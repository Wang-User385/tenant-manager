{"_data":[{"last_updated_by":10001,"description":"保证金管理方案创建页面","creation_date":1659003581851,"layout_code":"BZJ002","created_by":10001,"_sub":[{"_data":[{"recreate_ds_flag":"N","fetchall":"N","row_count":0,"last_updated_by":10001,"margin_height":1,"object_version_number":1,"creation_date":1659003581865,"created_by":10001,"_sub":[],"setup_width":"MARGIN_WIDTH","query_only":"N","flexible":"N","layout_code":"BZJ002","tab_code":"BZJCHUANGJIAN","field_width":150,"margin_top":3,"program_id":-1,"box_width":1,"tab_type":"FORM","column_count":0,"show_box":"Y","selected_flag":"Y","margin_width":1,"tab_seq":1,"repeat_bindertarget_flag":"N","last_update_date":1659003581865,"setup_height":"MARGIN_HEIGHT","enabled_flag":"Y","label_width":120,"request_id":-1,"configurable":"Y"},{"base_table_pk":"MANAGE_HD_ID","row_count":3,"tab_desc":"保证金方案创建","last_updated_by":10001,"parent_tab_code":"BZJCHUANGJIAN","margin_height":10,"object_version_number":1,"creation_date":1659003581914,"created_by":10001,"_sub":[{"_data":[{"order_seq":1,"colspan":1,"last_updated_by":10001,"rowspan":1,"column_name":"CONTRACT_NUMBER","input_mode":"REQUIRED","creation_date":1659005563423,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563423},{"order_seq":2,"colspan":1,"last_updated_by":10001,"rowspan":1,"column_name":"HANDLING_METHOD","input_mode":"REQUIRED","creation_date":1659005563458,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563458},{"order_seq":3,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563459,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563459},{"order_seq":4,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563459,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563459},{"order_seq":5,"colspan":1,"last_updated_by":10001,"rowspan":1,"column_name":"CONTRACT_NAME","input_mode":"READONLY","creation_date":1659005563459,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563459},{"order_seq":6,"colspan":1,"last_updated_by":10001,"rowspan":1,"column_name":"BP_NAME","input_mode":"READONLY","creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":7,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":8,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":9,"colspan":1,"last_updated_by":10001,"rowspan":1,"column_name":"DEPOSIT_AMOUNT","input_mode":"READONLY","creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":10,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":11,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460},{"order_seq":12,"colspan":1,"last_updated_by":10001,"rowspan":1,"creation_date":1659005563460,"layout_code":"BZJ002","created_by":10001,"tab_code":"CJ01","last_update_date":1659005563460}],"_table":"hls_doc_layout_screen"}],"setup_width":"MARGIN_WIDTH","layout_code":"BZJ002","tab_code":"CJ01","field_width":150,"margin_top":3,"program_id":-1,"box_width":10,"tab_type":"FORM","base_table":"csh_deposit_manage_hd","column_count":4,"show_box":"Y","margin_width":1,"tab_seq":1,"last_update_date":1659065518047,"setup_height":"MARGIN_HEIGHT","enabled_flag":"Y","label_width":120,"request_id":-1,"configurable":"Y"}],"_table":"hls_doc_layout_tab"},{"_data":[{"system_flag":"Y","underline":"N","display_flag":"Y","validation_type":"COMBOBOX","last_updated_by":10001,"footerrenderer":"N","clob_validation_sql":"Select scvb.value As value_code, scvb.meaning As value_name\n  From sys_code_value_b scvb, sys_code_b scb\n Where scb.code = 'CSH1001.HANDLING_METHOD'\n   And scb.code_id = scvb.code_id\n   And scvb.enabled_flag = 'Y'\n Order By scvb.order_seq\n","creation_date":1659004267310,"created_by":10001,"_sub":[],"ignore_required":"N","layout_code":"BZJ002","tab_code":"CJ01","allow_format":"FALSE","program_id":-1,"copy_from_parent_tab":"N","field_bak_flag":"N","input_mode":"REQUIRED","last_update_date":1659004272544,"key_field_flag":"N","column_name":"HANDLING_METHOD","lov_return_vcode":"N","allow_decimal":"FALSE","enabled_flag":"Y","zero_fill":"FALSE","prompt":"保证金处理方式","match_any_flag":"N","request_id":-1},{"system_flag":"Y","underline":"N","display_flag":"Y","validation_type":"LOV_D","last_updated_by":10001,"footerrenderer":"N","clob_validation_sql":"SELECT\n        c.contract_id,\n        c.contract_id value_code,\n        c.contract_number,\n        c.contract_number value_name,\n        c.contract_name,\n        (\n        SELECT\n        HBM.BP_NAME\n        FROM\n        HLS_BP_MASTER HBM\n        WHERE\n        c.tenant_id = HBM.BP_ID\n        ) BP_NAME,\n        (select sum(w.due_amount - nvl(w.received_amount,0)) from con_contract_cashflow w\n        where w.contract_id = c.contract_id\n        and w.cf_item = 51\n        and w.cf_direction = 'INFLOW') deposit_amount,\n        (select w.due_amount - nvl(w.received_amount,0) from con_contract_cashflow w\n        where w.contract_id = c.contract_id\n        and w.cf_item = 1\n        and w.cf_direction = 'INFLOW'\n        and w.times = (select min(cw.times) from con_contract_cashflow cw\n        where cw.contract_id = w.contract_id\n        and trunc(cw.due_date) >= trunc(sysdate)\n        and cw.cf_item = 1\n        )\n        ) PERFORM_AMOUNT,\n        ((select sum(w.due_amount - nvl(w.received_amount,0)) from con_contract_cashflow w\n        where w.contract_id = c.contract_id\n        and w.cf_item = 51\n        and w.cf_direction = 'INFLOW') -\n        (select w.due_amount - nvl(w.received_amount,0) from con_contract_cashflow w\n        where w.contract_id = c.contract_id\n        and w.cf_item = 1\n        and w.cf_direction = 'INFLOW'\n        and w.times = (select min(cw.times) from con_contract_cashflow cw\n        where cw.contract_id = w.contract_id\n        and trunc(cw.due_date) >= trunc(sysdate)\n        and cw.cf_item = 1\n        ))\n        ) AFTERPERFORM_BALANCE,\n        c.deposit_deduction,\n        (Select scvb.meaning As value_name\n  From sys_code_value_b scvb, sys_code_b scb\n Where scb.code = 'PRJ.MARGIN_PAYMENT_METHOD'\n   And scb.code_id = scvb.code_id\n   And scvb.enabled_flag = 'Y'\n   and scvb.value = c.deposit_deduction) deposit_deduction_n\n        FROM\n        con_contract c\n        where\n            1=1\n            and c.data_class = 'NORMAL'","creation_date":1659003582075,"created_by":10001,"_sub":[{"_data":[{"object_version_number":0,"lov_col_for_query":"N","program_id":-1,"last_update_login":10001,"lov_config_id":51096,"lov_col_display_width":120,"lov_col_name":"contract_id","creation_date":1659064935776,"lov_col_for_display":"N","created_by":10001,"last_updated_by":10001,"lov_data_type":"NUMBER","lov_col_prompt":"contract_id","config_id":279981,"lov_col_sequence":1,"request_id":-1,"last_update_date":1659083073520},{"object_version_number":0,"lov_col_for_query":"Y","program_id":-1,"last_update_login":10001,"lov_config_id":51097,"lov_col_display_width":120,"lov_col_name":"contract_number","creation_date":1659064935876,"lov_col_for_display":"Y","created_by":10001,"last_updated_by":10001,"lov_data_type":"VARCHAR2","lov_col_prompt":"支付表编号","config_id":279981,"lov_col_sequence":2,"request_id":-1,"last_update_date":1659083073525},{"object_version_number":0,"lov_col_for_query":"Y","program_id":-1,"last_