    <insert id="create" parameterType="com.hand.hls.web.logs.dto.HlsWsRequests"   useGeneratedKeys="true" keyProperty="recordId" >
        insert into hls_ws_requests
        (
        request_date,
        request_wsdl_url,
        function_name,
        status_code,
        status_date,
        return_status,
        responsed_date,
        request_xml,
        response_xml,
        pk_value,
        user_id,
        parameter_type,
        request_json,
        response_json
        )VALUES(
        #{requestDate},
        #{requestWsdlUrl},
        #{functionName},
        #{statusCode},
        #{statusDate},
        #{returnStatus},
        #{responsedDate},
        #{requestXml},
        #{responseXml},
        #{pkValue},
        #{userId},
        #{parameterType},
        #{requestJson},
        #{responseJson}
        )



    </insert>

    <select id="findByHlsWsRequests" resultMap="BaseResultMap">
        select hwr.request_date,
               hwr.request_wsdl_url,
               hwr.function_name,
               hwr.return_status,
               hwr.request_json,
               hwr.response_json,
               hwr.REQUEST_JSON_ENCRYPT,
               hwr.RESPONSE_JSON_ENCRYPT,
        (select sc.meaning
        from sys_code_value_b_v sc
        where sc.code = 'HLS.WS.REQUESTS.STATUS' and sc.code_value = hwr.return_status) return_status_n,
               hwr.created_by,
               (select s.description from sys_user s where s.user_id = hwr.created_by) created_by_n
        from hls_ws_requests hwr
        <where>
            <if test="functionName != null and functionName != ''">
               and  function_name like concat(concat('%',#{functionName}),'%')
            </if>
            <if test="returnStatus != null and returnStatus != ''">
                and  return_status = #{returnStatus}
            </if>
            <if test="requestDateFrom != null">
                and  request_date  >= to_date(#{requestDateFrom},'yyyy-mm-dd hh24:mi:ss')
            </if>
            <if test="requestDateTo != null">
                and  request_date <![CDATA[ <= ]]> to_date(#{requestDateTo},'yyyy-mm-dd hh24:mi:ss')+1-1/24/60/60
            </if>
            <if test="createdBy != null and createdBy != ''">
                and  created_by = #{createdBy}
            </if>
        </where>
        order by request_date desc
    </select>


</mapper>