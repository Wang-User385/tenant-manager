<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.cont.mapper.DocFileTempletTypeMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.cont.dto.DocFileTempletType">
        <result column="templet_type" property="templetType" jdbcType="VARCHAR" />
        <result column="description" property="description" jdbcType="VARCHAR" />
        <result column="enabled_flag" property="enabledFlag" jdbcType="VARCHAR" />
        <result column="system_flag" property="systemFlag" jdbcType="VARCHAR" />
    </resultMap>

    <select id="selectFileTempletTypeLov" resultMap="BaseResultMap">
        select
            t.templet_type,
            t.description,
            t.enabled_flag,
            t.system_flag
        from
        hls_doc_file_templet_type t
        <where>
            1=1
            <if test="templetType != null">
                AND t.templet_type LIKE CONCAT(CONCAT('%',#{templetType}),'%')
            </if>
            <if test="description != null">
                AND t.description LIKE CONCAT(CONCAT('%',#{description}),'%')
            </if>
        </where>
    </select>
</mapper>