<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hand.hls.cont.mapper.HlsDocFileTempletMapper">

    <resultMap type="com.hand.hls.cont.dto.HlsDocFileTemplet" id="BaseResultMap">

        <id column="templet_id" property="templetId"/>
        <result column="templet_code" property="templetCode" jdbcType="VARCHAR"/>
        <result column="templet_name" property="templetName" jdbcType="VARCHAR"/>
        <result column="templet_type" property="templetType" />
        <result column="usage_code" property="usageCode" jdbcType="VARCHAR"/>
        <result column="note" property="note" jdbcType="VARCHAR"/>
        <result column="usage_category" property="usageCategory" jdbcType="VARCHAR"/>
        <result column="enabled_flag" property="enabledFlag" jdbcType="VARCHAR"/>
        <result column="usage_class" property="usageClass" jdbcType="VARCHAR"/>
        <result column="usage_class_desc" property="usageClassDesc" jdbcType="VARCHAR"/>

    </resultMap>
    <select id="selectList" parameterType="com.hand.hls.cont.dto.HlsDocFileTemplet" resultMap="BaseResultMap">

        SELECT
        t1.*,t2.description usageCategoryDesc,
        (select meaning
        from sys_code_value_b_v
        where code = 'FND.BP_CLASS'
        and code_value = t1.usage_class) usage_class_desc
        FROM
        hls_doc_file_templet t1
        left join hls_bp_category t2 on t1.usage_category = t2.bp_category
        <where>
            1 = 1
            <if test="templetCode!=null">
                and  t1.templet_code  like concat(concat('%',#{templetCode}),'%')
            </if>
            <if test="templetName!=null">
                and   t1.templet_name  like concat(concat('%',#{templetName}),'%')
            </if>
        </where>


    </select>
</mapper>