        <result column="ASSETS_DISPOSAL_DATE" property="assetsDisposalDate" jdbcType="DATE" />
        <result column="ASSETS_DISPOSAL_STAUTS" property="assetsDisposalStauts" jdbcType="VARCHAR" />

        <result column="description" property="description" jdbcType="VARCHAR" />
        <result column="FULL_NAME" property="fullName" jdbcType="VARCHAR" />
        <result column="LEASE_ITEM_TYPE" property="leaseItemType" jdbcType="VARCHAR" />
        <result column="price" property="price" jdbcType="DECIMAL" />
        <result column="quantity" property="quantity" jdbcType="DECIMAL" />
        <result column="specification" property="specification" jdbcType="VARCHAR" />
        <result column="vender_Id" property="venderId" jdbcType="DECIMAL" />
        <result column="SERIAL_NUMBER" property="serialNumber" jdbcType="VARCHAR" />
