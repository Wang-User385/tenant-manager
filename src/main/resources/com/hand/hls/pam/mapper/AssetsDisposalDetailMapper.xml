        <result column="MANUFACTURER" property="manufacturer" jdbcType="VARCHAR" />
        <result column="ASSET_NUM" property="assetNum" jdbcType="VARCHAR" />
        <result column="lease_item_type_n" property="leaseItemTypeN" jdbcType="VARCHAR" />
        <result column="VENDER_ID_N" property="venderIdN" jdbcType="VARCHAR" />
        <result column="INVOICE_NUM" property="invoiceNum" jdbcType="VARCHAR" />
        <result column="ASSETS_DISPOSAL_STAUTS_N" property="assetsDisposalStautsN" jdbcType="VARCHAR" />
        <result column="hls_lease_item_list_id" property="hlsLeaseItemListId" jdbcType="DECIMAL" />
    </resultMap>
    <select id="queryLeaseItemByProjectId" parameterType="Long"
            resultMap="BaseResultMap">
        SELECT
        ppli.PROJECT_ID,
        ppli.LEASE_ITEM_ID,
            (select  h.LEASE_ITEM_CODE from hls_lease_item h where h.LEASE_ITEM_ID = ppli.LEASE_ITEM_ID) 	 LEASE_ITEM_CODE,

            hl.ASSET_NAME FULL_NAME,
        hl.hls_lease_item_list_id,
        hl.PRICE,
        hl.QUANTITY,
        hl.SPECIFICATION,
        hl.MANUFACTURER,
        hl.ASSET_NUM,
        hl.INSTALLATION_SITE,
        hl.INVOICE_NUM

        from hls_lease_item_list hl,prj_project_lease_item ppli
        <where>
            hl.LEASE_ITEM_ID=ppli.LEASE_ITEM_ID
            and ppli.PROJECT_ID=#{projectId}
            and hl.hls_lease_item_list_id NOT IN (SELECT DISTINCT ad.hls_lease_item_list_id FROM assets_disposal_detail ad WHERE ad.ASSETS_DISPOSAL_STAUTS IN ('DISPOSED'))

        </where>
    </select>



    <select id="queryAssetsDisposalDetail" parameterType="com.hand.hls.pam.dto.AssetsDisposalDetail"
            resultMap="BaseResultMap">
        select
        adl.ASSETS_DISPOSAL_DETAIL_ID,
        ad.ASSETS_DISPOSAL_ID,
        adl.FULL_NAME,
        adl.PRICE,
        adl.QUANTITY,
        adl.ASSETS_DISPOSAL_STAUTS,
        (SELECT meaning
        FROM sys_code_value_b_v v
        WHERE v.CODE = 'ASSETS_DISPOSAL_STATUS'
        AND v.code_value = adl.ASSETS_DISPOSAL_STAUTS)ASSETS_DISPOSAL_STAUTS_N,
        adl.*,
        ad.*
        from assets_disposal_detail adl,assets_disposal ad
        <where>
            adl.ASSETS_DISPOSAL_ID = ad.ASSETS_DISPOSAL_ID
            and adl.ASSETS_DISPOSAL_ID = #{assetsDisposalId}

        </where>

    </select>


