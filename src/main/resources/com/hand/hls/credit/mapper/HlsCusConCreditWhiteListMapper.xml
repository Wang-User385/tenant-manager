<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.credit.mapper.HlsCusConCreditWhiteListMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.credit.dto.HlsCusConCreditWhiteList">
        <result column="CON_WHITE_ID" property="conWhiteId" jdbcType="DECIMAL" />
        <result column="CONTRACT_ID" property="contractId" jdbcType="DECIMAL" />
        <result column="ENABLED_FLAG" property="enabledFlag" jdbcType="VARCHAR" />
        <result column="MARK" property="mark" jdbcType="VARCHAR" />

        <result column="create_date_s" property="createDateS" jdbcType="VARCHAR" />
        <result column="contract_number" property="contractNumber" jdbcType="VARCHAR" />
        <result column="contract_name" property="contractName" jdbcType="VARCHAR" />
        <result column="employee_id_n" property="employeeIdN" jdbcType="VARCHAR" />
        <result column="contract_id_n" property="contractIdN" jdbcType="VARCHAR" />

    </resultMap>



    <select id="selectConWhiteInfo" parameterType="com.hand.hls.credit.dto.HlsCusConCreditWhiteList" resultMap="BaseResultMap">
         select t1.con_white_id,
        t1.contract_id,
        t1.mark,
        t1.enabled_flag,
        t1.creation_date create_date_s,
        cc.contract_number,
        cc.contract_number as contract_id_n,
        cc.contract_name,
        cc.employee_id,
        (select fe.name from fnd_employee fe where fe.employee_id=cc.employee_id)employee_id_n
        from hls_con_credit_white_list t1, con_contract cc
        where t1.contract_id = cc.contract_id
        <if test="contractNumber!=null">
            and cc.contract_number like concat(concat('%',#{contractNumber}),'%')
        </if>
        <if test="contractName!=null">
            and cc.contract_name like concat(concat('%',#{contractName}),'%')
        </if>

    </select>
</mapper>