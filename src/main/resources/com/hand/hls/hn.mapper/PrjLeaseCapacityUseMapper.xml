<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.hn.mapper.PrjLeaseCapacityUseMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.hn.dto.PrjLeaseCapacityUse">
        <result column="LEASE_CAPACITY_ID" property="leaseCapacityId" jdbcType="DECIMAL" />
        <result column="PRJ_LEASE_ID" property="prjLeaseId" jdbcType="DECIMAL" />
        <result column="LEASE_PRODUCT_NAME" property="leaseProductName" jdbcType="VARCHAR" />
        <result column="SATURATED_CAPACITY" property="saturatedCapacity" jdbcType="VARCHAR" />
        <result column="PRESENT_ARRAIVE" property="presentArraive" jdbcType="VARCHAR" />
        <result column="SALE_PRICE" property="salePrice" jdbcType="VARCHAR" />
        <result column="UNIT" property="unit" jdbcType="VARCHAR" />
        <result column="OUTPUT_VALUE" property="outputValue" jdbcType="VARCHAR" />
        <result column="OTHER_DESC" property="otherDesc" jdbcType="VARCHAR" />

    </resultMap>


    <select id="selectCapacityUse" parameterType="com.hand.hls.hn.dto.PrjLeaseCapacityUse" resultMap="BaseResultMap">
        select * from

        prj_lease_capacity_use

        <where>
            1=1
            <if test="prjLeaseId !=null">
                AND prj_lease_id = #{prjLeaseId}
            </if>


        </where>
    </select>


</mapper>