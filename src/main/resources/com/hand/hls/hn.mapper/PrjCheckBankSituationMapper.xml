<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.hn.mapper.PrjCheckBankSituationMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.hn.dto.PrjCheckBankSituation">
        <result column="BANK_SITUATION_ID" property="bankSituationId" jdbcType="DECIMAL" />
        <result column="CHECK_ID" property="checkId" jdbcType="DECIMAL" />
        <result column="LOAN_BANK" property="loanBank" jdbcType="DECIMAL" />
        <result column="LOAN_MONEY" property="loanMoney" jdbcType="DATE" />
        <result column="LOAN_RATE" property="loanRate" jdbcType="VARCHAR" />
        <result column="LOAN_START_DATE" property="loanStartDate" jdbcType="DATE" />
        <result column="GUARANT_TYPE" property="guarantType" jdbcType="VARCHAR" />
        <result column="CHANGE_REMARK" property="changeRemark" jdbcType="VARCHAR" />
        <result column="CONTRACT_NUMBER" property="contractNumber" jdbcType="VARCHAR" />



    </resultMap>


    <select id="queryList" parameterType="com.hand.hls.hn.dto.PrjCheckBankSituation" resultMap="BaseResultMap">
        select * from

        prj_check_bank_situation
        <where>
            1=1

            <if test="checkId!=null">
                and CHECK_ID = #{checkId}
            </if>
        </where>
    </select>


</mapper>