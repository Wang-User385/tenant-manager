<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.hn.mapper.PrjLeaseMakeRuleMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.hn.dto.PrjLeaseMakeRule">
        <result column="RULE_ID" property="ruleId" jdbcType="DECIMAL" />
        <result column="PRJ_LEASE_ID" property="prjLeaseId" jdbcType="DECIMAL" />
        <result column="RULE_DESC" property="ruleDesc" jdbcType="VARCHAR" />
        <result column="RULE_FILE" property="ruleFile" jdbcType="VARCHAR" />


    </resultMap>


    <select id="selectPrjLeaseMakeRule" parameterType="com.hand.hls.hn.dto.PrjLeaseMakeRule" resultMap="BaseResultMap">
        select * from
        prj_lease_make_rule

        <where>
            1=1
            <if test="prjLeaseId !=null">
                AND prj_lease_id = #{prjLeaseId}
            </if>


        </where>
    </select>


</mapper>