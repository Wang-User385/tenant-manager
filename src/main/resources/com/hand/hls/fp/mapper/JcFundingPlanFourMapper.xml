<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.fp.mapper.JcFundingPlanFourMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.fp.dto.JcFundingPlanFour">
        <result column="FUNDING_FOUR_ID" property="fundingFourId" jdbcType="DECIMAL" />
        <result column="FUNDING_ID" property="fundingId" jdbcType="DECIMAL" />
        <result column="FUNDING_ONE_ID" property="fundingOneId" jdbcType="DECIMAL" />
        <result column="FUNDING_SECOND_ID" property="fundingSecondId" jdbcType="DECIMAL" />
        <result column="FUNDING_THREE_ID" property="fundingThreeId" jdbcType="DECIMAL" />
        <result column="FOUR_ITEM_CODE" property="fourItemCode" jdbcType="VARCHAR" />
        <result column="FOUR_ITEM_NAME" property="fourItemName" jdbcType="VARCHAR" />
        <result column="FOUR_ITEM_SEQ" property="fourItemSeq" jdbcType="DECIMAL" />
        <result column="ENABLED_FLAG" property="enabledFlag" jdbcType="VARCHAR" />
    </resultMap>

    <select id="queryAll" parameterType="com.hand.hls.fp.dto.JcFundingPlanFour" resultMap="BaseResultMap">
        select t.*  from jc_funding_plan_four t
        <where>
            t.funding_three_id = #{fundingThreeId}
            <if test="enabledFlag != null">
                and t.enabled_flag = #{enabledFlag}
            </if>

        </where>
        order by t.FOUR_ITEM_SEQ asc
    </select>

</mapper>