<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.abs.mapper.HlsCusAbsProductBuybackMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.abs.dto.HlsCusAbsProductBuyback">
        <result column="BUYBACK_ID" property="buybackId" jdbcType="DECIMAL" />
        <result column="PRODUCT_ID" property="productId" jdbcType="DECIMAL" />
        <result column="BUYBACK_COMPANY_ID" property="buybackCompanyId" jdbcType="DECIMAL" />
        <result column="STRUCTURE_ID" property="structureId" jdbcType="DECIMAL" />
        <result column="BANK_ACCOUNT_ID" property="bankAccountId" jdbcType="DECIMAL" />
        <result column="BUYBACK_AMOUNT" property="buybackAmount" jdbcType="DECIMAL" />
        <result column="RECEIVER_AMOUNT" property="receiverAmount" jdbcType="DECIMAL" />
        <result column="BUYBACK_DATE" property="buybackDate" jdbcType="DATE" />
        <result column="BUYBACK_REASON" property="buybackReason" jdbcType="VARCHAR" />
        <result column="OUT_BANK_ACCOUNT_NAME" property="outBankAccountName" jdbcType="VARCHAR" />
        <result column="OUT_BANK_ACCOUNT_NUM" property="outBankAccountNum" jdbcType="VARCHAR" />
        <result column="OUT_BANK_BRANCH_NAME" property="outBankBranchName" jdbcType="VARCHAR" />
        <result column="IN_BANK_ACCOUNT_NAME" property="inBankAccountName" jdbcType="VARCHAR" />
        <result column="IN_BANK_ACCOUNT_NUM" property="inBankAccountNum" jdbcType="VARCHAR" />
        <result column="IN_BANK_BRANCH_NAME" property="inBankBranchName" jdbcType="VARCHAR" />
        <result column="COMPANY_FULL_NAME" property="companyFullName" jdbcType="VARCHAR" />
    </resultMap>


    <select id="selectProductBuybackData" parameterType="com.hand.hls.abs.dto.HlsCusAbsProductBuyback" resultMap="BaseResultMap">
        SELECT
            CAPB.*,
            FC.COMPANY_FULL_NAME,
            CBA.BANK_ACCOUNT_NAME  OUT_BANK_ACCOUNT_NAME,
            CBA.BANK_ACCOUNT_NUM   OUT_BANK_ACCOUNT_NUM,
            CBA.BANK_BRANCH_NAME   OUT_BANK_BRANCH_NAME,
            CABA.BANK_ACCOUNT_NAME  IN_BANK_ACCOUNT_NAME,
            CABA.BANK_ACCOUNT_NUM   IN_BANK_ACCOUNT_NUM,
            CABA.BANK_BRANCH_NAME   IN_BANK_BRANCH_NAME
        FROM
            CT_ABS_PRODUCT_BUYBACK CAPB
        JOIN
            FND_COMPANY FC
        ON
            FC.COMPANY_ID=CAPB.BUYBACK_COMPANY_ID
        JOIN
            CSH_BANK_ACCOUNT CBA
        ON
            CBA.BANK_ACCOUNT_ID= CAPB.BANK_ACCOUNT_ID
        JOIN
            CT_ABS_BANK_ACCOUNT CABA
        ON
            CABA.ABS_BANK_ACCOUNT_ID=CAPB.ABS_BANK_ACCOUNT_ID
        WHERE
           1=1
        <if test="productId != null">
           AND CAPB.PRODUCT_ID = #{productId}
         </if>
    </select>

</mapper>