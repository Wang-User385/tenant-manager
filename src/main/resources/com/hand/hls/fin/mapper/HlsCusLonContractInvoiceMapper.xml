<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hand.hls.fin.mapper.HlsCusLonContractInvoiceMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.fin.dto.HlsCusLonContractInvoice">
        <result column="invoice_id" property="invoiceId"/>
        <result column="invoice_code" property="invoiceCode"/>
        <result column="invoice_number" property="invoiceNumber"/>
        <result column="invoice_description" property="invoiceDescription"/>
        <result column="invoice_flag" property="invoiceFlag"/>
        <result column="invoice_flag_n" property="invoiceFlagN"/>
        <result column="project_cash_flow" property="projectCashFlow"/>
        <result column="invoice_url" property="invoiceUrl"/>
        <result column="contract_id" property="contractId"/>
        <result column="contract_number" property="contractNumber"/>
        <result column="batch_id" property="batchId"/>
        <result column="batch_number" property="batchNumber"/>

        <!--上传人-->
        <result column="upload_person" property="uploadPerson" jdbcType="VARCHAR"/>
        <result column="file_name" property="fileName" jdbcType="VARCHAR"/>
        <result column="file_path" property="filePath" jdbcType="VARCHAR"/>
        <result column="file_size" property="fileSize" jdbcType="DECIMAL"/>
        <result column="upload_date" property="uploadDate" jdbcType="TIMESTAMP"/>
        <result column="update_status" property="updateStatus" jdbcType="VARCHAR"/>
        <result column="category_path" property="categoryPath" jdbcType="VARCHAR"/>
        <result column="file_suffix" property="fileSuffix" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="selectInvoiceInfo" resultMap="BaseResultMap">
        select lci.*,
               (select v.meaning as value_name
                from sys_code_value_b_v v
                where v.enabled_flag = 'Y'
                  and v.code = 'SYS.YES_NO'
                  and lci.invoice_flag = v.code_value) invoice_flag_n,
               (SELECT wm_concat(fa.file_name)
                FROM fnd_atm_attachment fa, fnd_atm_attachment_multi fam
                WHERE fa.attachment_id = fam.attachment_id
                  AND fam.table_name = 'LON_CONTRACT_INVOICE'
                  AND lci.invoice_id = fam.table_pk_value) file_name
        from lon_contract_invoice lci
        where lci.batch_id = #{batchId}
    </select>
</mapper>