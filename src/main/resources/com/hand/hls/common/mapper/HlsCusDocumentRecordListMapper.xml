<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.common.mapper.HlsCusDocumentRecordListMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.common.dto.HlsCusDocumentRecordList">
        <result column="LIST_ID" property="listId" jdbcType="DECIMAL" />
        <result column="OUTBOUND_ID" property="outboundId" jdbcType="DECIMAL" />
        <result column="SOURCE_ID" property="sourceId" jdbcType="DECIMAL" />
        <result column="SOURCE_TABLE" property="sourceTable" jdbcType="VARCHAR" />
        <result column="MARK" property="mark" jdbcType="VARCHAR" />
        <result column="source_type" property="sourceType" jdbcType="VARCHAR" />
    </resultMap>

    <select id="selectDocumentByOutboundId" resultMap="BaseResultMap" parameterType="com.hand.hls.common.dto.HlsCusDocumentRecordList">
        select t.list_id, t.outbound_id, t.source_id, t.source_table, t.mark
        from ws_document_record_list t
        WHERE 1=1
        <if test="outboundId!=null">
            and t.outbound_id = #{outboundId}
        </if>
    </select>
</mapper>