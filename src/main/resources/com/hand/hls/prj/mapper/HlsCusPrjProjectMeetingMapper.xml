    <select id="queryInfo" resultMap="BaseResultMap">
        SELECT
        ppm.*
        FROM
        prj_project_meeting ppm
        <where>
            1=1
            and ppm.data_class = 'NORMAL'
            <if test="meetingName != null">
                and ppm.meeting_name LIKE concat(concat('%',#{meetingName}),'%')
            </if>
            <if test="projectId != null">
                and ppm.project_id = #{projectId}
            </if>
            <if test="meetingDate != null">
                and ppm.meeting_date = #{meetingDate}
            </if>
        </where>
        order by ppm.meeting_date desc
    </select>

    <select id="queryInfoChange" resultMap="BaseResultMap">
        SELECT
        ppm.*
        FROM
        prj_project_meeting ppm
        <where>
            1=1
            and ppm.data_class = 'CHANGE'
            <if test="meetingName != null">
                and ppm.meeting_name LIKE concat(concat('%',#{meetingName}),'%')
            </if>
            <if test="projectId != null">
                and ppm.project_id = #{projectId}
            </if>
            <if test="meetingDate != null">
                and ppm.meeting_date = #{meetingDate}
            </if>
        </where>
        order by ppm.meeting_date desc
    </select>

    <select id="queryConfirmMeetingInfo" resultMap="BaseResultMap">
        SELECT
        ppm.*
        FROM
        prj_project_meeting ppm
        WHERE
        ppm.project_id = #{projectId}
        and ppm.data_class = 'NORMAL'
        <if test="processInstanceId != null || processInstanceId != ''">
            and process_instance_id = #{processInstanceId}
        </if>
    </select>

    <select id="queryApproveResult" resultMap="BaseResultMap">
        SELECT ppm.review_results
        FROM prj_project_meeting ppm ,prj_project pp
        <where>
            ppm.project_id = pp.project_id
            and ppm.data_class = 'NORMAL'
            <if test="projectId != null">
                and ppm.project_id = #{projectId}
            </if>
        </where>

    </select>
    <select id="updateMeetingStatus" resultMap="BaseResultMap">
        update prj_project_meeting
        set data_class = #{dataClass}
        where project_id = #{projectId}
        and data_class = 'CHANGE'
    </select>

</mapper>