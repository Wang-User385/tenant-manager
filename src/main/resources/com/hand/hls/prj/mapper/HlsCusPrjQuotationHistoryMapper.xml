    <select id="selectVersionCount" resultType="java.lang.Long" parameterType="com.hand.hls.prj.dto.HlsCusPrjProject">
        select (case
        when count(pqh.version_id) = 0 then
        0
        else
        max(pqh.version_id)
        end) version_id
        from prj_quotation_history pqh
        <where>
            pqh.source_document_id = #{projectId}
            and pqh.source_document_category = 'PRJ_PROJECT'
        </where>
    </select>

    <select id="selectVersionCountCon" resultType="java.lang.Long"
            parameterType="com.hand.hls.cont.dto.HlsCusConContract">
        select (case
        when count(pqh.version_id) = 0 then
        0
        else
        max(pqh.version_id)
        end) version_id
        from prj_quotation_history pqh
        <where>
            pqh.source_document_id = #{contractId}
            and pqh.source_document_category = 'CON_CONTRACT'
        </where>
    </select>

