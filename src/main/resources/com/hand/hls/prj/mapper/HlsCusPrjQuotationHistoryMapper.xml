    <select id="queryQuotationHistoryByQuotationId" parameterType="com.hand.hls.prj.dto.HlsCusPrjQuotation"
            resultMap="QuotationInfoMap">
        select
        pq.quotation_id,
        pq.lease_item_amount,
        pq.finance_amount,
        pq.lease_term,
        pq.first_rental_payment_date,
        pq.lease_start_date,
        pq.annual_pay_times,
        pq.RENTING_FREQUENCY,
        pq.vat_rate,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'RENTING_FREQUENCY' and s.code_value =
        pq.RENTING_FREQUENCY)renting_frequency_n,

        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'HLS500_ANNUAL_PAY_TIMES' and s.code_value =
        pq.annual_pay_times)annual_pay_times_n,
        pq.payment_day,
        pq.residual_value,
        pq.currency,
        (select fc.currency_name from fnd_currency fc where fc.currency_code = pq.currency)currency_n,
        pq.xirr,
        pq.XIRR_WITHOUT_FEE_AFT,
        pq.int_rate_type,

        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'CON.INT_RATE_TYPE' and upper(s.code_value) =
        upper(pq.int_rate_type))int_rate_type_n,
        pq.base_rate,
        pq.lpr_fixed_date,
        pq.lpr_link_date,
        pq.int_rate,
        pq.lpr_adjustment_term,
        pq.LPR_ADJUSTMENT_TERM pricing_floating_cycle,

        (select nvl(sum(pqc.due_amount),0) from prj_quotation_cashflow pqc
        where pqc.quotation_id = pq.quotation_id and pqc.cf_item = 5 and pqc.cf_type = 51) DEPOSIT,
        (select nvl(sum(pqc.due_amount),0) from prj_quotation_cashflow pqc
        where pqc.quotation_id = pq.quotation_id and pqc.cf_item = 3 and pqc.cf_type = 3) LEASE_CHARGE,
        (select nvl(sum(pqc.due_amount),0) from prj_quotation_cashflow pqc
        where pqc.quotation_id = pq.quotation_id and pqc.cf_item = 65 and pqc.cf_type = 66) adv_service_fee,
        (select nvl(sum(pqc.due_amount),0) from prj_quotation_cashflow pqc
        where pqc.quotation_id = pq.quotation_id and pqc.cf_item = 4 and pqc.cf_type = 41) LEASE_MGT_FEE,
        (case
        when nvl(pq.lease_item_amount,0) != 0 then
        ((select nvl(sum(pqc.due_amount),0) from prj_quotation_cashflow pqc
        where pqc.quotation_id = pq.quotation_id and pqc.cf_item = 4 and pqc.cf_type = 41)/pq.lease_item_amount)
        else
        pq.LEASE_MGT_FEE_RATIO
        end) LEASE_MGT_FEE_RATIO,
        pq.total_rental,

        pq.description,
        pq.payment_number,
        pq.quotation_number,
        pq.price_list,
        (select h.description from hls_price_list h where h.price_list = pq.price_list)price_list_n,
        pq.price_list_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'PRICE_LIST_TYPE' and s.code_value =
        pq.price_list_type)price_list_type_n,
        pq.business_type,
        (select hbt.description from hls_business_type hbt where hbt.document_category = 'PRJ_PROJECT'
        and pq.business_type = hbt.business_type)business_type_n,
        pq.exchange_rate,
        pq.first_pay,
        pq.down_payment,
        pq.first_release_date,
        pq.pre_lease_flag,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'SYS.YES_NO' and s.code_value =
        pq.pre_lease_flag)pre_lease_flag_n,

        pq.pre_lease_term,
        pq.grace_flag,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'SYS.YES_NO' and s.code_value =
        pq.grace_flag)grace_flag_n,

        pq.grace_lease_term,
        pq.lease_end_date,
        pq.pay_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'PAY_TYPE' and s.code_value = pq.pay_type)pay_type_n,

        pq.base_rate_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'FND.BASE_RATE_TYPE' and s.code_value =
        pq.base_rate_type)base_rate_type_n,

        pq.floating_way_rate,
        pq.tax_structure,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'TAX_STRUCTURE' and s.code_value =
        pq.tax_structure)tax_structure_n,

        pq.tax_type_code,
        pq.lpr_base_date,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'LPR_BASE_DATE' and s.code_value =
        pq.lpr_base_date)lpr_base_date_n,

        pq.lpr_adjustment_period,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'CON.FLOATING_RANGE_METHOD' and s.code_value =
        pq.lpr_adjustment_period)lpr_adjustment_period_n,

        pq.asset_mgt_fee_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'ASSET_MGT_FEE_TYPE' and s.code_value =
        pq.asset_mgt_fee_type)asset_mgt_fee_type_n,

        pq.interest_amortization_method,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'GLD.AMORTIZATION_METHOD' and s.code_value =
        pq.interest_amortization_method)interest_amortization_method_n,

        pq.rental_rounding_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'RENTAL_ROUNDING_TYPE' and s.code_value =
        pq.rental_rounding_type)rental_rounding_type_n,


        pq.calc_date_type,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'CALC_DATE_TYPE' and s.code_value =
        pq.calc_date_type)calc_date_type_n,
        pq.rental_pay_date,
        pq.lpr_ref_day,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'LPR_DATE_REF' and s.code_value =
        pq.lpr_ref_day)lpr_ref_day_n,

        pq.vatable_rate_flag,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'SYS.YES_NO' and s.code_value =
        pq.vatable_rate_flag)vatable_rate_flag_n,

        pq.vatable_prin_flag,
        (select s.MEANING from sys_code_value_b_v s where s.CODE = 'SYS.YES_NO' and s.code_value =
        pq.vatable_prin_flag)vatable_prin_flag_n,


        pq.lpr_name_date,
        pq.xirr_net,
        pq.xirr_paynote,
        pq.xirr_net_paynote,
        pq.lease_times

        from prj_quotation_history pq
        <where>
            1=1
            <if test="sourceDocumentId!=null ">
                and pq.source_Document_Id=#{sourceDocumentId}
            </if>
            <if test="sourceDocumentCategory!=null ">
                and pq.source_document_category=#{sourceDocumentCategory}
            </if>
            <if test="quotationId!=null ">
                and pq.quotation_id=#{quotationId}
            </if>
        </where>

    </select>

    <select id="ConFinancialXIRRHistoryQuery" resultMap="QuotationInfoMap">
        select q.xirr, q.XIRR_NET, q.creation_date create_date, (@i :=@i + 1) AS sec_num
        from prj_quotation_history q,(SELECT @i := 0) AS row_seq
        <where>q.source_document_category = 'CON_CONTRACT'
            and q.source_document_id = #{contractId}
        </where>
    </select>

</mapper>