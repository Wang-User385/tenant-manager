<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.bp.mapper.HlsBpSpouseMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.bp.dto.HlsBpSpouse">
        <result column="SPOUSE_ID" property="spouseId" jdbcType="DECIMAL" />
        <result column="BP_ID" property="bpId" jdbcType="DECIMAL" />
        <result column="RELATIONSHIP" property="relationship" jdbcType="VARCHAR" />
        <result column="PERSON_NAME" property="personName" jdbcType="VARCHAR" />
        <result column="ORG_TYPE" property="orgType" jdbcType="VARCHAR" />
        <result column="ORG_NUM" property="orgNum" jdbcType="VARCHAR" />
        <result column="AGE" property="age" jdbcType="DECIMAL" />
        <result column="PHONE" property="phone" jdbcType="VARCHAR" />
        <result column="NATIONALITY" property="nationality" jdbcType="VARCHAR" />
        <result column="PERSONAL_CREDIT" property="personalCredit" jdbcType="VARCHAR" />
        <result column="relationship_n" property="relationshipN" jdbcType="VARCHAR" />
        <result column="org_type_n" property="orgTypeN" jdbcType="VARCHAR" />
        <result column="nationality_n" property="nationalityN" jdbcType="VARCHAR" />
        <result column="REF_V01" property="refV01" jdbcType="VARCHAR" />
        <result column="REF_V04" property="refV04" jdbcType="VARCHAR" />
        <result column="REF_V03" property="refV04" jdbcType="VARCHAR" />
        <result column="FAX" property="fax" jdbcType="VARCHAR" />
        <result column="EMAIL" property="email" jdbcType="VARCHAR" />
        <result column="CELL_PHONE" property="cellPhone" jdbcType="VARCHAR" />
    </resultMap>
    <select id="queryAll" parameterType="com.hand.hls.bp.dto.HlsBpSpouse" resultMap="BaseResultMap">
        SELECT
        hbs.*,
        (SELECT
        v.meaning AS value_name
        FROM
        sys_code_value_b_v v
        WHERE
        v.CODE = 'ZX_MEMBERTYPE' and v.code_value = hbs.relationship)relationship_n,
        (SELECT
        v.meaning AS value_name
        FROM
        sys_code_value_b_v v
        WHERE
        v.CODE = 'FND.EMPLOYEE_ID_TYPE' and v.code_value = hbs.org_type)org_type_n,
        (SELECT
        v.meaning AS value_name
        FROM
        sys_code_value_b_v v
        WHERE
        v.CODE = 'HLS211_NATIONALITY' and v.code_value = hbs.nationality)nationality_n
        FROM
        hls_bp_spouse  hbs
        <where>
            <if test="bpId != null">
                hbs.bp_id = #{bpId}
            </if>
        </where>
    </select>

</mapper>