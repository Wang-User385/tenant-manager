<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.bp.mapper.HlsCusBpAssetslistRealestateMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.bp.dto.HlsCusBpAssetslistRealestate">
        <result column="realEstate_assets_id" property="realestateAssetsId" jdbcType="DECIMAL" />
        <result column="bp_id" property="bpId" jdbcType="DECIMAL" />
        <result column="property_form" property="propertyForm" jdbcType="VARCHAR" />
        <result column="house_number" property="houseNumber" jdbcType="VARCHAR" />
        <result column="located_address" property="locatedAddress" jdbcType="VARCHAR" />
        <result column="area" property="area" jdbcType="DECIMAL" />
        <result column="unit_price" property="unitPrice" jdbcType="DECIMAL" />
        <result column="total_price" property="totalPrice" jdbcType="DECIMAL" />
        <result column="description" property="description" jdbcType="VARCHAR" />
    </resultMap>

    <select id="queryAll" parameterType="com.hand.hls.bp.dto.HlsCusBpAssetslistRealestate" resultMap="BaseResultMap">
        SELECT
        hbar.realEstate_assets_id,
        hbar.bp_id,
        hbar.property_form,
        hbar.located_address,
        hbar.area,
        hbar.unit_price,
        hbar.total_price,
        hbar.house_number,
        hbar.description
        FROM
        hls_bp_assetsList_realEstate  hbar
        <where>
            <if test="bpId != null">
                hbar.bp_id = #{bpId}
            </if>
            <if test="realestateAssetsId != null">
                hbar.realEstate_assets_id = #{realestateAssetsId}
            </if>
        </where>
    </select>


</mapper>