<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.bp.mapper.HlsBpSanctionMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.bp.dto.HlsBpSanction">
        <result column="SANCTION_ID" property="sanctionId" jdbcType="DECIMAL" />
        <result column="BP_ID" property="bpId" jdbcType="DECIMAL" />
        <result column="CONTENT" property="content" jdbcType="VARCHAR" />
        <result column="PUNISH_NUMBER" property="punishNumber" jdbcType="VARCHAR" />
        <result column="DESCRIPTION" property="description" jdbcType="VARCHAR" />
        <result column="DECISION_DATE" property="decisionDate" jdbcType="DATE" />
        <result column="TYPE" property="type" jdbcType="VARCHAR" />
        <result column="DEPARTMENT_NAME" property="departmentName" jdbcType="VARCHAR" />
        <result column="PUBLISH_DATE" property="publishDate" jdbcType="DATE" />
    </resultMap>
    <select id="queryAll" parameterType="com.hand.hls.bp.dto.HlsBpSanction" resultMap="BaseResultMap">
        SELECT
        hbs.*
        FROM
        hls_bp_sanction  hbs
        <where>
            <if test="bpId != null">
                hbs.bp_id = #{bpId}
            </if>
        </where>
    </select>

</mapper>