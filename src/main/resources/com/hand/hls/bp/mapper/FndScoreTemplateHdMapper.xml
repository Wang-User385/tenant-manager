    <select id="dbCloumnData" parameterType="com.hand.hls.bp.dto.FndScoreTemplateHd" resultMap="DbColumnMap1">
        SELECT hddsc.*,hddsc.description AS dsDescription
        FROM hls_db_data_source_column hddsc
        WHERE EXISTS (
        SELECT *
        FROM
        fnd_score_tplt_db_source fstds
        WHERE fstds.db_data_source_id = hddsc.data_source_id
        AND fstds.score_template_hd_id = #{scoreTemplateHdId}
        )
    </select>

    <select id="query" parameterType="com.hand.hls.bp.dto.FndScoreTemplateHd" resultMap="BaseResultMap1">
        SELECT fsth.*,fstt.score_template_type_name
        FROM fnd_score_template_hd fsth
        left join fnd_score_template_type fstt on fsth.score_template_type_id = fstt.score_template_type_id
        <where>
            1=1
            <if test="scoreTemplateHdId!=null">
                AND fsth.score_template_hd_id = #{scoreTemplateHdId}
            </if>
            <if test="companyId!=null">
                AND fsth.company_id = #{companyId}
            </if>
            <if test="scoreTemplateHdCode!=null">
                AND fsth.score_template_hd_code LIKE CONCAT(concat('%',#{scoreTemplateHdCode}),'%')
            </if>
            <if test="scoreTemplateHdName!=null">
                AND fsth.score_template_hd_name LIKE CONCAT(concat('%',#{scoreTemplateHdName}),'%')
            </if>
            <if test="calcMethod!=null">
                AND fsth.calc_method LIKE CONCAT(concat('%',#{calcMethod}),'%')
            </if>
            <if test="scoreTemplateTypeId!=null">
                AND fsth.score_template_type_id = #{scoreTemplateTypeId}
            </if>
        </where>
        ORDER BY fsth.score_template_hd_code ASC
    </select>

    <select id="selectDbLov" resultMap="DbColumnMap1" parameterType="com.hand.hls.bp.dto.FndScoreTemplateLn">
        select b.data_source_column_id,
        b.column_name,
        b.description as dsDescription
        from
        FND_SCORE_TPLT_DB_SOURCE a,
        hls_db_data_source_column b
        where a.score_template_hd_id = #{scoreTemplateHdId}
        <if test="columnName!=null">
            AND b.cloumn_name = #{columnName}
        </if>
        and a.db_data_source_id = b.data_source_id
        and a.enabled_flag = 'Y'
        and b.enabled_flag = 'Y'
    </select>
-->
    <select id="selectScoreTemplateHd" resultMap="BaseResultMap1">
        select
        fsth.SCORE_TEMPLATE_HD_ID as value_code,
        fsth.SCORE_TEMPLATE_HD_NAME as value_name,
        fsth.SCORE_TEMPLATE_HD_NAME,
        fsth.SCORE_TEMPLATE_HD_CODE,
        fsth.SCORE_TEMPLATE_HD_ID,
        fsth.FINANCIAL_FLAG
        from fnd_score_template_hd fsth
        where ENABLED_FLAG = 'Y'
    </select>



</mapper>