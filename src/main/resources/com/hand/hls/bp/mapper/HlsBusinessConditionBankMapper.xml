<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.bp.mapper.HlsBusinessConditionBankMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.bp.dto.HlsBusinessConditionBank">
        <result column="BANK_ID" property="bankId" jdbcType="DECIMAL"/>
        <result column="CONDITION_ID" property="conditionId" jdbcType="DECIMAL"/>
        <result column="MONTH" property="month" jdbcType="VARCHAR"/>
        <result column="REVENUE" property="revenue" jdbcType="DECIMAL"/>
        <result column="PAY" property="pay" jdbcType="DECIMAL"/>
        <result column="NET_INCOME" property="netIncome" jdbcType="DECIMAL"/>
        <result column="YEAR" property="year" jdbcType="VARCHAR"/>
        <result column="year_n" property="yearN" jdbcType="VARCHAR"/>

        <result column="month_n" property="monthN" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="queryAllByConditionId" resultMap="BaseResultMap">
        select hbcb.*,
        (select sc.meaning value_name
        from sys_code_value_b_v sc
        where sc.code = 'MONTH'
        and sc.code_value = hbcb.month) month_n,
        (select sc.meaning value_name
        from sys_code_value_b_v sc
        where sc.code = 'YEAR'
        and sc.code_value = hbcb.year) year_n
        from hls_business_condition_bank hbcb
        where condition_id = #{conditionId}
    </select>

</mapper>