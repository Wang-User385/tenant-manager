<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.bp.mapper.HlsCusBpMasterShareholderMapper" >
    <resultMap id="BaseResultMap" type="com.hand.hls.bp.dto.HlsCusBpMasterShareholder">
        <id column="BP_SHAREHOLDER_ID" jdbcType="BIGINT" property="bpShareholderId"/>
        <result column="BP_ID" jdbcType="BIGINT" property="bpId"/>
        <result column="SHAREHOLDER_NAME" jdbcType="VARCHAR" property="shareholderName"/>
        <result column="CONTRIBUTION_AMOUNT" jdbcType="BIGINT" property="contributionAmount"/>
        <result column="CONTRIBUTION_PROPORTION" jdbcType="DOUBLE" property="contributionProportion"/>
        <result column="REALITY_POSITION" jdbcType="VARCHAR" property="realityPosition"/>
        <result column="BP_RELATION" jdbcType="VARCHAR" property="bpRelation"/>
        <result column="CREATED_BY" jdbcType="BIGINT" property="createdBy"/>
        <result column="CREATION_DATE" jdbcType="TIMESTAMP" property="creationDate"/>
        <result column="LAST_UPDATED_BY" jdbcType="BIGINT" property="lastUpdatedBy"/>
        <result column="LAST_UPDATE_DATE" jdbcType="TIMESTAMP" property="lastUpdateDate"/>
        <result column="REF_V01" jdbcType="VARCHAR" property="refV01"/>
        <result column="REF_V02" jdbcType="VARCHAR" property="refV02"/>
        <result column="REF_V03" jdbcType="VARCHAR" property="refV03"/>
        <result column="REF_V04" jdbcType="VARCHAR" property="refV04"/>
        <result column="REF_V05" jdbcType="VARCHAR" property="refV05"/>
        <result column="REF_N01" jdbcType="BIGINT" property="refN01"/>
        <result column="REF_N02" jdbcType="BIGINT" property="refN02"/>
        <result column="REF_N03" jdbcType="BIGINT" property="refN03"/>
        <result column="REF_N04" jdbcType="BIGINT" property="refN04"/>
        <result column="REF_N05" jdbcType="BIGINT" property="refN05"/>
        <result column="REF_D01" jdbcType="TIMESTAMP" property="refD01"/>
        <result column="REF_D02" jdbcType="TIMESTAMP" property="refD02"/>
        <result column="REF_D03" jdbcType="TIMESTAMP" property="refD03"/>
        <result column="REF_D04" jdbcType="TIMESTAMP" property="refD04"/>
        <result column="REF_D05" jdbcType="TIMESTAMP" property="refD05"/>
        <result column="STOCKHOLDERTYPE" jdbcType="VARCHAR" property="stockholdertype"/>
        <result column="CERTTYPE" jdbcType="VARCHAR" property="certtype"/>
        <result column="CERTNO" jdbcType="VARCHAR" property="certno"/>
        <result column="ORGCODE" jdbcType="VARCHAR" property="orgcode"/>
        <result column="ORGCREDITCODE" jdbcType="VARCHAR" property="orgcreditcode"/>
        <result column="UPDATEDATE" jdbcType="VARCHAR" property="updatedate"/>
        <result column="RESERVEDFIELD" jdbcType="VARCHAR" property="reservedfield"/>
        <result column="INVESTOR_TYPE" jdbcType="VARCHAR" property="investorType"/>
        <result column="INVESTOR_TYPE_N" jdbcType="VARCHAR" property="investorTypeN"/>
    </resultMap>

    <select id="queryShareholderDetails" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
            hbms.*,
            ( SELECT v.meaning FROM sys_code_value_b_v v WHERE v.CODE = 'ZX_STOCKHOLDERTYPE' AND v.code_value = STOCKHOLDERTYPE ) stockholdertypeN,
            ( SELECT v.meaning FROM sys_code_value_b_v v WHERE v.CODE = 'ZX_CERTORG_TYPE' AND v.code_value = CERTTYPE ) certtypeN,
            ( SELECT v.meaning FROM sys_code_value_b_v v WHERE v.CODE = 'INVESTOR_TYPE' AND v.code_value = INVESTOR_TYPE ) INVESTOR_TYPE_N
        FROM
            hls_bp_master_shareholder hbms
        where hbms.bp_id = #{bpId}
  </select>
</mapper>