    <select id="selectExemptionReqCf" resultMap="baseResultMap" parameterType="com.hand.hls.csh.dto.HlsCusConDebtExemptionReqCf">
        SELECT
        cash.cashflow_id,
        cash.contract_id,
        cash.times,
        (select hls.description from hls_cashflow_item hls where hls.cf_item=cash.cf_item) cf_item_desc,
        (select datediff(curdate(),cash.due_date)) days,
        ccc.cashflow_id as delay_id,
        ccc.due_amount,
        ccc.received_amount,
        cf.exemption_amount
        FROM
            con_debt_exemption_req_cf cf,
            con_contract_cashflow cash,
            con_contract_cashflow ccc
        WHERE
        cash.contract_id = #{contractId}
       <if test="changeReqId !=null">
           AND cf.change_req_id= #{changeReqId}
       </if>
        AND cf.cashflow_id=cash.cashflow_id
        AND ccc.cashflow_id=cash.generated_source_doc_id
        AND ccc.cf_item !=9

    </select>
    <select id="selectExemptionReqCfById" resultMap="baseResultMap" parameterType="com.hand.hls.csh.dto.HlsCusConDebtExemptionReqCf">
        SELECT
        cf.change_req_cf_id,
        cf.change_req_id,
        cf.cashflow_id,
        cf.contract_id,
        cf.due_amount,
        cash.received_amount,
        ccc.cashflow_id as delay_id,
        (select hls.description from hls_cashflow_item hls where hls.cf_item=ccc.cf_item) cf_item_desc,
        (select datediff(curdate(),ccc.due_date)) days,
        ccc.times,
        cf.exemption_amount
        FROM
        con_debt_exemption_req_cf cf,
        con_contract_cashflow cash,
        con_contract_cashflow ccc
        WHERE
        cash.contract_id = #{contractId}
        <if test="changeReqId !=null">
            AND cf.change_req_id= #{changeReqId}
        </if>
        AND cf.cashflow_id=cash.cashflow_id
        AND cash.generated_source_doc_id=ccc.cashflow_id
        AND ccc.cf_item !=9

    </select>
    <select id="selectReqCfByCashflowId" resultMap="baseResultMap" parameterType="com.hand.hls.csh.dto.HlsCusConDebtExemptionReqCf">
        SELECT
        cf.change_req_cf_id,
        cf.change_req_id,
        cf.cashflow_id,
        cf.contract_id,
        cf.cf_item,
        cf.cf_type,
        cf.cf_direction,
        cf.cf_status,
        cf.times,
        cf.due_date,
        cf.due_amount,
        cf.principal,
        cf.interest,
        cf.exemption_amount
        FROM
        con_debt_exemption_req_cf cf
        LEFT JOIN con_debt_exemption_req req ON cf.change_req_id = req.change_req_id
        <where>
            req.req_status = 'APPROVED'
            <if test="cashflowId!=null">
                AND cf.cashflow_id=#{cashflowId}
            </if>
            <!--<if test="withdrawCfId!=null">
                AND cf.withdraw_cf_id=#{withdrawCfId}
            </if>-->
        </where>
    </select>

