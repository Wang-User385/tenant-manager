    <select id="selectConDebtExemptionReqCf" parameterType="com.hand.hls.csh.dto.HlsCusConDebtExemptionReqCf"
            resultMap="ConDebtExemptionReqCfMap">
        select v.*,(v.due_amount-v.exemption_amount) exempted_amount from (select
        t.change_req_cf_id,
        t.change_req_id,
        t.cashflow_id,
        t.contract_id,
        t.cf_item,
        t.cf_type,
        t.cf_direction,
        t.cf_status,
        t.times,
        t.due_date,
        t.due_amount,
        t.principal,
        t.interest,
        t.exemption_amount,
        (select cc.contract_number
        from con_contract cc
        where cc.contract_id = t.contract_id) contract_number,
        (select cc.contract_name
        from con_contract cc
        where cc.contract_id = t.contract_id) contract_name,
        (select  wm_concat(hls.bp_name)
        from hls_bp_master hls, con_contract cc
        where cc.contract_id=t.contract_id
        and hls.bp_id = cc.tenant_id) tenant_name,
        (select hct.description from HLS_CASHFLOW_TYPE hct where hct.cf_type = t.cf_type) cf_item_n,
        (select ccc.received_amount from con_contract_cashflow ccc where ccc.cashflow_id = t.cashflow_id) received_amount,
        (t.due_amount - (select ccc.received_amount from con_contract_cashflow ccc where ccc.cashflow_id = t.cashflow_id)) uncollected_amount

        from con_debt_exemption_req_cf t) v
        <where>
            1=1
            <if test="changeReqId != null">
                and v.change_req_id = #{changeReqId}
            </if>

            <if test="changeReqId == null">
                and v.change_req_id = 0
            </if>
        </where>


    </select>
