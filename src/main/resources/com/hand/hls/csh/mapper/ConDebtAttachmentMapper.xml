<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.csh.mapper.ConDebtAttachmentMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.csh.dto.ConDebtAttachment">
        <result column="DEBT_ATTACHMENT_ID" property="debtAttachmentId" jdbcType="DECIMAL" />
        <result column="CONTRACT_ID" property="contractId" jdbcType="DECIMAL" />
        <result column="DEBT_ATTACHMENT_CATEGORY" property="debtAttachmentCategory" jdbcType="VARCHAR" />
        <result column="DOCUMENT_NAME" property="documentName" jdbcType="VARCHAR" />
        <result column="DESCRIPTION" property="description" jdbcType="VARCHAR" />
        <result column="file_name" property="fileName" jdbcType="VARCHAR" />
        <result column="bp_type" property="bpType" jdbcType="VARCHAR" />
        <result column="yes_no" property="yesNo" jdbcType="VARCHAR" />
        <result column="value_code" property="valueCode" jdbcType="VARCHAR" />
        <result column="value_name" property="valueName" jdbcType="VARCHAR" />
        <result column="upload_person" property="uploadPerson" jdbcType="VARCHAR" />
        <result column="upload_date" property="uploadDate" jdbcType="VARCHAR" />
        <result column="file_path" property="filePath" jdbcType="VARCHAR" />
        <result column="attachment_id" property="attachmentId" jdbcType="VARCHAR" />
    </resultMap>
    <select id="selectDebtAttachmentInfo" resultMap="BaseResultMap">
        SELECT
            cda.*,
            (
                SELECT
                     fa.file_name
                FROM
                    fnd_atm_attachment fa,
                    fnd_atm_attachment_multi fam
                WHERE
                    fa.attachment_id = fam.attachment_id
                  AND fam.table_name = 'con_debt_attachment'
                  AND to_char(cda.debt_attachment_id) = fam.table_pk_value
            ) file_name
        FROM
            con_debt_attachment cda
        WHERE
            cda.debt_attachment_category = 'DEBT_EXEMPTION'
          and cda.contract_id= #{contractId}
    </select>
</mapper>
