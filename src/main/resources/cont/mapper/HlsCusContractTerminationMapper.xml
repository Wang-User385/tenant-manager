<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hand.hls.cont.mapper.HlsCusContractTerminationMapper">
    <resultMap id="BaseResultMap" type="com.hand.hls.cont.dto.HlsCusContractTermination">
        <result column="CONTRACT_TERMINATION_ID" property="contractTerminationId" jdbcType="DECIMAL"/>
        <result column="CONTRACT_ID" property="contractId" jdbcType="DECIMAL"/>
        <result column="STATUS" property="status" jdbcType="VARCHAR"/>
        <result column="DESCRIPTION" property="description" jdbcType="VARCHAR"/>
        <result column="TERMINATION_DATE" property="terminationDate"/>
        <result column="PROCESS_INSTANCE_ID" property="processInstanceId" jdbcType="DECIMAL"/>
    </resultMap>

    <select id="queryTerminationByContractId"  resultMap="BaseResultMap">
        SELECT *
        FROM con_contract_termination cct
        WHERE cct.contract_id=#{contractId}
    </select>
</mapper>