<style>
    .hls-selectBar {
        width:60px;
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 100;
    }
    .hls-selectBar ul {
        list-style: none;
        margin: 0px;
        padding: 0px;
    }
    .hls-selectBar ul li .contain {
        width: 100%;
        height: 55px;
        text-align: center;
        color: #7A849A;
        cursor: pointer;
        background-color:white;
        overflow: hidden;
        border: 1px solid #BDC4D4;
        border-bottom: none;
    }
    .hls-selectBar ul li:first-child .contain{
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }
    .hls-selectBar ul li:last-child .contain{
        border-bottom-left-radius: 15px;
        border-bottom-right-radius: 15px;
        border-bottom: 1px solid #BDC4D4;
    }
    .hls-selectBar ul li img {
        display: inline-block;
        width: 25px;
        height: 25px;
        margin-top: 10px;
        vertical-align: middle;
        background: #fff;
    }
    .text-content-right{
        height: 20px;
    }
</style>

<div>${rightNavBars}</div>


<script>
    jQuery(function () {
        jQuery(".hls-selectBar div.contain").hover(function(){
            var img = jQuery(this).find('img');
            jQuery(this).css({
                "background":"#5A7FFF",
                "color":"white"
            });
            if(jQuery(this).context.id=='display_common_button_id'){
                img[0].src=img[0].src.replace("hide-common","hide-common-hover");
                img[0].src=img[0].src.replace("display-common","display-common-hover");
                img.css({
                    "background":"#5A7FFF"
                });
            }
        },function(){
            var img = jQuery(this).find('img');
            var str = img.attr("src");
            img[0].src = img[0].src.replace("-hover.jpg",".jpg");
            img[0].src = img[0].src.replace("-hover.png",".png");
            jQuery(this).css({
                "background":"white",
                "color":"#7A849A"
            });
            if(jQuery(this).context.id=='display_common_button_id'){
                img.css({
                    "background":"#ffffff"
                });
            }
        });
    })
    new $L.RightNavBars({id:'${id}'});
