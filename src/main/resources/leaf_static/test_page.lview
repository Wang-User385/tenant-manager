<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" trace="true">
    <a:init-procedure><![CDATA[
        ]]>
    </a:init-procedure>
    <a:view template="default">
        <script language="javascript"><![CDATA[


        function test_insert_pra_date(){
            debugger;
            var contract_id = $('test_contract_id').value;

            Leaf.request({
                url: "${/request/@context_path}/con/contract/rentApportioned",
                para: {
                    contract_id: contract_id
                },
                success: function (res) {
                    alert("分摊成功")
                },
                failure: function () {
                    alert("分摊失败")
                },
                error: function () {
                    alert("分摊失败")
                }, scope: this
            });
        }


        function rzft(){
            var withdraw_id = $('withdraw_id').value;

            Leaf.request({
                url: "${/request/@context_path}/lon/contract/rentApportioned",
                para: {
                    withdraw_id: withdraw_id
                },
                success: function (res) {
                    alert("分摊成功")
                },
                failure: function () {
                    alert("分摊失败")
                },
                error: function () {
                    alert("分摊失败")
                }, scope: this
            });
        }


        function cdjk(){
            debugger;
            var withdraw_id2 = $('withdraw_id2').value;

            Leaf.request({
                url: "${/request/@context_path}/lon/contract/rentApportioned2501",
                para: {
                    withdraw_id: withdraw_id2
                },
                success: function (res) {
                    alert("分摊成功")
                },
                failure: function () {
                    alert("分摊失败")
                },
                error: function () {
                    alert("分摊失败")
                }, scope: this
            });
        }


        function abs(){
            debugger;
            var product_id1 = $('product_id1').value;

            Leaf.request({
                url: "${/request/@context_path}/ct/abs/product/abs/apportioned",
                para: {
                    product_id: product_id1
                },
                success: function (res) {
                    alert("分摊成功")
                },
                failure: function () {
                    alert("分摊失败")
                },
                error: function () {
                    alert("分摊失败")
                }, scope: this
            });
        }


        function xyz(){
            debugger;
            var product_id2 = $('product_id2').value;

            Leaf.request({
                url: "${/request/@context_path}/ct/abs/product/xyz/apportioned",
                para: {
                    product_id: product_id2
                },
                success: function (res) {
                    alert("分摊成功")
                },
                failure: function () {
                    alert("分摊失败")
                },
                error: function () {
                    alert("分摊失败")
                }, scope: this
            });
        }

        function irr(){
            debugger;
            var quotation_id = $('quotation_id').value;

            Leaf.request({
                url: "${/request/@context_path}/ct/prj/quotation/xirr/calc",
                para: {
                    quotation_id: quotation_id
                },
                success: function (res) {
                    alert("irr计算成功")
                },
                failure: function () {
                    alert("irr计算失败")
                },
                error: function () {
                    alert("irr计算失败")
                }, scope: this
            });
        }

        function queryFlow(){
            var query_date = $('query_date').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/queryFlow",
                para: {
                    query_date: query_date
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }

        function postPayment(){
            var payment_number = $('DC51').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/postPayment",
                para: {
                    payment_number: payment_number
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }
        function postCashflow(){
            var write_off_id = $('DC41').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/postCashflow",
                para: {
                    write_off_id: write_off_id
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }

        function createProjectPlan(){
            var project_number = $('project_number').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/createProjectPlan",
                para: {
                    project_number: project_number
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }
        function createContract(){
            var contract_id = $('contract_id').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/createContract",
                para: {
                    contract_id: contract_id
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }
        function matchCashflow(){
            var cashflow_id = $('cashflow_id').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/writeMatch",
                para: {
                    cashflow_id: cashflow_id
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }

        function uploatToPlat() {
            var attachmentId=$('attachmentId').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/uploatToPlat",
                para: {
                    attachmentId: attachmentId
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }
        function queryInvoiceUrl() {
            var invoice_document_number=$('invoice_document_number').value;
            Leaf.request({
                url: "${/request/@context_path}/test/interface/queryInvoiceUrl",
                para: {
                    invoice_document_number: invoice_document_number
                },
                success: function (res) {
                },
                failure: function () {
                },
                error: function () {
                }, scope: this
            });
        }
        ]]></script>

        <a:vBox style="margin:30px;">
            <a:button click="test_insert_pra_date" text="租赁月结计算按钮"/>
            <a:textField id="test_contract_id">合同id</a:textField>
        </a:vBox>

        <a:vBox style="margin:30px;">
            <a:button click="rzft" text="融资分摊"/>
            <a:textField id="withdraw_id">融资提款id</a:textField>
        </a:vBox>


        <a:vBox style="margin:30px;">
            <a:button click="cdjk" text="长期短期借款分摊"/>
            <a:textField id="withdraw_id2">融资提款id</a:textField>
        </a:vBox>


        <a:vBox style="margin:30px;">
            <a:button click="abs" text="abs分摊"/>
            <a:textField id="product_id1">abs产品id</a:textField>
        </a:vBox>


        <a:vBox style="margin:30px;">
            <a:button click="xyz" text="信用债分摊"/>
            <a:textField id="product_id2">信用债产品id</a:textField>
        </a:vBox>


        <a:vBox style="margin:30px;">
            <a:button click="xirr" text="irrxirr计算"/>
            <a:textField id="quotationId">报价id</a:textField>
        </a:vBox>

        <a:vBox style="margin:30px;">
            <a:button click="queryFlow" text="查询流水"/>
            <a:textField id="query_date" prompt="query_date">query_date</a:textField>
        </a:vBox>
        <a:vBox style="margin:30px;">
            <a:button click="postPayment" text="DC51应付报账"/>
            <a:textField id="DC51" prompt="payment_number">payment_number</a:textField>
        </a:vBox>
        <a:vBox style="margin:30px;">
            <a:button click="postCashflow" text="DC41收款数据报账"/>
            <a:textField id="DC41" prompt="write_off_id">write_off_id</a:textField>
        </a:vBox>
        <a:vBox style="margin:30px;">
            <a:button click="createProjectPlan" text="CW002"/>
            <a:textField id="project_number" prompt="project_number">project_number</a:textField>
        </a:vBox>

        <a:vBox style="margin:30px;">
            <a:button click="createContract" text="YH007-AL001"/>
            <a:textField id="contract_id" prompt="contract_id">contract_id</a:textField>
        </a:vBox>

        <a:vBox style="margin:30px;">
            <a:button click="matchCashflow" text="YH007-AL002"/>
            <a:textField id="cashflow_id" prompt="cashflow_id">cashflow_id</a:textField>
        </a:vBox>
        <a:vBox style="margin:30px;">
            <a:button click="queryInvoiceUrl" text="发票URL查询"/>
            <a:textField id="invoice_document_number" prompt="发票单据编号">invoice_document_number</a:textField>
        </a:vBox>
        <a:vBox style="margin:30px;">
            <a:button click="uploatToPlat" text="文件补传到平台"/>
            <a:textField id="attachmentId" prompt="attachment_id">attachmentId</a:textField>
        </a:vBox>
    </a:view>
</a:screen>

