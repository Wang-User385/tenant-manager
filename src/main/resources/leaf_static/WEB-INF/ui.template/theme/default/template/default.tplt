<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
<title>${page:title}</title>
<meta name="_csrf" content="${/session/@_csrf.token}"/>
<meta name="_csrf_header" content="X-CSRF-TOKEN" />
<meta name="_publicKey" content="${/session/@pubKeyString}"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
${page:html.head.css} 
${page:html.head.script}
<script src="${page:contextPath}/javascripts/leaf-plugin.js"></script>
<script src="${page:contextPath}/javascripts/calculate.js"></script>
<script src="${page:contextPath}/resource/leaf.ui.std/hap/base/jsencrypt.min.js"></script>
<script src="${page:contextPath}/javascripts/crypto-js.js"></script>
<link rel="stylesheet" href="${page:contextPath}/css/common/common_icon_font.css">
</head>
<style>
	.query-form {
	    border:1px solid #ccc;
	    margin-bottom:10px;
	    -webkit-radius:0px;
	    border-radius:0px;
	    -moz-box-shadow:none;
	    -webkit-box-shadow:none;
	    box-shadow:none;
	}
	.query-form  .query_form_head {
    	padding:5px;
    	background: url(${page:contextPath}/resource/leaf.ui.std/default/grid/grid_bg.gif) repeat-x;
    	-webkit-radius:0px;
    	border-radius:0px;
    	color:#000;
	}
	.query-form .form_body_wrap {
	    padding:5px;
	    position:absolute;
	    background-color:#fcfcfc;
	    border:1px solid #ccc;
	    z-index:21;
	    background-color: #eff0ef;
	    -webkit-radius:0px;
	    border-radius:0px;
	    -moz-box-shadow:none;
	    -webkit-box-shadow:none;
	    box-shadow:none;
	}
	.cell-editor-div{
		display:none;
	}
    .form_body_flexible{
        display: inline-block;
        overflow: hidden;
    }
    .form-bottom-flexible{
        background: url(${page:contextPath}/resources/leaf.ui.std/hap/form/flexible_add.png);
        height: 20px;
        background-repeat-x: no-repeat;
        text-align: center;
        width: 20px;
        margin: auto;
        background-size: 100% 100%;
        cursor: pointer;
        background-color: white;
        display: inline-block;
        float: right;
        margin-right: 10px;
        border-radius: 15px;
    }
    .form-bottom-flexible-div{
        display: inline-block;
        float: right;
    }
    .form-bottom-flexible-transform{
        background-image: url(${page:contextPath}/resources/leaf.ui.std/hap/form/flexible.png);
    }
</style>
<body>
    <script language="javascript">
    	/**
    	超时标志，具体操作过程为：
    	1.在default.tplt中注册timeout事件
    	2.超时时调用main.screen的showlogin方法并设置isTimeout为true
    	3.用户在login_timeout.screen输入密码，如果成功则将isTimeout重新设置为false
    	**/
    	var isTimeout = false;
        function checkFrame(){
	    	Leaf.Status.enable = false;
			Leaf.SideBar.enable = true;
            if(parent && parent.unionKey == "hap_main"){                
            }else{
                //window.location.href = '${page:contextPath}/error_wrong_entrance.lview';
            }
        }

        checkFrame();
        if(parent && parent.ajaxSuccessFunction){
			Ext.Ajax.on('requestcomplete',parent.ajaxSuccessFunction);        
        }
        
        function isIpad() {
            var ua = navigator.userAgent.toLowerCase();
            if (ua.match(/iPad/i) == "ipad") {
                return true;
            } else {
                return false;
            }
        }
        
        Leaf.manager.on('timeout',function(){
            if(top&& top.showlogin && !isTimeout){
 				isTimeout = true;
            	top.showlogin();    
            }
            return false;
        });
        
        Ext.get(document.documentElement).on('click',function(el)
        {
            if(parent && parent != self && parent.hideCurrentMenu)
            {
            	parent.hideCurrentMenu();
            }
        });

        document.onclick = function(e) {
            var fastButton = $jq(top.document.getElementById("fast_button"));
            var menuButton = $jq(top.document.getElementById("notice_menu"));
            var userDetail = $jq(top.document.getElementById("userDetail"));
            var sysTemplate = $jq(top.document.getElementById("sys_template_body"));
            var leaf_search_engine = top.jQuery(".leaf_search_engine");
            var sp_searchtext = top.jQuery("#sp-searchtext");
            if(top.disBorderInput && !jQuery(e.target).parent().hasClass("searchbox") && !jQuery(e.target).hasClass("leaf_search_engine") && !jQuery(e.target).parents().hasClass("leaf_search_engine")){
                top.disBorderInput();
            }
            if(leaf_search_engine.css("display") != 'none' && !jQuery(e.target).hasClass("leaf_search_engine") && !jQuery(e.target).parents().hasClass("leaf_search_engine")){
                if(top.searchUnMasker) {
                    top.searchUnMasker();
                }
            }
            if (fastButton.css("display") != 'none') {
                //top.jQuery(".fast_toolbar_button").css("background","none");
                top.jQuery("#fast-menu-toolbar").removeClass("fast-menu-toolbar-background");
                top.jQuery(".fast_toolbar_button").animate({height: "0px"}, function () {
                    top.jQuery(".fast_toolbar_button").hide();
                    if (parent && parent != self && parent.saveFastFunction) {
                        parent.saveFastFunction();
                    }
                });
            }
            if (sysTemplate.css("display") != 'none') {
                top.jQuery("#sys-template-toolbar").removeClass("fast-menu-toolbar-background");
                top.jQuery(".sys_template_body").animate({height: "0px"}, function () {
                    top.jQuery(".sys_template_body").hide();
                });
            }
            if (menuButton.css("display") != 'none') {
                top.jQuery("#system_notice_button").removeClass("system_notice_button_background");
                top.jQuery("#notice_menu").animate({height: "0px"}, function () {
                    top.jQuery("#notice_menu").hide();
                });
            }
            if (userDetail.css("display") != 'none') {
                if (parent && parent != self && parent.hideUserInfo) {
                    parent.hideUserInfo();
                }
            }
            var form_flexible = $jq(e.target);
            if (form_flexible.hasClass("form-bottom-flexible")) {
                if (!form_flexible.hasClass("form-bottom-flexible-n")) {
                    var form_body_flexible = $jq("#" + form_flexible.data("bind") + " .form_body_flexible");
                    var trs = form_body_flexible.find(">tr"), totalHeight = 0;
                    for (var i = 0; i < trs.length; i++) {
                        totalHeight = totalHeight + trs.eq(i).height();
                    }
                    form_body_flexible.animate({height: totalHeight + "px"});
                    form_flexible.addClass("form-bottom-flexible-n");
                    form_flexible.addClass("form-bottom-flexible-transform");
                } else {
                    var form_body_flexible = $jq("#" + form_flexible.data("bind") + " .form_body_flexible");
                    form_body_flexible.animate({height: form_body_flexible.data("height")});
                    form_flexible.removeClass("form-bottom-flexible-n");
                    form_flexible.removeClass("form-bottom-flexible-transform");
                }
            }
        }

        Leaf.onReady(function() {
            var form_body_flexible = jQuery(".form_body_flexible");
            if(form_body_flexible.length > 0){
                form_body_flexible.each(function(index,obj){
                    if(jQuery(this).data("init_flag") != "true"){
                        var trs = jQuery(obj).find("tr");
                        var hideHeight = 2;
                         if(trs.length > 3){
                            var flexible = $jq(obj.closest('table')).find('.form-bottom-flexible');
                            if(flexible){
                                flexible.removeClass('form-bottom-flexible-hidden');
                            }
                            hideHeight = trs.eq(0).height() + trs.eq(2).height()+2;
                            var adjHeight = jQuery(this).height() - hideHeight;
                            jQuery(this).height(hideHeight);
                            jQuery(this).attr("data-height",hideHeight);
                            jQuery(this).data("init_flag","true");
                            var refGrids = $jq(".item-grid-wrap");
                            for(var i=0;i<refGrids.length;i++){
                                var refGrid = $jq(refGrids[0]);
                                var refGridId = refGrid[0].id.substring(0,refGrid[0].id.length-5);
                                $L.getCmp(refGridId).setHeight($L.getCmp(refGridId).height+adjHeight);
                                $L.getCmp(refGridId).resetPageSize();
                                $L.getCmp(refGridId).dataset.query();
                            }
                        }
                    }
                });
            }
        });

    </script>
    <div></div>
	${page:init}
	${page:content}
	<input type="hidden" class="logLink" screen="${/@service_name}" value="viewlog?file=${/@SERVICE_LOGGING_FILE}"/>	
</body>
</html>