<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:parameter>
        <a:param DataType="java.lang.String" Name="ORDER_FIELD"/>
        <a:param DataType="java.lang.String" Name="ORDER_TYPE"/>
    </a:parameter>
    <a:init-procedure/>
    <a:view package="leaf.ui.std" template="default">
        <style><![CDATA[
        .lovForm .layout-th {
            font-size:11px;
        }
        ]]></style>
        <div/>
        <script language="JavaScript"><![CDATA[
            function _onLovRowselect(grid,record,row){
                $('${/parameter/@lovid}').commit(record);
            }
            function _onLovKeyDown(grid, e){
                if(e.getKey() == 13){
                    _lovok();
                }
                if(e.getKey() == 27){
                    $('${/parameter/@lovid}').commit();
                }
            }
            function _lovok(){
                var record = $('SYS_LOV_RESULT_DS').getCurrentRecord();
                $('${/parameter/@lovid}').commit(record);
            }
            function _lovquery(){
                $('SYS_LOV_RESULT_DS').query();
            }
            function lovcancle(){
                $('${/parameter/@lovid}').win.close();
            }
            var sys_lov_result_ds_load_flag  = true;
            function sys_lov_result_ds_load(ds) {
                if(sys_lov_result_ds_load_flag) {
                    $('autoGrid_${/parameter/@lovid}').setHeight($('autoGrid_${/parameter/@lovid}').height - 20);
                    sys_lov_result_ds_load_flag = false;
                }
            }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="SYS_LOV_QUERY_DS"/>
            <a:dataSet id="SYS_LOV_RESULT_DS" autoQuery="${/parameter/@lovautoquery}" pageSize="${/parameter/@lovpagesize}" queryDataSet="SYS_LOV_QUERY_DS" queryUrl="${/parameter/@url}">
                <a:events>
                    <a:event handler="sys_lov_result_ds_load" name="load"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:autoForm bindTarget="SYS_LOV_QUERY_DS" className="lovForm" column="2" enterdownHandler="_lovquery" labelWidth="${/parameter/@lovlabelwidth}" dto="${/parameter/@dto}" lovCacheKey="${/parameter/@lovCacheKey}" style="margin:7px;" title="查询条件" width="${/parameter/@innerwidth}"/>
        <!-- 增加了确定按钮-->
        <a:hBox>
            <a:button click="_lovquery" style="margin-left:5px;" text="查询"/>
            <a:button click="_lovok" style="margin-left:5px;" text="确定"/>
            <a:button click="lovcancle" style="margin-left:5px;" text="取消"/>
        </a:hBox>
        <a:autoGrid id="autoGrid_${/parameter/@lovid}" bindTarget="SYS_LOV_RESULT_DS" enablepagesize="false" height="${/parameter/@gridheight}" dto="${/parameter/@dto}" lovCacheKey="${/parameter/@lovCacheKey}" navBar="true" style="margin:7px;" width="${/parameter/@innerwidth}">
            <a:events>
                <a:event name="dblclick" handler="_onLovRowselect"/>
                <a:event name="keydown" handler="_onLovKeyDown"/>
            </a:events>
        </a:autoGrid>
    </a:view>
</a:screen>
