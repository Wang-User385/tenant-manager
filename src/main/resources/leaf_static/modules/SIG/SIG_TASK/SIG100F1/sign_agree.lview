<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: wuguobiao
    $Date: 2019-11-13
    签约批量审批-批量审批
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
    <a:link id="sign_batch_wfl_approve" url="${/request/@context_path}/sign/batch/wfl/approve"/>
        <script><![CDATA[
            // 常用审批意见 select事件
            function onSelect_general_approval_comments_combo(combo,value,display,record){
                var record = $("approval_comments_ds").data[0];
                var pre_comments = record.get("comment") || '';
                record.set("comment",pre_comments + display);
                $("approval_comment_ta").fireEvent("change",$("approval_comment_ta"),record.get("comment"),pre_comments);
            }
            // 审批意见输入栏 change事件
            function onChange_approval_comment_ta(ta,value,pre_value){
                var left_length = 300 - value.length;
                if(left_length >= 0){
                    jQuery("#comment_wordLeft").removeClass("text_warning");
                    jQuery("#comment_wordLeft").text("您还可以再输入" + left_length + "个字。");
                }else{
                    jQuery("#comment_wordLeft").text("最多只能输入300个字");
                    jQuery("#comment_wordLeft").addClass("text_warning");
                }
            }
            // 审批意见输入栏 keypress事件触发change事件
            function onKeyPress_approval_comment_ta(field,e){
                var ta = $("approval_comment_ta");
                var comment = field.el.dom.value || '';
                ta.fireEvent("change",ta,comment,'');
            }
            // 审批意见输入栏 valid
            function approval_comment_validator(record,name,value){
                if(!!value && value.length >300 ){
                    return "审批意见最多只能输入300个字！"
                }
                return true;
            }
            //提交
            function approved(){
                Leaf.showOkCancelWindow("确认","确认提交？",function () {
                    submit();
                },function () {return true;},200,200)
            }
            function submit() {
                $L.Masker.mask(Ext.getBody(),"数据提交中...");
                var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
                var selectDatas = $("${/parameter/@datasds}").getSelectedJson();
                selectDatas[0].comment = comment;
                Leaf.request({
                    url: $('sign_batch_wfl_approve').getUrl(),
                    jsonData: selectDatas,
                    success: function (res) {
                        $L.Masker.unmask(Ext.getBody());
                        if(res.success){
                            $L.showInfoMessage("提示","审批通过!");
                            $('${/parameter/@winid}').close();
                            $("${/parameter/@datasds}").query();
                        }
                    },
                    failure: function () {
                        $L.Masker.unmask(Ext.getBody());
                        $L.showInfoMessage("提示","审批失败!");
                    },
                    error: function () {
                        $L.Masker.unmask(Ext.getBody());
                        $L.showInfoMessage("提示","审批失败，服务器错误!");
                    },
                    scope: this
                });
            }
            function cancel(){
                $('${/parameter/@winid}').close();
            }
        ]]></script>
        <!--审批意见-->
        <a:dataSets>
            <!--审批常用语-->
            <a:dataSet id="general_approval_comments_ds" lookupCode="SYS_DEFAULT_WFL_COMMENT"/>
            <a:dataSet id="approval_comments_ds">
                <a:fields>
                    <a:field name="general_com"/>
                    <a:field name="general_com_cn" options="general_approval_comments_ds" displayField="code_value_name" valueField="code_value" returnField="general_com"/>
                    <a:field name="comment" validator="approval_comment_validator"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form column="1" labelWidth="160" flexible="false">
                <a:textArea bindTarget="approval_comments_ds" name="comment" id="approval_comment_ta" width="350" height="150" emptyText="请输入审批意见">
                    <a:events>
                        <a:event name="change" handler="onChange_approval_comment_ta"/>
                        <a:event name="keypress" handler="onKeyPress_approval_comment_ta"/>
                    </a:events>
                </a:textArea>
                <div id="comment_wordLeft"></div>
            </a:form>
            <a:box column="3">
                <a:box width="200"/>
                <a:gridButton click="approved" text="提交"/>
                <a:gridButton click="cancel" text="取消"/>
            </a:box>
        </a:screenBody>
    </a:view>
</a:screen>
