<?xml version="1.0" encoding="UTF-8"?>
        <!--
            $Author: lrd
            $Revision: 1.0
            $Purpose:
        -->
        <a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
            <a:init-procedure/>
            <a:view>
    <script><![CDATA[
    $L.Masker.mask(Ext.getBody(),"加载中...");
    function sig00f1_sign_count_ds_handler_query(ds, para){
        var arr = [];
        var wfl_flag = '${/parameter/@wfl_flag}';
        if(wfl_flag == 'Y'){
            arr.push('${/parameter/@project_id}');
            para['idList'] = arr;
            para['manufacturer_id'] = '${/parameter/@manufacturer_id}';
            para['credit_line_id'] = '${/parameter/@credit_line_id}';
        }else {
            var datas = $("SIG100_R_GRID_act_ru_task_ds").getSelectedJson();
            for (var i = 0; i < datas.length; i++) {
                arr.push(datas[i].business_key);
            }
            para['idList'] = arr;
            para['manufacturer_id'] = datas[0].manufacturer_id;
            para['credit_line_id'] = datas[0].credit_line_id;
        }
    }

    function sig00f1_sign_count_ds_handler_load(){
        $L.Masker.unmask(Ext.getBody());
    }

    ]]></script>
        <a:dataSets>
            <a:dataSet id="sig00f1_sign_count_ds" queryUrl="${/request/@context_path}/sign/batch/calc" autoQuery="true">
                <a:events>
                    <a:event name="query" handler="sig00f1_sign_count_ds_handler_query"/>
                    <a:event name="load" handler="sig00f1_sign_count_ds_handler_load"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:form title="投放审查">
            <a:hBox labelWidth="150">
                <a:textField name="manufacturer_name" prompt="授信厂商/合作方" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true" name="sum_not_finance_amount" prompt="累计投放余额(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true" name="credit_exposure_amt" prompt="累计投放余额(不含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true" name="sum_not_finance_total_amount" prompt="累计投放融资额(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true" name="credit_exposure_total_amt" prompt="累计投放融资额(不含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true" name="available_amt" prompt="剩余额度(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true" name="credit_available_amt" prompt="剩余额度(不含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="sum_finance_amount" prompt="融资额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_down_payment" prompt="首付款总额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_deposit" prompt="保证金总额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="sum_lease_change" prompt="合同手续费(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_lease_change_interest" prompt="贴息手续费(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_lease" prompt="手续费总额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="select_prjl_finance_amount" prompt="直接租赁总额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_prjl_finance_amount" prompt="累计直租金额(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="prjl_radio" prompt="累计直租比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="select_prjlb_finance_amount" prompt="售后回租总额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_prjlb_finance_amount" prompt="累计回租金额(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="prjlb_radio" prompt="累计回租比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="vender_amount" prompt="经销商模式金额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_vender_sum_amount" prompt="累计经销商模式金额(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="vender_radio" prompt="累计经销商模式比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="senond_amount" prompt="二手机模式金额(本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:numberField allowFormat="true"  name="sum_senond_amount" prompt="累计二手机模式金额（含在途）" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="second_radio" prompt="累计二手机模式比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="three_year_amount" prompt="3年期(含)以内(含本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="three_year_amount_rate" prompt="3年期(含)以内比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
            <a:hBox labelWidth="150">
                <a:numberField allowFormat="true"  name="five_year_amount" prompt="5年期(含)以上(含本批)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
                <a:percentField name="five_year_amount_rate" prompt="5年期(含)以上比例(含在途)" readOnly="true" bindTarget="sig00f1_sign_count_ds"/>
            </a:hBox>
        </a:form>
    </a:view>
</a:screen>
