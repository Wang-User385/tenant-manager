<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function score_result_detail_exit() {
            $('${/parameter/@winId}').close();
        }
        
        function score_result_detail_recalc() {
            // window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            $L.Masker.mask(Ext.getBody(),'正在评分...');
            var record = $('score_calculation_ds').getAt(0);
            //hls_score_calculation
            var scoreCalculation = {};
            // scoreCalculation.score_id = '';
            // scoreCalculation.company_id = '';
            scoreCalculation.objectType = record.get('object_type');
            scoreCalculation.objectId = record.get('object_id');
            // scoreCalculation.fiscalYear = '';
            // scoreCalculation.fiscalMonth = '';
            // scoreCalculation.score_date = '';
            // scoreCalculation.score_user_id = '';
            // scoreCalculation.description = '';
            // scoreCalculation.score_template_hd_id = '';
            // scoreCalculation.score_result_id = '';

            //评分
            var scoreUrl = '${/request/@context_path}/hls/score/calculation?reCalcFlag=Y&_csrf=${/session/@_csrf.token}';
            jQuery.ajax({
                type: 'post',
                url: scoreUrl,
                data: JSON.stringify(scoreCalculation),
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.success == true){
                        // 返回一个scoreId
                        scoreId = data.rows[0].scoreId;

                        if(Ext.isEmpty(scoreId)){
                            $L.showInfoMessage("提示","评分失败，请联系管理员!");
                            // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.Masker.unmask(Ext.getBody());
                            return;
                        }
                        // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.Masker.unmask(Ext.getBody());
                        //进入评分结果页面
                        var detailUrl = '${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001/prj_score_detail.lview';
                        /*new Leaf.Window({
                            id: 'prj_score_detail_winid',
                            url: detailUrl,
                            title: '评分结果',
                            params: {
                                winId: 'prj_score_detail_winid',
                                scoreId: scoreId,
                                function_code: '${/parameter/@function_code}',
                                function_usage: '${/parameter/@function_usage}'
                            },
                            fullScreen: true
                        });*/

                        var hlsScoreCalculationDetailUrl = '${/request/@context_path}/hls/score/calculation/detail/query?scoreId=' + scoreId;
                        $('score_calculation_ds').setQueryUrl(hlsScoreCalculationDetailUrl);
                        $('score_calculation_ds').query();
                    } else {
                        Leaf.showMessage("提示", data.message, null);
                        // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.Masker.unmask(Ext.getBody());
                        return;
                    }
                },
                failure: function () {
                    // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        function score_calculation_load_function(ds, e) {
            var score_calculation_ds = $('score_calculation_ds');
            var score_calculation_record = score_calculation_ds.getAt(0);
            if (score_calculation_record) {
                // $('score_result_ds').setQueryParameter("score_result_id", score_calculation_record.get('score_result_id'));
                // $('score_result_ds').query();
                var score_result_id = score_calculation_record.get('score_result_id');
                var hlsScoreResultUrl = '${/request/@context_path}/fnd/score/result/queryById?scoreResultId=' + score_result_id;
                $('score_result_ds').setQueryUrl(hlsScoreResultUrl);
                $('score_result_ds').query();

                var hlsScoreResultDtlUrl = '${/request/@context_path}/fnd/score/result/dtl/query?scoreResultId=' + score_result_id;
                $('score_result_dtl_ds').setQueryUrl(hlsScoreResultDtlUrl);
                $('score_result_dtl_ds').query();
            }
        }

        $L.onReady(function () {
            var hlsScoreCalculationDetailUrl = '${/request/@context_path}/hls/score/calculation/detail/query?scoreId=${/parameter/@scoreId}';
            $('score_calculation_ds').setQueryUrl(hlsScoreCalculationDetailUrl);
            $('score_calculation_ds').query();

            if('${/parameter/@function_usage}' == 'QUERY'){
                jQuery("#score_result_detail_recalc_btn").hide();
            }
        });
        ]]></script>
        <a:dataSets>
            <a:dataSet id="score_calculation_ds">
                <a:events>
                    <a:event name="load" handler="score_calculation_load_function"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="score_result_ds"
                       queryMethod="POST" autoQuery="false"
                       queryUrl="${/request/@context_path}/fnd/score/result/queryById"/>
            <a:dataSet id="score_result_dtl_ds" autoPageSize="true" fetchAll="true" selectable="true"
                       autoQuery="false"
                       queryUrl="${/request/@context_path}/fnd/score/result/dtl/query"/>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="score_result_detail_exit" text="退出"/>
<!--                <a:gridButton click="score_result_detail_recalc" id="score_result_detail_recalc_btn" text="重新评分"/>-->
            </a:screenTopToolbar>
            <a:form title="评级结果">
                <a:box column="4" labelWidth="140">
                    <a:textField name="object_code" bindTarget="score_calculation_ds" prompt="进件编号" readOnly="true"
                                 width="250"/>
                    <a:textField name="score_template_hd_id_n" bindTarget="score_calculation_ds" prompt="评级模板"
                                 readOnly="true" width="250"/>
                    <a:textField name="score_value" bindTarget="score_result_ds" prompt="评级得分" readOnly="true"
                                 width="250"/>
                    <!--<a:textField name="score_grade" bindTarget="score_result_ds" prompt="评级等级" readOnly="true"
                                 width="250"/>-->
                </a:box>
            </a:form>
            <a:treeGrid id="score_result_dtl_grid" bindTarget="score_result_dtl_ds" expandField="expand_flag"
                        idField="score_result_dtl_id" marginHeight="180" marginWidth="30" navBar="false"
                        parentField="parent_result_dtl_id" sequenceField="score_target_seq">
                <a:columns>
                    <a:column name="score_target_name" width="300" prompt="指标描述" align="center"/>
                    <!--<a:column name="max_score_value" width="150" prompt="指标分值" align="center"/>-->
                    <a:column name="score_target_value_name" width="300" prompt="得分描述" align="center"/>
                    <!--<a:column name="target_score" width="150" prompt="得分" align="center"/>-->
                    <!--<a:column name="target_score_grade" width="150" prompt="评级" align="center"/>-->
                </a:columns>
            </a:treeGrid>

        </a:screenBody>
    </a:view>
</a:screen>
