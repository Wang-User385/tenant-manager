<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="sig001_project_modify_id" url="${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F1/sig_project_modify.lview"/>
        <a:link id="sig002_project_modify_id" url="${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F2/sig_project_modify.lview"/>
        <a:link id="sig001_project_wfl_submit_batch_id" url="${/request/@context_path}/prj/sign/batch/wfl/submit"/>
        <a:link id="sig_retry_docx_link_id" url="${/request/@context_path}/sig/retry/generate/docx"/>
        <a:link id="prj316_reply_verify_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_reply_verify_detail.lview"/>
        <a:link id="prj316_project_risk_result_link_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_risk_result.lview"/>
        <a:link id="sig003_project_wfl_submit_batch_id" url="${/request/@context_path}/ol/package/sign/wfl/submit"/>
        <a:link id="sig001_project_resign_bpInfo_link_id" url="${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F3/sig_project_resign_bp_info.lview"/>

        <script><![CDATA[

        var sig001_view_model = {
            returnDatas: ''
        };

        Leaf.onReady(function () {
            /*var ds_id = '${/parameter/@layout_code}_F_QUERY__ds';
            var record = $(ds_id).getCurrentRecord();
            record.set('file_flag_n','是');
            record.set('file_flag','Y');

            //进件部门用户不显示提交按钮
            var unit_name='${/session/@unitName}';
            if(unit_name =='进件部门'){
                $('${/parameter/@layout_code}_sign_submit').hide();
            }*/
        });

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            if (name == 'rejected_description'){
                return '<a href="javascript:open_project_reject_description_win(\'' + record.ds.id + '\',\'' + record.id + '\')">退回理由</a>';
            }
            if (name == 'result_message'){
                return '<a href="javascript:open_reply_verify_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">规则返回明细</a>';
            }
            if (name == 'delivery_review_info') {
                return '<a href="javascript:open_project_approve_history_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#68798a">投放审查审批明细</span></a>';
            }
            return value;
        };

        //查看规则返回明细
        function open_reply_verify_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['biz_type'] = 'APPROVAL';
            param['url_title'] = '规则返回明细';
            param['function_code'] = 'PRJ316F7';
            param['winid'] = 'sig_reply_verify_detail_win';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'prj316_reply_verify_detail_id', ds_id, 'SIG001');
        }

        //审批明细跳转
        function open_project_approve_history_win(ds_id, record_id) {
            debugger
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var instance_id = param['instance_id']


            new Leaf.Window({
                id: 'PRJ419_approve_history_winid',
                params: {
                    winid: 'PRJ419_approve_history_winid',
                    id: instance_id
                },
                url: '${/request/@context_path}/modules/MYWFL/MYWFL002/process_approve_history.lview',
                title: '审批明细',
                fullScreen:true
            });


        }

        // 退回理由
        function open_project_reject_description_win(ds_id,record_id){
            var description = $(ds_id).findById(record_id).get('rejected_description');
            sig001_view_model.rejected_description = description;
            new Leaf.Window({
                id: 'sig001_project_reject_open_winid',
                params: {
                    winid: 'sig001_project_reject_open_winid'
                },
                url: '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F1/prj_project_reject_description.lview',
                title: '项目退回理由',
                width: 630,
                height: 360
            });
        }

        //签约退回
        window['${/parameter/@layout_code}_return_layout_dynamic_click'] = function () {
            var ds_id = '${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds';
            var datas = $(ds_id).getSelected();
            if(datas == null || datas.length == 0){
                $L.showInfoMessage("提示","请勾选要退回的签约数据!");
                return;
            }
            var manufacturer_code = datas[0].get('manufacturer_code');
            if(manufacturer_code == 'C000004453'){
                $L.showInfoMessage("提示","不可对三一单据在此页面进行退回操作!");
                return;
            }
            var lease_channel = datas[0].get('lease_channel');
            for(var i = 0; i < datas.length; i++){
                var data = datas[i].data;
                if(data.lease_channel !== lease_channel){
                    $L.showInfoMessage("提示","商业模式不同的数据不能一起退回!");
                    return;
                }
                if(data.sign_status !== 'NEW' && data.sign_status !== 'REJECTED' && data.sign_status !== 'CANCEL'){
                    $L.showInfoMessage("提示","只能退回投放审查状态为新建，审批拒绝或者撤回的单据!");
                    return;
                }
            }
            sig001_view_model.returnDatas = datas;
            var returnWin = new Leaf.Window({
                id: 'sig001f2_project_return_open_winid',
                params: {
                    winid: 'sig001f2_project_return_open_winid',
                    lease_channel: lease_channel,
                    parent_function_code : 'SIG001',
                    return_stage : 'SIGN'
                },
                url: '${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F2/sig_project_reject.lview',
                title: '合同签约退回',
                width: 630,
                height: 360
            });
            returnWin.on('close',function(){
                $(ds_id).query();
            });
        }

        //签约申请工作流批量提交
        window['${/parameter/@layout_code}_sign_submit_layout_dynamic_click'] = function () {
            var ds_id = '${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds';
            var datas = $(ds_id).getSelected();
            var url;
            if(datas == null || datas.length == 0){
                $L.showInfoMessage("提示","请勾选要提交审批的签约数据!");
                return;
            }

            $L.Masker.mask(Ext.getBody(),"正在提交数据...");
            var result = [];
            var results = [];
            var obj = {};
            var statusMatchMun = 0;
            for(var i = 0; i < datas.length; i++){
                result[i] = {
                    project_id: datas[i].get('project_id')
                }
                results.push(datas[i].get('project_id'));

                if(!obj[datas[i].data.lease_channel]){
                    results.push(datas[i].data.lease_channel);
                    obj[datas[i].data.lease_channel] = true;
                }

                if(datas[i].data.sign_status === 'APPROVING' || datas[i].data.sign_status == 'APPROVED'
                    || datas[i].data.sign_status === 'CANCEL'){
                    statusMatchMun++;
                }
            }
            if (statusMatchMun > 0){
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.showMessage('提示！', '只有投放审查状态为 新建 或 审批退回 的数据才能发起投放审查申请!');
                return;
            }
            if (results.indexOf('40') !== -1) {
                if (results.indexOf('10') !== -1 || results.indexOf('20') !== -1) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.showMessage('提示！', '经营租赁和融资租赁的进件不能同时提交!');
                    return;
                }
            }
            if (datas[0].data.lease_channel === '40') {
                url = $('sig003_project_wfl_submit_batch_id').getUrl()
                result = {projectIdList: results.join(',')}
            } else {
                url = $('sig001_project_wfl_submit_batch_id').getUrl();
            }

            Leaf.request({
                url: url,
                para: result,
                success: function (res) {
                    if(res.error.message && res.error.message != ''){
                        $L.showInfoMessage("提示",res.error.message,null,1000,800);
                    }else {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                    }
                    $(ds_id).query();
                    Leaf.Masker.unmask(Ext.getBody());

                    // if(res.success) {
                    //     $(ds_id).query();
                    //     Leaf.Masker.unmask(Ext.getBody());
                    //     $L.showInfoMessage("提示", "单据提交成功!");
                    // }
                },
                failure: function () {
                    $(ds_id).query();
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    $(ds_id).query();
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //审批表打印
        window['${/parameter/@layout_code}_sign_docx_layout_dynamic_click'] = function () {
            var ds_id = '${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds';
            var datas = $(ds_id).getSelected();
            if(datas == null || datas.length == 0){
                $L.showInfoMessage("提示","请勾选要打印的签约数据!");
                return;
            }
            //$L.Masker.mask(Ext.getBody(),"正在打印");
            var str = "";
            for(var i = 0; i < datas.length; i++){
                str += datas[i].get('project_id') + ",";
            }
            str = str.substring(0,str.length-1);
            var a = $jq("#sig001_sign_docx_a")[0];
            a.href = "${/request/@context_path}/prj/sign/create/docx?projectIdStr="+str;
            a.click();
        }
        //签约维护
        function open_project_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var lease_channel = record.get('lease_channel');
            var function_code = 'SIG001F1',link_id = 'sig001_project_modify_id';
            /*if(record.get('lease_channel') == 20){
                function_code = 'SIG001F2';
                link_id = 'sig002_project_modify_id';
            }*/
            var param = record.data;
            param['url_title'] = '投放审查明细';
            param['function_code'] = function_code;
            param['winid'] = 'sign_project_modify_winid';
            var sign_status = record.get('sign_status');
            var division = record.get('division');
            /*if (division === 'PHOTOVOLTAIC_DEVICES' && lease_channel === '10') {
                param['function_usage'] = 'QUERY';
                param['parent_layout_code'] = 'SIG001';
            }*/
            //if (sign_status === 'APPROVING' || sign_status === 'APPROVED') {
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['submit_hide'] = true;
            //}
            /*if (lease_channel === '40') {
                param['parent_layout_code'] = 'SIG001';
            }*/
            hls_doc_get_layout_code(param, link_id, ds_id, function_code);
        }

        //查询时调用(grid,table,gridBox)
        var load_flag = 1
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            debugger
            if (ds_id == ds.id) {
                // if (load_flag <= 2){
                //     load_flag = load_flag+1
                //     $(ds_id).closeQuery()
                // }else {
                //     $(ds_id).setQueryParameter('user_id', '${/session/@user_id}');
                // }
                qpara['created_by'] = '${/session/@user_id}';
            }
        };

        //客户评级
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //$L.Masker.mask(Ext.getBody(),'正在评分...');
            var prj_project_ds_id = '${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds';
            var selectRecords = $(prj_project_ds_id).getSelected();
            if(selectRecords.length != 1){
                $L.showInfoMessage("提示","请勾选一条要评分的数据!");
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                //$L.Masker.unmask(Ext.getBody());
                return;
            }

            var record = selectRecords[0];
            //hls_score_calculation
            var scoreCalculation = {};
            // scoreCalculation.score_id = '';
            // scoreCalculation.company_id = '';
            scoreCalculation.objectType = 'PRJ_PROJECT';
            scoreCalculation.objectId = record.get('project_id');
            // scoreCalculation.fiscalYear = '';
            // scoreCalculation.fiscalMonth = '';
            // scoreCalculation.score_date = '';
            // scoreCalculation.score_user_id = '';
            // scoreCalculation.description = '';
            // scoreCalculation.score_template_hd_id = '';
            // scoreCalculation.score_result_id = '';

            var lease_channel = record.get('lease_channel');
            if (lease_channel === '40') {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                $L.showInfoMessage("提示","经营租赁合同无需评分!");
                return;
            }

            //评分
            var scoreUrl = '${/request/@context_path}/hls/score/calculation?reCalcFlag=Y&_csrf=${/session/@_csrf.token}';
            jQuery.ajax({
                type: 'post',
                url: scoreUrl,
                data: JSON.stringify(scoreCalculation),
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.success == true){
                        // 返回一个scoreId
                        scoreId = data.rows[0].scoreId;

                        if(Ext.isEmpty(scoreId)){
                            $L.showInfoMessage("提示","评分失败，请联系管理员!");
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            //$L.Masker.unmask(Ext.getBody());
                            return;
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        //进入评分结果页面
                        var detailUrl = '${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001/prj_score_detail.lview';
                        new Leaf.Window({
                            id: 'prj_score_detail_winid',
                            url: detailUrl,
                            title: '评分结果',
                            params: {
                                winId: 'prj_score_detail_winid',
                                scoreId: scoreId,
                                function_code: '${/parameter/@function_code}',
                                function_usage: '${/parameter/@function_usage}'
                            },
                            fullScreen: true
                        });
                    } else {
                        Leaf.showMessage("提示", data.message, null);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        //$L.Masker.unmask(Ext.getBody());
                        return;
                    }
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        };

        //风险引擎结果查看
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project'),
                select_datas = $(ds_id).getSelected();
            if(select_datas.length === 0){
                Leaf.showMessage('提示！', '至少选择一行!');
                return;
            }
            var saveResultData = [];
            for (var i = 0; i < select_datas.length; i++) {
                saveResultData.push(select_datas[i].get('project_id'));
                if (select_datas[i].get('lease_channel') === '40') {
                    $L.showMessage("提示","经营租赁合同包无需查看预审结果");
                    return;
                }
            }
            var param = {};
            param['records'] = saveResultData.join(',');
            param['url_title'] = '风险引擎结果查看';
            param['function_code'] = 'PRJ316F11';
            hls_doc_get_layout_code(param, 'prj316_project_risk_result_link_id', ds_id, 'PRJ316F11');
        }
        ]]></script>
        <a id="sig001_sign_docx_a" href="${/request/@context_path}/prj/sign/create/docx" style="display:none;"></a>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
