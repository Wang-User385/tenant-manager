        function getDivision() {
            currentDivision = '${/parameter/@division}'
            let contractNumber;
            if (!currentDivision) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('prj316f2_prj_get_divison_id').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber,projectId:'${/parameter/@project_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            currentDivision = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        function getManufacturerCode() {
            manufacturerCode = '${/parameter/@manufacturer_code}'
            let contractNumber;
            if (!manufacturerCode) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('prj316f2_prj_get_manufacturer_code').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber,projectId:'${/parameter/@project_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            manufacturerCode = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

