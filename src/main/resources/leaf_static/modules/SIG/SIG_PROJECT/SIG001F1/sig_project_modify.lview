                hls_doc_get_layout_code(param, 'PRJ419_project_modify_new_id', ds_id, 'PRJ419');
            }

        }
        //附件
        var win;

        function sig001_open_attach(project_attachment_id,table_name,document_name, th_back_flag,attach_code) {
            var prj_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds).getCurrentRecord();
            var name = prj_record.data.manufacturer_id_n;
            var url;
            var query_flag = '${/parameter/@function_usage}';
            var parent_layout_code = '${/parameter/@parent_layout_code}';
            var submit_hide = '${/parameter/@submit_hide}';
            var work_flow = '${/parameter/@work_flow}';
            var node_id = '${/parameter/@node_id}';

            //当天合单据的投放审查状态为“待审批”、“审批拒绝”和“撤回”时，系统允许业务经理编辑《中登网办理抵押登记照片》、《并网照片》、《保险（综合险）》等三个附件
            if(name === '江苏天合智慧分布式能源有限公司' && submit_hide !=true && (attach_code === 'TH_C_04' || attach_code === 'TH_C_05' || attach_code === 'TH_C_06')){
                url = '${/request/@context_path}/uploadFile.lview';
            }else {
                if ((query_flag === 'QUERY' && (currentDivision !== 'PHOTOVOLTAIC_DEVICES' || (currentDivision === 'PHOTOVOLTAIC_DEVICES' && parent_layout_code === 'SIG001' && submit_hide)))
                    || table_name === 'PRJ_PROJECT_DOCX'
                    || th_back_flag === 'Y') {
                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';
                }
            }
            if(document_name == '审查文件'){
                url = '${/request/@context_path}/downloadFile.lview';
                query_flag = 'QUERY';
            }
            //厂商风险审查流程,投放审查流程 ，风险审查岗位，资管部负责人,投放审查岗节点可以上传下载附件“审查文件”
            if(document_name == '审查文件' && (node_id  == 'sid-NADqOrSA-McJQ-4fHc-8uYZ-BKWVs7HBI46d'  || node_id == 'sid-jN5Ah6L5-KH8s-42iD-88b0-RquXNoZVcvvN'||
                node_id == 'sid-QEd1QUWf-46Bo-4RUr-8G0I-bH5cZ9VKnVKo' ) ){
                url = '${/request/@context_path}/uploadFile.lview';
                query_flag = '${/parameter/@function_usage}';
            }
            win = new Leaf.Window({
                id: 'sig001_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: '${/request/@context_path}/downloadFile.lview',
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table_name,
                    winid: 'sig001_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id;
                if (currentDivision === 'PHOTOVOLTAIC_DEVICES' || manufacturerCode == 'C000004453') {
                    ds_id = "${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds";
                } else {
                    ds_id = "${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds";
                }
                $(ds_id).query();
            });
        }

        function PRJ419_open_attach(project_attachment_id, table_name,document_name,th_back_flag) {
            debugger;
            var url;
            var function_usage = '${/parameter/@function_usage}';
            var parent_layout_code = '${/parameter/@parent_layout_code}';
            var submit_hide = '${/parameter/@submit_hide}';
            var work_flow = '${/parameter/@work_flow}';
            var node_id = '${/parameter/@node_id}';
            if (function_usage === 'QUERY'&&('${/parameter/@sign_status}'!='REJECTED'&&'${/parameter/@sign_status}'!='NEW')) {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            win = new Leaf.Window({
                id: 'PRJ419_open_attachment_winid',
                url: url,
                params: {
                    header_id: project_attachment_id,
                    table_name: table_name,
                    winid: 'PRJ419_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                debugger
                var ds_id;
                if (currentDivision === 'PHOTOVOLTAIC_DEVICES' || manufacturerCode == 'C000004453') {
                    ds_id = "${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds";
                } else {
                    ds_id = "${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds";
                }
                $(ds_id).query();
                if(parent_layout_code=='PRJ329'){
                    record.getField('document_name').setReadOnly(false);
                    record.getField('description').setReadOnly(false);
                }
            });
        }
        //报价
        function sig001_open_price(dsId,record_id, quotationId) {
            if ($(dsId).validate()) {
                if (quotationId != 'undefined') {
                    //打开报价窗口
                    var price_list = $(dsId).findById(record_id).get("price_list");
                    var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotationId+"&priceList="+price_list;
                    url = url + '&readOnly=Y';
                    var win = new Leaf.Window({
                        id: 'sig001_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                        $(ds_id).query();
                    });
                } else {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
        }

