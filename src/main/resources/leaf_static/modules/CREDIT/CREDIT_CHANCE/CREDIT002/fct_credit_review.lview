<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-17
    $Description: 授信管理 - 授信评审
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fct_credit_open_detail_id"
                url="${/request/@context_path}/modules/CREDIT/CREDIT_CHANCE/CREDIT002/fct_credit_review_detail.lview"/>
        <script><![CDATA[

        function credit001_detail_open(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.credit_line_status;
            var type = (status === "APPROVING" || status === 'APPROVED') ? 'QUERY' : 'MODIFY';
            param['url_title'] = '授信评审明细';
            param['function_code'] = 'CREDIT002F1';
            param['function_usage'] = type;
            param['credit_line_id'] = param.credit_line_id;
            param['bp_id'] = param.bp_id;
            param['winid'] = 'fct_credit_review_detail_winid';
            param['ds'] = ds_id;
            var link_id = 'fct_credit_open_detail_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'CREDIT002');
        }

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'credit001_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'credit_line_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
