<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-22
    $Description: 工作流跳转页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="link_id"
                url="${/request/@context_path}/modules/CREDIT/CREDIT_CHANCE/CREDIT002/fct_credit_review_detail.lview"/>
        <script><![CDATA[
        var pageChooser = new PageChooser({
            url: $('link_id').getUrl() + '?function_code=CREDIT002F1',
            function_code: 'CREDIT002F1',
            context_path: '${/request/@context_path}',
            opt: {
                credit_line_id: "${/parameter/@businessKey}",
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

