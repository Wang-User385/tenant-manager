<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="bill001f5_query_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_request_wfl.lview"/>
        <a:link id="bill001f1_entrance_create_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_request_create.lview"/>
        <a:link id="bill001f2_query_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_request_create_detail.lview"/>
        <a:link id="bill001f3_new_modify_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_request_detail_modify.lview"/>
        <a:link id="bill001f3_bank_modify_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_bank_detail_modify.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bill_request');
            var param = {};
            param['url_title'] = '票据开具申请创建入口';
            param['function_code'] = 'BILL001F1';
            param['function_usage'] = 'CREATE';
            param['screen_width'] = '900';
            param['screen_height'] = '700';
            param['function_usage'] = 'CREATE';
            param['winid'] = 'hls_bill_request_create_winId';
            hls_doc_get_layout_code(param, 'bill001f1_entrance_create_link_id', ds_id, 'BILL001');
        };


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            if (name == 'bill_apply_number' && value) {
                return '<a href="javascript:open_apply_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            } else if (name == 'detail') {
                return '<a href="javascript:open_detail_win3(\'' + record.ds.id + '\',\'' + record.id + '\')">兑付/解付明细</a>';
            } else if (name == 'bank_detail') {
                return '<a href="javascript:open_bank_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">保证金账户明细</a>';
            }

            return value;
        };

        function open_bank_detail_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'BILL001F7';
            param['url_title'] = '保证金账户明细维护';
            param['function_usage'] = 'MODIFY';
            hls_doc_get_layout_code(param, 'bill001f3_bank_modify_link_id', ds_id, 'BILL001F3');

        }

        function open_apply_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            if (param['bill_status'] == 'NEW' || param['bill_status'] == 'APPROVED_RETURN' || param['bill_status'] == 'REJECTED') {
                param['function_code'] = 'BILL001F2';
                param['url_title'] = '票据开具申请维护明细';
                param['function_usage'] = 'MODIFY';
                hls_doc_get_layout_code(param, 'bill001f2_query_link_id', ds_id, 'BILL001F2');
            } else {
                param['function_code'] = 'BILL001F5';
                param['url_title'] = '票据开具申请查询';
                param['function_usage'] = 'QUERY';
                hls_doc_get_layout_code(param, 'bill001f5_query_link_id', ds_id, 'BILL001F2');
            }


        }


        function open_detail_win3(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'BILL001F3';
            param['url_title'] = '票据到期兑付/解付明细维护';
            param['function_usage'] = 'MODIFY';
            hls_doc_get_layout_code(param, 'bill001f3_new_modify_link_id', ds_id, 'BILL001F3');

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
