<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fin003_lon_create_id1"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <a:link id="CSH007_create_detail_id1"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_detail.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bill_request');
            if (ds_id == ds.id) {
                ds.setQueryParameter('bill_id', '${/parameter/@bill_id}');
                $(ds_id).query
            }
        };



        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            debugger;
         if(name=='actual_bill_date' && '${/parameter/@function_code}'=='BILL001F4'){
                if(record.get('curreny')=='CNY'){

                    record.set('exchange_rate',1);
                    record.set('bill_amount_yuan',record.get('bill_amount'));
                    record.set('marge_amount',record.get('bill_amount')*record.get('marge_level')/100);
                    record.set('margin_balance',record.get('bill_amount')*record.get('marge_level')/100)

                }else{
                    Leaf.request({
                        url: '${/request/@context_path}/hls/bill/request/dailyrate/query',
                        para: {
                            curreny:record.get('curreny'),
                            payment_discharge_date: record.get('actual_bill_date')

                        },
                        success: function (res) {
                            if(res.success){

                                var  amount =res.result.record[0].daily_rate;

                                    var  amount1=record.get('bill_amount')*amount;
                                    var amount2=amount1*record.get('charge_rate');
                                    debugger;
                                    record.set('exchange_rate',amount);
                                    record.set('bill_amount_yuan',amount1);

                                    record.set('service_charge',amount2);

                                record.set('marge_amount',amount1*record.get('marge_level')/100)
                                record.set('margin_balance',amount1*record.get('marge_level')/100)


                            }else{

                                $L.showInfoMessage("提示", "未找到汇率!", null);


                            }
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });

                }
            }
            if(name=='charge_rate' && '${/parameter/@function_code}'=='BILL001F4'){
                record.set('service_charge',record.get('bill_amount_yuan')*record.get('charge_rate'));

            }
        }
        function open_loan_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '租赁合同查询';

            param['function_code'] = 'FIN003F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['hidden_button_code'] = ['save', 'submit_approval'];
            param['winid'] = 'lon_contract_modify_winid';
            param['contract_id'] = record.get('loan_contract_id');
            param['document_id'] = record.get('loan_contract_id');
            param['company_id'] = '${/session/@companyId}';
            hls_doc_get_layout_code(param, 'fin003_lon_create_id1');

        }
        function open_detail_win4(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['payment_req_id'] = record.get('payment_req_id');
            param['function_code'] = 'CSH008F1';
            param['url_title'] = '付款支付明细查询';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'csh_repayment_req_create_winId';
            param['parent_winid'] = 'csh_repayment_req_create_winId_close';

            hls_doc_get_layout_code(param, 'CSH007_create_detail_id1');


        }




        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            var link_function;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

            if (name == 'loan_contract_number') {
                return '<a href="javascript:open_loan_win(\'' + record.ds.id + '\',\'' + record.id + '\')">融资合同明细</a>';
            }else if (name == 'payment_req_number') {
                return '<a href="javascript:open_detail_win4(\'' + record.ds.id + '\',\'' + record.id + '\')">付款明细</a>';
            } if (name == 'upload') {
                link_function = '${/parameter/@layout_code}_attachment_detail';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + config_record.get('prompt') + '</a>';
            }

            return value;
        };
        /*附件上传超链接函数*/
        window['${/parameter/@layout_code}_attachment_detail'] = function (record_id, name) {

            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            if (record.get('bill_attachment_id')){
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY') {

                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';

                }
                var win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('bill_attachment_id'),
                        table_name: 'hls_bill_request_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bill_request_attachment');
                    $(ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }
        function beforeSubmit(countiune) {
        debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bill_request');
            if($(ds_id).validate()) {
                $(ds_id).submit();
                countiune();
                return true;

            }else{
                return false;
            }

        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>