<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: wangchao7709
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[


        function setPassword(value, record, name){
            var passwd ='';
            if(typeof(record.get('password')) != 'undefined' ){
                for(var i=0; i<value.length ; i++){
                    passwd = passwd + '●';
                }
                return passwd;
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="itfc005_eas_login_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/eas/login/query"
                       submitUrl="${/request/@context_path}/eas/login/submit"
                       deleteUrl="${/request/@context_path}/eas/login/remove"  queryDataSet="itfc005_eas_login_query_ds" selectable="true">
                <a:fields>
                    <a:field name="user_name"/>
                    <a:field name="password"/>
                    <a:field name="sln_name"/>
                    <a:field name="dc_name"/>
                    <a:field name="language"/>
                    <a:field name="db_type"/>
                    <a:field name="auth_pattern"/>
                    <a:field name="ip_address"/>
                    <a:field name="port"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton bind="itfc005_eas_login_grid_id" type="add"/>
                <a:gridButton bind="itfc005_eas_login_grid_id" type="save" />
                <a:gridButton bind="itfc005_eas_login_grid_id" type="delete"/>
                <a:gridButton bind="itfc005_eas_login_grid_id" type="refresh"/>

            </a:screenTopToolbar>

            <a:grid id="itfc005_eas_login_grid_id" bindTarget="itfc005_eas_login_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>

                    <a:column name="user_name" align="right" autoAdjust="true" width="100"
                              prompt="用户名" editor="itfc005_eas_login_grid_textfield"/>
                    <a:column name="password" align="right" autoAdjust="true" width="100"
                              prompt="密码" editor="password_grid_password" renderer="setPassword"/>

                    <a:column name="sln_name" align="right" autoAdjust="true" width="100"
                              prompt="解决方案" editor="itfc005_eas_login_grid_textfield"  />

                    <a:column name="dc_name" align="right" autoAdjust="true" width="100"
                              prompt="数据中心" editor="itfc005_eas_login_grid_textfield"/>

                    <a:column name="language" align="right" autoAdjust="true" width="100"
                              prompt="语言" editor="itfc005_eas_login_grid_textfield"/>

                    <a:column name="db_type" align="right" autoAdjust="true" width="100"
                              prompt="数据库类型" editor="itfc005_eas_login_grid_numberField"/>
                    <a:column name="auth_pattern" align="right" autoAdjust="true" width="100"
                              prompt="验证方式" editor="itfc005_eas_login_grid_textfield"/>

                    <a:column name="ip_address" align="right" autoAdjust="true" width="100"
                              prompt="IP地址" editor="itfc005_eas_login_grid_textfield"/>

                    <a:column name="port" align="right" autoAdjust="true" width="100"
                              prompt="端口号" editor="itfc005_eas_login_grid_textfield"/>
                </a:columns>
                <a:editors>
                    <a:textField id="itfc005_eas_login_grid_textfield"/>
                    <a:numberField id="itfc005_eas_login_grid_numberField"/>
                    <a:datePicker id="itfc005_eas_login_grid_datePicker"/>
                    <a:checkBox id="itfc005_eas_login_grid_checkBox"/>
                    <a:passWord id="password_grid_password"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>