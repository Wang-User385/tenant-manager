<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_itfc_bank_flow');
            //debugger;
            if (ds.id === ds_id && record) {
                if (record.get('io_code') == 'AL002' && record.get('deal_status') == 'N'
                    && (record.get('rival_account_id') == '' || record.get('rival_account_id') == null || record.get('rival_account_id') == undefined)) {
                    record.getField('bp_id').setReadOnly(false);
                    record.getField('bp_id_n').setReadOnly(false);
                }else{
                    record.getField('bp_id').setReadOnly(true);
                    record.getField('bp_id_n').setReadOnly(true);
                }
            }
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_itfc_bank_flow');
            var records = $(ds_id).getAll();
            var array = $(ds_id).getAll().map((v)=>v.data);

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/hls/itfc/bank/flow/dealRivalAccount',
                para: array,
                success: function (datas) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '保存成功');
                    $(ds_id).query();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>