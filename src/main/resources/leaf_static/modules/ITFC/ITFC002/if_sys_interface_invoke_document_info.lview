<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[



        ]]></script>
        <a:dataSets>
            <a:dataSet id="if200_document_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/ws/document/record/by/outboundId/query?outboundId=${/parameter/@outboundId}" selectable="true">

                <a:fields>
                    <a:field name="source_table"/>
                    <a:field name="source_id"/>
                    <a:field name="mark"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>

            <a:form labelwidth="110" title="单据信息" labelWidth="100">
                <a:grid id="itfc007f1_document_info_grid_id" bindTarget="if200_document_info_ds" marginHeight="200"
                        marginWidth="600" navBar="true">
                    <a:columns>

                        <a:column name="source_table" align="left" autoAdjust="true" width="200"
                                  prompt="数据来源表" />
                        <a:column name="source_id" align="left" autoAdjust="true" width="100"
                                  prompt="来源ID" />
                        <a:column name="mark" align="left" autoAdjust="true" width="500"
                                  prompt="备注" />
                    </a:columns>
                </a:grid>
            </a:form>

        </a:screenBody>
    </a:view>
</a:screen>
