<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="lon_withdraw_change_detail_link"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create_detail.lview"/>
        <script><![CDATA[

        //debugger;
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        var param = parent.currentTaskInfo.execution_variables;

        var changeReqIds = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "changeReqId";
        });
        var oldWithdrawIds = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "oldWithdrawId";
        });
        var oldWithdrawId = oldWithdrawIds[0].value;

        var contractIds = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "contractId";
        });
        var contractId = contractIds[0].value;
        var oldContractIds = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "oldContractId";
        });
        var oldContractId = oldContractIds[0].value;
        //console.log(param);
debugger;
        var pageChooser = new PageChooser({
            url: $('lon_withdraw_change_detail_link').getUrl(),
            function_code: 'FIN003T2',
            context_path: '${/request/@context_path}',
            opt: {
                businessKey : businessKey,
                withdraw_id: businessKey,
                old_withdraw_id: oldWithdrawId,
                contract_id:contractId,
                old_contract_id: oldContractId,
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: 'FIN003T2'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

