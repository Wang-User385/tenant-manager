<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="fin003_change_entrance_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create.lview"/>
        <a:link id="fin003_lon_create_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <a:link id="fin003s_detail_back_link_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_home.lview"/>
        <script><![CDATA[

        var query_flag = 'Y';
        var withdraw_id = '${/parameter/@withdrawId}'
        var financingTermTo='${/parameter/@financingTermTo}'

        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var quotation_ds_id = '${/parameter/@layout_code}_F_QUOTATION_INFO_lon_contract_quotation_ds';
            if (ds.id === quotation_ds_id && ('${/parameter/@function_usage}' !== 'QUERY')) {
                //测算类型为手工测算，还款方式只读
                var measure_type = $(quotation_ds_id).getCurrentRecord().get('measure_type');
                if(measure_type == 'SYSTEM_ESTIMATION'){
                    $(quotation_ds_id).getCurrentRecord().getField('price_list').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list_n').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list').setRequired(true);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list_n').setRequired(true);
                    $(quotation_ds_id).getCurrentRecord().getField('calc_interest_year_days').setRequired(true);
                    $(quotation_ds_id).getCurrentRecord().getField('calc_interest_year_days_n').setRequired(true);
                    $(quotation_ds_id).getCurrentRecord().getField('calc_interest_year_days').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('calc_interest_year_days_n').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle_n').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle').setRequired(true);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle_n').setRequired(true);

                }else if(measure_type == 'HAND_ESTIMATION'){
                    $(quotation_ds_id).getCurrentRecord().getField('price_list').setRequired(false);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list_n').setRequired(false);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().getField('price_list_n').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().set('price_list','PAY_BY_NO_RULE');
                    $(quotation_ds_id).getCurrentRecord().set('price_list_n','不规则还款');
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle').setRequired(false);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle_n').setRequired(false);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().getField('interest_cycle_n').setReadOnly(true);
                }

                var int_rate_type = $(quotation_ds_id).getCurrentRecord().get('int_rate_type');
                if (int_rate_type == 'FIXED') {
                    var  record = $(quotation_ds_id).getCurrentRecord();
                    record.getField('base_rate').setReadOnly(true);
                    record.getField('base_rate').setRequired(false);
                    record.getField('base_rate_type').setReadOnly(true);
                    record.getField('base_rate_type').setRequired(false);
                    record.getField('base_rate_type_n').setReadOnly(true);
                    record.getField('base_rate_type_n').setRequired(false);
                    /*record.getField('floating_way').setReadOnly(true);
                    record.getField('floating_way').setRequired(false);
                    record.getField('floating_way_n').setReadOnly(true);
                    record.getField('floating_way_n').setRequired(false);*/
                    record.getField('floating_way_range').setReadOnly(true);
                    record.getField('floating_way_range').setRequired(false);
                    record.getField('floating_range_method').setReadOnly(true);
                    record.getField('floating_range_method_n').setReadOnly(true);

                } else {
                    var  record = $(quotation_ds_id).getCurrentRecord();
                    record.getField('base_rate').setReadOnly(false);
                    record.getField('base_rate').setRequired(true);
                    record.getField('base_rate_type').setReadOnly(false);
                    record.getField('base_rate_type').setRequired(true);
                    record.getField('base_rate_type_n').setReadOnly(false);
                    record.getField('base_rate_type_n').setRequired(true);
                    /*record.getField('floating_way').setReadOnly(false);
                    record.getField('floating_way').setRequired(true);
                    record.getField('floating_way_n').setReadOnly(false);
                    record.getField('floating_way_n').setRequired(true);*/
                    record.getField('floating_way_range').setReadOnly(false);
                    record.getField('floating_way_range').setRequired(true);
                    record.getField('floating_range_method').setReadOnly(false);
                    record.getField('floating_range_method_n').setReadOnly(false);
                }

                var serve_flag = $(quotation_ds_id).getCurrentRecord().get('serve_flag');
                if (serve_flag == 'N') {
                    $(quotation_ds_id).getCurrentRecord().getField('serve_currency_code_n').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_amount').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_rate').setReadOnly(true);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_method_n').setReadOnly(true);

                } else {
                    $(quotation_ds_id).getCurrentRecord().getField('serve_currency_code_n').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_amount').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_rate').setReadOnly(false);
                    $(quotation_ds_id).getCurrentRecord().getField('serve_method_n').setReadOnly(false);

                }

                var interest_cycle = $(quotation_ds_id).getCurrentRecord().get('interest_cycle');
                if (interest_cycle == 'MONTH' || interest_cycle == 'BEGINNING_OF_PERIOD' || interest_cycle == 'EXPIRE_OF_PERIOD'  ) {

                    $(quotation_ds_id).getCurrentRecord().getField('interest_month_n').setReadOnly(true);
                } else {
                    $(quotation_ds_id).getCurrentRecord().getField('interest_month_n').setReadOnly(false);
                }

                if('${/parameter/@baseRate}'!=undefined && '${/parameter/@baseRate}' !=null && '${/parameter/@baseRate}' != '' && '${/parameter/@function_usage}' =='CREATE'){
                    $(quotation_ds_id).getCurrentRecord().set('base_rate', '${/parameter/@baseRate}');
                }

            }

            var contract_id = '${/parameter/@contractId}';
            var withdraw_id = '${/parameter/@withdrawId}';
            if ('${/parameter/@withdrawStatus}' != null && '${/parameter/@withdrawStatus}' != 'undefined' || '${/parameter/@withdrawStatus}' != '') {
                var withdraw_status = '${/parameter/@withdrawStatus}';
            } else {
                var withdraw_status = 'NEW';
            }
            var base_ds_id = '${/parameter/@layout_code}_F_BASE_lon_contract_ds';
            if (ds.id === base_ds_id) {
                $(base_ds_id).getCurrentRecord().set('company_full_name', '${/session/@companyName}');
                $(base_ds_id).getCurrentRecord().set('lon_company_id', '${/session/@companyId}');

            }

            if (query_flag == 'Y') {
                query_flag = 'N';
                var lon_contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/contract/withdraw/formData',
                    para: {
                        contract_id: contract_id,
                        withdraw_id: withdraw_id
                    },

                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        if (ds.id == lon_contract_ds_id) {
                            setRecordValue(record, res.result.record[0]);
                        }

                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });

                ds.setQueryParameter('contract_id', contract_id);
                ds.setQueryParameter('withdraw_id', withdraw_id);
                ds.query();

            }

        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {

            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');

            var base_record = $(base_ds_id).getCurrentRecord();
            if (ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_bank_account')) {
                record.set('bp_id',base_record.get("credit_bp_id"));
            }
            else if (ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment','G_REPAYMENT_FIN_INFO')) {
                var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');
                if($(quotation_ds_id).getCurrentRecord().get("due_amount") && record.get('proportion')){
                    record.set('planned_due_amount',$(quotation_ds_id).getCurrentRecord().get("due_amount")*record.get('proportion'));
                }
            }

        };

        function getMonthsBetween(startTime,endTime) {debugger;
            startTime=new Date(startTime);
            endTime=new Date(endTime);
            var date2Mon;
            var startDate=startTime.getDate()+startTime.getHours()/24+startTime.getMinutes()/24/60;
            var endDate=endTime.getDate()+endTime.getHours()/24+endTime.getMinutes()/24/60;
            if(endDate>startDate){
                date2Mon=1;
            }else{
                date2Mon=0;
            }
            return (endTime.getYear()-startTime.getYear())*12+endTime.getMonth()-startTime.getMonth()+1/*+date2Mon*/;

        }


        function onchange_base_rate_type(cb, value, old_value) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');
            var quotation_result_ds = $(ds_id);
            var record = quotation_result_ds.getAt(0);


            var baseRateType = '';
            baseRate = getBaseRate(record.get('base_rate_type'), record.get("due_date"));
            record.set('base_rate', baseRate);
        }

        function getBaseRate(base_rate_type, due_date) {
            var baseRate = null;
            Leaf.request({
                url: '${/request/@context_path}/fnd/baserateset/queryForFinanceQuotation',
                para: {
                    baseRatetype: base_rate_type,
                    due_date: due_date
                },
                sync: true,
                success: function (datas) {
                    if (datas.result.record.length > 0) {
                        baseRate = datas.result.record[0];
                    }
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
            return baseRate;
        }


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var quotation_ds_id = '${/parameter/@layout_code}_F_QUOTATION_INFO_lon_contract_quotation_ds';
            if (ds.id === quotation_ds_id) {
                //测算类型为手工测算，还款方式只读
                if(name == 'measure_type'){
                    if(value == 'SYSTEM_ESTIMATION'){
                        record.getField('price_list').setReadOnly(false);
                        record.getField('price_list_n').setReadOnly(false);
                        record.getField('price_list').setRequired(true);
                        record.getField('price_list_n').setRequired(true);
                        record.getField('calc_interest_year_days').setRequired(true);
                        record.getField('calc_interest_year_days_n').setRequired(true);
                        record.getField('calc_interest_year_days').setReadOnly(false);
                        record.getField('calc_interest_year_days_n').setReadOnly(false);
                        record.set('price_list','');
                        record.set('price_list_n','');
                        record.getField('interest_cycle').setRequired(true);
                        record.getField('interest_cycle_n').setRequired(true);
                        record.getField('interest_cycle').setReadOnly(false);
                        record.getField('interest_cycle_n').setReadOnly(false);
                    }else if(value == 'HAND_ESTIMATION'){
                        record.getField('price_list').setRequired(false);
                        record.getField('price_list_n').setRequired(false);
                        record.getField('price_list').setReadOnly(true);
                        record.getField('price_list_n').setReadOnly(true);
                        record.set('price_list','PAY_BY_NO_RULE');
                        record.set('price_list_n','不规则还款');
                        record.getField('interest_cycle').setRequired(false);
                        record.getField('interest_cycle_n').setRequired(false);
                        record.getField('interest_cycle').setReadOnly(true);
                        record.getField('interest_cycle_n').setReadOnly(true);
                        record.set('interest_cycle','');
                        record.set('interest_cycle_n','')
                    }
                }

                if (name === 'int_rate_type') {
                    if (value == 'FIXED') {
                        record.getField('base_rate').setReadOnly(true);
                        record.getField('base_rate').setRequired(false);
                        record.getField('base_rate_type').setReadOnly(true);
                        record.getField('base_rate_type').setRequired(false);
                        record.getField('base_rate_type_n').setReadOnly(true);
                        record.getField('base_rate_type_n').setRequired(false);
                        /*record.getField('floating_way_n').setReadOnly(true);
                        record.getField('floating_way_n').setRequired(false);
                        record.getField('floating_way').setReadOnly(true);
                        record.getField('floating_way').setRequired(false);*/
                        record.getField('floating_way_range').setReadOnly(true);
                        record.getField('floating_way_range').setRequired(false);
                        record.getField('floating_range_method').setReadOnly(true);
                        record.getField('floating_range_method_n').setReadOnly(true);

                        record.set('base_rate',null);
                        record.set('base_rate_type',null);
                        record.set('base_rate_type_n',null);
                        record.set('floating_way_range',null);
                        record.set('floating_range_method','');
                        record.set('floating_range_method_n','');



                    } else {
                        record.getField('base_rate').setReadOnly(false);
                        record.getField('base_rate').setRequired(true);
                        record.getField('base_rate_type').setReadOnly(false);
                        record.getField('base_rate_type').setRequired(true);
                        record.getField('base_rate_type_n').setReadOnly(false);
                        record.getField('base_rate_type_n').setRequired(true);
                        /*record.getField('floating_way_n').setReadOnly(false);
                        record.getField('floating_way_n').setRequired(true);*/
                        record.getField('floating_way_range').setReadOnly(false);
                        record.getField('floating_way_range').setRequired(true);
                        record.getField('floating_range_method').setReadOnly(false);
                        record.getField('floating_range_method_n').setReadOnly(false);

                    }
                }
                if (name === 'base_rate_type' || name === 'base_rate_type_n') {
                    onchange_base_rate_type();
                }

                if (name === 'due_date') {
                    onchange_base_rate_type();
                }

                if(name == 'floating_way_range'){
                    if(record.get("int_rate_type")=='FLOATING' && record.get('base_rate') != null && record.get('base_rate') != '' && record.get('floating_way_range') != null && record.get('floating_way_range') != ''){
                        var int_rate = plus(record.get('base_rate'),div(record.get('floating_way_range'),10000));
                        record.set('int_rate',int_rate);
                    }else{
                        record.set('int_rate','');
                    }
                }

                if(name == 'base_rate'){
                    if(record.get("int_rate_type")=='FLOATING' &&record.get('base_rate') != null && record.get('base_rate') != '' && record.get('floating_way_range') != null && record.get('floating_way_range') != ''){
                        var int_rate = plus(record.get('base_rate'),div(record.get('floating_way_range'),10000));
                        record.set('int_rate',int_rate);
                    }else{
                        record.set('int_rate','');
                    }
                }

                if (name === 'serve_flag') {
                    if (value == 'N') {
                        $(quotation_ds_id).getCurrentRecord().getField('serve_currency_code_n').setReadOnly(true);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_amount').setReadOnly(true);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_rate').setReadOnly(true);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_method_n').setReadOnly(true);

                    } else {
                        $(quotation_ds_id).getCurrentRecord().getField('serve_currency_code_n').setReadOnly(false);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_amount').setReadOnly(false);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_rate').setReadOnly(false);
                        $(quotation_ds_id).getCurrentRecord().getField('serve_method_n').setReadOnly(false);

                    }
                }

                if (name === 'interest_cycle') {
                    if (value == 'MONTH' || value == 'BEGINNING_OF_PERIOD' || value == 'EXPIRE_OF_PERIOD'  ) {

                        $(quotation_ds_id).getCurrentRecord().set('interest_month','');
                        $(quotation_ds_id).getCurrentRecord().set('interest_month_n','');
                        $(quotation_ds_id).getCurrentRecord().getField('interest_month_n').setReadOnly(true);

                    } else {
                        $(quotation_ds_id).getCurrentRecord().set('interest_month','');
                        $(quotation_ds_id).getCurrentRecord().set('interest_month_n','');
                        $(quotation_ds_id).getCurrentRecord().getField('interest_month_n').setReadOnly(false);
                    }
                }

                if(name == 'due_date'){
                    if(record.get('due_date')>new Date(financingTermTo)){
                        Leaf.showMessage('提示','合同到期日必须大于提款起始日！');
                    }else{
                        if(record.get('withdraw_end_date') != null && record.get('due_date')!= null){
                            var month = getMonthsBetween(record.get('due_date'),record.get('withdraw_end_date'));
                            if(record.get('withdraw_end_date') > record.get('due_date')){
                                record.set('loan_term',month);
                            }else{
                                Leaf.showMessage('提示','计划到期日必须大于提款起始日！');
                            }
                        }else{
                            record.set('loan_term',0);
                        }
                        if(record.get('due_date') != null){
                            record.set('withdraw_date_actual',record.get('due_date'));
                        }
                    }
                }

                if(name == 'withdraw_end_date'){
                    record.set('initial_withdraw_end_date',record.get('withdraw_end_date'));
                    if(record.get('withdraw_end_date') != null && record.get('due_date')!= null){
                        var month = getMonthsBetween(record.get('due_date'),record.get('withdraw_end_date'));
                        if(record.get('withdraw_end_date') > record.get('due_date')){
                            record.set('loan_term',month);
                        }else{
                            Leaf.showMessage('提示','计划到期日必须大于提款起始日！');
                        }

                    }else{
                        record.set('loan_term',null);
                    }
                }

                //付息日
                if(name == 'plan_interest_payment_date'){
                    if(record.get('plan_interest_payment_date') != null && record.get('plan_interest_payment_date') != '' && record.get('plan_interest_payment_date') != undefined){
                        if(record.get('interest_cycle') == 'QUARTER'){
                            //按季付息
                            var month = record.get('plan_interest_payment_date').getMonth() +1;
                            var day = record.get('plan_interest_payment_date').getDate();
                            var interest_month;
                            if(month == 1 || month == 4 || month == 7 || month == 10){
                                interest_month = 1;
                            } else if(month == 2 || month == 5 || month == 8 || month == 11){
                                interest_month = 2;
                            } else if(month == 3 || month == 6 || month == 9 || month == 12){
                                interest_month = 3;
                            }
                            record.set('interest_month',interest_month);
                            record.set('interest_calc_date',day);
                            record.set('interest_payment_date',day);
                        }else if(record.get('interest_cycle') == 'MONTH'){
                            //按月付息
                            var month = record.get('plan_interest_payment_date').getMonth()+1;
                            var day = record.get('plan_interest_payment_date').getDate();
                            record.set('interest_month',month);
                            record.set('interest_calc_date',day);
                            record.set('interest_payment_date',day);
                        }else if(record.get('interest_cycle') == 'YEAR'){
                            //按年付息
                            var month = record.get('plan_interest_payment_date').getMonth() +1;
                            var day = record.get('plan_interest_payment_date').getDate();
                            record.set('interest_month',month);
                            record.set('interest_calc_date',day);
                            record.set('interest_payment_date',day);
                        }
                    }else{
                        record.set('interest_month','');
                        record.set('interest_month_n','');
                        record.set('interest_calc_date','');
                        record.set('interest_payment_date','');
                    }
                }


            }

            if (ds.id == '${/parameter/@layout_code}_G_REPAYMENT_INFO_lon_contract_repayment_ds'){
                if(name == 'planned_calc_date' && (record.get('planned_due_date') == '' || record.get('planned_due_date') == null
                        || record.get('planned_due_date') == undefined || record.isNew == true )){
                    record.set('planned_due_date',record.get('planned_calc_date'));
                }
            }
            else if (ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment','G_REPAYMENT_FIN_INFO')) {
                var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');

                if (name == 'proportion' && $(quotation_ds_id).getCurrentRecord().get("due_amount") && record.get('proportion')) {
                    record.set('planned_due_amount', $(quotation_ds_id).getCurrentRecord().get("due_amount") * record.get('proportion'));
                }
            }


        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, record, config_records, bp_seq) {

            var contract_id = '${/parameter/@contractId}';
            var withdraw_id = '${/parameter/@withdrawId}';


            if (withdraw_id != '' && withdraw_id != 'undefined' && withdraw_id != null) {
                if (ds.id === '${/parameter/@layout_code}_G_PURPOSE_INFO_lon_contract_purpose_ds') {
                    ds.setQueryParameter('withdraw_id', withdraw_id);
                }
            }

            if (ds.id === '${/parameter/@layout_code}_G_ATTACHMENT_lon_contract_attachment_ds') {
                ds.setQueryParameter('withdraw_id', withdraw_id);
            }

            var repayment_fin_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment','G_REPAYMENT_FIN_INFO');
            var repayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment','G_REPAYMENT_INFO');

            if(ds.id == repayment_fin_info_ds_id){
                ds.setQueryParameter('contract_id', contract_id);
                ds.setQueryParameter('withdraw_id', withdraw_id);
                ds.setQueryParameter('interest_flag', 'Y');
            }
            if(ds.id == repayment_info_ds_id){
                ds.setQueryParameter('contract_id', contract_id);
                ds.setQueryParameter('withdraw_id', withdraw_id);
                ds.setQueryParameter('interest_flag', 'Y');
            }


        };

        function setRecordValue(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record.set(i, data[i]);
                }
            }
        }
        var whiteList = ['base_rate','base_rate_type','floating_way_range','floating_range_method'];
        function assignValue(record, data) {
            for (var i in data) {
                if (data[i] != null || whiteList.indexOf("base_rate")>=0) {
                    record[i] = data[i];
                }
            }
        }

        // 报价计算
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //debugger;
            var function_usage = '${/parameter/@function_usage}';
            var maintain_type = '${/parameter/@maintain_type}';
            var readOnly;

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw', 'F_BASE');
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation', 'F_QUOTATION_INFO');
            var repayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment');
            var priceList = $(quotation_ds_id).getAll();
            var withdraw_status = $(ds_id).getCurrentRecord().get('withdraw_status');

            if ($(quotation_ds_id).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }

            if (!$(quotation_ds_id).validate()) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示', '请将必填的交易信息输入完整');
                return false;
            }
            if (!$(ds_id).validate()) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示', '请将必填的基本信息输入完整');
                return false;
            }

            if($(quotation_ds_id).getCurrentRecord() != null ){
                var lon_contract_quotation_record = $(quotation_ds_id).data[0].data;
                if(lon_contract_quotation_record.measure_type=='HAND_ESTIMATION'){
                    Leaf.showMessage('提示！', '只有系统测算类型才可计算！');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;

                };
            }

            var url;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/lon/contract/quotation/withdraw/create",
                para: {
                    withdrawId: withdraw_id,
                    priceList: priceList[0].get('price_list')
                },
                success: function (res) {
                    debugger;
                    var quotation_id = res.result.record[0].quotation_id;
                    var price_list = priceList[0].get('price_list');
                    if (withdraw_status == 'APPROVING' || withdraw_status == 'APPROVED' || maintain_type == 'QUERY') {
                        url = '${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_calculate.lview?quotationId=' + quotation_id + '&readOnly=Y&priceList=' + price_list;
                    } else {
                        url = '${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_calculate.lview?quotationId=' + quotation_id + '&readOnly=N&priceList=' + price_list;
                    }
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var win = new Leaf.Window({
                        id: 'con_open_price_modify_winid',
                        url: url,
                        title: '报价明细',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        $(repayment_ds_id).query();
                        $(quotation_ds_id).query();
                        $(ds_id).query();
                    });
                },
                failure: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function checkLoanTerm(record){
            var interest_cycle = record.get('interest_cycle');
            var repayment_frequency = 0;
            if ("YEAR" == interest_cycle) {
                repayment_frequency = 12;
            } else if ("HALF_A_YEAR" == interest_cycle) {
                repayment_frequency = 6;
            } else if ("QUARTER" == interest_cycle) {
                repayment_frequency = 3;
            } else if ("MONTH" == interest_cycle) {
                repayment_frequency = 1;
            }
            //还款周期乘以期数，必须小于等于期限（月），否则提示校验：还款计划的月数和提款期限（月）不相等，请重新录入还款周期和期数！【大的话利息会是负数】
            if(mul(repayment_frequency,record.get("loan_times")) > record.get("loan_term")){
                return false;
            }else{
                return true;
            }
        }


