<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>

    <a:view>
        <div id="lon_contract_calc_templet" style="width:100%;height:100%;">
            <iframe id="lon_contract_calc_templet_iframe" onload="unlock_window()" border="0" frameborder="0" height="100%" scrolling="auto"
                    sytle="border:none;" width="100%"/>
        </div>
        <script><![CDATA[

        function unlock_window(){
            $L.Masker.unmask(Ext.getBody())
        }

        $L.Masker.mask(Ext.getBody(),"正在载入excel，请稍等...");

        setTimeout(function(){
            debugger;
            if ('${/parameter/@document_history_flag}') {
                document.getElementById('lon_contract_calc_templet_iframe').src = '${/request/@context_path}/modules/LON/LON_CONTRACT/LON340Alon_contract_calculate_common_history.html?priceList=${/parameter/@priceList}&quotationId=${/parameter/@quotationId}&readOnly=${/parameter/@readOnly}&document_history_flag=Y&documentId=${/parameter/@document_id}&documentCategory=${/parameter/@document_category}';
            } else {
                document.getElementById('lon_contract_calc_templet_iframe').src = '${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_calculate_common.html?priceList=${/parameter/@priceList}&quotationId=${/parameter/@quotationId}&readOnly=${/parameter/@readOnly}';
            }
        },10);
        ]]></script>
        <a:screenBody style="display:none;"/>
    </a:view>
</a:screen>
