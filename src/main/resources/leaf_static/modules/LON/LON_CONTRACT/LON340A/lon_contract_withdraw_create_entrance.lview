<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fin003_lon_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>
        <script><![CDATA[

        //按钮1
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            debugger;
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var contract_record = $(contract_ds_id).getCurrentRecord().data;
            var contract_value=contract_record.contract_value;
            contract_record['contract_id']=contract_record.lon_contract;
            if(contract_record.withdraw_plan!=null){
                contract_record['withdraw_plan_id']=contract_record.withdraw_plan;
            }

            console.log(contract_record);
            if(contract_record.lon_contract == null || contract_record.lon_contract == ''){
                Leaf.showMessage('提示','融资合同编号不能为空！');
            }else{
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/contract/withdraw/create',
                    para:  contract_record,
                    success: function (datas) {
                        // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        debugger;
                        var param = {};
                        param['url_title'] = '融资提款创建详细信息';
                        param['function_code'] = 'FIN003S3';
                        param['function_usage'] = 'CREATE';
                        param['winid'] = 'fin004_lon_detail_id';
                        param['newFlag'] = 'N';
                        param['editFlag'] = 'Y';
                        param['contractId']=contract_record.lon_contract;
                        param['withdrawId']=datas.result.record[0].withdraw_id;
                        param['baseRate'] = contract_value;
                        param['financingTermTo']=datas.result.record[0].ref_d01;
                        hls_doc_get_layout_code(param, 'fin003_lon_detail_id', null, 'FIN003S3');
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }
                });
            }







            /*debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var grid_id = ds_id.replace('ds', 'layout_grid_id');
            $(grid_id)._export();*/

        };




        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>