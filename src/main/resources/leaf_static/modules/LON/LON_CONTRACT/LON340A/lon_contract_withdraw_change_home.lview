<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="FIN003F7_create_add_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_create_entrance.lview"/>
        <a:link id="FIN003T_change_create_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create.lview"/>

        <a:link id="FIN003T_tikuan_lon_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>

        <a:link id="FIN003T_pending_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_fin003_lon_create_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <a:link id="${/parameter/@layout_code}_withdraw_change_history_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_history.lview"/>
        <a:link id="fin003_tikuan_lon_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //debugger;
            var link_function = '';
            if (name == 'withdraw_number') {
                link_function = 'withdrawChangeDetailFunction';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">'+record.data.withdraw_number+'</a>';
            }
            if (name == 'contract_number') {
                return '<a href="javascript:open_contract_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
        };

        function open_contract_win(ds_id, record_id) {
            // debugger;
            var record2 = $(ds_id).findById(record_id);
            // var param = record2.data;
            var param = {};
            param['url_title'] = '租赁合同维护';
            var contract_status = record2.get('settle_status_desc');
            param['function_code'] = 'FIN003F1';

            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            param['contract_id'] = record2.get('contract_id');
            param['document_id'] = record2.get('contract_id');
            param['company_id'] = '${/session/@companyId}';
            // param['layout_debugger_flag'] = 'Y';


            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_fin003_lon_create_id', ds_id, 'FIN003S1');
        }
        function withdrawChangeDetailFunction(ds_id, record_id) {

            debugger;
            var record = $(ds_id).findById(record_id);
            var editFlag = 'Y';
            var changeFlag='N';
            if (record.get('withdraw_status') == 'APPROVED' || record.get('withdraw_status') == 'APPROVING') {
                editFlag = 'N';
                var param = {};
                param['contractId'] = record.get('contract_id');
                param['withdrawId'] = record.get('withdraw_id');
                param['withdrawStatus'] = record.get('withdraw_status');
                param['function_code'] = 'FIN003S3';
                param['function_usage'] = 'QUERY';
                param['editFlag'] = editFlag;
                param['changeFlag'] = changeFlag;
                param['url_title'] = '融资提款详细信息';
                hls_doc_get_layout_code(param, 'fin003_tikuan_lon_detail_id', null, 'FIN003S1');
            }
           else if (record.get('withdraw_status') == 'PENDING' ){
                var param = {};
                param['contract_id'] = record.get('contract_id');
                param['withdraw_id'] = record.get('withdraw_id');
                param['old_contract_id'] = record.get('old_contract_id');
                param['old_withdraw_id'] = record.get('old_withdraw_id');
                param['withdraw_status'] = record.get('withdraw_status');
                param['change_type'] = record.get('change_type');

                param['function_code'] = 'FIN003T2';
                param['function_usage'] = 'MODIFY';
                if(record.get('change_status') == 'APPROVING' || record.get('change_status') == 'APPROVED'){
                    param['function_usage'] = 'QUERY';
                    param['hidden_button_code'] = ['save', 'submit_approval'];

                }
               param['editFlag'] = editFlag;
                param['changeFlag'] = changeFlag;
                param['url_title'] = '融资提款变更详细';
                hls_doc_get_layout_code(param, 'FIN003T_pending_detail_id', ds_id, 'FIN003S1');
            }else{
                var param = {};
                param['contract_id'] = record.get('contract_id');
                param['withdraw_id'] = record.get('withdraw_id');
                param['withdraw_status'] = record.get('withdraw_status');
                param['function_code'] = 'FIN003S3';
                param['function_usage'] = 'QUERY';
                param['editFlag'] = editFlag;
                param['changeFlag'] = changeFlag;
                param['url_title'] = '融资提款详细信息';
                hls_doc_get_layout_code(param, 'FIN003T_tikuan_lon_detail_id', ds_id, 'FIN003S1');
            }

        };

        window['${/parameter/@layout_code}_change_layout_dynamic_click'] = function () {

            //debugger;
            var lon_contract_withdraw_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw','G_INFO_GRID');
            var records = $(lon_contract_withdraw_id).getSelected();
            if(records.length!=1){
                Leaf.showErrorMessage('提示','请选择一条审批通过的单据');
                return;
            }
            if(records[0].get('withdraw_status') != 'APPROVED'){
                Leaf.showErrorMessage('提示','请选择一条审批通过的单据');
                return;
            }
            if(records[0].get('batch_count') > 0 ){
                Leaf.showErrorMessage('提示','有一笔融资还款单据包含了该提款的现金流，请将其删除后再进行变更！');
                return;
            }
            var param = {};
            debugger;
            param['url_title'] = '融资提款变更创建';
            param['function_code'] = 'FIN003T1';
            param['winid'] = 'FIN003T1_change_win_id';
            param['withdraw_id'] = records[0].get('withdraw_id');
            param['withdraw_number'] = records[0].get('withdraw_number');
            param['credit_bp_id'] = records[0].get('credit_bp_id');
            param['credit_bp_name'] = records[0].get('credit_bp_name');
            param['created_by_n'] = records[0].get('created_by_n');
            param['created_by'] = records[0].get('created_by');
            param['contract_id'] = records[0].get('contract_id');
            param['withdraw_status'] = records[0].get('withdraw_status');
            param['function_usage']='CREATE';
            hls_doc_get_layout_code(param, 'FIN003T_change_create_id', lon_contract_withdraw_id, 'FIN003S1');


        };

        //变更历史
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

           //debugger;
           var lon_contract_withdraw_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw','G_INFO_GRID');
           var withdraw_records = $(lon_contract_withdraw_id).getSelected();
           if(withdraw_records.length != 1){
               Leaf.showMessage('提示','未选择一条数据！');
           }else{
               var param = {};
               param['url_title'] = '融资提款变更历史';
               param['function_code'] = 'FIN003T5';
               param['winid'] = 'FIN003T5_withdraw_change_win_id';
               param['function_usage']='MODIFY';
               param['screen_width']= '900';
               param['side']='right';
               param['withdraw_number']=withdraw_records[0].get('withdraw_number');
               hls_doc_get_layout_code(param, '${/parameter/@layout_code}_withdraw_change_history_id', lon_contract_withdraw_id, 'FIN003T');
           }


       };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>