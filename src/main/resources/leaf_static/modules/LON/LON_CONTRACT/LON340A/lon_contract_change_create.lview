<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fin003_change_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create_detail.lview"/>
        <script><![CDATA[
        //下一步
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var ds_id = '${/parameter/@layout_code}_F_FORM__ds';
            //var type_ds_id = '${/parameter/@layout_code}_F_CHANGE_TYPE__ds';
            var record = $(ds_id).getCurrentRecord();
            //var type_record = $(type_ds_id).getCurrentRecord();
            var change_time = record.get('change_time');
            var change_reason = record.get('change_reason');
            var withdraw_id = '${/parameter/@withdraw_id}';
            //var ai = type_record.get('ai');
            //var te = type_record.get('te');
            var type = '';
            //if(ai == 'Y'){
            //    type = 'AI';//交易要素变更
            //}else if(te == 'Y'){
            //    type = 'TE';//手动调息
            //}
            if(change_time == null || change_time == ''){
                Leaf.showMessage('提示','变更时间不能为空！');
            }else if(change_reason == null || change_reason == ''){
                Leaf.showMessage('提示','变更申请原因不能为空！');
            //}else if(type == ''){
            //    Leaf.showMessage('提示','变更类型不能为空！');
            } else{
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/contract/withdraw/lonContractWithdrawChangeReq',
                    para:{
                        withdrawId:withdraw_id,
                        //change Type:type,
                        changeTime:change_time,
                        changeReason:change_reason,
                        created_by:'${/session/@user_id}'
                    },
                    success: function(res) {
                    debugger;
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        var param = {};
                        param['function_code'] = 'FIN003T2';
                        param['function_usage'] = 'MODIFY';
                        param['url_title'] = '融资提款变更详细';
                        param['contract_id'] = res.result.record[0].contract_id;
                        param['withdraw_id'] = res.result.record[0].withdraw_id;
                        param['old_contract_id'] = '${/parameter/@contract_id}';
                        param['old_withdraw_id'] = '${/parameter/@withdraw_id}';
                        //param['change_type'] = type_record.get('type');
                        param['change_time'] = record.get('change_time');
                        param['change_reason'] = record.get('change_reason');
                        param['withdraw_status'] = '${/parameter/@withdraw_status}';
                        param['parent_winid'] = '${/parameter/@winid}';

                        hls_doc_get_layout_code(param, 'fin003_change_detail_id', null, 'FIN003T1');
                    },
                    error: function(res) {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    faliure: function() {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });

            }

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            //debugger;
            if(ds.id == '${/parameter/@bp_seq}${/parameter/@layout_code}_F_CHANGE_TYPE__ds'){
                if(name == 'ai'){
                    if(value == 'Y'){
                        record.set('te','N');
                    }
                }
                if(name == 'te'){
                    if(value == 'Y'){
                        record.set('ai','N');
                    }
                }
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if(ds.id == '${/parameter/@bp_seq}${/parameter/@layout_code}_F_FORM__ds'){
                record.set('change_time',Leaf.formatDate(new Date()));
                record.set('create_person','${/session/@employeeName}');
                record.set('created_by','${/session/@user_id}');

                record.set('withdraw_id_n','${/parameter/@withdraw_number}');
                record.set('withdraw_id','${/parameter/@withdraw_id}');
                record.set('credit_bp_id','${/parameter/@credit_bp_id}');
                record.set('credit_bp_id_n','${/parameter/@credit_bp_name}');

            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>