<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fin003_change_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create_detail.lview"/>
        <script><![CDATA[
        //查询时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            debugger;
            if(ds.id == '${/parameter/@layout_code}_G_GRID_lon_contract_withdraw_ds'){
                qpara['withdraw_number'] = '${/parameter/@withdraw_number}';
            }

        }

        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = '';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'withdraw_number') {
                link_function = 'withdraw_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
        };

        function withdraw_detail(ds_id,record_id){
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['contract_id'] = record.get('contract_id');
            param['withdraw_id'] = record.get('withdraw_id');
            param['old_contract_id'] = record.get('old_contract_id');
            param['old_withdraw_id'] = record.get('old_withdraw_id');
            param['withdraw_status'] = record.get('withdraw_status');
            param['function_code'] = 'FIN003T4QUERY';
            param['function_usage'] = 'QUERY';

            param['url_title'] = '融资提款变更详细';
            hls_doc_get_layout_code(param, 'FIN003T_pending_detail_id', ds_id, 'FIN003S1');

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>