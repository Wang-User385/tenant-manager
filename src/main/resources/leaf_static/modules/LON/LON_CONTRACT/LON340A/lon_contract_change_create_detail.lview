            });

        };

        //按钮3 确认
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            //上个页面传的contract_id和withdraw_id
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var contract_id = '${/parameter/@contract_id}';
            var withdraw_id = '${/parameter/@withdraw_id}';
            var withdraw_status = '${/parameter/@withdraw_status}';
            //基本信息
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var lonContractRecord = {};
            lonContractRecord['contract_id'] = contract_id;
            lonContractRecord['withdraw_id'] = withdraw_id;
            lonContractRecord['withdraw_status'] = withdraw_status;
            lonContractRecord['old_withdraw_id'] = '${/parameter/@old_withdraw_id}';
            lonContractRecord['old_contract_id'] = '${/parameter/@old_contract_id}';

            lonContractRecord['change_reason'] = $(lon_contract_id).getCurrentRecord().data.change_reason;
            lonContractRecord['change_time'] = $(lon_contract_id).getCurrentRecord().data.change_time;
            //账户信息
            lonContractRecord['lon_contract_bank_accounts'] = null;
            var ct_lon_contract_bank_account_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_bank_account', 'G_BANK_INFO_AFTER');
            if ($(ct_lon_contract_bank_account_id).getAll().length != 0) {
                var lonContractBankAccount_records = $(ct_lon_contract_bank_account_id).getAll();
                var ct_lon_contract_bank_accounts = [];
                lonContractRecord['lon_contract_bank_accounts'] = [];
                for (var i = 0; i < lonContractBankAccount_records.length; i++) {
                    ct_lon_contract_bank_accounts[i] = {};
                    lonContractBankAccount_records[i].data['enabled_flag'] = 'Y';
                    lonContractBankAccount_records[i].data['withdraw_id'] = withdraw_id;
                    lonContractBankAccount_records[i].data['contract_id'] = contract_id;
                    assignValue(ct_lon_contract_bank_accounts[i], lonContractBankAccount_records[i].data);
                    ct_lon_contract_bank_accounts['company_id'] = '${/session/@companyId}';
                    lonContractRecord['lon_contract_bank_accounts'].push(ct_lon_contract_bank_accounts[i]);
                }
            }


            /* //贷款用途
             var lon_contract_purpose_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_purpose');
             if($(lon_contract_purpose_id).getAll().length != 0){
                 var  lon_contract_purpose_id_records =$(lon_contract_purpose_id).getAll();
                 var hlsCusLonContractPurposeList = [];
                 lonContractRecord['hls_cus_lon_contract_purpose_list']=[];
                 for(var i=0;i<lon_contract_purpose_id_records.length;i++){
                     hlsCusLonContractPurposeList[i] = {};
                     // lon_contract_purpose_id_records[i].data['enabled_flag'] = 'Y';
                     lon_contract_purpose_id_records[i].data['withdraw_id'] = withdraw_id;
                     lon_contract_purpose_id_records[i].data['contract_id'] = contract_id;
                     assignValue(hlsCusLonContractPurposeList[i],lon_contract_purpose_id_records[i].data);
                     hlsCusLonContractPurposeList['company_id']='${/session/@companyId}';
                     lonContractRecord['hls_cus_lon_contract_purpose_list'].push(hlsCusLonContractPurposeList[i]);
                 }
             }*/


            //本息还款计划
            lonContractRecord['hls_cus_lon_contract_repayment_list'] = null;
            var lon_contract_repayment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_INFO');
            if ($(lon_contract_repayment_id).getAll().length != 0) {
                var lon_contract_repayment_id_records = $(lon_contract_repayment_id).getAll();
                var hlsCusLonContractRepaymentList = [];
                lonContractRecord['hls_cus_lon_contract_repayment_list'] = [];
                for (var i = 0; i < lon_contract_repayment_id_records.length; i++) {
                    hlsCusLonContractRepaymentList[i] = {};
                    // lon_contract_repayment_id_records[i].data['enabled_flag'] = 'Y';
                    lon_contract_repayment_id_records[i].data['withdraw_id'] = withdraw_id;
                    lon_contract_repayment_id_records[i].data['contract_id'] = contract_id;
                    assignValue(hlsCusLonContractRepaymentList[i], lon_contract_repayment_id_records[i].data);
                    hlsCusLonContractRepaymentList['company_id'] = '${/session/@companyId}';
                    lonContractRecord['hls_cus_lon_contract_repayment_list'].push(hlsCusLonContractRepaymentList[i]);
                }
            }

            //付款计划
            lonContractRecord['hls_cus_lon_contract_payment_list'] = null;
            var lon_contract_payment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_FIN_INFO');
            if ($(lon_contract_payment_id).getAll().length != 0) {
                var lon_contract_payment_id_records = $(lon_contract_payment_id).getAll();
                var hlsCusLonContractPaymentList = [];
                lonContractRecord['hls_cus_lon_contract_payment_list'] = [];
                for (var i = 0; i < lon_contract_payment_id_records.length; i++) {
                    hlsCusLonContractPaymentList[i] = {};
                    // lon_contract_payment_id_records[i].data['enabled_flag'] = 'Y';
                    lon_contract_payment_id_records[i].data['withdraw_id'] = withdraw_id;
                    lon_contract_payment_id_records[i].data['contract_id'] = contract_id;
                    assignValue(hlsCusLonContractPaymentList[i], lon_contract_payment_id_records[i].data);
                    hlsCusLonContractPaymentList['company_id'] = '${/session/@companyId}';
                    lonContractRecord['hls_cus_lon_contract_payment_list'].push(hlsCusLonContractPaymentList[i]);
                }
            }


            //交易信息
            var lon_contract_quotation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');
            if ($(lon_contract_quotation_id).getCurrentRecord() != null) {
                var lon_contract_quotation_record = $(lon_contract_quotation_id).data[0].data;
                assignValue(lonContractRecord, lon_contract_quotation_record);
            }

            //附件信息
            lonContractRecord['lon_contract_attachments'] = null;
            var lon_contract_attachment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_attachment');
            //附件信息 List<HlsCusLonContractAttachment> lonContractAttachments;  hlsCusPrjProjectAttachments
            if ($(lon_contract_attachment_id).getAll().length != 0) {
                var lon_contract_attachment_id_records = $(lon_contract_attachment_id).getAll();
                var lonContractAttachments = [];
                lonContractRecord['lon_contract_attachments'] = [];
                for (var i = 0; i < lon_contract_attachment_id_records.length; i++) {
                    lonContractAttachments[i] = {};
                    lon_contract_attachment_id_records[i].data['source_id'] = withdraw_id;
                    lon_contract_attachment_id_records[i].data['contract_id'] = contract_id;
                    lon_contract_attachment_id_records[i].data['source_type'] = 'LON_CONTRACT_WITHDRAW';
                    // lon_contract_attachment_id_records[i].data['project_attachment_category'] = 'LON_CONTRACT_WITHDRAW';
                    assignValue(lonContractAttachments[i], lon_contract_attachment_id_records[i].data);
                    lonContractRecord['lon_contract_attachments'].push(lonContractAttachments[i]);
                }
            }

            var old_repayment_fin_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_FIN_INFO_BEFORE');
            var old_repayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_INFO_BEFORE');
            //把其他属性去掉，避免栈溢出
            var old_lon_contract_quotation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation', 'F_QUOTATION_INFO_BEFORE');

            lonContractRecord[ct_lon_contract_bank_account_id.replace('_ds', '')] = undefined;
            //lonContractRecord[lon_contract_purpose_id.replace('_ds','')]=undefined;
            lonContractRecord[lon_contract_repayment_id.replace('_ds', '')] = undefined;
            lonContractRecord[lon_contract_payment_id.replace('_ds', '')] = undefined;
            lonContractRecord[lon_contract_quotation_id.replace('_ds', '')] = undefined;
            lonContractRecord[old_lon_contract_quotation_id.replace('_ds', '')] = undefined;
            lonContractRecord[old_repayment_fin_info_ds_id.replace('_ds', '')] = undefined;
            lonContractRecord[old_repayment_info_ds_id.replace('_ds', '')] = undefined;
            //附件
            lonContractRecord[lon_contract_attachment_id.replace('_ds', '')] = undefined;


            if (!$(lon_contract_quotation_id).validate()) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示', '请将必填的交易信息输入完整');
            } else if (!$(lon_contract_id).validate()) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示', '请将必填的基本信息输入完整');
            } else {
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/contract/withdraw/submitApproval',
                    para: lonContractRecord,

                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        Leaf.showSuccessMessage('提示', '提交成功', function () {
                            if ('${/parameter/@winid}') {
                                window.location.href = $('fin003_change_detail_plan_back_link_id').getUrl() + location.search;
                            }
                        });
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        };
        //按钮4 取消变更
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //上个页面传的contract_id和withdraw_id
            //debugger;
            var contract_id = '${/parameter/@contract_id}';
            var withdraw_id = '${/parameter/@withdraw_id}';

            if ('${/parameter/@withdraw_status}' != null || '${/parameter/@withdraw_status}' != '') {
                var withdraw_status = '${/parameter/@withdraw_status}';
            } else {
                var withdraw_status = 'NEW';
            }

            //基本信息
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var lonContractRecord = $(lon_contract_id).getCurrentRecord();
            //debugger;
            Leaf.request({
                url: '${/request/@context_path}/hlsLon/contract/withdraw/cancelChangeReq',
                para: {
                    withdraw_id: lonContractRecord.get('withdraw_id')
                },

                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '成功', function () {
                        $('${/parameter/@winid}').close();
                    });

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            })
        };


        //附件上传
        window['${/parameter/@layout_code}_G_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');
            var dsRecord = $(ds_id).getCurrentRecord();
            // var withdraw_id = dsRecord.get('withdraw_id');

            var contract_id = '${/parameter/@contract_id}';
            var withdraw_id = '${/parameter/@withdraw_id}';

            if (withdraw_id == null || withdraw_id == '' || withdraw_id == undefined) {
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                $L.showInfoMessage("提示", "当前无法编辑页面!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                url: url,
                params: {
                    'header_id': withdraw_id,
                    'table_name': 'LON_CONTRACT_WITHDRAW',

                    winid: 'prj316_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });

            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_lon_contract_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'fin003t2_download_detail';
            if (name == 'download') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + '上传/下载' + '</a>';
            }
        };

        function fin003t2_download_detail(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var withdraw_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var withdraw_record = $(withdraw_ds_id).getCurrentRecord();
            var withdraw_id = withdraw_record.get('withdraw_id');

            var contract_attachment_id = record.get('contract_attachment_id');
            if (withdraw_id == null || withdraw_id == '' || withdraw_id == undefined) {
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            if (contract_attachment_id == null || contract_attachment_id == '' || contract_attachment_id == undefined) {
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'lon340a_open_attachment_winid',
                url: url,
                params: {
                    'header_id': contract_attachment_id,
                    'table_name': 'LON_CONTRACT_ATTACHMENT',

                    winid: 'lon340a_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_lon_contract_attachment_ds";
                $(document_list_ds_id).query();
            });
        }


        //grid的渲染，设置编辑模式
        window['${/parameter/@layout_code}_renderer_model'] = function (temp_value, record, name, editor_record) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_INFO');

            if (record.ds.id == ds_id) {
                if ('${/parameter/@function_usage}' != 'QUERY') {
                    var write_off_flag = record.get("write_off_flag");
                    if (write_off_flag == 'NOT') {
                        record.getField('cf_item').setReadOnly(false);
                        record.getField('cf_item_n').setReadOnly(false);
                        record.getField('planned_calc_date').setReadOnly(false);
                        record.getField('planned_due_date').setReadOnly(false);
                        record.getField('planned_due_amount').setReadOnly(false);
                        record.getField('cny_planned_due_amount').setReadOnly(false);
                        record.getField('int_rate').setReadOnly(false);
                        record.getField('amortization_method').setReadOnly(false);
                        record.getField('amortization_method_n').setReadOnly(false);
                    } else {
                        record.getField('cf_item').setReadOnly(true);
                        record.getField('cf_item_n').setReadOnly(true);
                        record.getField('planned_calc_date').setReadOnly(true);
                        record.getField('planned_due_date').setReadOnly(true);
                        record.getField('planned_due_amount').setReadOnly(true);
                        record.getField('cny_planned_due_amount').setReadOnly(true);
                        record.getField('int_rate').setReadOnly(true);
                        record.getField('amortization_method').setReadOnly(true);
                        record.getField('amortization_method_n').setReadOnly(true);

                    }
                }
            }
        };


        //支付表导入
        window['${/parameter/@layout_code}_G_REPAYMENT_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var repayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_INFO');
            var base_record = $(base_ds_id).getCurrentRecord();
            var withdraw_id = base_record.get('withdraw_id');
            var contract_id = base_record.get('contract_id');
            if (withdraw_id == '' || withdraw_id == 'undefined' || withdraw_id == null) {
                Leaf.showInfoMessage("提示", "请先保存再进行导入操作！");
                return;
            }
            var win = new Leaf.Window({
                id: 'lon_contract_repayment_import_win_id',
                params: {
                    winid: 'lon_contract_repayment_import_win_id'
                },
                url: '${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_repayment_import.lview?withdraw_id=' + withdraw_id + '&contract_id=' + contract_id,
                title: '本息还款计划导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(repayment_ds_id).query();
            });
        }
        //合同信息
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var contract_id = $(base_ds_id).getCurrentRecord().get('contract_id');
            var param = {};
            param['url_title'] = '融资合同维护';
            param['function_code'] = 'FIN003F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['hidden_button_code'] = ['save', 'submit_approval'];
            param['contract_id'] = contract_id;
            param['document_id'] = contract_id;
            param['withdraw_flag'] = 'Y';
            param['company_id'] = '${/session/@companyId}';
            // param['layout_debugger_flag'] = 'Y';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_fin003_lon_create_id', base_ds_id, 'FIN003S3');

        }

        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {
            //debugger;
            if (ds.id == '${/parameter/@layout_code}_G_REPAYMENT_INFO_lon_contract_repayment_ds') {
                for (var i = 0; i < record.length; i++) {
                    if (record[i].get('write_off_flag') == 'FULL' || record[i].get('write_off_flag') == 'PARTIAL') {
                        Leaf.showMessage('提示', '该现金流已发生核销，不允许删除！');
                        return false;
                    }
                }
            }
            if (ds.id == '${/parameter/@layout_code}_G_REPAYMENT_FIN_INFO_lon_contract_repayment_ds') {
                for (var i = 0; i < record.length; i++) {
                    if (record[i].get('write_off_flag') == 'FULL' || record[i].get('write_off_flag') == 'PARTIAL') {
                        Leaf.showMessage('提示', '该现金流已发生核销，不允许删除！');
                        return false;
                    }
                }
            }
            return true;
        };
        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {
            var repayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_INFO');
            if (ds.id === repayment_ds_id) {
                for (var i = 0; i < record.length; i++) {
                    var write_off_flag = record[i].get('write_off_flag');
                    if (write_off_flag == 'PARTIAL' || write_off_flag == 'FULL') {
                        $L.showMessage('提示', '部分核销以及完全核销不允许删除！');
                        return false;
                    }
                }
            }

            var repayment_ds_fin_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment', 'G_REPAYMENT_FIN_INFO');
            if (ds.id === repayment_ds_fin_id) {
                for (var i = 0; i < record.length; i++) {
                    var write_off_flag = record[i].get('write_off_flag');
                    if (write_off_flag == 'PARTIAL' || write_off_flag == 'FULL') {
                        $L.showMessage('提示', '部分核销以及完全核销不允许删除！');
                        return false;
                    }
                }
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>