<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_fin003_tikuan_lon_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>

        <a:link id="${/parameter/@layout_code}_fin003_lon_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>

        <a:link id="${/parameter/@layout_code}_fin003_pending_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_change_create_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_fin003_write_off_detail_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON003S5/lon_contract_withdraw_write_off_detail.lview"/>

        <a:link id="${/parameter/@layout_code}_calc_price_quotation_common_link_id"
                url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900/quotation_calc_common.lview"/>

        <a:link id="${/parameter/@layout_code}_con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>

        <a:link id="${/parameter/@layout_code}_zq_lon_query_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>

        <a:link id="${/parameter/@layout_code}_FIN003_BP_CREATE_ID"
                url="${/request/@context_path}/modules/FIN/FIN001/fin_bp_master_create.lview"/>

        <a:link id="${/parameter/@layout_code}_common_release_repurchase_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_common_release_repurchase.lview"/>

        <script><![CDATA[
var  check_flag='N';
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            debugger
            if(ds.id == '${/parameter/@layout_code}_G_PLEDGE_INFO_ct_lon_contract_pledge_ds'){
                record.set('pledge_release_flag','Y');
                record.set('pledge_release_flag_n','是');
                record.set('pledge_doc_category','CON_CONTRACT');
            }
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var pledge_ds_id = '${/parameter/@layout_code}_G_PLEDGE_INFO_ct_lon_contract_pledge_ds';

            if(ds.id === pledge_ds_id && record){
                var grid_id = '${/parameter/@layout_code}_G_PLEDGE_INFO_ct_lon_contract_pledge_layout_grid_id';
                var pledge_record = $(pledge_ds_id).getAll();
                for(var i = 0 ; i < pledge_record.length; i++){
                    if(pledge_record[i].data.duration_flag == 'Y'){
                        setTimeout(function(){
                            $jq('#' + grid_id + '_' + 'pledge_doc_number' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_doc_number_n' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_doc_name' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_times_from' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_times_to' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'amount' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_release_flag' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'pledge_release_flag_n' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'description' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'quotation_detail' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });
                            $jq('#' + grid_id + '_' + 'contract_detail' + '_' + record.id).css({
                                "background-color": "#FFFF00",
                                "color": "black"
                            });

                        },500);

                    }


                }
            }

        }

        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
          //  debugger;

    if(check_flag=='Y'){
             reload()
        }

            if ('${/parameter/@function_code}' == 'FIN003F1' && '${/parameter/@function_usage}' == 'CREATE') {
                var head_record = ds.getAt(0);
                head_record.set('contract_status','NEW');

            }
            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_contract_ds';
            if (ds.id === base_ds_id) {
                if (record.get('lon_company_id') == null || record.get('lon_company_id') == '' || record.get('lon_company_id') == undefined) {
                    record.set('lon_company_id', '${/session/@companyId}');
                    record.set('lon_company_id_n', '${/session/@companyName}');


                }
                if (record.get('created_by_n') == null || record.get('created_by_n') == '' || record.get('created_by_n') == undefined) {

                    record.set('created_by', '${/session/@user_id}');
                    record.set('created_by_n', '${/session/@employeeName}');


                }
                if (record.get('con_exchange_rate') == null || record.get('con_exchange_rate') == '' || record.get('con_exchange_rate') == undefined) {
                    record.set('con_exchange_rate', 1.0);
                }
                var rele_credit_flag = $(base_ds_id).getCurrentRecord().get('rele_credit_flag');


                if(record.get('document_type') == 'F3' || record.get('document_type') == 'F7'){
                    $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").next().show();
                }else{
                    $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").next().hide();
                }

                if(record.get('document_type') == 'F13' || record.get('document_type') == 'F14' || record.get('document_type') == 'F18'){
                    $jq('#${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").next().show();
                }else{
                    $jq('#${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").next().hide();
                }

                if('${/parameter/@function_usage}' != 'QUERY' && (record.get('document_type') == 'F3' || record.get('document_type') == 'F11')){
                    record.getField('contract_name').setReadOnly(false);
                    record.getField('contract_name').setRequired(true);
                }else{
                    record.getField('contract_name').setRequired(false);
                    record.getField('contract_name').setReadOnly(true);
                }

                //编号生成之后就不允许再改类别了
                if(record.get('contract_number') != null && record.get('contract_number') != '' && record.get('contract_number') != undefined){
                    record.getField('document_type').setRequired(false);
                    record.getField('document_type_n').setRequired(false);
                    record.getField('document_type').setReadOnly(true);
                    record.getField('document_type_n').setReadOnly(true);
                }


            }

            //debugger;
            if(ds.id == '${/parameter/@layout_code}_F_BASE_INFO_lon_contract_ds'){
                if(record.get('mortgage_flag') == 'Y'){
                    $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').show();
                    $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").next().show();
                } else {
                    $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').hide();
                    $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").next().hide();
                }

                if (record.get('pledge_flag') == 'Y' || record.get('transfer_flag') == 'Y') {
                    $jq('#${/parameter/@layout_code}_T_PLEDGE_INFO_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").next().show();
                } else {
                    $jq('#${/parameter/@layout_code}_T_PLEDGE_INFO_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").next().hide();
                }

                if (record.get('assure_flag') == 'Y') {
                    $jq('#${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").next().show();
                } else {
                    $jq('#${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").next().hide();
                }

                if (record.get('gz_pledge_flag') == 'Y') {
                    $jq('#${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").next().show();
                } else {
                    $jq('#${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").next().hide();
                }
                if (record.get('deposit_flag') == 'Y') {
                    $jq('#${/parameter/@layout_code}_T_SECURITY_MONEY_component_id').show();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").show();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").prev().show();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").next().show();
                } else {
                    $jq('#${/parameter/@layout_code}_T_SECURITY_MONEY_component_id').hide();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").hide();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").prev().hide();
                    $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").next().hide();
                }
            }
        };
        function getamount(contract_id,pledge_times_from,pledge_times_to) {
            var amount1 = null;
            debugger;
            Leaf.request({
                url: '${/request/@context_path}/hls/cus/lon/queryForAmount',
                para: {
                    contract_id: contract_id,
                    pledge_times_from:pledge_times_from,
                    pledge_times_to:pledge_times_to
                },
                sync: true,
                success: function (datas) {
                    if (datas.result.record.length > 0) {
                        amount1 = datas.result.record[0];
                    }
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
            return amount1;
        }
        function onchange_Amount(cb, value, old_value) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_pledge','G_PLEDGE_INFO');
            var quotation_result_ds = $(ds_id);
            var record = quotation_result_ds.getCurrentRecord();
            var amount1 = '';
            amount1 = getamount(record.get('pledge_doc_id'), record.get("pledge_times_from"),record.get("pledge_times_to"));
            record.set('amount', amount1);


        }
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            //debugger;
            if(check_flag=='Y'){
                reload()
            }
            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_contract_ds';
            var lon_contract_bail_ds = '${/parameter/@layout_code}_G_SECURITY_MONEY_ct_lon_contract_bail_ds';
            var bank_ds_id = '${/parameter/@layout_code}_G_RELATED_BANK_lon_con_bank_relation_ds';
            var pledge_ds_id = '${/parameter/@layout_code}_G_PLEDGE_INFO_ct_lon_contract_pledge_ds';

            if (ds.id === base_ds_id) {

                if(name == 'finance_amount'){
                    if(record.get('finance_amount') != null && record.get('finance_amount') != '' && record.get('finance_amount') != undefined
                        && record.get('finance_amount') != null && record.get('finance_amount') != '' && record.get('finance_amount') != undefined){
                        var cny_finance_amount =  mul(record.get('finance_amount'),record.get('con_exchange_rate'));
                        record.set('cny_finance_amount',cny_finance_amount);
                    }
                }

                if (name == 'finance_amount') {
                    if (record.get('finance_amount') != null && record.get('finance_amount') != '') {
                        var lon_contract_bail_records = $(lon_contract_bail_ds).getAll();
                        for (var i = 0; i < lon_contract_bail_records.length; i++) {
                            if (lon_contract_bail_records[i].get('bail_ratio') != null && lon_contract_bail_records[i].get('bail_ratio') != '') {
                                var bail_amount = mul(record.get('finance_amount'), lon_contract_bail_records[i].get('bail_ratio'));
                                lon_contract_bail_records[i].set('bail_amount', bail_amount);
                            }
                        }
                        var remain_withdraw_amount = minus(record.get('finance_amount'), record.get('withdraw_amount'));
                        record.set('remain_withdraw_amount', remain_withdraw_amount);
                    }
                }

                if(name == 'document_type'){
                    if(record.get('document_type') == 'F3' || record.get('document_type') == 'F7'){
                        //debugger;
                        //关联银行
                        $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').show();
                        $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').show();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").show();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").prev().show();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").next().show();

                        record.set('rele_credit_flag', 'N');
                        record.set('rele_credit_flag_n', '否');
                        $(base_ds_id).getCurrentRecord().getField('rele_credit_flag').setReadOnly(true);
                        $(base_ds_id).getCurrentRecord().getField('rele_credit_flag_n').setReadOnly(true);
                        record.set('credit_contract_id', null);
                        record.set('credit_contract_id_n', null);
                        record.set('credit_line_amt', null);
                        record.set('credit_currency_code', null);
                        record.set('credit_currency_code_n', null);
                        record.set('valid_from', null);
                        record.set('valid_to', null);
                    } else{
                        //关联银行
                        $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').hide();
                        $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').hide();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").hide();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").prev().hide();
                        $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").next().hide();
                        $(base_ds_id).getCurrentRecord().getField('rele_credit_flag').setReadOnly(false);
                        $(base_ds_id).getCurrentRecord().getField('rele_credit_flag_n').setReadOnly(false);
                    }

                    if(record.get('document_type') == 'F13' || record.get('document_type') == 'F14' || record.get('document_type') == 'F18'){
                        $jq('#${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id').show();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").show();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").prev().show();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").next().show();
                    }else{
                        $jq('#${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id').hide();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").hide();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").prev().hide();
                        $jq("div[name='${/parameter/@layout_code}_T_WITHDRAW_BORROW_component_id']").next().hide();
                    }
                }

                if(name == 'document_type'){
                    if(record.get('document_type') == 'F3' || record.get('document_type') == 'F11'){
                        record.getField('contract_name').setReadOnly(false);
                        record.getField('contract_name').setRequired(true);
                    }else{
                        record.getField('contract_name').setRequired(false);
                        record.getField('contract_name').setReadOnly(true);
                    }

                    if(record.get('document_type') == 'F21'){
                        record.getField('original_contract_number').setRequired(true);
                    }else{
                        record.getField('original_contract_number').setRequired(false);
                    }
                }

                if(name == 'con_exchange_rate'){
                    if(record.get('finance_amount') != null && record.get('finance_amount') != '' && record.get('finance_amount') != undefined
                        && record.get('finance_amount') != null && record.get('finance_amount') != '' && record.get('finance_amount') != undefined){
                        var cny_finance_amount =  mul(record.get('finance_amount'),record.get('con_exchange_rate'));
                        record.set('cny_finance_amount',cny_finance_amount);
                    }
                }

            }

            //debugger;
            if (ds.id == lon_contract_bail_ds) {
                var base_record = $(base_ds_id).getCurrentRecord();
                if (name == 'bail_ratio') {
                    if (record.get('bail_ratio') != null && record.get('bail_ratio') != ''
                        && base_record.get('finance_amount') != null && base_record.get('finance_amount') != '') {
                        var bail_amount = mul(record.get('bail_ratio'), base_record.get('finance_amount'));
                        record.set('bail_amount', bail_amount);
                    } else {
                        record.set('bail_amount', null);
                    }
                }
            }

            if (ds.id == bank_ds_id) {
                var base_record = $(base_ds_id).getCurrentRecord();
                if (name == 'amount_proportion') {
                    if (record.get('amount_proportion') != null && record.get('amount_proportion') != '' && base_record.get('finance_amount') != null && base_record.get('finance_amount') != '') {
                        var contribute_amount = mul(record.get('amount_proportion'), base_record.get('finance_amount'));
                        record.set('contribute_amount', contribute_amount);
                    } else {
                        record.set('contribute_amount', null);
                    }
                }
            }


            if (ds.id == '${/parameter/@layout_code}_F_BASE_INFO_lon_contract_ds') {

                //组件隐藏
                if(name == 'mortgage_flag'){
                    if(value == 'Y'){
                        $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').show();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").show();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").prev().show();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").next().show();
                    } else {
                        $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').hide();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").hide();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").prev().hide();
                        $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").next().hide();
                    }
                }
                if (name == 'pledge_flag') {
                    if (value == 'Y' || record.get('transfer_flag') == 'Y') {
                        $jq('#${/parameter/@layout_code}_T_PLEDGE_INFO_component_id').show();
                        $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").show();
                        $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").prev().show();
                        $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").next().show();
                    } else {
                        $jq('#${/parameter/@layout_code}_T_PLEDGE_INFO_component_id').hide();
