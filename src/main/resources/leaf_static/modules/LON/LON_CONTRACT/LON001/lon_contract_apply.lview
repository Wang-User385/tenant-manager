        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, record, config_records, bp_seq) {

            //debugger;
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            var lonContractRecord = $(lon_contract_id).getCurrentRecord().data;
            var contract_id = lonContractRecord.contract_id;

            // var contract_id = '${/parameter/@contract_id}';
            var attachment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_attachment');

            if (ds.id === attachment_id) {
                ds.setQueryParameter('contract_id', contract_id);
            }


        };



        function setValue(record, data) {
            //debugger;
            for (var i in data) {
                if (data[i] != null) {
                    record[i] = data[i];
                }
            }
        }

        function setValue2(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record.set(i, data[i]);
                }
            }
        }


        //保存
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;

            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            console.log($(lon_contract_id).getCurrentRecord().data);
            if(check_flag=='Y'){
                Leaf.showInfoMessage("提示" ,"该单据已经确认，不能保存！");
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                return false;
            }
            if($(lon_contract_id).validate()){
                var lon_contract_credit_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_CREDIT_WAY_INFO');
                var related_bank_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_bank_relation', 'G_RELATED_BANK');

                var lon_contract_quotation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_quotation');
                var lon_contract_guarantee_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_guarantee');
                var lon_contract_withdraw_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
                var lon_contract_repayment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_repayment');
                var lon_contract_purpose_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_purpose');
                //账户信息
                //var ct_lon_contract_bank_account_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_bank_account');
                //抵押信息
                var ct_lon_contract_mortgage_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_mortgage');
                //质押
                var lon_contract_pledge_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_pledge');
                var lon_internal_security_loan_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_internal_security_loan');
                //保证金信息
                var ct_lon_contract_bail_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_bail');
                //附件信息
                var lon_contract_attachment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_attachment');
                //担保信息
                var lon_contract_guarantor_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_guarantor');
                //国债质押
                var lon_con_bond_relation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_bond_relation');
                //展期信息
                var lon_con_withdraw_borrow_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_withdraw_borrow');

                var lonContractRecord = $(lon_contract_id).getCurrentRecord().data;


                var rele_credit_flag = lonContractRecord.rele_credit_flag;
                var finance_amount = lonContractRecord.finance_amount;
                var credit_line_amt = lonContractRecord.credit_line_amt;
                var credit_unexposure_amt = lonContractRecord.credit_unexposure_amt;
                if(rele_credit_flag == 'Y'){
                    if(finance_amount > credit_line_amt){
                        $L.showMessage('提示','融资金额应小于关联授信的授信额度！');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                    if(finance_amount > credit_unexposure_amt){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" ,"融资金额大于授信剩余可用金额！");
                        return false;
                    }

                }
                //debugger;
                if(lonContractRecord.contract_number == null || lonContractRecord.contract_number == ''){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" ,"融资合同编号不能为空！");
                    return false;
                }

                if(lonContractRecord.contract_number != null || lonContractRecord.contract_number != ''){
                    var contractNumberCheck = new RegExp("[`~!@#$^&*()=|{}':;',\\[\\].<>/?~！@#￥……&*（）——|{}【】‘；：”“'。，、？]");
                    if(contractNumberCheck.test(lonContractRecord.contract_number)){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" ,"融资合同编号中包含特殊字符！");
                        return false;
                    };
                    Leaf.request({
                        url: '${/request/@context_path}/hlsLon/contract/check',
                        para: {
                            contractNumber: lonContractRecord.contract_number
                        },
                        success: function(res){
                            console.log(res);
                            console.log(res.result);
                            console.log(res.result.record);
                            console.log(res.result.record.length);
                            var rse = res.result.record.length;
                            if(rse > 0){
                                var rs = res.result.record;
                                for(var i = 0; i < rs.length; i++){
                                    if(rs[i].contract_number == lonContractRecord.contract_number && rs[i].contract_id != lonContractRecord.contract_id){
                                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                        Leaf.showMessage("提示", "融资合同编号已存在！");
                                        return false;
                                    }
                                }
                            }
                        },
                        failure: function(){
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            return false;
                        },
                        error: function(){
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            return false;
                        },
                        sync: true,
                        scope: this
                    });
                }

                if(lonContractRecord.document_type == null || lonContractRecord.document_type == '' || lonContractRecord.document_type == undefined){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" ,"融资种类不能为空！");
                    return false;
                }

                if(lonContractRecord.document_type_n != '超短贷'){
                    if(lonContractRecord.credit_contract_id == null || lonContractRecord.credit_contract_id == '' || lonContractRecord.credit_contract_id == undefined) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" ,"融资种类不为超短贷时，授信编码不能为空！");
                        return false;
                    }
                }

                if(lonContractRecord.document_type_n == '委贷置换'){
                    if(lonContractRecord.original_contract_number == null || lonContractRecord.original_contract_number == '' || lonContractRecord.original_contract_number == undefined){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" ,"融资种类为委贷置换时，原合同号不能为空！");
                        return false;
                    }
                }


                if(lonContractRecord.currency == null || lonContractRecord.currency == '' || lonContractRecord.currency == undefined){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" ,"融资币种不能为空！");
                    return false;
                }
                //console.log(new Date(lonContractRecord.date_from));
                //校验融资合同执行期
                if(lonContractRecord.financing_term_from < new Date(lonContractRecord.date_from)){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var dateFrom = new Date(lonContractRecord.date_from);
                    var from = dateFrom.getFullYear()+"-"+(dateFrom.getMonth()+1)+"-"+dateFrom.getDate();
                    Leaf.showInfoMessage("提示" ,"“合同执行期从”不能早于授信有效期("+from+")！");
                    return false;
                }

                if(lonContractRecord.financing_term_to > new Date(lonContractRecord.date_to)){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var dateTo = new Date(lonContractRecord.date_to);
                    var dto = dateTo.getFullYear()+"-"+(dateTo.getMonth()+1)+"-"+dateTo.getDate();
                    Leaf.showInfoMessage("提示" ,"“合同执行期到”不能晚于授信有效期("+dto+")！");
                    return false;
                }

                if(lonContractRecord.financing_term_from > lonContractRecord.financing_term_to){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" ,"合同执行期从不能大于合同执行期到！");
                    return false;
                }

                //把其他属性去掉，避免栈溢出
                lonContractRecord[lon_contract_credit_id.replace('_ds','')]=undefined;
                lonContractRecord[related_bank_id.replace('_ds','')]=undefined;
                lonContractRecord[lon_contract_quotation_id.replace('_ds','')]=undefined;
                lonContractRecord[lon_contract_guarantee_id.replace('_ds','')]=undefined;
                lonContractRecord[lon_contract_withdraw_id.replace('_ds','')]=undefined;
                lonContractRecord[lon_contract_repayment_id.replace('_ds','')]=undefined;
                lonContractRecord[lon_contract_purpose_id.replace('_ds','')]=undefined;
                //担保信息
                lonContractRecord[lon_contract_guarantor_id.replace('_ds','')]=undefined;
                //账户
                //lonContractRecord[ct_lon_contract_bank_account_id.replace('_ds','')]=undefined;
                //抵押
                lonContractRecord[ct_lon_contract_mortgage_id.replace('_ds', '')] = undefined;
                //质押
                lonContractRecord[lon_contract_pledge_id.replace('_ds', '')] = undefined;
                lonContractRecord[lon_internal_security_loan_id.replace('_ds', '')] = undefined;
                //保证金
                lonContractRecord[ct_lon_contract_bail_id.replace('_ds', '')] = undefined;
                //附件
                lonContractRecord[lon_contract_attachment_id.replace('_ds', '')] = undefined;
                //国债质押
                lonContractRecord[lon_con_bond_relation_id.replace('_ds', '')] = undefined;
                //展期信息
                lonContractRecord[lon_con_withdraw_borrow_id.replace('_ds', '')] = undefined;

                lonContractRecord['company_id'] = '${/session/@companyId}';
                console.log(lonContractRecord);

                // var  lonContractQuotation =$(lon_contract_quotation_id).getCurrentRecord().data;
                // lonContractRecord['lon_contract_quotation']=lonContractQuotation;

                //抵押信息  --List<HlsCusCtLonContractMortgage> hlsCusCtLonContractMortgages;
                if ($(ct_lon_contract_mortgage_id).getAll().length != 0) {
                    var ct_lon_contract_mortgage_records = $(ct_lon_contract_mortgage_id).getAll();
                    var hls_cus_ct_lon_contract_mortgages = [];
                    lonContractRecord['hls_cus_ct_lon_contract_mortgages'] = [];
                    for (var i = 0; i < ct_lon_contract_mortgage_records.length; i++) {
                        if(ct_lon_contract_mortgage_records[i].data.mortgage_date_from > ct_lon_contract_mortgage_records[i].data.mortgage_date_to){
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showInfoMessage("提示" ,"抵押期限从不能大于抵押期限到！");
                            return false;
                        }
                        hls_cus_ct_lon_contract_mortgages[i] = {};
                        setValue(hls_cus_ct_lon_contract_mortgages[i], ct_lon_contract_mortgage_records[i].data);
                        lonContractRecord['hls_cus_ct_lon_contract_mortgages'].push(hls_cus_ct_lon_contract_mortgages[i]);
                    }
                }










                var lon_contract_number = lonContractRecord.contract_number;
                var lonContract_id = lonContractRecord.contract_id;

                var saveData = [];



                //质押信息   List<HlsCusCtLonContractPledge> ctLonContractPledges;
                if ($(lon_contract_pledge_id).getAll().length != 0) {
                    var ctLonContractPledge_records = $(lon_contract_pledge_id).getAll();
                    var ct_lon_contract_pledges = [];
                    lonContractRecord['ct_lon_contract_pledges'] = [];
                    for (var i = 0; i < ctLonContractPledge_records.length; i++) {
                        ct_lon_contract_pledges[i] = {};
                        saveData.push(ctLonContractPledge_records[i].data);
                        if(ctLonContractPledge_records[i].data.pledge_times_from >ctLonContractPledge_records[i].data.pledge_times_to){
                            Leaf.showInfoMessage("提示" ,"质押期限从需小于质押期限到！");
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                            return false;

                        }else if(ctLonContractPledge_records[i].data.pledge_contract_number) {
                            // var contract_id = $(lon_contract_id).data[0].data.contract_id;
                            // var lonRecord = lonContractRecord;
                            // lonRecord['contract_number'] = ctLonContractPledge_records[i].data.pledge_contract_number;
                            // lonRecord['contract_id'] = contract_id;
                            // Leaf.request({
                            //     url: '${/request/@context_path}/hls/cus/lon/queryContractNumber',
                            //     para: lonRecord,
                            //
                            //     success: function(res){
                            //         console.log('质押校验请求');
                            //     },
                            //     failure: function() {
                            //         return false;
                            //     },
                            //     error: function(){
                            //         return false;
                            //     },
                            //     sync: false,
                            //     scope: this
                            // })
                        }

                        setValue(ct_lon_contract_pledges[i], ctLonContractPledge_records[i].data);



                        lonContractRecord['ct_lon_contract_pledges'].push(ct_lon_contract_pledges[i]);


                    }
                }
                flag = true;
                Leaf.request({
                    url: '${/request/@context_path}/hls/cus/lon/queryContractNumber',
                    para: saveData,
                    success: function(res){
                        if(!res.success){
                            Leaf.showMessage('提示', res.message);
                            flag=false;
                            return false;
                        }
                    },
                    failure: function() {
                        flag=false;
                        return false;
                    },
                    error: function(){
                        flag=false;
                        return false;
                    },
                    sync: true,
                    scope: this
                });
                if(!flag){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    return flag;
                }





                //保证金金额   List<HlsCusLonContractBail> hlsCusLonContractBails;
                //console.log($(ct_lon_contract_bail_id).getAll());
                if ($(ct_lon_contract_bail_id).getAll().length != 0) {
                    var ct_lon_contract_bail_records = $(ct_lon_contract_bail_id).getAll();
                    var hls_cus_lon_contract_bails = [];
                    lonContractRecord['hls_cus_lon_contract_bails'] = [];
                    for (var i = 0; i < ct_lon_contract_bail_records.length; i++) {
                        hls_cus_lon_contract_bails[i] = {};
                        setValue(hls_cus_lon_contract_bails[i], ct_lon_contract_bail_records[i].data);
                        lonContractRecord['hls_cus_lon_contract_bails'].push(hls_cus_lon_contract_bails[i]);
                    }
                }
                //附件信息 List<HlsCusLonContractAttachment> lonContractAttachments;
                debugger;
                if ($(lon_contract_attachment_id).getAll().length != 0) {
                    var lon_contract_attachment_id_records = $(lon_contract_attachment_id).getAll();
                    var lonContractAttachments = [];
                    lonContractRecord['lon_contract_attachments'] = [];
                    for (var i = 0; i < lon_contract_attachment_id_records.length; i++) {
                        lonContractAttachments[i] = {};
                        lon_contract_attachment_id_records[i].data['source_type'] = 'LOAN_CONTRACT';
                        lon_contract_attachment_id_records[i].data['source_id'] = lonContractRecord.contract_id;
                        setValue(lonContractAttachments[i], lon_contract_attachment_id_records[i].data);
                        lonContractRecord['lon_contract_attachments'].push(lonContractAttachments[i]);
                    }

                }

debugger;
                //担保信息
                if($(lon_contract_guarantor_id).getAll().length != 0 ){
                    var  guarantor_records =$(lon_contract_guarantor_id).getAll();
                    var hlsCusLonContractGuarantorList = [];
                    lonContractRecord['hls_cus_lon_contract_guarantor_list']=[];
                    for (var i=0;i<guarantor_records.length;i++){
                        hlsCusLonContractGuarantorList[i] = {};

                        setValue(hlsCusLonContractGuarantorList[i],guarantor_records[i].data);
                        lonContractRecord['hls_cus_lon_contract_guarantor_list'].push(hlsCusLonContractGuarantorList[i]);

                        var contract_id = guarantor_records[i].data.contract_id;
                        var company_name = guarantor_records[i].data.company_name;
                        var bp_id_n = guarantor_records[i].data.bp_id_n;
                        if(company_name == null || company_name == ''){
                            if(bp_id_n == null || bp_id_n == ''){
                                Leaf.showInfoMessage('提示', '请选择担保人信息');
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                return false;
                            }
                        }
                        var record = lonContractRecord;
                        record['contract_id'] = contract_id;
                        Leaf.request({
                            url: '${/request/@context_path}/hlsLon/contract/company/find',
                            para: record,
                            success: function(res){
                                console.log("=============================");
                                var records = res.result.record;
                                if(records.length > 0){
                                    for (var i = 0; i < records.length; i++){
                                        if (records[i].contract_id != contract_id){
                                            Leaf.showMessage('${l:HLS.PROMPT}', '担保人(' + guarantor_records[i].data.description + ')在其他融资合同('+records[i].contract_number+')内存在担保。');
                                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                            return false;
                                        }
                                    }
                                }
                            },
                            failure: function(){

                            },
                            error: function(){
                                Leaf.showMessage('${l:HLS.PROMPT}', 'lon_contract_apply.lview 担保信息校验错误！');
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                return false;
                            },
                            sync: false,
                            scope: this
                        })
                    }
                }

                if (lonContractRecord['contract_id'] == null || lonContractRecord['contract_id'] == '') {
                    lonContractRecord['contract_id'] = '0';
                }


                console.log(lonContractRecord);
                lonContractRecord['contract_number'] = lon_contract_number;
                lonContractRecord['contract_id'] = lonContract_id;
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/contract/create',
                    para: lonContractRecord,


                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        debugger
                        console.log(res);
                        $(lon_contract_id).setQueryParameter('contract_id', res.result.record[0].contract_id);

                        $(ct_lon_contract_mortgage_id).setQueryParameter('contract_id', res.result.record[0].contract_id);
                        $(lon_contract_pledge_id).setQueryParameter('contract_id', res.result.record[0].contract_id);
                        $(ct_lon_contract_bail_id).setQueryParameter('contract_id', res.result.record[0].contract_id);
                        $(lon_contract_attachment_id).setQueryParameter('contract_id', res.result.record[0].contract_id);
                        $(lon_contract_id).query();
                        Leaf.showMessage('提示', '成功');
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }else{
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
            //}

        };


        //质押合同释放






        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // debugger;
            var link_function;

            if (name == 'download' && record.get('contract_attachment_id')) {
                link_function = 'fin003f1_download_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + '上传/下载' + '</a>';
            }

        };







        function fin003f1_download_detail(ds_id, record_id) {

            debugger;
            var record = $(ds_id).findById(record_id);
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            var con_record = $(lon_contract_id).getCurrentRecord();
            var contract_id = con_record.get('contract_id');

            var contract_attachment_id = record.get('contract_attachment_id');
            if (contract_id == null || contract_id == '' || contract_id == undefined) {
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            if(contract_attachment_id== null || contract_attachment_id == '' || contract_attachment_id == undefined ){
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'lon001_open_attachment_winid',
                url: url,
                params: {
                    'header_id': contract_attachment_id,
                    'table_name': 'LON_CONTRACT_ATTACHMENT',

                    winid: 'lon001_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_lon_contract_attachment_ds";
                $(document_list_ds_id).query();
            });
        }





        //附件上传
        window['${/parameter/@layout_code}_G_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            // debugger;

            // var contract_id = '${/parameter/@contract_id}';
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            var lonContractRecord = $(lon_contract_id).getCurrentRecord().data;
            var contract_id = lonContractRecord.contract_id;

            if (contract_id == null || contract_id == '' || contract_id == undefined) {
                $L.showInfoMessage("提示", "请先保存信息再上传附件!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                $L.showInfoMessage("提示", "当前无法编辑页面!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                url: url,
                params: {
                    'header_id': contract_id,
                    'table_name': 'LON_CONTRACT',

                    winid: 'prj316_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_lon_contract_attachment_ds";
                $(document_list_ds_id).query();
            });
        };


        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {

            var lon_contract_withdraw_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_withdraw');
            var lon_con_bond_relation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_bond_relation');
            if(ds.id == lon_contract_withdraw_id){
                var withdrawRecord = $(lon_contract_withdraw_id).getSelected();
                var delete_flag = 'Y';
                for (var i = 0; i < withdrawRecord.length; i++) {
                    if (withdrawRecord[i].data.withdraw_status != 'NEW') {
                        delete_flag = 'N';
                        break;
                    }
                }
                if (delete_flag == 'N') {
                    Leaf.showWarningMessage('提示', '只有新建的单据可以删除!');
                    return false;
                } else {
                    return true;
                }
            }

            if(ds.id == lon_con_bond_relation_id){
                var lon_con_bond_relation_records = $(lon_con_bond_relation_id).getSelected();
                var hlsCusLonContractBondList = [];
                for(var i=0;i<lon_con_bond_relation_records.length;i++){
                    if(lon_con_bond_relation_records[i].get('bond_id') != null){
                        hlsCusLonContractBondList[i] = lon_con_bond_relation_records[i].data;
                    }
                }

                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/lon/con/bond/relation/updateOccupiedFlag',
                    para: hlsCusLonContractBondList,


                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }

        };

        Leaf.onReady(function(){
            if('${/parameter/@function_usage}' == 'CREATE'){
                //关联银行
                $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').hide();
                $jq('#${/parameter/@layout_code}_T_RELATED_BANK_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_RELATED_BANK_component_id']").next().hide();
                //抵押信息
                $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').hide();
                $jq('#${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_MORTGAGE_INFO_component_id']").next().hide();

                //质押信息
                $jq('#${/parameter/@layout_code}_T_PLEDGE_INFO_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_PLEDGE_INFO_component_id']").next().hide();

                //担保信息
                $jq('#${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_GUARANTOR_INFO_component_id']").next().hide();


                //保证金信息
                $jq('#${/parameter/@layout_code}_T_SECURITY_MONEY_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").next().hide();
            }
        });

        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {

            //debugger;
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            var record= $(lon_contract_id).getCurrentRecord();

            if($(lon_contract_id).validate()){
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                if(record.get('contract_status'=='APPROVED')){
                    $L.showInfoMessage("提示", "已确认!", null);
                       return  false;
                }
          var  contract_id=record.get('contract_id');
                if (contract_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '确定确认？', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/hlsLon/contract/update',
                            para: {
                                contract_id: contract_id,
                                contract_status:'APPROVED'
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();

                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }



            }



        }



        function  reload(){
            var lon_contract_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract', 'F_BASE_INFO');
            var record = $(lon_contract_id).At(0);

            record.getField('lon_company_id').setReadOnly(true);
            record.getfield('lon_company_id_n').setreadonly(true);
            record.getfield('credit_bp_id').setreadonly(true);
            record.getfield('credit_bp_id_n').setreadonly(true);
            record.getfield('contract_number').setreadonly(true);

            record.getfield('document_type').setreadonly(true);
            record.getfield('document_type_n').setreadonly(true);
            record.getfield('currency').setreadonly(true);
            record.getfield('currency_n').setreadonly(true);
            record.getfield('finance_amount').setreadonly(true);


            record.getfield('financing_term_from').setreadonly(true);
            record.getfield('financing_term_to').setreadonly(true);
            record.getfield('original_contract_number').setreadonly(true);
            record.getfield('credit_contract_id').setreadonly(true);
            record.getfield('created_by_n').setreadonly(true);
            record.getfield('description').setreadonly(true)

            record.getfield('credit_flag').setreadonly(true);
            record.getfield('mortgage_flag').setreadonly(true);
            record.getfield('pledge_flag').setreadonly(true);
            record.getfield('assure_flag').setreadonly(true);
            record.getfield('deposit_flag').setreadonly(true);
            record.getfield('other_flag').setreadonly(true);
            record.getfield('note').setreadonly(true);

            var lon_contract_guarantor_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_guarantor', 'G_GUARANTOR_INFO');
            var  records1=$(lon_contract_guarantor_id).getAll();
            for(var i=0;i<records1.length;i++){
                var record1=records1.get[i]

                record1.getfield('bp_id').setreadonly(true);
                record1.getfield('description').setreadonly(true);
                record1.getfield('bp_id_n').setreadonly(true);

            }

            var ct_lon_contract_mortgage_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_mortgage', 'G_MORTGAGE_INFO');
            var  records2s=$(ct_lon_contract_mortgage_id).getAll();
            for(var i=0;i<records2s.length;i++){
                var record2=records2s.get[i]

                record2.getfield('MORTGAGE_NAME').setreadonly(true);
                record2.getfield('AMOUNT').setreadonly(true);
                record2.getfield('MORTGAGE_DATE_FROM').setreadonly(true);
                record2.getfield('MORTGAGE_DATE_TO').setreadonly(true);
                record2.getfield('NOTE').setreadonly(true);


            }

            var ct_lon_contract_pledge_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_pledge', 'G_PLEDGE_INFO');
            var  records3s=$(ct_lon_contract_pledge_id).getAll();
            for(var i=0;i<records3s.length;i++){
                var record3=records3s.get[i]

                record3.getfield('pledge_contract_number').setreadonly(true);
                record3.getfield('pledge_contract_number_n').setreadonly(true);
                record3.getfield('pledge_contract_name').setreadonly(true);
                record3.getfield('pledge_contract_name_n').setreadonly(true);
                record3.getfield('pledge_times_from').setreadonly(true);
                record3.getfield('pledge_times_from_n').setreadonly(true);
                record3.getfield('pledge_times_to').setreadonly(true);
                record3.getfield('pledge_times_to_n').setreadonly(true);
                record3.getfield('amount').setreadonly(true);

                record3.getfield('description').setreadonly(true);


            }




            var ct_lon_contract_bail_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_lon_contract_bail', 'G_SECURITY_MONEY');
            var  records4s=$(ct_lon_contract_bail_id).getAll();
            for(var i=0;i<records4s.length;i++){
                var record4=records4s.get[i]

                record4.getfield('bail_ratio').setreadonly(true);
                record4.getfield('bail_amount').setreadonly(true);
                record4.getfield('description').setreadonly(true);



            }

            var lon_contract_attachment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_contract_attachment', 'G_ATTACHMENT');
            var  records5s=$(lon_contract_attachment_id).getAll();
            for(var i=0;i<records5s.length;i++){
                var record5=records5s.get[i]

                record5.getfield('document_name').setreadonly(true);
                record5.getfield('description').setreadonly(true);



            }
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
