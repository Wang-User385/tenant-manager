                        $jq("div[name='${/parameter/@layout_code}_T_GZ_PLEDGE_INFO_component_id']").next().hide();
                    }
                }
                if (name == 'deposit_flag') {
                    if (value == 'Y') {
                        $jq('#${/parameter/@layout_code}_T_SECURITY_MONEY_component_id').show();
                        $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").show();
                        $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").prev().show();
                        $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").next().show();
