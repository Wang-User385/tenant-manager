                        $jq("div[name='${/parameter/@layout_code}_T_SECURITY_MONEY_component_id']").next().hide();
                    }
                }

            }

            if(ds.id === pledge_ds_id){
debugger;
                if (name === 'pledge_times_to') {
                    onchange_Amount();
                }
            debugger;
                /*var grid_id = '${/parameter/@layout_code}_G_PLEDGE_INFO_ct_lon_contract_pledge_layout_grid_id';
