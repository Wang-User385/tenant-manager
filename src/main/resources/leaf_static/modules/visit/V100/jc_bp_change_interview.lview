<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp100v2_bp_change_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/hls_bp_master_change_history_detail.lview"/>
        <script><![CDATA[
        var bp_type='${/parameter/@bp_type}';
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            // debugger;
            if(ds.id == '${/parameter/@layout_code}_T_BASIC_hls_bp_master_change_req_ds'){
                qpara['bp_id'] = '${/parameter/@bp_id}';
            }
        };
        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            // debugger
            if (name == 'change_version') {
                return '<a href="javascript:open_change_detail_info(\'' + record.ds.id + '\',\'' + record.id + '\')">' + record.get('document_version_n') + '</a>';
            }
            return value;
        };
        function open_change_detail_info(ds_id, record_id) {
            debugger
            var record = $(ds_id).findById(record_id);
            var param = {};
            var  bp_id = record.get('bp_id');
            param['change_req_id'] =record.get('change_req_id');
            // param['bp_id'] = bp_id;
            if ('${/parameter/@bp_class}' == 'ORG') {
                // if(bp_type=='MANUFACTURER') {
                //     param['function_code'] = 'BP100F4'
                // }else if(bp_type=='VENDER' || bp_type=='DEALER'){
                //     param['function_code'] = 'PRJ320_LS_F1';
                // }else{
                //     param['function_code'] = 'BP100F1';
                // }
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'QUERY';
            // if (record.get('status') == 'APPROVING' || record.get('status') == 'APPROVED'||'${/parameter/@function_usage}' === 'QUERY') {
            //     param['function_usage'] = 'QUERY';
            // } else {
            //     param['function_usage'] = 'MODIFY';
            // }
            param['bp_type']=bp_type;
            param['bp_id'] = '${/parameter/@bp_id}';
            param['document_category'] = 'HLS_BP_MASTER_CHANGE';
            param['bp_class'] = '${/parameter/@bp_class}';
            param['bp_project_flag'] = '${/parameter/@bp_project_flag}';
            param['bp_contract_flag'] = '${/parameter/@bp_contract_flag}';
            param['url_title'] = '商业伙伴历史版本';
            param['winid'] = 'bp_master_change_modify_winid';
            hls_doc_get_layout_code(param, 'bp100v2_bp_change_modify_id', ds_id, 'BP100V2');
        }
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            new Leaf.showConfirm('${l:HLS.PROMPT}', '确认新增商业伙伴版本吗？', function okFun() {
                // window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                debugger
                Leaf.request({
                    url: '${/request/@context_path}/hls/bp/master/change/validate',
                    para: {bp_id: '${/parameter/@bp_id}'},
                    success: function (res) {
                        if (res.success) {
                            debugger
                            Leaf.request({
                                url: '${/request/@context_path}/hls/bp/master/change/request/submit',
                                para: {bp_id: '${/parameter/@bp_id}'},
                                success: function (res) {
                                    debugger
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    var change_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_change_req');
                                    $(change_ds_id).query();
                                    if (res.success) {
                                        Leaf.showMessage('提示', '新增变更成功！');
                                    }
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        }
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100);
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>