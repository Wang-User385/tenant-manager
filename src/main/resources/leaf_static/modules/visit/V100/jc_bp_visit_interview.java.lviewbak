<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        ]]></script>
        <a:dataSets>
            <a:dataSet id="JcBpVisitInterview_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/jc/bp/visit/interview/query"
                       submitUrl="${/request/@context_path}/jc/bp/visit/interview/submit"
                       deleteUrl="${/request/@context_path}/jc/bp/visit/interview/remove" selectable="true">
                <a:fields>
                        <a:field name="visit_id"/>
                        <a:field name="bp_id"/>
                        <a:field name="visit_name"/>
                        <a:field name="visit_person"/>
                        <a:field name="visit_date"/>
                        <a:field name="visit_place"/>
                        <a:field name="note"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton bind="JcBpVisitInterview_grid_id" type="add"/>
                <a:gridButton bind="JcBpVisitInterview_grid_id" type="save"/>
                <a:gridButton bind="JcBpVisitInterview_grid_id" type="delete"/>
                <a:gridButton bind="JcBpVisitInterview_grid_id" type="refresh"/>
            </a:screenTopToolbar>
            <a:grid id="JcBpVisitInterview_grid_id" bindTarget="JcBpVisitInterview_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>
                            <a:column name="visit_name" align="right" autoAdjust="true"
                                      prompt="JcBpVisitInterview.visit_name" editor="JcBpVisitInterview_grid_textfield"/>
                            <a:column name="visit_person" align="right" autoAdjust="true"
                                      prompt="JcBpVisitInterview.visit_person" editor="JcBpVisitInterview_grid_textfield"/>
                            <a:column name="visit_date" align="right" autoAdjust="true"
                                      prompt="JcBpVisitInterview.visit_date" editor="JcBpVisitInterview_grid_datePicker"/>
                            <a:column name="visit_place" align="right" autoAdjust="true"
                                      prompt="JcBpVisitInterview.visit_place" editor="JcBpVisitInterview_grid_textfield"/>
                            <a:column name="note" align="right" autoAdjust="true"
                                      prompt="JcBpVisitInterview.note" editor="JcBpVisitInterview_grid_textfield"/>
                </a:columns>
                <a:editors>
                        <a:textField id="JcBpVisitInterview_grid_textfield"/>
                        <a:numberField id="JcBpVisitInterview_grid_numberField"/>
                        <a:datePicker id="JcBpVisitInterview_grid_datePicker"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>