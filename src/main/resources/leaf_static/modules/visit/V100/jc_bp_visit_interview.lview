<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            //debugger;
            if(ds.id == '${/parameter/@layout_code}_T_BASIC_jc_bp_visit_interview_ds'){
                qpara['bp_id'] = '${/parameter/@bp_id}';
            }
        };
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            if (ds.id === '${/parameter/@layout_code}_T_BASIC_jc_bp_visit_interview_ds') {
                var contracts = $('${/parameter/@layout_code}_T_BASIC_jc_bp_visit_interview_ds').getCurrentRecord();
                record.set('bp_id', '${/parameter/@bp_id}');
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_bp_visit_interview');
            if (ds.id === ds_id) {
                $(ds_id).query();
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
