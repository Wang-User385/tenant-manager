<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var fill_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            var fill_record = $(fill_id).getCurrentRecord();
            if (ds.id === '${/parameter/@layout_code}_G_QUERY_RESULT_jc_fund_filling_detail_ds') {
                record.set('filling_ln_id','${/parameter/@filling_ln_id}');
                record.set('filling_id','${/parameter/@filling_id}');
                record.set('item_code','${/parameter/@fill_item_code}');
                record.set('item','${/parameter/@fill_item}');
                record.set('fund_type','${/parameter/@fund_type}');
                record.set('fill_type','${/parameter/@fill_type}');
                record.set('fill_quarter','${/parameter/@fill_quarter}');
                record.set('fill_mon','${/parameter/@fill_mon}');
                record.set('fill_week','${/parameter/@fill_week}');
            }

        };
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var fill_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            if(ds.id == fill_id && record ){
                record.set('fill_item','${/parameter/@fill_item}');
            }
        }
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_detail');
            if (ds_id == ds.id) {
                qpara['filling_ln_id'] = '${/parameter/@filling_ln_id}';
                qpara['fill_item_code'] = '${/parameter/@fill_item_code}';
                qpara['fund_type'] = '${/parameter/@fund_type}';
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            var record = $(ds_id).getCurrentRecord();
            Leaf.Masker.mask(Ext.getBody(), '金额更新中...');
            Leaf.request({
                url: "${/request/@context_path}/jc/fund/filling/detail/summary/update",
                para: {
                    fill_year: record.get('fill_year'),
                    host_unit_id:record.get('unit_id'),
                    filling_id:record.get('filling_id'),
                    filling_ln_id:record.get('filling_ln_id'),
                    fill_type:record.get('fill_type'),
                    fill_quarter:record.get('fill_quarter'),
                    fill_mon:record.get('fill_mon'),
                    fill_week:record.get('fill_week'),
                    fill_update:"Y"
                },
                type: "POST",
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });
        };


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_G_QUERY_RESULT_USER_BUTTON1_layout_dynamic_tab_click'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_detail');
            var detail_reocrd = $(ds_id).getSelected()[0];
            Leaf.request({
                url: "${/request/@context_path}/jc/fund/filling/detail/delete",
                para: {
                    filling_detail_id:detail_reocrd.get('filling_detail_id')
                },
                type: "POST",
                success: function (res) {
                    $(ds_id).query();
                    Leaf.Masker.mask(Ext.getBody(), '删除成功，金额更新中...');
                    var fill_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
                    var fill_record = $(fill_ds_id).getCurrentRecord();
                    Leaf.request({
                        url: "${/request/@context_path}/jc/fund/filling/detail/update",
                        para: {
                            fill_year: fill_record.get('fill_year'),
                            host_unit_id: fill_record.get('unit_id'),
                            filling_id: fill_record.get('filling_id'),
                            fill_type: fill_record.get('fill_type'),
                            fill_quarter: fill_record.get('fill_quarter'),
                            fill_mon: fill_record.get('fill_mon'),
                            fill_week: fill_record.get('fill_week')
                        },
                        type: "POST",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        scope: this
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            })

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
