<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp300_fp_year_id"
                url="${/request/@context_path}/modules/FP/FP300/fund_filling_summary_year.lview"/>
        <a:link id="fp300_fp_quarter_id"
                url="${/request/@context_path}/modules/FP/FP300/fund_filling_summary_quarter.lview"/>
        <a:link id="fp300_fp_mon_id"
                url="${/request/@context_path}/modules/FP/FP300/fund_filling_summary_mon.lview"/>
        <a:link id="fp300_fp_week_id"
                url="${/request/@context_path}/modules/FP/FP300/fund_filling_summary_week.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'detail' && !record.isNew) {
                return '<a href="javascript:open_fp_year_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '计划明细' + '</a>';
            }
        }

        function open_fp_year_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '资金计划汇总明细';
            if (record.get('summary_status') == 'NEW' || record.get('summary_status') == 'REJECTED') {
                param['function_usage'] = 'MODIFY';
            } else {
                param['function_usage'] = 'QUERY';
            }
            param['winid'] = 'fp300_d01_detail_winid';
            var link_url;
            if (record.get('fill_type') == 'YEAR') {
                link_url = 'fp300_fp_year_id';
                param['function_code'] = 'FP200D01';
            } else if (record.get('fill_type') == 'QUARTER') {
                link_url = "fp300_fp_quarter_id";
                if (record.get('fill_quarter') == 'FIRST') {
                    param['function_code'] = 'FP200D02';
                } else if (record.get('fill_quarter') == 'SECOND') {
                    param['function_code'] = 'FP200D03';
                } else if (record.get('fill_quarter') == 'THIRD') {
                    param['function_code'] = 'FP200D04';
                } else if (record.get('fill_quarter') == 'FOURTH') {
                    param['function_code'] = 'FP200D05';
                }
            } else if (record.get('fill_type') == 'MON') {
                link_url = 'fp300_fp_mon_id';
                param['function_code'] = 'FP200D06';
            } else if (record.get('fill_type') == 'WEEK') {
                link_url = 'fp300_fp_week_id';
                param['function_code'] = 'FP200D07';
            }
            hls_doc_get_layout_code(param, link_url, ds_id, 'FP200');
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
