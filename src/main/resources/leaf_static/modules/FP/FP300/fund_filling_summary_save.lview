<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            if (ds_id == ds.id) {
                qpara['filling_ln_id'] = '${/parameter/@filling_ln_id}';
            }
        };
        // <a:gridButton click="FP300S_SAVE_LAYOUT_DYNAMIC_CLICK" id="FP300S_save" text="确认"/>
        // window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln', 'G_QUERY_RESULT');
        //     $(ds_id).submit();
        // };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            //初始金额更新后 则更新其他金额
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            Leaf.Masker.mask(Ext.getBody(), '金额更新中...');
            Leaf.request({
                url: "${/request/@context_path}/jc/fund/filling/detail/summary/update",
                para: {
                    fill_year: '${/parameter/@fill_year}',
                    host_unit_id: '${/parameter/@unit_id}',
                    filling_id: '${/parameter/@filling_id}',
                    fill_type: '${/parameter/@fill_type}',
                    fill_quarter: '${/parameter/@fill_quarter}',
                    fill_mon: '${/parameter/@fill_mon}',
                    fill_week: '${/parameter/@fill_week}',
                    fill_update:"Y"
                },
                type: "POST",
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
