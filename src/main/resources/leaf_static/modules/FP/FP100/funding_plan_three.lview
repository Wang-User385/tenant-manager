<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp100d04_detail_modify_id"
                url="${/request/@context_path}/modules/FP/FP100/funding_plan_four.lview"/>
        <script><![CDATA[
        var funding_id = '${/parameter/@funding_id}';
        var funding_one_id ='${/parameter/@funding_one_id}';
        var funding_second_id ='${/parameter/@funding_second_id}';
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('funding_second_id', funding_second_id);
        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_funding_plan_three');
            if (ds.id && ds_id == ds.id) {
                record.set('funding_id', funding_id);
                record.set('funding_one_id', funding_one_id);
                record.set('funding_second_id', funding_second_id);
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if(name === 'detail'&& !record.isNew){
                return '<a href="javascript:open_fp_detail_04_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '明细' + '</a>';
            }
        }

        function open_fp_detail_04_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '四级级分类页面';
            param['function_code'] = 'FP100D04';
            param['function_usage'] = 'MODIFY';
            param['funding_id'] = record.get('funding_id');
            param['winid'] = 'fp_d04_detail_winid';

            hls_doc_get_layout_code(param, 'fp100d04_detail_modify_id', ds_id, 'FP100');
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
