<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        ]]></script>
        <a:dataSets>
            <a:dataSet id="JcFundFillingLn_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/jc/fund/filling/ln/query"
                       submitUrl="${/request/@context_path}/jc/fund/filling/ln/submit"
                       deleteUrl="${/request/@context_path}/jc/fund/filling/ln/remove" selectable="true">
                <a:fields>
                        <a:field name="FILLING_LN_ID"/>
                        <a:field name="FILLING_ID"/>
                        <a:field name="FILL_TIEM"/>
                        <a:field name="FIELD_1"/>
                        <a:field name="FIELD_2"/>
                        <a:field name="FIELD_3"/>
                        <a:field name="FIELD_4"/>
                        <a:field name="FIELD_5"/>
                        <a:field name="FIELD_6"/>
                        <a:field name="FIELD_7"/>
                        <a:field name="FIELD_8"/>
                        <a:field name="FIELD_9"/>
                        <a:field name="FIELD_10"/>
                        <a:field name="FIELD_11"/>
                        <a:field name="FIELD_12"/>
                        <a:field name="FIELD_13"/>
                        <a:field name="FIELD_14"/>
                        <a:field name="FIELD_15"/>
                        <a:field name="FIELD_16"/>
                        <a:field name="SUM_AMOUNT"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton bind="JcFundFillingLn_grid_id" type="add"/>
                <a:gridButton bind="JcFundFillingLn_grid_id" type="save"/>
                <a:gridButton bind="JcFundFillingLn_grid_id" type="delete"/>
                <a:gridButton bind="JcFundFillingLn_grid_id" type="refresh"/>
            </a:screenTopToolbar>
            <a:grid id="JcFundFillingLn_grid_id" bindTarget="JcFundFillingLn_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>
                            <a:column name="FILL_TIEM" align="right" autoAdjust="true"
                                      prompt="JcFundFillingLn.FILL_TIEM" editor="JcFundFillingLn_grid_textfield"/>
                </a:columns>
                <a:editors>
                        <a:textField id="JcFundFillingLn_grid_textfield"/>
                        <a:numberField id="JcFundFillingLn_grid_numberField"/>
                        <a:datePicker id="JcFundFillingLn_grid_datePicker"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>