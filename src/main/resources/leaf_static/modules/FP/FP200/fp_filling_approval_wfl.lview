<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="fp200_fp_year_wfl"
                url="${/request/@context_path}/modules/FP/FP200/fund_filling_ln_year.lview"/>
        <a:link id="fp200_fp_quarter_wfl"
                url="${/request/@context_path}/modules/FP/FP200/fund_filling_ln_quarter.lview"/>
        <a:link id="fp200_fp_mon_wfl"
                url="${/request/@context_path}/modules/FP/FP200/fund_filling_ln_mon.lview"/>
        <a:link id="fp200_fp_week_wfl"
                url="${/request/@context_path}/modules/FP/FP200/fund_filling_ln_week.lview"/>
        <script><![CDATA[
        debugger;
        var businessKey = '${/parameter/@businessKey}';

        var param = parent.currentTaskInfo.execution_variables;

        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        var fillingId = param.filter(function (o) {
            return o.name == "fillingId";
        })[0].value;
        var fillType = param.filter(function (o) {
            return o.name == "fillType";
        })[0].value;
        var fillYear = param.filter(function (o) {
            return o.name == "fillYear";
        })[0].value;
        var fillQuarter = param.filter(function (o) {
            return o.name == "fillQuarter";
        })[0].value;
        var fillMon = param.filter(function (o) {
            return o.name == "fillMon";
        })[0].value;
        var fillWeek = param.filter(function (o) {
            return o.name == "fillWeek";
        })[0].value;

        var function_code;
        var link_url;
        if (fillType == 'YEAR') {
            link_url = 'fp200_fp_year_wfl';
            function_code = 'FP200D01';
        } else if (fillType == 'QUARTER') {
            link_url = "fp200_fp_quarter_wfl";
            if (fillQuarter == 'FIRST') {
                function_code= 'FP200D02';
            } else if (fillQuarter == 'SECOND') {
                function_code = 'FP200D03';
            } else if (fillQuarter == 'THIRD') {
                function_code = 'FP200D04';
            } else if (fillQuarter == 'FOURTH') {
                function_code = 'FP200D05';
            }
        } else if (fillType == 'MON') {
            link_url = 'fp200_fp_mon_wfl';
            function_code = 'FP200D06';
        } else if (fillType == 'WEEK') {
            link_url = 'fp200_fp_week_wfl';
            function_code = 'FP200D07';
        }
        var pageChooser = new PageChooser({
            url: $(link_url).getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                filling_id: fillingId,
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: function_code,
                supplement_flag: 'Y',
                fill_year:fillYear,
                fill_quarter:fillQuarter,
                fill_mon:fillMon,
                fill_week:fillWeek,
                fill_type:fillType,
                wfl_flag: "${/parameter/@wflRuleControlFlag}"
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

