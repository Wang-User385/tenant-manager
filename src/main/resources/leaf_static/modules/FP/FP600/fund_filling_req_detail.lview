<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp600d01d_detail_modify_id"
                url="${/request/@context_path}/modules/FP/FP600/fund_req_amount_detail.lview"/>
        <a:link id="fp600d01d_detail_normal_id"
                url="${/request/@context_path}/modules/FP/FP200/fund_filling_detail.lview"/>
        <script><![CDATA[
        var first_day, second_day, third_day, fourth_day, fifth_day, sixth_day, seventh_day, eighth_day, ninth_day;
        var tenth_day, eleventh_day, twelfth_day, thirteenth_day;
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var fill_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling');
            if (ds.id == fill_id && record && ('${/parameter/@function_usage}' == 'CREATE')) {
                record.set('fill_type', '${/parameter/@fill_type}');
                record.set('fill_type_n', '${/parameter/@fill_type_n}');
                record.set('fill_year', '${/parameter/@fill_year}');
                record.set('fill_year_n', '${/parameter/@fill_year_n}');
                record.set('fill_quarter', '${/parameter/@fill_quarter}');
                record.set('fill_quarter_n', '${/parameter/@fill_quarter_n}');
                record.set('unit_id', '${/parameter/@unit_id}');
                record.set('unit_id_n', '${/parameter/@unit_id_n}');
                record.set('fill_user_id', '${/parameter/@fill_user_id}');
                record.set('fill_user_id_n', '${/parameter/@fill_user_id_n}');
                record.set('fill_mon', '${/parameter/@fill_mon}');
                record.set('fill_mon_n', '${/parameter/@fill_mon_n}');
                record.set('fill_week', '${/parameter/@fill_week}');
                record.set('fill_week_n', '${/parameter/@fill_week_n}');
            }
        }

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            var req_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_req');
            var filling_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling');
            if(ds.id == req_ds_id){
                qpara['filling_id'] = '${/parameter/@filling_id}';
            }
            if(ds.id == filling_ds_id){
                qpara['filling_id'] = '${/parameter/@filling_id}';
            }
        };
        //页面加载 初始化行项目
        Leaf.onReady(function () {
            //行创建
            if ('${/parameter/@fill_type}' == 'WEEK') {
                Leaf.request({
                    url: "${/request/@context_path}/jc/fund/filling/week/prompt/query",
                    para: {
                        fill_week: '${/parameter/@fill_week}',
                        fill_year: '${/parameter/@fill_year}',
                        fill_type: '${/parameter/@fill_type}',
                        unit_id: '${/parameter/@unit_id}',
                        fill_quarter: '${/parameter/@fill_quarter}',
                        fill_mon: '${/parameter/@fill_mon}',
                        filling_id: '${/parameter/@filling_id}'
                    },
                    type: "POST",
                    success: function (res) {
                        debugger;
                        var record = res.result.record[0];
                        first_day = record.first_day;
                        second_day = record.second_day;
                        third_day = record.third_day;
                        fourth_day = record.fourth_day;
                        fifth_day = record.fifth_day;
                        sixth_day = record.sixth_day;
                        seventh_day = record.seventh_day;
                        eighth_day = record.eighth_day;
                        ninth_day = record.ninth_day;
                        tenth_day = record.tenth_day;
                        eleventh_day = record.eleventh_day;
                        twelfth_day = record.twelfth_day;
                        thirteenth_day = record.thirteenth_day;
                        var grid_id = 'FP600D01_G_QUERY_RESULT_jc_fund_filling_req_ln_layout_grid_id';
                        var grid_id1 = 'FP600D01_G_QUERY_RESULT1_jc_fund_filling_ln_layout_grid_id';
                        $(grid_id).setColumnPrompt('field1', record.first_day);
                        $(grid_id).setColumnPrompt('field2', record.second_day);
                        $(grid_id).setColumnPrompt('field3', record.third_day);
                        $(grid_id).setColumnPrompt('field4', record.fourth_day);
                        $(grid_id).setColumnPrompt('field5', record.fifth_day);
                        $(grid_id).setColumnPrompt('field6', record.sixth_day);
                        $(grid_id).setColumnPrompt('field7', record.seventh_day);
                        $(grid_id).setColumnPrompt('field8', record.eighth_day);
                        $(grid_id).setColumnPrompt('field9', record.ninth_day);
                        $(grid_id).setColumnPrompt('field10', record.tenth_day);
                        $(grid_id).setColumnPrompt('field11', record.eleventh_day);
                        $(grid_id).setColumnPrompt('field12', record.twelfth_day);
                        $(grid_id).setColumnPrompt('field13', record.thirteenth_day);

                        $(grid_id1).setColumnPrompt('field1', record.first_day);
                        $(grid_id1).setColumnPrompt('field2', record.second_day);
                        $(grid_id1).setColumnPrompt('field3', record.third_day);
                        $(grid_id1).setColumnPrompt('field4', record.fourth_day);
                        $(grid_id1).setColumnPrompt('field5', record.fifth_day);
                        $(grid_id1).setColumnPrompt('field6', record.sixth_day);
                        $(grid_id1).setColumnPrompt('field7', record.seventh_day);
                        $(grid_id1).setColumnPrompt('field8', record.eighth_day);
                        $(grid_id1).setColumnPrompt('field9', record.ninth_day);
                        $(grid_id1).setColumnPrompt('field10', record.tenth_day);
                        $(grid_id1).setColumnPrompt('field11', record.eleventh_day);
                        $(grid_id1).setColumnPrompt('field12', record.twelfth_day);
                        $(grid_id1).setColumnPrompt('field13', record.thirteenth_day);
                    },
                    error: function (res) {
                        Leaf.SideBar.show({
                            type: 'warning',
                            msg: '操作失败',
                            duration: 1000
                        });
                    },
                    failure: function (res) {
                        Leaf.SideBar.show({
                            type: 'warning',
                            msg: '操作失败',
                            duration: 1000
                        });
                    },
                    scope: this
                });

            }

        });

        //初始化
        function initialization_fill() {
            var fill_ln_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            var fill_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling');
            var fill_record = $(fill_ds).getCurrentRecord();
            var filedNameDate = ['field_1', 'field_2', 'field_3', 'field_4', 'field_5', 'field_6', 'field_7', 'field_8', 'field_9', 'field_10', 'field_11', 'field_12'];
            Leaf.Masker.mask(Ext.getBody(), '初始化中...');
            Leaf.request({
                url: "${/request/@context_path}/jc/fund/filling/week/init/query",
                para: {
                    fill_week: '${/parameter/@fill_week}',
                    fill_year: '${/parameter/@fill_year}',
                    fill_type: '${/parameter/@fill_type}',
                    unit_id: '${/parameter/@unit_id}',
                    fill_quarter: '${/parameter/@fill_quarter}',
                    fill_mon: '${/parameter/@fill_mon}',
                    filling_id: '${/parameter/@filling_id}'
                },
                type: "POST",
                success: function (res) {
                    debugger;
                    var filling_id = res.result.record[0].filling_id;
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    var hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling');
                    $(hd_ds).setQueryParameter('filling_id', '${/parameter/@filling_id}');
                    $(hd_ds).query();
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //置灰按钮
            var layout_code = '${/parameter/@layout_code}';
            var dis_but = layout_code + '_user_button1';
            $(dis_but).disable();
            initialization_fill();
        }
        //提交工作流
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            Leaf.Masker.mask(Ext.getBody(), '提交中...');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling');
            var record = $(ds_id).getCurrentRecord();
            if (record.get('req_status') == 'APPROVING' || record.get('req_status') == 'APPROVED') {
                Leaf.Masker.unmask(Ext.getBody());
                $L.showMessage('提示', '只有新建和拒绝的单据才可提交审批！');
                return false;
            } else {
                var param = {};
                param.filling_id = record.get("filling_id");
                param.req_status = record.get("req_status");
                Leaf.request({
                    url: "${/request/@context_path}/jc/fund/filling/req/submit/wfl",
                    para: param,
                    success: function (r) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $("${/parameter/@winid}").close();
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.SideBar.show({
                            type: 'warning',
                            msg: '提交失败',
                            duration: 1000
                        });
                    },
                    scope: this
                });
            }
        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            //针对所有字段超链接进行识别
            if (record.get('fill_item_code') == 'PRINCIPAL' || record.get('fill_item_code') == 'INTEREST' || record.get('fill_item_code') == 'LEGAL_FEE' || record.get('fill_item_code') == 'DEPOSIT' || record.get('fill_item_code') == 'LOAN_DELIVERY') {
                if (name === 'field1' || name === 'field2' || name === 'field3' || name === 'field4' || name === 'field5' || name === 'field6'
                    || name === 'field7' || name === 'field8' || name === 'field9' || name === 'field10' || name === 'field11' || name === 'field12'|| name === 'field13') {
                    if (value) {
                        return '<a href="javascript:open_fp_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + name + '\')">' + Leaf.formatMoney(value) + '</a>';
                    } else {
                        return '<a href="javascript:open_fp_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + name + '\')">' + Leaf.formatMoney(0.00) + '</a>';
                    }
                }
            } else if (record.get('fill_item_code') != 'IN_THE') {
                if (value) {
                    return Leaf.formatMoney(value);
                } else {
                    return Leaf.formatMoney(0.00);
                }
            }
        }

        function open_fp_detail_win(ds_id, record_id, name) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var fill_ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_ln');
            var fund_type;
            var fill_year = record.get('fill_year');
            if (name == 'field1') {
                fund_type = first_day.substring(4, 14);
            } else if (name == 'field2') {
                fund_type = second_day.substring(4, 14);
            } else if (name == 'field3') {
                fund_type = third_day.substring(4, 14);
            } else if (name == 'field4') {
                fund_type = fourth_day.substring(4, 14);
            } else if (name == 'field5') {
                fund_type = fifth_day.substring(4, 14);
            } else if (name == 'field6') {
                fund_type = sixth_day.substring(4, 14);
            } else if (name == 'field7') {
                fund_type = seventh_day.substring(4, 14);
            } else if (name == 'field8') {
                fund_type = eighth_day.substring(4, 14);
            } else if (name == 'field9') {
                fund_type = ninth_day.substring(4, 14);
            } else if (name == 'field10') {
                fund_type = tenth_day.substring(4, 14);
            } else if (name == 'field11') {
                fund_type = eleventh_day.substring(4, 14);
            } else if (name == 'field12') {
                fund_type = twelfth_day.substring(4, 14);
            } else if (name == 'field13') {
                fund_type = thirteenth_day.substring(4, 14);
            }
            param['url_title'] = '资金周计划调整金额明细';
            param['fill_item'] = record.get('fill_item');
            param['fund_type'] = fund_type;
            param['filling_ln_id'] = record.get('filling_ln_id');
            param['filling_id'] = record.get('filling_id');
            var link_url;
            if(ds_id == fill_ln_ds_id){
                param['function_usage'] = 'QUERY';
                link_url = 'fp600d01d_detail_normal_id';
                param['function_code'] = 'FP200D01D';
            }else{
                param['function_usage'] = '${/parameter/@function_usage}';
                link_url = 'fp600d01d_detail_modify_id';
                param['function_code'] = 'FP600D02';
            }
            param['winid'] = 'fp6_d01d_detail_winid';

            hls_doc_get_layout_code(param, link_url, ds_id, 'FP600');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
