<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp600_fp_week_id"
                url="${/request/@context_path}/modules/FP/FP600/fund_filling_req_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'detail' && !record.isNew) {
                return '<a href="javascript:open_fp_week_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '计划明细' + '</a>';
            }
        }

        function open_fp_week_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '资金周计划调整明细';
            if (record.get('req_status') == 'NEW' || record.get('req_status') == 'REJECTED') {
                param['function_usage'] = 'MODIFY';
            } else {
                param['function_usage'] = 'QUERY';
            }
            param['winid'] = 'fp600d_detail_winid';
            var link_url;
            link_url = 'fp600_fp_week_id';
            param['function_code'] = 'FP600D';

            hls_doc_get_layout_code(param, link_url, ds_id, 'FP600D');
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var win = new Leaf.Window({
                id: 'fp600c_fill_create_win_id',
                url: "${/request/@context_path}/modules/FP/FP600/fp_filling_req_select.lview",
                params: {
                    parent_winid: 'fp600c_fill_create_win_id'
                },
                title: '资金周计划调整创建',
                fullScreen: true
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_filling_req');
                $(ds_id).query();
            });
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
