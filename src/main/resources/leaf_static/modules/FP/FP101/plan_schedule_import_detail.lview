<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="JC_FUND_PLAN_SCHEDULE"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[


        function returnBack() {
              top.refreshFrame();
            // $('${/parameter/@parent_winid}').close();
        }

        function saveBtn() {
            var head_id = '${/model/header/record/@header_id}';
            Leaf.request({
                type: 'POST',
                url: "${/request/@context_path}/hls/plan/schedule/import?headerId=" + head_id,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    Leaf.showMessage('提示', res.message);
                    //debugger;
                    returnBack();
                }
            });
        }

        function disableBtn() {
            $('saveBtn_id').disable();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="temp_interface_ds" autoQuery="true"
                       queryDataSet="temp_interface_query_ds"
                       queryUrl="${/request/@context_path}/fnd/interface/lines/query?headerId=${/model/header/record/@header_id}&amp;readLine=5">
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="资金计划填报导入" marginWidth="100">
                <a:grid id="temp_interface_grid_id" bindTarget="temp_interface_ds" marginHeight="150" navBar="true"
                        marginWidth="150">
                    <a:columns>
                        <a:column name="attributes_1" width="80" prompt="填报年度" align="center"/>
                        <a:column name="attributes_2" width="80" prompt="季度" align="center"/>
                        <a:column name="attributes_3" width="80" prompt="填报月份" align="right"/>
                        <a:column name="attributes_4" width="80" prompt="填报周" align="left"/>
                        <a:column name="attributes_5" width="130" prompt="填报周周开始日" align="left"/>
                        <a:column name="attributes_6" width="150" prompt="填报周周结束日" align="left"/>
                        <a:column name="attributes_7" width="130" prompt="本周第1天" align="left"/>
                        <a:column name="attributes_8" width="130" prompt="本周第2天" align="left"/>
                        <a:column name="attributes_9" width="130" prompt="本周第3天" align="left"/>
                        <a:column name="attributes_10" width="130" prompt="本周第4天" align="left"/>
                        <a:column name="attributes_11" width="130" prompt="本周第5天" align="left"/>
                        <a:column name="attributes_12" width="130" prompt="本周第6天" align="left"/>
                        <a:column name="attributes_13" width="130" prompt="本周第7天" align="left"/>
                        <a:column name="attributes_14" width="130" prompt="本周第8天" align="left"/>
                        <a:column name="attributes_15" width="130" prompt="本周第9天" align="left"/>
                        <a:column name="attributes_16" width="130" prompt="本周第10天" align="left"/>
                        <a:column name="attributes_17" width="130" prompt="本周第11天" align="left"/>
                        <a:column name="attributes_18" width="130" prompt="本周第12天" align="left"/>
                        <a:column name="attributes_19" width="130" prompt="本周第13天" align="left"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
