<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //execl导入
        window['${/parameter/@layout_code}_G_QUERY_RESULT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_fund_plan_schedule');
            var win = new Leaf.Window({
                id: 'plan_schedule_import_win_id',
                params: {
                    winid: 'plan_schedule_import_win_id'
                },
                url: '${/request/@context_path}/modules/FP/FP101/plan_schedule_import.lview',
                title: '资金计划填报日期导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
