<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp500_fp_quarter_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_quarter_detail.lview"/>
        <a:link id="fp500_fp_mon_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_mon_detail.lview"/>
        <a:link id="fp500_fp_week_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_week_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'detail' && !record.isNew) {
                return '<a href="javascript:open_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '计划明细' + '</a>';
            }
        }

        function open_detail_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '资金计划执行情况填报';
            if (record.get('confirm_status') == 'NEW' || record.get('confirm_status') == 'REJECTED') {
                param['function_usage'] = 'MODIFY';
            } else {
                param['function_usage'] = 'QUERY';
            }
            var link_url;
            if (record.get('fill_type') == 'QUARTER') {
                link_url = "fp500_fp_quarter_id";
                param['function_code'] = 'FP400D02';
            } else if (record.get('fill_type') == 'MON') {
                link_url = 'fp500_fp_mon_id';
                param['function_code'] = 'FP400D06';
            } else if (record.get('fill_type') == 'WEEK') {
                link_url = 'fp500_fp_week_id';
                param['function_code'] = 'FP400D07';
            }
            hls_doc_get_layout_code(param, link_url, ds_id, 'FP500');
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
