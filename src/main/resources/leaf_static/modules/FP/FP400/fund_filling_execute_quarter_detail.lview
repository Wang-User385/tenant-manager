<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //初始化
        function initialization_fill() {
            var execute_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_funding_execute');
            var execute_record = $(execute_ds).getCurrentRecord();
            //初始化
            Leaf.Masker.mask(Ext.getBody(), '初始化中...');
            Leaf.request({
                url: "${/request/@context_path}/jc/fund/filling/execute/update",
                para: {
                    fill_week: execute_record.get('fill_week'),
                    fill_year: execute_record.get('fill_year'),
                    fill_type: execute_record.get('fill_type'),
                    unit_id: execute_record.get('unit_id'),
                    fill_quarter: execute_record.get('fill_quarter'),
                    fill_mon: execute_record.get('fill_mon'),
                    summary_flag: '${/parameter/@summary_flag}',
                    execute_id: execute_record.get('execute_id'),
                    filling_id: execute_record.get('filling_id'),
                },
                type: "POST",
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    var hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_funding_execute');
                    $(hd_ds).query();
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //置灰按钮
            var layout_code = '${/parameter/@layout_code}';
            var dis_but = layout_code + '_user_button1';
            $(dis_but).disable();
            initialization_fill();
        }

        //确认
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_funding_execute');
            var record = $(ds_id).getCurrentRecord();
            var confirm_status = record.get('confirm_status');
            new Leaf.showConfirm('${l:HLS.PROMPT}', '确认确定执行?', function okFun() {
                record.set('confirm_status', 'CONFIRM');
                $(ds_id).submit();
                $(ds_id).query();
            }, function cancel() {
                Leaf.Masker.unmask(Ext.getBody());
            }, 200, 100);
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
