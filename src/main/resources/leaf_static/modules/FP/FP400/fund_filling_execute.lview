<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fp400_fp_quarter_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_quarter_detail.lview"/>
        <a:link id="fp400_fp_mon_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_mon_detail.lview"/>
        <a:link id="fp400_fp_week_id"
                url="${/request/@context_path}/modules/FP/FP400/fund_filling_execute_week_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'detail' && !record.isNew) {
                return '<a href="javascript:open_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '计划明细' + '</a>';
            }
        }

        function open_detail_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var summary_flag;
            if(record.get('unit_code') == 'FINANCIAL_MARKETS_DEPT'){
                summary_flag = 'Y';
            }else{
                summary_flag = 'N';
            }
            param['url_title'] = '资金计划执行情况填报';
            var function_usage;
            if (record.get('confirm_status') == 'NEW' || record.get('confirm_status') == 'REJECTED') {
                function_usage = 'MODIFY';
            } else {
                function_usage = 'QUERY';
            }
            var link_url;
            var function_code;
            if (record.get('fill_type') == 'QUARTER') {
                link_url = "fp400_fp_quarter_id";
                function_code = 'FP400D02';
            } else if (record.get('fill_type') == 'MON') {
                link_url = 'fp400_fp_mon_id';
                function_code = 'FP400D06';
            } else if (record.get('fill_type') == 'WEEK') {
                link_url = 'fp400_fp_week_id';
                function_code = 'FP400D07';
            }
            // hls_doc_get_layout_code(param, link_url, ds_id, 'FP400');
            var winid = 'fp400_fill_excute_id';
            var win = new Leaf.Window({
                id: 'fp400_fill_excute_id',
                params: {
                    winid:winid ,
                    excute_id :record.get('excute_id'),
                    filling_id:record.get('filling_id'),
                    function_code: function_code,
                    function_usage:function_usage,
                    summary_flag:summary_flag
                },
                url: $(link_url).getUrl(),
                title: '资金计划执行情况填报',
                fullScreen: true,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
