<?xml version="1.0" encoding="UTF-8"?>
<!--
    Date: 2018/12/24
    Revision: 1.0
    Purpose:行政区域定义 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function fnd_province_screen_reset() {
            $('fnd_province_query_ds').reset();
            $('fnd_province_ds').query();
        }
        function fnd_city_screen_reset() {
            $("fnd_city_query_ds").getAt(0).set("city","");
            $("fnd_city_query_ds").getAt(0).set("description","");
            $('fnd_city_ds').query();
        }
        function fnd_district_screen_reset() {
            $("fnd_district_query_ds").getAt(0).set("district","");
            $("fnd_district_query_ds").getAt(0).set("description","");
            $('fnd_district_ds').query();
        }

        function fnd_province_screen_query() {
            $('fnd_province_ds').query();
        }
        function fnd_city_screen_query() {
            $('fnd_city_ds').query();
        }
        function fnd_district_screen_query() {
            $('fnd_district_ds').query();
        }

        /* grid editFunction */
        function fnd_distract_view_renderer_ef(record, name) {
            if (name == "province" && record.isNew) {
                return "fnd_province_ds_grid_tf"
            }else if(name == "city" && record.isNew){
                return "fnd_city_ds_grid_tf"
            }else if(name == "district" && record.isNew){
                return "fnd_district_ds_grid_tf"
            }else{
                return ""
            }
        }

        /* grid renderer */
        function fnd_distract_view_renderer(value, record, name) {
            if (name == "province" && !!record.get('province')) {
                return '<a href="javascript:query_city(\'' + record.get('province') + '\');">' + value + '</a>';
            }
            if (name == "city" && !!record.get('city')) {
                return '<a href="javascript:query_district(' +
                    '\'' + record.get('province') + '\'' +
                    ',' +
                    '\'' + record.get('city') + '\'' +
                    ');">' + value + '</a>';
            }
        }

        /* 级联查询 */
        function query_city(province) {
            //重置区县数据
            $("fnd_district_query_ds").reset();
            $("fnd_district_ds").removeAll();
            //根据province查市数据
            $("fnd_city_query_ds").getAt(0).set("province",province);
            $("fnd_city_ds").query();
        }
        function query_district(province,city) {
            var queryRecord = $("fnd_district_query_ds").getAt(0);
            queryRecord.set("province",province);
            queryRecord.set("city",city);
            $("fnd_district_ds").query();
        }

        /* validator 只允许数字+大写字母 */
        function code_valid(record, name, value) {
            if (/^[A-Z\d]+$/.test(value)) {
                return true
            } else {
                return "代码只允许包含数字和大写字母";
            }
        }
        /* validator 市/区县新建时必须包含省/市代码*/
        function fnd_city_ds_province_check(record, name, value){
            if(record.ds.id === "fnd_city_ds" && name === "province"){
                var curQueryPro = $("fnd_city_query_ds").getAt(0).get("province");
                if(!value){
                    if(!!curQueryPro){
                        record.set("province",curQueryPro);
                        return true
                    }else{
                        return "请先选择省"
                    }
                }
                return true
            }
            if(record.ds.id === "fnd_district_ds" && name === "province"){
                var curQueryPro = $("fnd_district_query_ds").getAt(0).get("province");
                if(!value){
                    if(!!curQueryPro){
                        record.set("province",curQueryPro);
                        return true
                    }else{
                        return "请先选择省"
                    }
                }
                return true
            }
            if(record.ds.id === "fnd_district_ds" && name === "city"){
                var curQueryCity = $("fnd_district_query_ds").getAt(0).get("city");
                if(!value){
                    if(!!curQueryCity){
                        record.set("city",curQueryCity);
                        return true
                    }else{
                        return "请先选择市"
                    }
                }
                return true
            }
            return true
        }

        /* 自动查询下级 */
        function onLoad_fnd_province_ds(ds){
            var firstRecord = ds.getAt(0);
            if(!!firstRecord){
                query_city(firstRecord.get("province"));
            }else{
                $("fnd_city_query_ds").reset();
                $("fnd_city_ds").removeAll();
                $("fnd_district_query_ds").reset();
                $("fnd_district_ds").removeAll();
            }
        }
        function onLoad_fnd_city_ds(ds){
            var firstRecord = ds.getAt(0);
            if(!!firstRecord){
                query_district(firstRecord.get("province"),firstRecord.get("city"));
            }else{
                $("fnd_district_query_ds").reset();
                $("fnd_district_ds").removeAll();
            }
        }

        function indexChange_fnd_province_ds(ds, record){
            query_city(record.get("province"));
        }
        function indexChange_fnd_city_ds(ds, record){
            query_district(record.get("province"),record.get("city"));
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="fnd_province_query_ds">
                <a:fields>
                    <a:field name="province"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_province_ds"
                       autoPageSize="true" selectable="true"
                       autoQuery="true" queryDataSet="fnd_province_query_ds"
                       queryUrl="${/request/@context_path}/fnd/province/query"
                       deleteUrl="${/request/@context_path}/fnd/province/delete"
                       submitUrl="${/request/@context_path}/fnd/province/submit">
                <a:fields>
                    <a:field name="province" required="true" validator="code_valid"/>
                    <a:field name="description"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <!--<a:event name="load" handler="onLoad_fnd_province_ds"/>-->
                    <a:event name="indexchange" handler="indexChange_fnd_province_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_city_query_ds">
                <a:fields>
                    <a:field name="province"/>
                    <a:field name="city"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_city_ds" autoPageSize="true" selectable="true"
                       autoQuery="false" queryDataSet="fnd_city_query_ds"
                       queryUrl="${/request/@context_path}/fnd/city/query"
                       deleteUrl="${/request/@context_path}/fnd/city/delete"
                       submitUrl="${/request/@context_path}/fnd/city/submit">
                <a:fields>
                    <a:field name="city" required="true" validator="code_valid"/>
                    <a:field name="province" validator="fnd_city_ds_province_check"/>
                    <a:field name="description"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="provincial_capital_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <!--<a:event name="load" handler="onLoad_fnd_city_ds"/>-->
                    <a:event name="indexchange" handler="indexChange_fnd_city_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_district_query_ds">
                <a:fields>
                    <a:field name="province"/>
                    <a:field name="city"/>
                    <a:field name="district"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_district_ds" autoPageSize="true" selectable="true"
                       autoQuery="false" queryDataSet="fnd_district_query_ds"
                       queryUrl="${/request/@context_path}/fnd/district/query"
                       deleteUrl="${/request/@context_path}/fnd/district/delete"
                       submitUrl="${/request/@context_path}/fnd/district/submit">
                <a:fields>
                    <a:field name="district" required="true" validator="code_valid"/>
                    <a:field name="province" validator="fnd_city_ds_province_check"/>
                    <a:field name="city" validator="fnd_city_ds_province_check"/>
                    <a:field name="description"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTitle/>
            <a:hBox column="3">
                <a:vBox row="3">
                    <a:screenTopToolbar>
                        <a:gridButton bind="fnd_province_ds_grid" type="add"/>
                        <a:gridButton bind="fnd_province_ds_grid" type="save"/>
                        <a:gridButton bind="fnd_province_ds_grid" type="query"/>
                        <a:gridButton bind="fnd_province_ds_grid" type="delete"/>
                        <a:gridButton click="fnd_province_screen_reset" text="HAP.RESET"/>
                    </a:screenTopToolbar>
                    <a:form column="2" title="省" labelWidth="72">
                        <a:textField name="province" bindTarget="fnd_province_query_ds" prompt="代码" emptyText="代码"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_province_screen_query"/>
                            </a:events>
                        </a:textField>
                        <a:textField name="description" bindTarget="fnd_province_query_ds" prompt="描述" emptyText="描述"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_province_screen_query"/>
                            </a:events>
                        </a:textField>
                    </a:form>
                    <a:grid id="fnd_province_ds_grid" bindTarget="fnd_province_ds"
                            width="395" height="330" navBar="true">
                        <a:columns>
                            <a:column width="120" name="province" renderer="fnd_distract_view_renderer"
                                      editorFunction="fnd_distract_view_renderer_ef" prompt="省代码"/>
                            <a:column width="150" name="description" editor="fnd_province_ds_grid_tf" prompt="描述"/>
                            <a:column width="80" name="enabled_flag" editor="fnd_province_ds_grid_check" prompt="启用"
                                      align="center"/>
                        </a:columns>
                        <a:editors>
                            <a:textField id="fnd_province_ds_grid_tf"/>
                            <a:checkBox id="fnd_province_ds_grid_check"/>
                        </a:editors>
                    </a:grid>
                </a:vBox>
                <a:vBox>
                    <a:screenTopToolbar>
                        <a:gridButton bind="fnd_city_ds_grid" type="add"/>
                        <a:gridButton bind="fnd_city_ds_grid" type="save"/>
                        <a:gridButton bind="fnd_city_ds_grid" type="query"/>
                        <a:gridButton bind="fnd_city_ds_grid" type="delete"/>
                        <a:gridButton click="fnd_city_screen_reset" text="HAP.RESET"/>
                    </a:screenTopToolbar>
                    <a:form column="2" title="市" labelWidth="72">
                        <a:textField name="city" bindTarget="fnd_city_query_ds" prompt="代码" emptyText="代码"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_city_screen_query"/>
                            </a:events>
                        </a:textField>
                        <a:textField name="description" bindTarget="fnd_city_query_ds" prompt="描述" emptyText="描述"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_city_screen_query"/>
                            </a:events>
                        </a:textField>
                    </a:form>
                    <a:grid id="fnd_city_ds_grid" bindTarget="fnd_city_ds" width="495" height="330" navBar="true">
                        <a:columns>
                            <a:column width="120" name="city" renderer="fnd_distract_view_renderer"
                                      editorFunction="fnd_distract_view_renderer_ef" prompt="市代码"/>
                            <a:column width="150" name="description" editor="fnd_city_ds_grid_tf" prompt="描述"/>
                            <a:column width="80" name="enabled_flag" editor="fnd_city_ds_grid_check" prompt="启用"
                                      align="center"/>
                            <a:column width="80" name="provincial_capital_flag" editor="fnd_city_ds_grid_check" prompt="省会城市"
                                      align="center"/>
                        </a:columns>
                        <a:editors>
                            <a:textField id="fnd_city_ds_grid_tf"/>
                            <a:checkBox id="fnd_city_ds_grid_check"/>
                        </a:editors>
                    </a:grid>
                </a:vBox>
                <a:vBox>
                    <a:screenTopToolbar>
                        <a:gridButton bind="fnd_district_ds_grid" type="add"/>
                        <a:gridButton bind="fnd_district_ds_grid" type="save"/>
                        <a:gridButton bind="fnd_district_ds_grid" type="query"/>
                        <a:gridButton bind="fnd_district_ds_grid" type="delete"/>
                        <a:gridButton click="fnd_district_screen_reset" text="HAP.RESET"/>
                    </a:screenTopToolbar>
                    <a:form column="2" title="区/县" labelWidth="72">
                        <a:textField name="district" bindTarget="fnd_district_query_ds" prompt="代码" emptyText="代码"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_district_screen_query"/>
                            </a:events>
                        </a:textField>
                        <a:textField name="description" bindTarget="fnd_district_query_ds" prompt="描述" emptyText="描述"
                                     width="120">
                            <a:events>
                                <a:event name="enterdown" handler="fnd_district_screen_query"/>
                            </a:events>
                        </a:textField>
                    </a:form>
                    <a:grid id="fnd_district_ds_grid" bindTarget="fnd_district_ds" width="400" height="330" navBar="true">
                        <a:columns>
                            <a:column width="120" name="district" editorFunction="fnd_distract_view_renderer_ef" prompt="区县代码"/>
                            <a:column width="150" name="description" editor="fnd_district_ds_grid_tf" prompt="描述"/>
                            <a:column width="80" name="enabled_flag" editor="fnd_district_ds_grid_check" prompt="启用"
                                      align="center"/>
                        </a:columns>
                        <a:editors>
                            <a:textField id="fnd_district_ds_grid_tf"/>
                            <a:checkBox id="fnd_district_ds_grid_check"/>
                        </a:editors>
                    </a:grid>
                </a:vBox>
            </a:hBox>
        </a:screenBody>
    </a:view>
</a:screen>
