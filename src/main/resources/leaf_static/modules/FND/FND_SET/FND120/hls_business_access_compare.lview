<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        ]]></script>
        <a:dataSets>
            <a:dataSet id="HlsBusinessAccessCompare_ds" autoQuery="true"
                queryUrl="${/request/@context_path}/hls/business/access/compare/query"
                submitUrl="${/request/@context_path}/hls/business/access/compare/submit"
                deleteUrl="${/request/@context_path}/hls/business/access/compare/remove" selectable="true">
                <a:fields>
                    <a:field name="business_access"/>
                    <a:field name="project_access_items"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTitle/>
            <a:screenTopToolbar>
                <a:gridButton bind="HlsBusinessAccessCompare_grid_id" type="add"/>
                <a:gridButton bind="HlsBusinessAccessCompare_grid_id" type="save"/>
                <a:gridButton bind="HlsBusinessAccessCompare_grid_id" type="delete"/>
                <a:gridButton bind="HlsBusinessAccessCompare_grid_id" type="query"/>
            </a:screenTopToolbar>
            <a:grid id="HlsBusinessAccessCompare_grid_id" bindTarget="HlsBusinessAccessCompare_ds" marginHeight="140" marginWidth="50" navBar="true">
                <a:columns>
                    <a:column name="business_access" align="left" autoAdjust="true" width="240" prompt="业务准入对照" editor="HlsBusinessAccessCompare_grid_textfield"/>
                    <a:column name="project_access_items" align="left" autoAdjust="true" width="920" prompt="项目准入事项" editor="HlsBusinessAccessCompare_grid_textfield"/>
                </a:columns>
                <a:editors>
                    <a:textField id="HlsBusinessAccessCompare_grid_textfield"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>