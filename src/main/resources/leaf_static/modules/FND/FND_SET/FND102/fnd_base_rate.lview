<?xml version="1.0" encoding="UTF-8"?>
<!--

    $Date: 2018-12-21
    $Revision: 1.0
    $Purpose: 基准利率集明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        var curEcMap = {};
        $L.onReady(function () {
            var curRecords = $("currency_ds").getAll();
            curRecords.forEach(function (i) {
                curEcMap[i.get("currency_code")] = i.get("currency_name");
            });

            $("base_rate_query_ds").create({
                base_rate_set: "${/parameter/@base_rate_set}"
            });
        });

        <!--新增-->
        function base_rate_ds_grid_add() {
            $('base_rate_ds').query();
        }

        <!--刷新-->
        function base_rate_ds_grid_refresh() {
            $("base_rate_ds").query();
        }

        <!--ds load事件-->
        function base_rate_ds_load(ds) {
            var base_rate_ds_records = ds.getAll();
            base_rate_ds_records.forEach(function (i) {
                i.set("currency_name", curEcMap[i.get("currency")],true);
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="base_rate_query_ds">
                <a:fields>
                    <a:field name="base_rate_set"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="description_options_ds" lookupCode="FND.BASE_RATE_TYPE"/>

            <a:dataSet id="base_rate_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryMethod="GET" queryDataSet="base_rate_query_ds"
                       submitUrl="${/request/@context_path}/fnd/baserate/submit"
                       deleteUrl="${/request/@context_path}/fnd/baserate/delete"
                       queryUrl="${/request/@context_path}/fnd/baserate/query">
                <a:fields>
                    <a:field name="base_rate_id"/>
                    <a:field name="base_rate"  required="true"/>
                    <a:field name="base_rate_set" defaultValue="${/parameter/@base_rate_set}"/>
                    <a:field name="currency" defaultValue="${/parameter/@currency_code}"/>
                    <a:field name="currency_name" defaultValue="${/parameter/@currency_name}"/>
                    <a:field name="description"/>
                    <a:field name="months_from"/>
                    <a:field name="months_to"/>
                    <a:field name="description"/>
                    <a:field name="description_n" displayField="code_value_name" options="description_options_ds"
                             returnField="description" valueField="code_value"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="base_rate_ds_load"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="base_rate_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton bind="base_rate_ds_grid" text="HAP.SAVE" type="save"/>
                <a:gridButton bind="base_rate_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="base_rate_ds_grid_refresh" text="HAP.REFRESH"/>
            </a:screenTopToolbar>
            <a:grid id="base_rate_ds_grid" bindTarget="base_rate_ds" marginHeight="150"  width="815" navBar="true">
                <a:columns>
                    <a:column width="120" name="currency_name" prompt="币种" align="center"/>
                    <a:column width="140" name="base_rate" editor="base_rate_ds_grid_nf" prompt="基准利率值" align="center"/>
                    <!--<a:column width="147" name="months_from"
                              editor="base_rate_ds_grid_nf_month" prompt="月数从" align="center"/>
                    <a:column width="157" name="months_to"
                              editor="base_rate_ds_grid_nf_month" prompt="月数至" align="center"/>-->
                    <a:column width="200" name="description_n" editor="base_rate_ds_grid_cb" prompt="描述"/>
                </a:columns>
                <a:editors>
                    <a:numberField id="base_rate_ds_grid_nf" allowFormat="true"  allowNegative="false"
                                   allowDecimals="true" decimalPrecision="4"/>
                    <a:numberField id="base_rate_ds_grid_nf_month" allowDecimals="false" allowNegative="false"
                                   allowFormat="false"/>
                    <a:textField id="base_rate_ds_grid_tf"/>
                    <a:comboBox id="base_rate_ds_grid_cb"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
