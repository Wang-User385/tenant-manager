<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yuanshuai
    $Date: 2018-10-8
    公司基础属性定义
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="pageLink_fnd_org_unit_define" url="${/request/@context_path}/modules/FND/FND_ORG/FND110/hls_org_units.lview"/>
        <script><![CDATA[
        function fnd_company_query() {
            $('fnd_company_ds').query();
        }

        function fnd_company_reset() {
            $('fnd_company_query_ds').reset();
            $('fnd_company_ds').query();
        }

        function fnd_company_add() {
            $('fnd_company_ds').create();
        }

        function fnd_company_save() {
            var ds = $('fnd_company_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/leaf/fnd/company/submit');
                ds.submit();
            }
        }

        function fnd_company_delete_confirm(){
            if($('fnd_company_ds').getSelected().length==0){
                Leaf.showErrorMessage( '提示', '请选择记录！',null, 200, 100 );
                return ;
            }
            Leaf.showConfirm('提示', '确定删除？', fnd_company_delete, null, 200, 100 );
        }

        function fnd_company_delete(){
            var ds = $('fnd_company_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/leaf/fnd/company/remove');
                ds.submitSelected();
            }
        }

        function fnd_company_quit() {
            location.href = $('pageLink_welcome').getUrl();
        }



        function onSubmitSuccess_fnd_company_ds(ds) {
            fnd_company_query();
        }

        function org_unit_define_render(value,record,name){
            if(record.isNew==true){
                return "";
            }else{
                return '<a href="javascript:winOpen_org_unit_define(\'' + record.get('company_id') + '\',\'' + record.get('company_full_name') + '\');">部门定义</a>';
            }
        }

        function winOpen_org_unit_define(company_id,company_full_name){
            new Leaf.Window({
                id: 'fnd_org_unit_define',
                url: $('pageLink_fnd_org_unit_define').getUrl(),
                params: {
                    company_id: company_id,
                    company_full_name:company_full_name
                },
                title: '部门定义',
                fullScreen:true
            });
        }

        function parent_company_valid(record,name,value){
            if(record.get('company_id')!=null&&record.get('company_id')!=""){
                if(record.get('company_id')==record.get('parent_company_id')){
                    return '上级公司不能为自身!';
                }else{
                    return true;
                }
            }else{
                return true;
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="fnd_company_query_ds">
            </a:dataSet>
            <a:dataSet id="fnd_currency_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls_currency/by/query">
                <a:fields>
                    <a:field name="currency_code"/>
                    <a:field name="currency_name"/>
                    <a:field name="finance_precision"/>
                    <a:field name="currency_symbol"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_company_ds" autoPageSize="true" autoQuery="true" queryUrl="${/request/@context_path}/leaf/fnd/company/query"
                       queryDataSet="fnd_company_query_ds" selectable="true">
                <a:fields>
                    <a:field name="company_code" required="true"/>
                    <a:field name="company_full_name" required="true"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="parent_company_name" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100" lovService="/leaf/fnd/company/query~hls.layout.dto.LovParentCompanyDto" lovWidth="600"
                             title="选择上级公司" validator="parent_company_valid">
                        <a:mapping>
                            <a:map from="company_full_name" to="parent_company_name"/>
                            <a:map from="company_id" to="parent_company_id"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bank_account_name" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100" lovService="/csh/bank/account/query~hls.layout.dto.LovCshBankAccountDto" lovWidth="600"
                             title="收款账户" >
                        <a:mapping>
                            <a:map from="bank_account_name" to="bank_account_name"/>
                            <a:map from="bank_account_id" to="bank_account_id"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="set_of_books_id_n" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100" lovService="/gld/set/of/books/query/lovForCompany~com.hand.hls.layout.dto.LovForCompanySetOfBooksDto" lovWidth="600"
                             title="账套">
                        <a:mapping>
                            <a:map from="set_of_books_id" to="set_of_books_id"/>
                            <a:map from="set_of_books_name" to="set_of_books_id_n"/>
                            <a:map from="account_set_id_n" to="account_set_id_n"/>
                            <a:map from="functional_currency_n" to="functional_currency_n"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="currency_n" options="fnd_currency_ds"
                             displayField="currency_name" valueField="currency_code" returnField="currency"/>

                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_company_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="fnd_company_add" text="HAP.NEW"/>
                <a:gridButton click="fnd_company_save" text="HAP.SAVE"/>
                <a:gridButton click="fnd_company_delete_confirm" text="HAP.DELETE"/>
                <a:gridButton click="fnd_company_query" text="HAP.QUERY"/>
                <a:gridButton click="fnd_company_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="3" labelwidth="100" title="查询条件">
                <a:textField name="company_code" bindTarget="fnd_company_query_ds" prompt="公司代码" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_company_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="company_full_name" bindTarget="fnd_company_query_ds" prompt="公司名称" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_company_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="fnd_company_ds_grid" bindTarget="fnd_company_ds" marginHeight="150" marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column name="company_code" width="220" prompt="公司代码" editor="fnd_company_ds_grid_tf"/>
                    <a:column name="company_full_name" width="220" prompt="公司名称" editor="fnd_company_ds_grid_tf"/>
                    <a:column name="fin_company_name" width="220" prompt="公司名称(财务)" editor="fnd_company_ds_grid_tf"/>
                    <a:column name="ws_com_code" width="220" prompt="公司代码(财务)"/>
                    <a:column name="parent_company_name" width="220" prompt="上级公司" editor="fnd_company_ds_grid_lv"/>
                    <a:column name="parent_company_id" width="220" prompt="上级公司id" editor="fnd_company_ds_grid_tf" hidden="true"/>
                    <a:column name="enabled_flag" width="220" prompt="启用状态" editor="fnd_company_ds_grid_check"/>
                    <a:column prompt="部门定义" width="160" renderer="org_unit_define_render" align="center"/>
                    <a:column name="bank_account_name" width="220" prompt="收款账户" editor="bank_account_grid_lv" />
                    <a:column name="bank_account_id" width="220" prompt="收款账户id" editor="bank_account_grid_lv" hidden="true" />
                    <a:column name="set_of_books_id_n" editor="set_of_books_id_grid_lv" prompt="账套" width="100"/>
                    <a:column name="account_set_id_n" prompt="科目表" width="100"/>
                    <a:column name="functional_currency_n" prompt="币种" width="100"/>
                </a:columns>
                <a:editors>
                    <a:comboBox id="fnd_company_ds_grid_cb"/>
                    <a:textField id="fnd_company_ds_grid_tf"/>
                    <a:datePicker id="fnd_company_ds_grid_dp"/>
                    <a:lov id="fnd_company_ds_grid_lv" editable="true"/>
                    <a:lov id="bank_account_grid_lv" editable="true"/>
                    <a:lov id="set_of_books_id_grid_lv" editable="true"/>
                    <a:checkBox id="fnd_company_ds_grid_check"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
