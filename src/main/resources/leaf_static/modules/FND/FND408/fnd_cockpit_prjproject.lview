<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[

        function project_line_query() {
            $('cockpit_info_ds').query();
        }

        function project_reset() {
            $('cockpitMaintainDs').reset();
            $('cockpit_info_ds').query();
        }

        function percentFormat(value, record, name) {
            debugger;
            if (value) {
                return parseFloat(value * 100).toFixed(2) + '%';
            } else {
                return '0%';
            }
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="prj_cockpit_query_ds">
                <a:datas>
                    <a:record/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="cockpitMaintainDs"
                       autoQuery="true" autoCreate="true">
                <a:fields>
                    <a:field name="host_project_manager_n"/>
                    <a:field name="host_unit_id_n"/>
                    <a:field name="year"/>
                    <a:field name="mon"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="cockpit_info_ds" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true"
                       fetchAll="false"   queryDataSet="cockpitMaintainDs"
                       queryUrl="${/request/@context_path}/jc/cockpit/project/query">
                <a:fields>
                    <a:field name="host_project_manager_n"/>
                    <a:field name="host_unit_id_n"/>
                    <a:field name="year"/>
                    <a:field name="mon"/>
                    <a:field name="launch_amount"/>
                    <a:field name="completed_launch_amount"/>
                    <a:field name="launch_ratio"/>
                    <a:field name="bearing_amount"/>
                    <a:field name="completed_bearing_amount"/>
                    <a:field name="bearing_ratio"/>
                    <a:field name="income_amount"/>
                    <a:field name="completed_income_amount"/>
                    <a:field name="income_ratio"/>
                    <a:field name="profit_amount"/>
                    <a:field name="completed_profit_amount"/>
                    <a:field name="profit_ratio"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="project_line_query" text="HAP.QUERY"/>
                <a:gridButton click="project_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="4" title="查询条件" labelwidth="140">
                <a:textField name="host_project_manager_n" bindTarget="cockpitMaintainDs" prompt="项目经理"
                             width="150">
                    <a:events>
                        <a:event name="enterdown" handler="project_line_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="host_unit_id_n" bindTarget="cockpitMaintainDs" prompt="业务部门"
                             width="150">
                    <a:events>
                        <a:event name="enterdown" handler="project_line_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="year" bindTarget="cockpitMaintainDs" prompt="年份"
                             width="150">
                    <a:events>
                        <a:event name="enterdown" handler="project_line_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="mon" bindTarget="cockpitMaintainDs" prompt="月份"
                             width="150">
                    <a:events>
                        <a:event name="enterdown" handler="project_line_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="cockpit_into_define" bindTarget="cockpit_info_ds"
                    marginHeight="80" marginWidth="80" navBar="true">
                <a:columns>
                    <a:column width="80" align="center" name="host_project_manager_n" prompt="项目经理"/>
                    <a:column width="80" align="center" name="host_unit_id_n" prompt="业务部门"/>
                    <a:column width="60" align="center" name="year" prompt="年份"/>
                    <a:column width="60" align="center" name="mon" prompt="月份"/>
                    <a:box column="3" labelWidth="120" prompt="投放完成情况">
                        <a:column width="120" align="right" name="launch_amount" prompt="目标值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="completed_launch_amount" prompt="完成值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="launch_ratio" prompt="完成率" renderer="percentFormat"/>
                    </a:box>
                    <a:box column="3" labelWidth="120" prompt="生息资产完成情况">
                        <a:column width="120" align="right" name="bearing_amount" prompt="目标值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="completed_bearing_amount" prompt="完成值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="bearing_ratio" prompt="完成率" renderer="percentFormat"/>
                    </a:box>
                    <a:box column="3" labelWidth="120" prompt="收入完成情况">
                        <a:column width="120" align="right" name="income_amount" prompt="目标值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="completed_income_amount" prompt="完成值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="income_ratio" prompt="完成率" renderer="percentFormat"/>
                    </a:box>
                    <a:box column="3" labelWidth="120" prompt="利润完成情况">
                        <a:column width="120" align="right" name="profit_amount" prompt="目标值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="completed_profit_amount" prompt="完成值" renderer="Leaf.formatMoney"/>
                        <a:column width="120" align="right" name="profit_ratio" prompt="完成率" renderer="percentFormat"/>
                    </a:box>
                </a:columns>
            </a:grid>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
