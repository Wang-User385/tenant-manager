<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="V100_bp_visit_modify_id"
                url="${/request/@context_path}/modules/visit/V100/jc_bp_visit_interview.lview"/>
        <a:link id="bp100_bp_master_ecif_signal_query_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_ecif_signal_query.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var win = new Leaf.Window({
                id: 'bp100_bp_create_win_id',
                url: "${/request/@context_path}/modules/BP/BP100/bp_master_select.lview",
                params: {
                    parent_winid: 'bp100_bp_create_win_id'
                },
                title: '客户信息创建',
                fullScreen: true
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                $(ds_id).query();
            });
        };

        //ECIF单一客户查询
        // window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
        //
        //     var ds_id=null;
        //     var param = {};
        //     param['winid'] = 'bp_master_ecif_signale_query_winid';
        //     param['url_title'] = 'ECIF单一客户查询';
        //     param['function_code'] = 'BP100F103';
        //
        //     hls_doc_get_layout_code(param, 'bp100_bp_master_ecif_signal_query_id', ds_id, 'BP100F103');
        // };

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_name' && value) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }else if (name == 'visit_information' && value) {
                return '<a href="javascript:open_visit_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">拜访明细</a>';
            }
            return value;
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户信息维护';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            // param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';

            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
        }

        //拜访明细 维护入口
        function open_visit_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '拜访明细';
            param['function_code'] = 'BP100V1';

            // param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_visit_modify_winid';

            hls_doc_get_layout_code(param, 'V100_bp_visit_modify_id', ds_id, 'BP100');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
