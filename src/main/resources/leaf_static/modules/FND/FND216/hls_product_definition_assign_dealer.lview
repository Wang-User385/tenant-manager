<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_product_def_dealer');
            $(ds_id).query();
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            record.set('definition_id','${/parameter/@definitionId}');
            record.set('definition_id_n','${/parameter/@definitionName}');
            record.set('manufacturer_id','${/parameter/@manufacturerId}');
            record.set('manufacturer_id_n','${/parameter/@manufacturerName}');
            record.set('enabled_flag','Y');
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_product_def_dealer');
            if (ds.id == ds_id) {
                $(ds_id).setQueryParameter('definition_id', '${/parameter/@definitionId}');
            }
        };

        Leaf.onReady(function () {
            var product_record = $('FND216F1_F_CHECKCODE__ds').getAt(0);
            product_record.set('definition_id','${/parameter/@definitionId}');
            product_record.set('definition_id_n','${/parameter/@definitionName}');
            product_record.set('manufacturer_id','${/parameter/@manufacturerId}');
            product_record.set('manufacturer_id_n','${/parameter/@manufacturerName}');
        })

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
