                             displayField="code_value_name" returnField="residual_price_type" valueField="code_value"/>
                    <a:field name="step_quotation_flag_n" options="enabled_flag_ds" required="true" prompt="是否阶梯式报价"
                             displayField="code_value_name" returnField="step_quotation_flag" valueField="code_value"/>-->
                    <a:field name="residual_value_received_n" options="residual_value_received_ds" required="true" prompt="名义货价收取方式"
                             displayField="code_value_name" returnField="residual_value_received" valueField="code_value"/>
                    <!--<a:field name="repay_mode_n" options="repay_mode_ds" readOnly="true" prompt="租金返利/贴息模式"
                             displayField="code_value_name" returnField="repay_mode" valueField="code_value"/>
                    <a:field name="repay_bp_type_n" options="repay_bp_type_ds" readOnly="true" prompt="租金/服务费返利贴息对象类型"
                             displayField="code_value_name" returnField="repay_bp_type" valueField="code_value"/>-->
                    <a:field name="payment_bp_type_n" options="payment_bp_type_ds" required="true" prompt="投放对象类型"
                             displayField="code_value_name" returnField="payment_bp_type" valueField="code_value"/>
                    <!--<a:field name="simple_compound_type_n" options="simple_compound_type_ds" required="true" prompt="单利/复利"
                             displayField="code_value_name" returnField="simple_compound_type" valueField="code_value"/>-->
                    <!--<a:field name="margin_deduction_method_n" options="margin_deduction_method_ds" required="true" prompt="保证金抵扣方式"
                             displayField="code_value_name" returnField="margin_deduction_method" valueField="code_value"/>-->
                    <a:field name="incept_type_n" options="incept_type_ds" required="true" prompt="起租方式"
                             displayField="code_value_name" returnField="incept_type" valueField="code_value"/>
                    <!--<a:field name="int_rate_calc_flag_n" options="yes_no_ds" required="true" prompt="是否倒推租金"
