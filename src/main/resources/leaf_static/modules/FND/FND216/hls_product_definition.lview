            $('fnd216_hls_product_definition_para_ds').query();
        }*/

        function fnd216_hls_product_definition_para_beforeremove(ds, record, index) {
            var product_definition_record = $('fnd216_hls_product_definition_ds').getCurrentRecord();
            var product_status = product_definition_record.get('product_status');
            if (product_status == 'APPROVING' || product_status == 'APPROVED') {
                Leaf.SideBar.show({
                    msg: '不允许删除参数！',
                    duration: 2000
                });
                return false;
            }
            return true;
        }

        $L.DataSet.prototype.onDataSetIndexChange = function (ds, record) {
//            if (record.isNew != true) {
            this.qpara = {};
            Ext.apply(this.qpara, record.data);
//            }
            if (!this.indexchangedisquery) {
                //未设置indexchangedisquery=true时 每次indexchange都要重新查询
                this.query(1, {record: record});
            } else if (!record.get(this.bindname) && record.isNew != true) {
                //设置indexchangedisquery=true时，根据“数据不存在 且 数据未被更改”来判断是否重新查询
                this.query(1, {record: record});
            }
        }

