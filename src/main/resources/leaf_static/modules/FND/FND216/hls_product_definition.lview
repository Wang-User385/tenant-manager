        function fnd216_hls_product_definition_clear() {
            $('fnd216_hls_product_definition_grid').clear();
        }


        function formatDate(value, record, name) {
            if (!Ext.isEmpty(value)) {
                var date = new Date(value);
                var year = date.getFullYear();
                var month = date.getMonth() + 1;
                var day = date.getDate();
                // 将月份和日期补齐两位数
                month = month < 10 ? '0' + month : month;
                day = day < 10 ? '0' + day : day;
                return year + '-' + month + '-' + day;
            } else {
                return '';
            }
        }

        function dealer_assign_renderer(value, record, name){
            var function_usage;
            if(record.isNew==true){
                return "";
            }else{
                if(record.get('product_status') == 'APPROVED'||record.get('product_status') == 'APPROVING'){
                    function_usage = 'QUERY';
                }else{
                    function_usage = 'MODIFY';
                }
                return '<a href="javascript:winOpen_dealer_assign_renderer(\'' + function_usage + '\',\'' + record.get('definition_id') + '\',\'' + record.get('definition_name') + '\',\'' + record.get('bp_id') + '\',\'' + record.get('bp_name') + '\');">分配经销商</a>';
            }
        }

        function winOpen_dealer_assign_renderer(function_usage,definition_id,definition_name,bp_id,bp_name){
            var win = new Leaf.Window({
                id: 'fnd216_dealer_assign_winid',
                url: $('fnd216_dealer_assign_link').getUrl() + '?function_code=FND216F1&&function_usage=' + function_usage,
                params: {
                    definitionId: definition_id,
                    definitionName: definition_name,
                    manufacturerId: bp_id,
                    manufacturerName: bp_name,
                    winId:'fnd216_dealer_assign_winid'
                },
                title: '分配经销商',
                width: 1000,
                height: 675
            });
            win.on('close', function () {
                $('fnd216_hls_product_definition_ds').query();
            });
        }

        //百分数格式化
        function percentFormat(value,record,name){
            if (name == 'penalty_rate') {
                if (!isNaN(value)) {
                    return parseFloat(value * 100).toFixed(6) + '%';
                } else {
                    return '';
                }
            }

        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="enabled_flag_ds" loadData="true" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="product_status_ds" loadData="true" lookupCode="FND.PRODUCT_STATUS"/>
            <a:dataSet id="pay_type_ds" loadData="true" lookupCode="HLS500_PAY_TYPE"/>
            <a:dataSet id="annual_pay_times_ds" loadData="true" lookupCode="HLS500_ANNUAL_PAY_TIMES"/>
            <a:dataSet id="lease_item_type_ds" loadData="true" lookupCode="PRODUCT.LEASE_ITEM_TYPE"/>
            <a:dataSet id="exempt_penalty_int_ds" loadData="true" lookupCode="EXEMPT_PENALTY_INT"/>
            <a:dataSet id="product_para_ds" loadData="true" lookupCode="HLS500_PRODUCT_PARA"/>
            <a:dataSet id="residual_price_type_ds" loadData="true" lookupCode="RESIDUAL_PRICE_TYPE"/>
            <a:dataSet id="residual_value_received_ds" loadData="true" lookupCode="RESIDUAL_VALUE_RECEIVED"/>
            <a:dataSet id="repay_mode_ds" loadData="true" lookupCode="REPAY_MODE"/>
            <a:dataSet id="simple_compound_type_ds" loadData="true" lookupCode="SIMPLE_COMPOUND_TYPE"/>
            <a:dataSet id="payment_bp_type_ds" loadData="true" lookupCode="PAYMENT_BP_TYPE"/>
            <a:dataSet id="repay_bp_type_ds" loadData="true" lookupCode="REPAY_BP_TYPE"/>
            <a:dataSet id="yes_no_ds" loadData="true" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="margin_deduction_method_ds" loadData="true" lookupCode="MARGIN_DEDUCTION_METHOD"/>
            <a:dataSet id="incept_type_ds" loadData="true" lookupCode="PRODUCT.INCEPT_TYPE"/>
            <a:dataSet id="charge_discount_rule_ds" loadData="true" lookupCode="CHARGE_DISCOUNT_RULE"/>
            <a:dataSet id="discount_times_ds" loadData="true" lookupCode="DISCOUNT_TIMES"/>
            <a:dataSet id="manufacturer_name_query_ds">
                <a:fields>
                    <a:field name="bp_category" defaultValue="MANUFACTURER"/>
                    <a:field name="bp_category2" defaultValue="PARTNER"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="manufacturer_name_ds" autoQuery="true" queryDataSet="manufacturer_name_query_ds"
                       queryUrl="${/request/@context_path}/hls/bp/home/query" loadData="true">
                <a:fields>
                    <a:field name="bp_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd216_hls_product_definition_query_ds">
                <a:fields>
                    <!--<a:field name="product_status_n" options="product_status_ds" prompt="状态"
                             displayField="code_value_name" returnField="product_status" valueField="code_value"/>-->
                    <!--<a:field name="enabled_flag" checkedValue="Y" uncheckedValue="N" defaultValue="Y"/>-->
                    <a:field name="enabled_flag_n" options="enabled_flag_ds" prompt="启用标志"
                             displayField="code_value_name" returnField="enabled_flag" valueField="code_value"/>
                    <!--<a:field name="bp_name" options="manufacturer_name_ds" prompt="厂商/合作方"
                             displayField="bp_name" returnField="bp_name" valueField="bp_name"/>-->
                    <a:field name="bp_name" autoComplete="true" lovGridHeight="360" lovHeight="510"
                             lovLabelWidth="100" lovService="/hls/bp/master/manufacturer/query~com.hand.hls.prj.dto.BpManufacturerInfoLov"
                             lovWidth="600"
                             title="合作商">
                        <a:mapping>
                            <a:map from="bp_name" to="bp_name"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd216_hls_product_definition_ds" autoQuery="true"
                       queryDataSet="fnd216_hls_product_definition_query_ds"
                       queryUrl="${/request/@context_path}/hls/product/definition/query"
                       submitUrl="${/request/@context_path}/hls/product/definition/save"
                       deleteUrl="${/request/@context_path}/hls/product/definition/remove" selectable="true" selectionModel="single">
                <a:fields>
                    <a:field name="definition_id"/>
                    <a:field name="definition_code"/>
                    <a:field name="definition_name" required="true"/>
                    <a:field name="description"/>
                    <a:field name="credit_project_id"/>
<!--                    <a:field name="reply_product_code" required="true" autoComplete="true" lovGridHeight="300"-->
<!--                             lovHeight="450"-->
<!--                             lovLabelWidth="100"-->
<!--                             lovService="/hls/manufacturer/reply/product/query1~com.hand.hls.prj.dto.LovHlsReplyProduct"-->
