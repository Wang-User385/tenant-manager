                    <a:field name="lease_charge_discount_rule_n" options="charge_discount_rule_ds" required="true" prompt="服务费贴息规则"
                             displayField="code_value_name" returnField="lease_charge_discount_rule" valueField="code_value"/>
                    <a:field name="rental_discount_times_n" options="discount_times_ds"  prompt="租金/服务费返利贴息支付期数"
                             displayField="code_value_name" returnField="rental_discount_times" valueField="code_value"/>-->
                    <a:field name="compen_day" required="true"/>
                    <a:field name="buy_back_day" required="true"/>
                    <a:field name="penalty_rate" required="true"/>
                    <a:field name="risk_submit_value_time" required="true"/>
                    <a:field name="loan_submit_value_time" required="true"/>
                    <a:field name="loan_submit_value_second_time" required="true"/>
                    <a:field name="enabled_flag" required="true" checkedValue="Y" uncheckedValue="N" defaultValue="N"
                             prompt="启用标志"/>
                </a:fields>
