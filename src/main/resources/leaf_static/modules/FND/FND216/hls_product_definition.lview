        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="fnd216_hls_product_definition_query" text="HAP.QUERY"/>
                <a:gridButton click="fnd216_hls_product_definition_reset" text="HAP.RESET"/>
                <a:gridButton bind="fnd216_hls_product_definition_grid" type="add" text="新增产品"/>
                <!--<a:gridButton bind="fnd216_hls_product_definition_para_grid" type="add" text="新增参数"/>-->
                <!--<a:gridButton bind="fnd216_hls_product_definition_para_grid" type="delete" text="删除参数"/>-->
                <a:gridButton bind="fnd216_hls_product_definition_grid" type="save"/>
                <!--<a:gridButton click="fnd216_hls_product_definition_submit" text="提交复核"/>-->
                <!--<a:gridButton bind="fnd216_hls_product_definition_grid" type="refresh"/>-->
                <!--<a:gridButton click="fnd216_hls_product_definition_change" text="变更产品"/>-->
            </a:screenTopToolbar>
            <a:form column="4" labelWidth="175" title="HAP_QUERY_TITLE">
                <a:textField name="definition_code" bindTarget="fnd216_hls_product_definition_query_ds" prompt="产品编号"
                             typeCase="upper"
                             width="180">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="definition_name" bindTarget="fnd216_hls_product_definition_query_ds" prompt="产品名称"
                             width="170">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:textField>
                <!--<a:comboBox name="product_status_n" bindTarget="fnd216_hls_product_definition_query_ds" prompt="产品状态"
                            width="170">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:comboBox>-->
                <a:lov name="bp_name" bindTarget="fnd216_hls_product_definition_query_ds"  prompt="合作商"
                       width="170">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:lov>
                <!--<a:checkBox name="enabled_flag" bindTarget="fnd216_hls_product_definition_query_ds" prompt="启用标志"
                            width="200">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:checkBox>-->
                <a:comboBox name="enabled_flag_n" bindTarget="fnd216_hls_product_definition_query_ds" prompt="启用标志"
                            width="170">
                    <a:events>
                        <a:event name="enterdown" handler="fnd216_hls_product_definition_query"/>
                    </a:events>
                </a:comboBox>
            </a:form>
            <a:grid id="fnd216_hls_product_definition_grid" bindTarget="fnd216_hls_product_definition_ds"
                    height="400" canWheel="false"
                    marginWidth="50" navBar="true">
                <a:columns>
                    <a:column name="definition_code" align="center" autoAdjust="true" width="100"
                              prompt="产品编号"/>
                    <a:column name="definition_name" align="center" autoAdjust="true" width="270"
                              prompt="产品名称" editorFunction="fnd216_hls_product_definition_grid_editFun"/>
<!--                    <a:column name="reply_product_code" align="center" autoAdjust="true" width="150"-->
<!--                              prompt="批复产品编号"-->
<!--                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
<!--                    <a:column name="reply_product_name" align="center" autoAdjust="true" width="250"-->
<!--                              prompt="批复产品名称"/>-->
<!--                    <a:column name="bp_name" align="center" autoAdjust="true" width="150"-->
<!--                              prompt="厂商/合作方"/>-->
                    <!--<a:column name="project_number" align="center" autoAdjust="true" width="150"
                              prompt="批复编号"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="project_name" align="center" autoAdjust="true" width="250"
                              prompt="项目名称"/>-->
                    <a:column name="bp_name" align="center" autoAdjust="true" width="200"
                              prompt="合作商"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <!--<a:column name="dealer_link" align="center" autoAdjust="true" width="150"
                              prompt="分配经销商" renderer="dealer_assign_renderer"/>-->
                    <a:column name="price_list_display" align="center" autoAdjust="true" width="150"
                              prompt="还款方式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <!--<a:column name="simple_compound_type_n" align="center" autoAdjust="true" width="80"
                              prompt="单利/复利"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <!--<a:column name="margin_deduction_method_n" align="center" autoAdjust="true" width="130"
                              prompt="保证金抵扣方式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <a:column name="incept_type_n" align="center" autoAdjust="true" width="130"
                              prompt="起租方式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="pay_type_n" align="center" autoAdjust="true" width="60"
                              prompt="先付/后付"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="annual_pay_times_n" align="center" autoAdjust="true" width="60"
                              prompt="支付频率"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <!--<a:column name="repay_flag" align="center" autoAdjust="true" width="60"
                              prompt="租金是否返利"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="service_fee_repay_flag" align="center" autoAdjust="true" width="60"
                              prompt="服务费是否返利"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="exempt_penalty_int_n" align="center" autoAdjust="true" width="80"
                              prompt="逾期宽限类型"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="residual_price_type_n" align="center" autoAdjust="true" width="120"
                              prompt="名义货价类型"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="step_quotation_flag_n" align="center"  width="120"
                              prompt="是否阶梯式报价"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <a:column name="residual_value_received_n" align="center"  width="120"
                              prompt="留购价收取方式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                   <!-- <a:column name="repay_mode_n" align="center"  width="120"
                              prompt="租金返利/贴息模式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="lease_charge_discount_rule_n" align="center"  width="120"
                              prompt="服务费返利/贴息规则"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="repay_bp_type_n" align="center"  width="120"
                              prompt="租金/服务费返利贴息对象类型"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <a:column name="payment_bp_type_n" align="center"  width="100"
                              prompt="投放对象"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="employee_name" align="center"  width="100"
                              prompt="业务经理"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="lease_item_type_n" align="center"  width="100"
                              prompt="业务类型"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <!--<a:column name="description" align="center" autoAdjust="true" width="200"
                              prompt="产品说明"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    &lt;!&ndash;<a:column name="product_status_n" align="center" autoAdjust="true" width="60"
                              prompt="产品状态"/>&ndash;&gt;
                    <a:column name="int_rate_calc_flag_n" align="center"  width="120"
                              prompt="是否倒推租金"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="rental_discount_times_n" align="center"  width="120"
                              prompt="租金/服务费返利贴息支付期数"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <a:column name="creation_date" align="center" autoAdjust="true" width="120" renderer="formatDate"
                              prompt="创建日期"/>
                    <a:column name="penalty_rate" align="center" autoAdjust="true" width="120"
                              editorFunction="fnd216_hls_product_definition_grid_editFun" prompt="罚息率" renderer="percentFormat"/>
                    <a:column name="compen_day" align="center" autoAdjust="true" width="120"
                              editorFunction="fnd216_hls_product_definition_grid_editFun" prompt="代偿天数"/>
                    <a:column name="buy_back_day" align="center" autoAdjust="true" width="120"
                              editorFunction="fnd216_hls_product_definition_grid_editFun" prompt="回购天数"/>
