<!--                            <a:map from="bp_name" to="bp_name"/>-->
<!--                        </a:mapping>-->
<!--                    </a:field>-->
                    <a:field name="bp_name" required="true" autoComplete="true" lovGridHeight="300"
                             lovHeight="450"
                             lovLabelWidth="100"
                             lovService="/hls/manufacturer/reply/product/query3~com.hand.hls.prj.dto.LovHlsReplyProduct"
                             lovWidth="600"
                             title="合作商选择" fetchRemote="false" prompt="合作商">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <!--<a:map from="project_number" to="project_number"/>
                            <a:map from="project_name" to="project_name"/>-->
                            <a:map from="bp_name" to="bp_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_id"/>
                    <a:field name="employee_id"/>
                    <a:field name="employee_name" required="true" autoComplete="true" lovGridHeight="300"
                             lovHeight="450"
                             lovLabelWidth="100"
                             lovService="/hls/manufacturer/reply/product/querySales~com.hand.hls.prj.dto.LovHlsSalesProduct"
                             lovWidth="600"
