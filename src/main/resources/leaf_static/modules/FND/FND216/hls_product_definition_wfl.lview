    $Author: 胡辉勇
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="fnd216_dealer_assign_link" url="${/request/@context_path}/modules/FND/FND216/hls_product_definition_assign_dealer.lview"/>
        <style>
            html,body {
                background: white;
            }
        </style>
        <script><![CDATA[
        $L.onReady(function () {
            var product_definition_ds = $("fnd216_hls_product_definition_ds");
            var definition_id = "${/parameter/@businessKey}";
            product_definition_ds.setQueryParameter('definition_id', definition_id);
            product_definition_ds.query();
        });


        // if(parent.currentTaskInfo.task_definition_key == "sid-WkmLSIar-JkoH-4P1z-8KKI-dqDXYSNuR4ZO"  ){
        //
        // }

        function dealer_assign_renderer(value, record, name){
            var function_usage;
            if(record.isNew==true){
                return "";
            }else{
                if(parent.currentTaskInfo.task_definition_key != "sid-8c3rdKuB-71jP-4hjF-8b6X-hbCjo5j8v2fM"){
                    function_usage = 'QUERY';
                }else{
                    function_usage = 'MODIFY';
                }
                return '<a href="javascript:winOpen_dealer_assign_renderer(\'' + function_usage + '\',\'' + record.get('definition_id') + '\',\'' + record.get('definition_name') + '\',\'' + record.get('bp_id') + '\',\'' + record.get('bp_name') + '\');">分配经销商</a>';
            }
        }

        function beforeClick_lov_price_list_display(lov) {
//            lov.controller = "/hls/calcConfig/queryUnSheets?enabledFlag=Y";
            lov.para = {
                'enabledFlag': 'Y'
            }
        }



        function fnd216_hls_product_definition_para_grid_editFun(record, name) {
            var product_definition_record = $('fnd216_hls_product_definition_ds').getCurrentRecord();
            var product_status = product_definition_record.get('product_status');
            var key=parent.currentTaskInfo.task_definition_key;
            if(parent.currentTaskInfo.task_definition_key != "sid-8c3rdKuB-71jP-4hjF-8b6X-hbCjo5j8v2fM"  ){
                $('para_save_bt').hide();
                $('add_bt').hide();
                $('delete_bt').hide();
                return '';

            }
            if (name == 'product_para_display') {
                return 'fnd216_hls_product_definition_para_grid_comboBox';
            } else if (name == 'description' || name == 'annual_pay_times_n') {
                return 'fnd216_hls_product_definition_para_grid_textField';
            } else if (name == 'default_value' || name == 'value_from' || name == 'value_to') {
                return 'fnd216_hls_product_definition_para_grid_numberField';
            } else if (name == 'system_control_flag' || name == 'enabled_flag') {
                return 'fnd216_hls_product_definition_para_grid_checkBox';
            } else {
                return '';
            }
        }


        function fnd216_hls_product_definition_grid_editFun(record, name) {
            var product_status = record.get('product_status');
            if(parent.currentTaskInfo.task_definition_key != "sid-8c3rdKuB-71jP-4hjF-8b6X-hbCjo5j8v2fM"  ){
                $('save_bt').hide();
                return '';
            }

            if (name == 'definition_name' || name == 'description') {
                return 'fnd216_hls_product_definition_grid_textField';
            } else if (name == 'reply_product_code') {
                return 'fnd216_hls_product_definition_grid_lov_reply_product_code';
            } else if (name == 'price_list_display') {
                return 'fnd216_hls_product_definition_grid_lov_price_list_display';
            } else if (name == 'pay_type_n' || name == 'annual_pay_times_n' || name == 'exempt_penalty_int_n' || name == 'residual_price_type_n'||
                name == 'step_quotation_flag_n'|| name == 'residual_value_received_n'|| name == 'repay_mode_n' || name == 'payment_bp_type_n'|| name == 'repay_bp_type_n'|| name == 'simple_compound_type_n'
                || name == 'int_rate_calc_flag_n' || name == 'lease_charge_discount_rule_n' || name == 'rental_discount_times_n') {
                return 'fnd216_hls_product_definition_grid_comboBox';
            } else if (name == 'repay_flag' || name == 'service_fee_repay_flag' || name=='enabled_flag') {
                return 'fnd216_hls_product_definition_grid_checkBox';
            } else {
                return '';
            }

        }

        function beforeClick_lov_reply_product_code(lov) {
            lov.para = {
                'latestFlag': 'Y'
            }
        }

        function commit_lov_reply_product_code(lov, dsRecord, lovRecord){
            var param = lovRecord.data;
            var irr_flag=true;
            var down_payment_ratio_flag=true;
            var deposit_ratio=true;
            var residual=true;
            ds = $('fnd216_hls_product_definition_para_ds');
            var datas = ds.getAll();
            if(datas != null && datas.length > 0) {
                for (var j = 0; j < datas.length; j++) {
                    if (datas[j].get('product_para') === 'IRR') {
                        datas[j].set('default_value',param.irr);
                        datas[j].set('value_from',param.irr);
                        datas[j].set('value_to',param.irr);
                        irr_flag = false;
                    }
                    if (datas[j].get('product_para') === 'DOWN_PAYMENT_RATIO') {
                        datas[j].set('default_value',param.down_payment_ratio);
                        datas[j].set('value_from',param.down_payment_ratio);
                        datas[j].set('value_to',param.down_payment_ratio);
                        down_payment_ratio_flag = false;
                    }
                    if (datas[j].get('product_para') === 'DEPOSIT_RATIO') {
                        datas[j].set('default_value',param.deposit_ratio);
                        datas[j].set('value_from',param.deposit_ratio);
                        datas[j].set('value_to',param.deposit_ratio);
                        deposit_ratio = false;
                    }
                    if (datas[j].get('product_para') === 'RESIDUAL_VALUE') {
                        datas[j].set('default_value',param.residual);
                        datas[j].set('value_from',param.residual);
                        datas[j].set('value_to',param.residual);
                        residual = false;
                    }
                }
            }
            debugger
            if(param.price_list != undefined && param.price_list != null){
                dsRecord.set('price_list', param.price_list);
                dsRecord.set('price_list_display', param.price_list_n);
            }
            if(param.pay_type != undefined && param.pay_type != null){
                dsRecord.set('pay_type', param.pay_type);
                dsRecord.set('pay_type_n', param.pay_type_n);
            }
            if(param.annual_pay_timess != undefined && param.annual_pay_timess != null){
                dsRecord.set('annual_pay_times', param.annual_pay_timess);
                dsRecord.set('annual_pay_times_n', param.annual_pay_times_n);
            }
            if(param.residual_price_type != undefined && param.residual_price_type != null){
                dsRecord.set('residual_price_type', param.residual_price_type);
                dsRecord.set('residual_price_type_n', param.residual_price_type_n);
            }
            if(param.exempt_penalty_int != undefined && param.exempt_penalty_int != null){
                dsRecord.set('exempt_penalty_int', param.exempt_penalty_int);
                dsRecord.set('exempt_penalty_int_n', param.exempt_penalty_int_n);
            }
            debugger
            if(param.irr != undefined && param.irr != null && irr_flag){
                ds.create();
                var record = ds.getCurrentRecord();
                record.set('product_para', 'IRR');
                record.set('product_para_display', 'IRR');
                record.set('default_value',param.irr);
                record.set('value_from',param.irr);
                record.set('value_to',param.irr);
                record.set('system_control_flag', 'Y');
                record.set('enabled_flag', 'Y');
            }
            if(param.down_payment_ratio != undefined && param.down_payment_ratio != null && down_payment_ratio_flag){
                ds.create();
                var record = ds.getCurrentRecord();
                record.set('product_para', 'DOWN_PAYMENT_RATIO');
                record.set('product_para_display', '首付款比例');
                record.set('default_value',param.down_payment_ratio);
                record.set('value_from',param.down_payment_ratio);
                record.set('value_to',param.down_payment_ratio);
                record.set('system_control_flag', 'Y');
                record.set('enabled_flag', 'Y');
            }
            if(param.deposit_ratio != undefined && param.deposit_ratio != null && deposit_ratio){
                ds.create();
                var record = ds.getCurrentRecord();
                record.set('product_para', 'DEPOSIT_RATIO');
                record.set('product_para_display', '保证金比例');
                record.set('default_value',param.deposit_ratio);
                record.set('value_from',param.deposit_ratio);
                record.set('value_to',param.deposit_ratio);
                record.set('system_control_flag', 'Y');
                record.set('enabled_flag', 'Y');
            }
            if(param.residual != undefined && param.residual != null && residual){
                ds.create();
                var record = ds.getCurrentRecord();
                record.set('product_para', 'RESIDUAL_VALUE');
                record.set('product_para_display', '名义货价');
                record.set('default_value',param.residual);
                record.set('value_from',param.residual);
                record.set('value_to',param.residual);
                record.set('system_control_flag', 'Y');
                record.set('enabled_flag', 'Y');
            }


            // $('fnd216_hls_product_definition_para_ds').query();
            // Leaf.request({
            //     url: $('hls_reply_product_param_query_link').getUrl()+'?pagesize=0',
            //     para: {
            //         reply_product_id: param.project_id
            //     },
            //     success: function (e) {
            //         var maps = e.result.record,
            //             ds = $('fnd216_hls_product_definition_para_ds'),
            //             datas = ds.getAll();
            //         if(maps != null && maps.length > 0){
            //             for(var i = 0; i < maps.length; i++){
            //                 var map = maps[i],insert_flag = true;
            //                 if(datas != null && datas.length > 0){
            //                     for(var j = 0; j < datas.length; j++){
            //                         if(datas[j].get('product_para') === map.reply_product_para){
            //                             insert_flag = false;
            //                             break;
            //                         }
            //                     }
            //                 }
            //                 if(insert_flag){
            //                     ds.create();
            //                     var record = ds.getCurrentRecord();
            //                     record.set('product_para', map.reply_product_para);
            //                     record.set('product_para_display', map.reply_product_para_n);
            //                     record.set('default_value', map.default_value);
            //                     record.set('value_from', map.vaule_from);
            //                     record.set('value_to', map.vaule_to);
            //                     record.set('system_control_flag', 'Y');
            //                     record.set('enabled_flag', 'Y');
            //                 }
            //             }
            //         }
            //     },
            //     scope: this
            // });
        }

        function winOpen_dealer_assign_renderer(function_usage,definition_id,definition_name,bp_id,bp_name){
            var win = new Leaf.Window({
                id: 'fnd216_dealer_assign_winid',
                url: $('fnd216_dealer_assign_link').getUrl() + '?function_code=FND216F1&&function_usage=' + function_usage,
                params: {
                    definitionId: definition_id,
                    definitionName: definition_name,
                    manufacturerId: bp_id,
                    manufacturerName: bp_name,
                    winId:'fnd216_dealer_assign_winid'
                },
                title: '分配经销商',
                width: 1000,
                height: 575
            });
            win.on('close', function () {
                $('fnd216_hls_product_definition_ds').query();
            });
        }

        function fnd216_hls_product_definition_submitsuccess(ds) {
            $("fnd216_hls_product_definition_ds").query();
        }

        //2023-02-28参数grid新增保存按钮逻辑
        function fnd216_hls_product_definition_para_beforesubmit(ds) {
            var product_definition_record = $('fnd216_hls_product_definition_ds').getCurrentRecord();
            var definition_id = product_definition_record.get('definition_id');
            var datas = ds.getAll();
            for (var i = 0; i < datas.length; i++) {
                datas[i].set('definition_id',definition_id);
            }
            return true;
        }
        function fnd216_hls_product_definition_para_submitsuccess(ds) {
            $('fnd216_hls_product_definition_para_ds').query();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="product_status_ds" loadData="true" lookupCode="FND.PRODUCT_STATUS"/>
            <a:dataSet id="pay_type_ds" loadData="true" lookupCode="HLS500_PAY_TYPE"/>
            <a:dataSet id="annual_pay_times_ds" loadData="true" lookupCode="HLS500_ANNUAL_PAY_TIMES"/>
            <a:dataSet id="exempt_penalty_int_ds" loadData="true" lookupCode="EXEMPT_PENALTY_INT"/>
            <a:dataSet id="product_para_ds" loadData="true" lookupCode="HLS500_PRODUCT_PARA"/>
            <a:dataSet id="fnd216_hls_product_definition_ds" autoQuery="false"
                       queryDataSet="fnd216_hls_product_definition_query_ds"
                       queryUrl="${/request/@context_path}/hls/product/definition/query"
                       submitUrl="${/request/@context_path}/hls/product/definition/save">

                <a:fields>
                    <a:field name="definition_id"/>
                    <a:field name="definition_code"/>
                    <a:field name="definition_name"/>
                    <a:field name="description"/>
                    <a:field name="credit_project_id"/>
<!--                    <a:field name="reply_product_code" required="true" autoComplete="true" lovGridHeight="300"-->
<!--                             lovHeight="450"-->
<!--                             lovLabelWidth="100"-->
<!--                             lovService="/hls/manufacturer/reply/product/query1~com.hand.hls.prj.dto.LovHlsReplyProduct"-->
<!--                             lovWidth="600"-->
<!--                             title="批复产品" fetchRemote="false" prompt="批复产品">-->
<!--                        <a:mapping>-->
<!--                            <a:map from="reply_product_id" to="reply_product_id"/>-->
<!--                            <a:map from="reply_product_code" to="reply_product_code"/>-->
<!--                            <a:map from="difinition_name" to="reply_product_name"/>-->
<!--                            <a:map from="bp_name" to="bp_name"/>-->
<!--                        </a:mapping>-->
<!--                    </a:field>-->
                    <a:field name="project_number" required="true" autoComplete="true" lovGridHeight="300"
                             lovHeight="450"
                             lovLabelWidth="100"
                             lovService="/hls/manufacturer/reply/product/query2~com.hand.hls.prj.dto.LovHlsReplyProduct"
                             lovWidth="600"
                             title="批复项目" fetchRemote="false" prompt="批复项目">
                        <a:mapping>
                            <a:map from="project_id" to="reply_product_id"/>
                            <a:map from="project_number" to="project_number"/>
                            <a:map from="project_name" to="project_name"/>
                            <a:map from="bp_name" to="bp_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="price_list_display" required="true" autoComplete="true" lovGridHeight="300"
                             lovHeight="450"
                             lovLabelWidth="100"
                             lovService="/hls/calcConfig/queryUnSheets~com.hand.hls.calc.dto.LovHlsCalcConfig"
                             lovWidth="600"
                             title="还款方式" fetchRemote="false" prompt="还款方式">
                        <a:mapping>
                            <a:map from="price_list" to="price_list"/>
                            <a:map from="description" to="price_list_display"/>
                        </a:mapping>
                    </a:field>
<!--                    <a:field name="reply_product_code" autoComplete="true" lovGridHeight="300"-->
<!--                             lovHeight="450"-->
<!--                             lovLabelWidth="100"-->
<!--                             lovService="/hls/reply/product/query~com.hand.hls.prj.dto.LovHlsReplyProduct"-->
<!--                             lovWidth="600"-->
<!--                             title="批复产品" fetchRemote="false" prompt="批复产品">-->
<!--                        <a:mapping>-->
<!--                            <a:map from="reply_product_id" to="reply_product_id"/>-->
<!--                            <a:map from="reply_product_code" to="reply_product_code"/>-->
<!--                            <a:map from="difinition_name" to="reply_product_name"/>-->
<!--                        </a:mapping>-->
<!--                    </a:field>-->
<!--                    <a:field name="price_list_display" autoComplete="true" lovGridHeight="300"-->
<!--                             lovHeight="450"-->
<!--                             lovLabelWidth="100"-->
<!--                             lovService="/hls/calcConfig/queryUnSheets~com.hand.hls.calc.dto.LovHlsCalcConfig"-->
<!--                             lovWidth="600"-->
<!--                             title="还款方式" fetchRemote="false" prompt="还款方式">-->
<!--                        <a:mapping>-->
<!--                            <a:map from="price_list" to="price_list"/>-->
<!--                            <a:map from="description" to="price_list_display"/>-->
<!--                        </a:mapping>-->
<!--                    </a:field>-->
<!--                    <a:field name="pay_type_display" options="pay_type_ds" prompt="先付/后付"-->
<!--                             displayField="code_value_name" returnField="pay_type" valueField="code_value"/>-->
<!--                    <a:field name="annual_pay_times_display" options="annual_pay_times_ds" prompt="支付频率"-->
<!--                             displayField="code_value_name" returnField="annual_pay_times" valueField="code_value"/>-->
<!--                    <a:field name="exempt_penalty_int_display" options="exempt_penalty_int_ds"-->
<!--                             prompt="逾期宽限类型"-->
<!--                             displayField="code_value_name" returnField="exempt_penalty_int" valueField="code_value"/>-->
                    <a:field name="pay_type_n" options="pay_type_ds" required="true" prompt="先付/后付"
                             displayField="code_value_name" returnField="pay_type" valueField="code_value"/>
                    <a:field name="annual_pay_times_n" options="annual_pay_times_ds" required="true" prompt="支付频率"
                             displayField="code_value_name" returnField="annual_pay_times" valueField="code_value"/>
                    <a:field name="exempt_penalty_int_n" options="exempt_penalty_int_ds" required="true"
                             prompt="逾期宽限类型"
                             displayField="code_value_name" returnField="exempt_penalty_int" valueField="code_value"/>
                    <a:field name="enabled_flag" checkedValue="Y" uncheckedValue="N" defaultValue="Y"/>
                    <a:field name="product_status_n" options="product_status_ds" prompt="产品状态"
                             displayField="code_value_name" returnField="product_status" valueField="code_value"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="fnd216_hls_product_definition_submitsuccess"/>
                </a:events>

            </a:dataSet>
            <a:dataSet id="fnd216_hls_product_definition_para_ds" bindName="hls_product_definition_para_list"
                       bindTarget="fnd216_hls_product_definition_ds" autoCount="true" autoPageSize="true"
                       autoQuery="false" selectable="true"
                       fetchAll="false" pageSize="999"
                       queryUrl="${/request/@context_path}/hls/product/definition/para/query"
                       submitUrl="${/request/@context_path}/hls/product/definition/para/submit"
                       deleteUrl="${/request/@context_path}/hls/product/definition/para/remove">
                <a:fields>
                    <a:field name="product_para_display" options="product_para_ds" prompt="参数名"
                             displayField="code_value_name" returnField="product_para" valueField="code_value"/>
                    <a:field name="system_control_flag" checkedValue="Y" uncheckedValue="N"
                             defaultValue="Y"/>
                    <a:field name="value_from"/>
                    <a:field name="value_to"/>
                    <a:field name="enabled_flag" checkedValue="Y" uncheckedValue="N" defaultValue="Y"/>
                </a:fields>
                <a:events>
                    <a:event name="beforesubmit" handler="fnd216_hls_product_definition_para_beforesubmit"/>
                    <a:event name="submitsuccess" handler="fnd216_hls_product_definition_para_submitsuccess"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:gridButton bind="fnd216_hls_product_definition_grid" type="save" id="save_bt"/>
            <a:grid id="fnd216_hls_product_definition_grid" bindTarget="fnd216_hls_product_definition_ds"
                    height="280"
                    marginWidth="50" navBar="true">
                <a:columns>
                    <a:column name="definition_code" align="center" autoAdjust="true" width="100"
                              prompt="产品编号"/>
                    <a:column name="definition_name" align="center" autoAdjust="true" width="150"
                              prompt="产品名称" editorFunction="fnd216_hls_product_definition_grid_editFun"/>
<!--                    <a:column name="reply_product_code" align="center" autoAdjust="true" width="150"-->
<!--                              prompt="批复产品编号"-->
<!--                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
<!--                    <a:column name="reply_product_name" align="center" autoAdjust="true" width="250"-->
<!--                              prompt="批复产品名称"/>-->
                    <a:column name="project_number" align="center" autoAdjust="true" width="150"
                              prompt="批复编号"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="project_name" align="center" autoAdjust="true" width="250"
                              prompt="项目名称"/>
<!--                    <a:column name="bp_name" align="center" autoAdjust="true" width="150"-->
<!--                              prompt="合作方"/>-->
                    <a:column name="dealer_link" align="center" autoAdjust="true" width="150"
                              prompt="分配经销商" renderer="dealer_assign_renderer"/>
                    <a:column name="price_list_display" align="center" autoAdjust="true" width="130"
                              prompt="还款方式"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
<!--                    <a:column name="pay_type_display" align="center" autoAdjust="true" width="120"-->
<!--                              prompt="先付/后付" editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
<!--                    <a:column name="annual_pay_times_display" align="center" autoAdjust="true" width="120"-->
<!--                              prompt="支付频率" editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
<!--                    <a:column name="exempt_penalty_int_display" align="center" autoAdjust="true" width="120"-->
<!--                              prompt="逾期宽限类型" editorFunction="fnd216_hls_product_definition_grid_editFun"/>-->
                    <a:column name="pay_type_n" align="center" autoAdjust="true" width="60"
                              prompt="先付/后付"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="annual_pay_times_n" align="center" autoAdjust="true" width="60"
                              prompt="支付频率"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="exempt_penalty_int_n" align="center" autoAdjust="true" width="80"
                              prompt="逾期宽限类型"
                              editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="description" align="center" autoAdjust="true" width="200"
                              prompt="产品说明" editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                    <a:column name="product_status_n" align="center" autoAdjust="true" width="100"
                              prompt="产品状态"/>
                    <a:column name="creation_date" align="center" autoAdjust="true" width="200"
                              prompt="创建时间"/>
                    <a:column name="last_update_date" align="center" autoAdjust="true" width="200"
                              prompt="最后更新时间"/>
                    <a:column name="enabled_flag" align="center" autoAdjust="true" width="80"
                              prompt="启用标志" editorFunction="fnd216_hls_product_definition_grid_editFun"/>
                </a:columns>
                <a:editors>
                    <a:textField id="fnd216_hls_product_definition_grid_textField_upper" typeCase="upper"/>
                    <a:textField id="fnd216_hls_product_definition_grid_textField"/>
                    <a:numberField id="fnd216_hls_product_definition_grid_numberField"/>
                    <a:checkBox id="fnd216_hls_product_definition_grid_checkBox"/>
                    <a:comboBox id="fnd216_hls_product_definition_grid_comboBox"/>
                    <a:lov id="fnd216_hls_product_definition_grid_lov"/>
                    <a:lov id="fnd216_hls_product_definition_grid_lov_reply_product_code">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="beforeClick_lov_reply_product_code"/>
                            <a:event name="commit" handler="commit_lov_reply_product_code"/>
                        </a:events>
                    </a:lov>
                    <a:lov id="fnd216_hls_product_definition_grid_lov_price_list_display">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="beforeClick_lov_price_list_display"/>
                        </a:events>
                    </a:lov>
                </a:editors>
            </a:grid>
            <a:grid id="fnd216_hls_product_definition_para_grid" bindTarget="fnd216_hls_product_definition_para_ds"
                    height="280"
                    marginWidth="50" navBar="true">
                <a:toolBar>
                    <a:button type="save" id="para_save_bt"/>
                    <a:button type="add" id="add_bt"/>
                    <a:button type="delete" id="delete_bt"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="product_para_display" align="center" autoAdjust="true" width="120"
                              prompt="参数名" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="description" align="center" autoAdjust="true" width="200"
                              prompt="参数说明" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="default_value" align="right" autoAdjust="true" width="120"
                              prompt="缺省值" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="value_from" align="right" autoAdjust="true" width="120"
                              prompt="范围从" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="value_to" align="right" autoAdjust="true" width="120"
                              prompt="范围到" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="system_control_flag" align="center" autoAdjust="true" width="80"
                              prompt="系统控制标志" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                    <a:column name="creation_date" align="center" autoAdjust="true" width="200"
                              prompt="创建时间"/>
                    <a:column name="last_update_date" align="center" autoAdjust="true" width="200"
                              prompt="最后更新时间"/>
                    <a:column name="enabled_flag" align="center" autoAdjust="true" width="80"
                              prompt="启用标志" editorFunction="fnd216_hls_product_definition_para_grid_editFun"/>
                </a:columns>
                <a:editors>
                    <a:textField id="fnd216_hls_product_definition_para_grid_textField"/>
                    <a:numberField id="fnd216_hls_product_definition_para_grid_numberField" decimalPrecision="6"/>
                    <a:checkBox id="fnd216_hls_product_definition_para_grid_checkBox"/>
                    <a:comboBox id="fnd216_hls_product_definition_para_grid_comboBox"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>