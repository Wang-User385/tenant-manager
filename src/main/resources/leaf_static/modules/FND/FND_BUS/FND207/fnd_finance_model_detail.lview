<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?item_type=FIN_STATEMENT_TMPLT_ITEM_TYPE" type="text/javascript"></script>
        <script><![CDATA[

        <!--获取resource type中英文映射数组，存入Map-->
        var itemTypeECMap = {};
        item_type.forEach(function(i){
            itemTypeECMap[i.value] = i.meaning;
        });

        <!--将type中英文存入对应的ds-->
        $L.onReady(function(){
            item_type.forEach(function(i){
                $("fnd_finance_model_item_type_query_ds").create({"fin_statement_item_type":i.value,"fin_statement_item_type_cn":i.meaning});
            });
            //console.log(item_type);
        });

        <!-- business_parter_type_ds 加载后从type字段换成映射item_type-->
        function onLoad_business_parter_type_ds(ds){
            var records = ds.data;
            records.forEach(function(record){
                record.data["item_type_cn"] = itemTypeECMap[record.data["item_type"]];
            });
        }

        <!--客户财报-->
        function fnd_finance_model_detail_bpmaster_select_query() {
            $('fnd_finance_model_detail_bpmaster_select_query_ds').query();
        }

        function fnd_finance_model_detail_bpmaster_select_add() {
            $('fnd_finance_model_detail_bpmaster_select_ds').create();
        }

        function fnd_finance_model_detail_bpmaster_select_save() {
            var ds = $('fnd_finance_model_detail_bpmaster_select_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }
        function onSubmitSuccess_fnd_finance_model_detail_bpmaster_select_ds(ds) {
            fnd_finance_model_detail_bpmaster_select_query();
        }



        <!-- 资产负债表 -->
        function fnd_finance_model_detail_balance_select_query() {
            $('fnd_finance_model_detail_balance_select_query_ds').query();
        }

        function fnd_finance_model_detail_balance_select_add() {
            $('fnd_finance_model_detail_balance_select_ds').create();
        }

        function fnd_finance_model_detail_balance_select_save() {
            var ds = $('fnd_finance_model_detail_balance_select_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_fnd_finance_model_detail_balance_select_ds(ds) {
            fnd_finance_model_detail_balance_select_query();
        }

        <!-- 利润表 -->
        function fnd_finance_model_detail_profit_statement_query() {
            $('fnd_finance_model_detail_profit_statement_query_ds').query();
        }

        function fnd_finance_model_detail_profit_statement_add() {
            $('fnd_finance_model_detail_profit_statement_ds').create();
        }

        function fnd_finance_model_detail_profit_statement_save() {
            var ds = $('fnd_finance_model_detail_profit_statement_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_fnd_finance_model_detail_profit_statement_ds(ds) {
            fnd_finance_model_detail_profit_statement_query();
        }

        <!-- 现金流量表 -->
        function fnd_finance_model_detail_cash_flow_statement_query() {
            $('fnd_finance_model_detail_cash_flow_statement_query_ds').query();
        }
        function fnd_finance_model_detail_cash_flow_statement_add() {
            $('fnd_finance_model_detail_cash_flow_statement_ds').create();
        }

        function fnd_finance_model_detail_cash_flow_statement_save() {
            var ds = $('fnd_finance_model_detail_cash_flow_statement_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_fnd_finance_model_detail_cash_flow_statement_ds(ds) {
            fnd_finance_model_detail_cash_flow_statement_query();
        }

        <!-- 补充资料表 -->
        function fnd_finance_model_detail_financial_index_query() {
            $('fnd_finance_model_detail_financial_index_query_ds').query();
        }

        function fnd_finance_model_detail_financial_index_add() {
            $('fnd_finance_model_detail_financial_index_ds').create();
        }

        function fnd_finance_model_detail_financial_index_save() {
            var ds = $('fnd_finance_model_detail_financial_index_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_fnd_finance_model_detail_financial_index_ds(ds) {
            fnd_finance_model_detail_financial_index_query();
        }

        <!-- 财务指标表 -->
        function fnd_finance_model_detail_financial_indicator_query() {
            $('fnd_finance_model_detail_financial_indicator_query_ds').query();
        }

        function fnd_finance_model_detail_financial_indicator_add() {
            $('fnd_finance_model_detail_financial_indicator_ds').create();
        }

        function fnd_finance_model_detail_financial_indicator_save() {
            var ds = $('fnd_finance_model_detail_financial_indicator_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/fnd/statementTmpltLn/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_fnd_finance_model_detail_financial_indicator_ds(ds) {
            fnd_finance_model_detail_financial_indicator_query();
        }


        function fnd_finance_model_detail_quit() {
            $('${/parameter/@winId}').close();
        }

        /***
         *  bpmaster_select 编辑
         * @param record
         * @param name
         */
        function fnd_finance_model_detail_bpmaster_select_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_bpmaster_select_ds_grid_tf';
            }else
                return '';
        }


        /***
         *  balance_select 编辑
         * @param record
         * @param name
         */
        function fnd_finance_model_detail_balance_select_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_balance_select_ds_grid_tf';
            }else
                return '';
        }


        /***
         * profit_statement 编辑
         * @param record
         * @param name
         * @returns {string}
         */
        function fnd_finance_model_detail_profit_statement_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_profit_statement_ds_grid_tf';
            }else
                return '';
        }

        /***
         *  cash_flow_statement 编辑
         * @param record
         * @param name
         * @returns {string}
         */
        function fnd_finance_model_detail_cash_flow_statement_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_cash_flow_statement_ds_grid_tf';
            }else
                return '';
        }

        /**
         * financial_index 编辑
         * @param record
         * @param name
         * @returns {string}
         */
        function fnd_finance_model_detail_financial_index_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_financial_index_ds_grid_tf';
            }else
                return '';
        }


        function fnd_finance_model_detail_financial_indicator_ds_grid_editFun(record,name) {
            if(record.get("fin_statement_item_type_cn") == "公式"){
                return 'fnd_finance_model_detail_financial_indicator_ds_grid_tf';
            }else
                return '';
        }

        /**
         * 序号校验
         * @param record
         * @param name
         * @param value
         * @returns {*}
         */
        function fnd_finance_model_detail_line_seq_number_validate(record,name,value) {
            if(/^[1-9]\d*|0$/.test(value)){
                return true;
            }else {
                return "请输入非负整数";
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="fnd_finance_model_item_type_query_ds">
                <a:fields>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="fnd_finance_model_detail_bpmaster_select_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="客户财报基本信息"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="fnd_finance_model_detail_balance_select_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="资产负债表"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_profit_statement_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="利润表"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_cash_flow_statement_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="现金流量表"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_financial_index_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="补充资料表"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="fnd_finance_model_detail_financial_indicator_query_ds">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="财务指标"/>
                </a:fields>
            </a:dataSet>


            <a:dataSet id="fnd_finance_model_detail_bpmaster_select_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_bpmaster_select_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="客户财报基本信息"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_bpmaster_select_ds"/>
                </a:events>
            </a:dataSet>


            <a:dataSet id="fnd_finance_model_detail_balance_select_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_balance_select_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="资产负债表"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_balance_select_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_profit_statement_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_profit_statement_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="利润表"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_profit_statement_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_cash_flow_statement_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_cash_flow_statement_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="现金流量表"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_cash_flow_statement_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_financial_index_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_financial_index_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="补充资料表"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_financial_index_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="fnd_finance_model_detail_financial_indicator_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/statementTmpltLn/query"
                       deleteUrl="${/request/@context_path}/fnd/statementTmpltLn/delete"
                       queryDataSet="fnd_finance_model_detail_financial_indicator_query_ds" selectable="true">
                <a:fields>
                    <a:field name="fin_statement_templet_hd_id" defaultValue="${/parameter/@fin_statement_templet_hd_id}"/>
                    <a:field name="line_type" defaultValue="财务指标"/>
                    <a:field name="fin_statement_item_name" required="true" requiredMessage="请输入报表项名称"/>
                    <a:field name="fin_statement_item_type"/>
                    <a:field name="fin_statement_item_type_cn" required="true" requiredMessage="请输入报表项类型" options="fnd_finance_model_item_type_query_ds"
                             displayField="fin_statement_item_type_cn" valueField="fin_statement_item_type"
                             returnField="fin_statement_item_type"/>
                    <a:field name="line_seq_number" validator="fnd_finance_model_detail_line_seq_number_validate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_fnd_finance_model_detail_financial_indicator_ds"/>
                </a:events>
            </a:dataSet>


        </a:dataSets>
        <a:screenBody>
            <a:tabPanel marginWidth="360" marginHeight="40">
                <a:tabs>

                    <a:tab prompt="客户财报基本信息" width="130" selected="true" >
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="fnd_finance_model_detail_quit" text="关闭"/>
                            <a:gridButton click="fnd_finance_model_detail_bpmaster_select_add" text="HAP.NEW"/>
                            <a:gridButton click="fnd_finance_model_detail_bpmaster_select_save" text="HAP.SAVE"/>
                            <a:gridButton bind="fnd_finance_model_detail_bpmaster_select_ds_grid" text="HAP.DELETE" type="delete"/>
                        </a:screenTopToolbar>
                        <a:grid id="fnd_finance_model_detail_bpmaster_select_ds_grid"
                                bindTarget="fnd_finance_model_detail_bpmaster_select_ds" marginWidth="400"
                                marginHeight="160"
                                navBar="true">
                            <a:columns>
                                <a:column name="fin_statement_item_name" width="200" prompt="报表项名称" editor="fnd_finance_model_detail_bpmaster_select_ds_grid_tf"/>
                                <a:column name="fin_statement_item_type_cn" width="150" prompt="报表项类型" editor="fnd_finance_model_detail_bpmaster_select_ds_grid_cmb"/>
                                <a:column name="line_seq_number" width="100" prompt="序号" editor="fnd_finance_model_detail_bpmaster_select_ds_grid_tf"/>
                                <a:column name="formula_priority" width="100" prompt="公式优先级" editor="fnd_finance_model_detail_bpmaster_select_ds_grid_tf"/>
                                <a:column name="formula_text" width="280" prompt="公式编辑" editor="fnd_finance_model_detail_bpmaster_select_ds_grid_tf"/>
                            </a:columns>
                            <a:editors>
                                <a:textField id="fnd_finance_model_detail_bpmaster_select_ds_grid_tf"/>
                                <a:comboBox id="fnd_finance_model_detail_bpmaster_select_ds_grid_cmb"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>

                    <a:tab prompt="资产负债表" width="130" selected="true" >
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="fnd_finance_model_detail_quit" text="关闭"/>
                            <a:gridButton click="fnd_finance_model_detail_balance_select_add" text="HAP.NEW"/>
                            <a:gridButton click="fnd_finance_model_detail_balance_select_save" text="HAP.SAVE"/>
                            <a:gridButton bind="fnd_finance_model_detail_balance_select_ds_grid" text="HAP.DELETE" type="delete"/>
                        </a:screenTopToolbar>
                        <a:grid id="fnd_finance_model_detail_balance_select_ds_grid"
                                bindTarget="fnd_finance_model_detail_balance_select_ds" marginWidth="400"
                                marginHeight="160"
                                navBar="true">
                            <a:columns>
                                <a:column name="fin_statement_item_name" width="200" prompt="报表项名称" editor="fnd_finance_model_detail_balance_select_ds_grid_tf"/>
                                <a:column name="fin_statement_item_type_cn" width="150" prompt="报表项类型" editor="fnd_finance_model_detail_balance_select_ds_grid_cmb"/>
                                <a:column name="line_seq_number" width="100" prompt="序号" editor="fnd_finance_model_detail_balance_select_ds_grid_tf"/>
                                <a:column name="formula_priority" width="100" prompt="公式优先级" editor="fnd_finance_model_detail_balance_select_ds_grid_tf"/>
                                <a:column name="formula_text" width="280" prompt="公式编辑" editor="fnd_finance_model_detail_balance_select_ds_grid_tf"/>
                            </a:columns>
                            <a:editors>
                                <a:textField id="fnd_finance_model_detail_balance_select_ds_grid_tf"/>
                                <a:comboBox id="fnd_finance_model_detail_balance_select_ds_grid_cmb"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="利润表" width="130">
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="fnd_finance_model_detail_quit" text="关闭"/>
                            <a:gridButton click="fnd_finance_model_detail_profit_statement_add" text="HAP.NEW"/>
                            <a:gridButton click="fnd_finance_model_detail_profit_statement_save" text="HAP.SAVE"/>
                            <a:gridButton bind="fnd_finance_model_detail_profit_statement_ds_grid" text="HAP.DELETE" type="delete"/>
                        </a:screenTopToolbar>
                        <a:grid id="fnd_finance_model_detail_profit_statement_ds_grid"
                                bindTarget="fnd_finance_model_detail_profit_statement_ds" marginWidth="400"
                                marginHeight="160"
                                navBar="true">
