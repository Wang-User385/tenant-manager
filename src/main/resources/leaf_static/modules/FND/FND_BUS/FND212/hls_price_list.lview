<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function hls_price_list_query() {
            $('hls_price_list_ds').query();
        }

        function hls_price_list_reset() {
            $('hls_price_list_query_ds').reset();
            $('hls_price_list_ds').query();
        }

        function hls_price_list_add() {
            $('hls_price_list_ds').create();
        }

        function hls_price_list_save() {
            var ds = $('hls_price_list_ds');
            if (ds.validate()) {
                ds.submit();
            }
        }

        function hls_price_list_export_confirm(){
            if($('hls_price_list_ds').getSelected().length==0){
                Leaf.showErrorMessage( '提示', '请选择记录！',null, 200, 100 );
                return ;
            }
            Leaf.showConfirm('提示', '确定导出？', hls_price_list_export, null, 200, 100 );

        }
        function hls_price_list_export() {
            var ds = $('hls_price_list_ds');
            var records = ds.getSelected();
            var export_list;
            for (var i = 0; i < records.length; i++) {
                if(export_list){
                    export_list = export_list + "," + records[i].data.price_list;
                }else{
                    export_list = records[i].data.price_list;
                }
            }
            location.href = "${/request/@context_path}/hls/calcConfig/export?idlist=" + export_list;
        }

        function hls_price_list_import() {
            jQuery("#file").click();
        }

        function hls_upload_file(){
            var file = jQuery("#file")[0].files[0];
            if(file == undefined){
                return ;
            }
            var formData = new FormData();
            formData.append("file",file);
            formData.append("_csrf","${/session/@_csrf.token}");
            Leaf.Masker.mask(Ext.getBody(), '上传中。。');
            jQuery.ajax({
                url:'${/request/@context_path}/hls/calcConfig/import',
                type:'post',
                data: formData,
                contentType: false,
                processData: false,
                success:function(res){
                   Leaf.Masker.unmask(Ext.getBody());
                    if (res.success) {
                        Leaf.showMessage("提示", res.message || "导入成功", null);
                    } else{
                        Leaf.showErrorMessage("提示", res.message || res.error.message || "导入失败", null);
                    }

                },
            })
            document.getElementById('file').value = null;
        }

        function onSubmitSuccess_hls_price_list_ds(ds) {
            hls_price_list_query();
        }

        function price_list_edit_function(record, name) {
            if (name === 'price_list') {
                if (record.isNew) {
                    return 'hls_price_list_ds_grid_tf';
                }
                return '';
            }
            return '';
        }

        function fnd100_hls_price_prop(value, record, name) {
            if (record.isNew == true) {
                return "";
            } else {
                return '<a href="javascript:winOpen_hls_price_prop(\'' + record.get('price_list') + '\',\'' + record.get('description') + '\');">字段属性</a>';
            }
        }

        function fnd100_hls_price_list_config(value, record, name) {
            if (record.isNew == true) {
                return "";
            } else {
                return '<a href="javascript:winOpen_hls_price_list_config(\'' + record.get('price_list') + '\');">价目表配置</a>';
            }
        }

        function winOpen_hls_price_prop(price_list,description) {
            new Leaf.Window({
                id: 'hls_price_prop_winid',
                url: '${/request/@context_path}/modules/FND/FND_BUS/FND212/hls_field_attribute.lview',
                params: {
                    price_list: price_list,
                    description: description,
                    winId: 'hls_price_prop_winid'
                },
                title: '字段属性',
                fullScreen: true
            });
        }

        function winOpen_hls_price_list_config(price_list) {
            new Leaf.Window({
                id: 'hls_price_list_config_winid',
                url: '${/request/@context_path}/modules/FND/FND_BUS/FND212/hls_fin_calculate_template_iframe.lview?priceList='+price_list,
                // params: {
                //     price_list: price_list,
                //     winid: 'hls_fin_cal_detail_winid'
                // },
                title: '价目表配置',
                fullScreen:true
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="hls_price_list_query_ds">
            </a:dataSet>
            <a:dataSet id="hls_price_list_payment_method_ds" lookupCode="HLS.PRICE_LIST_PAYMENT_TYPE">
            </a:dataSet>
            <a:dataSet id="hls_price_list_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/calcConfig/queryUnSheets"
                       submitUrl="${/request/@context_path}/hls/calcConfig/submit"
                       queryDataSet="hls_price_list_query_ds" selectable="true">
                <a:fields>
                    <a:field name="price_list" required="true"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="payment_type"/>
                    <a:field name="payment_type_n" displayField="code_value_name" options="hls_price_list_payment_method_ds"
                             returnField="payment_type" valueField="code_value"/>
                    <a:field name="adjust_rate_price" autoComplete="true" lovGridHeight="350"
                             lovHeight="500"
                             lovLabelWidth="90"
                             lovService="/hls/calcConfig/adjust/queryLov~com.hand.hls.layout.dto.LovHlsCalcConfigDto"
                             lovWidth="500"
                             title="对应调息报价" prompt="对应调息报价" >
                        <a:mapping>
                            <a:map from="price_list" to="adjust_rate_price"/>
                            <a:map from="description" to="adjust_rate_description"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_hls_price_list_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="hls_price_list_query" text="HAP.QUERY"/>
                <a:gridButton click="hls_price_list_reset" text="HAP.RESET"/>
                <a:gridButton click="hls_price_list_add" text="HAP.NEW"/>
                <a:gridButton click="hls_price_list_save" text="HAP.SAVE"/>
                <a:gridButton click="hls_price_list_export_confirm" text="HLS.EXPORT"/>
                <a:gridButton click="hls_price_list_import" text="HLS.IMPORT"/>
            </a:screenTopToolbar>
            <a:form column="3" labelwidth="100" title="查询条件">
                <a:textField name="price_list" bindTarget="hls_price_list_query_ds" prompt="价目表代码" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="hls_price_list_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="description" bindTarget="hls_price_list_query_ds" prompt="价目表名称" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="hls_price_list_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="hls_price_list_ds_grid" bindTarget="hls_price_list_ds" marginHeight="150" marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column name="price_list" width="270" prompt="价目表代码" editorFunction="price_list_edit_function" align="center"/>
                    <a:column name="description" width="290" prompt="价目表名称" editor="hls_price_list_ds_grid_tf" align="center"/>
                    <a:column name="payment_type_n" width="150" prompt="放款类型" editor="hls_price_list_ds_grid_cb" align="center"/>
                    <a:column width="170" prompt="价目表配置" renderer="fnd100_hls_price_list_config" align="center"/>
                    <a:column width="170" prompt="字段属性" align="center"
                              renderer="fnd100_hls_price_prop"/>
                    <a:column name="enabled_flag" width="80" prompt="启用" editor="hls_price_list_ds_grid_check"/>
                    <a:column name="adjust_rate_price" width="140" prompt="对应调息价目表" editor="hls_price_list_ds_grid_lov"/>
                </a:columns>
                <a:editors>
                    <a:textField id="hls_price_list_ds_grid_tf"/>
                    <a:checkBox id="hls_price_list_ds_grid_check"/>
                    <a:comboBox id="hls_price_list_ds_grid_cb"/>
                    <a:lov      id="hls_price_list_ds_grid_lov"/>
                </a:editors>
            </a:grid>
            <input type="file" name="file" id="file" value="" onChange="hls_upload_file()" style="display:none"/>
        </a:screenBody>
    </a:view>
</a:screen>
