<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-12-27
    $Revision: 1.0
    $Purpose: 评分模板定义-模板行指标明细设置
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function score_template_ln_value_ds_grid_refresh() {
            $("score_template_ln_value_ds").query();
        }

        /*function positive_int_valid(record, name, value) {
            if (/^[A-Z\d]+$/.test(value)) {
                return true
            } else if (!value) {
                return true
            } else {
                return "请输入正整数";
            }
        }

        function positive_num_valid(record, name, value) {
            if (/^([0-9][0-9]*(\.\d{1,2})?)|(0\.\d{1,2})$/.test(value)) {
                return true
            } else if (!value) {
                return true
            } else {
                return "请输入正数";
            }
        }*/

        function score_template_ln_value_ds_grid_render(ds, record, name) {
            if (!record.isNew && name == "next_line") {
                var hdId=record.get("score_template_hd_id");//评分模板id
                var lnId=record.get("score_target_set_id");//评分模板行id
                var targetId=record.get("score_target_id");//评分指标id
                if (record.get("summary_flag") == "Y"){
                    return '<a href="javascript:fnd_score_template_nextLn_winOpen(' +
                        '\'' + hdId + '\'' + ',' +
                        '\'' + lnId + '\'' +
                        ');">设置</a>';
                }else{
                    return '<a href="javascript:fnd_score_template_lastLn_winOpen(' +
                        '\'' + hdId + '\'' + ',' +
                        '\'' + lnId + '\'' + ',' +
                        '\'' + targetId + '\'' +
                        ');">设置</a>';
                }

            }
        }

        ]]></script>
        <a:dataSets>
            <!--评分指标ds-->
            <a:dataSet id="score_target_value_query_ds">
                <a:datas>
                    <a:record score_target_id="${/parameter/@scoreTargetId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="score_target_value_ds"
                       autoQuery="true" queryDataSet="score_target_value_query_ds" queryMethod="POST"
                       queryUrl="${/request/@context_path}/fnd/score/target/values/queryAll">
                <a:fields>
                    <a:field name="score_target_value_id"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
            <!--评分指标模板行ds-->
            <a:dataSet id="score_template_ln_value_query_ds">
                <a:datas>
                    <a:record score_template_ln_id="${/parameter/@parentLnId}"
                              score_target_id="${/parameter/@scoreTargetId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="score_template_ln_value_ds" pageSize="5" fetchAll="false" selectable="true"
                       autoQuery="true" queryDataSet="score_template_ln_value_query_ds" queryMethod="POST"
                       queryUrl="${/request/@context_path}/fnd/score/template/ln/value/query"
                       deleteUrl="${/request/@context_path}/fnd/score/template/ln/value/remove"
                       submitUrl="${/request/@context_path}/fnd/score/template/ln/value/submit">
                <a:fields>
                    <a:field name="score_template_ln_value_id"/>
                    <a:field name="description" options="score_target_value_ds" displayField="description"
                             returnField="score_target_value_id" valueField="score_target_value_id"/>
                    <a:field name="score_template_ln_id" defaultValue="${/parameter/@parentLnId}"/>
                    <a:field name="score_value"/>
                    <a:field name="score_grade"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="score_template_ln_value_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton bind="score_template_ln_value_ds_grid" text="HAP.SAVE" type="save"/>
                <a:gridButton bind="score_template_ln_value_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="score_template_ln_value_ds_grid_refresh" text="HAP.REFRESH"/>
            </a:screenTopToolbar>
            <a:grid id="score_template_ln_value_ds_grid" bindTarget="score_template_ln_value_ds"
                    marginHeight="150"  width="570" navBar="true">
                <a:columns>
                    <a:column name="description" width="180" prompt="指标描述"
                              editor="score_template_ln_value_ds_grid_combo" align="center"/>
                    <a:column name="score_value" width="160" prompt="分值"
                              editor="score_template_ln_value_ds_grid_tf" align="center"/>
                    <a:column name="score_grade" width="180" prompt="等级"
                              editor="score_template_ln_value_ds_grid_tf" align="center"/>
                </a:columns>
                <a:editors>
                    <a:numberField id="score_template_ln_value_ds_grid_nf" allowNegative="false" allowDecimals="false"/>
                    <a:textField id="score_template_ln_value_ds_grid_tf"/>
                    <a:comboBox id="score_template_ln_value_ds_grid_combo"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
