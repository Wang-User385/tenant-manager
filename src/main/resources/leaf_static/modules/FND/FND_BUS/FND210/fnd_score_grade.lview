<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-12-27
    $Revision: 1.0
    $Purpose: 评分模板定义-评分等级设置
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?leafBracketArr=FND.SCORE_TPLT_LEFT_BRACKET&amp;codeYesNo=SYS.YES_NO"
                type="text/javascript"></script>
        <script src="${/request/@context_path}/common/code?rightBracketArr=FND.SCORE_TPLT_RIGHT_BRACKET&amp;codeYesNo=SYS.YES_NO"
                type="text/javascript"></script>


        <script><![CDATA[
        function score_template_hd_value_ds_grid_refresh(){
            $("score_template_hd_value_ds").query();
        }


        $L.onReady(function(){
            leafBracketArr.forEach(function (i) {
                $("left_bracket_ds").create({"left_bracket": i.value});
            });
            rightBracketArr.forEach(function (i) {
                $("right_bracket_ds").create({"right_bracket": i.value});
            });


        });

        function positive_int_valid(record, name, value) {
            if (/^[A-Z\d]+$/.test(value)) {
                return true
            } else if(!value) {
                return true
            }else{
                return "请输入正整数";
            }
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="left_bracket_ds">
                <a:fields>
                    <a:field name="left_bracket"/>
                </a:fields>
            </a:dataSet>


            <a:dataSet id="right_bracket_ds">
                <a:fields>
                    <a:field name="right_bracket"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="score_template_hd_value_query_ds">
                <a:datas>
                    <a:record score_template_hd_id="${/parameter/@scoreTemplateHdId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="score_template_hd_value_ds" autoPageSize="true" fetchAll="false" selectable="true"
                       autoQuery="true" queryDataSet="score_template_hd_value_query_ds" queryMethod="POST"
                       queryUrl="${/request/@context_path}/fnd/score/template/hd/value/query"
                       deleteUrl="${/request/@context_path}/fnd/score/template/hd/value/remove"
                       submitUrl="${/request/@context_path}/fnd/score/template/hd/value/submit">
                <a:fields>
                    <a:field name="score_template_hd_id" defaultValue="${/parameter/@scoreTemplateHdId}"/>
                    <a:field name="score_template_hd_value_id"/>
                    <a:field name="line_number" defaultValue="0" required="true" validator="positive_int_valid"/>
                    <a:field name="left_bracket" options="left_bracket_ds" displayField="left_bracket" valueField="left_bracket"/>
                    <a:field name="from_value" validator="positive_int_valid"/>
                    <a:field name="to_value" validator="positive_int_valid"/>

                    <a:field name="right_bracket" options="right_bracket_ds" displayField="right_bracket" valueField="right_bracket"/>
                    <a:field name="score_grade"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="score_template_hd_value_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton bind="score_template_hd_value_ds_grid" text="HAP.SAVE" type="save"/>
                <a:gridButton bind="score_template_hd_value_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="score_template_hd_value_ds_grid_refresh" text="HAP.REFRESH"/>
            </a:screenTopToolbar>
            <a:grid id="score_template_hd_value_ds_grid"  bindTarget="score_template_hd_value_ds"
                    marginHeight="150" width="815" navBar="true">
                <a:columns>
                    <a:column name="line_number" width="100" prompt="序号" align="center"
                              editor="score_template_hd_value_ds_grid_nf"/>
                    <a:column name="left_bracket" width="100" prompt="左边界" align="center"
                              editor="score_template_hd_value_ds_grid_cb"/>
                    <a:column name="from_value" width="100" prompt="起始值" align="center"
                              editor="score_template_hd_value_ds_grid_nf"/>
                    <a:column name="to_value" width="100" prompt="结束值" align="center"
                              editor="score_template_hd_value_ds_grid_nf"/>
                    <a:column name="right_bracket" width="100" prompt="右边界" align="center"
                              editor="score_template_hd_value_ds_grid_cb"/>
                    <a:column name="score_grade" width="120" prompt="评分等级" align="center"
                              editor="score_template_hd_value_ds_grid_tf"/>
                    <a:column name="description" width="130" prompt="说明" align="center"
                              editor="score_template_hd_value_ds_grid_tf"/>
                </a:columns>
                <a:editors>
                    <a:comboBox id="score_template_hd_value_ds_grid_cb"/>
                    <a:numberField id="score_template_hd_value_ds_grid_nf" allowDecimals="false" allowNegative="false"/>
                    <a:textField id="score_template_hd_value_ds_grid_tf"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
