<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-12-27
    $Revision: 1.0  
    $Purpose: 评分模板定义
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?calcMethodArr=HLS.SCORE_TEMPLATE_CALC_METHOD&amp;codeYesNo=SYS.YES_NO"
                type="text/javascript"></script>
        <script><![CDATA[

        /* calc_method中英文字段 */
        var calcMethodECMap = {};
        calcMethodArr.forEach(function (i) {
            calcMethodECMap[i.value] = i.meaning;
        });
        $L.onReady(function () {
            calcMethodArr.forEach(function (i) {
                $("calc_method_ds").create({"calc_method": i.value, "calc_method_cn": i.meaning});
            });
        });

        function onLoad_fnd_score_template_ds(ds) {
            var records = ds.data;
            records.forEach(function (record) {
                record.data["calc_method_cn"] = calcMethodECMap[record.data["calc_method"]];
            });
        }

        /* 查询 */
        function fnd_score_template_screen_query() {
            $('fnd_score_template_ds').query();
        }

        /* 重置查询条件 */
        function fnd_score_template_screen_reset() {
            $('fnd_score_template_query_ds').reset();
            $('fnd_score_template_ds').query();
        }

        /* 打开窗口： */
        function fnd_score_template_screen_winOpen(name, id) {
            switch (name) {
                case "template_line":
                    new Leaf.Window({
                        id: "score_template_template_line_win",
                        url: "${/request/@context_path}/modules/FND/FND_BUS/FND210/fnd_score_template_line.lview",
                        title: '评分模板行定义',
                        fullScreen: false,
                        params: {
                            scoreTemplateHdId: id,
                            winId: "score_template_template_line_win"
                        },
                        draggable: true,
                        closeable: true,
                        side:'right',
                        width: 850,
                        height: 450
                    });
                    break;
                case "score_grade":
                    new Leaf.Window({
                        id: "score_template_score_grade_win",
                        url: "${/request/@context_path}/modules/FND/FND_BUS/FND210/fnd_score_grade.lview",
                        title: '评分等级设置',
                        fullScreen: false,
                        params: {
                            scoreTemplateHdId: id,
                            winId: "score_template_score_grade_win"
                        },
                        draggable: true,
                        closeable: true,
                        side:'right',
                        width: 850,
                        height: 450
                    });
                    break;
                case "data_source":
                    new Leaf.Window({
                        id: "score_template_data_source_win",
                        url: "${/request/@context_path}/modules/FND/FND_BUS/FND210/fnd_score_template_db_source.lview",
                        title: '数据源',
                        fullScreen: false,
                        params: {
                            scoreTemplateHdId: id,
                            winId: "score_template_data_source_win"
                        },
                        draggable: true,
                        closeable: true,
                        side:'right',
                        width: 850,
                        height: 450
                    });
                    break;
            }
        }

        /* grid渲染 */
        function render_fnd_score_template_ds_grid(value, record, name) {
            var id = record.get('score_template_hd_id');
            if (!record.isNew && !!id && (name == 'template_line' || name == "score_grade" || name == "data_source")) {
                return '<a href="javascript:fnd_score_template_screen_winOpen(' +
                    '\'' + name + '\'' + ',' +
                    '\'' + id + '\'' +
                    ');">编辑</a>';
            }
            return '';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="calc_method_ds">
                <a:fields>
                    <a:field name="calc_method"/>
                    <a:field name="calc_method_cn"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_score_template_type_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/score/template/type/query">
                <a:fields>
                    <a:field name="score_template_type_name"/>
                    <a:field name="score_template_type_id"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_score_template_query_ds">
                <a:fields>
                    <a:field name="score_template_hd_code"/>
                    <a:field name="score_template_hd_name"/>
                    <a:field name="score_template_type_name" options="fnd_score_template_type_ds"
                             displayField="score_template_type_name" valueField="score_template_type_id"
                             returnField="score_template_type_id"/>
                    <a:field name="calc_method_cn" options="calc_method_ds"
                             displayField="calc_method_cn" valueField="calc_method" returnField="calc_method"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_score_template_ds" autoPageSize="true" autoQuery="true"
                       queryDataSet="fnd_score_template_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/fnd/score/template/hd/query"
                       deleteUrl="${/request/@context_path}/fnd/score/template/hd/remove"
                       submitUrl="${/request/@context_path}/fnd/score/template/hd/submit">
                <a:fields>
                    <a:field name="score_template_hd_id"/>
                    <a:field name="score_template_hd_code" required="true"/>
                    <a:field name="score_template_hd_name" required="true"/>
                    <a:field name="score_template_hd_type_id"/>
                    <a:field name="score_template_type_name" required="true" options="fnd_score_template_type_ds"
                             displayField="score_template_type_name" valueField="score_template_type_id"
                             returnField="score_template_type_id"/>
                    <a:field name="calc_method"/>
                    <a:field name="calc_method_cn" required="true" options="calc_method_ds"
                             displayField="calc_method_cn" valueField="calc_method" returnField="calc_method"/>
                    <a:field name="financial_flag" defaultValue="Y" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="enabled_flag" defaultValue="Y" checkedValue="Y" unCheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="onLoad_fnd_score_template_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="fnd_score_template_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton bind="fnd_score_template_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton bind="fnd_score_template_ds_grid" text="HAP.SAVE" type="save"/>
                <a:gridButton click="fnd_score_template_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="fnd_score_template_screen_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="4" title="查询条件" labelwidth="100">
                <a:textField name="score_template_hd_code" bindTarget="fnd_score_template_query_ds" prompt="模板代码"
                             emptyText="模板代码" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_score_template_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="score_template_hd_name" bindTarget="fnd_score_template_query_ds" prompt="模板名称"
                             emptyText="模板名称" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_score_template_screen_query"/>
                    </a:events>
                </a:textField>
                <a:comboBox name="score_template_type_name" bindTarget="fnd_score_template_query_ds" prompt="模板类型"
                            emptyText="模板类型" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_score_template_screen_query"/>
                    </a:events>
                </a:comboBox>
                <a:comboBox name="calc_method_cn" bindTarget="fnd_score_template_query_ds" prompt="计算方式"
                            emptyText="计算方式" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="fnd_score_template_screen_query"/>
                    </a:events>
                </a:comboBox>
            </a:form>
            <a:grid id="fnd_score_template_ds_grid" bindTarget="fnd_score_template_ds" marginHeight="150" marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column width="200" name="score_template_hd_code" editor="fnd_score_template_ds_grid_tf"
                              prompt="模板代码" align="center"/>
                    <a:column width="250" name="score_template_hd_name" editor="fnd_score_template_ds_grid_tf"
                              prompt="模板名称" align="center"/>
                    <a:column width="200" name="score_template_type_name" editor="fnd_score_template_ds_grid_combo"
                              prompt="模板类型" align="center"/>
                    <a:column width="200" name="calc_method_cn" editor="fnd_score_template_ds_grid_combo" prompt="计算方式"
                              align="center"/>
                    <a:column width="100" name="template_line" renderer="render_fnd_score_template_ds_grid" prompt="模板行"
                              align="center"/>
                    <a:column width="100" name="score_grade" renderer="render_fnd_score_template_ds_grid" prompt="评分等级"
                              align="center"/>
                    <a:column width="100" name="data_source" renderer="render_fnd_score_template_ds_grid" prompt="数据源"
                              align="center"/>
                    <a:column width="100" name="financial_flag" editor="fnd_score_template_ds_grid_check" prompt="有财报"
                              align="center"/>
                    <a:column width="100" name="enabled_flag" editor="fnd_score_template_ds_grid_check" prompt="启用"
                              align="center"/>
                </a:columns>
                <a:editors>
                    <a:textField id="fnd_score_template_ds_grid_tf"/>
                    <a:checkBox id="fnd_score_template_ds_grid_check"/>
                    <a:comboBox id="fnd_score_template_ds_grid_combo"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
