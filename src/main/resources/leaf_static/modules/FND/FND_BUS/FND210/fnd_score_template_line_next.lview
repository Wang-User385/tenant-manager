<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-12-27
    $Revision: 1.0
    $Purpose: 评分模板定义-下级模板行定义
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_refresh() {
            $("score_template_ln_ds_${/parameter/@nextLineWinNum}").query();
        }
        function onSubmitSuccess_score_template_ln_ds_${/parameter/@nextLineWinNum}() {
            $("score_template_ln_ds_${/parameter/@nextLineWinNum}").query();
        }

        function score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_render(ds, record, name) {
            if (!record.isNew && name == "next_line") {
                var hdId=record.get("score_template_hd_id");//评分模板id
                var lnId=record.get("score_template_ln_id");//评分模板行id
                var targetId=record.get("score_target_id");//评分指标id
                if (record.get("summary_flag") == "Y"){
                    return '<a href="javascript:fnd_score_template_nextLn_winOpen_${/parameter/@nextLineWinNum}(' +
                        '\'' + hdId + '\'' + ',' +
                        '\'' + lnId + '\'' +
                        ');">设置</a>';
                }else{
                    return '<a href="javascript:fnd_score_template_lastLn_winOpen_${/parameter/@nextLineWinNum}(' +
                        '\'' + hdId + '\'' + ',' +
                        '\'' + lnId + '\'' + ',' +
                        '\'' + targetId + '\'' +
                        ');">设置</a>';
                }

            }
        }

        /* 打开窗口 下级指标设置 */
        function fnd_score_template_nextLn_winOpen_${/parameter/@nextLineWinNum}(hdId,lnId) {
            new Leaf.Window({
                id: "fnd_score_template_nextLn_win"+nextLineWinNum++,
                url: "${/request/@context_path}/modules/FND/FND_BUS/FND210/fnd_score_template_line_next.lview",
                title: '评分模板行定义',
                fullScreen: false,
                params: {
                    scoreTemplateHdId: hdId,
                    parentLnId: lnId,
                    winId: "fnd_score_template_nextLn_win"+nextLineWinNum,
                    nextLineWinNum:nextLineWinNum
                },
                draggable: true,
                closeable: true,
                side:'right',
                width: 850,
                height: 450
            });
        }
        /* 打开窗口 指标明细设置 */
        function fnd_score_template_lastLn_winOpen_${/parameter/@nextLineWinNum}(hdId,lnId,targetId) {
            new Leaf.Window({
                id: "fnd_score_template_lastLn_win",
                url: "${/request/@context_path}/modules/FND/FND_BUS/FND210/fnd_score_template_line_target.lview",
                title: '指标明细设置',
                fullScreen: false,
                params: {
                    scoreTemplateHdId: hdId,
                    parentLnId: lnId,
                    scoreTargetId: targetId,
                    winId: "fnd_score_template_lastLn_win"
                },
                draggable: true,
                closeable: true,
                side:'right',
                width: 600,
                height: 400
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="score_template_line_next_hd_column_ds_${/parameter/@nextLineWinNum}"
                       queryMethod="POST" autoQuery="true" queryDataSet="score_template_hd_id_ds"
                       queryUrl="${/request/@context_path}/fnd/hd/column/ds">
                <a:fields>
                    <a:field name="data_source_column_id"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="score_template_hd_id_ds_${/parameter/@nextLineWinNum}">
                <a:datas>
                    <a:record parent_ln_id="${/parameter/@parentLnId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="score_template_ln_ds_${/parameter/@nextLineWinNum}" autoPageSize="true" fetchAll="false" selectable="true"
                       autoQuery="true" queryDataSet="score_template_hd_id_ds_${/parameter/@nextLineWinNum}" queryMethod="POST"
                       queryUrl="${/request/@context_path}/fnd/score/template/ln/query"
                       deleteUrl="${/request/@context_path}/fnd/score/template/ln/remove"
                       submitUrl="${/request/@context_path}/fnd/score/template/ln/submit">
                <a:fields>
                    <a:field name="score_template_hd_id" defaultValue="${/parameter/@scoreTemplateHdId}"/>
                    <a:field name="score_template_ln_id" />
                    <a:field name="parent_ln_id" defaultValue="${/parameter/@parentLnId}"/>
                    <a:field name="line_seq" validator="positive_int_valid"/>
                    <a:field name="summary_flag" defaultValue="Y" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="description"/>
                    <a:field name="score_target_id" />
                    <a:field name="score_target_name"/>
                    <a:field name="score_target_code" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovLabelWidth="100"
                             lovService="/hls/score/target/query~hls.layout.dto.LovFndScoreTargetDto"
                             lovWidth="600" title="选择评分指标" editable="false" fetchRemote="false">
                        <a:mapping>
                            <a:map from="score_target_code" to="score_target_code"/>
                            <a:map from="score_target_id" to="score_target_id"/>
                            <a:map from="score_target_name" to="score_target_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="data_source_column_id"/>
                    <a:field name="column_name" options="score_template_line_next_hd_column_ds_${/parameter/@nextLineWinNum}" displayField="description"
                             returnField="data_source_column_id" valueField="data_source_column_id"/>
                    <a:field name="weight_value" validator="positive_num_valid"/>
                    <a:field name="enabled_flag" defaultValue="Y" checkedValue="Y" unCheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_score_template_ln_ds_${/parameter/@nextLineWinNum}"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid" type="add"/>
                <a:gridButton bind="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid" type="save"/>
                <a:gridButton bind="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid" type="delete"/>
                <a:gridButton click="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_refresh" text="HAP.REFRESH"/>
            </a:screenTopToolbar>
            <a:grid id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid"
                    bindTarget="score_template_ln_ds_${/parameter/@nextLineWinNum}"
                    marginHeight="150"  width="815" navBar="true">
                <a:columns>
                    <a:column name="line_seq" width="60" prompt="序号"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_nf2" align="center"/>
                    <a:column name="summary_flag" width="50" prompt="是否汇总"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_cb" align="center"/>
                    <a:column name="description" width="130" prompt="汇总描述"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_tf"/>
                    <a:column name="score_target_code" width="100" prompt="指标代码"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_lov"/>
                    <a:column name="score_target_name" width="100" prompt="指标名称"/>
                    <a:column name="column_name" width="100" prompt="数据源"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_combo"/>
                    <a:column name="weight_value" width="80" prompt="权重"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_nf" align="center"/>
                    <a:column name="next_line" width="80" prompt="下级指标"
                              renderer="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_render" align="center"/>
                    <a:column name="enabled_flag" width="60" prompt="启用"
                              editor="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_cb" align="center"/>
                </a:columns>
                <a:editors>
                    <a:checkBox id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_cb"/>
                    <a:numberField id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_nf" allowNegative="false" allowDecimals="true"/>
                    <a:numberField id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_nf2" allowNegative="false" allowDecimals="false"/>
                    <a:textField id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_tf"/>
                    <a:lov id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_lov"/>
                    <a:comboBox id="score_template_ln_ds_${/parameter/@nextLineWinNum}_grid_combo"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
