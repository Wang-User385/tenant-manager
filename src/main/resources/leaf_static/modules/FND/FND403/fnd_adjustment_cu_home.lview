<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="fnd_430_cu_id"
                url="${/request/@context_path}/modules/FND/FND403/fnd_adjustment_cu_detail.lview"/>
        <script><![CDATA[
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'detail' && !record.isNew) {
                return '<a href="javascript:open_fp_year_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '通用调整明细' + '</a>';
            }
        }

        function open_fp_year_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '通用调整明细';
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['winid'] = 'fnd403_detail_winid';
            var link_url;
            link_url = 'fnd_430_cu_id';
            param['function_code'] = 'FND403F1';
            hls_doc_get_layout_code(param, link_url, ds_id, 'FP403');
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
