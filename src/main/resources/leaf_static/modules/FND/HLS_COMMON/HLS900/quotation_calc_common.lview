        //excel计算
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            debugger;
            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=${/parameter/@quotationId}&priceList=${/parameter/@priceList}';

            var excelEdit = '${/parameter/@excel_edit}';

            if (excelEdit != 'Y') {
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    url = url + '&readOnly=Y';
                }
            }
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var win = new Leaf.Window({
                    id: 'hls900_open_price_winid',
                    url: url,
                    title: 'excel测算',
                    fullScreen: true
                });
                win.on('close', function () {
                    $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                });
            }, 'N');
        }

