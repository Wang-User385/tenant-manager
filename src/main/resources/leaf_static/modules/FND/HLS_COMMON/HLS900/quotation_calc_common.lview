        window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'] = function (func, calcFlag) {
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            //debugger;
            if(!$('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').validate()){
                Leaf.Masker.unmask(Ext.getBody());
                return false;
            };
            var pq_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_FORM');
            var pq_record = $(pq_ds_id).getCurrentRecord();
            if ('${/parameter/@loan_initial_lease}' == 'Y') {
                if (pq_record.get('first_release_date') - pq_record.get('lease_start_date') != 0) {
                    Leaf.Masker.unmask(Ext.getBody());
                    $L.showInfoMessage("提示", "当选择放款即起租时，首次放款日与起租日必须相等!");
                    return;
                }
            }
            if ('${/parameter/@loan_initial_lease}' == 'N') {
                if (pq_record.get('first_release_date') - pq_record.get('lease_start_date') == 0) {
                    Leaf.Masker.unmask(Ext.getBody());
                    $L.showInfoMessage("提示", "当放款即起租为否时，首次放款日与起租日必须不相等!");
                    return;
                }
            }
            var param = {};
            var data = $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').getJsonData();
            if (data.length == 1) {
                param = data[0];
            }

            if (calcFlag == 'N') {
                param['calc_flag'] = 'N';
            }

            Leaf.request({
                url: $('hls900_quotation_info_save_link_id').getUrl(),
                type: "POST",
                para: param,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                    $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                    Leaf.Masker.unmask(Ext.getBody());
                    if (typeof func == 'function') {
                        func();
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var quotation_record = $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').getCurrentRecord();
            if (ds.id == '${/parameter/@layout_code}_G_EXPENSE_prj_quotation_cashflow_ds') {
                record.set('tax_type_rate', quotation_record.get('vat_rate'));
            }

            if (ds.id == '${/parameter/@layout_code}_G_PAYNOTE_prj_quotation_cashflow_ds') {
                var paymentDs = $('${/parameter/@layout_code}_G_PAYMENT_prj_quotation_cashflow_ds').getAll();
                if (paymentDs.length > 0) {
                    record.set('due_date', paymentDs[0].get('due_date'));
                    record.set('due_amount', paymentDs[0].get('base_amount'));
                }
            }

            if (ds.id == '${/parameter/@layout_code}_G_PAYMENT_prj_quotation_cashflow_ds') {
                record.set('paynote_amount', 0);
            }

            if (ds.id == '${/parameter/@layout_code}_G_EXPENSE_prj_quotation_cashflow_ds') {
                record.set('amortization_method', 'COST_PROPORTION');
                record.set('amortization_method_n', '利息占比法');
            }
        };


        Leaf.onReady(function () {
            if ('${/parameter/@quotation_flag}' == 'CONTRACT') {
                $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').setAllFieldsReadOnly(true);

                if ($('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').getCurrentRecord()) {
                    $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').getCurrentRecord().getField("first_release_date").setReadOnly(false);
                }
                $jq("#${/parameter/@layout_code}_G_PAYMENT_prj_quotation_cashflow_layout_grid_id_tb").find("table").remove();
            }

        });
        ]]></script>

    </a:view>
</a:screen>