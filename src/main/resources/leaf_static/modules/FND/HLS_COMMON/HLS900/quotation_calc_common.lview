<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
    $Revision: 1.0
    $Purpose: 报价输入的通用页面，
    功能号 HLS900,布局代码 CALC_QUOTATUON
    接收quotation_id,price_list
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true" dynamiccreateenabled="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="hls900_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="hls900_quotation_base_rate_query_link_id" url="${/request/@context_path}/prj/quotation/query/base/rate"/>
        <a:link id="hls900_quotation_fee_save_link_id" url="${/request/@context_path}/prj/quotation/deposit/fee/save"/>

        <a:link id="hls900_quotation_paynote_save_link_id" url="${/request/@context_path}/prj/quotation/paynote/fee/save"/>

        <a:link id="hls900_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
    <script><![CDATA[


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            if (ds.id == '${/parameter/@layout_code}_F_FORM_prj_quotation_ds') {
                if ('${/parameter/@new_flag}' == 'Y') {
                    record.set('source_quotation_id', '${/parameter/@quotation_id}');
                }

                if (record.get('currency') == null) {
                    record.set('currency', 'CNY');
                    record.set('currency_n', '人民币');
                }

                if (record.get('exchange_rate') == null) {
                    record.set('exchange_rate', 1);
                }

                if (record.get('renting_frequency') == null) {
                    record.set('renting_frequency', 3);
                    record.set('renting_frequency_n', '季付');
                }

                if (record.get('pre_lease_flag') == null) {
                    record.set('pre_lease_flag', 'N');
                    record.set('pre_lease_flag_n', '否');
                }

                if (record.get('pre_lease_term') == null) {
                    record.set('pre_lease_term', 0);
                }

                if (record.get('grace_flag') == null) {
                    record.set('grace_flag', 'N');
                    record.set('grace_flag_n', '否');
                }

                if (record.get('grace_lease_term') == null) {
                    record.set('grace_lease_term', 0);
                }

                if (record.get('calc_date_type') == null) {
                    record.set('calc_date_type', 'NAME_DAY');
                    record.set('calc_date_type_n', '指定日');
                }

                if (record.get('rental_pay_date') == null) {
                    record.set('rental_pay_date', 20);
                }

                if (record.get('pay_type') == null) {
                    record.set('pay_type', 0);
                    record.set('pay_type_n', '后付');

                }

                if (record.get('int_rate_type') == null) {
                    record.set('int_rate_type', 'FLOATING');
                    record.set('int_rate_type_n', '浮动利率');
                }

                if (record.get('float_type') == null) {
                    record.set('float_type', 'BP');
                }

                /*if (record.get('lpr_ref_day') == null) {
                    record.set('lpr_ref_day', 'NAME_DAY');
                    record.set('lpr_ref_day_n', '指定日');
                }*/

                /*if(record.get('base_rate_type') == null){
                    record.set('base_rate_type','LPR五年期');
                    record.set('base_rate_type_n','LPR五年期');
                }*/

                if (record.get('vatable_rate_flag') == null) {
                    record.set('vatable_rate_flag', 'Y');
                    record.set('vatable_rate_flag_n', '是');
                }

                if (record.get('vatable_prin_flag') == null) {
                    record.set('vatable_prin_flag', 'Y');
                    record.set('vatable_prin_flag_n', '是');
                }

                if (record.get('lpr_base_date') == null) {
                    record.set('lpr_base_date', 'RELEASE_DAY');
                    record.set('lpr_base_date_n', '放款日');
                }

                if (record.get('asset_mgt_fee_type') == null) {
                    record.set('asset_mgt_fee_type', 'INT');
                    record.set('asset_mgt_fee_type_n', '利息类');
                }

                if (record.get('business_type') == null) {
                    record.set('business_type', 'LEASEBACK');
                    record.set('business_type_n', '一般融资租赁-回租');
                }

                if (record.get('tax_structure') == null) {
                    record.set('tax_structure', 'M_LB_6');
                    record.set('tax_structure_n', '动产回租');
                }


                if (record.get('lpr_adjustment_term') == null) {
                    record.set('lpr_adjustment_term', 12);
                }

                if (record.get('lpr_adjustment_period') == null) {
                    record.set('lpr_adjustment_period', 'NEXT_PERIOD');
                    record.set('lpr_adjustment_period_n', '次期');
                }

                if (record.get('residual_value') == null) {
                    record.set('residual_value', 0);
                }

                if (record.get('floating_way_rate') == null) {
                    record.set('floating_way_rate', 0);
                }

                //固定利率设置只读非必填
                if (record.get('int_rate_type') == 'FIXED') {
                    record.set('base_rate', '');
                    record.set('base_rate_type', '');
                    record.set('base_rate_type_n', '');
                    record.set('floating_way_rate', '');
                    record.getField('base_rate').setReadOnly(true);
                    record.getField('base_rate').setRequired(false);
                    record.getField('base_rate_type').setReadOnly(true);
                    record.getField('base_rate_type').setRequired(false);
                    record.getField('base_rate_type_n').setReadOnly(true);
                    record.getField('base_rate_type_n').setRequired(false);
                    record.getField('floating_way_rate').setReadOnly(true);
                    record.getField('floating_way_rate').setRequired(false);
                } else {
                    record.getField('base_rate').setReadOnly(false);
                    record.getField('base_rate').setRequired(true);
                    record.getField('base_rate_type').setReadOnly(false);
                    record.getField('base_rate_type').setRequired(true);
                    record.getField('base_rate_type_n').setReadOnly(false);
                    record.getField('base_rate_type_n').setRequired(true);
                    record.getField('floating_way_rate').setReadOnly(false);
                    record.getField('floating_way_rate').setRequired(true);
                }

                if ('${/parameter/@quotation_flag}' == 'CONTRACT' && '${/parameter/@function_usage}' != 'QUERY') {
                    record.getField("first_release_date").setReadOnly(false);
                }
            }
        };


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {

            var quotation_record = $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').getCurrentRecord();

            if (ds.id === '${/parameter/@layout_code}_F_FORM_prj_quotation_ds') {
                switch (name) {
                    case "first_release_date":
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_lease_start_date_update'](record, value, record.get('pre_lease_term'));
                        var lprRefDay = record.get('lpr_ref_day');
                        var baseRateType = record.get('base_rate_type');
                        var leaseStartDate = record.get('lease_start_date');
                        var lprNameDate = record.get('lpr_name_date');
                        window['${/parameter/@layout_code}_base_rate_update'](record, lprRefDay, baseRateType, value, leaseStartDate, lprNameDate);
                        break;
                    case "lease_term":
                        window['${/parameter/@layout_code}_lease_times_update'](record, value, record.get('pre_lease_term'), record.get('renting_frequency'));
                        window['${/parameter/@layout_code}_lease_end_date_update'](record, record.get('lease_start_date'), value);
                        break;
                    case "renting_frequency":
                        window['${/parameter/@layout_code}_lease_times_update'](record, record.get('lease_term'), record.get('pre_lease_term'), value);
                        break;
                    case "pre_lease_term":
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_lease_start_date_update'](record, record.get('first_release_date'), value);

                        window['${/parameter/@layout_code}_lease_times_update'](record, record.get('lease_term'), value, record.get('renting_frequency'));

                        break;
                    case "lpr_ref_day":
                        var firstReleaseDate = record.get('lease_start_date');
                        var baseRateType = record.get('base_rate_type');
                        var leaseStartDate = record.get('lease_start_date');
                        var lprNameDate = record.get('lpr_name_date');
                        var lprRefDay = record.get('lpr_ref_day');
                        if (value != 'NAME_DAY') {
                            record.set('lpr_name_date', null);
                            record.set('base_rate', null);
                            record.getField('lpr_name_date').setRequired(false);
                            record.getField("lpr_name_date").setReadOnly(true);
                        } else {
                            record.getField("lpr_name_date").setReadOnly(false);
                            record.getField('lpr_name_date').setRequired(true);
                        }
                        window['${/parameter/@layout_code}_base_rate_update'](record, value, baseRateType, firstReleaseDate, leaseStartDate, lprNameDate);
                        break;
                    case "base_rate_type":
                        var firstReleaseDate = record.get('lease_start_date');
                        var baseRateType = record.get('base_rate_type');
                        var leaseStartDate = record.get('lease_start_date');
                        var lprNameDate = record.get('lpr_name_date');
                        var lprRefDay = record.get('lpr_ref_day');
                        window['${/parameter/@layout_code}_base_rate_update'](record, lprRefDay, value, firstReleaseDate, leaseStartDate, lprNameDate);
                        break;
                    case "lease_start_date":
                        var firstReleaseDate = record.get('lease_start_date');
                        var baseRateType = record.get('base_rate_type');
                        var leaseStartDate = record.get('lease_start_date');
                        var lprNameDate = record.get('lpr_name_date');
                        var lprRefDay = record.get('lpr_ref_day');
                        window['${/parameter/@layout_code}_base_rate_update'](record, lprRefDay, baseRateType, firstReleaseDate, value, lprNameDate);

                        window['${/parameter/@layout_code}_lease_end_date_update'](record, value, record.get('lease_term'));
                        break;
                    case "lpr_name_date":
                        var firstReleaseDate = record.get('lease_start_date');
                        var baseRateType = record.get('base_rate_type');
                        var leaseStartDate = record.get('lease_start_date');
                        var lprNameDate = record.get('lpr_name_date');
                        var lprRefDay = record.get('lpr_ref_day');
                        window['${/parameter/@layout_code}_base_rate_update'](record, lprRefDay, baseRateType, firstReleaseDate, leaseStartDate, value);
                        break;
                    case "lpr_base_date":
                        if (value != 'NAME_DAY') {
                            record.set('lpr_fixed_date', null);
                            record.getField("lpr_fixed_date").setRequired(false);
                            record.getField("lpr_fixed_date").setReadOnly(true);
                        } else {
                            record.getField("lpr_fixed_date").setReadOnly(false);
                            record.getField("lpr_fixed_date").setRequired(true);
                        }
                        break;
                    case "base_rate":

                        var floating_way_rate = record.get('floating_way_rate');
                        window['${/parameter/@layout_code}_int_rate_update'](record, value, floating_way_rate);
                        break;

                    case "floating_way_rate":

                        var base_rate = record.get('base_rate');
                        window['${/parameter/@layout_code}_int_rate_update'](record, base_rate, value);
                        break;
                    case "int_rate_type":

                        if (value == 'FIXED') {
                            record.set('base_rate', '');
                            record.set('base_rate_type', '');
                            record.set('base_rate_type_n', '');
                            record.set('floating_way_rate', '');
                            record.getField('base_rate').setReadOnly(true);
                            record.getField('base_rate').setRequired(false);
                            record.getField('base_rate_type').setReadOnly(true);
                            record.getField('base_rate_type').setRequired(false);
                            record.getField('base_rate_type_n').setReadOnly(true);
                            record.getField('base_rate_type_n').setRequired(false);
                            record.getField('floating_way_rate').setReadOnly(true);
                            record.getField('floating_way_rate').setRequired(false);
                        } else {
                            record.getField('base_rate').setReadOnly(false);
                            record.getField('base_rate').setRequired(true);
                            record.getField('base_rate_type').setReadOnly(false);
                            record.getField('base_rate_type').setRequired(true);
                            record.getField('base_rate_type_n').setReadOnly(false);
                            record.getField('base_rate_type_n').setRequired(true);
                            record.getField('floating_way_rate').setReadOnly(false);
                            record.getField('floating_way_rate').setRequired(true);
                        }

                        break;

                    case "tax_structure":

                        //动产直租
                        if (value == 'M_LEASE_13') {
                            record.set('vat_rate', 0.13);
                        }

                        //动产回租
                        if (value == 'M_LB_6') {
                            record.set('vat_rate', 0.06);
                        }

                        //动产回租（旧）
                        if (value == 'M_LB_13') {
                            record.set('vat_rate', 0.13);
                        }

                        //不动产直租
                        if (value == 'R_LEASE_9') {
                            record.set('vat_rate', 0.09);
                        }

                        //不动产回租
                        if (value == 'R_LB_6') {
                            record.set('vat_rate', 0.06);
                        }
                        break;

                    case "lease_item_amount":
                        if (record.get('down_payment') == null) {
                            record.set('finance_amount', minus(value, 0));
                        } else {
                            record.set('finance_amount', minus(value, record.get('down_payment')));
                        }

                        break;
                    case "down_payment":
                        if (record.get('lease_item_amount') == null) {
                            record.set('finance_amount', minus(value, 0));
                        } else {
                            record.set('finance_amount', minus(record.get('lease_item_amount'), value));
                        }
                        break;
                    case "business_type":
                        record.set('tax_structure', null);
                        record.set('tax_structure_n', null);
                        break;
                    case "price_list":
                        if (value == 'General_Calculator_FreePrin') {
                            $L.showInfoMessage("提示", "由于报价方案是<b>【自定义本金】</b> , 请点击 <b>【excel计算】</b> 按钮完成报价录制！");
                            record.getField("rental_plan").setRequired(true);
                        } else if (value == 'General_Calculator_FreeRental') {
                            $L.showInfoMessage("提示", "由于报价方案是<b>【自定义租金】</b> , 请点击 <b>【excel计算】</b> 按钮完成报价录制！");
                            record.getField("rental_plan").setRequired(true);
                        } else {
                            record.getField("rental_plan").setRequired(false);
                        }
                        break;
                }
            }

            if (ds.id == '${/parameter/@layout_code}_G_DEPOSIT_prj_quotation_cashflow_ds') {

                if (name == 'calc_base_amount') {
                    window['${/parameter/@layout_code}_due_amount_update'](record, value, record.get('calc_ratio'));
                }

                if (name == 'calc_ratio') {
                    window['${/parameter/@layout_code}_due_amount_update'](record, record.get('calc_base_amount'), value);

                }

                if (name == 'due_amount') {
                    if (record.get('calc_base_amount') != null) {
                        record.set('calc_ratio', div(value, record.get('calc_base_amount')));
                    }
                }

                if (name == 'calc_base') {

                    if (value == 'RELEASE') {
                        record.set('calc_base_amount', quotation_record.get('finance_amount'));
                    } else {
                        record.set('calc_base_amount', 0);
                    }

                    if (value == 'RELEASE' && record.get('receipt_type') == 'INDIRECT') {
                        window['${/parameter/@layout_code}_due_date_update'](record, true, quotation_record.get('first_release_date'));
                    } else {
                        window['${/parameter/@layout_code}_due_date_update'](record, false);
                    }

                }
                if (name == 'payment_date_type') {

                    if (value == 'PAYMENT_DAY') {
                        window['${/parameter/@layout_code}_due_date_update'](record, true, quotation_record.get('first_release_date'));
                    } else {
                        window['${/parameter/@layout_code}_due_date_update'](record, false);
                    }
                }

                if (name == 'receipt_type') {
                    if (record.get('payment_date_type') != 'PAYMENT_DAY') {
                        if (value == 'INDIRECT' && record.get('calc_base') == 'RELEASE') {
                            window['${/parameter/@layout_code}_due_date_update'](record, true, quotation_record.get('first_release_date'));
                        } else {
                            window['${/parameter/@layout_code}_due_date_update'](record, false);
                        }
                    }
                }

            }
            /*if(ds.id == '${/parameter/@layout_code}_G_EXPENSE_prj_quotation_cashflow_ds'){
                if(name == 'calc_base_amount'){
                    window['${/parameter/@layout_code}_due_amount_update'](record,value,record.get('calc_ratio'));
                }

                if(name == 'calc_ratio'){
                    window['${/parameter/@layout_code}_due_amount_update'](record,record.get('calc_base_amount'),value);

                }
                if(name == 'due_amount'){
                    if(record.get('calc_base_amount') != null && record.get('calc_base_amount') != 0){
                        record.set('calc_ratio',div(value,record.get('calc_base_amount')));
                    }else if(record.get('calc_ratio') != null && record.get('calc_ratio') != 0){
                        record.set('calc_base_amount',div(value,record.get('calc_ratio')));
                    }
                }
                if(name == 'calc_base'){

                    if(value == 'RELEASE'){
                        record.set('calc_base_amount',quotation_record.get('finance_amount'));
                    }else{
                        record.set('calc_base_amount',0);
                    }

                    if(value == 'RELEASE' && record.get('receipt_type') == 'INDIRECT'){
                        window['${/parameter/@layout_code}_due_date_update'](record,true,quotation_record.get('first_release_date'));
                    }else{
                        window['${/parameter/@layout_code}_due_date_update'](record,false);
                    }

                }

                if(name == 'payment_date_type'){

                    if(value == 'PAYMENT_DAY'){
                        window['${/parameter/@layout_code}_due_date_update'](record,true,quotation_record.get('first_release_date'));
                    }else{
                        window['${/parameter/@layout_code}_due_date_update'](record,false);
                    }
                }

                if(name == 'receipt_type'){
                    if(value == 'INDIRECT' && record.get('calc_base') == 'RELEASE'){
                        window['${/parameter/@layout_code}_due_date_update'](record,true,quotation_record.get('first_release_date'));
                    }else{
                        window['${/parameter/@layout_code}_due_date_update'](record,false);
                    }
                }

                if(name == 'cf_item'){
                    if(value == 66){

                        record.set('tax_type_rate',0.06);

                    }else{
                        record.set('tax_type_rate',quotation_record.get('vat_rate'));
                    }
                }

            }

            if(ds.id == '${/parameter/@layout_code}_G_PAYNOTE_prj_quotation_cashflow_ds'){

                if(name == 'due_amount'){
                    if(record.get('paynote_rate') != null){
                        record.set('paynote_amount',mul(value,record.get('paynote_rate')));
                    }
                    if(record.get('paynote_charge_rate') != null){
                        record.set('paynote_charge_fee',mul(value,record.get('paynote_charge_rate')));
                    }
                }

                if(name == 'paynote_rate'){
                    if(record.get('due_amount') != null){
                        record.set('paynote_amount', mul(record.get('due_amount'),value));
                    }
                }

                if(name == 'paynote_amount'){
                    if(record.get('paynote_charge_rate') != null){
                        record.set('paynote_charge_fee', mul(record.get('paynote_charge_rate'),value));
                    }
                    if(record.get('due_amount') != null){
                        record.set('paynote_rate',div(value,record.get('due_amount')));
                    }
                }

                if(name == 'paynote_charge_fee'){
                    if(record.get('paynote_amount') != null){
                        record.set('paynote_charge_rate',div(value,record.get('paynote_amount')));
                    }
                }

                if(name == 'paynote_charge_rate'){
                    if(record.get('paynote_amount') != null){
                        record.set('paynote_charge_fee', mul(record.get('paynote_amount'),value));
                    }
                }

                if(name == 'paynote_term'){
                    if(record.get('due_date') != null){
                        var dueDate = new Date(record.get('due_date'));
                        var accepted_date = new Date(dueDate.setDate(dueDate.getDate() + record.get('paynote_term')));
                        record.set('accepted_date',accepted_date);
                    }
                }

                if(name == 'due_date'){
                    if(record.get('paynote_term') != null){
                        var dueDate = new Date(value);
                        var accepted_date = new Date(dueDate.setDate(dueDate.getDate() + record.get('paynote_term')));
                        record.set('accepted_date',accepted_date);
                    }
                }
            }
    */
            if (ds.id == '${/parameter/@layout_code}_G_PAYMENT_prj_quotation_cashflow_ds') {

                if (name == 'base_amount') {
                    record.set('due_amount', minus(value, record.get('paynote_amount')));
                }

            }

        };

        window['${/parameter/@layout_code}_lease_times_update'] = function (record, lease_term, pre_lease_term, renting_frequency) {

            if (lease_term != null && pre_lease_term != null && renting_frequency != null) {
                record.set('lease_times', div(plus(lease_term, pre_lease_term), parseInt(renting_frequency)));
            }

        }

        window['${/parameter/@layout_code}_due_date_update'] = function (record, readFlag, value) {

            if (readFlag == true) {
                record.getField("due_date").setReadOnly(true);
                record.set('due_date', value);
            } else {
                record.getField("due_date").setReadOnly(false);
                record.set('due_date', null);
            }

        };

        window['${/parameter/@layout_code}_int_rate_update'] = function (record, base_rate, floating_way_rate) {
            if (base_rate != null && floating_way_rate != null) {
                record.set('int_rate', plus(base_rate, div(floating_way_rate, 10000)));
            }
        };

        window['${/parameter/@layout_code}_due_amount_update'] = function (record, calc_base_amount, calc_ratio) {

            if (calc_base_amount != null && calc_ratio != null) {
                record.set('due_amount', mul(calc_base_amount, calc_ratio));
            }

        };

        window['${/parameter/@layout_code}_base_rate_update'] = function (record, lprRefDay, baseRateType, firstReleaseDate, leaseStartDate, lprNameDate) {

            //当利率日期参考系，基准利率标准不为空的时候才能确定基准利率
            if (lprRefDay != null && baseRateType != null) {

                //放款日，取firstReleaseDate
                if (lprRefDay == 'RELEASE_DAY') {

                    if (firstReleaseDate != null) {
                        window['${/parameter/@layout_code}_base_rate_query'](record, baseRateType, firstReleaseDate);
                    }

                }

                //起租日，leaseStartDate
                if (lprRefDay == 'LEASE_DAY') {

                    if (leaseStartDate != null) {
                        window['${/parameter/@layout_code}_base_rate_query'](record, baseRateType, leaseStartDate);
                    }
                }

                //指定日，lprNameDate
                if (lprRefDay == 'NAME_DAY') {

                    if (lprNameDate != null) {
                        window['${/parameter/@layout_code}_base_rate_query'](record, baseRateType, lprNameDate);
                    } else {
                        record.set('base_rate', null);
                    }
                }
            }

        };

        window['${/parameter/@layout_code}_base_rate_query'] = function (record, baseRateType, dateValue) {
            Leaf.Masker.mask(Ext.getBody(), '正在查询基准利率...');

            var param = {
                lpr_date: dateValue,
                description: baseRateType
            };

            Leaf.request({
                url: $("hls900_quotation_base_rate_query_link_id").getUrl(),
                para: param,
                success: function (res) {
                    record.set("base_rate", res.result.record[0].base_rate);
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        };

        window['${/parameter/@layout_code}_lease_start_date_update'] = function (record, firstReleaseDate, preLeaseTerm) {

            if (firstReleaseDate != null && firstReleaseDate != '') {

                if (preLeaseTerm == null || preLeaseTerm == '') {
                    record.set('lease_start_date', firstReleaseDate);
                } else {
                    var firstDate = new Date(firstReleaseDate);
                    var lease_start_date = new Date(firstDate.setMonth(firstReleaseDate.getMonth() + preLeaseTerm));
                    record.set('lease_start_date', lease_start_date);
                }

            }
        };

        window['${/parameter/@layout_code}_lease_end_date_update'] = function (record, lease_start_date, lease_term) {

            if (lease_start_date != null && lease_start_date != '') {

                if (lease_term == null || lease_term == '') {
                    record.set('lease_end_date', lease_start_date);
                } else {
                    var firstDate = new Date(lease_start_date);
                    var lease_start_date = new Date(firstDate.setMonth(lease_start_date.getMonth() + lease_term));
                    record.set('lease_end_date', lease_start_date);
                }

            }
        };

