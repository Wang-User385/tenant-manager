    $Purpose: 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="hls031_doc_layout_button_add_link"
                url="${/request/@context_path}/modules/FND/FND_MODEL/FND114/hls_doc_layout_button_add.lview"/>
        <a:link id="hls031_doc_layout_button_detail_link"
                url="${/request/@context_path}/modules/FND/FND_MODEL/FND114/hls_doc_layout_button_detail.lview"/>
        <script><![CDATA[
            function hls031_add() {
                new Leaf.Window({
                    id: 'hls031_doc_layout_button_add_window',
                    url: $('hls031_doc_layout_button_add_link').getUrl(),
                    title: '${l:HLS031.LAYOUT_BUTTON_CONFIG}',
                    height: 200,
                    width: 300
                });
            }
            
            function hls031_result_detail_open(function_code) {
                new Leaf.Window({
                    id: 'hls031_doc_layout_button_detail_window',
                    url: $('hls031_doc_layout_button_detail_link').getUrl() + '?flag=true&function_code=' + function_code,
                    title: '${l:HLS031.LAYOUT_BUTTON_CONFIG_DETAIL}',
                    fullScreen: true
                });
            }
            
            function hls031_result_gird_render(value, record, name) {
                return '<a href="javascript:hls031_result_detail_open(\'' + record.get('function_code') + '\')">${l:HLS031.BUTTON_CONFIG}</a>';
            
            }
            
            function hls031_query() {
                $('hls031_function_result_ds').query();
            }
            
            function hls031_reset() {
                $('hls031_function_query_ds').reset();
                $('hls031_function_result_ds').query();
            }
        function upload() {

            var formData = new FormData();
            var dom = document.getElementById('layout_upload_fun_btn');
            formData.append('fileToUpload',dom.files[0]);
            debugger;
            $jq.ajax({
                url: '${/request/@context_path}/hls/doc/layout/button/import',
                data: formData,
                cache: false,
                processData: false,
                contentType: false,
                type: "post",
                success: function (res) {
                    if (res.success) {
                        Leaf.showMessage('${l:PROMPT}', '导入成功!');
                    } else {
                        Leaf.showErrorMessage('${l:PROMPT}', res.message);
                    }
                }
            })
        }

        function layout_fun_btn_import() {

            var header = $jq('meta[name=_csrf_header]').attr('content');
            var token = $jq('meta[name=_csrf]').attr('content');
            $jq(document).ajaxSend(function (e, xhr, options) {
                xhr.setRequestHeader(header, token);
            });
            var dom = document.getElementById('layout_upload_fun_btn');
            // dom.setAttribute('type','text');
            // dom.setAttribute('type','file');
            dom.click();
        }
        function layout_fun_btn_export() {
            var records = $('hls031_function_result_ds').getSelected();
            var saveData = [];
            if (records.length != 1) {
                Leaf.showMessage('${l:PROMPT}', '${l:HLS.SELECT_RECORD}');
                return;
            } else {
                jQuery('#download_fun_btn').attr('href','${/request/@context_path}/hls/doc/layout/button/export?functionCode='+ records[0].data.function_code)
                jQuery('#download_fun_btn')[0].click();
            }
        }

        Leaf.onReady(function () {
            document.getElementById('layout_upload_fun_btn').addEventListener('change',upload);
        })
        ]]></script>
        <a:dataSets>
            <a:dataSet id="hls031_function_query_ds"/>
            <a:dataSet id="hls031_function_result_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls/doc/layout/button/function/query"
                       queryDataSet="hls031_function_query_ds"/>
        </a:dataSets>
        <a:screenBody>
            <a id="download_fun_btn" style="display: none"/>
            <input id="layout_upload_fun_btn" type="file" style="display:none;"/>
            <a:screenTopToolbar>
                <a:toolbarButton click="hls031_add" text="HLS.NEW" width="80"/>
                <a:toolbarButton click="hls031_query" text="HLS.QUERY" width="80"/>
                <a:toolbarButton click="hls031_reset" text="HLS.RESET" width="80"/>
                <a:gridButton click="layout_fun_btn_export" text="导出"/>
                <a:gridButton click="layout_fun_btn_import" text="导入"/>
            </a:screenTopToolbar>
            <a:form column="2">
                <a:textField name="function_code" bindTarget="hls031_function_query_ds"
                             prompt="SYS8010.SYS_FUNCTION.FUNCTION_CODE" typeCase="upper">
                    <a:events>
                        <a:event name="enterdown" handler="hls031_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="function_name" bindTarget="hls031_function_query_ds"
                             prompt="SYS8010.SYS_FUNCTION.FUNCTION_NAME">
                    <a:events>
                        <a:event name="enterdown" handler="hls031_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="hls031_result_gird_id" bindTarget="hls031_function_result_ds" marginHeight="150"
                    marginWidth="40" navBar="true">
                <a:columns>
                    <a:column name="function_code" prompt="SYS8010.SYS_FUNCTION.FUNCTION_CODE" width="200"/>
                    <a:column name="function_name" prompt="SYS8010.SYS_FUNCTION.FUNCTION_NAME" width="250"/>
                    <a:column name="button_config" align="center" prompt="HLS031.BUTTON_CONFIG"
                              renderer="hls031_result_gird_render" width="150"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
