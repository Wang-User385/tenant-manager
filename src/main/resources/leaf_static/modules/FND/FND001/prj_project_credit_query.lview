<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectProjectBp"
                       rootPath="prj_project_bp_path"/>
    </a:init-procedure>
    <a:view>
        <a:link id="fnd001_project_modify_credit_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl_audit_credit.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project'):
                    qpara['created_by'] = '${/session/@user_id}';
                    qpara['credit_flag'] = 'Y';
                    break;
            }
        };
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            //debugger;
            var record = $(ds_id).findById(record_id);
            //查询项目商业伙伴信息
            if(record.get('project_id')){
                var param = record.data, function_code = '';
                param['url_title'] = '项目明细';
                param['winid'] = 'project_modify_winid';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['project_id'] = record.get('project_id');
                function_code = 'PRJ316F2WL3_CREDIT';
                param['function_code'] = function_code;
                hls_doc_get_layout_code(param, 'fnd001_project_modify_credit_id', ds_id, 'FND001');
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
