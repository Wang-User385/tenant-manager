<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?dbColumnType=SYS.DB_COLUMN_TYPE"
                type="text/javascript"></script>
        <script><![CDATA[
        $L.onReady(function () {
            dbColumnType.forEach(function (item) {
                $('sys_db_column_type_ds').create({"value": item.value, "text": item.meaning});
            });
        });

        <!-- 报价single信息操作 -->
        function hls_field_singe_lninfo_query() {
            $('hls_field_singe_hdinfo_ds').query();
        }

        function hls_field_singe_lninfo_add() {
            $('hls_field_singe_lninfo_ds').create();
        }

        function hls_field_singe_lninfo_save() {
            $('hls_field_singe_hdinfo_ds').submit();
        }

        function hls_field_singe_lninfo_delete() {
            $('hls_field_singe_lninfo_ds_grid').remove();
        }

        function onSubmitSuccess_hls_field_singe_lninfo_ds(ds) {
            hls_field_singe_lninfo_query();
        }

        <!-- 报价mult操作 -->
        function hls_field_mult_lninfo_query() {
            $('hls_field_mult_hdinfo_ds').query();
        }

        function hls_field_mult_lninfo_add() {
            $('hls_field_mult_lninfo_ds').create();
        }

        function hls_field_mult_lninfo_save() {
            $('hls_field_mult_hdinfo_ds').submit();
        }

        function hls_field_mult_lninfo_delete() {
            $('hls_field_mult_lninfo_ds_grid').remove();
        }

        function onSubmitSuccess_hls_field_mult_lninfo_ds(ds) {
            hls_field_mult_lninfo_query();
            hls_field_bt_query();
        }

        function sys_module_table_edit_quit() {
            $('${/parameter/@winid}').close();
        }


        function hls_field_sheet_query_ds_query(ds,para) {
            para['excel_id'] = '${/parameter/@excel_id}';
        }

        $L.Masker.mask(Ext.getBody(),"正在加载...");

        function hls_field_sheet_query_ds_load(ds){
            $L.Masker.unmask(Ext.getBody());
            var datas = ds.getAll();
            if(datas != null && datas.length > 0) {
                $('hls_field_sheet_query_ds').getCurrentRecord().set('sheet_name',datas[0].get('sheet_name'));

                $('hls_field_singe_hdinfo_query_ds').getCurrentRecord().set('sheet_name',datas[0].get('sheet_name'));
                $('hls_field_mult_hdinfo_query_ds').getCurrentRecord().set('sheet_name',datas[0].get('sheet_name'));

                $('hls_field_singe_hdinfo_ds').query();


                $('hls_field_mult_hdinfo_ds').query();

            }
        }


        function hls_field_singe_hdinfo_ds_load(ds){
            if(ds.getAll().length == 0){
                ds.create({
                    sheet_name: $('hls_field_sheet_query_ds').getCurrentRecord().get('sheet_name'),
                    table_type: 'SINGLE',
                    excel_id: '${/parameter/@excel_id}',
                    excel_code : '${/parameter/@excel_code}',
                    excel_name: '${/parameter/@excel_name}'
                });
            }
        }

        function hls_field_mult_hdinfo_ds_load(ds){
            if(ds.getAll().length == 0){
                ds.create({
                    sheet_name: $('hls_field_sheet_query_ds').getCurrentRecord().get('sheet_name'),
                    table_type: 'MULTI_LINE',
                    excel_id: '${/parameter/@excel_id}',
                    excel_code: '${/parameter/@excel_code}',
                    excel_name: '${/parameter/@excel_name}'
                });
            }
        }

        function hls_field_sheet_query_ds_update(ds,record,name,value,oldval){
            if(name == 'sheet_name'){
                $('hls_field_sheet_query_ds').getCurrentRecord().set('sheet_name',value);

                $('hls_field_singe_hdinfo_query_ds').getCurrentRecord().set('sheet_name',value);
                $('hls_field_mult_hdinfo_query_ds').getCurrentRecord().set('sheet_name',value);

                $('hls_field_singe_hdinfo_ds').query();


                $('hls_field_mult_hdinfo_ds').query();
            }
        }

        function hls_field_singe_lninfo_ds_query(ds,qpara){
            if($('hls_field_singe_hdinfo_ds').getCurrentRecord().get('config_hd_id') == null){
                qpara['config_hd_id'] = null;
            }
        }

        function hls_field_mult_lninfo_ds_query(ds,qpara){
            if($('hls_field_mult_hdinfo_ds').getCurrentRecord().get('config_hd_id') == null){
                qpara['config_hd_id'] = null;
            }
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="sys_db_column_type_ds">
            </a:dataSet>
            <a:dataSet id="fnd_cf_item_options_ds" queryUrl="${/request/@context_path}/fnd/HlsCfItem/query"
                       autoQuery="true" pageSize="999">
            </a:dataSet>

            <a:dataSet id="hls_field_sheet_query_options"
                       queryUrl="${/request/@context_path}/hls/web/excel/query/sheetInfo" autoQuery="true">
                <a:events>
                    <a:event name="query" handler="hls_field_sheet_query_ds_query"/>
                    <a:event name="load" handler="hls_field_sheet_query_ds_load"/>
                </a:events>
            </a:dataSet>

            <!--sheet标签页信息-->
            <a:dataSet id="hls_field_sheet_query_ds" autoCreate="true">

                <a:fields>
                    <a:field name="sheet_name" displayField="code_value_name" options="hls_field_sheet_query_options"
                             returnField="sheet_name" valueField="code_value"/>
                </a:fields>

                <a:events>
                    <a:event handler="hls_field_sheet_query_ds_update" name="update"/>
                </a:events>

            </a:dataSet>

            <!--单行本方信息head ds-->
            <a:dataSet id="hls_field_singe_hdinfo_query_ds">
                <a:fields>
                    <a:field name="excel_id" defaultValue="${/parameter/@excel_id}"/>
                    <a:field name="table_type" defaultValue="SINGLE"/>
                    <a:field name="sheet_name"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="hls_web_excel_loop_type_ds" lookupCode="WEB.EXCEL_LOOP_TYPE"/>

            <a:dataSet id="hls_field_singe_hdinfo_ds"
                       queryUrl="${/request/@context_path}/get/configHd/info/by/excel"
                       submitUrl="${/request/@context_path}/hls/web/excel/config/info/save"
                       queryDataSet="hls_field_singe_hdinfo_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="excel_code" readOnly="true"/>
                    <a:field name="excel_name" readOnly="true"/>
                    <a:field name="table_type" readOnly="true"/>
                    <a:field name="table_name" required="true"/>
                    <a:field name="sheet_name"/>
                    <a:field name="loop_type"/>
                    <a:field name="loop_type_n" options="hls_web_excel_loop_type_ds" displayField="code_value_name"
                             returnField="loop_type" valueField="code_value"/>
                </a:fields>
                <a:events>
                    <a:event name="submitSuccess" handler="onSubmitSuccess_hls_field_singe_lninfo_ds"/>
                    <a:event name="load" handler="hls_field_singe_hdinfo_ds_load"/>
                </a:events>
            </a:dataSet>

            <!--单行本方信息line ds-->
            <a:dataSet id="hls_field_singe_lninfo_ds" bindTarget="hls_field_singe_hdinfo_ds"
                       bindName="hlsWebExcelConfigLnList" selectable="true"
                       queryUrl="${/request/@context_path}/hls/web/excel/config/ln/query"
                       deleteUrl="${/request/@context_path}/hls/web/excel/config/ln/remove"
                       queryDataSet="hls_field_singe_hdinfo_ds">
                <a:fields>
                    <a:field name="cashflow_item_desc" options="fnd_cf_item_options_ds" displayField="excel_name"
                             valueField="cf_item" returnField="cashflow_item"/>
                    <a:field name="column_type_desc" options="sys_db_column_type_ds" displayField="text"
                             valueField="value" returnField="column_type"/>
                    <a:field name="formula_no_check_flag" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                    <a:field name="hide_row_flag" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="hls_field_singe_lninfo_ds_query"/>
                </a:events>
            </a:dataSet>

            <!--多行行本方信息ds-->
            <a:dataSet id="hls_field_mult_hdinfo_query_ds">
                <a:fields>
                    <a:field name="excel_id" defaultValue="${/parameter/@excel_id}"/>
                    <a:field name="table_type" defaultValue="MULTI_LINE"/>
                    <a:field name="sheet_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="hls_field_mult_hdinfo_ds"
                       queryUrl="${/request/@context_path}/get/configHd/info/by/excel"
                       submitUrl="${/request/@context_path}/hls/web/excel/config/info/save"
                       queryDataSet="hls_field_mult_hdinfo_query_ds">
                <a:fields>
                    <a:field name="excel_code" readOnly="true"/>
                    <a:field name="excel_name" readOnly="true"/>
                    <a:field name="table_type" readOnly="true"/>
                    <a:field name="table_name" required="true"/>
                    <a:field name="multi_line_from" required="true"/>
                    <a:field name="multi_line_to" required="true"/>
                    <a:field name="loop_type_n" options="hls_web_excel_loop_type_ds" displayField="code_value_name"
                             returnField="loop_type" valueField="code_value"/>
                    <a:field name="sheet_name"/>
                </a:fields>
                <a:events>
                    <a:event name="submitSuccess" handler="onSubmitSuccess_hls_field_mult_lninfo_ds"/>
                    <a:event name="load" handler="hls_field_mult_hdinfo_ds_load"/>
                </a:events>
            </a:dataSet>

            <!--多行本方信息line ds-->
            <a:dataSet id="hls_field_mult_lninfo_ds" bindTarget="hls_field_mult_hdinfo_ds"
                       bindName="hlsWebExcelConfigLnList" selectable="true"
                       queryUrl="${/request/@context_path}/hls/web/excel/config/ln/query"
                       deleteUrl="${/request/@context_path}/hls/web/excel/config/ln/remove"
                       queryDataSet="hls_field_mult_hdinfo_ds" autoQuery="true">
                <a:fields>
                    <a:field name="cashflow_item_desc" options="fnd_cf_item_options_ds" displayField="excel_name"
                             valueField="cf_item" returnField="cashflow_item"/>
                    <a:field name="column_type_desc" options="sys_db_column_type_ds" displayField="text"
                             valueField="value" returnField="column_type"/>
                    <a:field name="formula_no_check_flag" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                    <a:field name="hide_row_flag" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="hls_field_mult_lninfo_ds_query"/>
                </a:events>
            </a:dataSet>





        </a:dataSets>
        <a:screenBody>
            <a:form title="sheet配置">
                <a:comboBox name="sheet_name" prompt="标签页" bindTarget="hls_field_sheet_query_ds"/>
            </a:form>

            <a:tabPanel width="1300" marginHeight="100">
                <a:tabs>
                    <a:tab prompt="webexcel头信息" width="130" selected="true">
                        <a:form column="4" labelwidth="100" title="本方信息">
                            <a:textField name="excel_code" bindTarget="hls_field_singe_hdinfo_ds" prompt="webexcel代码"
                                         width="180">
                            </a:textField>
                            <a:textField name="excel_name" bindTarget="hls_field_singe_hdinfo_ds" prompt="webexcel名称"
                                         width="180">
                            </a:textField>
                            <a:textField name="table_name" bindTarget="hls_field_singe_hdinfo_ds" prompt="数据库表名"
                                         width="180">
                            </a:textField>
                            <a:textField name="table_type" bindTarget="hls_field_singe_hdinfo_ds" prompt="数据库表类型"
                                         width="180">
                            </a:textField>
                            <a:comboBox name="loop_type_n" bindTarget="hls_field_singe_hdinfo_ds" prompt="循环类型" width="180"/>

                            <a:textField name="multi_line_from" bindTarget="hls_field_singe_hdinfo_ds" prompt="循环范围从"
                                         width="180"/>
                            <a:textField name="multi_line_to" bindTarget="hls_field_singe_hdinfo_ds" prompt="循环范围至"
                                         width="180"/>

                            <a:textField name="config_hd_id" bindTarget="hls_field_singe_hdinfo_ds" style="display:none"
                                         width="180">
                            </a:textField>
                        </a:form>
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="hls_field_singe_lninfo_add" text="HAP.NEW"/>
                            <a:gridButton click="hls_field_singe_lninfo_save" text="HAP.SAVE"/>
                            <a:gridButton click="hls_field_singe_lninfo_delete" text="HAP.DELETE"/>
                        </a:screenTopToolbar>
                        <a:grid id="hls_field_singe_lninfo_ds_grid" bindTarget="hls_field_singe_lninfo_ds" width="1250"
                                marginHeight="320"
                                navBar="true">
                            <a:columns>
                                <a:column name="column_code" width="100" prompt="字段编码"
                                          editor="hls_field_singe_lninfo_ds_grid_tf"/>
                                <a:column name="column_name" width="150" prompt="字段名称"
                                          editor="hls_field_singe_lninfo_ds_grid_tf"/>
                                <a:column name="prompt" width="140" prompt="描述"
                                          editor="hls_field_singe_lninfo_ds_grid_tf"/>
                                <a:column name="column_type_desc" width="140" prompt="字段类型"
                                          editor="hls_field_singe_lninfo_ds_grid_com"/>
                                <a:column name="column_type" width="140" prompt="字段类型" hidden="true"/>

                                <a:column name="precisions" width="140" prompt="精度"
                                          editor="hls_field_singe_lninfo_ds_grid_tf"/>

                                <a:column name="formula_no_check_flag" width="80" prompt="忽略公式校验"
                                          editor="hls_field_singe_lninfo_ds_grid_cb"/>
                                <a:column name="hide_row_flag" width="80" prompt="隐藏单元格行"
                                          editor="hls_field_singe_lninfo_ds_grid_cb"/>
                            </a:columns>
                            <a:editors>
                                <a:textField id="hls_field_singe_lninfo_ds_grid_tf"/>
                                <a:checkBox id="hls_field_singe_lninfo_ds_grid_cb"/>
                                <a:comboBox id="hls_field_singe_lninfo_ds_grid_com"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="webexcel行信息" width="130">
                        <a:form column="4" labelwidth="100" title="本方信息">
                            <a:textField name="excel_code" bindTarget="hls_field_mult_hdinfo_ds" prompt="webexcel代码"
                                         width="180">
                            </a:textField>
                            <a:textField name="excel_name" bindTarget="hls_field_mult_hdinfo_ds" prompt="webexcel名称"
                                         width="180">
                            </a:textField>
                            <a:textField name="table_name" bindTarget="hls_field_mult_hdinfo_ds" prompt="数据库表名"
                                         width="180">
                            </a:textField>
                            <a:textField name="table_type" bindTarget="hls_field_mult_hdinfo_ds" prompt="数据库表类型"
                                         width="180">
                            </a:textField>

                            <a:comboBox name="loop_type_n" bindTarget="hls_field_mult_hdinfo_ds" prompt="循环类型" width="180"/>

                            <a:textField name="multi_line_from" bindTarget="hls_field_mult_hdinfo_ds" prompt="多行范围从"
                                         width="180">
                            </a:textField>
                            <a:textField name="multi_line_to" bindTarget="hls_field_mult_hdinfo_ds" prompt="多行范围至"
                                         width="180">
                            </a:textField>
                        </a:form>
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="hls_field_mult_lninfo_add" text="HAP.NEW"/>
                            <a:gridButton click="hls_field_mult_lninfo_save" text="HAP.SAVE"/>
                            <a:gridButton click="hls_field_mult_lninfo_delete" text="HAP.DELETE"/>
                        </a:screenTopToolbar>
                        <a:grid id="hls_field_mult_lninfo_ds_grid" bindTarget="hls_field_mult_lninfo_ds" width="1250"
                                marginHeight="320"
                                navBar="true">
                            <a:columns>
                                <a:column name="column_code" width="50" prompt="字段编码"
                                          editor="hls_field_mult_lninfo_ds_grid_tf"/>
                                <a:column name="column_name" width="150" prompt="字段名称"
                                          editor="hls_field_mult_lninfo_ds_grid_tf"/>
                                <a:column name="prompt" width="140" prompt="描述"
                                          editor="hls_field_mult_lninfo_ds_grid_tf"/>
                                <a:column name="column_type_desc" width="140" prompt="字段类型"
                                          editor="hls_field_mult_lninfo_ds_grid_com"/>
                                <a:column name="column_type" width="140" prompt="字段类型" hidden="true"/>

                                <a:column name="precisions" width="140" prompt="精度"
                                          editor="hls_field_mult_lninfo_ds_grid_tf"/>

                                <a:column name="formula_no_check_flag" width="80" prompt="忽略公式校验"
                                          editor="hls_field_mult_lninfo_ds_grid_cb"/>
                                <a:column name="hide_row_flag" width="80" prompt="隐藏单元格行"
                                          editor="hls_field_mult_lninfo_ds_grid_cb"/>
                            </a:columns>
                            <a:editors>
                                <a:textField id="hls_field_mult_lninfo_ds_grid_tf"/>
                                <a:checkBox id="hls_field_mult_lninfo_ds_grid_cb"/>
                                <a:comboBox id="hls_field_mult_lninfo_ds_grid_com"/>
                            </a:editors>
                        </a:grid>

                    </a:tab>

                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
    </a:view>
</a:screen>
