<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="HLS200_MARKETING_REPORT"
                url="${/request/@context_path}/modules/HLS/HLS200/hls_marketing_report_detail_wfl.lview"/>

        <script><![CDATA[

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'marketing_report_number' && value) {
                return '<a href="javascript:open_marketing_report_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_marketing_report_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'HLS200F1WFL';
            param['url_title'] = '项目方案详情';
            param['function_usage'] = 'UPDATE';
            param['winid'] = 'marketing_report_detailwinid';

            hls_doc_get_layout_code(param, 'HLS200_MARKETING_REPORT', ds_id, 'HLS200', null, null, '${/parameter/@layout_code}_autoQuery');


            // param['function_usage'] = 'CREATE';

        }
       ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>