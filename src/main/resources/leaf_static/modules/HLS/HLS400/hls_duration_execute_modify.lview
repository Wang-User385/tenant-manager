            param['hd_id'] = hd_id;

            // param['screen_width'] = '1400';
            // param['screen_height'] = '700';
            if (record.get('execute_type') == 'FINANCIAL_TERMS' || record.get('execute_type') == 'RELEASE' || record.get('execute_type') == 'REPURCHASE' || record.get('execute_type') == 'ET' || record.get('execute_type') == 'PREPAYMENT' || record.get('execute_type') == 'TERMINATE') {
                param['function_code'] = 'HLS300CASHF1';
