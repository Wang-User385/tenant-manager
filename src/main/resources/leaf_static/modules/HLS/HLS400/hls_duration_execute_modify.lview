        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');


            var lease_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var lease_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var lease_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');


            //保证金退还和抵扣 支付表选择后 保证金需要重新查询
            if (duration_hd_ds_id == ds.id) {
                if (name == 'contract_id') {
                    if ($(deposit_ds_id)) {
                        $(deposit_ds_id).setQueryParameter('contract_id', value);
                        $(deposit_ds_id).query();
                    }

                    if ($(interest_ds_id)) {
                        $(interest_ds_id).setQueryParameter('contract_id', value);
                        $(interest_ds_id).query();
                    }
                }
            }

            //保证金退还和抵扣 本次冲抵金额不能大于剩余金额
            if (credit_ds_id == ds.id) {

                var deduction_amount = record.get('deduction_amount') || 0;
                var residual_amount = record.get('residual_amount') || 0;
                var residual_interest = record.get('residual_interest') || 0;

                if (name == 'deduction_amount') {
                    if (minus(value, residual_amount) > 0) {
                        Leaf.showMessage('提示！', '本次抵扣金额:' + value + '大于剩余金额:' + record.get('residual_amount'));
                        return;
                    } else if (minus(value, residual_amount) <= 0 && minus(value, residual_interest) <= 0) {
                        record.set('deduction_principal', 0);
                        record.set('deduction_interest', value || 0);
                    } else if (minus(value, residual_amount) <= 0 && minus(value, residual_interest) >= 0) {
                        record.set('deduction_principal', minus(value, residual_interest));
                        record.set('deduction_interest', residual_interest);
                    }
                } else if (name == 'deduction_principal') {
                    record.set('deduction_interest', minus(deduction_amount, value));

                } else if (name == 'deduction_interest') {
                    record.set('deduction_principal', minus(deduction_amount, value));
                }
            }

            if (execute_type == 'FINANCIAL_TERMS') {
                if (name == 'financial_terms_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(0);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(0);
                    }
                }
                if (name == 'bp_info_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                    }
                }
                if (name == 'release_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                    }
                }
                if (name == 'repurchase_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                    }
                }
                // if (name == 'agreement_change_flag') {
                //     if (value == 'N') {
                //         $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(4);
                //     } else {
                //         $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(4);
                //     }
                // }
            } else if (execute_type == 'ET' || execute_type == 'PREPAYMENT') {
                if (name == 'release_change_flag') {
                    if (value == 'N') {
                        release_change_flag = 'N';
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                    } else {
                        release_change_flag = 'Y';
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                    }
                }
                if (name == 'repurchase_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                    }
                }
                if (name == 'agreement_change_flag') {
                    if (value == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                    } else {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                    }
                }
            }

            if (lease_ds_id == ds.id) {
                var currentRecord = $(lease_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var mortgage_pledge_amount = currentRecord.get('mortgage_pledge_amount');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(mortgage_pledge_amount, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }


            }

            if (lease_2_ds_id == ds.id) {
                var currentRecord = $(lease_2_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var net_asset_value_now = currentRecord.get('net_asset_value_now');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(net_asset_value_now, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }


            }

            if (lease_1_ds_id == ds.id) {
                var currentRecord = $(lease_1_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var mortgage_pledge_amount = currentRecord.get('mortgage_pledge_amount');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(mortgage_pledge_amount, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }
            }


        };

        window['${/parameter/@layout_code}_grid_refund_update'] = function (value) {
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var deposit_records = $(deposit_ds_id).getAll();
            var interest_records = $(interest_ds_id).getAll();
            if (value == 'Y') {
                deposit_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(false);
                    record.getField('refund_amount').setRequired(true);
                });
                interest_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(false);
                    record.getField('refund_amount').setRequired(true);
                });
            } else {
                deposit_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(true);
                    record.getField('refund_amount').setRequired(false);
                    record.set('refund_amount', 0);
                });
                interest_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(true);
                    record.getField('refund_amount').setRequired(false);
                    record.set('refund_amount', 0);
                });
            }
        };

