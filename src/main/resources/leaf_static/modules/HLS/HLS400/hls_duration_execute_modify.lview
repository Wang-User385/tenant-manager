            param['hd_id'] = hd_id;
            param['execute_type'] = execute_type;
            param['project_id'] = record.get('project_id');
            param['report_flag'] = 'Y';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_con_contract_detail_id', null, '${/parameter/@function_code}');
        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            var param = {};
            param['url_title'] = '存续期履约情况';
            param['function_code'] = 'HLS300CASH';
            param['function_usage'] = 'MODIFY';
            param['contract_id'] = record.get('contract_id');
            param['winid'] = '${/parameter/@layout_code}_common_winid';
            /*param['screen_width'] = '1600';
            param['screen_height'] = '700';*/
