<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>

        <a:link id="${/parameter/@layout_code}_common_window_id"
                url="${/request/@context_path}/modules/HLS/HLS400/hls_duration_execute_common.lview"/>
        <a:link id="${/parameter/@layout_code}_common_release_repurchase_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_common_release_repurchase.lview"/>
        <a:link id="${/parameter/@layout_code}_project_credit_notice_link"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition.lview"/>
        <a:link id="${/parameter/@layout_code}_con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_sw001_pledges_lease_id"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_lease_info_detail_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="lease_info_detail_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="sw001_pledges_lease"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="bp100_bp_master_modify_id12"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>

        <script><![CDATA[


        var execute_type = '${/parameter/@execute_type}';
        var contract_id = '${/parameter/@contract_id}';

        var hd_id = '${/parameter/@hd_id}';

        var bp_info_change_flag = 'N';
        var release_change_flag = 'N';
        var repurchase_change_flag = 'N';
        var agreement_change_flag = 'N';
        var financial_terms_change_flag = 'N';


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');

            if (ds.id === duration_hd_ds_id) {
                //新增时初始化
                if (!record.get('apply_unit_id_n')) {
                    record.set('apply_unit_id_n', '${/session/@unitName}');
                    record.set('apply_unit_id', '${/session/@unitId}');
                }
                if (!record.get('apply_person_n')) {
                    record.set('apply_person_n', '${/session/@employeeName}');
                    record.set('apply_person', '${/session/@userId}');
                }
                if (!record.get('apply_date')) {
                    record.set('apply_date', Leaf.dateFormat.format(new Date('${/model/default_value/record/@now_date}'), 'isoDate'));
                }
                if (!record.get('project_id')) {
                    record.set('project_id', '${/parameter/@project_id}');
                }
                if (!record.get('prj_con_number')) {
                    record.set('prj_con_number', '${/parameter/@prj_con_number}');
                }
                if (!record.get('project_name')) {
                    record.set('project_name', '${/parameter/@project_name}');
                }
                if (!record.get('prj_bp_name')) {
                    record.set('prj_bp_name', '${/parameter/@prj_bp_name}');
                }
                if (!record.get('prj_bp_name')) {
                    record.set('prj_bp_name', '${/parameter/@prj_bp_name}');
                }
                if (!record.get('prj_con_status_n')) {
                    record.set('prj_con_status_n', '${/parameter/@prj_con_status_n}');
                }
                if (!record.get('prj_unit_name')) {
                    record.set('prj_unit_name', '${/parameter/@prj_unit_name}');
                }
                if (!record.get('prj_employee_name')) {
                    record.set('prj_employee_name', '${/parameter/@prj_employee_name}');
                }
                if (!record.get('prj_finance_amount')) {
                    record.set('prj_finance_amount', '${/parameter/@prj_finance_amount}');
                }
                if (!record.get('prj_outstanding_principal')) {
                    record.set('prj_outstanding_principal', '${/parameter/@prj_outstanding_principal}');
                }
                if (!record.get('prj_overdue_max_days')) {
                    record.set('prj_overdue_max_days', '${/parameter/@prj_overdue_max_days}');
                }

                if (!record.get('financial_terms_change_flag')) {
                    record.set('financial_terms_change_flag', 'N');
                } else {
                    financial_terms_change_flag = record.get('financial_terms_change_flag');
                }
                if (!record.get('bp_info_change_flag')) {
                    record.set('bp_info_change_flag', 'N');
                } else {
                    bp_info_change_flag = record.get('bp_info_change_flag');
                }
                if (!record.get('release_change_flag')) {
                    record.set('release_change_flag', 'N');
                } else {
                    release_change_flag = record.get('release_change_flag');
                }
                if (!record.get('repurchase_change_flag')) {
                    record.set('repurchase_change_flag', 'N');
                } else {
                    repurchase_change_flag = record.get('repurchase_change_flag');
                }
                if (!record.get('agreement_change_flag')) {
                    record.set('agreement_change_flag', 'Y');
                } else {
                    agreement_change_flag = record.get('agreement_change_flag');
                }

                //新建的单据 通过 Leaf.onReady 渲染
                //保存的单据 通过 from load 事件 渲染
                if ('${/parameter/@hd_id}') {
                    Leaf.onReady(function () {
                        if (execute_type == 'FINANCIAL_TERMS') {
                            if (financial_terms_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(0);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(0);
                            }
                            if (bp_info_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                            }
                            if (release_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                            }
                            if (repurchase_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                            }
                            // if (agreement_change_flag == 'N') {
                            //     $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(4);
                            // } else {
                            //     $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(4);
                            // }
                        } else if (execute_type == 'ET' || execute_type == 'PREPAYMENT') {
                            if (release_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                            }
                            if (repurchase_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                            }
                            if (agreement_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                            }
                        }

                        //debugger;
                        if ('${/parameter/@function_usage}' == 'QUERY' && '${/parameter/@fin_review_flag}' != 'Y') {
                            //除了合同变更工作流资产审查岗外，其它只读页面隐藏按钮
                            $('${/parameter/@layout_code}_G_ATTACHMENT_INFO_DELETE_layout_dynamic_button_id').hide();
                            $('${/parameter/@layout_code}_G_ATTACHMENT_INFO_ADD_layout_dynamic_button_id').hide();
                            $('${/parameter/@layout_code}_G_ATTACHMENT_INFO_SAVE_layout_dynamic_button_id').hide();
                        }
                    });
                }


            }

        };


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');

            var contract_text_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_CONTRACT_TEXT');

            var file_end_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');

            //保证金退还和抵扣
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');

            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');
            var change_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CHANGE_INFO');

            if (attachment_ds_id == ds.id) {
                ds.setQueryParameter('attachment_category', execute_type);
            }
            //补充协议
            if (contract_text_ds_id == ds.id) {
                ds.setQueryParameter('attachment_category', 'TEXT');
            }

            if (file_end_ds_id == ds.id) {
                var project_id = '-1';
                var base_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
                var base_record = $(base_info_ds_id).getCurrentRecord();
                if (base_record != null) {
                    project_id = base_record.get('project_id');
                }
                ds.setQueryParameter('project_id', project_id);
                ds.setQueryParameter('status', 'Y');
            }

            if (deposit_ds_id == ds.id) {
                ds.setQueryParameter('risk_cf_item', '52');
                ds.setQueryParameter('hd_id', hd_id)
            }
            if (interest_ds_id == ds.id) {
                ds.setQueryParameter('cf_item', '502');
                ds.setQueryParameter('hd_id', hd_id)
            }
            if (credit_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'CREDIT');
                ds.setQueryParameter('hd_id', hd_id)
            }
            if (et_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'ET');
            }
            if (prepayment_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'PREPAYMENT');
            }
            if (change_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'FINANCIAL_TERMS');
            }


            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        //indexchange事件(grid,attach,gridbox,table)
        // window['${/parameter/@layout_code}_on_layout_dynamic_grid_indexchange'] = function (ds, record, bp_seq) {
        //     debugger;
        //     //解押 && 回购
        //     var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
        //     if (lease_item_ds_id == ds.id) {
        //         var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
        //         $(list_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
        //         $(list_ds_id).query();
        //     }
        //
        //     //正常结清&&提前结清&&提前还款
        //     var lease_item_ds_1_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
        //     if (lease_item_ds_1_id == ds.id) {
        //         var list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
        //         $(list_1_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
        //         $(list_1_ds_id).query();
        //     }
        //
        //     var lease_item_ds_2_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
        //     if (lease_item_ds_2_id == ds.id) {
        //         var list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
        //         $(list_2_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
        //         $(list_2_ds_id).query();
        //     }
        //
        // };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function;
            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }
            if (name == 'lease_item_code') {
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win11(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if (name == 'finnance_info') {
                return '<a href="javascript:open_finance_modify_win22(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }
            if (name === 'upload') {
                return '<a href="javascript:window[\'' + 'upload_file' + '\'](\'' + record.id + '\',\'' + record.get('duration_attachment_id') + '\');">上传</a>';
            }
            if (name === 'cashflow_detail') {
                if (record.get('contract_id')) {
                    return '<a href="javascript:window[\'' + 'cashflow_detail' + '\'](\'' + record.id + '\',\'' + record.get('contract_id') + '\');">详细</a>';
                }
            }
            if (name === 'approval_notice') {
                if (record.get('project_id')) {
                    return '<a href="javascript:window[\'' + 'approval_notice' + '\'](\'' + record.id + '\',\'' + record.get('project_id') + '\');">详细</a>';
                }
            }
            if (name == 'lease_item_code') {
                //解押
                if (execute_type == 'RELEASE') {
                    return '<a href="javascript:window[\'' + 'sw001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                } else if (execute_type == 'REPURCHASE') {
                    //回购
                    return '<a href="javascript:window[\'' + 'lease001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                } else if (execute_type == 'ET' || execute_type == 'PREPAYMENT' || execute_type == 'TERMINATE') {
                    //正常结清&&提前结清&&提前还款
                    var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
                    var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
                    if (record.ds.id == lease_item_1_ds_id && record.get('source_id') != null) {
                        return '<a href="javascript:window[\'' + 'sw001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                    if (record.ds.id == lease_item_2_ds_id && record.get('source_id') != null) {
                        return '<a href="javascript:window[\'' + 'lease001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                }
            }
            if (name == 'full_name') {
                //金融条款
                if (execute_type == 'FINANCIAL_TERMS') {

                    var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
                    var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
                    if (record.ds.id == lease_item_1_ds_id && record.get('source_id') != null) {
                        return '<a href="javascript:window[\'' + 'sw001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                    if (record.ds.id == lease_item_2_ds_id && record.get('source_id') != null) {
                        return '<a href="javascript:window[\'' + 'lease001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                }
            }

            //颜色标记
            if (name == 'lease_full_name') {
                if (record.get('release_flag') == 'Y') {
                    return '<div style="color: red">' + value + '</div>';
                } else {
                    return value;
                }
            }
            if (name == 'warrant_name') {
                if (record.get('warrant_flag') == 'Y') {
                    return '<div style="color: red">' + value + '</div>';
                } else {
                    return value;
                }
            }

            if (name == 'source_id') {
                //提前结清 - 保证金方案
                return '<a href="javascript:window[\'' + 'deposit_detail' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">详细</a>';

            }

            if (name == 'ln_id') {
                //提前结清 - 测算 && 提前还款-测算
                return '<a href="javascript:window[\'' + 'duration_calc_detail' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">测算</a>';
            }

            if (name === 'con_upload' && record.get('project_attachment_id')) {
                link_function = 'con_upload';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传' + '</a>';
            }
            if (name == 'file_name' && value) {
                // debugger;
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }
        };

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        function open_bp_modify_win11(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid11';

            if ('${/parameter/@wfl_bp_flag}' == 'Y') {
                parent.parent_bp_chance_detail(param, ds_id);
            } else {
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id12', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win22(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;

            var bp_id = param.bp_id;
            var bp_name = param.bp_name;
            var bp_code = param.bp_code;

            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid22',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    winid: 'hls_bp_master_financial_info_winid22',
                    'function_usage': 'QUERY'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 850,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //租赁物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_2_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var param = {};
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_detail_new_winid';
            // param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'lease_info_detail_id';
            hls_doc_get_layout_code(param, link_id, null, 'LEASE001');
        };

        //抵质押物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_1_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';

            param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
            hls_doc_get_layout_code(param, 'sw001_pledges_lease', null, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
        };

        window['lease_item_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
