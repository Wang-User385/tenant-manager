        window['con_upload'] = function (record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var project_attachment_id = record.get('project_attachment_id');

            var url;
            if ('${/parameter/@function_usage}' == 'QUERY' && '${/parameter/@wfl_flag}' != 'Y') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if ('${/parameter/@function_usage}' == 'QUERY' && '${/parameter/@fin_review_flag}' != 'Y') {
                //除了合同变更工作流资产审查岗外，其它只读页面不可上传
                url = '${/request/@context_path}/downloadFile.lview';
            }

            var table_name = 'FCT_PROJECT_ATTACHMENT';
            var file_end_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');


            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table_name,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                if (file_end_list_ds_id) {
                    $(file_end_list_ds_id).query();
                }
            });
        };

