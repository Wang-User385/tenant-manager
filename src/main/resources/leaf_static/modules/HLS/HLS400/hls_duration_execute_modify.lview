            param['side'] = 'right';*/
            if (param['project_id'] == '') {
                param['project_id'] = $(ds_id).getCurrentRecord().get('ref_project_id');
            }
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_project_credit_notice_link', ds_id, '${/parameter/@function_code}');

        };
        //取消变更
