<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年6月22日
    $Revision: 1.0
    $Purpose: 存续期执行-入口界面（合同变更）
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_duration_create_id"
                url="${/request/@context_path}/modules/HLS/HLS400/hls_duration_execute_create.lview"/>

        <a:link id="${/parameter/@layout_code}_duration_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>
        <a:link id="${/parameter/@layout_code}_execute_window_id"
                url="${/request/@context_path}/modules/HLS/HLS400/hls_duration_execute_modify.lview"/>

        <script><![CDATA[

        //变更创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'G_DURATION');
            var execute_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'G_EXECUTE');

            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '至少勾选一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示', '请选择一条记录！');
                return;
            }
            var param = {};
            var hd_id = records[0].get('hd_id');
            param = records[0].data;
            param['url_title'] = '合同变更创建';
            param['function_code'] = 'HLS400F1';
            param['function_usage'] = 'CREATE';
            param['hd_id'] = hd_id;
            param['winid'] = '${/parameter/@layout_code}_duration_create_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_duration_create_id', execute_ds_id, 'HLS400');
        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd','G_EXECUTE');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '请至少选择一条记录！');
                return;
            }
            var saveData = [];
            records.forEach(function (record) {
                //状态校验
                if (record.get('execute_status') == 'APPROVING' || record.get('execute_status') == 'APPROVED' || record.get('execute_status') == 'CANCEL') {
                    Leaf.showMessage('提示', '当前状态不能作废！');
                    check_flag = false;
                }
                record.set("execute_status", "CANCEL");
                record.set('__status', 'update');
                saveData.push(record.data);
            });

            if (check_flag) {
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认作废吗?', function okFun() {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/hls/duration/hd/cancel',
                        para: saveData,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ds_id).query();
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                },function cancel() {
                    $(ds_id).query();
                });
            }
        };

        function duration_number_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var duration_type = record.get('duration_type');
            param['url_title'] = '明细';
            param['function_code'] = get_function_code(duration_type);
            param['winid'] = 'duration_detail_open_id';
            param['function_usage'] = 'QUERY';
            param['execute_flag'] = 'Y';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_duration_window_id', ds_id, 'HLS400F');
        }


        function execute_number_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var execute_type = record.get('execute_type');
            var execute_status = record.get('execute_status');
            param['url_title'] = '明细';
            param['function_code'] =  get_execute_code(execute_type);
            param['winid'] = 'execute_detail_open_id';
            if (execute_status == 'APPROVED' || execute_status == 'APPROVING' || execute_status == 'CANCEL') {
                param['function_usage'] = 'QUERY';
            } else {
                param['function_usage'] = 'MODIFY';
            }
            //param['layout_debugger_flag'] = 'Y';

            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_execute_window_id', ds_id, 'HLS400F');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = '';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'duration_number') {
                link_function = 'duration_number_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }

            if (name == 'execute_number') {
                link_function = 'execute_number_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function get_function_code(duration_type) {
            /**
             PROJECT           项目变更审批事项工作联系单
             TERMINATE         正常结清
             ET                提前结清
             DEPOSIT           保证金释放、退还
             RELEASE           解押
             REPURCHASE        回购
             PREPAYMENT        提前还款
             SPECIAL           特殊事项
             */
            if (duration_type == 'PROJECT') {
                return 'HLS300F2';
            } else if (duration_type == 'RELEASE') {
                return 'HLS300F3';
            } else if (duration_type == 'SPECIAL') {
                return 'HLS300F4';
            } else if (duration_type == 'DEPOSIT') {
                return 'HLS300F5';
            } else if (duration_type == 'REPURCHASE') {
                return 'HLS300F7';
            } else if (duration_type == 'TERMINATE') {
                return 'HLS300F8';
            } else if (duration_type == 'ET') {
                return 'HLS300F9';
            } else if (duration_type == 'PREPAYMENT') {
                return 'HLS300F12';
            } else if (duration_type == 'BUSINESS_CHANGE') {
                return 'HLS300F20';
            }else if (duration_type == 'ET') {
                return 'HLS300F9';
            }else if (duration_type == 'DEPOSIT') {
                return 'HLS300F5';
            }else if (duration_type == 'CON_TERMINATION') {
                return 'HLS300F21';
            }
        }

        function get_execute_code(execute_type) {
            if (execute_type == 'ET') {
                return 'HLS400F3';
            } else if (execute_type == 'PREPAYMENT') {
                return 'HLS400F4';
            } else if (execute_type == 'RELEASE') {
                return 'HLS400F5';
            } else if (execute_type == 'REPURCHASE') {
                return 'HLS400F6';
            } else if (execute_type == 'FINANCIAL_TERMS') {
                return 'HLS400F8';
            } else if (execute_type == 'DEPOSIT') {
                return 'HLS300F5';
            }else if (execute_type == 'CON_TERMINATION') {
                return 'HLS300F21';
            }else {
                return 'HLS400F2';
            }

        }


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var duration_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'G_DURATION')
            var execute_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'G_EXECUTE')
            //申请查询 暂时限制只有业务变更可以查询到
            if (duration_ds_id == ds.id) {
                qpara['execute_flag'] = 'N';
                qpara['duration_status'] = 'APPROVED';
                qpara['duration_flag'] = 'Y';
                qpara['apply_person'] = '${/session/@user_id}';
                qpara['duration_type'] = 'BUSINESS_CHANGE';
            }
            if (execute_ds_id == ds.id) {
                qpara['execute_flag'] = 'Y';
                qpara['apply_person'] = '${/session/@user_id}';
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
