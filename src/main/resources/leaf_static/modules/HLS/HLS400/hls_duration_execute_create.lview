<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年6月22日
    $Revision: 1.0
    $Purpose: 存续期执行-创建界面（合同变更创建）
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>

    <a:view>
        <a:link id="${/parameter/@layout_code}_modify_id"
                url="${/request/@context_path}/modules/HLS/HLS400/hls_duration_execute_modify.lview"/>


        <script><![CDATA[
        var duration_type = '${/parameter/@duration_type}';
        var function_code;
        //取消执行方案
        /*window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/hls/duration/execute/cancel",
                para: {
                    hd_id: '${/parameter/@hd_id}'
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $('${/parameter/@winid}').close();
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });
        };*/

        //下一步
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            //根据存续期方案不同 进入不同的动态界面
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var record = $(ds_id).getAt(0);
            var param = {};
            if ($(ds_id).validate()) {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/hls/duration/prjContract/check',
                    para: {
                        projectId: record.get('project_id'),
                        durationType:duration_type,
                    },
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        if(res.result.record[0] == 'Y'){
                            Leaf.request({
                                url: "${/request/@context_path}/hls/duration/execute/create",
                                para: record.data,
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    var hd_id = res.result.record[0].hd_id;
                                    var execute_type = res.result.record[0].execute_type;
                                    param['url_title'] = '明细';
                                    param['function_code'] = function_code;
                                    param['duration_type'] = duration_type;
                                    param['execute_type'] = execute_type;
                                    param['hd_id'] = hd_id;
                                    param['project_id'] = record.get('project_id');
                                    param['contract_id'] = record.get('contract_id');
                                    param['function_usage'] = 'CREATE';
                                    param['winid'] = '${/parameter/@layout_code}_execute_modify_winid';
                                    hls_doc_get_layout_code(param, '${/parameter/@layout_code}_modify_id', ds_id, 'HLS400F1','${/parameter/@winid}','Y');
                                },
                                error: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                failure: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                sync: true,
                                scope: this
                            });
                        }else if(res.result.record[0] == 'N_LEASE'){
                            Leaf.showMessage('提示','存在与该合同下的租赁物挂钩的合同正在走存续期或合同变更！');
                        }else if(res.result.record[0] =='N_MORTGAGE'){
                            Leaf.showMessage('提示','存在与该合同下的抵质押物挂钩的合同正在走存续期或合同变更！');
                        }

                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd','F_BASE_INFO');
            if (ds_id == ds.id) {
                //新增时初始化
                record.set('hd_id', '${/parameter/@hd_id}');
                record.set('apply_date', Leaf.dateFormat.format(new Date('${/model/default_value/record/@now_date}'), 'isoDate'));
                if (record.get('duration_type') == 'ET' || record.get('duration_type') == 'PREPAYMENT' || record.get('duration_type') == 'RELEASE' || record.get('duration_type') == 'REPURCHASE') {
                    record.getField('prj_con_id_n').setReadOnly(true);
                    record.getField('prj_con_id').setRequired(false);
                    record.getField('prj_con_id_n').setRequired(false);
                    record.set('prj_con_id', '${/parameter/@prj_con_id}');
                    record.set('prj_con_id_n', '${/parameter/@prj_con_id_n}');
                    record.set('project_name', '${/parameter/@project_name}');
                } else {
                    record.getField('prj_con_id_n').setReadOnly(false);
                    record.getField('prj_con_id').setRequired(true);
                    record.getField('prj_con_id_n').setRequired(true);
                    record.set('prj_con_id_n', '');
                    record.set('project_name', '');
                }
            }
        };


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        Leaf.onReady(function () {
            debugger;
            if (duration_type == 'ET') {
                function_code = 'HLS400F3';
            } else if (duration_type == 'PREPAYMENT') {
                function_code = 'HLS400F4';
            } else if (duration_type == 'RELEASE') {
                function_code = 'HLS400F5';
            } else if (duration_type == 'REPURCHASE') {
                function_code = 'HLS400F6';
            } else if(duration_type=='BUSINESS_CHANGE'){
                function_code = 'HLS400F8';
            } else {
                function_code = 'HLS400F2';
            }
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>



