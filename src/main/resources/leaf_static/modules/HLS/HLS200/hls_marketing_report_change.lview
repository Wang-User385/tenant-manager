<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                }
                else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        };


        function urlSearch(url) {
            var obj = {};
            var name, value;
            var str = url; //取得整个地址栏
            var num = str.indexOf("?");
            str = str.substr(num + 1); //取得所有参数   stringvar.substr(start [, length ]

            var arr = str.split("&"); //各个参数放到数组里
            for (var i = 0; i < arr.length; i++) {
                num = arr[i].indexOf("=");
                if (num > 0) {
                    name = arr[i].substring(0, num);
                    value = arr[i].substr(num + 1);
                    obj[name] = value;
                }
            }
            return obj;
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var win = new Leaf.Window({
                id: 'hls200_bp_create_win_id',
                url: "${/request/@context_path}/modules/BP/BP100/bp_master_select.lview",
                params: {
                    winid: 'hls200_bp_create_win_id'
                },
                title: '客户信息创建',
                fullScreen: true
            });
            win.on('close', function () {

            });
        };
        window['${/parameter/@layout_code}_attachment_detail'] = function (record_id, name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            var currentRecord = $(ds_id).getCurrentRecord();
            var function_usage = '${/parameter/@function_usage}';
            var status = currentRecord.get('status');
            var change_req_id = currentRecord.get('change_req_id');

            if (record.get('marketing_attachment_id')) {
                var url;
                url = '${/request/@context_path}/uploadFileHistory.lview';

                if(record.get('status') == 'APPROVED'){
                    function_usage = 'QUERY';

                }

                var win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('marketing_attachment_id'),
                        document_id: change_req_id,
                        document_category: '${/parameter/@document_category}',
                        table_name: 'hls_report_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: function_usage
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
                    $(attachment_ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = '${/parameter/@layout_code}_attachment_detail';
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            var bp_records = $(bp_ds_id).getAll();

            /*for (var i = 0; i < bp_records.length; i++) {
                if(bp_records[i].get('status') != 'APPROVED'){
                    if(name == 'bp_code'&&bp_records[i].get('bp_code')){
                        return '<h style="color: red">' + bp_records[i].get('bp_code') + '</h>';
                    }
                }
            }*/
            if(name == 'bp_code'){
                if(record.get('status') != 'APPROVED' && record.get('bp_code')!= undefined){
                    return '<h style="color: red">' + record.get('bp_code')|| '' + '</h>';
                }
            }
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'attachment_detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + config_record.get('prompt') + '</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }


            return value;
        };
        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            $(ds_id).setQueryParameter('marketing_report_id', $(ds_id).getAt(0).get("marketing_report_id"));
            $(ds_id).query();
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            $(bp_ds_id).query();
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            $(att_ds_id).query();

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_channel');
            if(ds.id ===ds_id){
                if(name === 'marketing_channel'){
                    if(record.get('marketing_channel') == 'BRANCH_RECOMMENDATION'||record.get('marketing_channel') == 'INTEGRATED_MARKETING'){
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setRequired(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setRequired(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setReadOnly(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setReadOnly(false);
                        $(ds_id).getCurrentRecord().getField('source_marketing_channel').setRequired(false);
                    }else{
                        $(ds_id).getCurrentRecord().set('xy_branch_bank','');
                        $(ds_id).getCurrentRecord().set('xy_branch_bank_n','');
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setRequired(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setRequired(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setReadOnly(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setReadOnly(true);
                        $(ds_id).getCurrentRecord().getField('source_marketing_channel').setRequired(true);
                    }
                }

            }
            if (ds.id === basic_ds_id) {
                if(name == 'assist_unit_id'){
                    if(record.data.host_unit_id == value){
                        record.set('host_department_proportion',1);
                        record.set('host_department_proportion_r',1);
                        $(basic_ds_id).getCurrentRecord().getField('host_department_proportion').setReadOnly(true);
                        $(basic_ds_id).getCurrentRecord().getField('host_department_proportion_r').setReadOnly(true);
                    }else{
                        record.set('host_department_proportion','');
                        record.set('assist_department_proportion','');
                        record.set('host_department_proportion_r','');
                        record.set('assist_department_proportion_r','');
                        $(basic_ds_id).getCurrentRecord().getField('host_department_proportion').setReadOnly(false);
                        $(basic_ds_id).getCurrentRecord().getField('host_department_proportion_r').setReadOnly(false);
                    }
                }
                if (name === 'host_department_proportion'&&value) {
                    record.set('assist_department_proportion',1-record.get('host_department_proportion'));
                }
                if (name === 'host_department_proportion_r' && value) {
                    record.set('assist_department_proportion_r',1-record.get('host_department_proportion_r'));
                }
                if(name === 'revenue_sharing_base' && value === '30'){
                    record.getField('revenue_sharing_base_bc').setReadOnly(false);
                }else if(name === 'revenue_sharing_base' && value !== '30'){
                    record.getField('revenue_sharing_base_bc').setReadOnly(true);
                    record.set('revenue_sharing_base_bc',null);
                }
            }

            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            if (ds.id === bp_ds_id) {
                if (name === 'bp_class') {
                    if(value != 'NP'){
                        record.getField('assets_total').setRequired(true);
                        record.getField('liabilities_total').setRequired(true);
                        record.getField('asset_liability_ratio').setRequired(true);
                        record.getField('sales_revenue').setRequired(true);
                        record.getField('profit_total').setRequired(true);
                        record.getField('retained_profits').setRequired(true);
                    }else{
                        record.getField('assets_total').setRequired(false);
                        record.getField('liabilities_total').setRequired(false);
                        record.getField('asset_liability_ratio').setRequired(false);
                        record.getField('sales_revenue').setRequired(false);
                        record.getField('profit_total').setRequired(false);
                        record.getField('retained_profits').setRequired(false);
                    }
                }
                if(name == 'liabilities_total'){
                    if(record.get('assets_total') != null){
                        record.set('asset_liability_ratio',div(value,record.get('assets_total')));
                    }
                }
            }
        };
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function() {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    if ($(ds_id).validate()) {
                        var record = $(ds_id).data[0].data;
                        var change_req_id = record.change_req_id;
                        if (change_req_id != null) {
                            new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                                Leaf.request({
                                    url: '${/request/@context_path}/marketing/report/change/submit',
                                    para: {
                                        change_req_id: change_req_id,
                                    },
                                    success: function (res) {
                                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                        if (res.success) {
                                            Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '申请提交成功', function () {
                                                if ('${/parameter/@winid}') {
                                                    $("${/parameter/@winid}").close();
                                                } else {
                                                    location.href = '${/request/@context_path}/user_role_home_page.lview';
                                                    parent.shMenu('show');
                                                }
                                            });

                                        } else {
                                            Leaf.showErrorMessage('提示', res.message);
                                        }
                                    },
                                    failure: function () {
                                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    },
                                    error: function () {
                                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    },
                                    scope: this
                                });
                            }, function cancel() {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            }, 200, 100);
                        } else {
                            $L.showInfoMessage("提示", "请先保存!", null);
                        }
                    }
                })

        }
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }

            if (ds.submiturl) {
                var submitUrl = ds.submiturl;
                if (submitUrl.indexOf('document_history_flag') === -1) {
                    var obj = urlSearch(submitUrl);
                    obj.document_id = documentId;
                    obj.document_history_flag = 'Y';
                    obj.document_category = documentCategory;
                    submitUrl = submitUrl.split('?')[0];
                    for (var k in obj) {
                        submitUrl = splitparameter(submitUrl, k, obj[k]);
                    }
                }
                ds.submiturl = submitUrl;
            }
        };


        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }
            if (ds.submiturl) {
                var submitUrl = ds.submiturl;
                if (submitUrl.indexOf('document_history_flag') === -1) {
                    var obj = urlSearch(submitUrl);
                    obj.document_id = documentId;
                    obj.document_history_flag = 'Y';
                    obj.document_category = documentCategory;
                    submitUrl = submitUrl.split('?')[0];
                    for (var k in obj) {
                        submitUrl = splitparameter(submitUrl, k, obj[k]);
                    }
                }
                ds.submiturl = submitUrl;
            }
        };
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
                var documentId = '${/parameter/@change_req_id}';
                var documentCategory = '${/parameter/@document_category}';

            var submitUrl = $('${/parameter/@layout_code}_virtual_ds').submiturl;
            if (submitUrl.indexOf('document_history_flag') === -1) {
                submitUrl = splitparameter(
                    splitparameter(
                        splitparameter(submitUrl, 'document_id', documentId),
                        'document_history_flag', 'Y'),
                    'document_category', documentCategory);
            }
            $('${/parameter/@layout_code}_virtual_ds').submiturl = submitUrl;
            return true;
        };
        //取消申请
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            new Leaf.showConfirm('${l:HLS.PROMPT}', '确认取消申请吗？', function okFun() {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');

                var record = $(ds_id).data[0].data;
                var change_req_id = record.change_req_id;
                Leaf.request({
                    url: '${/request/@context_path}/marketing/report/change/cancel',
                    para: {change_req_id: change_req_id},
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        if (res.success) {
                            $('${/parameter/@winid}').close();
                            Leaf.showMessage('提示', '申请取消!');
                        }
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }
                });
            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100);

        };
        // 删除前校验
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq){
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');

            var flag = true;
            if(ds.id == bp_ds_id){

                if(record[0].get('status') == 'APPROVED'){
                    Leaf.showMessage('提示', '不能删除该单据');
                    flag = false;
                }
            }
            if(ds.id == att_ds_id){
                var selectData = $(att_ds_id).getSelected();

                for (var i = 0; i < selectData.length; i++) {

                    if(record[0].get('status') == 'APPROVED'){
                        Leaf.showMessage('提示', '不能删除该单据');
                        flag = false;
                    }
                }


            }
            return flag;
        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');

            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            if (ds.id === bp_ds_id) {
                if(record.get('status') == 'APPROVED') {
                    record.getField('bp_id').setReadOnly(true);
                    record.getField('bp_id_n').setReadOnly(true);
                    record.getField('assets_total').setReadOnly(true);
                    record.getField('liabilities_total').setReadOnly(true);
                    record.getField('asset_liability_ratio').setReadOnly(true);
                    record.getField('sales_revenue').setReadOnly(true);
                    record.getField('profit_total').setReadOnly(true);
                    record.getField('retained_profits').setReadOnly(true);
                    record.getField('customer_profile').setReadOnly(true);
                }
                else if(record.get('bp_class') != 'NP'){
                    record.getField('assets_total').setRequired(true);
                    record.getField('liabilities_total').setRequired(true);
                    record.getField('asset_liability_ratio').setRequired(true);
                    record.getField('sales_revenue').setRequired(true);
                    record.getField('profit_total').setRequired(true);
                    record.getField('retained_profits').setRequired(true);
                }else{
                    record.getField('assets_total').setRequired(false);
                    record.getField('liabilities_total').setRequired(false);
                    record.getField('asset_liability_ratio').setRequired(false);
                    record.getField('sales_revenue').setRequired(false);
                    record.getField('profit_total').setRequired(false);
                    record.getField('retained_profits').setRequired(false);
                }

                /*$L.onReady(function () {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    var bp_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp', 'F_CUSTOMER_INFO');
                    if (ds.id == bp_info_ds_id) {
                        var bp_info_records = $(bp_info_ds_id).getAll();
                        var function_code = '${/parameter/@function_code}';
                        setTimeout(function () {
                            for (var i = 0; i < bp_info_records.length; i++) {
                                Ext.fly(function_code +"_F_CUSTOMER_INFO_hls_marketing_report_bp_layout_grid_id_customer_profile_" + bp_info_records[i].id).setStyle({height:'75px'});
                                // Ext.fly("HLS200F3_F_CUSTOMER_INFO_hls_marketing_report_bp_layout_grid_id_customer_profile_" + bp_info_records[i].id).setStyle({height:'75px'});

                            }
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }, 3000);
                    }
                });*/

            }
            if(ds.id == att_ds_id && record ) {
                var status = record.get('status');
                // 非新建或非审批拒绝的单据设置只读
                if(status== 'APPROVED') {
                    for (var i = 0; i < config_records.length; i++) {
                        var column_name = config_records[i].data.column_name;
                        var validation_type = config_records[i].data.validation_type;
                        record.getField(column_name).setReadOnly(true);
                        record.getField(column_name).setRequired(false);
                        if (validation_type == 'COMBOBOX' || validation_type == 'LOV_D') {
                            record.getField(column_name + '_n').setReadOnly(true);
                            record.getField(column_name + '_n').setRequired(false);
                        }
                    }
                }
            }



        }
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            if(ds.id === ds_id){
                record.set('upload_person','${/session/@user_id}');
                record.set('upload_date',new Date());
            }
            /*var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            if (ds.id === bp_ds_id) {
                $L.onReady(function () {
                    // window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    var bp_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp', 'F_CUSTOMER_INFO');
                    if (ds.id == bp_info_ds_id) {
                        var bp_info_records = $(bp_info_ds_id).getAll();
                        var function_code = '${/parameter/@function_code}';
                        setTimeout(function () {
                            for (var i = 0; i < bp_info_records.length; i++) {
                                Ext.fly(function_code + "_F_CUSTOMER_INFO_hls_marketing_report_bp_layout_grid_id_customer_profile_" + bp_info_records[i].id).setStyle({height: '75px'});
                            }
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }, 2000);
                    }
                });
            }*/
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>