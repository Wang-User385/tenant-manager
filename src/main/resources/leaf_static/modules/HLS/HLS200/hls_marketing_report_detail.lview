<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjQuotationService.queryBaseRateNow"
                       rootPath="quote_record_path"/>
        <a:model-query model="$com.hand.hls.hls.service.HlsCusHlsMarketingReportService.queryMarketingReport"
                       rootPath="report_record_path"/>
    </a:init-procedure>
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"></script>
        <a:link id="hls200_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="hls200_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script><![CDATA[
        Leaf.onReady(function() {

            if('${/parameter/@function_usage}' == 'CREATE'){
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                var record = $(ds_id).getCurrentRecord();
                record.set('unit_id','${/session/@unitId}');
                record.set('unit_id_n','${/session/@unitName}');
                record.set('host_unit_id','${/session/@unitId}');
                record.set('host_unit_name','${/session/@unitName}');
                record.set('host_project_manager','${/session/@userId}');
                record.set('host_project_manager_n','${/parameter/@user_name}');
                var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
                $(bp_ds_id).create();
            }
            // var index=$(bp_ds_id).indexOf($(bp_ds_id).getCurrentRecord());
            // $(bp_ds_id).showEditorByRecord(2,$(bp_ds_id).create(index+1));


            //${/model/header/record/@header_id}

        });
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //忽略保存校验方法
        window['${/parameter/@layout_code}_ignore_required_before_save'] = function() {
            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
        };

        //业务意向书生成 获取文档文办 pkvalue
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report','F_BASIC_INFO');
            if($(ds_id).validate()){
                var record = $(ds_id).getCurrentRecord();
                if(record.get('marketing_report_id') && record.get('marketing_report_id') != null && record.get('marketing_report_id') != '' ){
                    var source_pk_value = record.get('source_pk_value');
                     if(!(source_pk_value && source_pk_value != null && source_pk_value!= '' )) {//判断是否已生成 不重复生成
                        Leaf.Masker.mask(Ext.getBody(), '正在生成文本...');
                        Leaf.request({
                            url: "${/request/@context_path}/hls/marketing/create/content",
                            para: {marketing_report_id: record.get('marketing_report_id')},
                            success: function (res) {
                                console.log(res);
                                $(ds_id).query();
                                var source_pk_value = res.result.record[0].source_pk_value;
                                if (source_pk_value == 'undefined' || source_pk_value == '' || source_pk_value == null) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.showInfoMessage('未找到模板!');
                                    return;
                                } else {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    // Leaf.showInfoMessage('合同文本生成成功!');
                                    var ds_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment','G_ATTACHMENT');
                                    $(ds_att).query();
                                    editOffice(source_pk_value);
                                }
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    }else{
                         editOffice(source_pk_value);
                    }
                }else{
                    $L.showInfoMessage("提示","请先保存再生成合同文本!");
                }
            }
        };
        // 在线编辑
        function editOffice(source_pk_value){
            //查看
            if(source_pk_value){
                if('${/parameter/@function_usage}' == 'QUERY'){
                    window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
                }else{
                    //编辑
                    // window.open("${/request/@context_path}/sys/office/edit?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
                    //修订模式
                    window.open("${/request/@context_path}/sys/office/review?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
                }
            }else{
                $L.showInfoMessage("提示","合同文本不存在，请先生成合同文本!");
            }

            //转PDF
            // window.open(/sys/office/convert?sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=15961', '_blank');
        }

        window['upload_file'] = function(record_id,marketing_attachment_id,ds_id,table){
            var record = $(ds_id).findById(record_id);
            var tableName;
            if(record.get('attachment_category') === 'HLS_MARKETING_REPORT_DOCX'){
                tableName = 'HLS_MARKETING_REPORT_DOCX';
            }else{
                tableName = 'hls_report_attachment';
            }
            if(table){
                tableName = table;
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            var base_record = $(ds_id).getCurrentRecord();
            var marketing_report_id = base_record.get('marketing_report_id');
            if(marketing_report_id == null){
                $L.showInfoMessage("提示","请先保存再上传附件!");
                return;
            }
            if(marketing_attachment_id == null){
                $L.showInfoMessage("提示","请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY'||'${/parameter/@end_flag}' == 'Y') {

                url = '${/request/@context_path}/modules/HLS/HLS200/downloadFileCopy.lview';
            } else {
                if(record.get('attachment_category') === 'HLS_MARKETING_REPORT_DOCX') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/uploadFile.lview';
                }else {
                    url = '${/request/@context_path}/uploadFile.lview';
                }
            }
            var win = new Leaf.Window({
                id: 'hls200_open_attachment_winid',
                url: url,
                params: {
                    'header_id': marketing_attachment_id,
                    'table_name': tableName,
                    winid: 'hls200_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                debugger;
                var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
                var hls_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                $(hls_ds_id).query();
                $(document_list_ds_id).query();
            });
        };

        window['bpDetail'] = function(record_id,bp_id,ds_id){
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户信息明细';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function ;
            if (name == 'attachment_detail' && record.get('marketing_attachment_id')){
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('marketing_attachment_id') + '\',\'' + record.ds.id + '\');">附件</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }
            if (name == 'bp_detali' && record.get('bp_id')&& !record.isNew){
                link_function = 'bpDetail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('bp_id') + '\',\'' + record.ds.id + '\');">客户明细</a>';
            }
            return value;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            $(ds_id).setQueryParameter('marketing_report_id', $(ds_id).getAt(0).get("marketing_report_id"));
            // $(ds_id).query();
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            // $(bp_ds_id).query();
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            // $(att_ds_id).query();
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            // $(quotation_ds_id).query();

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var apply_leasing_products;
            if(ds.id === prj_ds_id){
                if(name === 'int_rate_type'){
                    if(record.get('int_rate_type') == 'FLOATING'){
                        $(prj_ds_id).getCurrentRecord().getField('base_rate').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect').setReadOnly(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect_n').setReadOnly(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect').setRequired(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect_n').setRequired(true);
                        // $(prj_ds_id).getCurrentRecord().set('base_rate_collect','');
                        // $(prj_ds_id).getCurrentRecord().set('base_rate_collect_n','');
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type').setReadOnly(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type_n').setReadOnly(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type').setRequired(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type_n').setRequired(true);
                        // $(prj_ds_id).getCurrentRecord().set('base_rate_type','');
                        // $(prj_ds_id).getCurrentRecord().set('base_rate_type_n','');
                        $(prj_ds_id).getCurrentRecord().getField('floating_way_rate').setReadOnly(false);
                        // $(prj_ds_id).getCurrentRecord().set('floating_way_rate','');
                    }else{
                        $(prj_ds_id).getCurrentRecord().getField('base_rate').setReadOnly(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect_n').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect').setRequired(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_collect_n').setRequired(false);
                        $(prj_ds_id).getCurrentRecord().set('base_rate_collect','');
                        $(prj_ds_id).getCurrentRecord().set('base_rate_collect_n','');
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type_n').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type').setRequired(false);
                        $(prj_ds_id).getCurrentRecord().getField('base_rate_type_n').setRequired(false);
                        $(prj_ds_id).getCurrentRecord().set('base_rate_type','');
                        $(prj_ds_id).getCurrentRecord().set('base_rate_type_n','');
                        $(prj_ds_id).getCurrentRecord().getField('floating_way_rate').setReadOnly(true);
                        $(prj_ds_id).getCurrentRecord().set('floating_way_rate','');


                    }
                }
                var base_rate = $(prj_ds_id).getCurrentRecord().get('base_rate');
                var floating_way_rate = $(prj_ds_id).getCurrentRecord().get('floating_way_rate');
                if(name === 'floating_way_rate'){
                    if(floating_way_rate != null && base_rate != null){
                        //年利率=基准利率+利率浮动制（bp）*0.01%
                        $(prj_ds_id).getCurrentRecord().set('int_rate',plus(base_rate,div(floating_way_rate,10000)));
                    }
                }
                if(name === 'base_rate'){
                    if(floating_way_rate != null && base_rate != null){
                        //年利率=基准利率+利率浮动制（bp）*0.01%
                        $(prj_ds_id).getCurrentRecord().set('int_rate',plus(base_rate,div(floating_way_rate,10000)));
                    }
                    if(floating_way_rate == null && base_rate != null){
                        $(prj_ds_id).getCurrentRecord().set('int_rate',base_rate);
                    }
                }
                if(name === 'lease_item_amount_org'){
                    if($(prj_ds_id).getCurrentRecord().get('lease_item_amount_org') != null && $(prj_ds_id).getCurrentRecord().get('exchange_rate')  != null){
                        $(prj_ds_id).getCurrentRecord().set('lease_item_amount',$(prj_ds_id).getCurrentRecord().get('lease_item_amount_org') * $(prj_ds_id).getCurrentRecord().get('exchange_rate'));
                    }
                }
                if(name === 'exchange_rate'){
                    if($(prj_ds_id).getCurrentRecord().get('lease_item_amount_org') != null && $(prj_ds_id).getCurrentRecord().get('exchange_rate')  != null){
                        $(prj_ds_id).getCurrentRecord().set('lease_item_amount',$(prj_ds_id).getCurrentRecord().get('lease_item_amount_org') * $(prj_ds_id).getCurrentRecord().get('exchange_rate'));
                    }
                }
            }
            var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report','F_BASIC_INFO');
            var quo_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','F_FORM');
            if(ds.id === report_ds_id) {
                if (name === 'credit_flag' && value && $(report_ds_id).getCurrentRecord().get('credit_flag') ==='Y') {
                    $(report_ds_id).getCurrentRecord().getField('credit_note').setRequired(true);
                    $(report_ds_id).getCurrentRecord().getField('credit_note').setReadOnly(false);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products').setRequired(false);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setRequired(false);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products').setReadOnly(true);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setReadOnly(true);
                    $(report_ds_id).getCurrentRecord().set('apply_leasing_products','COMP_CREDIT');
                    $(report_ds_id).getCurrentRecord().set('apply_leasing_products_n','综合授信');
                    $(quo_ds_id).getCurrentRecord().set('business_type','COMP_CREDIT');
                    $(quo_ds_id).getCurrentRecord().set('business_type_n','综合授信');
                }
                if (name === 'credit_flag_n' && value && value === '否') {
                    $(report_ds_id).getCurrentRecord().getField('credit_note').setRequired(false);
                    $(report_ds_id).getCurrentRecord().getField('credit_note').setReadOnly(true);
                    $(report_ds_id).getCurrentRecord().set('credit_note','');
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products').setRequired(true);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setRequired(true);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products').setReadOnly(false);
                    $(report_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setReadOnly(false);
                    $(report_ds_id).getCurrentRecord().set('apply_leasing_products','');
                    $(report_ds_id).getCurrentRecord().set('apply_leasing_products_n','');
                    $(quo_ds_id).getCurrentRecord().set('business_type','');
                    $(quo_ds_id).getCurrentRecord().set('business_type_n','');
                }
                if(name === 'apply_leasing_products' && value){
                    $(quo_ds_id).getCurrentRecord().set('business_type',value);
                }
                if(name === 'apply_leasing_products_n' && value){
                    $(quo_ds_id).getCurrentRecord().set('business_type_n',value);
                }
            }

        };
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if('${/parameter/@function_usage}' != 'QUERY' && '${/parameter/@end_flag}' != 'Y') {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_channel');
                var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_FORM');
                if (ds.id === base_ds_id) {
                    if(record.get('revenue_sharing_base') === null || record.get('revenue_sharing_base') === undefined || record.get('revenue_sharing_base') !== '30'){
                        record.getField('revenue_sharing_base_bc').setReadOnly(true);
                    }else if (record.get('revenue_sharing_base') === '30'){
                        record.getField('revenue_sharing_base_bc').setReadOnly(false);
                    }
                    if(record.get('credit_flag') === 'Y'){
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products').setRequired(false);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setRequired(false);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products').setReadOnly(true);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setReadOnly(true);
                        $(base_ds_id).getCurrentRecord().getField('credit_note').setRequired(true);
                        $(base_ds_id).getCurrentRecord().getField('credit_note').setReadOnly(false);
                    }
                    if(record.get('credit_flag') === 'N'){
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products').setRequired(true);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setRequired(true);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products').setReadOnly(false);
                        $(base_ds_id).getCurrentRecord().getField('apply_leasing_products_n').setReadOnly(false);
                        $(base_ds_id).getCurrentRecord().getField('credit_note').setRequired(false);
                        $(base_ds_id).getCurrentRecord().getField('credit_note').setReadOnly(true);
                    }
                }
                var quote_record = $(quote_ds_id).getCurrentRecord();
                if(ds.id === quote_ds_id && '${/parameter/@function_usage}' != 'CREATE') {
                    if(record.get('int_rate_type') != 'FLOATING'){
                        quote_record.getField('base_rate').setReadOnly(false);
                        quote_record.getField('base_rate_collect').setReadOnly(true);
                        quote_record.getField('base_rate_collect_n').setReadOnly(true);
                        quote_record.getField('base_rate_collect').setRequired(false);
                        quote_record.getField('base_rate_collect_n').setRequired(false);
                        quote_record.set('base_rate_collect', '');
                        quote_record.set('base_rate_collect_n', '');
                        quote_record.getField('base_rate_type').setReadOnly(true);
                        quote_record.getField('base_rate_type_n').setReadOnly(true);
                        quote_record.getField('base_rate_type').setRequired(false);
                        quote_record.getField('base_rate_type_n').setRequired(false);
                        quote_record.set('base_rate_type', '');
                        quote_record.set('base_rate_type_n', '');
                        quote_record.getField('floating_way_rate').setReadOnly(true);
                        quote_record.set('floating_way_rate', '');
                    }
                }
                if('${/parameter/@function_usage}' == 'CREATE' && ds.id === quote_ds_id) {
                    //页面加载报价字段默认值
                    if (quote_record && ($(base_ds_id).getCurrentRecord().get('marketing_report_id') == '' || $(base_ds_id).getCurrentRecord().get('marketing_report_id') == undefined)) {
                        quote_record.set('int_rate_type', 'FLOATING');
                        quote_record.set('int_rate_type_n', '浮动利率');
                        quote_record.set('base_rate_collect', '${/model/quote_record_path/record/@base_rate_set}');
                        quote_record.set('base_rate_collect_n', '${/model/quote_record_path/record/@base_rate_description1}');
                        quote_record.set('base_rate_type', '${/model/quote_record_path/record/@base_rate_description2}');
                        quote_record.set('base_rate_type_n', '${/model/quote_record_path/record/@base_rate_description2}');
                        quote_record.set('base_rate', '${/model/quote_record_path/record/@base_rate}');
                        quote_record.set('int_rate', '${/model/quote_record_path/record/@base_rate}');
                    }
                }
            }
        };


        //保存前调用获取编码 并提前获取 marketing_report_id
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            var marketing_report_number = $(ds_id).getCurrentRecord().get('marketing_report_number');
            var marketing_report_id = $(ds_id).getCurrentRecord().get('marketing_report_id');
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quo_reocrd = $(quotation_ds_id).getCurrentRecord();
            //用于报价保存
            if (marketing_report_id == null && check_flag){
                // marketing_report_id = "${/model/report_record_path/record/@marketingReportId}";
                Leaf.request({
                    url: "${/request/@context_path}/hls/marketing/report/id",
                    para: {
                        host_project_manager : '${/session/@userId}'
                    },
                    success: function (res) {
                        debugger;
                        marketing_report_id = res.result.record[0].marketing_report_id;
                        $(ds_id).getCurrentRecord().set('marketing_report_id', marketing_report_id);
                        quo_reocrd.set('document_id', marketing_report_id);
                        quo_reocrd.set('source_document_id', marketing_report_id);
                        quo_reocrd.set('source_document_category', 'HLS_MARKETING_REPORT');
                    },
                    error: function () {
                        check_flag = false;
                        Leaf.showMessage("提示", "保存出错!", null);
                    },
                    sync: true,
                    scope: this
                });

            }
            var bp_records = $(bp_ds_id).getAll();
            var k = 0;
            var m = 0;
            //项目类型
            var business_type = $(ds_id).getCurrentRecord().get("apply_leasing_products");
            //
            if(business_type=='LEASE_WITHOUT_RECOURSE_IN'||business_type=='OPERATING_LEASE_WITHOUT_RECOURSE_IN'){
                for (var i = 0; i < bp_records.length; i++) {
                    for (var j = 0; j < bp_records.length; j++) {
                        if(bp_records[i].get('bp_id') == bp_records[j].get('bp_id')
                            &&bp_records[i].get('bp_type') == bp_records[j].get('bp_type')){
                            k++;
                        }
                    }
                    //资产转让方
                    if( bp_records[i].get('bp_type') == "ASSET_TRANSFEROR"){
                        m++;
                    }
                }
                if(k>bp_records.length){
                    Leaf.showMessage('提示','同一角色的客户不能添加多次');
                    check_flag =false;

                }
                if(m>1){
                    Leaf.showMessage('提示','资产转让方有且只能有一个！');
                    check_flag =false;
                }
                if(m == 0){
                    Leaf.showMessage('提示','必须维护一个资产转让方！');
                    check_flag =false;

                }
                //
            }else if(business_type=='T+0_LEASE_FACTORING'||business_type=='T+N_LEASE_FACTORING'){
                for (var i = 0; i < bp_records.length; i++) {
                    for (var j = 0; j < bp_records.length; j++) {
                        if(bp_records[i].get('bp_id') == bp_records[j].get('bp_id')
                            &&bp_records[i].get('bp_type') == bp_records[j].get('bp_type')){
                            k++;
                        }
                    }
                    //应收账款债权人
                    if( bp_records[i].get('bp_type') == "ACCOUNTS_RECEIVABLE"){
                        m++;
                    }
                }
                if(k>bp_records.length){
                    Leaf.showMessage('提示','同一角色的客户不能添加多次');
                    check_flag =false;

                }
                if(m>1){
                    Leaf.showMessage('提示','应收账款债权人有且只能有一个！');
                    check_flag =false;
                }
                if(m == 0){
                    Leaf.showMessage('提示','必须维护一个应收账款债权人！');
                    check_flag =false;

                }
                //
            }else{
                for (var i = 0; i < bp_records.length; i++) {
                    for (var j = 0; j < bp_records.length; j++) {
                        if(bp_records[i].get('bp_id') == bp_records[j].get('bp_id')
                            &&bp_records[i].get('bp_type') == bp_records[j].get('bp_type')){
                            k++;
                        }
                    }
                    if( bp_records[i].get('bp_type') == "TENANT"){
                        m++;
                    }
                }
                if(k>bp_records.length){
                    Leaf.showMessage('提示','同一角色的客户不能添加多次');
                    check_flag =false;

                }
                if(m>1){
                    Leaf.showMessage('提示','承租人有且只能有一个！');
                    check_flag =false;
                }
                if(m == 0){
                    Leaf.showMessage('提示','必须维护一个承租人！');
                    check_flag =false;

                }
            }

            // for (var i = 0; i < bp_records.length; i++) {
            //     for (var j = 0; j < bp_records.length; j++) {
            //         if(bp_records[i].get('bp_id') == bp_records[j].get('bp_id')
            //             &&bp_records[i].get('bp_type') == bp_records[j].get('bp_type')){
            //             k++;
            //         }
            //     }
            //     if( bp_records[i].get('bp_type') == "TENANT"){
            //         m++;
            //     }
            // }
            // if(k>bp_records.length){
            //     Leaf.showMessage('提示','同一角色的客户不能添加多次');
            //     check_flag =false;
            //
            // }
            // if(m>1){
            //     Leaf.showMessage('提示','承租人有且只能有一个！');
            //     check_flag =false;
            // }
            // if(m == 0){
            //     Leaf.showMessage('提示','必须维护一个承租人！');
            //     check_flag =false;
            //
            // }
            if(marketing_report_number == null && check_flag){
                var document_category = 'HLS_MARKETING_REPORT';
                var document_type = 'HLS_MARKETING_REPORT';
                var business_type = 'HLS_MARKETING_REPORT';
                window['${/parameter/@layout_code}_set_authority_rule_string']();
                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type ,
                    success: function (res) {
                        $(ds_id).getCurrentRecord().set('marketing_report_number', res.result.record[0]);
                        check_flag = true;
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag =false;
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag =false;
                    },
                    sync: true,
                    scope: this
                });
            }
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        };



        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/hls/marketing/report/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        }


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            if(ds.id === ds_id){
                record.set('upload_person','${/session/@user_id}');
                record.set('upload_date',new Date());
            }
        }

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_F_FORM_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    if(marketing_report_id){
                        qpara['document_id'] = marketing_report_id;
                        qpara['source_document_id'] = marketing_report_id;
                    }else{
                        // qpara['document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        // qpara['source_document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        qpara['document_id'] = "-1";
                        qpara['source_document_id'] = "-1";
                    }
                    qpara['source_document_category'] = 'HLS_MARKETING_REPORT';
                    // qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    if(marketing_report_id){
                        qpara['document_id'] = marketing_report_id;
                        qpara['source_document_id'] = marketing_report_id;
                    }else{
                        // qpara['document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        // qpara['source_document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        qpara['document_id'] = "-1";
                        qpara['source_document_id'] = "-1";
                    }
                    qpara['source_document_category'] = 'HLS_MARKETING_REPORT';
                    // qpara['data_class'] = '';
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_BASIC_DATA_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    qpara['marketing_report_id'] = marketing_report_id;
                    break;
            }
        }
        //报价计算
        window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'] = function(func,calcFlag) {
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            var excelEdit = '${/parameter/@excel_edit}';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = url + '&readOnly=Y';
            }
            // 进入excel前打包数据存入excel
            var param = {};
            var data = $(quote_ds_id).getCurrentRecord();
            if (data) {
                // param = data[0];
                param = data.data;
            }
            if (calcFlag == 'N') {
                param['calc_flag'] = 'N';
            }
            //param带入excel
            Leaf.request({
                url: $('hls200_quotation_info_save_link_id').getUrl(),
                type: "POST",
                para: param,
                success: function (res) {
                    // Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                    if(typeof func == 'function'){
                        func();
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //报价计算入口
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            if(!$('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').validate()){
                return;
            }
            if(!$('${/parameter/@layout_code}_F_BASIC_INFO_hls_marketing_report_ds').getCurrentRecord().get('marketing_report_id')){
                Leaf.showErrorMessage('提示', '请先保存再计算报价！');
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'](function(){
                Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                Leaf.request({
                    url: $('hls200_quotation_calc_submit_link_id').getUrl() + "?quotationId="+quotation_id,
                    type: "GET",
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '计算成功',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        win.on('close', function () {
                            $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                            // $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
                        });
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            },'N');
        }

        //提交工作流
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            debugger;
            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function() {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report','F_BASIC_INFO');
                var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_FORM');
                var attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment', 'G_ATTACHMENT');
                if ($(ds_id).validate()) {
                    var record = $(ds_id).getCurrentRecord();
                    var quote_record = $(quote_ds_id).getCurrentRecord();
                    //var attch_record = $(attach_ds_id).getCurrentRecord();
                    var finance_amount = quote_record.get('finance_amount');
                    var marketing_report_id = record.get('marketing_report_id');
                    var attch_record = $(attach_ds_id).getAll();
                    var attachment_category = false;
                    for(var i=0;i<attch_record.length;i++){
                        if(attch_record[i].data.attachment_category=='HLS_MARKETING_REPORT_DOCX'){
                            attachment_category = true;
                            break;
                        }
                    }

                    if(record.get('apply_leasing_products')=='COMP_CREDIT'){
                        attachment_category = true;
                    }
                    if (marketing_report_id != null) {
                        if(finance_amount && finance_amount != null && finance_amount!= ''){
                            if(attachment_category){
                                new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                                    Leaf.request({
                                        url: '${/request/@context_path}/hls/marketing/report/approve/submit',
                                        para: {
                                            marketing_report_id: marketing_report_id,
                                        },
                                        success: function (res) {
                                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                            if (res.success) {
                                                Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '申请提交成功', function () {
                                                    if ('${/parameter/@winid}') {
                                                        $("${/parameter/@winid}").close();
                                                    } else {
                                                        location.href = '${/request/@context_path}/user_role_home_page.lview';
                                                        parent.shMenu('show');
                                                    }
                                                });

                                            } else {
                                                Leaf.showErrorMessage('提示', res.message);
                                            }
                                        },
                                        failure: function () {
                                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                        },
                                        error: function () {
                                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                        },
                                        scope: this
                                    });
                                }, function cancel() {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                }, 200, 100);
                            }else{
                                $L.showInfoMessage("提示", "请先生成方案报告书!", null);
                            }
                        }else{
                            $L.showInfoMessage("提示", "请先进行报价计算!", null);
                        }
                    } else {
                        $L.showInfoMessage("提示", "请先保存!", null);
                    }
                }
            })

        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>