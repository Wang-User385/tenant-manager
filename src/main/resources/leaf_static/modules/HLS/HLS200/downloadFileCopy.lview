<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: niujiaqing1265 $
    $Date: 2018/11/30 06:14:58 $
    $Revision: 1.8 $
    $Purpose: 系统级描述
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:s="leaf.plugin.script"
          trace="true">
    <a:init-procedure>
        <s:server-script><![CDATA[
            if($ctx.parameter.function_usage=='QUERY'){
            $ctx.parameter.show_delete='false';
            $ctx.parameter.show_upload='false';
            }else{
            $ctx.parameter.show_delete='true';
            $ctx.parameter.show_upload='true';
            }
            ]]></s:server-script>
    </a:init-procedure>
    <a:view >
        <script><![CDATA[
        Leaf.onReady(function () {
            if(document.getElementsByClassName('item-btn-upload')[0]){
                document.getElementsByClassName('item-btn-upload')[0].hidden='true';
            }
            if(document.getElementsByName('fileToUpload')[0]){
                document.getElementsByName('fileToUpload')[0].hidden='true';
            }
        });
        ]]></script>
        <a:screenBody>
            <div style="width:800px">
                <!--PROMPT.UPLOAD_ATTACHMENT-->
                <a:upload buttonWidth="75" fileType="*.*" pkvalue="${/parameter/@header_id}" showUpload="${/parameter/@show_upload}" showDelete="${/parameter/@show_delete}"
                          sourcetype="${/parameter/@table_name}" text="附件上传"  />
                <br/>
            </div>
            <br>
            <font color="red"><![CDATA[如不能正常显示，请安装Adobe Flash Player最新版本!]]></font>
            </br>
        </a:screenBody>
    </a:view>
</a:screen>
