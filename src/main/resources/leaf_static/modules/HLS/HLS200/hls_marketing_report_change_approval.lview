<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body{
                height:400px;
                width:1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="report_approve_link_id"
                url="${/request/@context_path}/modules/HLS/HLS200/hls_marketing_report_change.lview"/>
        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }
        var marketingReport = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "marketingReportId";
        })
        if(marketingReport.length>0){
            var marketing_report_id = marketingReport[0].value;
        }
        var pageChooser = new PageChooser({
            url: $('report_approve_link_id').getUrl(),
            function_code: 'HLS200F2',
            context_path: '${/request/@context_path}',
            opt: {
                change_req_id: businessKey,
                document_category: 'MARKETING_REPORT_CHANGE' ,
                document_type : 'MARKETING_REPORT_CHANGE',
                marketing_report_id : marketing_report_id,
                document_history_flag: 'Y',
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: 'HLS200F2',
                wfl_flag: "${/parameter/@wflRuleControlFlag}",
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

