<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjQuotationService.queryBaseRateNow"
                       rootPath="quote_record_path"/>
        <a:model-query model="$com.hand.hls.hls.service.HlsCusHlsMarketingReportService.queryMarketingReport"
                       rootPath="report_record_path"/>
    </a:init-procedure>
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"></script>
        <a:link id="hls200_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="hls200_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script><![CDATA[

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        //业务意向书生成 获取文档文办 pkvalue
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report','F_BASIC_INFO');
                var record = $(ds_id).getCurrentRecord();
                if(record.get('source_pk_value') && record.get('source_pk_value') != null && record.get('source_pk_value') != '' ){
                    var source_pk_value = record.get('source_pk_value');
                    editOffice(source_pk_value);
                }else{
                    $L.showInfoMessage("提示","请先生成业务意向书!");
                }
        };
        // 在线编辑
        function editOffice(source_pk_value){
            //查看
            if(source_pk_value){
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            }else{
                $L.showInfoMessage("提示","业务意向书不存在，请先生成业务意向书!");
            }
        }
        window['upload_file'] = function(record_id,marketing_attachment_id,ds_id,table){
            var record = $(ds_id).findById(record_id);
            var tableName;
            if(record.get('attachment_category') === 'HLS_MARKETING_REPORT_DOCX'){
                tableName = 'HLS_MARKETING_REPORT_DOCX';
            }else{
                tableName = 'hls_report_attachment';
            }
            if(table){
                tableName = table;
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            var base_record = $(ds_id).getCurrentRecord();
            var marketing_report_id = base_record.get('marketing_report_id');
            if(marketing_report_id == null){
                $L.showInfoMessage("提示","请先保存再上传附件!");
                return;
            }
            if(marketing_attachment_id == null){
                $L.showInfoMessage("提示","请先保存附件信息!");
                return;
            }
            var url;
            url = '${/request/@context_path}/modules/HLS/HLS200/downloadFileCopy.lview';
            var win = new Leaf.Window({
                id: 'hls200_open_attachment_winid',
                url: url,
                params: {
                    'header_id': marketing_attachment_id,
                    'table_name': tableName,
                    winid: 'hls200_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件查看下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
                $(document_list_ds_id).query();
            });
        };

        window['bpDetail'] = function(record_id,bp_id,ds_id){
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户信息明细';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function ;
            if (name == 'attachment_detail' && record.get('marketing_attachment_id')){
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('marketing_attachment_id') + '\',\'' + record.ds.id + '\');">附件</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }
            if (name == 'bp_detali' && record.get('bp_id')&& !record.isNew){
                link_function = 'bpDetail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('bp_id') + '\',\'' + record.ds.id + '\');">客户明细</a>';
            }
            return value;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
            $(ds_id).setQueryParameter('marketing_report_id', $(ds_id).getAt(0).get("marketing_report_id"));
            // $(ds_id).query();
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report_bp');
            // $(bp_ds_id).query();
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_report_attachment');
            // $(att_ds_id).query();
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            // $(quotation_ds_id).query();

        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_F_FORM_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    if(marketing_report_id){
                        qpara['document_id'] = marketing_report_id;
                        qpara['source_document_id'] = marketing_report_id;
                    }else{
                        qpara['document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        qpara['source_document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                    }
                    qpara['source_document_category'] = 'HLS_MARKETING_REPORT';
                    // qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    if(marketing_report_id){
                        qpara['document_id'] = marketing_report_id;
                        qpara['source_document_id'] = marketing_report_id;
                    }else{
                        qpara['document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                        qpara['source_document_id'] = "${/model/report_record_path/record/@marketingReportId}";
                    }
                    qpara['source_document_category'] = 'HLS_MARKETING_REPORT';
                    // qpara['data_class'] = '';
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_BASIC_DATA_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_marketing_report');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var marketing_report_id = prj_record.get('marketing_report_id');
                    qpara['marketing_report_id'] = marketing_report_id;
                    break;
            }
        }


        //报价计算入口
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list+'&readOnly=Y';
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel测算',
                fullScreen: true,
                document_history_flag:true
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
            });
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>