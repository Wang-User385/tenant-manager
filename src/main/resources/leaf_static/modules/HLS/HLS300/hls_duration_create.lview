<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年5月27日
    $Revision: 1.0
    $Purpose: 存续期审批-入口界面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_modify_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>
        <script src="${/request/@context_path}/common/code?sysCodeData=HLS.DURATION_TYPE_NEW"
                type="text/javascript"></script>
        <script><![CDATA[

        var function_code;
        var duration_type;
        var durationTypeECMap = {};
        sysCodeData.forEach(function (i) {
            durationTypeECMap[i.meaning] = i.value;
        });


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            var param = {};
            if ($(ds_id).validate()) {
                param['url_title'] = '合同变更审批事项工作联系单';
                param['function_code'] = get_function_code(record.get('duration_type'));
                param['duration_type'] = record.get('duration_type');
                param['project_id'] = record.get('project_id');
                param['ref_project_id'] = record.get('ref_project_id');
                param['project_name'] = record.get('project_name');
                param['contract_number'] = record.get('prj_con_number');
                param['project_number'] = record.get('project_number');
                param['prj_bp_name'] = record.get('prj_bp_name');
                param['prj_con_status_n'] = record.get('prj_con_status_n');
                param['prj_unit_name'] = record.get('prj_unit_name');
                param['prj_employee_name'] = record.get('prj_employee_name');
                param['prj_finance_amount'] = record.get('prj_finance_amount');
                param['prj_outstanding_principal'] = record.get('prj_outstanding_principal');
                param['prj_overdue_max_days'] = record.get('prj_overdue_max_days');
                param['five_classification_result'] = record.get('five_classification_result');
                param['five_classification_result_n'] = record.get('five_classification_result_n');
                param['overdue_status_n'] = record.get('overdue_status_n');
                param['host_project_manager_n'] = record.get('host_project_manager_n');
                param['host_unit_name'] = record.get('host_unit_name');

                param['function_usage'] = 'CREATE';
                param['winid'] = '${/parameter/@layout_code}_project_modify_winid';
                param['entrance_winid'] = '${/parameter/@winid}';
                //param['layout_debugger_flag'] = 'Y';
                // hls_doc_get_layout_code(param, '${/parameter/@layout_code}_modify_id', ds_id, 'HLS300F1');
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_modify_id', ds_id, 'HLS300F1','${/parameter/@winid}','Y');
            }
        };

        function get_function_code(duration_type) {
            /**
             BUSINESS_CHANGE    业务变更    合同-虚拟
             ET                 提前结清   合同-虚拟
             CON_TERMINATION    合同终止  合同-虚拟
             DEPOSIT            租赁保证金抵扣、退还  合同-虚拟
             */

            if (duration_type == 'BUSINESS_CHANGE') {
                return 'HLS300F20';
            } else if (duration_type == 'ET') {
                return 'HLS300F9';
            } else if (duration_type == 'DEPOSIT') {
                return 'HLS300F5';
            } else if (duration_type == 'CON_TERMINATION') {
                return 'HLS300F21';
            }
        }
        Leaf.onReady(function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            $('${/parameter/@layout_code}_F_FROM_HLS_DURATION_HD_DURATION_TYPE').addListener('change', function (component, value, oldValue) {

                /**
                 BUSINESS_CHANGE    业务变更
                 ET                 提前结清
                 CON_TERMINATION    合同终止
                 CON_END            合同结束
                 */

                if (duration_type == 'BUSINESS_CHANGE') {
                    function_code = 'HLS300F20';
                }else if (duration_type == 'ET') {
                    function_code = 'HLS300F9';
                }else if (duration_type == 'DEPOSIT') {
                    function_code = 'HLS300F5';
                }else if (duration_type == 'CON_TERMINATION') {
                    function_code = 'HLS300F21';
                }


                duration_type = durationTypeECMap[value];

            });
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>


