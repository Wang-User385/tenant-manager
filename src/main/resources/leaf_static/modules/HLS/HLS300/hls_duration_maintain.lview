<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年5月27日
    $Revision: 1.0
    $Purpose: 存续期审批-入口界面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_duration_create_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_create.lview"/>

        <a:link id="${/parameter/@layout_code}_duration_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>

        <script><![CDATA[


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var param = {};
            param['url_title'] = '存续期审批单类型选择';
            param['function_code'] = 'HLS300F1';
            param['function_usage'] = 'CREATE';
            param['screen_width'] = '450';
            param['screen_height'] = '350';
            param['winid'] = '${/parameter/@layout_code}_duration_create_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_duration_create_id', ds_id, 'HLS300');
        };
        //作废
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '请至少选择一条记录！');
                return;
            }
            var saveData = [];
            records.forEach(function (record) {
                //状态校验
                if (record.get('duration_status') == 'APPROVING' || record.get('duration_status') == 'APPROVED' || record.get('duration_status') == 'CANCEL') {
                    Leaf.showMessage('提示', '当前状态不能作废！');
                    check_flag = false;
                }
                record.set("duration_status", "CANCEL");
                record.set('__status', 'update');
                saveData.push(record.data);
            });

            if (check_flag) {
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认作废吗?', function okFun() {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/hls/duration/hd/cancel',
                        para: saveData,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ds_id).query();
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                },function cancel() {
                    $(ds_id).query();
                });
            }
        };


        function duration_number_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var duration_status = record.get('duration_status');
            var duration_type = record.get('duration_type');

            param['url_title'] = '存续期审批申请';
            param['function_code'] = get_function_code(duration_type);
            param['winid'] = 'duration_detail_open_id';
            if (duration_status == 'APPROVED' || duration_status == 'APPROVING' || duration_status == 'CANCEL') {
                param['function_usage'] = 'QUERY';
            } else {
                param['function_usage'] = 'MODIFY';
            }
            //param['layout_debugger_flag'] = 'Y';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_duration_window_id', ds_id, 'HLS300F');
        }


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = '';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'duration_number') {
                link_function = 'duration_number_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function get_function_code(duration_type) {
            /**
             BUSINESS_CHANGE    业务变更    合同-虚拟
             ET                 提前结清   合同-虚拟
             CON_TERMINATION    合同终止  合同-虚拟
             DEPOSIT            租赁保证金抵扣、退还  合同-虚拟
             */
            // if (duration_type == 'PROJECT') {
            //     return 'HLS300F2';
            // } else if (duration_type == 'RELEASE') {
            //     return 'HLS300F3';
            // } else if (duration_type == 'SPECIAL') {
            //     return 'HLS300F4';
            // } else if (duration_type == 'REPURCHASE') {
            //     return 'HLS300F7';
            // } else if (duration_type == 'TERMINATE') {
            //     return 'HLS300F8';
            // } else if (duration_type == 'PREPAYMENT') {
            //     return 'HLS300F12';
            // }else
            if (duration_type == 'BUSINESS_CHANGE') {
                return 'HLS300F20';
            }else if (duration_type == 'ET') {
                return 'HLS300F9';
            }else if (duration_type == 'DEPOSIT') {
                return 'HLS300F5';
            }else if (duration_type == 'CON_TERMINATION') {
                return 'HLS300F21';
            }
        }


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd')
            if (ds_id == ds.id) {
                qpara['execute_flag'] = 'N';
                qpara['apply_person'] = '${/session/@user_id}';
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>