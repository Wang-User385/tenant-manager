<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html, body {
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="duration_wfl_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>

        <script><![CDATA[

        var businessKey = '${/parameter/@businessKey}';
        if(!businessKey){
            var businessKey = param.filter(function (o) {
                return o.name == "hdId";
            })[0].value;
        }
debugger;
        var param = parent.currentTaskInfo.execution_variables;

        var contractId = param.filter(function (o) {
            return o.name == "contractId";
        })[0].value;

        var projectId = param.filter(function (o) {
            return o.name == "projectId";
        })[0].value;

        var durationType = param.filter(function (o) {
            return o.name == "durationType";
        })[0].value;
        if(durationType =='BUSINESS_CHANGE'){
            var approvalId = param.filter(function (o) {
                return o.name == "approvalId";
            })[0].value;
        }


        var function_code = '';
        var meettingFlag= '${/parameter/@meettingFlag}';
        var buttonFlag= '${/parameter/@buttonFlag}';
        var approvalFlag = '${/parameter/@approvalFlag}';
        var secretFlag = '${/parameter/@secretFlag}';
        //业务类变更申请 需要上会
        if (durationType == 'BUSINESS_CHANGE') {
            if(meettingFlag == 'Y'){
                function_code = 'HLS300F20WFL_MEET';
            }else if(approvalFlag == 'Y'){
                function_code = 'HLS300F20WFL_MEETAP';
            }else if(approvalFlag == 'N'){
                function_code = 'HLS300F20WFL_MEETAQ';
            }else{
                function_code = 'HLS300F20WFL';
            }
        } else if (durationType == 'ET') {
            function_code = 'HLS300F9';
        } else if (durationType == 'CON_TERMINATION') {
            function_code = 'HLS300F21';
        } else if (durationType == 'DEPOSIT') {
            function_code = 'HLS300F5';
        }


        var pageChooser = new PageChooser({
            url: $('duration_wfl_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                contract_id: contractId,
                project_id: projectId,
                hd_id: businessKey,
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: function_code,
                duration_type: durationType,
                approval_id:approvalId,
                data_class:'Y',
                wfl_flag: 'Y'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
