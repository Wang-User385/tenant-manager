            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln');
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '存续期履约情况';
            param['function_code'] = 'HLS300CASH';
            param['function_usage'] = 'MODIFY';
            param['contract_id'] = record.get('contract_id');
            param['winid'] = '${/parameter/@layout_code}_common_winid';
            /*param['screen_width'] = '1600';
            param['screen_height'] = '700';*/
            param['duration_type'] = duration_type;
            param['hd_id'] = hd_id;

            // param['screen_width'] = '1400';
            // param['screen_height'] = '700';
            //if (record.get('duration_type') == 'RELEASE' || record.get('duration_type') == 'REPURCHASE' || record.get('duration_type') == 'ET' || record.get('duration_type') == 'PREPAYMENT' || record.get('duration_type') == 'TERMINATE') {
            param['function_code'] = 'HLS300CASHF1';
            param['project_id'] = record.get('project_id');
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_release_repurchase_window_id', null, '${/parameter/@function_code}');
            /*} else {
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', null, '${/parameter/@function_code}');
            }*/
        }

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'warrant_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_LEASE_ITEM_WARRANT',
                    winid: 'warrant_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '附件',
                width: 900,
                height: 475
            });
        }

        function open_contract_detail_win(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id).data;
            var param = {};
            param['url_title'] = '合同明细查看';
            param['winid'] = 'con_contract_detail_winid';
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
