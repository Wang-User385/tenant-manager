            }
        };

        //grid的渲染，设置编辑模式
        //点击下方刷新按钮时，可以保持只读、必填等状态
        window['${/parameter/@layout_code}_renderer_model'] = function (temp_value, record, name, editor_record) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit');
            if (ds_id && (duration_type == 'DEPOSIT' || duration_type == 'TERMINATE')) {
                var deposit_record = $(ds_id).getCurrentRecord();
                var is_refund_flag = deposit_record.get('is_refund_flag');
                var is_deduction_flag = deposit_record.get('is_deduction_flag');
                //保证金抵扣、退还
                if (name == 'refund_amount') {
                    if (is_refund_flag == 'Y' && '${/parameter/@function_usage}' != 'QUERY') {
                        record.getField('refund_amount').setReadOnly(false);
                        record.getField('refund_amount').setRequired(true);

                    } else {
                        record.getField('refund_amount').setReadOnly(true);
                        record.getField('refund_amount').setRequired(false);
                    }
                }
                if (name == 'deduction_amount' && '${/parameter/@function_usage}' != 'QUERY') {
                    if (is_deduction_flag == 'Y') {
                        record.getField('deduction_amount').setReadOnly(false);
                        record.getField('deduction_amount').setRequired(true);

                    } else {
                        record.getField('deduction_amount').setReadOnly(true);
                        record.getField('deduction_amount').setRequired(false);
                    }
                }
            }
        };


        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            hd_id = record.get('hd_id');
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            if (duration_hd_ds_id) {
                $(duration_hd_ds_id).setQueryParameter('hd_id', hd_id);
                $(duration_hd_ds_id).query();
            }
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            if (project_ds_id) {
                $(project_ds_id).query();
            }
        };


        //解押 抵质押明细 标记为申请解押 && 回购 租赁物明细 标记为申请回购
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var records = $(list_ds_id).getSelected()
            if (records.length == 0) {
                Leaf.showMessage('提示！', '至少选择一条数据！')
                return;
            } else {
                records.forEach(function (record) {
                    record.set('release_flag', 'Y');
                    record.set('release_flag_n', '是');
                    record.set('release_quantity', record.get('quantity'));
                    record.set('residual_quantity', 0);
                    record.set('release_amount', 0);
                });
            }
        }


