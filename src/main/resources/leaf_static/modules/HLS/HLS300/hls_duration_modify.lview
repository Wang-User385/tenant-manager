        window['upload_file'] = function (record_id, duration_attachment_id) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var hd_record = $(ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');

            if (hd_id == undefined || hd_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (duration_attachment_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: '${/parameter/@layout_code}_open_attachment_winid',
                url: url,
                params: {
                    'header_id': duration_attachment_id,
                    'table_name': 'HLS_DURATION_ATTACHMENT',
                    winid: '${/parameter/@layout_code}_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 900,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_INFO_hls_duration_attachment_ds";
                $(document_list_ds_id).query();
            });
        }

