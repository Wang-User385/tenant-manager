        }

        //正常结清&&提前结清&&提前还款 回购 租赁物明细 取消标记
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_2_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var records = $(list_ds_id).getSelected()
            if (records.length == 0) {
