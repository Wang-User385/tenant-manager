        window['duration_calc_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            if (duration_type == 'ET') {
                param['url_title'] = '提前结清测算';
                param['function_code'] = 'HLS300F11';
            } else if (duration_type == 'PREPAYMENT') {
                param['url_title'] = '提前还款测算';
                param['function_code'] = 'HLS300F13';
            }
            param['function_usage'] = 'MODIFY';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                param['function_usage'] = 'QUERY';
            }
            param['duration_type'] = duration_type;
            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_ET_INFO');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_PREPAYMENT_INFO');
            param[et_ds_id.replace('_ds', '')] = undefined;
            param[prepayment_ds_id.replace('_ds', '')] = undefined;
            param['winid'] = '${/parameter/@layout_code}_duration_calc_detail_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', ds_id, '${/parameter/@function_code}');
        }


        //提交按钮
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //提交前先保存
            window['${/parameter/@layout_code}_custom_save_layout_dynamic_click'](submit_function);
        }


        function submit_function() {

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var duration_deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'F_DEPOSIT_INFO');

            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');

            var depost_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'G_DEPOSIT_GIRD');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');

            var et_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');

            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');
            var lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
            var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
            var item_list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var item_list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_WARRANT_INFO');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');

            //debugger;

            if (duration_type == 'TERMINATE' || duration_type == 'PREPAYMENT') {
                if (release_change_flag == 'Y') {
                    var lease_item_records = $(lease_item_1_ds_id).getAll();
                    var pledge_check = 'Y';
                    lease_item_records.forEach(function (record) {
                        if (record.get('release_amt') > record.get('pledge_amount')) {
                            pledge_check = 'N';
                        }
                    });

                    if (pledge_check == 'N') {
                        Leaf.showMessage('提示', '抵质押物中，本次解押金额不能大于本合同抵押金额！');
                        $(duration_hd_ds_id).query();
                        return false;
                    }
                }
            } else if (duration_type == 'RELEASE') {
                var lease_item_records = $(lease_item_ds_id).getAll();
                var pledge_check = 'Y';
                lease_item_records.forEach(function (record) {
                    if (record.get('release_amt') > record.get('pledge_amount')) {
                        pledge_check = 'N';
                    }
                });

                if (pledge_check == 'N') {
                    Leaf.showMessage('提示', '抵质押物中，本次解押金额不能大于本合同抵押金额！');
                    $(duration_hd_ds_id).query();
                    return false;
                }
            }

            var record = $(duration_hd_ds_id).getCurrentRecord();
            var saveData = [];
            saveData.push(record.data);


            saveData[0][duration_hd_ds_id.replace('_ds', '')] = undefined;
            saveData[0][duration_deposit_ds_id.replace('_ds', '')] = undefined;
            saveData[0][project_ds_id.replace('_ds', '')] = undefined;
            saveData[0][contract_ds_id.replace('_ds', '')] = undefined;
            saveData[0][depost_grid_ds_id.replace('_ds', '')] = undefined;
            saveData[0][deposit_ds_id.replace('_ds', '')] = undefined;
            saveData[0][interest_ds_id.replace('_ds', '')] = undefined;
            saveData[0][credit_ds_id.replace('_ds', '')] = undefined;
            saveData[0][et_info_ds_id.replace('_ds', '')] = undefined;
            saveData[0][prepayment_info_ds_id.replace('_ds', '')] = undefined;

            saveData[0][lease_item_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_list_ds_id.replace('_ds', '')] = undefined;

            saveData[0][lease_item_1_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_2_ds_id.replace('_ds', '')] = undefined;


            saveData[0][item_list_1_ds_id.replace('_ds', '')] = undefined;
            saveData[0][item_list_2_ds_id.replace('_ds', '')] = undefined;
            saveData[0][warrant_ds_id.replace('_ds', '')] = undefined;
            saveData[0][attachment_ds_id.replace('_ds', '')] = undefined;

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/hls/duration/hd/submit",
                para: saveData,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                        $('${/parameter/@winid}').close();
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "提交失败!", null);
                },
                scope: this
            });

        }


        function assignValue(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record[i] = data[i];
                }
            }
        }


        //保存按钮
        window['${/parameter/@layout_code}_custom_save_layout_dynamic_click'] = function (nextStep) {
            //debugger;

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');

            var duration_deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'F_DEPOSIT_INFO');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');


            var et_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');
            var et_compare_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_ET_INFO');
            var prepayment_compare_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_PREPAYMENT_INFO');


            var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
            var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
            var depost_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'G_DEPOSIT_GIRD');


            var item_list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var item_list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_WARRANT_INFO');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');

            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');


            var f_change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var f_change_info_record = null;
            if (f_change_info_ds_id) {
                f_change_info_record = $(f_change_info_ds_id).getCurrentRecord();
            }
            var validate_check = true;


            if (duration_type == 'TERMINATE') {
                //正常结清
                var deposit_change_flag = 'N'; //保证金冲抵、退还
                var release_change_flag = 'N'; //解押
                var repurchase_change_flag = 'N'; //回购
                var warrant_change_flag = 'N'; //权证出库

                if (f_change_info_record != null) {
                    if (f_change_info_record.get('deposit_change_flag') == 'Y') {
                        deposit_change_flag = 'Y';
                    }
                    if (f_change_info_record.get('release_change_flag') == 'Y') {
                        release_change_flag = 'Y';
                    }
                    if (f_change_info_record.get('repurchase_change_flag') == 'Y') {
                        repurchase_change_flag = 'Y';
                    }
                    if (f_change_info_record.get('warrant_change_flag') == 'Y') {
                        warrant_change_flag = 'Y';
                    }
                }

                //必填校验
                if (duration_hd_ds_id) {
                    if (!$(duration_hd_ds_id).validateSelf()) {
                        validate_check = false;
                    }
                }

                if (duration_deposit_ds_id) {
                    if (deposit_change_flag == 'Y') {
                        if (!$(duration_deposit_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (deposit_ds_id) {
                    if (deposit_change_flag == 'Y') {
                        if (!$(deposit_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (interest_ds_id) {
                    if (deposit_change_flag == 'Y') {
                        if (!$(interest_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (credit_ds_id) {
                    if (deposit_change_flag == 'Y') {
                        if (!$(credit_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (depost_grid_ds_id) {
                    if (!$(depost_grid_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (item_list_1_ds_id) {
                    if (release_change_flag == 'Y') {
                        if (!$(item_list_1_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (item_list_2_ds_id) {
                    if (repurchase_change_flag == 'Y') {
                        if (!$(item_list_2_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }

                if (warrant_ds_id) {
                    if (warrant_change_flag == 'Y') {
                        if (!$(warrant_ds_id).validate()) {
                            validate_check = false;
                        }
                    }
                }
                if (attachment_ds_id) {
                    if (!$(attachment_ds_id).validate()) {
                        validate_check = false;
                    }
                }
            } else {
                //必填校验
                if (duration_hd_ds_id) {
                    if (!$(duration_hd_ds_id).validateSelf()) {
                        validate_check = false;
                    }
                }

                if (duration_deposit_ds_id) {
                    if (!$(duration_deposit_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (deposit_ds_id) {
                    if (!$(deposit_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (interest_ds_id) {
                    if (!$(interest_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (credit_ds_id) {
                    if (!$(credit_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (depost_grid_ds_id) {
                    if (!$(depost_grid_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (item_list_1_ds_id) {
                    if (!$(item_list_1_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (item_list_2_ds_id) {
                    if (!$(item_list_2_ds_id).validate()) {
                        validate_check = false;
                    }
                }

                if (warrant_ds_id) {
                    if (!$(warrant_ds_id).validate()) {
                        validate_check = false;
                    }
                }
                if (attachment_ds_id) {
                    if (!$(attachment_ds_id).validate()) {
                        validate_check = false;
                    }
                }
            }


            if (validate_check) {
                //基本信息

                $(duration_hd_ds_id).getCurrentRecord().set('duration_type', duration_type);
                var saveData = $(duration_hd_ds_id).getCurrentRecord().data;

                //debugger;
                //保证金冲抵、退还方案
                saveData['hls_duration_deposit_list'] = [];
                if (duration_deposit_ds_id) {
                    var duration_deposit_record = $(duration_deposit_ds_id).getCurrentRecord();
                    duration_deposit_record.set('duration_type', duration_type);
                    //duration_deposit_record.set('project_id', $(duration_hd_ds_id).getCurrentRecord().get('project_id'));
                    saveData['hls_duration_deposit_list'].push(duration_deposit_record.data);
                }

                //保证金退还 && 保证金利息 && 债权
                saveData['hls_duration_ln_list'] = [];

                if (deposit_ds_id) {
                    var deposit_records = $(deposit_ds_id).getAll();
                    deposit_records.forEach(function (record) {
                        record.set('source_type', 'DEPOSIT');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }

                if (interest_ds_id) {
                    var interest_records = $(interest_ds_id).getAll();
                    interest_records.forEach(function (record) {
                        record.set('source_type', 'INTEREST');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }

                if (credit_ds_id) {
                    var credit_records = $(credit_ds_id).getAll();
                    credit_records.forEach(function (record) {
                        record.set('source_type', 'CREDIT');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }


                saveData['hls_duration_attachment_list'] = [];
                if (attachment_ds_id) {
                    var attachment_records = $(attachment_ds_id).getAll();
                    attachment_records.forEach(function (record) {
                        saveData['hls_duration_attachment_list'].push(record.data);
                    });
                }

                if (duration_type == 'TERMINATE' || duration_type == 'PREPAYMENT') {
                    //保证金
                    if (duration_type == 'PREPAYMENT') {
                        var depost_grid_records = $(depost_grid_ds_id).getAll();
                        depost_grid_records.forEach(function (record) {
                            record.set('source_type', 'DEPOSIT');
                            saveData['hls_duration_deposit_list'].push(record.data);
                        });
                    }

                    //解押 回购
                    var item_list_1_records = $(item_list_1_ds_id).getAll();
                    var item_list_2_records = $(item_list_2_ds_id).getAll();

                    item_list_1_records.forEach(function (record) {
                        record.set('source_type', 'RELEASE');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                    item_list_2_records.forEach(function (record) {
                        record.set('source_type', 'REPURCHASE');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                    //权证
                    var warrant_records = $(warrant_ds_id).getAll();
                    warrant_records.forEach(function (record) {
                        record.set('source_type', 'WARRANT');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });

                }
                if (duration_type == 'ET') {
                    var et_info_records = $(et_info_ds_id).getAll();
                    et_info_records.forEach(function (record) {
                        record.set('source_type', 'ET');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }
                if (duration_type == 'PREPAYMENT') {
                    var prepayment_info_records = $(prepayment_info_ds_id).getAll();
                    prepayment_info_records.forEach(function (record) {
                        record.set('source_type', 'PREPAYMENT');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }


                //把其他属性去掉，避免栈溢出
                saveData[duration_hd_ds_id.replace('_ds', '')] = undefined;

                saveData[duration_deposit_ds_id.replace('_ds', '')] = undefined;
                saveData[deposit_ds_id.replace('_ds', '')] = undefined;
                saveData[interest_ds_id.replace('_ds', '')] = undefined;
                saveData[credit_ds_id.replace('_ds', '')] = undefined;
                saveData[et_info_ds_id.replace('_ds', '')] = undefined;
                saveData[prepayment_info_ds_id.replace('_ds', '')] = undefined;
                saveData[lease_item_1_ds_id.replace('_ds', '')] = undefined;
                saveData[lease_item_2_ds_id.replace('_ds', '')] = undefined;
                saveData[depost_grid_ds_id.replace('_ds', '')] = undefined;
                saveData[item_list_1_ds_id.replace('_ds', '')] = undefined;
                saveData[item_list_2_ds_id.replace('_ds', '')] = undefined;
                saveData[warrant_ds_id.replace('_ds', '')] = undefined;
                saveData[attachment_ds_id.replace('_ds', '')] = undefined;

                if (duration_type == 'ET' || duration_type == 'PREPAYMENT' || duration_type == 'TERMINATE') {

                    if (saveData['hls_duration_deposit_list'][0]) {
                        saveData['hls_duration_deposit_list'][0][depost_grid_ds_id.replace('_ds', '')] = undefined;
                    }
                    for (var i = 0; i < saveData['hls_duration_ln_list'].length; i++) {
                        if (saveData['hls_duration_ln_list'][i]) {
                            saveData['hls_duration_ln_list'][i][et_compare_info_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_ln_list'][i][prepayment_compare_info_ds_id.replace('_ds', '')] = undefined;
                        }
                    }
                    if (duration_type == 'TERMINATE') {
                        for (var i = 0; i < saveData['hls_duration_deposit_list'].length; i++) {
                            if (saveData['hls_duration_deposit_list'][i]) {
                                saveData['hls_duration_deposit_list'][i][deposit_ds_id.replace('_ds', '')] = undefined;
                                saveData['hls_duration_deposit_list'][i][interest_ds_id.replace('_ds', '')] = undefined;
                                saveData['hls_duration_deposit_list'][i][credit_ds_id.replace('_ds', '')] = undefined;
                                saveData['hls_duration_deposit_list'][i][credit_ds_id.replace('_ds', '')] = undefined;
                            }
                        }
                    }

                } else {
                    for (var i = 0; i < saveData['hls_duration_deposit_list'].length; i++) {
                        if (saveData['hls_duration_deposit_list'][i]) {
                            saveData['hls_duration_deposit_list'][i][deposit_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_deposit_list'][i][interest_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_deposit_list'][i][credit_ds_id.replace('_ds', '')] = undefined;
                        }
                    }
                }


                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();

                Leaf.request({
                    url: '${/request/@context_path}/hls/duration/hd/save',
                    para: saveData,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        hd_id = res.result.record[0].hd_id;
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        if (typeof (nextStep) == 'function') {
                            nextStep();
                        } else {
                            all_query(hd_id);
                        }
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        };

        function all_query(hd_id) {
            //保存后 form 框需要 刷新将 后台保存的值 返回到前台
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var duration_deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'F_DEPOSIT_INFO');

            if (duration_hd_ds_id) {
                $(duration_hd_ds_id).setQueryParameter('hd_id', hd_id);
                $(duration_hd_ds_id).query();
            }

            if (duration_deposit_ds_id) {
                $(duration_deposit_ds_id).setQueryParameter('hd_id', hd_id);
                $(duration_deposit_ds_id).query();
            }
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            var param = {};
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1WFL2';
            param['winid'] = '${/parameter/@layout_code}_con_contract_detail_winid';
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['hd_id'] = hd_id;
            param['duration_type'] = duration_type;
            param['project_id'] = record.get('project_id');
            param['report_flag'] = 'Y';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_con_contract_detail_id', null, '${/parameter/@function_code}');
        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            var param = {};
            param['url_title'] = '存续期履约情况';
            param['function_code'] = 'HLS300CASH';
            param['function_usage'] = 'MODIFY';
            param['contract_id'] = record.get('contract_id');
            param['winid'] = '${/parameter/@layout_code}_common_winid';
            /*param['screen_width'] = '1600';
            param['screen_height'] = '700';*/
            param['duration_type'] = duration_type;
            param['hd_id'] = hd_id;

            // param['screen_width'] = '1400';
            // param['screen_height'] = '700';
            if (record.get('duration_type') == 'RELEASE' || record.get('duration_type') == 'REPURCHASE' || record.get('duration_type') == 'ET' || record.get('duration_type') == 'PREPAYMENT' || record.get('duration_type') == 'TERMINATE') {
                param['function_code'] = 'HLS300CASHF1';
                param['project_id'] = record.get('project_id');
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_release_repurchase_window_id', null, '${/parameter/@function_code}');
            } else {
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', null, '${/parameter/@function_code}');
            }

        };

        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            if (hd_id == undefined || hd_id == 0) {
                $L.showInfoMessage("提示", "请先保存!");
                return;
            }
            var param = {};
            param['url_title'] = '项目审批通知书';
            param['function_code'] = 'PRJ316T1';
            param['function_usage'] = 'MODIFY';
            param['winid'] = '${/parameter/@layout_code}_project_credit_notice_winid';
            param['project_id'] = '${/parameter/@ref_project_id}';
            param['hd_id'] = hd_id;
            param['duration_type'] = duration_type;
            /*param['screen_width'] = '600';
            param['side'] = 'right';*/
            if (param['project_id'] == '') {
                param['project_id'] = $(ds_id).getCurrentRecord().get('ref_project_id');
            }
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_project_credit_notice_link', ds_id, '${/parameter/@function_code}');

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var duration_deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'F_DEPOSIT_INFO');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');
            var lease_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var lease_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var lease_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');

            //保证金退还和抵扣 支付表选择后 保证金需要重新查询
            if (duration_hd_ds_id == ds.id) {
                if (duration_type == 'DEPOSIT') {
                    if (name == 'contract_id') {
                        if ($(deposit_ds_id)) {
                            contract_id = value;
                            $(deposit_ds_id).setQueryParameter('contract_id', value);
                            $(deposit_ds_id).query();
                        }
                        if ($(interest_ds_id)) {
                            contract_id = value;
                            $(interest_ds_id).setQueryParameter('contract_id', value);
                            $(interest_ds_id).query();
                        }
                        //保证金冲抵、退还方案 需要根据选择的支付表自动带出 币种
                        if ($(duration_deposit_ds_id)) {
                            contract_id = value;
                            $(duration_deposit_ds_id).getCurrentRecord().set('contract_id', value);
                            $(duration_deposit_ds_id).getCurrentRecord().set('deposit_residual_amount', '');
                            $(duration_deposit_ds_id).getCurrentRecord().set('deposit_deduction_amount', 0);
                            $(duration_deposit_ds_id).getCurrentRecord().set('deposit_refund_amount', 0);
                            $(duration_deposit_ds_id).getCurrentRecord().set('outstanding_deposit', '');
                        }
                    }
                    if (name == 'currency_code') {
                        $(duration_deposit_ds_id).getCurrentRecord().set('currency_code', value);
                    }
                    if (name == 'currency_code_n') {
                        $(duration_deposit_ds_id).getCurrentRecord().set('currency_code_n', value);
                    }

                } else if (duration_type == 'TERMINATE') {
                    //正常结清&&提前结清&&提前还款 根据变更信息 显示隐藏
                    if (name == 'deposit_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(0);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(0);
                        }
                    }
                    if (name == 'release_change_flag') {
                        if (value == 'N') {
                            release_change_flag = 'N';
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                        } else {
                            release_change_flag = 'Y';
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                        }
                    }
                    if (name == 'repurchase_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                        }
                    }
                    if (name == 'warrant_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                        }
                    }
                } else if (duration_type == 'PREPAYMENT') {
                    if (name == 'deposit_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                        }
                    }
                    if (name == 'release_change_flag') {
                        if (value == 'N') {
                            release_change_flag = 'N';
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                        } else {
                            release_change_flag = 'Y';
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                        }
                    }
                    if (name == 'repurchase_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                        }
                    }
                    if (name == 'warrant_change_flag') {
                        if (value == 'N') {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(4);
                        } else {
                            $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(4);
                        }
                    }
                } else if (duration_type == 'PROJECT') {
                    if (name == 'project_id') {

                    }

                }
            }
            if (duration_deposit_ds_id == ds.id) {
                //针对于保证金冲抵、退还方案 是否需要退还 影响 下方gird 只读还是必填
                if (name == 'is_refund_flag') {
                    /*
                                        window['${/parameter/@layout_code}_grid_refund_update'](value);
                    */
                    if (value == 'Y') {
                        record.getField('refund_date').setReadOnly(false);
                        record.getField('bp_bank_account_id').setReadOnly(false);
                        record.getField('bp_bank_account_id_n').setReadOnly(false);
                        record.getField('refund_date').setRequired(true);
                        record.getField('bp_bank_account_id').setRequired(true);
                        record.getField('bp_bank_account_id_n').setRequired(true);
                    } else if (value == 'N') {
                        record.getField('refund_date').setRequired(false);
                        record.getField('bp_bank_account_id').setRequired(false);
                        record.getField('bp_bank_account_id_n').setRequired(false);
                        record.getField('refund_date').setReadOnly(true);
                        record.getField('bp_bank_account_id').setReadOnly(true);
                        record.getField('bp_bank_account_id_n').setReadOnly(true);
                    }
                }
                if (name == 'is_deduction_flag') {
                    if (value == 'Y') {

                        record.getField('bank_account_id').setReadOnly(false);
                        record.getField('bank_account_id_n').setReadOnly(false);
                        record.getField('bank_account_id').setRequired(true);
                        record.getField('bank_account_id_n').setRequired(true);
                    } else if (value == 'N') {
                        record.getField('bank_account_id').setRequired(false);
                        record.getField('bank_account_id_n').setRequired(false);
                        record.getField('bank_account_id').setReadOnly(true);
                        record.getField('bank_account_id_n').setReadOnly(true);
                    }
                }
            }
            //保证金退还和抵扣 本次冲抵金额不能大于剩余金额
            if (credit_ds_id == ds.id) {

                var deduction_amount = record.get('deduction_amount') || 0;
                var residual_amount = record.get('residual_amount') || 0;
                var residual_interest = record.get('residual_interest') || 0;

                if (name == 'deduction_amount') {
                    if (minus(value, residual_amount) > 0) {
                        Leaf.showMessage('提示！', '本次抵扣金额:' + value + '大于剩余金额:' + record.get('residual_amount'));
                        return;
                    } else if (minus(value, residual_amount) <= 0 && minus(value, residual_interest) <= 0 && (record.get('cf_item') == 1 || record.get('cf_item') == 10)) {
                        record.set('deduction_principal', 0);
                        record.set('deduction_interest', value || 0);
                    } else if (minus(value, residual_amount) <= 0 && minus(value, residual_interest) >= 0 && (record.get('cf_item') == 1 || record.get('cf_item') == 10)) {
                        record.set('deduction_principal', minus(value, residual_interest));
                        record.set('deduction_interest', residual_interest);
                    }
                } else if (name == 'deduction_principal' && (record.get('cf_item') == 1 || record.get('cf_item') == 10)) {
                    record.set('deduction_interest', minus(deduction_amount, value));

                } else if (name == 'deduction_interest' && (record.get('cf_item') == 1 || record.get('cf_item') == 10)) {
                    record.set('deduction_principal', minus(deduction_amount, value));
                }

                if (name == 'cf_item') {
                    if (value != 1 && value != 10) {
                        record.getField('deduction_principal').setReadOnly(true);
                        record.getField('deduction_interest').setReadOnly(true);
                        record.getField('deduction_principal').setRequired(false);
                        record.getField('deduction_interest').setRequired(false);
                    } else {
                        record.getField('deduction_principal').setReadOnly(false);
                        record.getField('deduction_interest').setReadOnly(false);
                        record.getField('deduction_principal').setRequired(true);
                        record.getField('deduction_interest').setRequired(true);
                    }
                }
            }

            if (lease_ds_id == ds.id) {
                var currentRecord = $(lease_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var mortgage_pledge_amount = currentRecord.get('mortgage_pledge_amount');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(mortgage_pledge_amount, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }


            }

            if (lease_2_ds_id == ds.id) {
                var currentRecord = $(lease_2_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var net_asset_value_now = currentRecord.get('net_asset_value_now');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(net_asset_value_now, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }


            }

            if (lease_1_ds_id == ds.id) {
                var currentRecord = $(lease_1_ds_id).getCurrentRecord();
                if (currentRecord != null) {
                    var quantity = currentRecord.get('quantity');
                    var mortgage_pledge_amount = currentRecord.get('mortgage_pledge_amount');

                    if (name == 'release_quantity') {
                        var release_quantity = currentRecord.get('release_quantity');
                        var residual_quantity = minus(quantity, release_quantity);
                        currentRecord.set('residual_quantity', residual_quantity);
                        var release_amount = mul(div(mortgage_pledge_amount, quantity), residual_quantity);
                        currentRecord.set('release_amount', Leaf.formatMoney(release_amount));
                    }

                }
            }

            if (et_ds_id == ds.id) {
                debugger;
                //提前结清 对支付表列上的结清费用 减免费用 实际结清费用 进行汇总病校验
                var et_amount = 0;
                var amount = 0;
                var et_exempt_amount = 0;
                var rental_residual_amount = 0;
                var et_pre_amount = 0;
                var etRecords = $(et_ds_id).getAll();
                var hdRecord = $(duration_hd_ds_id).getCurrentRecord();
                if (name == 'et_amount') {
                    if (record.get('et_amount') - record.get('et_exempt_amount') < record.get('rental_residual_amount')) {
                        Leaf.showMessage('提示', '实际结清金额不能小于未偿还租赁本金');
                        return;
                    } else {
                        //结清金额合计
                        // et_amount +=  etRecords[nn].get('et_amount');
                        // //实际结清金额合计
                        // et_pre_amount += etRecords[nn].get('et_amount') - etRecords[nn].get('et_exempt_amount');
                        // //减免金额合计
                        // et_exempt_amount += etRecords[nn].get('et_exempt_amount');
                        record.set('et_pre_amount', record.get('et_amount') - record.get('et_exempt_amount'));
                    }

                }
                if (name == 'et_exempt_amount') {
                    if (record.get('et_amount') - record.get('et_exempt_amount') < record.get('rental_residual_amount')) {
                        Leaf.showMessage('提示', '实际结清金额不能小于未偿还租赁本金');
                        return;
                    } else {
                        // et_exempt_amount += etRecords[m].get('et_exempt_amount');
                        // et_amount +=  etRecords[m].get('et_amount');
                        // et_pre_amount += etRecords[m].get('et_amount') - etRecords[m].get('et_exempt_amount');
                        record.set('et_pre_amount', record.get('et_amount') - record.get('et_exempt_amount'));
                    }

                }
                if (et_amount != 0) {
                    hdRecord.set('et_amount', et_amount);
                    hdRecord.set('deduction_amount', et_exempt_amount);
                    hdRecord.set('actual_et_amount', et_pre_amount);
                }

            }

        };

        window['${/parameter/@layout_code}_grid_refund_update'] = function (value) {
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var deposit_records = $(deposit_ds_id).getAll();
            var interest_records = $(interest_ds_id).getAll();
            if (value == 'Y') {
                deposit_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(false);
                    record.getField('refund_amount').setRequired(true);
                });
                interest_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(false);
                    record.getField('refund_amount').setRequired(true);
                });
            } else {
                deposit_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(true);
                    record.getField('refund_amount').setRequired(false);
                    record.set('refund_amount', '');
                });
                interest_records.forEach(function (record) {
                    record.getField('refund_amount').setReadOnly(true);
                    record.getField('refund_amount').setRequired(false);
                    record.set('refund_amount', NaN);
                });
            }
        };

