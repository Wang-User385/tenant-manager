        }


        //解押 抵质押明细 保存 && 回购 租赁物明细 保存
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');

            var check_flag = true;
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');
            if (!hd_id) {
                Leaf.showMessage('提示！', '请先点击上方保存按钮！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                check_flag = false;
                return check_flag;

            }

            var lease_item_record = $(lease_item_ds_id).getCurrentRecord();
            var records = $(list_ds_id).getAll();
            //保存前校验
            if (duration_type == 'RELEASE') {
                records.forEach(function (record) {
                    var release_amount = record.get('release_amount') || 0;
                    var mortgage_pledge_amount = record.get('mortgage_pledge_amount') || 0;
                    var quantity = record.get('quantity');
                    var release_quantity = record.get('release_quantity');

                    if (minus(release_amount, mortgage_pledge_amount) > 0) {
                        Leaf.showMessage('提示！', '解押后抵质押金额:' + release_amount + '大于抵质押金额:' + mortgage_pledge_amount);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                    if (release_quantity > quantity) {
                        Leaf.showMessage('提示！', '申请解押数量应小于或等于抵质押物总数量！');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                });
            } else if (duration_type == 'REPURCHASE') {
                records.forEach(function (record) {
                    var release_amount = record.get('release_amount') || 0;
                    var net_asset_value_now = record.get('net_asset_value_now') || 0;

                    if (minus(release_amount, net_asset_value_now) > 0) {
                        Leaf.showMessage('提示！', '回购后账面净值:' + release_amount + '大于账面净值(当前):' + net_asset_value_now);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                });
            }

            for (var i = 0; i < records.length; i++) {
                var quantity = records[i].get('quantity');
                var release_quantity = records[i].get('release_quantity');
                if (release_quantity > quantity) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '申请回购数量不能大于租赁物数量！');
                    return false;
                }
            }

            if (check_flag) {
                //第一步删除数据
                Leaf.request({
                    url: "${/request/@context_path}/hls/duration/ln/delete",
                    para: {
                        hd_id: hd_id,
                        lease_item_id: lease_item_record.get('lease_item_id'),
                        source_type: duration_type
                    },
                    success: function (res) {
                        var saveData = [];
                        for (var i = 0; i < records.length; i++) {
                            records[i].set('__status', 'insert');
                            records[i].set('hd_id', hd_id);
                            records[i].set('source_type', duration_type);
                            saveData.push(records[i].data);
                        }
                        //第二步 保存数据
                        Leaf.request({
                            url: '${/request/@context_path}/hls/duration/ln/submit',
                            para: saveData,
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                                    duration: 2000
                                });
                                //第三步 查询抵质押信息 grid && 查询租赁物信息
                                $(lease_item_ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    },
                    sync: true,
                    scope: this
                });
            }
        };


        //正常结清&&提前结清&&提前还款 解押 抵质押明细 保存
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_1_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');

            var check_flag = true;
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');
            if (!hd_id) {
                Leaf.showMessage('提示！', '请先点击上方保存按钮！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                check_flag = false;
                return check_flag;

            }

            var lease_item_record = $(lease_item_ds_id).getCurrentRecord();
            var records = $(list_ds_id).getAll();

            //保存前校验
            records.forEach(function (record) {
                var release_amount = record.get('release_amount') || 0;
                var mortgage_pledge_amount = record.get('mortgage_pledge_amount') || 0;
                if (record.get('release_flag') == 'Y') {
                    if (minus(release_amount, mortgage_pledge_amount) > 0) {
                        Leaf.showMessage('提示！', '解押后抵质押金额:' + release_amount + '大于抵质押金额:' + mortgage_pledge_amount);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                }
            });

            if (check_flag) {
                //第一步删除数据
                Leaf.request({
                    url: "${/request/@context_path}/hls/duration/ln/delete",
                    para: {
                        hd_id: hd_id,
                        lease_item_id: lease_item_record.get('lease_item_id'),
                        source_type: 'RELEASE'
                    },
                    success: function (res) {
                        var saveData = [];
                        for (var i = 0; i < records.length; i++) {
                            records[i].set('__status', 'insert');
                            records[i].set('hd_id', hd_id);
                            records[i].set('source_type', 'RELEASE');
                            saveData.push(records[i].data);
                        }
                        //第二步 保存数据
                        Leaf.request({
                            url: '${/request/@context_path}/hls/duration/ln/submit',
                            para: saveData,
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                                    duration: 2000
                                });
                                //第三步 查询抵质押信息 grid && 查询租赁物信息
                                $(lease_item_ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    },
                    sync: true,
                    scope: this
                });
            }
        };


        //正常结清&&提前结清&&提前还款 回购 租赁物明细 保存
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_2_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');

            var check_flag = true;
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');
            if (!hd_id) {
                Leaf.showMessage('提示！', '请先点击上方保存按钮！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                check_flag = false;
                return check_flag;

            }

            var lease_item_record = $(lease_item_ds_id).getCurrentRecord();
            var records = $(list_ds_id).getAll();
            //保存前校验
            records.forEach(function (record) {
                var release_amount = record.get('release_amount') || 0;
                var net_asset_value_now = record.get('net_asset_value_now') || 0;

                if (minus(release_amount, net_asset_value_now) > 0) {
                    Leaf.showMessage('提示！', '回购后账面净值:' + release_amount + '大于账面净值(当前):' + net_asset_value_now);
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    check_flag = false;
                }
            });

            if (check_flag) {
                //第一步删除数据
                Leaf.request({
                    url: "${/request/@context_path}/hls/duration/ln/delete",
                    para: {
                        hd_id: hd_id,
                        lease_item_id: lease_item_record.get('lease_item_id'),
                        source_type: 'REPURCHASE'
                    },
                    success: function (res) {
                        var saveData = [];
                        for (var i = 0; i < records.length; i++) {
                            records[i].set('__status', 'insert');
                            records[i].set('hd_id', hd_id);
                            records[i].set('source_type', 'REPURCHASE');
                            saveData.push(records[i].data);
                        }
                        //第二步 保存数据
                        Leaf.request({
                            url: '${/request/@context_path}/hls/duration/ln/submit',
                            para: saveData,
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                                    duration: 2000
                                });
                                //第三步 查询抵质押信息 grid && 查询租赁物信息
                                $(lease_item_ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    },
                    sync: true,
                    scope: this
                });
            }
        };

        function warrant_flag_change(warrant_flag, warrant_flag_n) {
            var check_flag = true;
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');
            if (!hd_id) {
                Leaf.showMessage('提示！', '请先点击上方保存按钮！');
                check_flag = false;
            }
            if (check_flag) {
                var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_WARRANT_INFO');
                var records = $(warrant_ds_id).getSelected();
                if (records.length == 0) {
                    Leaf.showMessage('提示！', '至少选择一条数据！');
                    return;
                } else {
                    var warrantIdArr = [];
                    for (var i = 0; i < records.length; i++) {
                        records[i].isNew = true;
                        records[i].set('warrant_flag', warrant_flag);
                        records[i].set('warrant_flag_n', warrant_flag_n);
                        records[i].set('hd_id', hd_id);
                        records[i].set('source_type', 'WARRANT');
                        warrantIdArr.push(records[i].get('warrant_id'));
                    }
                    //第一步删除选择的数据
                    Leaf.request({
                        url: "${/request/@context_path}/hls/duration/ln/delete",
                        para: {
                            hd_id: hd_id,
                            warrant_id_arr: warrantIdArr,
                            source_type: 'WARRANT'
                        },
                        success: function (res) {
                            //第二步 重新插入选择数据
                            $(warrant_ds_id).submit();
                        },
                        sync: true,
                        scope: this
                    });
                }
            }
        }

        //解押 权证信息 标记为申请出库
        window['${/parameter/@layout_code}_G_WARRANT_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            warrant_flag_change('Y', '是');
        }

        //解押 权证信息 标记为申请出库
        window['${/parameter/@layout_code}_G_WARRANT_INFO_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            warrant_flag_change('N', '否');
        }


        //项目变更审批事项工作联系单 删除
        window['${/parameter/@layout_code}_G_PROJECT_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');
            var records = $(project_ds_id).getSelected()
            if (records.length == 0) {
                Leaf.showMessage('提示！', '至少选择一条数据！')
                return;
            } else {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                var saveData = [];
                for (var i = 0; i < records.length; i++) {
                    records[i].set('hd_id', hd_id);
                    saveData.push(records[i].data);
                }
                Leaf.request({
                    url: "${/request/@context_path}/hls/duration/ln/project/delete",
                    para: saveData,
                    success: function (res) {
                        $(project_ds_id).setQueryParameter('hd_id', hd_id);
                        $(project_ds_id).query();

                        $(contract_ds_id).setQueryParameter('hd_id', hd_id);
                        $(contract_ds_id).query();
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    },
                    sync: true,
                    scope: this
                });
            }


        }


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {


            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'G_DEPOSIT_GIRD');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');

            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');
            var hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');


            if (ds.id == et_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('et_date', $(hd_ds).getCurrentRecord().get('et_date'));
            }
            if (ds.id == deposit_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
            }
            if (ds.id == prepayment_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
            }
            if (ds.id == credit_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
            }
            if (ds.id == project_ds_id) {
                if ('${/parameter/@create_flag}' == 'Y') {
                    record.set('ref_project_id', '${/parameter/@ref_project_id}');
                } else {
                    record.set('ref_project_id', '${/parameter/@project_id}');
                }

            }
            if (ds.id == contract_ds_id && duration_type == 'PROJECT') {
                //上下级联管理
                var project_record = $(project_ds_id).getCurrentRecord();
                var source_id = project_record.get('source_id');
                record.set('project_id', source_id);
                record.set('source_id', source_id);
            }

            /* var duration_att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment');
             if (ds.id === duration_att_ds_id) {
                 if ('${/parameter/@wfl_flag}' == 'Y') {
                     record.getField('document_name').setReadOnly(false);
                     record.getField('document_name').setRequired(true);
                     record.getField('description').setReadOnly(false);
                 }
             }*/
        };

        $L.onReady(function () {
            //解押&&回购 信息
            var item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');
            if (item_ds_id) {
                $(item_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_ds_id).query();
            }

            //解押&&回购 权证
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_WARRANT_INFO');
            if (warrant_ds_id) {
                $(warrant_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(warrant_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(warrant_ds_id).query();
            }

            //正常结清&&提前结清&&提前还款 信息
            var item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
            if (item_1_ds_id) {
                $(item_1_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_1_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_1_ds_id).query();
            }

            var item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
            if (item_2_ds_id) {
                $(item_2_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_2_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_2_ds_id).query();
            }
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            if (duration_hd_ds_id) {
                if (duration_type == 'TERMINATE') {
                    if (deposit_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(0);
                    }
                    if (release_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                    }
                    if (repurchase_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                    }
                    if (warrant_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                    }
                } else if (duration_type == 'PREPAYMENT') {

                    if (deposit_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                    }
                    if (release_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                    }
                    if (repurchase_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                    }
                    if (warrant_change_flag == 'N') {
                        $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(4);
                    }
                }
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>


