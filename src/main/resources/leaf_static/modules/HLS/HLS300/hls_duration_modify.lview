        //解押 抵质押明细 取消标记 && 回购 租赁物明细 取消标记
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var records = $(list_ds_id).getSelected()
            if (records.length == 0) {
                Leaf.showMessage('提示！', '至少选择一条数据！');
                return;
            } else {
                if (duration_type == 'RELEASE') {
                    records.forEach(function (record) {
                        record.set('release_flag', 'N');
                        record.set('release_flag_n', '否');
                        record.set('release_quantity', 0);
                        record.set('residual_quantity', record.get('quantity'));
                        record.set('release_amount', record.get('mortgage_pledge_amount'));
                    });
                } else if (duration_type == 'REPURCHASE') {
                    records.forEach(function (record) {
                        record.set('release_flag', 'N');
                        record.set('release_flag_n', '否');
                        record.set('release_quantity', 0);
                        record.set('residual_quantity', record.get('quantity'));
                        record.set('release_amount', record.get('net_asset_value_now'));
                    });
                }
            }
        }

        //正常结清&&提前结清&&提前还款 解押 抵质押明细 取消标记
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_1_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var records = $(list_ds_id).getSelected()
            if (records.length == 0) {
