<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>

        <a:link id="${/parameter/@layout_code}_common_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_common.lview"/>
        <a:link id="${/parameter/@layout_code}_common_release_repurchase_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_common_release_repurchase.lview"/>
        <a:link id="${/parameter/@layout_code}_project_credit_notice_link"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition.lview"/>
        <a:link id="${/parameter/@layout_code}_con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_sw001_pledge_lease_id"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <script><![CDATA[

        var duration_type = '${/parameter/@duration_type}';

        var deposit_change_flag = 'N';
        var release_change_flag = 'N';
        var repurchase_change_flag = 'N';
        var warrant_change_flag = 'N';
        var contract_id = '${/parameter/@contract_id}' || -1;
        var project_id = '${/parameter/@project_id}';

        var hd_id = '${/parameter/@hd_id}';

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        //在线编辑
        function editDocFile(source_pk_value) {
            if ('${/parameter/@function_usage}' == 'QUERY') {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                window.open("${/request/@context_path}/sys/office/review?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            }
        }

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            /*var duration_att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment');
            if (ds.id === duration_att_ds_id) {
                if ('${/parameter/@wfl_flag}' == 'Y') {
                    if (record) {
                        record.getField('document_name').setReadOnly(false);
                        record.getField('document_name').setRequired(false);
                        record.getField('description').setReadOnly(false);
                    }
                }
            }*/
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_deposit', 'F_DEPOSIT_INFO');

            if (ds.id === duration_hd_ds_id) {

                //新增时初始化
                if (!record.get('apply_unit_id_n')) {
                    record.set('apply_unit_id_n', '${/session/@unitName}');
                    record.set('apply_unit_id', '${/session/@unitId}');
                }
                if (!record.get('apply_person_n')) {
                    record.set('apply_person_n', '${/session/@employeeName}');
                    record.set('apply_person', '${/session/@userId}');
                }
                if (!record.get('apply_date')) {
                    record.set('apply_date', Leaf.dateFormat.format(new Date('${/model/default_value/record/@now_date}'), 'isoDate'));
                }
                if (!record.get('project_id')) {
                    record.set('project_id', '${/parameter/@project_id}');
                }
                if (!record.get('contract_number')) {
                    record.set('contract_number', '${/parameter/@contract_number}');
                }
                if (!record.get('project_number')) {
                    record.set('project_number', '${/parameter/@project_number}');
                }
                if (!record.get('project_name')) {
                    record.set('project_name', '${/parameter/@project_name}');
                }
                if (!record.get('prj_bp_name')) {
                    record.set('prj_bp_name', '${/parameter/@prj_bp_name}');
                }
                if (!record.get('prj_bp_name')) {
                    record.set('prj_bp_name', '${/parameter/@prj_bp_name}');
                }
                if (!record.get('prj_con_status_n')) {
                    record.set('prj_con_status_n', '${/parameter/@prj_con_status_n}');
                }
                if (!record.get('prj_unit_name')) {
                    record.set('prj_unit_name', '${/parameter/@prj_unit_name}');
                }
                if (!record.get('prj_employee_name')) {
                    record.set('prj_employee_name', '${/parameter/@prj_employee_name}');
                }
                if (!record.get('prj_finance_amount')) {
                    record.set('prj_finance_amount', '${/parameter/@prj_finance_amount}');
                }
                if (!record.get('prj_outstanding_principal')) {
                    record.set('prj_outstanding_principal', '${/parameter/@prj_outstanding_principal}');
                }
                if (!record.get('prj_overdue_max_days')) {
                    record.set('prj_overdue_max_days', '${/parameter/@prj_overdue_max_days}');
                }

                if (!record.get('five_classification_result_n')) {
                    record.set('five_classification_result_n', '${/parameter/@five_classification_result_n}');
                }

                if (!record.get('overdue_status_n')) {
                    record.set('overdue_status_n', '${/parameter/@overdue_status_n}');
                }

                if (!record.get('host_project_manager_n')) {
                    record.set('host_project_manager_n', '${/parameter/@host_project_manager_n}');
                }

                if (!record.get('host_unit_name')) {
                    record.set('host_unit_name', '${/parameter/@host_unit_name}');
                }


                if (!record.get('deposit_change_flag')) {
                    record.set('deposit_change_flag', 'N');
                } else {
                    deposit_change_flag = record.get('deposit_change_flag');
                }
                if (!record.get('release_change_flag')) {
                    record.set('release_change_flag', 'N');
                } else {
                    release_change_flag = record.get('release_change_flag');
                }
                if (!record.get('repurchase_change_flag')) {
                    record.set('repurchase_change_flag', 'N');
                } else {
                    repurchase_change_flag = record.get('repurchase_change_flag');
                }
                if (!record.get('warrant_change_flag')) {
                    record.set('warrant_change_flag', 'N');
                } else {
                    warrant_change_flag = record.get('warrant_change_flag');
                }


                //新建的单据 通过 Leaf.onReady 渲染
                //保存的单据 通过 from load 事件 渲染
                if ('${/parameter/@hd_id}') {
                    Leaf.onReady(function () {
                        if (duration_type == 'TERMINATE') {
                            if (deposit_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(0);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(0);
                            }
                            if (release_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                            }
                            if (repurchase_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                            }
                            if (warrant_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                            }
                        } else if (duration_type == 'PREPAYMENT') {
                            if (deposit_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(1);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(1);
                            }
                            if (release_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(2);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(2);
                            }
                            if (repurchase_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(3);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(3);
                            }
                            if (warrant_change_flag == 'N') {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setDisabled(4);
                            } else {
                                $('${/parameter/@layout_code}_TAB_GROUP_10').setEnabled(4);
                            }
                        }
                        /*var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
                        var record = $(duration_hd_ds_id).getCurrentRecord();
                        var duration_status = record.get('duration_status');
                        if ('${/parameter/@wfl_flag}' != 'Y' && duration_status != 'NEW' && duration_status != 'REJECTED' && '${/parameter/@execute_flag}' != 'Y') {
                            var duration_att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment');
                            if (duration_att_ds_id) {
                                jQuery(document).ready(function () {
                                    var table_id = document.getElementById('${/parameter/@layout_code}_G_ATTACHMENT_INFO_hls_duration_attachment_layout_grid_id_wrap');
                                    table_id.getElementsByClassName('grid-btn grid-save grid-btn-hap-toolbar')[0].hidden = true;
                                    table_id.getElementsByClassName('grid-btn grid-add grid-btn-hap-toolbar')[0].hidden = true;
                                    table_id.getElementsByClassName('grid-btn grid-delete grid-btn-hap-toolbar')[0].hidden = true;
                                });
                            }
                        }*/
                    });
                }
            }
            if (ds.id === deposit_ds_id) {
                record.set('project_id', project_id);
                if ('${/parameter/@function_usage}' !== 'QUERY') {
                    if (record.get('is_refund_flag') === 'Y') {
                        record.getField('refund_date').setReadOnly(false);
                        record.getField('bp_bank_account_id').setReadOnly(false);
                        record.getField('bp_bank_account_id_n').setReadOnly(false);
                        record.getField('refund_date').setRequired(true);
                        record.getField('bp_bank_account_id').setRequired(true);
                        record.getField('bp_bank_account_id_n').setRequired(true);
                    } else if (record.get('is_refund_flag') === 'N') {
                        record.getField('refund_date').setRequired(false);
                        record.getField('bp_bank_account_id').setRequired(false);
                        record.getField('bp_bank_account_id_n').setRequired(false);
                        record.getField('refund_date').setReadOnly(true);
                        record.getField('bp_bank_account_id').setReadOnly(true);
                        record.getField('bp_bank_account_id_n').setReadOnly(true);
                    }


                    if (record.get('is_deduction_flag') === 'Y') {

                        record.getField('bank_account_id').setReadOnly(false);
                        record.getField('bank_account_id_n').setReadOnly(false);
                        record.getField('bank_account_id').setRequired(true);
                        record.getField('bank_account_id_n').setRequired(true);
                    } else if (record.get('is_deduction_flag') === 'N') {
                        record.getField('bank_account_id').setRequired(false);
                        record.getField('bank_account_id_n').setRequired(false);
                        record.getField('bank_account_id').setReadOnly(true);
                        record.getField('bank_account_id_n').setReadOnly(true);
                    }
                }
            }
        };


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var check_flag = true;
            var document_category = 'DURATION';
            var document_type = 'DURATION';
            var business_type = 'DURATION';
            var duration_number = hd_record.get('duration_number');


            //项目变更审批事项工作联系单 必选选择合同
            if (duration_type == 'PROJECT') {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln');
                var records = $(ds_id).getAll();
                if (records.length == 0) {
                    Leaf.showMessage('提示', '必须选择一条合同记录！');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }

            //保证金冲抵、退还方案 由于gird数据是 通过支付表编号选择查询出来的，所以需要 将record 设置为NEW 才能插入到hls_duration_ln
            //modify by Eugnen Song 改为后台校验

            //-------------------------------------------------------------------------------

            //解押 && 回购
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            //数据保存
            if (lease_item_ds_id) {
                var records = $(lease_item_ds_id).getAll();
                records.forEach(function (record) {
                    if (!record.get('ln_id')) {
                        //将record 设置为NEW 才能插入到hls_duration_ln
                        record.isNew = true;
                        record.set('source_type', duration_type);
                    }
                    //解押后抵质押金额<=抵质押金额
                    if (duration_type == 'RELEASE') {
                        var release_amount = record.get('release_amount') || 0;
                        var mortgage_pledge_amount = record.get('mortgage_pledge_amount') || 0;
                        if (minus(release_amount, mortgage_pledge_amount) > 0) {
                            Leaf.showMessage('提示！', '解押后抵质押金额:' + release_amount + '大于抵质押金额:' + mortgage_pledge_amount);
                            check_flag = false;
                        }
                    } else if (duration_type == 'REPURCHASE') {
                        //回购后账面净值 <=账面净值(当前)
                        var release_amount = record.get('release_amount') || 0;
                        var net_asset_value_now = record.get('net_asset_value_now') || 0;
                        if (minus(release_amount, net_asset_value_now) > 0) {
                            Leaf.showMessage('提示！', '回购后账面净值:' + release_amount + '大于账面净值(当前):' + net_asset_value_now);
                            check_flag = false;
                        }
                    }
                });
            }

            //保存前调用获取存续期编码
            if (duration_number == null) {
                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                    success: function (res) {
                        $(duration_hd_ds_id).getCurrentRecord().set('duration_number', res.result.record[0]);
                        $(duration_hd_ds_id).getCurrentRecord().set('duration_type', duration_type);
                        $(duration_hd_ds_id).getCurrentRecord().set('duration_status', 'NEW');
                        $(duration_hd_ds_id).getCurrentRecord().set('execute_status', 'NEW');
                        $(duration_hd_ds_id).getCurrentRecord().set('execute_flag', 'N');

                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = true;
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    },
                    sync: true,
                    scope: this
                });
                return check_flag;
            } else {
                return check_flag;
            }
        };

        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {

            var duration_att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment');
            if (ds.id === duration_att_ds_id) {
                for (var i = 0; i < record.length; i++) {
                    var upload_person_id = record[i].get('upload_person_id');
                    if (upload_person_id && upload_person_id != '${/session/@userId}') {
                        //window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showMessage('提示', '只有上传人自己才能删除自己上传的附件资料！');
                        return false;
                    }
                }
            }
            return true;
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment');

            //保证金退还和抵扣
            var deposit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_DEPOSIT_INFO');
            var interest_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_INTEREST_INFO');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CREDIT_INFO');

            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');

            if (attachment_ds_id == ds.id) {
                ds.setQueryParameter('attachment_category', duration_type);
            }

            if (deposit_ds_id == ds.id) {
                ds.setQueryParameter('risk_cf_item', '52');
                ds.setQueryParameter('hd_id', hd_id)
                if (duration_type == 'DEPOSIT') {
                    ds.setQueryParameter('contract_id', contract_id)
                }
                //正常结清 保证金维度中 支付表变为了合同
                if (duration_type == 'TERMINATE') {
                    ds.setQueryParameter('project_id', project_id)
                }
            }

            if (interest_ds_id == ds.id) {
                ds.setQueryParameter('cf_item', '502');
                ds.setQueryParameter('hd_id', hd_id)
                if (duration_type == 'DEPOSIT') {
                    ds.setQueryParameter('contract_id', contract_id)
                }
                //正常结清 保证金维度中 支付表变为了合同
                if (duration_type == 'TERMINATE') {
                    ds.setQueryParameter('project_id', project_id)
                }
            }

            if (credit_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'CREDIT');
                ds.setQueryParameter('hd_id', hd_id)
                if (duration_type == 'DEPOSIT') {
                    ds.setQueryParameter('contract_id', contract_id)
                }
                //正常结清 保证金维度中 支付表变为了合同
                if (duration_type == 'TERMINATE') {
                    ds.setQueryParameter('project_id', project_id)
                }
            }


            if (et_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'ET');
            }
            if (prepayment_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'PREPAYMENT');
            }

            //项目变更审批通知单
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');

            if (project_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'PROJECT');
            }

            if (contract_ds_id == ds.id) {
                ds.setQueryParameter('source_type', 'CONTRACT');
            }

            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        //indexchange事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_indexchange'] = function (ds, record, bp_seq) {
            //解押 && 回购
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM');
            if (lease_item_ds_id == ds.id) {
                var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
                $(list_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
                $(list_ds_id).query();
            }

            //正常结清&&提前结清&&提前还款
            var lease_item_ds_1_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
            if (lease_item_ds_1_id == ds.id) {
                var list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
                $(list_1_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
                $(list_1_ds_id).query();
            }

            var lease_item_ds_2_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
            if (lease_item_ds_2_id == ds.id) {
                var list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
                $(list_2_ds_id).setQueryParameter('lease_item_id', record.get('lease_item_id'));
                $(list_2_ds_id).query();
            }

            //项目变更审批事项
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PROJECT_INFO');
            if (project_ds_id == ds.id && duration_type == 'PROJECT') {
                var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');
                $(contract_ds_id).setQueryParameter('source_id', record.get('project_id'));
                $(contract_ds_id).query();
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }
            if (name === 'upload') {
                return '<a href="javascript:window[\'' + 'upload_file' + '\'](\'' + record.id + '\',\'' + record.get('duration_attachment_id') + '\');">上传</a>';
            }
            if (name === 'cashflow_detail') {
                if (record.get('contract_id')) {
                    return '<a href="javascript:window[\'' + 'cashflow_detail' + '\'](\'' + record.id + '\',\'' + record.get('contract_id') + '\');">详细</a>';
                }
            }
            if (name === 'approval_notice') {
                if (record.get('ref_project_id')) {
                    return '<a href="javascript:window[\'' + 'approval_notice' + '\'](\'' + record.id + '\',\'' + record.get('ref_project_id') + '\');">详细</a>';
                }
            }
            // if (name == 'contract_number') {
            //     link_function = 'open_contract_detail_win';
            //
            //     return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">合同明细</a>';
            // }
            if (name == 'notice_detail') {
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '批复信息' + '</a>';
            }

            if (name == 'file_name' && value) {

                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = value.split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (var i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i])) {
                            html += '<a href=javascript:editDocFile(\'' + sourcePkList[i] + '\')>' + fileNameList[i] + '</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }

            if (name == 'lease_item_code') {
                //解押
                if (duration_type == 'RELEASE') {
                    return '<a href="javascript:window[\'' + 'sw001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                } else if (duration_type == 'REPURCHASE') {
                    //回购
                    return '<a href="javascript:window[\'' + 'lease001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                } else {
                    //正常结清&&提前结清&&提前还款
                    var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_1');
                    var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_2');
                    if (record.ds.id == lease_item_1_ds_id) {
                        return '<a href="javascript:window[\'' + 'sw001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                    if (record.ds.id == lease_item_2_ds_id) {
                        return '<a href="javascript:window[\'' + 'lease001_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                    }
                }
            }

            //颜色标记
            if (name == 'lease_full_name') {
                if (record.get('release_flag') == 'Y') {
                    return '<div style="color: red">' + value + '</div>';
                } else {
                    return value;
                }
            }
            if (name == 'warrant_name') {
                if (record.get('warrant_flag') == 'Y') {
                    return '<div style="color: red">' + value + '</div>';
                } else {
                    return value;
                }
            }

            if (name == 'source_id') {
                //提前结清 - 保证金方案
                return '<a href="javascript:window[\'' + 'deposit_detail' + '\'](\'' + record.id + '\',\'' + record.get('project_id') + '\',\'' + record.ds.id + '\');">详细</a>';

            }

            if (name == 'ln_id') {
                //提前结清 - 测算 && 提前还款-测算
                if (record.get('ln_id')) {
                    return '<a href="javascript:window[\'' + 'duration_calc_detail' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">测算</a>';
                }
            }

            if (name === 'prj_con_name') {
                var link_function = 'open_contract_detail_win';
                if (record.get('project_id')) {
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">合同明细</a>';
                }
            }

            //权证相关 附件
            if (name == 'warrant_download') {
                return '<a href="javascript:open_attach(\'' + record.get('warrant_id') + '\')">附件上传</a>';
            }

            if (name == 'warrant_file_name' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }

            if (name == 'duration_performance') {
                return '<a href="javascript:window[\'' + 'duration_performance' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">存续期履约情况</a>';
            }
        };


        function open_notice_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var project_id = record.data.ref_project_id;
            new Leaf.Window({
                id: 'fnd_org_unit_define',
                url: "${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_maintain_meeting_query.lview",
                params: {
                    project_id: project_id,
                    function_usage: 'QUERY',
                    winId: "fnd_org_unit_define"
                },
                title: '项目批复落实情况',
                fullScreen: true,
                draggable: true,
                closeable: true
            });
        }

