<?xml version="1.0" encoding="UTF-8"?>
<!--
	&author:Eugene Song
	$date:2019年2月18日
	$purpose:银行定义
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script type="text/javascript"><![CDATA[
        function bankDs_grid_query() {
            $('bankDs').query();
        }

        function bankAccountDs_grid_query() {
            $('bankAccountDs').query();
        }

        function bankDs_grid_add() {
            $('bankDs_grid').showEditorByRecord($('bankDs').create());
        }

        function bankAccountDs_grid_add() {
            var bankDs = $('bankDs');
            var record = bankDs.getCurrentRecord();
            if (Ext.isEmpty(record)) {
                return;
            }
            else if (record.isNew) {
                Leaf.showMessage('${l:HLS.PROMPT}', '请先保存银行，才能新增分行');
                return;
            }
            $('bankAccountDs_grid').showEditorByRecord($('bankAccountDs').create({
                bank_id: record.get('bank_id'),
                bank_code: record.get('bank_code')
            }));

        }

        function bankDs_grid_clear() {
            $('bankDs_grid').clear();
        }

        function bankAccountDs_grid_clear() {
            $('bankAccountDs_grid').clear();
        }

        function bankDs_grid_save() {
            var header_ds = $('bankDs');
            var line_ds = $('bankAccountDs');
            var records = line_ds.getAll();
            for(var i =0 ;i<records.length;i++){
                var record = records[i];
            }

            if (header_ds.validate() && line_ds.validate()) {
                header_ds.submit();
                line_ds.submit();
            }
        }

        function editorFunction_bankDs_grid(record, name) {
            if (record.isNew) {
                if (name == 'bank_type_n') {
                    return 'bankDs_grid_editor_comb';
                }
                if (name == 'bank_code') {
                    return 'bankDs_grid_editor_tf_upper';
                }
            }
            return '';
        }

        /**
         *  日期编辑
         * @param record
         * @param name
         * @returns {string}
         */
        function fnd_work_calendar_ifEditor(record, name) {
            if (record.isNew) {
                if (name == 'opening_date'){
                    return 'fnd_work_calendar_ds_grid_dp';
                }
            }
            return '';
        }

        function task_authority_ds_grid_render(value,record,name){
            if(!!value &&  ( name = "opening_date")){
                return Leaf.dateFormat.format(new Date(value),'isoDate');
            }else if(!!value &&  ( name = "opening_date")){
                return Leaf.dateFormat.format(new Date(value),'iscDate');
            }
            return ''
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="bank_type_ds" lookupCode="BANK_TYPE"/>
            <a:dataSet id="bank_account_type_ds" lookupCode="BALANCE_NATURE"/>
            <a:dataSet id="bank_type_new_ds" lookupCode="BANK_TYPE_NEW"/>
            <a:dataSet id="purpose_type_ds" lookupCode="PURPOSE_TYPE_NEW"/>
            <a:dataSet id="ref_v02_ds" lookupCode="ACCOUNT_TYPE"/>
            <a:dataSet id="fnd_currency_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls_currency/by/query">
                <a:fields>
                    <a:field name="currency_code"/>
                    <a:field name="currency_name"/>
                    <a:field name="finance_precision"/>
                    <a:field name="currency_symbol"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="bank_query_ds">
                <a:fields>
                    <a:field name="bank_code"/>
                    <a:field name="bank_short_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="bankDs" autoQuery="true" fetchAll="false"
                       queryUrl="${/request/@context_path}/csh/bank/query"
                       submitUrl="${/request/@context_path}/csh/bank/submit"
                       deleteUrl="${/request/@context_path}/csh/bank/remove"
                       selectable="true" selectionModel="single"
                       queryDataSet="bank_query_ds">
                <a:fields>
                    <a:field name="bank_code" required="true" prompt="银行代码"/>
                    <a:field name="bank_short_name" required="true" prompt="银行简称"/>
                    <a:field name="bank_type"/>
                    <a:field name="bank_dossier" required="true" prompt="银行档案"/>
                    <a:field name="bank_type_n" displayField="code_value_name" options="bank_type_ds" required="true"
                             returnField="bank_type" valueField="code_value" prompt="银行类型"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="zero_amounts_allowed" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="bank_account_query_ds">
                <a:fields>
                    <a:field name="bank_branch_name"/>
                    <a:field name="bank_account_num"/>
                    <a:field name="bank_account_name"/>
                    <a:field name="currency_n" options="fnd_currency_ds"
                             displayField="currency_name" valueField="currency_code" returnField="currency"/>
                    <a:field name="opening_date_from"/>
                    <a:field name="opening_date_to"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="bankAccountDs" bindName="account_info" bindTarget="bankDs" fetchAll="false"
                       queryUrl="${/request/@context_path}/csh/bank/account/query"
                       submitUrl="${/request/@context_path}/csh/bank/account/submit"
                       deleteUrl="${/request/@context_path}/csh/bank/account/remove" selectable="true"
                       queryDataSet="bank_account_query_ds">
                <a:fields>
                    <a:field name="bank_code" prompt="银行代码"/>
                    <a:field name="ref_v04" required="true" prompt="支行编码"/>
                    <a:field name="bank_branch_name" required="true" prompt="支行名称"/>
                    <a:field name="bank_account_num" required="true" prompt="账号"/>
                    <a:field name="bank_account_name" required="true" prompt="户名"/>
                    <a:field name="company_id" defaultValue="${/session/@company_id}"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="bank_account_type"/>
                    <a:field name="bank_account_type_n" displayField="code_value_name" options="bank_account_type_ds"
                             required="true" returnField="bank_account_type" valueField="code_value" prompt="账户类型"/>
                    <a:field name="ref_v02"/>
                    <a:field name="ref_v02_n" displayField="code_value_name" options="ref_v02_ds"
                             required="true" returnField="ref_v02" valueField="code_value" prompt="收支性质"/>
                    <a:field name="bank_type_new_n" displayField="code_value_name" options="bank_type_new_ds"
                             required="true" returnField="bank_type_new" valueField="code_value" prompt="账户类型（新）"/>
                    <a:field name="bank_type_new"/>
                    <a:field name="purpose_type_n" displayField="code_value_name" options="purpose_type_ds"
                             required="true" returnField="purpose_type" valueField="code_value" prompt="用途类型）"/>
                    <a:field name="purpose_type"/>
                    <a:field name="currency"/>
                    <a:field name="currency_n" displayField="currency_name" options="fnd_currency_ds" required="true" prompt="币种"
                             returnField="currency" valueField="currency_code"/>
                    <a:field name="opening_date"  required="true"  prompt="开户日期"/>
                    <a:field name="closing_date"  prompt="销户日期"/>
                    <a:field name="manager_name"  prompt="客户经理"/>
                    <a:field name="contact" prompt="联系方式"/>
                    <a:field name="address" prompt="地址信息"/>
                    <a:field name="unit_bank_code"  prompt="联行号"/>
                    <a:field name="valid_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N" prompt="受限"/>
                    <a:field name="valid_start"  prompt="受限开始日"/>
                    <a:field name="invoice_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N" prompt="电子商业汇票功能"/>

                    <a:field name="ref_v03" prompt="城市"/>
                    <a:field name="ref_v06" prompt="备注"/>
                    <a:field name="city_n" autoComplete="true" lovGridHeight="300" lovHeight="450"  required="true"
                             lovLabelWidth="100" lovService="/eas/city/data/query~com.hand.hls.eas.dto.HlsCusCityData" lovWidth="600"
                             title="城市选择" fetchRemote="false">
                        <a:mapping>
                            <a:map from="city_n" to="city_n"/>
                            <a:map from="city_code" to="ref_v03"/>
                            <a:map from="city_n" to="ref_v01"/>

                        </a:mapping>
                    </a:field>

                    <a:field name="company_full_name" autoComplete="true" lovGridHeight="400" lovHeight="550"
                             lovLabelWidth="100" lovService="/leaf/fnd/company/query~hls.layout.dto.LovParentCompanyDto" lovWidth="600"
                             title="选择公司" required="true" requiredMessage="请输入公司名称">
                        <a:mapping>
                            <a:map from="company_full_name" to="company_full_name"/>
                            <a:map from="company_id" to="company_id"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="bankDs_grid_add" text="CSH101.BUTTON.BANK_ADD"/>
                <a:gridButton bind="bankDs_grid" text="CSH101.BUTTON.BANK_CLEAR" type="delete"/>
                <a:gridButton click="bankDs_grid_query" text="查询银行"/>
                <a:gridButton click="bankDs_grid_save" text="HLS.SAVE"/>
            </a:screenTopToolbar>
            <a:form column="2" title="查询条件" labelwidth="100">
                <a:textField name="bank_code" bindTarget="bank_query_ds" prompt="银行代码" emptyText="银行代码" width="200">
                    <a:events>
                        <a:event handler="bankDs_grid_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="bank_short_name" bindTarget="bank_query_ds" prompt="银行简称" emptyText="银行简称" width="200">
                    <a:events>
                        <a:event handler="bankDs_grid_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="bankDs_grid" bindTarget="bankDs" height="200" marginWidth="30" navBar="true">
                <a:columns>
                    <a:column name="bank_code" editorFunction="editorFunction_bankDs_grid" prompt="银行代码" width="150"/>
                    <a:column name="bank_short_name" editor="bankDs_grid_editor_tf" prompt="银行简称" width="200"/>
                    <a:column name="bank_name" editor="bankDs_grid_editor_tf" prompt="银行全称" width="300"/>
                    <a:column name="bank_type_n" align="center" editorFunction="editorFunction_bankDs_grid"
                              prompt="银行类型" width="100"/>
                    <a:column name="bank_dossier" align="center" editor="bankDs_grid_editor_tf"
                              prompt="银行档案" width="100"/>
                    <a:column name="enabled_flag" align="center" editor="bankDs_grid_editor_check" prompt="启用"
                              width="100"/>
                </a:columns>
                <a:editors>
                    <a:textField id="bankDs_grid_editor_tf_upper" maxLength="30" typeCase="upper"/>
                    <a:textField id="bankDs_grid_editor_tf"/>
                    <a:comboBox id="bankDs_grid_editor_comb"/>
                    <a:checkBox id="bankDs_grid_editor_check"/>
                </a:editors>
            </a:grid>
            <a:screenTopToolbar>
                <a:gridButton click="bankAccountDs_grid_add" text="CSH101.BUTTON.BRANCH_ADD"/>
                <a:gridButton bind="bankAccountDs_grid" text="CSH101.BUTTON.BRANCH_CLEAR" type="delete"/>
                <a:gridButton click="bankAccountDs_grid_query" text="查询支行"/>
            </a:screenTopToolbar>
            <a:form column="6" title="查询条件" labelwidth="100">
                <a:textField name="bank_branch_name" bindTarget="bank_account_query_ds" prompt="支行名称" emptyText="支行名称" width="150">
                    <a:events>
                        <a:event handler="bankAccountDs_grid_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="bank_account_num" bindTarget="bank_account_query_ds" prompt="账号" emptyText="账号" width="150">
                    <a:events>
                        <a:event handler="bankAccountDs_grid_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="bank_account_name" bindTarget="bank_account_query_ds" prompt="户名" emptyText="户名" width="150">
                    <a:events>
                        <a:event handler="bankAccountDs_grid_query"/>
                    </a:events>
                </a:textField>
                <a:comboBox name="currency_n" bindTarget="bank_account_query_ds" prompt="币种" emptyText="币种"
                            width="150">
                    <a:events>
                        <a:event handler="bankAccountDs_grid_query"/>
                    </a:events>
                </a:comboBox>
                <a:datePicker name="opening_date_from"
                              bindTarget="bank_account_query_ds"
                              prompt="开户日期从"/>
                <a:datePicker name="opening_date_to"
                              bindTarget="bank_account_query_ds"
                              prompt="开户日期到"/>
            </a:form>
            <a:grid id="bankAccountDs_grid" bindTarget="bankAccountDs" height="200" marginWidth="30" navBar="true">
                <a:columns>
                    <a:column name="bank_code" prompt="银行代码" width="100"/>
                    <a:column name="ref_v04" prompt="支行代码" editor="bankAccountDs_grid_editor_tf" width="100"/>
                    <a:column name="bank_branch_name" editor="bankAccountDs_grid_editor_tf" width="200" prompt="支行名称"/>
                    <a:column name="company_full_name" editor="bankAccountDs_company_grid_editor_lov" width="200" prompt="公司名称"/>
                    <a:column name="bank_account_num" editor="bankAccountDs_grid_editor_tf" prompt="账号" width="150"/>
                    <a:column name="bank_account_name" editor="bankAccountDs_grid_editor_tf" prompt="户名" width="200"/>
                    <a:column name="bank_account_type_n" editor="bankAccountDs_grid_editor_comb" prompt="账户类型"
                              width="100"/>
                    <a:column name="bank_type_new_n" editor="bankAccountDs_grid_editor_comb" prompt="账户类型(新)"
                              width="100"/>
                    <a:column name="ref_v02_n" editor="bankAccountDs_grid_editor_comb" prompt="收支性质"
                              width="100"/>
                    <a:column name="gld_account_code" editor="bankAccountDs_grid_editor_tf" prompt="科目代码" width="150"/>
                    <a:column name="currency_n" editor="bankAccountDs_grid_editor_comb" prompt="币种" width="100"/>
                    <a:column name="invoice_flag" align="center" editor="bankAccountDs_grid_editor_check" prompt="电子商业汇票功能"
                              width="150"/>
                    <a:column width="150" name="opening_date" editorFunction="fnd_work_calendar_ifEditor"  prompt="开户日期" align="center" renderer="task_authority_ds_grid_render"/>
                    <a:column width="150" name="closing_date" editor="fnd_work_calendar_ds_grid_dp"  prompt="销户日期" align="center" renderer="task_authority_ds_grid_render"/>
                    <a:column name="manager_name" editor="bankAccountDs_grid_editor_tf" prompt="客户经理" width="200"/>
                    <a:column name="contact" editor="bankAccountDs_grid_editor_tf" prompt="联系方式" width="200"/>
                    <a:column name="address" editor="bankAccountDs_grid_editor_tf" prompt="地址信息" width="200"/>
                    <a:column name="unit_bank_code" editor="bankAccountDs_grid_editor_tf" prompt="联行号" width="200"/>
                    <a:column name="city_n" editor="bankAccountDs_grid_editor_lov" prompt="城市" width="100"/>
                    <a:column name="valid_flag" align="center" editor="bankAccountDs_grid_editor_check" prompt="受限"
                              width="60"/>
                    <a:column width="150" name="valid_start" editor="fnd_work_calendar_ds_grid_dp"  prompt="受限开始日" align="center" renderer="task_authority_ds_grid_render"/>

                    <a:column name="enabled_flag" align="center" editor="bankAccountDs_grid_editor_check" prompt="启用"
                              width="60"/>

                    <a:column name="ref_v05" editor="bankAccountDs_grid_editor_tf" align="center" prompt="账号编码"
                              width="60"/>
                    <a:column name="purpose_type_n" editor="bankAccountDs_grid_editor_comb" prompt="用途类型"
                              width="100"/>
                    <a:column name="ref_v06" editor="bankAccountDs_grid_editor_tf" prompt="备注"
                              width="100"/>
                </a:columns>
                <a:editors>
                    <a:textField id="bankAccountDs_grid_editor_tf"/>
                    <a:comboBox id="bankAccountDs_grid_editor_comb"/>
                    <a:checkBox id="bankAccountDs_grid_editor_check"/>
                    <a:lov id="bankAccountDs_grid_editor_lov"/>
                    <a:lov id="bankAccountDs_company_grid_editor_lov"/>
                    <a:datePicker id="fnd_work_calendar_ds_grid_dp"></a:datePicker>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
