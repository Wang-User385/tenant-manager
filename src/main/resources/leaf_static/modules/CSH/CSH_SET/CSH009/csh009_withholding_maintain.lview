<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:view>

        <a:link id="prj_project_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify_entrance.lview"/>

        <script><![CDATA[




        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            if (name == 'contract_number' && value) {
                return '<a href="javascript:open_withholding_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_withholding_win(record_id , ds_id) {

            //获取ds
            var param = $(ds_id).findById(record_id).data;
              debugger;
            param['url_title'] = '进件明细';
            param['function_code'] = 'PRJ419F2';
            param['winid'] = 'hls_withholding_winid';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'prj_project_detail', ds_id, 'CSH009');
        }



        //发起代扣
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var records = $(ds_id).getSelected();
           if (records.length === 0) {
            Leaf.showErrorMessage('提示信息', "请勾选至少一条数据！");
                    return;
           }


            for (let i = 0; i < records.length(); i++) {
                var record = records[i];
                var payment_status = record.get('payment_status');
                if (!payment_status || payment_status == '0' || payment_status == '2') {
                    Leaf.showErrorMessage('提示信息', "请勾选交易状态为未发起扣款、扣款失败的数据！");
                    return;
                }
            }
            Leaf.request({
                url: '/gt/alipay/order/submit',
                success: function (res) {
                    Leaf.showSuccessMessage('提示', '发起代扣成功');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function (){
                    Leaf.showErrorMessage('提示', '发起代扣失败');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });


        };

        //查询交易状态
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var records = $(ds_id).getSelected();
                if (records.length === 0) {
            Leaf.showErrorMessage('提示信息', "请勾选至少一条数据！");
                    return;
           }
            for (let i = 0; i < records.length(); i++) {
                var record = records[i];
                var payment_status = record.get('payment_status');
                if (!payment_status || payment_status != '0') {
                    Leaf.showErrorMessage('提示信息', "请勾选交易状态为扣款中的数据！");
                    return;
                }
            }
            Leaf.request({
                url: '/gt/alipay/order/query',
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function (){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });

        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>