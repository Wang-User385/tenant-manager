<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <!--template_code自己命名  区分是按什么功能导入-->
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="CSH_PAYMENT_REQ_HD"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function returnBack() {
            top.refreshFrame();
        }

        function saveBtn() {
            var head_id = '${/model/header/record/@header_id}';
            var payment_req_id = '${/parameter/@payment_req_id}';
            Leaf.request({
                type: 'POST',
                url: "${/request/@context_path}/csh/payment/req/hd/import?headerId=" + head_id + '&paymentReqId=' + payment_req_id,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    Leaf.showMessage('提示', res.message);
                    returnBack();
                }
            });
        }

        function disableBtn() {
            $('saveBtn_id').disable();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="temp_interface_ds" autoQuery="true"
                       queryDataSet="temp_interface_query_ds"
                       queryUrl="${/request/@context_path}/fnd/interface/lines/query?headerId=${/model/header/record/@header_id}&amp;readLine=0">
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="财务流水信息导入" marginWidth="100">
                <a:grid id="temp_interface_grid_id" bindTarget="temp_interface_ds" marginHeight="150" navBar="true"
                        marginWidth="150">
                    <a:columns>
                        <a:column name="attributes_1" prompt="现金流方向" width="120" />
                        <a:column name="attributes_2" prompt="银行流水" width="100"/>
                        <a:column name="attributes_3" prompt="交易金额" width="80"/>
                        <a:column name="attributes_4" prompt="交易日期" align="right"
                                  renderer="Leaf.formatDate" width="100" />
                        <a:column name="attributes_5" prompt="流水摘要" width="200"/>
                        <a:column name="attributes_6" prompt="本方账号" width="200"/>
                        <a:column name="attributes_7" prompt="本方户名" width="80"/>
                        <a:column name="attributes_8" prompt="对方账号" width="200"/>
                        <a:column name="attributes_9" prompt="对方户名" width="80"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
