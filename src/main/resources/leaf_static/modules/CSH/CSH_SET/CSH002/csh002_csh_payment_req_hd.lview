<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>

        <a:link id="csh_repayment_req_create_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_hd_entrance.lview"/>
        <a:link id="bill001f2_modify_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_hd_detail.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');

            if(ds.id && '${/parameter/@layout_code}_G_GRID_csh_payment_req_hd_ds' == ds.id){
                //管理页面查询自己的单据
                if('${/parameter/@function_code}' == 'CSH002'){
                    qpara['authority'] = '${/session/@user_id}';
                }
            }

        };
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (record,document_type, business_type, employee_code) {
            Leaf.request({
                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    record.set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var param = {};
            param['url_title'] = '放款申请创建入口';
            param['function_code'] = 'CSH002F1';
            param['function_usage'] = 'CREATE';
            param['screen_width'] = '900';
            param['screen_height'] = '700';
            param['function_usage'] = 'CREATE';
            param['winid'] = 'csh_repayment_req_create_winId';
            hls_doc_get_layout_code(param, 'csh_repayment_req_create_link_id', 'CSH002');
        };


        function open_payment_req_number_win(ds_id, record_id) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var record = $(ds_id).getCurrentRecord();
            var creditFlag = record.get('credit_flag');

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            if (param['payment_req_status'] == 'NEW' || param['payment_req_status'] == 'REJECTED' ){
                if(creditFlag == 'Y'){
                    param['function_code'] = 'CSH002F2_CREDIT';
                }else {
                    param['function_code'] = 'CSH002F2';
                }
                param['url_title'] = '放款申请明细维护';
                param['function_usage'] = 'MODIFY';
                param['winid'] = 'csh_repayment_req_create_winId';
                param['parent_winid'] = 'csh_repayment_req_create_winId_close';

                hls_doc_get_layout_code(param, 'bill001f2_modify_link_id', ds_id, 'CSH002');
            } else{
                //param['function_code'] = 'CSH002F2Q';
                if(creditFlag == 'Y'){
                    param['function_code'] = 'CSH002F2QNEW_CREDIT';
                }else {
                    param['function_code'] = 'CSH002F2QNEW';
                }
                param['url_title'] = '放款申请明细维护';
                param['function_usage'] = 'QUERY';
                param['winid'] = 'csh_repayment_req_create_winId';
                param['parent_winid'] = 'csh_repayment_req_create_winId_close';

                hls_doc_get_layout_code(param, 'bill001f2_modify_link_id', ds_id, 'CSH002');
            }
        }


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            if (name == 'payment_req_number' && value) {
                return '<a href="javascript:open_payment_req_number_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
