<?xml version="1.0" encoding="UTF-8"?><a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"          trace="true">    <a:init-procedure>    </a:init-procedure>    <a:view>        <a:link id="csh002f2_entrance_create_link_id"                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_hd_detail.lview"/>        <script><![CDATA[        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (record,document_type, business_type, employee_code) {        debugger; Leaf.request({                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,                success: function (res) {                    record.set('authority_rule_string', res.result.record[0]);                },                sync: true,                scope: this            });        };        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');            if ($(ds_id).validate()) {                var record = $(ds_id).getCurrentRecord();                record.data.employee_id='${/session/@user_id}'                var param = record.data;                debugger;                window['${/parameter/@layout_code}_set_authority_rule_string'](record,"CSH_PAYMENT_REQ_HD", "CSH_PAYMENT_REQ_HD", '${/session/@employeeCode}');                Leaf.showConfirm('${l:HLS.PROMPT}', '确定创建？', function() {                    Leaf.request({                        url: '${/request/@context_path}/csh/payment/req/hd/csh_hd_create',                        para:  param,                        success: function (res) {                            param['function_code'] = 'CSH002F2';                            param['function_usage'] = 'CREATE';                            param['url_title'] = '放款申请明细维护';                            param['payment_req_id'] = res.result.record[0].payment_req_id;                            param['parent_winid'] = '${/parameter/@winid}';                            param['winid'] = 'csh002f2_create_screen_id';                            hls_doc_get_layout_code(param, 'csh002f2_entrance_create_link_id', ds_id, 'CSH002F2', param['parent_winid'], 'Y');                        }, failure: function () {                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();                        },                        error: function () {                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();                        },                        scope: this                    });                });            }        };        ]]></script>        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>    </a:view></a:screen>