                                head_record.set('unit_name', '${/session/@unitName}');
                                 head_record.set('unit_id', '${/session/@unitId}');*/
                /*
                                head_record.set('payment_type','PAYMENT');
                */
                head_record.set('employee_id', '${/session/@user_id}');
                head_record.set('employee_id_n', '${/session/@employeeName}');
                head_record.set('company_id', '${/parameter/@company_id}');
                /*  head_record.set('payment_req_status','NEW');
                  head_record.set('document_category','CSH_PAYMENT_REQ');
                  head_record.set('document_type','PAYMENT_REQ');
                  head_record.set('source_doc_type','CON_CONTRACT');
                  head_record.set('source_doc_id','${/parameter/@project_id}');
                  head_record.set('sum_toufang_amount','${/parameter/@sum_toufang_amount}');
                  head_record.set('payment_approved_status','NEW');
                  head_record.set('payment_number','${/parameter/@payment_number}');*/

                /*  head_record.set('contract_balance','${/parameter/@contract_balance}');
                  record.set('contract_currency', '${/parameter/@contract_currency}');
                  record.set('contract_currency_id', '${/parameter/@contract_currency_id}');*/

            }
        }


        //保存前调用 (调用编码规则 生成编号)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'F_PAY_SETTLE');

            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            var ln_data = $(ln_ds_id).data;
            // 二期功能：限定放款信息行，放款方式要统一
            //付款方式为 线上支付（TT）的付款行记录
            var paymentMethodOfTTCount = 0;
            //付款方式为 线下支付（OTHER）的付款行记录
            var paymentMethodOfOtherCount = 0;
            var amount=0;
            for (var i = 0; i < ln_data.length; i++) {
                amount+=ln_data[i].get('due_amount_ln');

                if ('TT' === ln_data[i].get('payment_method')){
                    paymentMethodOfTTCount++;
                } else if ('OTHER' === ln_data[i].get('payment_method')){
                    paymentMethodOfOtherCount++;
                }
            }
            if ((paymentMethodOfTTCount > 0 && paymentMethodOfTTCount < ln_data.length) ||
                (paymentMethodOfOtherCount > 0 && paymentMethodOfOtherCount < ln_data.length)){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                if(ds.id === ds_id) {
                    Leaf.showMessage('提示', '各放款信息行的放款方式必须是同一个！');
                }
                return false;
            }

            var hdAmount=$(ds_id).getCurrentRecord().get('loan_total_amount');
            if(amount > hdAmount){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                if(ds.id == ds_id) {
                    Leaf.showErrorMessage('提示', '放款行金额不能大于本次放款总额！');
                }
                return false;
            }

            if (record.get('payment_req_number')) {
                return true;
            }
            var documentCategory = 'CSH_PAYMENT_REQ';
            var documentType = 'PAYMENT_REQ';
            var businessType = 'PAYMENT_REQ';
            if ($(ds_id).getCurrentRecord().get('payment_req_number') == null) {
                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + documentCategory + "&documentType=" + documentType + "&businessType=" + businessType,
                    success: function (res) {
                        $(ds_id).getCurrentRecord().set('payment_req_number', res.result.record[0]);

                        check_flag = true;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function (res) {
                        check_flag = false;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        check_flag = false;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }
            return check_flag;

        };


        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //先校验维护放款信息行
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln', 'G_PLAN');
            var records = $(ds_id).getAll();
            if(records.length > 0){
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'F_FORM');
                var redemption_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
                var ds_id_1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
                var ds_id_2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_attachment');

                if ($(ds_id).isModified()) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '${l:EXIT_BEFORE_SAVE}');
                    return;
                }

                if ($(redemption_ds_id).isModified()) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '${l:EXIT_BEFORE_SAVE}');
                    return;
                }
                if ($(ds_id_1).isModified()) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '${l:EXIT_BEFORE_SAVE}');
                    return;
                }
                /*if ($(ds_id_2).isModified()) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '${l:EXIT_BEFORE_SAVE}');
                    return;
                }*/

                var redemption_data = $(redemption_ds_id).data;
                var redemption_amount = 0;
                //TODO 二期功能：限定放款信息行，放款方式要统一
                //付款方式为 线上支付（TT）的付款行记录
                var paymentMethodOfTTCount = 0;
                //付款方式为 线下支付（OTHER）的付款行记录
                var paymentMethodOfOtherCount = 0;
                for (var i = 0; i < redemption_data.length; i++) {
                    redemption_amount = plus(redemption_amount, redemption_data[i].get('sum_due_amount'));
                    if ('TT' === redemption_data[i].get('payment_method')){
                        paymentMethodOfTTCount++;
                    } else if ('OTHER' === redemption_data[i].get('payment_method')){
                        paymentMethodOfOtherCount++;
                    }
                }
                if ((paymentMethodOfTTCount > 0 && paymentMethodOfTTCount < redemption_data.length) ||
                    (paymentMethodOfOtherCount > 0 && paymentMethodOfOtherCount < redemption_data.length)){
                    Leaf.showMessage('提示', '各放款信息行的放款方式必须是同一个！');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }

                var loan_total_amount = $(ds_id).data[0].get('loan_total_amount');
                if ($(ds_id).data[0].get('loan_type') == 'ROUTINE') {
                    if (redemption_amount != loan_total_amount) {
                        Leaf.showMessage('提示', '各放款方式总额加和需等于本次放款总额');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }

                var purchaseContractBalance = 0;
                for(var i = 0; i < redemption_data.length; i++){
                    purchaseContractBalance = minus(redemption_data[i].get('purchase_contract_balance'),redemption_data[i].get('sum_due_amount'));
                    if(purchaseContractBalance < 0){
                        Leaf.showMessage('提示', '采购合同余额不能小于总额');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }

                /*
                            if (redemption_amount == loan_total_amount) {
                */

                if ($(ds_id).validate()) {
                    var record = $(ds_id).data[0].data;
                    var payment_req_id = record.payment_req_id;
                    if (payment_req_id != null) {
                        new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                            Leaf.request({
                                url: "${/request/@context_path}/hls/cus/con/loan/submit/wfl?paymentReqId=" + payment_req_id,
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    if (res.success) {
                                        //$('${/parameter/@parent_winid}').close();
                                        $("${/parameter/@winid}").close();

                                    } else {
                                        Leaf.showErrorMessage('提示', res.message);
                                    }
                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        }, function cancel() {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }, 200, 100);
                    } else {
                        $L.showInfoMessage("提示", "请先保存!", null);
                    }
                } else {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
                /*  }else{
                      Leaf.showMessage('提示','各放款方式总额加和需等于本次放款总额');
                      window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                      return false;
                  }*/
            }else{
                $L.showInfoMessage("提示", "请维护放款信息行!", null);
            }


        }




        $L.onReady(function () {
            //获取ref_project_id去查询审议数据
            /*var project_id = '${/parameter/@project_id}';
            if(project_id == ''){
                var param = parent.currentTaskInfo.execution_variables;
                project_id = param.filter(function (o) {
                       return o.name == "projectId";
                })[0].value;
            }
            Leaf.request({
                url: "${/request/@context_path}/prj/project/queryProjectByProjectId",
                para: {project_id : project_id},
                success: function (res) {
                    ref_project_id = res.result.record[0].ref_project_id;
                },
                error: function (res) {
                },
                failure: function (res) {
                },
                sync: true,
                scope: this
            });*/
        });

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if (ds.id && '${/parameter/@layout_code}_G_PAY_CON_prj_project_credit_condition_ds' == ds.id) {
                ds.setQueryParameter('project_id', '${/parameter/@payment_req_id}');
            }

            //审批历史gird
            var wh_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'G_WFL_HIS');
            if (wh_id && ds.id == wh_id) {
                ds.setQueryParameter('businessKey', '${/parameter/@payment_req_id}');
                ds.setQueryParameter('workFlowType', 'CON_PAYMENT_WFL');
            }
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            var project_id = '${/parameter/@project_id}';
            if(project_id == ''){
                var param = parent.currentTaskInfo.execution_variables;
                project_id = param.filter(function (o) {
                    return o.name == "projectId";
                })[0].value;
            }
            Leaf.request({
                url: "${/request/@context_path}/prj/project/queryProjectByProjectId",
                para: {project_id : project_id},
                success: function (res) {
                    if(res.result.record[0].data_type == 'CREDIT_NORMAL'){
                        ref_project_id=null;
                    }else {
                        ref_project_id = res.result.record[0].ref_project_id;
                    }
                },
                error: function (res) {
                },
                failure: function (res) {
                },
                sync: true,
                scope: this
            });
            //设置审议组件查询参数为父项目Id
            if (ds.id && get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_approval', 'F_AUDIT_INFO') == ds.id) {
                ds.setQueryParameter('project_id', ref_project_id);
            }
            if (ds.id && get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'G_QUOTATION') == ds.id) {
                ds.setQueryParameter('project_id', ref_project_id);
            }
        };

        function open_contract_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id).data;

            var param = {};
            param['url_title'] = '合同明细查询';
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['function_code'] = 'CONT301F1';
            param['project_id'] = record.project_id;
            //param['layout_debugger_flag'] = 'Y';

            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
        }

        function open_insure_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id).data;
            var param = {};
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];

            param['url_title'] = '保险明细';
            if (record.insure_id) {
                param['insure_id'] = record.insure_id;
                param['project_id'] = record.project_id;

                param['function_code'] = 'IM200';
                param['function_usage'] = 'QUERY';
                param['winid'] = 'im200q_insurance_detail_winid';
                hls_doc_get_layout_code(param, 'im200q_insurance_detail_link');
            } else {
                $L.showInfoMessage("提示", "没有找到保险信息!", null);

            }

        }

        function open_pledge_detail_win(record_id, ds_id) {

            var record = $(ds_id).findById(record_id).data;
            var param = {};
            param['url_title'] = '抵质押物明细';
            param['project_id'] = record.project_id;
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'sw001_pledge_lease_winid';
            hls_doc_get_layout_code(param, 'sw001_pledge_lease');
        }

        function open_notice_detail_win(ds_id, record_id) {

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var project_id = record.data.ref_project_id;
            /*
                        console.log(project_id)
            */
            new Leaf.Window({
                id: 'fnd_org_unit_define',
                url: "${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_maintain_meeting_query.lview",
                params: {
                    project_id: project_id,
                    function_usage: 'QUERY',
                    winId: "fnd_org_unit_define"
                },
                title: '项目批复落实情况',
                fullScreen: true,
                draggable: true,
                closeable: true
            });
        }

        /*附件超链接渲染*/
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'upload') {
                link_function = '${/parameter/@layout_code}_attachment_detail';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + config_record.get('prompt') + '</a>';
            } else if (name == 'contract_number') {
                link_function = 'open_contract_detail_win';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">合同明细</a>';
            } else if (name == 'insure_detail') {
                link_function = 'open_insure_detail_win';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">保险信息明细</a>';
            } else if (name == 'pledge_detail') {
                link_function = 'open_pledge_detail_win';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">抵质押信息</a>';
            } else if (name == 'notice_detail') {
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '批复信息' + '</a>';
            }else if (name == 'condition_upload') {
                link_function = '${/parameter/@layout_code}_attachment_condition';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + '附件' + '</a>';
            }
        };
        /*附件上传超链接函数*/
        window['${/parameter/@layout_code}_attachment_detail'] = function (record_id, name) {

            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];

            if (record.get('csh_attcahment_id')) {
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY') {

                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';

                }
                var win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('csh_attcahment_id'),
                        table_name: 'csh_payment_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_attachment');
                    $(ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }

        /*前提附件上传超链接函数*/
        window['${/parameter/@layout_code}_attachment_condition'] = function (record_id, name) {

            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];

            if (record.get('credit_condition_id')) {
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY') {

                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';

                }
                var win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('credit_condition_id'),
                        table_name: 'prj_condition_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
                    //$(ds_id).submit();
                    //$(ds_id).query();
                    $(ds_id).submit();
                    setTimeout(function () {
                        $(ds_id).query();
                    }, 1000);
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln', 'G_PLAN');
            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            var ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_attachment');

            if (ds.id === ds_id) {
                record.set('source_doc_category', 'CON_CONTRACT');
                record.set('source_doc_id', '${/parameter/@contract_id}');
                record.set('source_doc_line_id', '${/parameter/@cashflow_id}');
                record.set('project_id', '${/parameter/@project_id}');

                record.set('if_from_contract', 'Y');

            }
            if (ds.id === ds_id1) {
                record.set('project_id', '${/parameter/@payment_req_id}');
                record.set('new_flag', 'Y');
                if (record.get('new_flag') != 'Y') {
                    record.getField('conditions').setReadOnly(true);
                    record.getField('if_practicable').setReadOnly(false);
                    record.getField('implementation_lease').setReadOnly(false);
                    record.getField('implementation_situation').setReadOnly(false);

                } else {
                    record.getField('conditions').setReadOnly(false);
                    record.getField('if_practicable').setReadOnly(false);
                    record.getField('implementation_lease').setReadOnly(false);
                    record.getField('implementation_situation').setReadOnly(false);
                }
            }

            if (ds.id === ds_id2) {
                record.set('project_attachment_category', 'CON_PAYMENT');


            }

        }
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');

            /*      if(record.get('LOAN_TYPE')=='TARIFF'){
                      record.set('CURRENCY', 'CNY');
                      record.set('CURRENCY_N', '人民币');
                  }else{
                      record.set('CURRENCY', '${/parameter/@currency}');
                      record.set('CURRENCY_N', '${/parameter/@contract_currency}');

