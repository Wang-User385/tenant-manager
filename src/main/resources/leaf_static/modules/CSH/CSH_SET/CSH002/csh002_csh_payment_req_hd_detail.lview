        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {


            if (name == 'implementation_lease') {
                if (value == 'Y') {
                    record.getField('implementation_situation').setRequired(true);

                } else {
                    record.getField('implementation_situation').setRequired(false);

                }
            }
            if (name == 'payment_method') {
                if (value == 'BUS_ACCEPTANCE' || value == 'BANK_ACCEPTANCE') {
                    //record.getField('acceptance_period').setRequired(true);

                } else {
                    //record.getField('acceptance_period').setRequired(false);

                }

                if (value == 'BUS_ACCEPTANCE' || value == 'BANK_ACCEPTANCE' || value == 'COUNTRY_CREDIT' || value == 'INTERNATION_CREDIT') {
                    //record.getField('bill_type').setRequired(true)
                    //record.getField('bill_type_n').setRequired(true);

                    //record.getField('seq_num').setRequired(true);
                } else {
                    //record.getField('bill_type_n').setRequired(false);
                    //record.getField('bill_type').setRequired(false);
                    //record.getField('seq_num').setRequired(false);
                }

                if (value == 'TT') {
                    record.getField('bp_bank_account_name').setRequired(true);
                    record.getField('bp_bank_account_name_n').setRequired(true);

                } else {
                    record.getField('bp_bank_account_name').setRequired(false);
                    record.getField('bp_bank_account_name_n').setRequired(false);
                }
            }
            if (name == 'due_amount_ln' || name == 'seq_num') {

                if (record.get('payment_method') == 'BANK_ACCEPTANCE' || record.get('payment_method') == 'BUSINESS_ACCEPTANCE') {
                    record.set('sum_due_amount', record.get('due_amount_ln') * record.get('seq_num'))

                } else {
                    record.set('sum_due_amount', record.get('due_amount_ln'))

                }
            }

            /*if(name=='loan_type'){
                if(value=='TARIFF'){
                    record.set('currency', 'CNY');
                    record.set('currency_n', '人民币');


                }else{
                    record.set('currency', '${/parameter/@currency}');
                    record.set('currency_n', '${/parameter/@contract_currency}');

                }
            }*/

            if (name == 'payment_amount') {
                var amount = 1;
                var amount1 = record.get('payment_amount') * amount;
                record.set('rate', amount);
                record.set('actual_payment_amount', amount1);
            }
        }

        window['${/parameter/@layout_code}_G_PLAN_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln', 'G_PLAN');
            var payment_req_id = '${/parameter/@payment_req_id}';
            var win = new Leaf.Window({
                id: 'cshln_import_win_id',
                params: {
                    winid: 'cshln_import_win_id'
                },
                url: '${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_ln_import.lview?payment_req_id=' + payment_req_id,
                title: '放款信息导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(warrant_ds_id).query();
            });

        }


        window['${/parameter/@layout_code}_G_PAY_CON_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            var records = $(ln_ds_id).getSelected();
            if (records.length > 0) {
                var removeData = [];
                for (var i = 0; i < records.length; i++) {
                    /*  if(records[i].get('new_flag')!='Y'){
                         $L.showInfoMessage("提示", "付款条件为批复书携带，非新增单据不允许删除！", null);

                          return false;
                 }*/
                    records[i].set('__status', 'delete');
                    removeData.push(records[i].data);
                }
                Leaf.showConfirm('${l:HLS.PROMPT}', '确认删除?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody());
                    Leaf.request({
                        url: '${/request/@context_path}/prj/project/credit/condition/remove',
                        para: removeData,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ln_ds_id).query();
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        error: function () {
                            Leaf.Masker.unmask(Ext.getBody())
                        },
                        failure: function () {
                            Leaf.Masker.unmask(Ext.getBody())
                        },
                        sync: true,
                        scope: this
                    });
                });

            } else {
                $L.showInfoMessage("提示", "请至少选择一条数据!", null);
                return false;
            }

        }


        window['${/parameter/@layout_code}_G_PAY_CON_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            var records = $(ln_ds_id).getAll();
            Leaf.Masker.mask(Ext.getBody());
            if (records.length > 0) {
                var removeData = [];
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('if_practicable') == 'Y' && records[i].get('implementation_lease') == 'Y') {
                        $L.showInfoMessage("提示", "已落实和已豁免不能同时存在!", null);
                        Leaf.Masker.unmask(Ext.getBody());
                        return false;
                    }
                    if (records[i].get('credit_condition_id')) {
                        records[i].set('__status', 'update');
                    } else {
                        records[i].set('__status', 'insert');
                    }
                    removeData.push(records[i].data);
                }

                Leaf.Masker.mask(Ext.getBody());
                Leaf.request({
                    url: '${/request/@context_path}/prj/project/credit/condition/submit',
                    para: removeData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $(ln_ds_id).query();
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    sync: true,
                    scope: this
                });


            }

        }


        //租赁物资料下载
        window['${/parameter/@layout_code}_G_ATTACHMENT_INFO_USER_BUTTON5_layout_dynamic_tab_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_attachment', 'G_ATTACHMENT_INFO');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage("提示", "请选择需要导出的附件!", null);
                return;
            }
            var exportList = [];

            for (var i = 0; i < records.length; i++) {
                if(records[i].get('attachment_id') != null){
                    for(var item of records[i].get('attachment_id').split(",")) {
                        exportList.push(item);
                    }
                }
            }
            if(exportList.length == 0){
                Leaf.showMessage("提示", "无附件可导出!", null);
                return;
            }
            for (var i = 0; i < exportList.length; i++) {
                var a = document.createElement('a');
                a.href = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + exportList[i];
                a.download = 'filename';
                a.click();
            }
        };

        /*
        alert('${/parameter/@parent_winid}');
        */


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            $('${/parameter/@ds_id}').query();
            $('${/parameter/@winid}').close();

        }


        function beforeSubmit(countiune) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if ($(ds_id).isModified()) {
                $(ds_id).submit();
                countiune();

                return true;
            }
            countiune();


        };

        Leaf.onReady(function () {
            var wfl_flag= '${/parameter/@wfl_flag}' || 'N';
            if (wfl_flag == 'Y') {
                $('CSH002F2_submit_approval').hide();
                $('CSH002F2_exit').hide();
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
