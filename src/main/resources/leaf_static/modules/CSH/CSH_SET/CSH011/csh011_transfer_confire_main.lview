<!--
    Author: LI JING ZHOU
    Date: 2024/8/2
    Revision: 1.0
    Purpose: 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:view>

        <a:link id="prj_project_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify_new.lview"/>
        <a:link id="transfer_confirm_detail_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH011/csh011_transfer_confirm_detail.lview"/>



        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'contract_number' && value) {
                return '<a href="javascript:open_project_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_project_detail_win(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_number'] = param['contract_number'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['url_title'] = '进件明细';
            param['function_code'] = 'PRJ419F2';
            param['winid'] = 'review_detail_winid';
            hls_doc_get_layout_code(param, 'prj_project_detail', ds_id, 'CSH011');
        }



        //转付确认
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yl_csh_transfer_payment','G_CSH011_TC');
            var records = $(ds_id).getSelected();
            if (records.length == 0){
                Leaf.showInfoMessage('提示','请勾选未确认的数据！');
                return;
            }
            var param = {};
            var  payment_id_str = '';
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('transfer_payment_status_n') != '未确认'){
                    Leaf.showErrorMessage('提示','请勾选转付状态为未确认的数据！');
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return;
                }
                if (i == 0) {
                    payment_id_str = records[0].get('payment_id');
                } else {
                    payment_id_str = payment_id_str + ',' + records[i].get('payment_id')
                }
            }
            param['payment_id_str'] = payment_id_str;
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '转付确认';
            param['function_code'] = 'CSH011F1';
            param['winid'] = 'csh011_transfer_confirm_detail_winid';
            param['screen_width'] = 950;
            param['screen_height'] = 400;
            hls_doc_get_layout_code(param, 'transfer_confirm_detail_link_id', ds_id, 'CSH011');
        };

        //作废
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yl_csh_transfer_payment','G_CSH011_TC');
            var records = $(ds_id).getSelected();
            if (records.length == 0){
                Leaf.showInfoMessage('提示','请勾选未确认的数据！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }
            var printData = [];
            for (let i = 0; i < records.length; i++) {
                var record = records[i];
                if (record.get('transfer_payment_status_n') != '未确认'){
                    Leaf.showErrorMessage('提示','请勾选转付状态为未确认的数据！');
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return;
                }
                printData.push(record.data);
            }
            Leaf.request({
                url: '${/request/@context_path}/yl/csh/update/transfer/status',
                para: printData,
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(ds_id).query();
                },
                error: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });

        };





        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
