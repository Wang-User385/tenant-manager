<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">

    <a:view>
        <script><![CDATA[
        //确认
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yl_csh_transfer_payment','G_CSH011_TC');
            
            var print_data = '${/parameter/@print_data}';
            for (let i = 0; i < print_data.length; i++) {
                var data = print_data[i];
                // data['bank_statement'] =
            }
            Leaf.request({
                url: '${/request/@context_path}/yl/csh/confirm?bank_statement',
                para: print_data,
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                },
                error: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });

        };






        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
