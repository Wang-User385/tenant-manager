<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">

    <a:view>
        <script><![CDATA[
        //确认
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yl_csh_transfer_payment','F_TRANSFER_CONFIRM_FORM');
            var record = $(ds_id).getCurrentRecord();
            var payment_id_str = '${/parameter/@payment_id_str}';
            var extra_bank_statement = record.get('bank_statement');
            Leaf.request({
                url: '${/request/@context_path}/yl/csh/confirm',
                para: {
                    payment_id_str: payment_id_str,
                    extra_bank_statement: extra_bank_statement
                },
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                },
                error: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });

        };






        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
