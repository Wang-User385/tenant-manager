<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">

    <a:view>
        <script><![CDATA[
        //确认
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yl_csh_transfer_payment','F_TRANSFER_CONFIRM_FORM');
            // if (!$(ds_id).validate()){
            //     return;
            // }
            var record = $(ds_id).getCurrentRecord();
            var payment_id_str = '${/parameter/@payment_id_str}';
            var extra_bank_statement = record.get('bank_statement');
            var bank_account_name = record.get('bank_account_name');
            var bank_account_num = record.get('bank_account_num');
            var bank_account_id = record.get('bank_account_id');
            var comments = record.get('comments');
            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract','F_TRANSFER_CONFIRM_FORM2');
            var record1 = $(ds_id1).getCurrentRecord();
            var bp_bank_account_name = record1.get('bp_bank_account_name');
            var bp_bank_account_num = record1.get('bp_bank_account_num');
            var bp_bank_name = record1.get('bp_bank_name');
            var bank_branch_name_ex = record1.get('bank_branch_name_ex');
            Leaf.request({
                url: '${/request/@context_path}/yl/csh/confirm',
                para: {
                    payment_id_str: payment_id_str,
                    extra_bank_statement: extra_bank_statement,
                    bank_account_name: bank_account_name,
                    bank_account_num: bank_account_num,
                    comments: comments,
                    bp_bank_account_name: bp_bank_account_name,
                    bp_bank_account_num: bp_bank_account_num,
                    bp_bank_name: bp_bank_name,
                    bank_branch_name_ex: bank_branch_name_ex,
                    bank_account_id: bank_account_id
                },
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showSuccessMessage('提示',"转付确认成功");
                    $("csh011_transfer_confirm_detail_winid").close();
                },
                error: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $("csh011_transfer_confirm_detail_winid").close();
                },
                failure: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $("csh011_transfer_confirm_detail_winid").close();
                },
                sync: true
            });

        };






        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
