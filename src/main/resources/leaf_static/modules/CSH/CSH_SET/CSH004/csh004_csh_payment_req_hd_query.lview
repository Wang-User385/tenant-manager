<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="bill001f2_modify_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_hd_detail.lview"/>
        <script><![CDATA[


        function open_payment_req_number_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            if (param['payment_req_status'] == 'NEW' || param['payment_req_status'] == 'APPROVED_RETURN' ){
                param['function_code'] = 'CSH002F2';
                param['url_title'] = '放款申请明细维护';
                param['function_usage'] = 'MODIFY';
                hls_doc_get_layout_code(param, 'bill001f2_modify_link_id', ds_id, 'CSH002F2');
            } else{
                param['function_code'] = 'CSH002F2Q';
                param['url_title'] = '放款申请明细查询';
                param['function_usage'] = 'QUERY';
                hls_doc_get_layout_code(param, 'bill001f2_modify_link_id', ds_id, 'CSH002F2Q');
            }
        }


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            if (name == 'payment_req_number' && value) {
                return '<a href="javascript:open_payment_req_number_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {


            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var records = $(ds_id).getSelected();
            if(records.length != 1){
                Leaf.showMessage('提示','请选择一条数据！');
                return false;
            }
            var payment_req_id = records[0].get('payment_req_id');
            //模板类型代码
            var code = "CHS_PAYMENT_FILE";
            var url = "${/request/@context_path}/simple/doc/gen?code=" + code + "&paymentId=" + payment_req_id;
            //window.location.href = url;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
