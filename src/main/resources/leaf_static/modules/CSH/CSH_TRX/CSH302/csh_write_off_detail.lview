<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020年2月12日
    $Revision: 1.0
    $Purpose: 单个核销明细扩展栏
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[
            function csh_single_write_off_detail_ds_query(ds,qpara){
                qpara['write_off_doc_category'] = '${/parameter/@write_off_doc_category}';
                qpara['write_off_id'] = '${/parameter/@write_off_id}';
            }
        ]]>
        </script>
        <a:dataSets>

            <a:dataSet id="csh_single_write_off_detail_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/writeOff/CancelAfterVerification/query">
                <a:fields>
                    <a:field name="write_off_date" datatype="date"/>
                    <a:field name="transaction_amount"/>
                    <a:field name="description"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="payment_method_name"/>
                    <a:field name="cashflow_id"/>
                    <a:field name="write_off_id"/>
                    <a:field name="contract_number"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="csh_single_write_off_detail_ds_query"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:form column="3" labelWidth="100">
            <a:datePicker name="write_off_date" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                          prompt="核销日期" width="180"/>
            <a:textField name="write_off_type" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="类型" width="180"/>
            <a:textField name="contract_number" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="合同查询编号" width="180"/>

            <a:textField name="approval_number" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="业务合同编号" width="180"/>
            <a:textField name="times" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="期数" width="180"/>
            <a:textField name="bp_name" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="客户名称" width="180"/>

            <a:textField name="description" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="性质" width="180"/>
            <a:textField name="write_off_due_amount" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="核销金额" width="180"/>
            <a:textField name="write_off_principal" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="本金" width="180"/>

            <a:textField name="write_off_interest" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="利息" width="180"/>
            <a:textField name="import_flag" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="自动核销" width="180"/>
            <a:textField name="last_update_date" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="操作日期" width="180"/>

            <a:textField name="user_name" bindTarget="csh_single_write_off_detail_ds" readOnly="true"
                         prompt="操作人" width="180"/>
        </a:form>
    </a:view>

</a:screen>
