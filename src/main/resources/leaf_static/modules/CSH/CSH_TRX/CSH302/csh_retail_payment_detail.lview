<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="csh_payment_req_payment_link" url="${/request/@context_path}/csh/write/off/payment"/>
        <a:link id="hls_payment_dt_link"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_payment_dt.lview"/>
        <a:link id="bill001f111_query_link_id"
                url="${/request/@context_path}/modules/BILL/BILL001/hls_bill_request_wfl.lview"/>
        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <script><![CDATA[

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        function checkXls(name){
            return /\.(xls|xlsx)$/i.test(name)
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {

            debugger;
            //二期功能：
            var csh_payment_req_hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'BASIC_FORM');
            var csh_record = $(csh_payment_req_hd_ds).getCurrentRecord();
            if(!record.isNew){
                var payment_req_id = csh_record.get('payment_req_id');
                //实际支付信息
                var down_bank_account_ds = $('${/parameter/@layout_code}_F_ACTPAY_PAYMENT_csh_pay_req_ln_bank_account_ds');
                down_bank_account_ds.setQueryParameter('payment_req_id', payment_req_id);
                down_bank_account_ds.query();
            }

        }

        //确认支付
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            //先校验是否维护了实际付款
            var payment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_pay_req_ln_bank_account', 'F_ACTPAY_PAYMENT');
            var payment_records = $(payment_ds_id).getAll();
            var records = $(payment_ds_id).getSelected();
            var csh_bank_id = '';
            var payment_status = '';
            if ($(payment_ds_id).isModified()) {
                $L.showMessage('提示', '请先保存');
                return false;
            }
            var reqPaymentAmountSum = 0;
            var payment_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','PAYMENT_FORM');
            var hdRecords = $(payment_hd_ds_id).getAll();
            var reqPaymentAmount = hdRecords[0].get('amount');
            for (i = 0; i < payment_records.length; i++) {
                csh_bank_id = payment_records[i].get('csh_bank_id');
                if(csh_bank_id == 'undefined' || csh_bank_id == ''||csh_bank_id == null){
                    Leaf.showMessage("提示", "请先保存!");
                    return false;
                }
                reqPaymentAmountSum = plus(reqPaymentAmountSum, payment_records[i].get('actual_payment_amount'));
            }
            if (minus(reqPaymentAmountSum, reqPaymentAmount) != 0){
                check_flag = false;
                Leaf.showMessage('提示', '实际支付金额总和必须等于申请放款金额，请调整！');
                return false;
            }
            pay();
        }

        function pay() {
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var csh_payment_req_hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'PAYMENT_FORM');
            var csh_record = $(csh_payment_req_hd_ds).getCurrentRecord();
            var itemFlag = 'N';
            //二期零售业务标示
            var businessFlag = 'RETAIL';
            businessFlag = '';
            //取投放净值 ，作为付款金额
            //var transaction_amount = csh_record.get('loan_net_amount');
            //var transaction_date = csh_record.get('transaction_date');
            //实际支付日期当前页面没有维护，暂时给当前日期
            var actual_pay_date = new Date();
            var currency = csh_record.get('currency');
            var contract_id = csh_record.get('contract_id');
            var funding_plan_id = '${/parameter/@funding_plan_id}';
            var payment_req_id = csh_record.get('payment_req_id');
            //window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //return false;

            var today_date = Leaf.formatDate(new Date());

            //transaction_date = Leaf.formatDate(transaction_date);
            actual_pay_date = Leaf.formatDate(actual_pay_date);

            if (!actual_pay_date) {
                Leaf.showErrorMessage('提示', '请选择实际支付日期');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }
            if (actual_pay_date > today_date) {
                Leaf.showErrorMessage('提示', '实际支付日期不能大于当前日期');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }



            new Leaf.showConfirm("提示", "确认支付么？", function okFun() {


                Leaf.request({
                    url: $('csh_payment_req_payment_link').getUrl(),
                    para: {
                        //transactionAmount: transaction_amount,
                        transactionDate: actual_pay_date,
                        actual_pay_date: actual_pay_date,
                        currency: currency,
                        contract_id: contract_id,
                        //itemFlag: itemFlag,
                        businessFlag: businessFlag,
                        //fundingPlanId: funding_plan_id,
                        payment_req_id: payment_req_id
                    },
                    success: function (res) {

                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "付款支付成功!", function () {
                            $('${/parameter/@parent_ds}').query();
                            $('${/parameter/@winid}').close();
                        });

                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });

            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100);


        }

        function send(informations) {

            var winId = '${/parameter/@winId}';
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/csh/write/off/payment/submit',
                method: "POST",
                dataType: "json",
                async: false,
                contentType: "application/json",
                para: {hlsCusCshWriteOffList: informations},
                success: function (json) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    if (json.success) {
                        Leaf.showInfoMessage("提示", "支付成功", function (event) {
                            $('${/parameter/@parent_ds}').query();
                            $('${/parameter/@winid}').close();
                        })
                    } else {
                        Leaf.showErrorMessage(json.message);
                        return false;
                    }
                },
                error: function (e) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (e) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            });
        }

        // 超链接渲染 抵扣明细
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            debugger;
            if(name == 'bank_huizhi'){
                if(record.get('file_num') > 0){
                    return '<a href="javascript:open_attach(\'' + record.id + '\',\'' + record.get('csh_bank_id') + '\',\'' + record.ds.id + '\')">附件' + '(' +record.get("file_num") + ')' + '</a>'
                }else {
                    return '<a href="javascript:open_attach(\'' + record.id + '\',\'' + record.get('csh_bank_id') + '\',\'' + record.ds.id + '\')">上传</a>';
                }
             }
            if (name == 'preview') {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_names').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (var i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i]) || checkXls(fileNameList[i]) ) {
                            html += '<a href=javascript:queryDocFile(\'' + sourcePkList[i] + '\')> ' + fileNameList[i] + '在线预览</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
            return value;
        }
            //在线预览
            function queryDocFile(source_pk_value) {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            }

        //打开附件窗口
        function open_attach(record_id, id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }

            var url;
            var table_name;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
                table_name = 'CSH_PAY_REQ_LN_BANK_ACCOUNT';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
                table_name = 'CSH_PAY_REQ_LN_BANK_ACCOUNT';
            }
            var win = new Leaf.Window({
                id: 'payment_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: table_name,
                    function_usage:'${/parameter/@function_usage}',
                    winid: 'payment_open_attachment_winid'
                },
                title: '附件',
                width: 320,
                height: 295
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }


        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            //var redemption_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');

            if ($(ds_id).isModified()) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示', '${l:EXIT_BEFORE_SAVE}');
                return;
            }
            if ($(ds_id).validate()) {
                var record = $(ds_id).data[0].data;
                var payment_req_id = record.payment_req_id;
                if (payment_req_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: "${/request/@context_path}/hls/cus/con/payment/submit/wfl?paymentReqId=" + payment_req_id,
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                if (res.success) {
                                    //$('${/parameter/@parent_winid}').close();
                                    $("${/parameter/@winid}").close();

                                } else {
                                    Leaf.showErrorMessage('提示', res.message);
                                }
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                }
            } else {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }

        }


        function getActualAmount(payment_req_id) {

            var amount = null;
            Leaf.request({
                url: '${/request/@context_path}/csh/payment/queryActualPaymentAmount',
                para: {
                    paymentReqId: payment_req_id

                },
                sync: true,
                success: function (datas) {
                    if (datas.result.record.length > 0) {
                        amount = datas.result.record[0];
                    }
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
            return amount;
        }

        function getPayAmount(payment_req_id) {

            var payAmount = null;
            Leaf.request({
                url: '${/request/@context_path}/csh/payment/queryPaymentAmount',
                para: {
                    paymentReqId: payment_req_id

                },
                sync: true,
                success: function (datas) {
                    if (datas.result.record.length > 0) {
                        payAmount = datas.result.record[0];
                    }
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
            return payAmount;
        }

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            /*var check_flag = true;
            var out_balance_amt = 0;
            var actual_payment_amount = 0;
            var payment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_pay_req_ln_bank_account', 'F_ACTPAY_PAYMENT');
            var payment_records = $(payment_ds_id).getAll();
            if(!payment_records.isNew){
                //获取银行流水剩余金额
                if (payment_records.length !== 0){
                    for (i = 0; i < payment_records.length; i++) {
                        out_balance_amt = hdRecords[i].get('out_balance_amt');
                        actual_payment_amount = payment_records[i].get('actual_payment_amount');
                        if (minus(actual_payment_amount, out_balance_amt) > 0){
                            check_flag = false;
                            Leaf.showMessage('提示', '银行流水剩余可用金额小于实际付款金额');
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            return false;
                        }
                    }
                }
            }*/


            Leaf.request({
                url: '${/request/@context_path}/csh/payment/req/hd/status',
                para: {
                    paymentReqId: '${/parameter/@payment_req_id}'
                },
                sync: true,
                success: function (datas) {
                    if (datas.result.record.length > 0) {
                        if (datas.result.record[0].payment_approved_status == "APPROVING" || datas.result.record[0].payment_approved_status == "APPROVED") {
                            check_flag = false;
                            Leaf.showMessage('提示！', '该笔单据已经提交审批,不能更改！');
                        }
                    }
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });

            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        };


        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_pay_req_ln_bank_account');
            if (ds_id == ds.id && ds.id) {
                record.set('payment_name', decodeURI(decodeURI(decodeURI('${/parameter/@companySpvN}'))));
                record.set('payment_name_id', '${/parameter/@companySpv}');
                record.set('process_instance_id', '${/parameter/@process_instance_id}');
                record.set('payment_status', 'PAYING');
                record.set('payment_status_n', '未支付');
                record.set('payment_req_ln_id',record.get('payment_req_id'));
            }


        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');

        }
        function beforeSubmit(countiune) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var record = $('${/parameter/@layout_code}_F_ACTPAY_PAYMENT_csh_pay_req_ln_bank_account_ds').getCurrentRecord();
            var record1 = $(ds_id).getCurrentRecord();
            if ('${/parameter/@function_code}' == 'CSH008F2') {
                if (!record1.get('actual_pay_date')){
                    Leaf.showMessage('${l:PROMPT}', '请维护首次支付日期');
                    return false;
                }
                var csh_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_pay_req_ln_bank_account');
                if ($(csh_ds_id).isModified()) {
                    $L.showMessage('提示', '请先保存实际支付情况！');
                    return false;
                }
                var ds_records = $(csh_ds_id).getAll();
                if (ds_records.length <= 0) {
                    Leaf.showMessage('${l:PROMPT}', '请维护实际支付信息');
                    return false;
                } else {
                    var payment_amount = getPayAmount('${/parameter/@payment_req_id}');
                    if (minus(payment_amount , record1.get('loan_total_amount')) > 0) {
                        Leaf.showMessage('${l:PROMPT}', '实际支付信息付款总额之和不能大于本次付款总额');
                        return false;
                    }
                }



                if (!$(ds_id).validate()){
                    return false;
                }else{
                    $(ds_id).submit();
                }

                $(csh_ds_id).submit();

                countiune();
                return true;
            }

            countiune();
            return true;

        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
