<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh_transaction_refund_link_wfl_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_req_maintain_refund.lview"/>

        <a:link id="csh_transaction_refund_detail_link_wfl_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH307/csh_transaction_refund_detail.lview"/>

        <script><![CDATA[
        debugger;
        var businessKey = '${/parameter/@businessKey}';

        var param = parent.currentTaskInfo.execution_variables;

        var refundId = param.filter(function (o) {
            return o.name == "refundId";
        })[0].value;

        var function_code = 'CSH008REFUND1';
        // 当前审批节点ID
        var task_definition_key = parent.currentTaskInfo.task_definition_key || '';

        if (!Ext.isEmpty(task_definition_key) && task_definition_key === 'sid-lyJCwg13-dVll-46kK-8EgC-P5mZSPFHe8WS'){
            //出纳节点，跳转到付款申请详情页面
            var pageChooser = new PageChooser({
                url: $('csh_transaction_refund_link_wfl_id').getUrl(),
                function_code: function_code,
                context_path: '${/request/@context_path}',
                opt: {
                    refund_id: refundId,
                    source_id: businessKey,
                    function_usage: 'MODIFY',
                    function_code: function_code,
                    wfl_flag_payment: 'Y'
                },
                success: function (realUrl) {
                    location.href = realUrl;
                }
            });
        }else {
            var pageChooser = new PageChooser({
                url: $('csh_transaction_refund_detail_link_wfl_id').getUrl(),
                function_code: function_code,
                context_path: '${/request/@context_path}',
                opt: {
                    refund_id: refundId,
                    source_id: businessKey,
                    maintain_type: 'QUERY',
                    function_usage: 'QUERY',
                    function_code: function_code,
                    wfl_flag_payment: 'N'
                },
                success: function (realUrl) {
                    location.href = realUrl;
                }
            });
        }

        ]]></script>
    </a:view>
    <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
</a:screen>
