        function csh_to_pay() {
            debugger;
            var ds = 'csh_unpaid_list_result_ds';
            var records = $('csh_unpaid_list_result_ds').getSelected();
            if (records.length != 1) {
                Leaf.showErrorMessage("错误", "请先勾选一个再进行付款申请");
                return;
            }

            // var param = {};
            var param = records[0].data;
            param['url_title'] = '付款申请支付界面';
            //param['function_code'] = 'CSH008';
            param['function_code'] = 'CSH008NEW';
            param['winId'] = 'csh007_detail_win_id';
            param['function_usage'] = 'MODIFY';

            param['parent_ds'] = ds;

            // param['funding_plan_id']=  records[0].data.funding_plan_id;
            // param['ln_id_str'] = idArr.join('-');

            hls_doc_get_layout_code(param, 'CSH007_create_detail_id', ds);

            /*  var idArr = [], firstChecked = {};
              var accountFlag = true;
              jQuery.each(records, function (index, item) {
                  firstChecked = records[0].data;
                  if (index !== 0 && (firstChecked.bp_bank_account_name !== item.data.bp_bank_account_name ||
                      firstChecked.bp_bank_account_num !== item.data.bp_bank_account_num ||
                      firstChecked.self_bank_account_num !== item.data.self_bank_account_num ||
                      firstChecked.payment_method !== item.data.payment_method ||
                      firstChecked.bp_Id !== item.data.bp_Id ||
                      firstChecked.contract_id !== item.data.contract_id)) {
                      accountFlag = false;
                      Leaf.showErrorMessage("提示", "请勾选付款对象、付款账号,我方账号及付款方式相同的合同");
                      return false;
                  }
                  idArr.push(item.data.payment_req_ln_id);
              });*/
            // if (accountFlag) {
            //     csh_open_pay_detail(ds, idArr);
            // }
        }

        function csh_to_pay_cash() {
            debugger;
            var ds = 'csh_unpaid_list_result_ds';
            var records = $('csh_unpaid_list_result_ds').getSelected();
            if (records.length === 0) {
                Leaf.showErrorMessage("错误", "请先勾选一个再进行付款申请")
            }
            var idArr = [], firstChecked = {};
            var accountFlag = true;
            jQuery.each(records, function (index, item) {
                firstChecked = records[0].data;
                if (index !== 0 && (firstChecked.bp_bank_account_name !== item.data.bp_bank_account_name ||
                    firstChecked.bp_bank_account_num !== item.data.bp_bank_account_num ||
                    firstChecked.self_bank_account_num !== item.data.self_bank_account_num ||
                    firstChecked.payment_method !== item.data.payment_method ||
                    firstChecked.bp_Id !== item.data.bp_Id ||
                    firstChecked.contract_id !== item.data.contract_id)) {
                    accountFlag = false;
                    Leaf.showErrorMessage("提示", "请勾选付款对象、付款账号,我方账号及付款方式相同的合同");
                    return false;
                }
                idArr.push(item.data.payment_req_ln_id);
            });
            if (accountFlag) {
                csh_open_pay_detail_cash(ds, idArr)
            }
        }

