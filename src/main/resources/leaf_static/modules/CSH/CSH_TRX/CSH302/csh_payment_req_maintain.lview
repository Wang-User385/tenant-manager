    <!--二期功能：零售业务的付款申请 start-->
        function csh_retail_unpaid_list_query() {
            $('csh_retail_unpaid_list_result_ds').query();
        }

        function csh_retail_unpaid_list_reset() {
            $('csh_retail_unpaid_list_query_ds').reset();
            $('csh_retail_unpaid_list_result_ds').query();
        }


        function csh_retail_to_pay() {
            var ds = 'csh_retail_unpaid_list_result_ds';
            var records = $('csh_retail_unpaid_list_result_ds').getSelected();

            var function_usage = 'MODIFY';

            if (records.length != 1) {
                Leaf.showErrorMessage("错误", "请先勾选一个再进行付款支付");
                return;
            }
            for (var i = 0; i < records.length; i++) {
                var payment_approved_status = records[i].get('payment_approved_status');
                if (payment_approved_status === 'PAID'){
                    function_usage = 'QUERY';
                }
            }

            var param = records[0].data;
            param['url_title'] = '车辆业务付款支付';
            param['function_code'] = 'CSH008R1';
            param['winId'] = 'csh008r1_detail_win_id';
            param['function_usage'] = function_usage;

            param['parent_ds'] = ds;

            hls_doc_get_layout_code(param, 'CSH008R1_create_detail_id', ds);
        }

