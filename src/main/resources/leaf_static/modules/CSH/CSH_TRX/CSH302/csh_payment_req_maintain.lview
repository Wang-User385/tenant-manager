        function quotation_renderer(value, record, name) {
            return '<a href="javascript:rent_payment_make_quotation(\'' + record.get('quotation_id') + '\',\'' + record.get('price_list') + '\');">报价</a>';
        }
        //报价链接
        function rent_payment_make_quotation(quotation_id, price_list) {

            if (quotation_id != null) {

                //打开报价窗口
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                param['priceList'] = price_list;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['excel_edit'] = 'Y';

                hls_doc_get_layout_code(param, 'rptm001_calc_price_quotation_common_link_id', '${/parameter/@layout_code}_G_CASHFLOW_INFO_con_contract_cashflow_ds', "HLS900");

            } else {
                Leaf.showMessage("提示", "报价未计算成功，无法查看!", null);
                return false;
            }
        };

        //资金调拨单
        function csh_fund_transfer_order(){
            var ds_id = 'csh_unpaid_list_result_ds';
            var records = $(ds_id).getSelected();
            if(records.length != 1){
                Leaf.showMessage('提示','请选择一条数据！');
                return false;
            }
            var payment_req_id = records[0].get('payment_req_id');
            //模板类型代码
            var code = "FOUND_ALLOCATION_A";
            var url = "${/request/@context_path}/simple/doc/gen?code=" + code + "&paymentId=" + payment_req_id;
            //window.location.href = url;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //放款审批表
        function csh_loan_approval_form(){
            var ds_id = 'csh_unpaid_list_result_ds';
            var records = $(ds_id).getSelected();
            if(records.length != 1){
                Leaf.showMessage('提示','请选择一条数据！');
                return false;
            }
            var payment_req_id = records[0].get('payment_req_id');
            //模板类型代码
            var code = "PAYMENT_FILE";
            var url = "${/request/@context_path}/simple/doc/gen?code=" + code + "&paymentId=" + payment_req_id;
            //window.location.href = url;
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        function csh_loan_approval_form_zip(){

            var ds_id = 'csh_unpaid_list_result_ds';
            var records = $(ds_id).getSelected();
            if(records.length != 1){
                Leaf.showMessage('提示','请选择一条数据！');
                return false;
            }
            var paymentReqId = records[0].get('payment_req_id')
            Leaf.Masker.mask(Ext.getBody());

            var url = "${/request/@context_path}/csh/contract/content/package?sourceId=" + paymentReqId;
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    if(datas){
                        window.location.href = "${/request/@context_path}/attachment/package/download?fileName="+datas;

                    }                }
            });
            Leaf.Masker.unmask(Ext.getBody());

        }



