            return '<a href="javascript:csh302_open_reverse(\'' + record.get('transaction_id') + '\', \'' + record.get('transaction_date') + '\',\'' + record.get('contract_id') + '\')">反冲</a>';
        }

        function query_wfl_id(contractId) {
            var id;
            Leaf.request({
                url: '${/request/@context_path}/wfl/history/process/queryId?workFlowKey=GDXF_INCEPT_ACTUAL_DELIVERY_WFL&businessKey=' + contractId,
                success: function (res) {
                    if (res.result.record[0]) {
                        id = res.result.record[0].id_;
                    }
                }
            });
            return id;
        }

        function wfl_open(process_instance_id) {
            // var id = query_wfl_id(contractId);
            debugger;
            if (!process_instance_id) {
                Leaf.showInfoMessage("提示", "未找到对应工作流,请检查!");
                return false;
            }
            var processName = '付款支付审批流程';
            /*     new Leaf.Window({
                     id: 'win_process_instance_info_detail',
                     url: '${/request/@context_path}/modules/WFL/WFL003/process_instance_detail.lview',
                     params: {
                         id: process_instance_id
                     },
                     title: processName,
                     side: 'right',
                     fullScreen: true
                 });*/

            new Leaf.Window({
                id: 'win_process_instance_info_detail',
                url: '${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh302_csh_payment_req_hd_payment_approve.lview',
                params: {
                    id: process_instance_id,
                    taskId: -1
                },
                title: processName,
                side: 'right',
                fullScreen: true
            });
        }

        function unpaid_wfl_renderer(value, record) {
