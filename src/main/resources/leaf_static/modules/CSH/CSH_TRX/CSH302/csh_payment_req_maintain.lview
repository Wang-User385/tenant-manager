        function csh_open_pay_detail(ds, idArr) {
            debugger;
            var ds = 'csh_unpaid_list_result_ds';
            var records = $('csh_unpaid_list_result_ds').getSelected();
            var param = {};
            if(records.get('payment_approved_status')=='APPROVING' || records.get('payment_approved_status')=='APPROVED' ||records.get('payment_approved_status')=='PAYING' ||records.get('payment_approved_status')=='PAID'){
                param['function_code'] = 'CSH008NEW';
                param['url_title'] = '付款支付明细查询';
                param['function_usage'] = 'QUERY';
                param['payment_req_id'] = records.get('payment_req_id');

                param['winid'] = 'csh_repayment_req_create_winId';
                hls_doc_get_layout_code(param, 'CSH007_create_detail_id', ds);

            }else{
                param['url_title'] = '付款申请支付界面';
                param['function_code'] = 'CSH007';
                //param['winId'] = 'csh007_detail_win_id';
                param['parent_ds'] = ds;

                param['payment_req_id'] = records.get('payment_req_id');
                param['ln_id_str'] = idArr.join('-');

                hls_doc_get_layout_code(param, 'CSH007_create_detail_id', ds);
            }


            /* var url = $('csh_pay_link_id').getUrl();
             win = new Leaf.Window({
                 id: 'csh302_open_pay_winid',
                 url: url,
                 params: {
                     ds: ds,
