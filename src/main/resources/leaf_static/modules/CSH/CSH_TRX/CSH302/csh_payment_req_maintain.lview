        //进件明细
        function open_project_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '进件明细';
            param['function_code'] = 'PRJ419F2';
            param['winid'] = 'project_modify_winid';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['submit_hide'] = true;
            if( param['document_type'] === 'PRJL' ||param['document_type'] === 'PRJLB'){
                hls_doc_get_layout_code(param, 'PRJ419_project_modify_new_id', ds_id, 'PRJ419');
            }else{
                hls_doc_get_layout_code(param, 'PRJ419_project_modify_new_id', ds_id, 'PRJ419');
            }


        }

        function open_retail_payment_req_number_win(ds_id, record_id) {

            var record = $(ds_id).findById(record_id);

            var read_only = 'Y';
            var win = new Leaf.Window({
                id: 'csh_payment_req_query_win_id',
                url: $('csh_payment_req_detail_link_id').getUrl(),
                params: {
                    winId: 'csh_payment_req_query_win_id',
                    payment_req_id :  record.get('payment_req_id'),
                    read_only : read_only
                },
                title: '付款申请查询',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {

            });

        }
        <!--打开支付单详情-->
        function csh_retail_payment_detail_render(value, record, name) {
            return '<a href="javascript:csh_retail_payment_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">支付单明细</a>';

        }
        function csh_retail_payment_detail_win(ds_id, record_id) {

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'CSH008R1';
            param['url_title'] = '零售业务付款支付明细查询';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'csh_retail_repayment_req_create_winId';

            hls_doc_get_layout_code(param, 'CSH008R1_create_detail_id', ds_id, 'CSH008R1');



        }


    <!--二期功能：零售业务的付款申请 end-->

    <!--二期功能：付款支付-退款申请 start-->
        function csh_refund_unpaid_list_query() {
            $('csh_transaction_refund_grid_ds').query();
        }

        function csh_refund_unpaid_list_reset() {
            $('csh_retail_unpaid_list_query_ds').reset();
            $('csh_transaction_refund_grid_ds').query();
        }


        function csh_refund_to_pay() {
            debugger;
            var ds = 'csh_transaction_refund_grid_ds';
            var records = $('csh_transaction_refund_grid_ds').getSelected();
            var function_usage = 'MODIFY';
            if (records.length !== 1) {
                Leaf.showErrorMessage("错误", "请先勾选一行再进行退款申请支付");
                return;
            }
            var payment_refund_status = records[0].get('payment_refund_status');
            if (payment_refund_status == 'PAID' || payment_refund_status == 'CANCEL_PAY'){
               function_usage = 'QUERY';
            }

            var param = records[0].data;
            param['url_title'] = '退款申请支付界面';
            param['function_code'] = 'CSH008REFUND1';
            param['winId'] = 'csh008refund1_transaction_refund_win_id';
            param['function_usage'] = function_usage;
            param['refund_id'] = records[0].get('refund_id');


            param['parent_ds'] = ds;

            hls_doc_get_layout_code(param, 'csh_transaction_refund_link_id', ds);

        }
        //取消支付
        function csh_cancel_to_pay() {
            debugger;
            var ds = 'csh_transaction_refund_grid_ds';
            var records = $('csh_transaction_refund_grid_ds').getSelected();
            if (records.length !== 1) {
                Leaf.showErrorMessage("错误", "请先勾选一行再进行取消支付");
                return;
            }
            var refundId = records[0].get('refund_id');
            var payment_refund_status = records[0].get('payment_refund_status');
            if(payment_refund_status != 'PAYING'){
                Leaf.showErrorMessage("错误", "只有待支付状态的支付单可操作取消支付");
                return;
            }
            //取消支付
            var paymentRefundStatus = "CANCEL_PAY";
            var url = "${/request/@context_path}/cah/refund/cancel?refundId=" + refundId + "&paymentRefundStatus=" + paymentRefundStatus;
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '取消成功',
                        duration: 2000
                    });
                    $('csh_transaction_refund_grid_ds').query();
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });

        }

        function refund_num_renderer(value, record, name){
            if (name = 'refund_num') {
                return '<a href="javascript:window[\'open_refund_modify_win\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        }

        function open_refund_modify_win(id, dsid){
            var record = $(dsid).findById(id);
            var read_only = 'Y';
            var win = new Leaf.Window({
                id: 'csh_transaction_refund_modify_win_id',
                url: $('csh_transaction_refund_detail_link_id').getUrl(),
                params: {
                    win_id: 'csh_transaction_refund_modify_win_id',
                    refund_id : record.get('refund_id'),
                    read_only : read_only,
                    source_type : 'QUARY'
                },
                title: '退款明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh_transaction_refund_modify_query();
            });
        }

    <!--二期功能：付款支付-退款申请 end-->

        function csh_payment_detail_render(value, record, name) {
            return '<a href="javascript:csh_payment_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">支付单明细</a>';

        }
        ]]></script>
        <a:screenBody>
            <a:dataSet id="wfl_status_ds" lookupCode="HLS_WFL_STATUS"/>
            <a:dataSet id="payment_approved_status_ds" lookupCode="PAYMENT_APPROVED_STATUS"/>
            <a:dataSet id="payment_refund_status_ds" lookupCode="PAYMENT_REFUND_STATUS_NEW"/>

            <a:dataSets>
                <a:dataSet id="csh_unpaid_list_query_ds">
                    <a:fields>
                        <a:field name="queryDateFrom"/>
                        <a:field name="queryDateTo"/>
                        <a:field name="payInfo"/>
                        <a:field name="bankInfo"/>
                        <a:field name="contractInfo"/>
                        <a:field name="payment_approved_status_n" displayField="code_value_name" options="payment_approved_status_ds"
                                 returnField="payment_approved_status" valueField="code_value"/>
                    </a:fields>
                </a:dataSet>

                <a:dataSet id="csh_unpaid_list_result_ds" autoPageSize="true" autoQuery="true"
                           queryDataSet="csh_unpaid_list_query_ds"
                           queryUrl="${/request/@context_path}/csh/contract/home/secord/query"
                           selectable="true">
                    <a:fields>
                        <a:field name="payment_req_number"/>
                        <a:field name="status_n"/>
                        <a:field name="contract_number"/>
                        <a:field name="bp_name"/>
                        <a:field name="defray_number"/>
                        <a:field name="proposed_launch_date" datatype="date"/>
                        <a:field name="application_name"/>
                        <a:field name="application_date" datatype="date"/>
                        <a:field name="loan_total_amount"/>
                        <a:field name="unpaid"/>
                        <a:field name="loan_net_amount"/>
                        <a:field name="payment_approved_status_n"/>
                        <a:field name="payment_approved_status"/>
                    </a:fields>
                </a:dataSet>

                <!--二期功能：零售业务的付款申请 start-->
                <a:dataSet id="csh_retail_unpaid_list_query_ds">
                    <a:fields>
                        <a:field name="paymentReqNumber"/>
                        <a:field name="bp_name"/>
                        <a:field name="payInfo"/>
                        <a:field name="bankInfo"/>
                        <a:field name="payment_approved_status"/>
                        <a:field name="payment_approved_status_n" displayField="code_value_name" options="payment_approved_status_ds"
                                 returnField="payment_approved_status" valueField="code_value"/>
                    </a:fields>
                </a:dataSet>

                <a:dataSet id="csh_retail_unpaid_list_result_ds" autoPageSize="true" autoQuery="true"
                           queryDataSet="csh_retail_unpaid_list_query_ds"
                           queryUrl="${/request/@context_path}/csh/payment/retail/home/query"
                           selectable="true"
                           selectionModel="single">
                    <a:fields>
                        <a:field name="payment_req_number"/>
                        <a:field name="status_n"/>
                        <a:field name="bp_name"/>
                        <a:field name="proposed_launch_date" datatype="date"/>
                        <a:field name="after_deduct_amount"/>
                        <a:field name="unpaid"/>
                        <a:field name="payment_approved_status_n"/>
                        <a:field name="payment_approved_status"/>
                    </a:fields>
                </a:dataSet>
                <!--二期功能：零售业务的付款申请 end-->

                <!--二期功能：付款支付-退款申请 start-->
                <a:dataSet id="csh_transaction_refund_form_ds">
                    <a:fields>
                        <a:field name="refund_number"/>
                        <a:field name="payment_refund_status_n" displayField="code_value_name" options="payment_refund_status_ds"
                                 returnField="payment_refund_status" valueField="code_value"/>
                    </a:fields>
                </a:dataSet>
                <a:dataSet id="csh_transaction_refund_grid_ds" autoPageSize="true" autoQuery="true" selectable="true"
                           selectionModel="single"
                           queryDataSet="csh_transaction_refund_form_ds"
