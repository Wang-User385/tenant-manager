        function csh_refund() {
            var ds = $('csh_transaction_receipt_refund_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '请至少选择一条数据！');
                return;
            }
            /* var saveData = [];
             for (var i = 0; i < records.length; i++) {
                 saveData.push(records[i].data);
             }*/
            var refund_id = records[0].get('refund_id');
            var  url;
            debugger;
            if(records[0].get('payment_refund_status')=='PAID'||records[0].get('payment_refund_status')=='APPROVING'||records[0].get('payment_refund_status')=='PAYING'){
                url=$('csh302_transaction_refund_query_link').getUrl()
            }else{
                url=$('csh302_transaction_writeoff_refund_link').getUrl()

            }

            var win = new Leaf.Window({
                id: 'transaction_writeoff_refund_apply_winId',
                url: url,
                params: {
                    winId: 'transaction_writeoff_refund_apply_winId',
                    refund_id: refund_id
                },
                title: '收款退款',
                width: 1000,
                height: 300,
                draggable: true
            });
            /* Leaf.Masker.mask(Ext.getBody(), '正在提交。。');
             Leaf.request({
                 url: '${/request/@context_path}/csh/transaction/refund',
                 para: saveData,
                 success: function (res) {
                     Leaf.SideBar.show({
                         msg: '${l:HLS.SUBMIT_SUCCESS}',
                         duration: 2000
                     });
                     csh_refund_list_query();
                     Leaf.Masker.unmask(Ext.getBody());
                 },
                 error: function () {
                     Leaf.Masker.unmask(Ext.getBody())
                 },
                 failure: function () {
                     Leaf.Masker.unmask(Ext.getBody())
                 },
                 sync: true,
                 scope: this
             });*/
        }
        <!--render函数-->
        function formateDate(value, record, name){
            if(value!=""&&value!=undefined){
                var date = new Date(value);
                var yy = date.getFullYear();
                var mm = date.getMonth() + 1;
                var dd = date.getDate();
                mm = (mm < 10) ? '0' + mm : mm;
                dd = (dd < 10) ? '0' + dd : dd;
                var dateStr=yy + '-' + mm + '-' + dd;
                return dateStr;
            }
            else{
                return "";
            }
        }

        function refund_detail_renderer(value, record, name) {
            return '<a href="javascript:winOpen_detail(\'' + record.get('refund_id') + '\');">支付单明细</a>';
