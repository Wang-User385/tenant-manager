        // 反冲
        function csh302_open_reverse(transaction_id, transaction_date, contract_id) {
            var url = $('csh_reverse_link_id').getUrl();
            win = new Leaf.Window({
                id: 'csh302_open_reverse_winid',
                url: url,
                params: {
                    transaction_id: transaction_id,
                    winId: 'csh302_open_reverse_winid',
                    payment_date: transaction_date,
                    contract_id: contract_id
                },
                title: '付款反冲',
                width: 800,
                height: 375
            });
            win.on('close', function () {
                $('csh_unpaid_list_result_ds').query();
            });
        }

        // 明细
