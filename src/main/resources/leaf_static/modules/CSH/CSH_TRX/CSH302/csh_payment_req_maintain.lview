                        <a:form column="4" labelWidth="100">
                            <a:datePicker name="queryDateFrom" bindTarget="csh_paid_list_query_ds"
                                          prompt="申请日期从" width="160"/>
                            <a:datePicker name="queryDateTo" bindTarget="csh_paid_list_query_ds"
                                          prompt="申请日期到" width="160"/>
                            <a:textField name="payInfo" bindTarget="csh_paid_list_query_ds"
                                         prompt="付款对象" width="160"/>
                            <a:textField name="bankInfo" bindTarget="csh_paid_list_query_ds"
                                         prompt="银行账户信息" width="160"/>
                            <a:textField name="contractInfo" bindTarget="csh_paid_list_query_ds"
                                         prompt="合同信息" width="160"/>
                        </a:form>
                        <a:grid bindTarget="csh_paid_list_result_ds" marginHeight="193" marginWidth="80"
                                navBar="true">
                            <a:columns>

                                <a:column name="contract_name" prompt="合同名称" width="250"/>
                                <a:column name="contract_number" prompt="合同编号" width="200"/>
                                <a:column name="transaction_date" prompt="付款日期" width="120" renderer="Leaf.formatDate"/>
                                <a:column name="payment_amount" prompt="付款金额	" width="150" align="right"
                                          renderer="Leaf.formatMoney"/>
                                <a:column name="bank_account_name" prompt="户名" width="200"/>
                                <a:column name="bank_name" prompt="银行名称" width="150"/>
                                <a:column name="bank_account_num" prompt="账号" width="150"/>
                                <a:column name="bp_bank_name" prompt="对方账户" width="150"/>
                                <a:column name="bp_bank_account_name" prompt="户名" width="200"/>
                                <a:column name="bp_bank_account_num" prompt="账号" width="150"/>
                                <a:column name="payment_req_date" prompt="付款操作人" width="120"/>
                                <a:column name="detail" prompt="明细" width="40" align="center" renderer="detail_renderer"/>
                                <a:column name="wfl_detail" prompt="审批明细" width="80" align="center" renderer="wfl_renderer"/>
                                <a:column name="reverse" prompt="反冲" width="40" align="center" renderer="reverse_renderer"/>
                            </a:columns>
                        </a:grid>

                    </a:tab>-->

                    <!--二期功能：付款支付-退款申请 start-->
                    <a:tab prompt="待支付清单-退款申请" width="250">
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="csh_refund_unpaid_list_query" text="HAP.QUERY"/>
                            <a:gridButton click="csh_refund_unpaid_list_reset" text="HAP.RESET"/>
                            <a:gridButton click="csh_refund_to_pay" text="去付款"/>
                            <a:gridButton click="csh_cancel_to_pay" text="取消支付"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="110">
                            <a:textField name="refund_number" bindTarget="csh_transaction_refund_form_ds"
                                         prompt="退款申请编号" width="160"/>
                            <a:textField name="bp_name" bindTarget="csh_transaction_refund_form_ds"
                                         prompt="客户名称" width="160"/>
                            <a:textField name="bp_bank_account_name" bindTarget="csh_transaction_refund_form_ds"
                                         prompt="收款对象账户" width="160"/>
                            <a:textField name="bp_bank_account_num" bindTarget="csh_transaction_refund_form_ds"
                                         prompt="收款对象账号" width="160"/>
                            <a:numberField name="refund_amount_from" bindTarget="csh_transaction_refund_form_ds"
                                           prompt="退款金额从" width="160"/>
                            <a:numberField name="refund_amount_to" bindTarget="csh_transaction_refund_form_ds"
                                           prompt="退款金额到" width="160"/>
                            <a:datePicker name="refund_date_from" bindTarget="csh_transaction_refund_form_ds"
                                          prompt="申请退款日期从" width="160"/>
                            <a:datePicker name="refund_date_to" bindTarget="csh_transaction_refund_form_ds"
                                          prompt="申请退款日期到" width="160"/>
                            <a:comboBox name="payment_refund_status_n"
                                        bindTarget="csh_transaction_refund_form_ds"
                                        prompt="支付单状态" width="160"/>

                        </a:form>
                        <a:grid bindTarget="csh_transaction_refund_grid_ds" marginHeight="193" marginWidth="80"
                                navBar="true">
                            <a:columns>
                                <a:column name="refund_number" prompt="退款申请编号" align="left" width="150" renderer="refund_num_renderer"/>
                                <a:column name="bp_name" prompt="客户名称" width="200"/>
                                <a:column name="bp_bank_name" prompt="收款银行" width="200"/>
                                <a:column name="bp_bank_account_name" prompt="收款对象账户" width="250"/>
                                <a:column name="bp_bank_account_num" prompt="收款对象账号" width="240"/>
                                <a:column name="refund_date" prompt="申请退款日期" align="center"
                                          renderer="Leaf.formatDate"/>
                                <a:column name="refund_amount" prompt="退款金额" align="right" width="100"
                                          renderer="Leaf.formatMoney"/>
                                <!--<a:column name="currency_name" prompt="币种" width="80"/>-->
                                <a:column name="payment_refund_status_n" prompt="支付单状态" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--二期功能：付款支付-退款申请 end-->


                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
