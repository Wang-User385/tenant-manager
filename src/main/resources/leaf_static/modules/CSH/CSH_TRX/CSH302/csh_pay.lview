<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020年2月14日
    $Revision: 1.0
    $Purpose: 付款申请支付
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[
        function csh_actual_payment_info_ds_query(ds, para) {
            para['ln_id_str'] = '${/parameter/@ln_id_str}';
        }

        function send(informations) {
            var winId = '${/parameter/@winId}';
            Leaf.Masker.mask($(winId).wrap, '正在支付。。');
            Leaf.request({
                url: '${/request/@context_path}/csh/write/off/payment/submit',
                method: "POST",
                dataType: "json",
                async: false,
                contentType: "application/json",
                para: {hlsCusCshWriteOffList: informations},
                success: function (json) {
                    Leaf.Masker.unmask($(winId).wrap);
                    if (json.success) {
                        Leaf.showInfoMessage("提示", "支付成功", function (event) {
                            $('${/parameter/@ds}').query();
                            $('${/parameter/@winId}').close();
                        })
                    } else {
                        Leaf.showErrorMessage(json.message);
                        return false;
                    }
                },
                error: function (e) {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                failure: function (e) {
                    Leaf.Masker.unmask($(winId).wrap);
                }
            });
        }

        function pay() {
            var record = $('csh_actual_payment_info_ds').getCurrentRecord();
            var transaction_date = record.get('transaction_date');
            var transaction_amount = record.get('amount');
            var payment_method = record.get('payment_method');
            var description = record.get('description');
            var bankNum = record.get('bank_account_num');
            var bankSlipNum = record.get('bank_slip_num');
            if (!transaction_date) {
                Leaf.showErrorMessage('提示', '请选择付款日期');
                return false;
            } else if (!payment_method) {
                Leaf.showErrorMessage('提示', '请选择付款方式');
                return false;
            } else if (!bankNum) {
                Leaf.showErrorMessage('提示', '请选择付款账户');
                return false;
            }
            if (transaction_date > new Date()) {
                Leaf.showErrorMessage('提示', '付款日期不能大于当前日期');
                return false;
            }
            var informations = [];
            var cshTransaction = [];
            var grid = $('csh_actual_payment_info_grid_ds').getAll();
            transaction_date = Leaf.formatDate(transaction_date);
            cshTransaction.push({
                'transactionDate': transaction_date,
                'penaltyCalcDate': transaction_date,
                'transactionAmount': transaction_amount,
                'currencyCode': grid[0].data.currency,
                'paymentMethod': payment_method,
                'bankAccountId': record.get('bank_account_id'),
                'bpId': grid[0].data.bp_id,
                'bpBankAccountId': grid[0].data.bp_bank_account_id,
                'bpBankName': grid[0].data.bp_bank_name,
                'bpBankBranchName': record.get('bp_bank_branch_name'), //grid._data[0].bp_bank_branch_name,
                'bpBankAccountNum': grid[0].data.bp_bank_account_num,
                'bpBankAccountName': grid[0].data.bp_bank_account_name,
                'description': description,
                "bankSlipNum": bankSlipNum,
                'sourceDocCategory': "CSH_PAYMENT_REQ", //付款申请头
                'sourceDocId': grid[0].data.payment_req_id,
                'transactionCategory': "CSH_TRANSACTION",
                'transactionType': "PAYMENT",
                'businessType': "PAYMENT",
                'reversedFlag': "N",
                'writeOffFlag': "NOT",
                "transactionNum": "abcdefg"
            });
            var index = 0;
            for (var i = 0; i < grid.length; i++) {
                if (!grid[i].data.payment_amount) {
                    continue;
                }
                if (grid[i].data.payment_amount > grid[i].data.amount) {
                    viewModel.showErrorMessage("付款金额不能大于申请金额");
                    return false;
                }
                if (grid[i].data.payment_amount > grid[i].data.amount - grid[i].data.amount_paid) {
                    viewModel.showErrorMessage("付款金额不能大于未支付金额");
                    return false;
                }
                var paymentAmount = grid[i].data.payment_amount;
                if ((paymentAmount + "").indexOf(',') != -1) {
                    paymentAmount = paymentAmount.replace(/,/g, '');
                }
                if (grid[i].data.source_doc_category === "FCT_CONTRACT") {
                    var writeOffType = "CT_FCT_PAYMENT_DEBT";
                } else {
                    var writeOffType = 'PAYMENT_DEBT';
                }
                informations.push({
                    '__status': 'add',
                    'writeOffType': writeOffType,//区分租赁保理
                    'writeOffDate': transaction_date,//付款日期
                    'cshWriteOffAmount': paymentAmount,//每一个申请行对应的付款金额
                    'reversedFlag': "N",
                    'cashflowId': grid[i].data.source_doc_line_id,  //每一个申请行对应的现金流ID
                    'contractId': grid[i].data.source_doc_id,
                    'times': grid[i].data.times,
                    'cfItem': grid[i].data.cf_item,
                    'cfType': grid[i].data.cf_type,
                    'writeOffDueAmount': grid[i].data.payment_amount,
                    'paymentReqLineId': grid[i].data.payment_req_ln_id,
                    'paymentReqId': grid[i].data.payment_req_id,
                    'description': description,
                    'cshTransaction': index === 0 ? cshTransaction[0] : null
                });
                index++;

            }

            Leaf.request({
                url: '${/request/@context_path}/ct/csh/write/off/confirm?contractId=' + informations[0].contractId + '&writeOffType=' + informations[0].writeOffType,
                method: "GET",
                async: false,
                dataType: "json",
                contentType: "application/json",
                success: function (datas) {
                    var data = datas.result.record[0];
                    if (data === "true") {
                        send(informations);
                    } else if (data === "false" && informations[0].writeOffType === "PAYMENT_DEBT") {
                        Leaf.showConfirm("提示", "确认支付么？该笔放款下的前期款项未全部核销！", function () {
                            send(informations);
                        });
                    } else if (data === "false") {
                        Leaf.showInfoMessage("提示", "该笔放款下的前期款项未全部核销, 请先核销");
                    }
                }
            });
        }

        function bank_account_handler(lov) {
            lov.para = {
                'companyId': '${/session/@companyId}'
            };
        }

        function csh_payment_amount_load(ds) {
            var records = ds.getAll();
            records.forEach(function (e) {
                e.set('payment_amount', e.get('unpaid_amount'));
            })
        }

        ]]>
        </script>
        <a:dataSets>
            <a:dataSet id="payment_method_ds" lookupCode="CSH.PAYMENT_METHOD"/>

            <a:dataSet id="csh_actual_payment_info_ds" autoPageSize="true" autoQuery="true" pageSize="1"
                       queryUrl="${/request/@context_path}/csh/CshPaymentReqLnDetail/query">
                <a:fields>
                    <a:field name="transaction_date" required="true" datatype="date"/>
                    <a:field name="payment_method_n" required="true" returnField="payment_method"
                             valueField="code_value"
                             displayField="code_value_name" prompt="付款对象" options="payment_method_ds"/>
                    <a:field name="amount"/>
                    <a:field name="unpaid_amount"/>
                    <a:field name="bank_account_name" required="true" requiredMessage="付款对象账户必填" autoComplete="true"
                             lovGridHeight="350" lovHeight="550" lovLabelWidth="90"
                             lovService="/hls/cus/csh/bank/account/query~com.hand.hls.layout.dto.LovBankAccountDto"
                             lovWidth="800"
                             title="本方支付账户" prompt="本方支付账户">
                        <a:mapping>
                            <a:map from="bank_account_id" to="bank_account_id"/>
                            <a:map from="bank_account_num" to="bank_account_num"/>
                            <a:map from="bank_account_name" to="bank_account_name"/>
                            <a:map from="bank_name" to="bank_name"/>
                            <a:map from="bank_code" to="bank_code"/>
                            <a:map from="bank_full_name" to="bank_full_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bank_account_num"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="description"/>
                    <a:field name="payment_amount" readOnly="false" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="csh_actual_payment_info_ds_query"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="csh_actual_payment_info_grid_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/CshPaymentReqLnDetail/query">
                <a:fields>
                    <a:field name="transaction_date" required="true" datatype="date"/>
                    <a:field name="amount"/>
                    <a:field name="unpaid_amount"/>
                    <a:field name="bank_account_num"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="description"/>
                    <a:field name="payment_amount" readOnly="false" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="csh_actual_payment_info_ds_query"/>
                    <a:event name="load" handler="csh_payment_amount_load"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenTopToolbar>
            <a:screenTitle/>
            <a:gridButton click="pay" text="支付"/>
        </a:screenTopToolbar>
        <a:form column="4" labelWidth="100" prompt="实际支付信息" title="实际支付信息">
            <a:datePicker name="transaction_date" bindTarget="csh_actual_payment_info_ds"
                          prompt="付款日期" width="250"/>
            <a:comboBox name="payment_method_n" bindTarget="csh_actual_payment_info_ds"
                        prompt="支付方式" width="250"/>
            <a:textField name="amount" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="本次申请金额" width="250"/>
            <a:textField name="unpaid_amount" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="剩余未支付金额" width="250"/>
            <a:lov name="bank_account_name" width="250" prompt="银行账户"
                   bindTarget="csh_actual_payment_info_ds">
                <a:events>
                    <a:event name="beforeTriggerClick" handler="bank_account_handler"/>
                </a:events>
            </a:lov>
            <a:textField name="bank_account_num" bindTarget="csh_actual_payment_info_ds"
                         prompt="银行账号" width="250"/>
            <a:textField name="bank_slip_num" bindTarget="csh_actual_payment_info_ds"
                         prompt="银行流水号" width="250"/>
            <a:textField name="description" bindTarget="csh_actual_payment_info_ds"
                         prompt="摘要" width="250"/>
        </a:form>
        <a:form column="4" labelWidth="100" prompt="支付结算申请信息" title="支付结算申请信息">
            <a:textField name="payment_obj" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="付款对象" width="250"/>
            <a:textField name="bp_bank_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="对方银行名称" width="250"/>
            <a:textField name="bp_bank_branch_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="对方开户支行" width="250"/>
            <a:textField name="bp_bank_account_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="对方账户名" width="250"/>
            <a:textField name="bp_bank_account_num" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="对方账户号" width="250"/>
            <a:textField name="self_bank_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="我方银行名称" width="250"/>
            <a:textField name="self_bank_branch_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="我方开户支行" width="250"/>
            <a:textField name="self_bank_account_name" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="我方账户名" width="250"/>
            <a:textField name="self_bank_account_num" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                         prompt="我方账户号" width="250"/>
            <a:comboBox name="payment_method_desc" bindTarget="csh_actual_payment_info_ds" readOnly="true"
                        prompt="支付方式" width="250"/>
        </a:form>

        <a:grid bindTarget="csh_actual_payment_info_grid_ds" marginHeight="193" marginWidth="80"
                navBar="true">
            <a:columns>
                <a:column name="contract_number" prompt="单据编号" width="200"/>
                <a:column name="tenant_name" prompt="付款对象" width="200"/>
                <a:column name="contract_name" prompt="合同名称" width="250"/>
                <a:column name="times" prompt="应付期数" width="60"/>
                <a:column name="yf_description" prompt="应付项目" width="60"/>
                <a:column name="due_date" prompt="应付日期" width="120" renderer="Leaf.formatDate"/>
                <a:column name="due_amount" prompt="应付金额" width="140" align="right" renderer="Leaf.formatMoney"/>
                <a:column name="amount" prompt="本次申请金额" width="140" align="right" renderer="Leaf.formatMoney"/>
                <a:column name="unpaid_amount" prompt="剩余未支付金额" width="140" align="right" renderer="Leaf.formatMoney"/>
                <a:column name="payment_amount" editor="amount_nf" prompt="本次支付金额" width="140" align="right"
                          renderer="Leaf.formatMoney"/>
            </a:columns>
            <a:editors>
                <a:numberField id="amount_nf"/>
            </a:editors>
        </a:grid>
    </a:view>

</a:screen>
