<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh002_csh_payment_detail_approve_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_detail.lview"/>

        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;
        // debugger;
        var companySpvN = '${/parameter/@companySpvN}';
       /* var projectId = param.filter(function (o) {
            return o.name == "projectId";
        })[0].value;

        var contractId = param.filter(function (o) {
            return o.name == "contractId";
        })[0].value;
        var fundingPlanId = param.filter(function (o) {
            return o.name == "fundingPlanId";
        })[0].value;*/
        //复核岗复核
/*
        var task_id = 'sid-qGUzoX9V-otdr-4Y0s-8doa-Qb3pqKWkVV9P';
*/
        //初审岗
        var first_task_id = 'sid-aEcwlE0m-shWF-4Epu-86oo-rhVzWm8p71cc';
        var current_activity_id = parent.currentTaskInfo.task_definition_key;
        var process_instance_id = parent.currentTaskInfo.process_instance_id;
        var function_code = 'CSH008';
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
       /* var first_flag = 'N';
        var check_flag = 'N';*/

    /*    if(current_activity_id == task_id){
            function_code = 'CONT301F24WFL';
            maintain_type = 'MODIFY';
            function_usage = 'MODIFY';
        }*/
        if(current_activity_id == first_task_id){
            function_code = 'CSH008F2';
            maintain_type = 'MODIFY';
            function_usage = 'MODIFY';
        }

        var companySpvN = param.filter(function (o) {
            return o.name == "companySpvN";
        })[0].value;
        var companySpv = param.filter(function (o) {
            return o.name == "companySpv";
        })[0].value;


        var pageChooser = new PageChooser({

            url: $('csh002_csh_payment_detail_approve_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                payment_req_id: businessKey,
                function_code: function_code,
                maintain_type: maintain_type,
                function_usage: function_usage,
                companySpvN:companySpvN,
                companySpv:companySpv,
                process_instance_id:process_instance_id,
                wfl_flag:"Y"
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
