<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh_penalty_wfl_detail_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH901LS/csh_penalty_interest_reduce_detail_wfl.lview"/>
        <script><![CDATA[
        debugger;

        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;
        var contractId=param.filter(function(o){
            return o.name=='contractId';
        })[0].value;
        debugger
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var function_code = 'CSH901LSF1WFL';

        var hidden_button_code = [];
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-Ewu9dlQd-XHGT-4xgg-ASUS-dZxy3TXqAwF0"  ){
            maintain_type = 'MODIFY';
            function_usage = 'MODIFY';
            hidden_button_code.push('USER_BUTTON1');
            hidden_button_code.push('EXIT');
        }

        var pageChooser = new PageChooser({
            url: $('csh_penalty_wfl_detail_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                change_req_id:      businessKey,
                contract_id:contractId,
                maintain_type: maintain_type,
                function_usage: function_usage,
                function_code: function_code,
                hidden_button_code:hidden_button_code
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>