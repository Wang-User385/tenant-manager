<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: chenliangxian
    $Date:2022年12月26日
    $Revision: 1.0
    $Purpose: 二期功能:退款申请审批页面跳转
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh_transaction_refund_wfl_approve_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH307/csh_transaction_refund_detail.lview"/>
        <iframe style="border:none;" src="" width="100%" height="500px" name="frame" noresize="noresize" id="frame">
        </iframe>

        <script><![CDATA[
            var frame = document.getElementById("frame");
            var link_id = 'csh_transaction_refund_wfl_approve_link_id';
            frame.src = $(link_id).getUrl() + '?businessKey='+'${/parameter/@businessKey}';

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

