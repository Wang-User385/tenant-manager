<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年3月15日
    $Revision: 1.0
    $Purpose: 保证金抵扣&&保证金池抵扣
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="csh_deposit_deduction_link" url="${/request/@context_path}/csh/deposit/deduction/approval"/>
        <script type="text/javascript"><![CDATA[
        var contract_id = '${/parameter/@contract_id}';
        var transaction_id= '${/parameter/@transaction_id}';
        var WRITE_OFF_TYPE = '${/parameter/@write_off_type}';

        function csh303_deposit_deduction_add() {
            $('csh_deposit_deduction_detail_grid_id').showEditorByRecord($('csh_deposit_deduction_ln_ds').create());
        }


        var can_return_amount_old = 0;
        var can_return_amount_new = 0;


        function csh303_deposit_deduction_delete() {

            //释放剩余可核销金额
            var ds = $('csh_deposit_deduction_ln_ds');
            var records = ds.getAll();
            var record = ds.getCurrentRecord();
            var csh_write_off_amount = 0;
            if (records.length >= 1) {
                for (var i = 0; i < records.length; i++) {
                    csh_write_off_amount = plus(csh_write_off_amount, records[i].get("write_off_due_amount") || 0);
                }
            }

            var current_record_amount = record.get("write_off_due_amount") || 0;
            var head_ds = $('csh_deposit_deduction_hd_ds');
            var hd_record = head_ds.getCurrentRecord();
            var transaction_amount = hd_record.get("transaction_amount") || 0;
            var write_off_amount = hd_record.get("write_off_amount") || 0;

            can_return_amount_old = plus(minus(minus(transaction_amount, write_off_amount), csh_write_off_amount), current_record_amount);
            hd_record.set("can_return_amount", can_return_amount_old);

            $('csh_deposit_deduction_detail_grid_id').clear();
        }

        function csh303_deposit_deduction() {
            var head_ds = $('csh_deposit_deduction_hd_ds');
            var line_ds = $('csh_deposit_deduction_ln_ds');
            if (head_ds.validate()) {
                var transaction_date = head_ds.getAt(0).get("transaction_date");

                if (line_ds.validate()) {

                    var records = line_ds.getAll();

                    if (records.length == 0) {
                        Leaf.showMessage('提示！', '请至少新增一条记录！');
                        return;
                    }
                    //组装数据
                    var saveData = [];
                    for (var i = 0; i < records.length; i++) {
                        records[i].set("write_off_date", transaction_date);
                        records[i].set("write_off_type", WRITE_OFF_TYPE);
                        records[i].set("csh_transaction_id", transaction_id);
                        records[i].set("deduction_date", transaction_date);
                        records[i].set("deduction_type", 'DEPOSIT_DEDUCT_CREDIT');
                        records[i].set("deduction_doc_category", 'CON_CONTRACT');
                        records[i].set("transaction_id", transaction_id);
                        records[i].set("deduction_amount", records[i].get("write_off_due_amount"));
                        records[i].set("deduction_principal", records[i].get("write_off_principal"));
                        records[i].set("deduction_interest", records[i].get("write_off_interest"));
                        records[i].set("deposit_status", 'NEW');
                        records[i].set("__status", 'insert');

                        saveData.push(records[i].data);
                    }
                    var winId = '${/parameter/@winId}';
                    Leaf.Masker.mask($(winId).wrap, '提交中。。');
                    Leaf.request({
                        url: $('csh_deposit_deduction_link').getUrl(),
                        para: saveData,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            Leaf.Masker.unmask($(winId).wrap);
                            csh303_deposit_deduction_return();
                        },
                        failure: function () {
                            Leaf.Masker.unmask($(winId).wrap);
                        },
                        error: function () {
                            Leaf.Masker.unmask($(winId).wrap);
                        },
                        scope: this
                    });
                }
            }
        }

        function csh303_deposit_deduction_return() {
            csh303_deposit_query();
            $('${/parameter/@winId}').close();
        }


        function deposit_contract_number_lov_before_event(lov) {
            var ds = $('csh_deposit_deduction_ln_ds');
            var records = ds.getAll();
            var record = ds.getCurrentRecord();
            var not_cashflow_ids_str = '';
            var csh_write_off_amount = 0;
            if (records.length >= 1) {
                for (var i = 0; i < records.length; i++) {
                    if (i == 0) {
                        not_cashflow_ids_str = records[i].get("cashflow_id")
                    } else {
                        not_cashflow_ids_str = not_cashflow_ids_str + ',' + records[i].get("cashflow_id");
                    }
                    csh_write_off_amount = plus(csh_write_off_amount, records[i].get("write_off_due_amount") || 0);
                }
            }
            var current_record_amount = record.get("write_off_due_amount") || 0;

            var contract_number = record.getMeta().getField('contract_number');
            //排除掉之前选择的现金流
            contract_number.setLovPara('notCashflowIdsStr', not_cashflow_ids_str);
            contract_number.setLovPara('contractId', contract_id);
            contract_number.setLovPara('cfStatus', 'RELEASE');
            contract_number.setLovPara('cfDirection', 'INFLOW');
            contract_number.setLovPara('SurplusAmountFlag', 'Y');

            var head_ds = $('csh_deposit_deduction_hd_ds');
            var hd_record = head_ds.getCurrentRecord();
            var transaction_amount = hd_record.get("transaction_amount") || 0;
            var write_off_amount = hd_record.get("write_off_amount") || 0;

            can_return_amount_old = plus(minus(minus(transaction_amount, write_off_amount), csh_write_off_amount), current_record_amount);
            hd_record.set("can_return_amount", can_return_amount_old);
        }


        function deposit_contract_number_lov_commit_event(lov, r1, r2) {

            //金额判断
            var head_ds = $('csh_deposit_deduction_hd_ds');
            var record = head_ds.getCurrentRecord();
            var can_return_amount = can_return_amount_old;//record.get('can_return_amount');

            var write_off_due_amount = r1.get('write_off_due_amount')|| 0;
            var write_off_principal = r1.get('write_off_principal')|| 0;
            var write_off_interest = r1.get('write_off_interest')|| 0;

            if (minus(can_return_amount, write_off_interest) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', 0);
                r1.set('write_off_interest', can_return_amount);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));

            } else if (minus(can_return_amount, write_off_interest) > 0 && minus(can_return_amount, write_off_due_amount) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', minus(can_return_amount, write_off_interest));
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));
            }

            if (minus(can_return_amount, write_off_due_amount) > 0) {
                r1.set('write_off_due_amount', write_off_due_amount);
                r1.set('write_off_principal', write_off_principal);
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, write_off_due_amount));
            }

            can_return_amount_new = record.get("can_return_amount");
        }

        function deposit_line_ds_update_event(ds, record, name, value, oldValue) {
            var head_ds = $('csh_deposit_deduction_hd_ds');
            var head_record = head_ds.getCurrentRecord();
            var can_return_amount = head_record.get('can_return_amount');
            var write_off_due_amount = record.get('write_off_due_amount');

            //更新剩余可核销金额
            if (name == 'write_off_due_amount') {
                var surplus_amount = record.get('surplus_amount');
                var surplus_principal = record.get('surplus_principal');
                var surplus_interest = record.get('surplus_interest');
                if ((oldValue === 0 || oldValue)) {
                    head_record.set('can_return_amount', minus(can_return_amount_new, minus(value, oldValue)));
                    can_return_amount_new = head_record.get("can_return_amount");
                }
                if (minus(value, surplus_amount) > 0) {
                    Leaf.showErrorMessage('提示', '金额超过剩余金额！', null, 200, 100);
                    return;
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) <= 0) {
                    record.set('write_off_principal', 0);
                    record.set('write_off_interest', value || 0);
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) >= 0) {
                    record.set('write_off_principal', minus(value, surplus_interest));
                    record.set('write_off_interest', surplus_interest);
                }
            }
        }


        ]]></script>

        <a:dataSets>
            <a:dataSet id="yes_no_ds" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="csh_deposit_deduction_hd_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/query?transactionId=${/parameter/@transaction_id}">
                <a:fields>
                    <a:field name="transaction_date" datatype="date" required="true"/>
                    <a:field name="transaction_amount" readOnly="true" prompt="抵扣日期"/>
                    <a:field name="can_return_amount" readOnly="true"/>
                    <a:field name="can_return_amount" readOnly="true"/>
                    <!--<a:field name="is_polishing_deposit_n" returnField="is_polishing_deposit"
                             options="yes_no_ds" displayField="code_value_name" valueField="code_value"
                             required="true" prompt="是否补收保证金"/>
                    <a:field name="is_polishing_deposit"/>-->
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_deposit_deduction_ln_ds" selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                    <a:field name="contract_number" autoComplete="true" required="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/queryLov~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="contract_name" to="contract_name"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="times" to="times"/>
                            <a:map from="contract_seq" to="contract_seq"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="due_date" to="due_date"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="cf_item_n" to="cf_item_n"/>
                            <a:map from="cf_item" to="cf_item"/>
                            <a:map from="cf_type" to="cf_type"/>
                            <a:map from="surplus_amount" to="surplus_amount"/>
                            <a:map from="surplus_principal" to="surplus_principal"/>
                            <a:map from="surplus_interest" to="surplus_interest"/>

                            <a:map from="surplus_amount" to="write_off_due_amount"/>
                            <a:map from="surplus_principal" to="write_off_principal"/>
                            <a:map from="surplus_interest" to="write_off_interest"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="deposit_line_ds_update_event"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh303_deposit_deduction_add" text="新增"/>
                <a:gridButton click="csh303_deposit_deduction_delete" text="删除"/>
                <a:gridButton click="csh303_deposit_deduction" text="提交"/>
                <a:gridButton click="csh303_deposit_deduction_return" text="HLS.RETURN"/>
            </a:screenTopToolbar>
            <a:form column="4" labelWidth="120">
                <a:datePicker name="transaction_date" bindTarget="csh_deposit_deduction_hd_ds"
                              prompt="冲抵日期"/>
                <a:numberField name="transaction_amount" bindTarget="csh_deposit_deduction_hd_ds"
                               prompt="保证金金额"/>
                <a:numberField name="can_return_amount" bindTarget="csh_deposit_deduction_hd_ds"
                               prompt="剩余可抵扣金额"/>
                <!--<a:comboBox name="is_polishing_deposit_n" bindTarget="csh_deposit_deduction_hd_ds"
                            prompt="是否补收保证金"/>-->
            </a:form>
            <a:grid id="csh_deposit_deduction_detail_grid_id"
                    bindTarget="csh_deposit_deduction_ln_ds" marginHeight="200" marginWidth="80"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="contract_number" prompt="合同编号" editor="deposit_editor_lov" width="120"/>
                    <a:column name="contract_name" prompt="合同名称" width="120"/>
                    <!--<a:column name="contract_seq" prompt="报价序号" align="center" width="80"/>-->
                    <a:column name="times" prompt="期数" width="80"/>
                    <a:column name="bp_name" prompt="承租人" width="200"/>
                    <a:column name="due_date" prompt="预定收款日期" width="150" renderer="Leaf.formatDate"/>
                    <a:column name="due_amount" prompt="预定收款金额" renderer="Leaf.formatMoney" align="right"
                              width="150"/>
                    <a:column name="cf_item_n" prompt="性质" width="80"/>
                    <a:column name="surplus_amount" prompt="剩余金额" renderer="Leaf.formatMoney" align="right"
                              width="150"/>
                    <a:column name="write_off_due_amount" prompt="核销金额" editor="deposit_editor_nf"
                              align="right" renderer="Leaf.formatMoney"
                              width="150"/>
                    <a:column name="write_off_principal" prompt="本金" align="right"
                              renderer="Leaf.formatMoney" width="150"/>
                    <a:column name="write_off_interest" prompt="利息" align="right"
                              renderer="Leaf.formatMoney" width="150"/>
                </a:columns>
                <a:editors>
                    <a:lov id="deposit_editor_lov">
                        <a:events>
                            <a:event name="beforetriggerclick"
                                     handler="deposit_contract_number_lov_before_event"/>
                            <a:event name="commit" handler="deposit_contract_number_lov_commit_event"/>
                        </a:events>
                    </a:lov>
                    <a:numberField id="deposit_editor_nf" allowNegative="false"/>
                </a:editors>
            </a:grid>


        </a:screenBody>

    </a:view>
</a:screen>
