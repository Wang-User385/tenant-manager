<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年8月18日
    $Revision: 3.0
    $Purpose: 保证金管理
    $Modify : 出资方银行账户
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <script type="text/javascript"><![CDATA[
        function csh303_deposit_sec_exit() {
            $('${/parameter/@winid}').close();
        }

        function csh303_deposit_sec_execute() {
            var ds = $('csh_deposit_result_ds');
            var account_ds = $('csh_deposit_bank_account_ds');
            var records = ds.getSelected();
            var account_records = account_ds.getAll();

            var saveData = [];
            for (var i = 0; i < records.length; i++) {
                records[i].set('deposit_id', '${/parameter/@deposit_id}');
                saveData.push(records[i].data);
            }

            var accountDate = [];
            for (var i = 0; i < account_records.length; i++) {
                account_records[i].set('deposit_id', '${/parameter/@deposit_id}');
                accountDate.push(account_records[i].data);
            }
            Leaf.Masker.mask(Ext.getBody(), '提交中...');

            Leaf.request({
                url: "${/request/@context_path}/hls/duration/deposit/account/submit",
                para: accountDate,
                success: function (res) {
                    Leaf.request({
                        url: "${/request/@context_path}/hls/duration/deposit/submit",
                        para: saveData,
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            csh303_deposit_sec_exit();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        scope: this
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });


        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="payment_method_ds" lookupCode="CSH.PAYMENT_METHOD"/>
            <a:dataSet id="csh_deposit_bank_account_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="deposit_id" defaultValue="${/parameter/@deposit_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_deposit_bank_account_ds" autoQuery="true"
                       queryDataSet="csh_deposit_bank_account_query_ds"
                       queryUrl="${/request/@context_path}/hls/duration/deposit/account/detail/query"
                       submitUrl="${/request/@context_path}/hls/duration/deposit/account/submit"
                       deleteUrl="${/request/@context_path}/hls/duration/deposit/account/remove" selectable="true">
                <a:fields>
                    <a:field name="bank_account_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90" lovService="/csh/bank/account/query~hls.layout.dto.LovCshBankAccountDto"
                             lovWidth="850" required="true" title="CSH511.BANK_ACCOUNT_CODE" prompt="付款账户">
                        <a:mapping>
                            <a:map from="bank_account_id" to="bank_account_id"/>
                            <a:map from="bank_account_num" to="bank_account_num"/>
                            <a:map from="bank_account_name" to="bank_account_name"/>
                            <a:map from="bank_account_code" to="bank_account_code"/>
                            <a:map from="bank_branch_name" to="bank_branch_name"/>
                            <a:map from="currency" to="currency_code"/>
                            <a:map from="currency_n" to="currency_n"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bank_account_num" readOnly="true"/>
                    <a:field name="currency_n" readOnly="true"/>
                    <a:field name="currency_code" readOnly="true"/>
                    <a:field name="refund_amount" required="true"/>
                    <a:field name="payment_method_n" displayField="code_value_name" options="payment_method_ds"
                             returnField="payment_method" valueField="code_value" required="true"/>
                    <a:field name="deposit_id" defaultValue="${/parameter/@deposit_id}"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh303_deposit_sec_exit" text="退出"/>
                <a:gridButton click="csh303_deposit_sec_execute" text="执行方案"/>
            </a:screenTopToolbar>
            <a:grid id="csh_deposit_bank_account_grid_ds"
                    bindTarget="csh_deposit_bank_account_ds" width="750" height="300"
                    navBar="true">
                <a:toolBar>
                    <a:button type="add"/>
                    <a:button type="delete"/>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="bank_account_name" prompt="付款账户" editor="grid_lov" width="150"/>
                    <a:column name="bank_account_num" prompt="付款账号" width="150"/>
                    <a:column name="refund_amount" align="right" editor="grid_number" prompt="付款金额" width="120"
                              renderer="Leaf.formatMoney"/>
                    <a:column name="payment_method_n" prompt="付款方式" editor="grid_cb" width="80"/>
                    <a:column name="bank_slip_num" prompt="银行流水" editor="grid_tf" width="120"/>
                </a:columns>
                <a:editors>
                    <a:lov id="grid_lov"/>
                    <a:numberField id="grid_number"/>
                    <a:comboBox id="grid_cb"/>
                    <a:textField id="grid_tf"/>
                </a:editors>
            </a:grid>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

