<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>

        <script><![CDATA[


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            debugger;
            ds.queryurl=ds.queryurl+'&wflRuleControlFlag=Y';
            if(ds.id == '${/parameter/@layout_code}_G_GRID_con_debt_exemption_req_cf_ds'){
                qpara['change_req_id'] = '${/parameter/@change_req_id}';
            }
            if(ds.id == '${/parameter/@layout_code}_G_ATTACHMENT_con_debt_attachment_ds'){
                qpara['contract_id'] = '${/parameter/@contract_id}';
                debugger
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            if(ds.id == '${/parameter/@layout_code}_F_FORM_con_debt_exemption_req_ds'){
                qpara['change_req_id'] = '${/parameter/@change_req_id}';
            }
        };
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            var link_function = '${/parameter/@layout_code}_attachment_detail';
            if (name === 'attach_link') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">上传/下载</a>';
            }
            return value;
        };
        //打开附件窗口
        window['${/parameter/@layout_code}_attachment_detail'] = function (record_id, name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if (record.get('debt_attachment_id')) {
                var win = new Leaf.Window({
                    id: 'CSH_OPEN_ATTACHMENT_WINID',
                    url: url,
                    params: {
                        header_id: record.get('debt_attachment_id'),
                        table_name: 'con_debt_attachment',
                        winid: 'CSH_OPEN_ATTACHMENT_WINID',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '附件',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_debt_attachment');
                    $(ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
