        //     if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_debt_attachment')) {
        //         record.set('contract_id', '${/parameter/@contract_id}');
        //         record.set('debt_attachment_category', 'DEBT_EXEMPTION');
