        //     var win = new Leaf.Window({
        //         id: 'CSH_OPEN_ATTACHMENT_WINID',
        //         url: url,
        //         params: {
        //             header_id: record.get('debt_attachment_id'),
        //             table_name: 'con_debt_attachment',
        //             winid: 'CSH_OPEN_ATTACHMENT_WINID',
