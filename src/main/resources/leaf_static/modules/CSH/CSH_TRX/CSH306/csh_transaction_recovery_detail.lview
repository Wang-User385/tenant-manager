<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月19日
    $Revision: 1.0
    $Purpose: 收款管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <script><![CDATA[

        function CurrentMonthLast() {
            debugger;
            var date = new Date();
            var currentMonth = date.getMonth();
            var nextMonth = ++currentMonth;
            var nextMonthFirstDay = new Date(date.getFullYear(), nextMonth, 1);
            var oneDay = 1000 * 60 * 60 * 24;
            return new Date(nextMonthFirstDay - oneDay);
        }

        function csh306_transaction_query() {
            $('csh_transaction_recovery_detail_result_ds').query();
        }

        function csh306_transaction_quit() {
            $('csh_transaction_recovery_detail_winId').close();
        }

        function detail_ds_query(ds, para) {debugger;
            var ds = $('csh_transaction_recovery_query_ds');
            var record = ds.getCurrentRecord();
            para['dueDateFrom'] = record.get('due_date_from');
            para['dueDateTo'] = record.get('due_date_to');
        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="csh_transaction_recovery_detail_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/csh/recovery/rate/home"
                       selectable="true">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="project_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="unit_name"/>
                    <a:field name="due_date"/>
                    <a:field name="due_amount"/>
                    <a:field name="received_amount"/>
                    <a:field name="surplus_amount"/>
                    <a:field name="cf_item_desc"/>
                    <a:field name="payment_method_n"/>
                    <a:field name="spv_company_n"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="detail_ds_query"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh306_transaction_quit" text="返回汇总表"/>
            </a:screenTopToolbar>
            <a:fieldSet labelWidth="150" title="应收查询" style="margin-left:20px">
                <a:grid id="csh_transaction_recovery_detail_grid_ds" bindTarget="csh_transaction_recovery_detail_result_ds"
                        marginHeight="190" marginWidth="80" navBar="true">
                    <a:columns>
                        <a:column name="bp_name" prompt="机构名称" width="150" align="center"/>
                        <a:column name="bp_name" prompt="客户名称" width="150" align="center"/>
                        <a:column name="contract_number" prompt="合同编号" width="150" align="center"/>
                        <a:column name="due_date" prompt="应收日期" align="right" width="100"/>
                        <a:column name="due_date" prompt="最后应收日期" align="right" width="100"/>
                        <a:column name="currency_name" prompt="币种" align="right" width="80"/>
                        <a:column name="exchange_rate" prompt="汇率" align="right" width="80"/>
                        <a:column name="due_amount" prompt="应收租赁款项" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="received_amount" prompt="已收金额" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="surplus_amount" prompt="未收金额" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="unit_name" prompt="业务部门" align="center" width="100"/>
                        <a:column name="plan_date_n" prompt="计划内/外" align="center" width="100"/>
                    </a:columns>
                </a:grid>
            </a:fieldSet>
        </a:screenBody>
        <script><![CDATA[
        ]]></script>
    </a:view>
</a:screen>
