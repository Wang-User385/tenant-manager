<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年7月10日
    $Revision: 1.0
    $Purpose: 银行账户新增
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>

        <a:link id="csh_transaction_receipt_import_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import.lview"/>
        <a:link id="csh_transaction_receipt_import_beijing_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_beijing.lview"/>
        <a:link id="csh_transaction_receipt_import_caiwu_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_caiwu.lview"/>
        <a:link id="csh301_transaction_receipt_jianhang_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_jianhang.lview"/>
        <a:link id="csh301_transaction_receipt_pingan_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_pingan.lview"/>
        <a:link id="csh301_transaction_receipt_pufa_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_pufa.lview"/>
        <a:link id="csh301_transaction_receipt_xingye_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_xingye.lview"/>

        <a:link id="csh301_transaction_receipt_zhaoshang_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_zhaoshang.lview"/>
        <a:link id="csh301_transaction_receipt_jiaohang_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_import_jiaohang.lview"/>
        <script type="text/javascript"><![CDATA[
      function   csh301_receipt_bp_bank_account(){
          if ($('csh_transaction_template_code_ds').validate()) {
              var record = $('csh_transaction_template_code_ds').getCurrentRecord();
              var  url;
              if(record.get('template_code')=='NORMAL'){
                      url= $('csh_transaction_receipt_import_link').getUrl()

              }else if(record.get('template_code')=='BEIJING'){
                  url= $('csh_transaction_receipt_import_beijing_link').getUrl()


              }else if(record.get('template_code')=='CAIWUGONGSI-JIANHANG'){
                  url= $('csh_transaction_receipt_import_caiwu_link').getUrl()

              }else if(record.get('template_code')=='JIANHANG'){
                  url= $('csh301_transaction_receipt_jianhang_link').getUrl()


              }else if(record.get('template_code')=='PINGAN'){
                  url= $('csh301_transaction_receipt_pingan_link').getUrl()


              }else if(record.get('template_code')=='PUFA'){
                  url= $('csh301_transaction_receipt_pufa_link').getUrl()


              }else if(record.get('template_code')=='XINGYE'){
                  url= $('csh301_transaction_receipt_xingye_link').getUrl()

              }else if(record.get('template_code')=='ZHAOSHANGYINHANG'){
                  url= $('csh301_transaction_receipt_zhaoshang_link').getUrl()


              }else if(record.get('template_code')=='JIAOHANG'){
                  url= $('csh301_transaction_receipt_jiaohang_link').getUrl()

              }
              var win = new Leaf.Window({
                  id: 'csh_receipt_import_win_id11',
                  params: {
                      winid: 'csh_receipt_import_win_id11'

                  },

                  url:url,
                  title: '收款新增导入',
                  fullScreen: false,
                  width: 500,
                  height: 400,
                  draggable: true
              });
              win.on('close', function () {
              });

          }
      }

        function csh301_receipt_bp_bank_account_back() {
            top.refreshFrame();
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="bank_type_bp_ds" lookupCode="CSH301_TEMPLATE"/>
            <a:dataSet id="csh_transaction_template_code_ds" autoCreate="true" loadData="true">
                <a:fields>
                    <a:field name="template_code_n" options="bank_type_bp_ds"
                             displayField="code_value_name" valueField="code_value" returnField="template_code" required="true"/>
                    <a:field  name="template_code"/>


                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_receipt_bp_bank_account" text="下一步"/>
                <a:gridButton click="csh301_receipt_bp_bank_account_back" text="返回"/>
            </a:screenTopToolbar>
            <a:form>
                <a:fieldSet column="4" labelWidth="250" title="模板选择" width="750">
                    <a:box column="2" labelWidth="100">

                        <a:comboBox name="template_code_n" bindTarget="csh_transaction_template_code_ds"
                                    prompt="模板选择"/>

                    </a:box>
                </a:fieldSet>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
