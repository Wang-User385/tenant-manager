<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020年2月12日
    $Revision: 1.0
    $Purpose: 收款管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <a:dataSets>
            <a:dataSet id="csh_transaction_detail_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/cshTransaction/cashThingTransaction/queryDetail"
                       selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                    <a:field name="creation_date"/>
                    <a:field name="bp_name"/>
                    <a:field name="transaction_num"/>
                    <a:field name="description"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="transaction_amount"/>
                    <a:field name="write_off_amount"/>
                    <a:field name="un_write_off_amount"/>
                    <a:field name="bank_account_name"/>
                    <a:field name="bank_name"/>
                    <a:field name="bank_account_num"/>
                    <a:field name="write_off_flag_desc"/>
                    <a:field name="match_status"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:grid id="csh_transaction_detail_grid_ds"
                bindTarget="csh_transaction_detail_result_ds" marginHeight="250"
                marginWidth="20"
                navBar="true">
            <a:toolBar>
                <a:button type="excel"/>
            </a:toolBar>
            <a:columns>
                <a:column name="write_off_type" prompt="类型" width="120"/>
                <a:column name="write_off_date" align="center" prompt="核销日期" width="100"
                          renderer="Leaf.formatDate"/>
                <a:column name="creation_date" align="center" prompt="导入日期" width="100"
                          renderer="Leaf.formatDate"/>
                <a:column name="times" prompt="期数" width="200"/>
                <a:column name="description" prompt="性质" width="120"/>
                <a:column name="write_off_due_amount" prompt="核销金额" width="120" renderer="Leaf.formatMoney"/>
                <a:column name="bp_name" prompt="客户名称" width="120"/>
            </a:columns>
        </a:grid>
    </a:view>
</a:screen>
