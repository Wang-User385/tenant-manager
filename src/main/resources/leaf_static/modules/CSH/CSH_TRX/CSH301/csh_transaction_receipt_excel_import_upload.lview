<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="CSH_TRANSACTION_RECEIPT"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>

    <a:view>
        <a:link id="csh301_transaction_receipt_excel_import_link" url="${/request/@context_path}/csh/write/off/batch/excel/import"/>
        <script><![CDATA[


        var transaction_type = '${/parameter/@transaction_type}';

        var transaction_id = '${/parameter/@transaction_id}';
        var allocation_id = '${/parameter/@allocation_id}';

        function csh301_transaction_receipt_excel_import_error_close(datas){
            parent.$L.Masker.unmask(parent.Ext.getBody());
            /*parent.$L.showConfirm("提示", datas.error.message,function(){
                prj330f1_prj_excel_import_close();
            });*/
            csh301_transaction_receipt_excel_import_close();
        }

        function csh301_transaction_receipt_excel_import_close(){
            //parent.$("PRJ440_G_RESULT_hls_virtual_account_ds").query();
            parent._file_upload_window.close();

        }

        parent.Leaf.request({
            url: $('csh301_transaction_receipt_excel_import_link').getUrl() + "?headerId=${/model/header/record/@header_id}&transactionType="+transaction_type+"&transactionId="+transaction_id+"&allocationId="+allocation_id,
            para: {headerId:'${/model/header/record/@header_id}'},
            success: function (res) {
                parent.$L.Masker.unmask(parent.Ext.getBody());
                parent.$L.showMessage("提示", "导入成功");
                top.refreshFrame()//回到头页面并且刷新页面
                parent._file_upload_window.close();
            },
            failure: function (datas) {
                csh301_transaction_receipt_excel_import_error_close(datas);
            },
            error: function (datas) {
                csh301_transaction_receipt_excel_import_error_close(datas);
            },
            scope: this
        });

        ]]></script>

        <a:screenBody>

        </a:screenBody>
    </a:view>
</a:screen>
