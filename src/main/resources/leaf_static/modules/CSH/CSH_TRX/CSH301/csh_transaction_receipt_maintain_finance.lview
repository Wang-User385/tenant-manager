        <script><![CDATA[


        function csh301_transaction_query() {
            $('csh_transaction_receipt_maintain_result_ds').query();
        }

        function csh301_transaction_reset() {
            $('csh_transaction_receipt_maintain_query_ds').reset();
        }


        function csh301_transaction_receipt_query() {
            $('csh_transaction_receipt_detail_result_ds').query();
        }

        function csh301_transaction_receipt_reset() {
            $('csh_transaction_receipt_detail_query_ds').reset();
        }

        function csh301_transaction_allocation_query() {
            $('csh_transaction_receipt_allocation_result_ds').query();
        }

        function csh301_transaction_allocation_reset() {
            $('csh_transaction_receipt_allocation_query_ds').reset();
        }

        function csh301_advance_transaction_query() {
            $('csh_transaction_advance_receipt_maintain_result_ds').query();
        }

        function csh301_advance_transaction_reset() {
            $('csh_transaction_advance_receipt_maintain_query_ds').reset();
        }

        //收款新增
        function csh301_transaction_add() {
            var win = new Leaf.Window({
                id: 'transaction_add_winId',
                url: $('transaction_add_link').getUrl(),
                params: {
                    winId: 'transaction_add_winId'
                },
                title: '收款新增',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

        //收款删除
        function csh301_transaction_delete() {

            Leaf.showConfirm('${l:HLS.PROMPT}', '确认删除吗?', function okFun() {
                var ds = $('csh_transaction_receipt_maintain_result_ds');
                var records = ds.getSelected();

                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少选择一条记录！');
                    return;
                }

                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('sum_write_off_amount')) {
                        Leaf.showMessage('提示！', '已核销，请先核销反冲！');
                        return;
                    }
                }

                var removeData = [];
                for (var i = 0; i < records.length; i++) {
                    records[i].set('__status', 'delete');
                    removeData.push(records[i].data);
                }

                Leaf.Masker.mask(Ext.getBody());

                Leaf.request({
                    url: '${/request/@context_path}/csh/transaction/delete',
                    para: removeData,
                    success: function (res) {
                        csh301_transaction_query();
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            });
        }


        //收款反冲
        function csh301_transaction_reverse() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();

            if (records.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('sum_write_off_amount')) {
                    Leaf.showMessage('提示！', '已核销，请先核销反冲！');
                    return;
                }
                //反冲只能做当月的
                var transaction_date = records[i].get('transaction_date');
                var date = new Date();
                var transaction_Month = transaction_date.getMonth();
                var Month = date.getMonth();
                var Year = date.getFullYear();
                var transaction_Year = transaction_date.getFullYear();
                if (transaction_Year != Year){
                    Leaf.showMessage('提示！', '非当年交易记录不能反冲！');
                    return;
                }

                if (transaction_Month != Month) {
                    Leaf.showMessage('提示！', '非当月交易记录不能反冲！');
                    return;
                }
                //已经反冲过的不能再次反冲
                var reversed_flag = records[i].get('reversed_flag');
                if (reversed_flag == 'Y') {
                    Leaf.showMessage('提示！', '该记录以反冲过，不能重复反冲！');
                    return;
                }
            }
            var win = new Leaf.Window({
                id: 'transaction_reverse_winId',
                url: $('transaction_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_reverse_winId'
                },
                title: '收款反冲',
                width: 600,
                height: 200,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

        //收款退款
        function csh301_transaction_writeoff_refund() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }
            var record = records[0];
            var can_return_amount = record.get('can_return_amount');

            if (can_return_amount == 0) {
                Leaf.showMessage('提示！', '该笔收款无剩余可退款金额！');
                return;
            }
            var transaction_id = records[0].get('transaction_id');

            var win = new Leaf.Window({
                id: 'transaction_writeoff_refund_winId',
                url: $('transaction_writeoff_refund_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_refund_winId',
                    transaction_id: transaction_id
                },
                title: '收款退款',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });


        }

        //收款自动匹配
        function csh301_transaction_auto_allocation() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }


            var transaction_id_str = "";

            for (var i = 0; i < records.length; i++) {
                if (i == 0) {
                    transaction_id_str = records[0].get('transaction_id');
                } else {
                    transaction_id_str = transaction_id_str + ',' + records[i].get('transaction_id')
                }

                var refund_status = records[i].get('refund_status');
                if (refund_status == 'APPROVING') {
                    Leaf.showMessage('提示！', '在退款流程中不允许核销！');
                    return;
                }
            }

            Leaf.Masker.mask(Ext.getBody(), '匹配中。。');
            Leaf.request({
                url: $('csh301_transaction_receipt_allocation_link').getUrl(),
                para: {
                    transaction_id_str: transaction_id_str
                },
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    Leaf.Masker.unmask(Ext.getBody());

                    if (res.success == false) {
                        Leaf.showMessage('提示！', res.error.message);
                    } else {
                        var win = new Leaf.Window({
                            id: 'transaction_manual_allocation_detail_winId',
                            //url: $('transaction_manual_allocation_detail_link').getUrl(),
                            url: $('transaction_manual_allocation_detail_finance_link').getUrl(),
                            params: {
                                winId: 'transaction_manual_allocation_detail_winId',
                                allocation_id_str: res.result.record[0].allocation_id_str,
                                transaction_id_str: transaction_id_str
                            },
                            title: '匹配结果',
                            fullScreen: true,
                            draggable: true
                        });
                        win.on('close', function () {
                            csh301_transaction_query();
                        });
                    }
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });


        }

        //收款核销
        function csh301_transaction_writeoff() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }
            var record = records[0];
            var posted_flag = record.get('posted_flag');
            var match_status = record.get('match_status');

            if (posted_flag == 'N') {
                Leaf.showMessage('提示！', '请先过账！');
                return;
            }
            if (match_status != 'NEW') {
                Leaf.showMessage('提示！', '请先匹配再核销！');
                return;
            }

            var refund_status = record.get('refund_status');
            if (refund_status == 'APPROVING') {
                Leaf.showMessage('提示！', '在退款流程中不允许核销！');
                return;
            }

            var win = new Leaf.Window({
                id: 'transaction_writeoff_winId',
                url: $('transaction_writeoff_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_winId',
                    transaction_id: record.get("transaction_id")
                },
                title: '收款核销',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }


        //核销反冲
        function csh301_transaction_writeoff_reverse() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
