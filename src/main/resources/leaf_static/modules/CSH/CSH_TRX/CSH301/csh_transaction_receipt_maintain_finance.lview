        //手工分配核销
        function csh301_transaction_manual_allocation() {
            debugger;
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }

            var transaction_id_str = "";
            var reversed_flag = "N";
            var un_write_off_amount = 0;
            var write_off_flag = "NOT";

            for (var i = 0; i < records.length; i++) {
                if (i == 0) {
                    transaction_id_str = records[0].get('transaction_id');
                } else {
                    transaction_id_str = transaction_id_str + ',' + records[i].get('transaction_id')
                }

                if (records[i].get("reversed_flag") != 'N') {
                    reversed_flag = 'Y';
                }

                var refund_status = records[i].get('refund_status');
                if (refund_status == 'APPROVING') {
                    Leaf.showMessage('提示！', '在退款流程中不允许核销！');
                    return;
                }

                if (records[i].get("write_off_flag") == 'FULL') {
                    write_off_flag = 'FULL';
                }

                un_write_off_amount = un_write_off_amount + records[i].get('un_write_off_amount') || 0;
            }


            if (reversed_flag == 'Y') {
                Leaf.showMessage('提示！', '收款已经反冲不能进行后续操作！');
                return;
            }
            if (write_off_flag == 'FULL') {
                Leaf.showMessage('提示！', '收款已经完全核销不能进行后续操作！');
                return;
            }


            var win = new Leaf.Window({
                id: 'transaction_manual_allocation_winId',
                url: $('transaction_manual_allocation_link').getUrl(),
                params: {
                    transaction_id_str: transaction_id_str,
                    un_write_off_amount: un_write_off_amount,
                    transaction_type: "RECEIPT",
                    winId: 'transaction_manual_allocation_winId'
                },
                title: '收款分配',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });

        }

        function open_allocation_detail_renderer(value, record, name) {

            var allocation_id = record.get('allocation_id');
            var allocation_status = record.get('allocation_status');
            return '<a  href="#' + Math.random() + '" onclick="open_allocation_detail_window(\'' + allocation_id + '\',\'' + allocation_status + '\')">' + value + '</a>';
        }

        function open_allocation_detail_window(allocation_id, allocation_status) {
            if (allocation_status == 'N') {
                var win = new Leaf.Window({
                    id: 'transaction_manual_allocation_modify_winId',
                    url: $('transaction_manual_allocation_modify_link').getUrl(),
                    params: {
                        allocation_id: allocation_id,
                        winId: 'transaction_manual_allocation_modify_winId'
                    },
                    title: '收款分配',
                    fullScreen: true,
                    draggable: true
                });
                win.on('close', function () {
                    csh301_transaction_allocation_query();
                });
            } else {
                var win = new Leaf.Window({
                    id: 'transaction_manual_allocation_query_winId',
                    url: $('transaction_manual_allocation_query_link').getUrl(),
                    params: {
                        allocation_id: allocation_id,
                        winId: 'transaction_manual_allocation_query_winId'
                    },
                    title: '收款分配查询',
                    fullScreen: true,
                    draggable: true
                });
                win.on('close', function () {
                    csh301_transaction_allocation_query();
                });
            }


        }

        function csh301_transaction_batch_reverse() {
            var win = new Leaf.Window({
                id: 'transaction_batch_writeoff_reverse_winId',
                url: $('transaction_batch_writeoff_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_batch_writeoff_reverse_winId'
                },
                title: '批量核销反冲',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_allocation_query();
            });

        }

        function allocation_renderer(value, record, name) {
            var allocation_id_str = record.get('allocation_id_str');
            return '<a  href="#' + Math.random() + '" onclick="open_allocation_window(\'' + allocation_id_str + '\')">' + value + '</a>';
        }


        function open_allocation_window(allocation_id_str) {
            var win = new Leaf.Window({
                id: 'transaction_allocation_winId',
                //url: $('transaction_manual_allocation_detail_link').getUrl(),
                url: $('transaction_manual_allocation_detail_finance_link').getUrl(),
                params: {
                    allocation_id_str: allocation_id_str,
                    winId: 'transaction_allocation_winId'
                },
                title: '匹配结果查询',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });

        }


        //收款自动匹配
        function csh301_advance_transaction_auto_allocation() {
            var ds = $('csh_transaction_advance_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }


            var transaction_id_str = "";

            for (var i = 0; i < records.length; i++) {
                if (i == 0) {
                    transaction_id_str = records[0].get('transaction_id');
                } else {
                    transaction_id_str = transaction_id_str + ',' + records[i].get('transaction_id')
                }
                var refund_status = records[i].get('refund_status');
                if (refund_status == 'APPROVING') {
                    Leaf.showMessage('提示！', '在退款流程中不允许核销！');
                    return;
                }
            }

            Leaf.Masker.mask(Ext.getBody(), '匹配中。。');
            Leaf.request({
                url: $('csh301_transaction_receipt_allocation_link').getUrl(),
                para: {
                    transaction_id_str: transaction_id_str
                },
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    Leaf.Masker.unmask(Ext.getBody());

                    if (res.success == false) {
                        Leaf.showMessage('提示！', res.error.message);
                    } else {
                        var win = new Leaf.Window({
                            id: 'transaction_manual_allocation_detail_winId',
                            url: $('transaction_manual_allocation_detail_finance_link').getUrl(),
                            params: {
                                winId: 'transaction_manual_allocation_detail_winId',
                                allocation_id_str: res.result.record[0].allocation_id_str,
                                transaction_id_str: transaction_id_str
                            },
                            title: '匹配结果',
                            fullScreen: true,
                            draggable: true
                        });
                        win.on('close', function () {
                            csh301_advance_transaction_query();
                        });
                    }
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });


        }

        //手工分配核销
        function csh301_advance_transaction_manual_allocation() {
            var ds = $('csh_transaction_advance_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }

            var transaction_id_str = "";
            var reversed_flag = "N";
            var un_write_off_amount = 0;
            var write_off_flag = "NOT";

            for (var i = 0; i < records.length; i++) {
                if (i == 0) {
                    transaction_id_str = records[0].get('transaction_id');
                } else {
                    transaction_id_str = transaction_id_str + ',' + records[i].get('transaction_id')
                }

                if (records[i].get("reversed_flag") != 'N') {
                    reversed_flag = 'Y';
                }

                var refund_status = records[i].get('refund_status');
                if (refund_status == 'APPROVING') {
                    Leaf.showMessage('提示！', '在退款流程中不允许核销！');
                    return;
                }

                if (records[i].get("write_off_flag") == 'FULL') {
                    write_off_flag = 'FULL';
                }

                un_write_off_amount = un_write_off_amount + records[i].get('un_write_off_amount') || 0;
            }


            if (reversed_flag == 'Y') {
                Leaf.showMessage('提示！', '收款已经反冲不能进行后续操作！');
                return;
            }
            if (write_off_flag == 'FULL') {
                Leaf.showMessage('提示！', '收款已经完全核销不能进行后续操作！');
                return;
            }


            var win = new Leaf.Window({
                id: 'transaction_manual_allocation_winId',
                url: $('transaction_manual_allocation_link').getUrl(),
                params: {
                    transaction_id_str: transaction_id_str,
                    un_write_off_amount: un_write_off_amount,
                    transaction_type: "ADVANCE_RECEIPT",
                    winId: 'transaction_manual_allocation_winId'
                },
                title: '收款分配',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });

        }


        //收款反冲
        function csh301_advance_transaction_reverse() {
            var ds = $('csh_transaction_advance_receipt_maintain_result_ds');
            var records = ds.getSelected();

            if (records.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('sum_write_off_amount')) {
                    Leaf.showMessage('提示！', '已核销，请先核销反冲！');
                    return;
                }
                //反冲只能做当月的
                var transaction_date = records[i].get('transaction_date');
                var date = new Date();
                var transaction_Month = transaction_date.getMonth();
                var Month = date.getMonth();
                if (transaction_Month != Month) {
                    Leaf.showMessage('提示！', '非当月交易记录不能反冲！');
                    return;
                }
                //已经反冲过的不能再次反冲
                var reversed_flag = records[i].get('reversed_flag');
                if (reversed_flag == 'Y') {
                    Leaf.showMessage('提示！', '该记录以反冲过，不能重复反冲！');
                    return;
                }
            }
            var win = new Leaf.Window({
                id: 'transaction_reverse_winId',
                url: $('transaction_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_reverse_winId'
                },
                title: '收款反冲',
                width: 600,
                height: 200,
                draggable: true
            });
            win.on('close', function () {
                csh301_advance_transaction_query();
            });
        }

        function test_sharing() {
            var removeData = [{
                "contract_id": "862"
            }];

            Leaf.request({
                url: '${/request/@context_path}/gld/finance/income/sharing',
                para: removeData,
                success: function (res) {

                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }


        ]]></script>

