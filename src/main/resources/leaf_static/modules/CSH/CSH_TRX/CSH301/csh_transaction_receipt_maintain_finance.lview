            var transaction_id = records[0].get('transaction_id');
            var win = new Leaf.Window({
                id: 'transaction_writeoff_reverse_winId',
                url: $('transaction_writeoff_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_reverse_winId',
                    transaction_id: transaction_id
                },
                title: '核销反冲',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

