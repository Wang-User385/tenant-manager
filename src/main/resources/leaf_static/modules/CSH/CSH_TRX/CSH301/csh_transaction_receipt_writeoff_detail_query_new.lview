<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月28日
    $Revision: 1.0
    $Purpose: 核销明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <a:link id="csh_transaction_receipt_writeoff_reverse_link"
                url="${/request/@context_path}/csh/write/off/reverse"/>
        <script><![CDATA[

        var body = $('${/parameter/@winId}').wrap;

        function csh301_write_off_detail_return() {
            $('${/parameter/@winId}').close();
        }

        //反冲收款标志（如果核销债权反冲，需要同时反冲收款）
        var reversed_receipt_flag = '${/parameter/@reversed_receipt_flag}';

        function csh301_write_off_reverse() {
            var head_ds = $('csh_transaction_receipt_write_off_reverse_detail_head_ds');
            var line_ds = $('csh_transaction_receipt_write_off_detail_result_ds');
            if (head_ds.validate()) {
                var reversed_date = head_ds.getAt(0).get('reversed_date');
                var description = head_ds.getAt(0).get('description');
                var saveData = [];
/*
                if (reversed_receipt_flag == 'Y') {
                    var records = line_ds.getAll();
                } else {
                    var records = line_ds.getSelected();
                }*/
                var records = line_ds.getSelected();
                if (records.length == 0) {
                    Leaf.showMessage('提示！', '至少勾选一条记录！');
                    return;
                }

                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('write_off_flag') != 'N') {
                        //校验
                        if (records[i].get('write_off_date') > reversed_date) {
                            Leaf.showMessage('提示！', '反冲日期不能小于核销日期！');
                            return;
                        }

                        if (records[i].get('write_off_flag') != 'NOT' && records[i].get('write_off_type')=='RECEIPT_ADVANCE_RECEIPT') {
                        Leaf.showMessage('提示！', '预收款已核销债权,不可反冲！');
                        return;
                        }
                        records[i].set("reversed_receipt_flag", reversed_receipt_flag);
                        records[i].set("reversed_date", reversed_date);
                        records[i].set("description", description);
                        saveData.push(records[i].data);
                    }
                    if (records[i].get('reversed_flag') == 'W') {
                        Leaf.showMessage('提示！', '已反冲的不能再反冲！');
                        return;
                    }

                    }
                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '反冲中。。');

                Leaf.request({
                    url: $('csh_transaction_receipt_writeoff_reverse_link').getUrl(),
                    para: saveData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask($(winId).wrap);
                        csh301_transaction_query();
                        csh301_write_off_detail_return();
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }


        }

        Leaf.onReady(function () {
            var ready_only_id = document.getElementById("ready_only_id");
            if ('${/parameter/@ready_only_flag}' == 'Y') {
                ready_only_id.style.display = "none";
            }
        });

        ]]></script>
        <a:dataSets>
            <a:dataSet id="csh_transaction_receipt_write_off_detail_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/write/off/query?cshTransactionId=${/parameter/@transaction_id}&amp;nonRefundFlag=Y"
                       selectable="true">
                <a:fields>
                    <a:field name="due_date" datatype="java.util.Date"/>
                    <a:field name="write_off_date" datatype="java.util.Date"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_write_off_reverse_detail_head_ds" autoCreate="true">
                <a:fields>
                    <a:field name="reversed_date" datatype="date" required="true" prompt="反冲日期"/>
                    <a:field name="description" defaultValue="${l:HLS.REVERSE}"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <div id="ready_only_id">
              <!--  <a:screenTopToolbar>
                    <a:gridButton click="csh301_write_off_detail_return" text="HLS.RETURN"/>
                    <a:gridButton click="csh301_write_off_reverse" text="HLS.REVERSE"/>
                </a:screenTopToolbar>
                <a:fieldSet column="3" labelWidth="100" title="CSH514.CSH_WRITE_OFF_DETAIL" width="800">
                    <a:datePicker name="reversed_date"
                                  bindTarget="csh_transaction_receipt_write_off_reverse_detail_head_ds"
                                  prompt="反冲日期"/>
                    <a:textField name="description"
                                 bindTarget="csh_transaction_receipt_write_off_reverse_detail_head_ds"
                                 prompt="HLS.NOTE" width="300"/>
                </a:fieldSet>-->
            </div>
            <a:grid id="csh_transaction_receipt_writeoff_detail_grid_id"
                    bindTarget="csh_transaction_receipt_write_off_detail_result_ds" marginHeight="200" marginWidth="10"
                    navBar="true">
                <a:columns>
                    <a:column name="write_off_type_n" width="120" prompt="核销类型"/>
                    <a:column name="due_date" renderer="Leaf.formatDate" width="80" prompt="预定收款日"/>
                    <a:column name="write_off_date" renderer="Leaf.formatDate" width="80" prompt="核销日期"/>
                    <a:column name="cf_item_n" prompt="性质" width="100"/>
                    <a:column name="write_off_due_amount" align="right" renderer="Leaf.formatMoney" prompt="核销金额"
                              width="120"/>
                    <a:column name="write_off_principal" align="right" renderer="Leaf.formatMoney" prompt="本金"
                              width="120"/>
                    <a:column name="write_off_interest" align="right" renderer="Leaf.formatMoney" prompt="利息"
                              width="120"/>
                    <a:column name="times" align="center" prompt="期数" width="40"/>
                    <a:column name="contract_number" prompt="合同编号" width="150"/>
                    <a:column name="contract_name" prompt="合同名称" width="250"/>
                    <a:column name="tenant_name" prompt="承租人" width="250"/>
                    <a:column name="reversed_flag_n" prompt="核销反冲标志" width="80"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
