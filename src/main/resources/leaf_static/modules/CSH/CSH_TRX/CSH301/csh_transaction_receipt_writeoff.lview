                    <!-- <a:tab prompt="核销为保证金池" width="120">
                        <a:grid id="csh301_receipt_writeoff_deposit_pool_grid_id"
                                bindTarget="csh_transaction_writeoff_deposit_pool_line_ds" marginHeight="300"
                                marginWidth="60">
                            <a:columns>
                                <a:column name="write_off_type_desc" prompt="核销类型" editor="deposit_pool_editor_cb"
                                          width="120"/>
                                <a:column name="write_off_due_amount" prompt="本次核销金额" editor="deposit_pool_editor_nf"
                                          align="right" renderer="Leaf.formatMoney"
                                          width="150"/>
                            </a:columns>
                            <a:editors>
                                <a:comboBox id="deposit_pool_editor_cb"/>
                                <a:numberField id="deposit_pool_editor_nf" allowNegative="false"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>-->
                </a:tabs>
                <a:events>
                    <a:event name="beforeselect" handler="before_select_event"/>
                </a:events>
            </a:tabPanel>
        </a:screenBody>
    </a:view>
</a:screen>


