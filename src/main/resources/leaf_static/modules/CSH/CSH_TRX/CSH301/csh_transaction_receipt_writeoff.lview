<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月21日
    $Revision: 1.0
    $Purpose: 收款核销
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <a:link id="csh_transaction_receipt_reverse_link" url="${/request/@context_path}/csh/transaction/reverse"/>
        <a:link id="csh_transaction_receipt_match_link"
                url="${/request/@context_path}/csh/write/off/match/submitMatch"/>
        <a:link id="csh_transaction_receipt_writeoff_link" url="${/request/@context_path}/csh/write/off/submit"/>
        <a:link id="csh_transaction_receipt_backMatch_link"
                url="${/request/@context_path}/csh/write/off/match/backMatch"/>


        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <script><![CDATA[
        function csh301_receipt_writeoff_return() {
            csh301_transaction_query();
            $('${/parameter/@winId}').close();
        }

        var WRITE_OFF_TYPE = 'RECEIPT_CREDIT';

        function before_select_event(tabPanel, index, tab) {
            if (index === 0) {
                WRITE_OFF_TYPE = 'RECEIPT_CREDIT';
            } else if (index === 1) {
                WRITE_OFF_TYPE = 'RECEIPT_ADVANCE_RECEIPT';
            } else if (index === 2) {
                WRITE_OFF_TYPE = 'RECEIPT_DEPOSIT';
            } else if (index === 3) {
                WRITE_OFF_TYPE = 'RECEIPT_DEPOSIT_POOL';
            }

        }

        function csh301_receipt_writeoff_add() {
            if (WRITE_OFF_TYPE == 'RECEIPT_CREDIT') {
                $('csh301_receipt_writeoff_credit_grid_id').showEditorByRecord($('csh_transaction_writeoff_credit_line_ds').create());
            }

        }

        var can_return_amount_old = 0;
        var can_return_amount_new = 0;

        function csh301_receipt_writeoff_delete() {
            if (WRITE_OFF_TYPE == 'RECEIPT_CREDIT') {

                //释放剩余可核销金额
                var ds = $('csh_transaction_writeoff_credit_line_ds');
                var records = ds.getAll();
                var record = ds.getCurrentRecord();
                var csh_write_off_amount = 0;
                if (records.length >= 1) {
                    for (var i = 0; i < records.length; i++) {
                        csh_write_off_amount = plus(csh_write_off_amount, records[i].get("write_off_due_amount") || 0);
                    }
                }

                var current_record_amount = record.get("write_off_due_amount") || 0;
                var head_ds = $('csh_transaction_writeoff_head_ds');
                var hd_record = head_ds.getCurrentRecord();
                var transaction_amount = hd_record.get("transaction_amount") || 0;
                var write_off_amount = hd_record.get("write_off_amount") || 0;

                can_return_amount_old = plus(minus(minus(transaction_amount, write_off_amount), csh_write_off_amount), current_record_amount);
                hd_record.set("can_return_amount", can_return_amount_old);

                $('csh301_receipt_writeoff_credit_grid_id').clear();
            }
        }

        function credit_contract_number_lov_before_event(lov) {
            var ds = $('csh_transaction_writeoff_credit_line_ds');
            var records = ds.getAll();
            var record = ds.getCurrentRecord();
            var not_cashflow_ids_str = '';
            var csh_write_off_amount = 0;
            if (records.length >= 1) {
                for (var i = 0; i < records.length; i++) {
                    if (i == 0) {
                        not_cashflow_ids_str = records[i].get("cashflow_id")
                    } else {
                        not_cashflow_ids_str = not_cashflow_ids_str + ',' + records[i].get("cashflow_id");
                    }
                    csh_write_off_amount = plus(csh_write_off_amount, records[i].get("write_off_due_amount") || 0);
                }
            }


            var current_record_amount = record.get("write_off_due_amount") || 0;

            var contract_number = record.getMeta().getField('contract_number');
            //排除掉之前选择的现金流
            contract_number.setLovPara('notCashflowIdsStr', not_cashflow_ids_str);
            contract_number.setLovPara('nCfType', '5');
            contract_number.setLovPara('cfStatus', 'RELEASE');
            contract_number.setLovPara('cfDirection', 'INFLOW');
            contract_number.setLovPara('SurplusAmountFlag', 'Y');

            var head_ds = $('csh_transaction_writeoff_head_ds');
            var hd_record = head_ds.getCurrentRecord();
            var transaction_amount = hd_record.get("transaction_amount") || 0;
            var write_off_amount = hd_record.get("write_off_amount") || 0;

            can_return_amount_old = plus(minus(minus(transaction_amount, write_off_amount), csh_write_off_amount), current_record_amount);
            hd_record.set("can_return_amount", can_return_amount_old);

        }

        function credit_contract_number_lov_commit_event(lov, r1, r2) {

            //金额判断
            var head_ds = $('csh_transaction_writeoff_head_ds');
            var record = head_ds.getCurrentRecord();

            var can_return_amount = can_return_amount_old;
            var write_off_due_amount = r1.get('write_off_due_amount') || 0;
            var write_off_principal = r1.get('write_off_principal') || 0;
            var write_off_interest = r1.get('write_off_interest') || 0;

            if (minus(can_return_amount, write_off_interest) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', 0);
                r1.set('write_off_interest', can_return_amount);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));

            } else if (minus(can_return_amount, write_off_interest) > 0 && minus(can_return_amount, write_off_due_amount) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', minus(can_return_amount, write_off_interest));
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));
            }

            if (minus(can_return_amount, write_off_due_amount) > 0) {
                r1.set('write_off_due_amount', write_off_due_amount);
                r1.set('write_off_principal', write_off_principal);
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, write_off_due_amount));
            }

            can_return_amount_new = record.get("can_return_amount");
        }

        function credit_line_ds_update_event(ds, record, name, value, oldValue) {
            var head_ds = $('csh_transaction_writeoff_head_ds');
            var head_record = head_ds.getCurrentRecord();
            var write_off_due_amount = record.get('write_off_due_amount') || 0;
            var can_return_amount = record.get('write_off_due_amount') || 0;
            //更新剩余可核销金额
            if (name == 'write_off_due_amount') {
                var surplus_amount = record.get('surplus_amount') || 0;
                var surplus_principal = record.get('surplus_principal') || 0;
                var surplus_interest = record.get('surplus_interest') || 0;

                if ((oldValue === 0 || oldValue)) {
                    head_record.set('can_return_amount', minus(can_return_amount_new, minus(value, oldValue)));
                    can_return_amount_new = head_record.get("can_return_amount");
                }
                if (minus(value, surplus_amount) > 0) {
                    Leaf.showErrorMessage('提示', '金额超过剩余金额！', null, 200, 100);
                    return;
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) <= 0) {
                    record.set('write_off_principal', 0);
                    record.set('write_off_interest', value || 0);
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) >= 0) {
                    record.set('write_off_principal', minus(value, surplus_interest));
                    record.set('write_off_interest', surplus_interest);
                }
            } else if (name == 'write_off_principal') {
                record.set('write_off_interest', minus(write_off_due_amount, value));

            } else if (name == 'write_off_interest') {
                record.set('write_off_principal', minus(write_off_due_amount, value));
            }
        }


        function csh301_receipt_writeoff_create() {
            var head_ds = $('csh_transaction_writeoff_head_ds');
            var credit_line_ds = $('csh_transaction_writeoff_credit_line_ds');
            var advance_credit_line_ds = $('csh_transaction_writeoff_advance_credit_line_ds');
            var deposit_line_ds = $('csh_transaction_writeoff_deposit_line_ds');
            var deposit_pool_line_ds = $('csh_transaction_writeoff_deposit_pool_line_ds');
            if (head_ds.validate()) {
                var write_off_date = head_ds.getAt(0).get("write_off_date");
                var transaction_id = '${/parameter/@transaction_id}';
                var business_type = head_ds.getAt(0).get("business_type");
                var bp_id = head_ds.getAt(0).get("bp_id");
                var records;
                if (WRITE_OFF_TYPE == 'RECEIPT_CREDIT') {
                    //预收款
                    if (business_type == 'ADVANCE_RECEIPT') {
                        //预收款核销债权
                        WRITE_OFF_TYPE = 'ADVANCE_RECEIPT_CREDIT';
                    } else {
                        //收款核销债权
                        WRITE_OFF_TYPE = 'RECEIPT_CREDIT';
                    }
                    if (!credit_line_ds.validate()) {
                        return;
                    }
                    records = credit_line_ds.getAll();
                } else if (WRITE_OFF_TYPE == 'RECEIPT_ADVANCE_RECEIPT') {
                    if (!advance_credit_line_ds.validate()) {
                        return;
                    }
                    records = advance_credit_line_ds.getAll();
                } else if (WRITE_OFF_TYPE == 'RECEIPT_DEPOSIT') {
                    if (!deposit_line_ds.validate()) {
                        return;
                    }
                    records = deposit_line_ds.getAll();

                } else if (WRITE_OFF_TYPE == 'RECEIPT_DEPOSIT_POOL') {
                    if (!deposit_pool_line_ds.validate()) {
                        return;
                    }
                    records = deposit_pool_line_ds.getAll();

                }
                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少新增一条记录！');
                    return;
                }
                //组装数据
                var saveData = [];
                for (var i = 0; i < records.length; i++) {
                    records[i].set("write_off_date", write_off_date);
                    //收款核销债权和收款核销保证金合并了
                    records[i].set("write_off_type", WRITE_OFF_TYPE);
                    /*if(records[i].get("cf_type") == 5){
                        records[i].set("write_off_type", "RECEIPT_DEPOSIT");
                    }*/
                    //records[i].set("write_off_type", WRITE_OFF_TYPE);
                    records[i].set("bp_id", bp_id);
                    records[i].set("csh_transaction_id", transaction_id);
                    saveData.push(records[i].data);
                }
                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '核销中。。');
                Leaf.request({
                    url: $('csh_transaction_receipt_writeoff_link').getUrl(),
                    para: saveData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $('csh_transaction_receipt_maintain_query_ds').query();
                        Leaf.Masker.unmask($(winId).wrap);
                        csh301_receipt_writeoff_return();
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }
        }


        function contract_number_editor_function(record, name) {
            var write_off_type = record.get('write_off_type');
            if (name == 'contract_number' && write_off_type == 'RECEIPT_DEPOSIT') {
                return "deposit_editor_lov"
            } else if (name == 'contract_number' && write_off_type == 'RECEIPT_DEPOSIT_POOL') {
                return "";
            }
        }

        var can_deposit_return_amount_old = 0;
        var can_deposit_return_amount_new = 0;

        function deposit_contract_number_lov_before_event(lov) {
            var ds = $('csh_transaction_writeoff_deposit_line_ds');
            var records = ds.getAll();
            var record = ds.getCurrentRecord();
            var not_cashflow_ids_str = '';
            var csh_write_off_amount = 0;
            if (records.length >= 1) {
                for (var i = 0; i < records.length; i++) {
                    if (i == 0) {
                        not_cashflow_ids_str = records[i].get("cashflow_id")
                    } else {
                        not_cashflow_ids_str = not_cashflow_ids_str + ',' + records[i].get("cashflow_id");
                    }
                    csh_write_off_amount = plus(csh_write_off_amount, records[i].get("write_off_amount") || 0);
                }
            }
            var contract_number = record.getMeta().getField('contract_number');
            //排除掉之前选择的现金流
            contract_number.setLovPara('notCashflowIdsStr', not_cashflow_ids_str);
            contract_number.setLovPara('cfType', '5');
            contract_number.setLovPara('cfStatus', 'RELEASE');
            contract_number.setLovPara('cfDirection', 'INFLOW');
            contract_number.setLovPara('SurplusAmountFlag', 'Y');

            var head_ds = $('csh_transaction_writeoff_head_ds');
            var hd_record = head_ds.getCurrentRecord();
            var transaction_amount = hd_record.get("transaction_amount") || 0;
            var write_off_amount = hd_record.get("write_off_amount") || 0;

            can_deposit_return_amount_old = minus(minus(transaction_amount, write_off_amount), csh_write_off_amount);
            hd_record.set("can_return_amount", can_deposit_return_amount_old);

        }


        function deposit_contract_number_lov_commit_event(lov, r1, r2) {

            //金额判断
            var head_ds = $('csh_transaction_writeoff_head_ds');
            var record = head_ds.getCurrentRecord();
            var can_return_amount = can_deposit_return_amount_old;

            var write_off_due_amount = r1.get('write_off_due_amount') || 0;
            var write_off_principal = r1.get('write_off_principal') || 0;
            var write_off_interest = r1.get('write_off_interest') || 0;

            if (minus(can_return_amount, write_off_interest) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', 0);
                r1.set('write_off_interest', can_return_amount);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));

            } else if (minus(can_return_amount, write_off_interest) > 0 && minus(can_return_amount, write_off_due_amount) <= 0) {
                r1.set('write_off_due_amount', can_return_amount);
                r1.set('write_off_principal', minus(can_return_amount, write_off_interest));
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, can_return_amount));
            }

            if (minus(can_return_amount, write_off_due_amount) > 0) {
                r1.set('write_off_due_amount', write_off_due_amount);
                r1.set('write_off_principal', write_off_principal);
                r1.set('write_off_interest', write_off_interest);
                record.set('can_return_amount', minus(can_return_amount, write_off_due_amount));
            }

            can_deposit_return_amount_new = record.get("can_return_amount");
        }

        function deposit_line_ds_update_event(ds, record, name, value, oldValue) {

            var head_ds = $('csh_transaction_writeoff_head_ds');
            var head_record = head_ds.getCurrentRecord();
            var can_return_amount = head_record.get('can_return_amount') || 0;
            var write_off_due_amount = record.get('write_off_due_amount') || 0;
            //更新剩余可核销金额
            if (name == 'write_off_due_amount') {
                var surplus_amount = record.get('surplus_amount') || 0;
                var surplus_principal = record.get('surplus_principal') || 0;
                var surplus_interest = record.get('surplus_interest') || 0;
                if ((oldValue === 0 || oldValue)) {

                    head_record.set('can_return_amount', minus(can_deposit_return_amount_new, minus(value, oldValue)));
                    can_deposit_return_amount_new = head_record.get("can_return_amount");
                }
                if (minus(value, surplus_amount) > 0) {
                    Leaf.showErrorMessage('提示', '金额超过剩余金额！', null, 200, 100);
                    return;
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) <= 0) {
                    record.set('write_off_principal', 0);
                    record.set('write_off_interest', value || 0);
                } else if (minus(value, surplus_amount) <= 0 && minus(value, surplus_interest) >= 0) {
                    record.set('write_off_principal', minus(value, surplus_interest));
                    record.set('write_off_interest', surplus_interest);
                }
            } else if (name == 'write_off_principal') {
                record.set('write_off_interest', minus(write_off_due_amount, value));

            } else if (name == 'write_off_interest') {
                record.set('write_off_principal', minus(write_off_due_amount, value));
            }

        }

        //认领退回
        function csh301_receipt_writeoff_back() {
            var winId = '${/parameter/@winId}';
            Leaf.Masker.mask($(winId).wrap, '退回中。。');
            Leaf.request({
                url: $('csh_transaction_receipt_backMatch_link').getUrl(),
                para: {
                    transaction_id: '${/parameter/@transaction_id}'
                },
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    $('csh_transaction_receipt_maintain_query_ds').query();
                    Leaf.Masker.unmask($(winId).wrap);
                    csh301_receipt_writeoff_return();
                },
                failure: function () {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                error: function () {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                scope: this
            });
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="write_off_type_ds">
                <a:datas>
                    <a:record code_value="RECEIPT_DEPOSIT" code_value_name="保证金"/>
                    <a:record code_value="RECEIPT_DEPOSIT_POOL" code_value_name="保证金池"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="csh_transaction_writeoff_head_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/query?transactionId=${/parameter/@transaction_id}">
                <a:fields>
                    <a:field name="transaction_date" datatype="date" readOnly="true"/>
                    <a:field name="write_off_date" datatype="date" readOnly="true" prompt="核销日期"/>
                    <a:field name="bp_type_n" readOnly="true"/>
                    <a:field name="transaction_num" readOnly="true"/>
                    <a:field name="bp_name" readOnly="true"/>
                    <a:field name="transaction_amount" readOnly="true"/>
                    <a:field name="return_write_off_amount" readOnly="true"/>
                    <a:field name="sum_write_off_amount" readOnly="true"/>
                    <a:field name="can_return_amount" readOnly="true"/>
                    <a:field name="bp_code" autoComplete="true" readOnly="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/hls/bp/queryBpMasterLov~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="商业伙伴">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                            <a:map from="bp_type" to="bp_type"/>
                            <a:map from="bp_type_n" to="bp_type_n"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_transaction_writeoff_credit_line_ds" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/write/off/match/queryHaveMatch?cshTransactionId=${/parameter/@transaction_id}&amp;writeOffType=RECEIPT_CREDIT">
                <a:fields>
                    <a:field name="contract_number" autoComplete="true" readOnly="true" lovGridHeight="350"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/queryLov~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="950"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="contract_seq" to="contract_seq"/>
                            <a:map from="contract_seq_num" to="contract_seq_num"/>
                            <a:map from="times" to="times"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="due_date" to="due_date"/>
                            <a:map from="due_date_format" to="due_date_format"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="cf_item_n" to="cf_item_n"/>
                            <a:map from="cf_item" to="cf_item"/>
                            <a:map from="cf_type" to="cf_type"/>
                            <a:map from="surplus_amount" to="surplus_amount"/>
                            <a:map from="surplus_principal" to="surplus_principal"/>
                            <a:map from="surplus_interest" to="surplus_interest"/>
                            <a:map from="surplus_amount" to="write_off_due_amount"/>
                            <a:map from="surplus_principal" to="write_off_principal"/>
                            <a:map from="surplus_interest" to="write_off_interest"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="due_date" datatype="date"/>
                    <a:field name="cf_status" defaultValue="RELEASE"/>
                    <a:field name="cf_direction" defaultValue="INFLOW"/>
                    <a:field name="surplus_amount_flag" defaultValue="Y"/>

                </a:fields>
                <a:events>
                    <a:event name="update" handler="credit_line_ds_update_event"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="csh_transaction_writeoff_advance_credit_line_ds"
                       autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/write/off/match/queryHaveMatch?cshTransactionId=${/parameter/@transaction_id}&amp;writeOffType=RECEIPT_ADVANCE_RECEIPT">
                >
                <a:fields>
                    <a:field name="write_off_type" readOnly="true" defaultValue="RECEIPT_ADVANCE_RECEIPT"/>
                    <a:field name="write_off_type_desc" readOnly="true" defaultValue="收款核销预收款"/>
                    <a:field name="write_off_due_amount" readOnly="true" prompt="本次核销金额"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_transaction_writeoff_deposit_line_ds"
                       queryUrl="${/request/@context_path}/csh/write/off/match/queryHaveMatch?cshTransactionId=${/parameter/@transaction_id}&amp;writeOffType=RECEIPT_DEPOSIT"
                       autoQuery="true" selectable="true">
                <a:fields>
                    <a:field name="write_off_type_desc" readOnly="true" defaultValue="收款核销保证金"/>
                    <a:field name="write_off_type" defaultValue="RECEIPT_DEPOSIT"/>
                    <a:field name="write_off_due_amount" prompt="核销金额" readOnly="true"/>
                    <a:field name="contract_number" autoComplete="true" readOnly="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/queryLov~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="contract_seq" to="contract_seq"/>
                            <a:map from="contract_seq_num" to="contract_seq_num"/>
                            <a:map from="times" to="times"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="due_date" to="due_date"/>
                            <a:map from="due_date_format" to="due_date_format"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="cf_item_n" to="cf_item_n"/>
                            <a:map from="cf_item" to="cf_item"/>
                            <a:map from="cf_type" to="cf_type"/>
                            <a:map from="surplus_amount" to="surplus_amount"/>
                            <a:map from="surplus_principal" to="surplus_principal"/>
                            <a:map from="surplus_interest" to="surplus_interest"/>

                            <a:map from="surplus_amount" to="write_off_due_amount"/>
                            <a:map from="surplus_principal" to="write_off_principal"/>
                            <a:map from="surplus_interest" to="write_off_interest"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="due_date" datatype="date"/>
                    <a:field name="cf_status" defaultValue="RELEASE"/>
                    <a:field name="cf_direction" defaultValue="INFLOW"/>
                    <a:field name="surplus_amount_flag" defaultValue="Y"/>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="deposit_line_ds_update_event"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="csh_transaction_writeoff_deposit_pool_line_ds"
                       autoCreate="true">
                <a:fields>
                    <a:field name="write_off_type" readOnly="true" defaultValue="RECEIPT_DEPOSIT_POOL"/>
                    <a:field name="write_off_type_desc" readOnly="true" defaultValue="收款核销保证金池"/>
                    <a:field name="write_off_due_amount" required="true" prompt="本次核销金额"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_receipt_writeoff_add" text="新增"/>
                <a:gridButton click="csh301_receipt_writeoff_delete" text="删除"/>
                <a:gridButton click="csh301_receipt_writeoff_create" text="核销"/>
                <a:gridButton click="csh301_receipt_writeoff_back" text="退回"/>
                <a:gridButton click="csh301_receipt_writeoff_return" text="HLS.RETURN"/>
            </a:screenTopToolbar>
            <a:fieldSet title="收款信息" width="1100">
                <a:box column="4" labelWidth="100">
                    <a:datePicker name="write_off_date" bindTarget="csh_transaction_writeoff_head_ds"
                                  prompt="核销日期" renderer="Leaf.formatDate"/>
                    <a:lov name="bp_code" bindTarget="csh_transaction_writeoff_head_ds"
                           prompt="商业伙伴编码"/>
                    <a:textField name="bp_type_n" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="商业伙伴类型"/>
                    <a:datePicker name="transaction_date" bindTarget="csh_transaction_writeoff_head_ds"
                                  prompt="来款日期" renderer="Leaf.formatDate"/>
                </a:box>
                <a:box column="2" labelWidth="100">
                    <a:textField name="transaction_num" bindTarget="csh_transaction_writeoff_head_ds" prompt="收款编号"/>
                    <a:textField name="bp_name" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="商业伙伴名称" width="370"/>
                </a:box>
                <a:box column="4" labelWidth="100">
                    <a:textField name="transaction_amount" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="收款金额" renderer="Leaf.formatMoney"/>
                    <a:textField name="return_write_off_amount" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="已退款金额" renderer="Leaf.formatMoney"/>
                    <a:textField name="sum_write_off_amount" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="已核销金额" renderer="Leaf.formatMoney"/>
                    <a:textField name="can_return_amount" bindTarget="csh_transaction_writeoff_head_ds"
                                 prompt="剩余可核销金额" renderer="Leaf.formatMoney"/>
                </a:box>
            </a:fieldSet>

            <a:tabPanel id="csh301_receipt_writeoff_grid_id" marginHeight="250" marginWidth="30">
                <a:tabs>
                    <a:tab prompt="核销债权" selected="true" width="120">
                        <a:grid id="csh301_receipt_writeoff_credit_grid_id"
                                bindTarget="csh_transaction_writeoff_credit_line_ds" marginHeight="300"
                                marginWidth="60">
                            <a:columns>
                                <a:column name="contract_number" prompt="合同编号" editor="credit_editor_lov" width="180"/>
                                <!--<a:column name="contract_seq_num" prompt="报价编号" width="120"/>-->
                                <a:column name="times" prompt="期数" width="80"/>
                                <a:column name="bp_name" prompt="商业伙伴" width="200"/>
                                <a:column name="due_date" prompt="预定收款日期" width="150" align="center"
                                          renderer="Leaf.formatDate"/>
                                <a:column name="due_amount" prompt="预定收款金额" renderer="Leaf.formatMoney" align="right"
                                          width="150"/>
                                <a:column name="cf_item_desc" prompt="性质" width="80"/>
                                <a:column name="surplus_amount" prompt="剩余金额" renderer="Leaf.formatMoney" align="right"
                                          width="150"/>
                                <a:column name="write_off_due_amount" prompt="核销金额"
                                          align="right" renderer="Leaf.formatMoney"
                                          width="150"/>
                                <a:column name="write_off_principal" prompt="本金" align="right"
                                          renderer="Leaf.formatMoney" width="150"/>
                                <a:column name="write_off_interest" prompt="利息" align="right"
                                          renderer="Leaf.formatMoney" width="150"/>
                            </a:columns>
                            <a:editors>
                                <a:lov id="credit_editor_lov">
                                    <a:events>
                                        <a:event name="beforetriggerclick"
                                                 handler="credit_contract_number_lov_before_event"/>
                                        <a:event name="commit" handler="credit_contract_number_lov_commit_event"/>
                                    </a:events>
                                </a:lov>
                                <a:numberField id="credit_editor_nf" allowNegative="false"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="核销为代偿款" width="120">
                        <a:grid bindTarget="csh_transaction_writeoff_advance_credit_line_ds" marginHeight="300"
                                marginWidth="60">
                            <a:columns>
                                <a:column name="write_off_type_desc" prompt="核销类型" width="120"/>
                                <a:column name="write_off_due_amount" prompt="本次核销金额" renderer="Leaf.formatMoney"
                                          align="right" width="150"/>
                            </a:columns>
                            <a:editors>
                                <a:numberField id="advance_credit_editor_nf" allowNegative="false"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <!--<a:tab prompt="核销为保证金" width="120">
                        <a:grid id="csh301_receipt_writeoff_deposit_grid_id"
                                bindTarget="csh_transaction_writeoff_deposit_line_ds" marginHeight="300"
                                marginWidth="60">
                            <a:columns>
                                &lt;!&ndash;<a:column name="write_off_type_desc" prompt="核销类型" width="120"/>&ndash;&gt;
                                <a:column name="contract_number" prompt="合同编号" width="120"/>
                                &lt;!&ndash;<a:column name="contract_seq_num" prompt="报价编号" width="120"/>&ndash;&gt;
