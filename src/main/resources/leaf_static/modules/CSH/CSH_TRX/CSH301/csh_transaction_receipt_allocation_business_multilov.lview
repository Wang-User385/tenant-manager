<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lancer chen
    $Date: 2022年11月09日
    $Revision: 1.0
    $Purpose: 收款分配界面-核销债权新增按钮弹窗页面，支持多选，多选结果回写到上一个页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script type="text/javascript"><![CDATA[

        function mutlilov_contract_cashflow_ds_query_event(ds, para) {
            debugger
            para['notCashflowIdsStr'] = '${/parameter/@mutlilov_not_cashflow_ids_str}';
            para['creditFlag'] = '${/parameter/@creditFlag}';

        }


        function csh_allocation_multilov_list_query() {
            debugger
            var ds = $('mutlilov_contract_cashflow_ds');
            ds.qpara['notCashflowIdsStr'] = '${/parameter/@mutlilov_not_cashflow_ids_str}';
            ds.qpara['creditFlag'] = '${/parameter/@creditFlag}';
            $('mutlilov_contract_cashflow_ds').query();
        }

        function csh_allocation_multilov_list_reset() {
            $('mutlilov_contract_cashflow_query_ds').reset();
            $('mutlilov_contract_cashflow_ds').query();
        }

        function csh_allocation_multilov_confirm() {
            //TODO 把选择的记录传回上一个页面
            var ds = $('mutlilov_contract_cashflow_ds');
            multilovDatas = ds.getSelected();
            console.log(multilovDatas);
            $('${/parameter/@winId}').close();
        }

        ]]></script>
        <!--数据源-->
        <a:dataSets>
            <a:dataSet id="mutlilov_contract_cashflow_query_ds">
                <a:fields>
                    <a:field name="contract_number" />
                    <a:field name="prj_con_number" />
                    <a:field name="legal_contract_number" />
                    <a:field name="bp_name" />
                    <a:field name="due_date_from" />
                    <a:field name="due_date_to" />
                    <a:field name="cf_item_n" />
                </a:fields>
            </a:dataSet>
            <a:dataSet id="mutlilov_contract_cashflow_ds" autoPageSize="true" autoQuery="true"
                       queryDataSet="mutlilov_contract_cashflow_query_ds"
                       queryUrl="${/request/@context_path}/contract/cashflow/queryLov?wflRuleControlFlag=Y"
                       selectable="true">
                <a:fields>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="deal_date" datatype="date"/>
                    <a:field name="contract_number" />
                    <a:field name="contract_number" />
                    <a:field name="legal_contract_number" />
                    <a:field name="prj_con_number" />
                    <a:field name="contract_name" />
                    <a:field name="cashflow_id" />
                    <a:field name="contract_id" />
                    <a:field name="times" />
                    <a:field name="contract_seq" />
                    <a:field name="bp_name" />
                    <a:field name="bp_id" />
                    <a:field name="due_amount" />
                    <a:field name="cf_item_n" />
                    <a:field name="cf_item" />
                    <a:field name="cf_type" />
                    <a:field name="surplus_amount" />
                    <a:field name="surplus_principal" />
                    <a:field name="surplus_interest" />
                    <a:field name="surplus_principal" />
                    <a:field name="surplus_interest" />
                    <a:field name="manufacturer_name" />
                </a:fields>
                <a:events>
                    <a:event name="query" handler="mutlilov_contract_cashflow_ds_query_event"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <!--页面布局-->
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh_allocation_multilov_list_query" text="HAP.QUERY"/>
                <a:gridButton click="csh_allocation_multilov_list_reset" text="HAP.RESET"/>
                <a:gridButton click="csh_allocation_multilov_confirm" text="确定"/>
            </a:screenTopToolbar>
            <a:form column="3" title="查询条件" labelWidth="110">
                <a:textField name="contract_number" bindTarget="mutlilov_contract_cashflow_query_ds"
                             prompt="合同编号" width="160"/>
                <!--<a:textField name="legal_contract_number" bindTarget="mutlilov_contract_cashflow_query_ds"
                             prompt="法务合同编号" width="160"/>-->
                <a:textField name="bp_name" bindTarget="mutlilov_contract_cashflow_query_ds"
                             prompt="客户名称" width="160"/>
                <a:textField name="cf_item_n" bindTarget="mutlilov_contract_cashflow_query_ds"
                             prompt="性质" width="160"/>
                <a:datePicker name="due_date_from" bindTarget="mutlilov_contract_cashflow_query_ds"
                              prompt="预定收款日期从" width="160"/>
                <a:datePicker name="due_date_to" bindTarget="mutlilov_contract_cashflow_query_ds"
                              prompt="预定收款日期到" width="160"/>

            </a:form>

            <a:grid id="csh_mutlilov_contract_cashflow_gird_id" bindTarget="mutlilov_contract_cashflow_ds"
                    marginHeight="100"
                    navBar="true" >
                <a:columns>
                    <a:column name="contract_number" prompt="合同编号" width="120" />
                   <!-- <a:column name="legal_contract_number" prompt="法务合同编号" width="120"/>-->
                    <a:column name="bp_name" prompt="客户名称" width="200"/>
                    <a:column name="manufacturer_name" prompt="合作商"  align="left"
                              width="150"/>
                    <a:column name="times" prompt="期数" align="center" width="80"/>
                    <a:column name="due_date" prompt="应收日期" align="center" renderer="Leaf.formatDate" width="100"/>
                    <a:column name="due_amount" prompt="应收金额" align="right" renderer="Leaf.formatMoney"
                              width="120"/>
                    <a:column name="cf_item_n" prompt="性质" align="center" width="100"/>
                    <a:column name="surplus_amount" prompt="剩余金额" renderer="Leaf.formatMoney" align="right"/>

                </a:columns>
            </a:grid>

        </a:screenBody>


    </a:view>
</a:screen>