<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月28日
    $Revision: 1.0
    $Purpose: 核销明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <a:link id="csh_transaction_receipt_writeoff_reverse_link"
                url="${/request/@context_path}/csh/write/off/reverse"/>
        <script><![CDATA[

        var body = $('${/parameter/@winId}').wrap;

        function csh301_batch_write_off_detail_return() {
            $('${/parameter/@winId}').close();
        }


        function csh301_batch_write_off_reverse() {
            debugger;
            var head_ds = $('csh_transaction_batch_write_off_reverse_detail_head_ds');
            var line_ds = $('csh_transaction_batch_write_off_detail_result_ds');
            if (head_ds.validate()) {
                var reversed_date = head_ds.getAt(0).get('reversed_date');
                var description = head_ds.getAt(0).get('description');
                var saveData = [];
                var records = line_ds.getSelected();
                for (var i = 0; i < records.length; i++) {
                    //校验
                    if (records[i].get('write_off_date') > reversed_date) {
                        Leaf.showMessage('提示！', '反冲日期不能小于核销日期！');
                        return;
                    }
                    var transaction_date = records[i].get('transaction_date');
                    var date = new Date();
                    var transaction_Month = transaction_date.getMonth();
                    var Month = date.getMonth();
                    if (transaction_Month != Month) {
                        Leaf.showMessage('提示！', '非当月交易记录不能反冲！');
                        return;
                    }
                    //已经反冲过的不能再次反冲
                    var reversed_flag = records[i].get('reversed_flag');
                    if (reversed_flag == 'Y') {
                        Leaf.showMessage('提示！', '该记录以反冲过，不能重复反冲！');
                        return;
                    }

                    records[i].set("reversed_date", reversed_date);
                    records[i].set("description", description);
                    saveData.push(records[i].data);
                }
                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '反冲中。。');

                Leaf.request({
                    url: $('csh_transaction_receipt_writeoff_reverse_link').getUrl(),
                    para: saveData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask($(winId).wrap);
                        csh301_batch_write_off_detail_query();
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }


        }

        function csh301_batch_write_off_detail_query() {
            $('csh_transaction_batch_write_off_detail_result_ds').query();
        }

        function csh301_batch_write_off_detail_reset() {
            $('csh_transaction_batch_write_off_query_ds').reset();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="csh_transaction_batch_write_off_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="reversed_flag_n" displayField="code_value_name" options="reversed_flag_ds"
                             returnField="reversed_flag" valueField="code_value"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_transaction_batch_write_off_detail_result_ds" autoQuery="true" autoPageSize="true"
                       queryDataSet="csh_transaction_batch_write_off_query_ds"
                       queryUrl="${/request/@context_path}/csh/write/off/query?nonRefundFlag=Y&amp;transactionType=RECEIPT"
                       selectable="true">
                <a:fields>
                    <a:field name="due_date" datatype="java.util.Date"/>
                    <a:field name="write_off_date" datatype="java.util.Date"/>
                    <a:field name="transaction_date" datatype="java.util.Date"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_batch_write_off_reverse_detail_head_ds" autoCreate="true">
                <a:fields>
                    <a:field name="reversed_date" datatype="date" required="true" prompt="反冲日期"/>
                    <a:field name="description" defaultValue="${l:HLS.REVERSE}"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_batch_write_off_detail_return" text="HLS.RETURN"/>
                <a:gridButton click="csh301_batch_write_off_detail_query" text="查询"/>
                <a:gridButton click="csh301_batch_write_off_detail_reset" text="重置"/>
                <a:gridButton click="csh301_batch_write_off_reverse" text="批量反冲"/>
            </a:screenTopToolbar>

            <a:fieldSet column="4" labelWidth="100" title="查询条件" width="1100">
                <a:textField name="contract_number" bindTarget="csh_transaction_batch_write_off_query_ds"
                             prompt="合同编号"/>
                <a:textField name="contract_name" bindTarget="csh_transaction_batch_write_off_query_ds"
                             prompt="合同名称"/>
                <a:textField name="tenant_name" bindTarget="csh_transaction_batch_write_off_query_ds"
                             prompt="承租人"/>
                <a:comboBox name="reversed_flag_n"
                            bindTarget="csh_transaction_batch_write_off_query_ds"
                            prompt="核销反冲标志"/>
            </a:fieldSet>

            <a:fieldSet column="2" labelWidth="100" title="CSH514.CSH_WRITE_OFF_DETAIL" width="1100">
                <a:datePicker name="reversed_date" bindTarget="csh_transaction_batch_write_off_reverse_detail_head_ds"
                              prompt="反冲日期"/>
                <a:textField name="description" bindTarget="csh_transaction_batch_write_off_reverse_detail_head_ds"
                             prompt="HLS.NOTE" width="300"/>
            </a:fieldSet>
            <a:grid id="csh_transaction_receipt_batch_writeoff_detail_grid_id"
                    bindTarget="csh_transaction_batch_write_off_detail_result_ds" marginHeight="250" marginWidth="10"
                    navBar="true">
                <a:columns>
                    <a:column name="write_off_type_n" width="120" prompt="核销类型"/>
                    <a:column name="due_date" renderer="Leaf.formatDate" width="80" prompt="预定收款日"/>
                    <a:column name="write_off_date" renderer="Leaf.formatDate" width="80" prompt="核销日期"/>
                    <a:column name="cf_item_n" prompt="性质" width="100"/>
                    <a:column name="write_off_due_amount" align="right" renderer="Leaf.formatMoney" prompt="核销金额"
                              width="120"/>
                    <a:column name="write_off_principal" align="right" renderer="Leaf.formatMoney" prompt="本金"
                              width="120"/>
                    <a:column name="write_off_interest" align="right" renderer="Leaf.formatMoney" prompt="利息"
                              width="120"/>
                    <a:column name="times" align="center" prompt="期数" width="40"/>
                    <a:column name="contract_number" prompt="合同编号" width="150"/>
                    <a:column name="contract_name" prompt="合同名称" width="250"/>
                    <a:column name="tenant_name" prompt="承租人" width="250"/>
                    <a:column name="reversed_flag_n" prompt="反冲标志" width="80"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
