<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月19日
    $Revision: 1.0
    $Purpose: 收款管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="transaction_add_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_add.lview"/>

        <a:link id="transaction_modify_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_modify.lview"/>

        <a:link id="transaction_query_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_query.lview"/>

        <a:link id="transaction_reverse_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_reverse.lview"/>
        <a:link id="transaction_writeoff_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_writeoff.lview"/>

        <a:link id="transaction_writeoff_reverse_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_writeoff_reverse.lview"/>

        <a:link id="transaction_writeoff_refund_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_refund.lview"/>

        <a:link id="transaction_writeoff_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_writeoff_detail_query.lview"/>

        <a:link id="transaction_refund_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_refund_detail_query.lview"/>

        <a:link id="csh301_receipt_post_link"
                url="${/request/@context_path}/csh/transaction/post"/>

        <a:link id="transaction_match_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_match.lview"/>


        <script><![CDATA[


        function csh301_transaction_query() {
            $('csh_transaction_receipt_maintain_result_ds').query();
        }

        function csh301_transaction_reset() {
            $('csh_transaction_receipt_maintain_query_ds').reset();
        }


        function csh301_transaction_receipt_query() {
            $('csh_transaction_receipt_detail_result_ds').query();
        }

        function csh301_transaction_receipt_reset() {
            $('csh_transaction_receipt_detail_query_ds').reset();
        }

        //收款新增
        function csh301_transaction_add() {
            var win = new Leaf.Window({
                id: 'transaction_add_winId',
                url: $('transaction_add_link').getUrl(),
                params: {
                    winId: 'transaction_add_winId'
                },
                title: '收款新增',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }


        //收款反冲
        function csh301_transaction_reverse() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('sum_write_off_amount')) {
                    Leaf.showMessage('提示！', '已核销，请先核销反冲！');
                    return;
                }
            }
            var win = new Leaf.Window({
                id: 'transaction_reverse_winId',
                url: $('transaction_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_reverse_winId'
                },
                title: '收款反冲',
                width: 600,
                height: 200,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

        //收款退款
        function csh301_transaction_writeoff_refund() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }
            var record = records[0];
            var can_return_amount = record.get('can_return_amount');

            if (can_return_amount == 0) {
                Leaf.showMessage('提示！', '该笔收款无剩余可退款金额！');
                return;
            }
            var transaction_id = records[0].get('transaction_id');

            var win = new Leaf.Window({
                id: 'transaction_writeoff_refund_winId',
                url: $('transaction_writeoff_refund_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_refund_winId',
                    transaction_id: transaction_id
                },
                title: '收款退款',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });


        }

        //收款认领/匹配
        function csh301_transaction_match() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }
            var record = records[0];
            var posted_flag = record.get('posted_flag');
            if (posted_flag == 'N') {
                Leaf.showMessage('提示！', '请先过账！');
                return;
            }

            var win = new Leaf.Window({
                id: 'transaction_match_winId',
                url: $('transaction_match_detail_link').getUrl(),
                params: {
                    winId: 'transaction_match_winId',
                    transaction_id: record.get("transaction_id")
                },
                title: '收款核销',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

        //收款核销
        function csh301_transaction_writeoff() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }
            var record = records[0];
            var posted_flag = record.get('posted_flag');
            var match_status = record.get('match_status');

            if (posted_flag == 'N') {
                Leaf.showMessage('提示！', '请先过账！');
                return;
            }
            if (match_status != 'NEW') {
                Leaf.showMessage('提示！', '请先匹配再核销！');
                return;
            }

            var win = new Leaf.Window({
                id: 'transaction_writeoff_winId',
                url: $('transaction_writeoff_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_winId',
                    transaction_id: record.get("transaction_id")
                },
                title: '收款核销',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }





        //核销反冲
        function csh301_transaction_writeoff_reverse() {
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }

            var transaction_id = records[0].get('transaction_id');
            var win = new Leaf.Window({
                id: 'transaction_writeoff_reverse_winId',
                url: $('transaction_writeoff_reverse_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_reverse_winId',
                    transaction_id: transaction_id
                },
                title: '核销反冲',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }


        // 匹配状态转换
        function match_status_renderer(value, record) {
            var matchShowMess = "";
            var matchColor = "";
            switch (value) {
                case "NEW":
                    matchShowMess = "匹配未核销";
                    matchColor = "rgb(255, 205, 85)";
                    break;
                case "CHECK":
                    matchShowMess = "匹配核销";
                    matchColor = "rgb(160, 212, 105)";
                    break;
                case "REJECT":
                    matchShowMess = "匹配退回";
                    matchColor = "rgb(220, 20, 60)";
                    break;
                case "NOT":
                    matchShowMess = "未匹配";
                    matchColor = "rgb(204, 204, 204)";
                    break;
            }
            return matchShowMess;
        }

        function attachment_render(value, record) {
            var table_name = 'CSH_COLLECTION_ACCT';
            return '<a href="javascript:csh301_open_attach(\'' + record.get('transaction_id') + '\',\'' + table_name + '\')">附件</a>';
        }

        // 收款明细
        function detail_renderer(value, record) {
            return '<a href="javascript:open_write_off_detail_window(\'' + record.get('transaction_id') + '\')">详情</a>'
        }


        function open_write_off_detail_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_writeoff_detail_winId',
                url: $('transaction_writeoff_detail_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_detail_winId',
                    transaction_id: transaction_id
                },
                title: '核销明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });

        }



        function csh301_open_detail(transaction_id) {
            var url = '${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_lists.lview';
            win = new Leaf.Window({
                id: 'csh301_open_detail_winid',
                url: url,
                params: {
                    header_id: transaction_id,
                    winid: 'csh301_open_detail_winid'
                },
                title: '收款明细',
                width: 1000,
                height: 475
            });
            win.on('close', function () {

            });
        }

        function csh301_open_attach(csh_attachment_id, table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'csh301_open_attachment_winid',
                url: url,
                params: {
                    header_id: csh_attachment_id,
                    table_name: 'CSH_TRANSACTION_ATTACHMENT',
                    winid: 'csh301_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {

            });
        }


        ]]></script>

        <a:dataSets>

            <a:dataSet id="payment_method_ds" lookupCode="CSH.PAYMENT_METHOD"/>
            <a:dataSet id="posted_flag_ds" lookupCode="CSH.POST_SELECT"/>
            <a:dataSet id="yes_no_ds" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="reversed_flag_ds" lookupCode="HLS_REVERSED_FLAG"/>
            <a:dataSet id="write_off_flag_ds" lookupCode="CON.CASHFLOW_WRITE_OFF_FLAG"/>
            <a:dataSet id="write_off_match_flag_ds" lookupCode="CON.WRITE_OFF_MATCH_FLAG"/>


            <a:dataSet id="csh_transaction_receipt_maintain_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="transaction_date_from"/>
                    <a:field name="transaction_date_to"/>
                    <a:field name="write_off_status_n" displayField="code_value_name" options="write_off_flag_ds"
                             returnField="write_off_status" valueField="code_value"/>
                    <a:field name="write_off_status"/>
                    <a:field name="bp_name"/>
                    <a:field name="bank_inf"/>
                    <a:field name="match_status_n" displayField="code_value_name" options="write_off_match_flag_ds"
                             returnField="match_status" valueField="code_value"/>
                    <a:field name="match_status"/>
                    <a:field name="role_id" defaultValue="${/session/@roleId}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_maintain_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/cshTransaction/collectionDetails?roleId=${/session/@roleId}"
                       queryDataSet="csh_transaction_receipt_maintain_query_ds"
                       selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                    <a:field name="creation_date"/>
                    <a:field name="bp_name"/>
                    <a:field name="transaction_num"/>
                    <a:field name="description"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="transaction_amount"/>
                    <a:field name="write_off_amount"/>
                    <a:field name="un_write_off_amount"/>
                    <a:field name="bank_account_name"/>
                    <a:field name="bank_name"/>
                    <a:field name="bank_account_num"/>
                    <a:field name="write_off_flag_desc"/>
                    <a:field name="match_status"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_transaction_receipt_detail_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="write_off_status_n" displayField="code_value_name" options="write_off_flag_ds"
                             returnField="write_off_status" valueField="code_value"/>
                    <a:field name="due_date_from"/>
                    <a:field name="due_date_to"/>
                    <a:field name="write_off_status"/>
                    <a:field name="bp_name_or_code"/>
                    <a:field name="contract_name_or_number"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_detail_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/csh/con/cashflow/list/query/home"
                       queryDataSet="csh_transaction_receipt_detail_query_ds"
                       selectable="true">
                <a:fields>
                    <a:field name="approval_number"/>
                    <a:field name="contract_number"/>
                    <a:field name="contract_name"/>
                    <a:field name="bp_code"/>
                    <a:field name="bp_name"/>
                    <a:field name="manager_name"/>
                    <a:field name="unit_name"/>
                    <a:field name="times_total"/>
                    <a:field name="due_date"/>
                    <a:field name="due_amount"/>
                    <a:field name="the_principal"/>
                    <a:field name="the_interest"/>
                    <a:field name="the_consulting_service_fee"/>
                    <a:field name="the_margin"/>
                    <a:field name="the_lease_charge"/>
                    <a:field name="the_down_payment"/>
                    <a:field name="the_pre_rent"/>
                    <a:field name="the_residual_value"/>
                    <a:field name="received_amount"/>
                    <a:field name="surplus_amount"/>
                    <a:field name="currency_name"/>
                    <a:field name="back_bank_name"/>
                    <a:field name="back_bank_account_num"/>
                    <a:field name="write_off_flag_desc"/>
                </a:fields>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:tabPanel marginHeight="50" marginWidth="10">
                <a:tabs>
                    <a:tab prompt="收款明细" width="110">
                        <a:form bindTarget="csh_transaction_receipt_maintain_query_ds" labelWidth="100" marginWidth="50"
                                height="175">
                            <a:screenTopToolbar>
                                <a:screenTitle/>
                                <a:gridButton click="csh301_transaction_query" text="HLS.QUERY"/>
                                <a:gridButton click="csh301_transaction_reset" text="HLS.RESET"/>
                                <a:gridButton id="csh301_write_add" click="csh301_transaction_add" text="收款新增"/>
                                <a:gridButton id="csh301_write_reverse" click="csh301_transaction_reverse" text="收款反冲"/>
                                <a:gridButton id="csh301_write_refund" click="csh301_transaction_writeoff_refund" text="收款退款"/>
                                <a:gridButton id="csh301_write_match" click="csh301_transaction_match" text="匹配"/>
                                <a:gridButton id="csh301_write_off" click="csh301_transaction_writeoff" text="核销"/>
                            </a:screenTopToolbar>
                            <a:fieldSet column="5" labelWidth="100" title="HLS.QUERY_TITLE">
                                <a:datePicker name="transaction_date_from"
                                              bindTarget="csh_transaction_receipt_maintain_query_ds"
                                              prompt="交易日期从"/>
                                <a:datePicker name="transaction_date_to"
                                              bindTarget="csh_transaction_receipt_maintain_query_ds"
                                              prompt="交易日期到"/>
                                <a:textField name="bp_name" bindTarget="csh_transaction_receipt_maintain_query_ds"
                                             prompt="收款对象"/>
                                <a:textField name="bank_inf" bindTarget="csh_transaction_receipt_maintain_query_ds"
                                             prompt="银行账户信息"/>

                                <a:comboBox name="write_off_status_n"
                                            bindTarget="csh_transaction_receipt_maintain_query_ds"
                                            prompt="核销状态"/>
                                <a:comboBox name="match_status_n"
                                            bindTarget="csh_transaction_receipt_maintain_query_ds"
                                            prompt="匹配状态"/>
                            </a:fieldSet>
                        </a:form>


                        <a:grid id="csh_transaction_receipt_maintain_grid_ds"
                                bindTarget="csh_transaction_receipt_maintain_result_ds" height="500"
                                marginWidth="50"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="detail" prompt="详情" width="80" align="center"
                                          renderer="detail_renderer"/>
                                <a:column name="write_off_flag_desc" prompt="核销状态" width="100"/>
                                <a:column name="match_status" prompt="匹配状态" width="100"
                                          renderer="match_status_renderer"/>
                                <a:column name="transaction_date" align="center" prompt="交易日期" width="100"
                                          renderer="Leaf.formatDate"/>
                                <a:column name="creation_date" align="center" prompt="导入日期" width="150"
                                          renderer="Leaf.formatDate"/>
                                <a:column name="bp_name" prompt="对象" width="200"/>
                                <a:column name="transaction_num" prompt="交易号" width="120"/>
                                <a:column name="description" prompt="摘要" width="120"/>
                                <a:column name="bank_slip_num" prompt="流水号" width="120"/>
                                <a:column name="transaction_amount" prompt="总金额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="120"/>
                                <a:column name="write_off_amount" prompt="已核销金额"
                                          align="right" renderer="Leaf.formatMoney"
                                          width="120"/>
                                <a:column name="un_write_off_amount" prompt="未核销金额"
                                          align="right" renderer="Leaf.formatMoney"
                                          width="120"/>
                                <a:column name="bank_account_name" prompt="户名" width="200"/>
                                <a:column name="bank_name" prompt="银行名称" width="200"/>
                                <a:column name="bank_account_num" prompt="账号" width="200"/>

                                <!--<a:column name="bank_account_num" prompt="操作" width="120"/>-->
                                <a:column name="attach" prompt="附件" renderer="attachment_render" width="120"
                                          align="center"/>


                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="应收实收情况统计" width="120">

                        <a:form bindTarget="csh_transaction_receipt_detail_query_ds" labelWidth="100" marginWidth="50"
                                height="175">
                            <a:screenTopToolbar>
                                <a:screenTitle/>
                                <a:gridButton click="csh301_transaction_receipt_query" text="HLS.QUERY"/>
                                <a:gridButton click="csh301_transaction_receipt_reset" text="HLS.RESET"/>
                            </a:screenTopToolbar>
                            <a:fieldSet column="5" labelWidth="100" title="HLS.QUERY_TITLE">
                                <a:datePicker name="due_date_from"
                                              bindTarget="csh_transaction_receipt_detail_query_ds"
                                              prompt="日期从"/>
                                <a:datePicker name="due_date_to"
                                              bindTarget="csh_transaction_receipt_detail_query_ds"
                                              prompt="日期到"/>
                                <a:textField name="bp_name_or_code" bindTarget="csh_transaction_receipt_detail_query_ds"
                                             prompt="客户信息"/>
                                <a:textField name="contract_name_or_number"
                                             bindTarget="csh_transaction_receipt_detail_query_ds"
                                             prompt="合同信息"/>
                                <a:comboBox name="write_off_status_n"
                                            bindTarget="csh_transaction_receipt_detail_query_ds"
                                            prompt="核销情况"/>
                            </a:fieldSet>
                        </a:form>

                        <a:grid id="csh_transaction_receipt_detail_grid_ds"
                                bindTarget="csh_transaction_receipt_detail_result_ds" height="500"
                                marginWidth="50"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="approval_number" prompt="业务合同编码" width="100"/>
                                <a:column name="contract_number" prompt="合同编号" width="100"/>
                                <a:column name="contract_name" prompt="合同名称" width="100"/>
                                <a:column name="bp_code" prompt="客户编号" width="100"/>
                                <a:column name="bp_name" prompt="客户名称" width="100"/>
                                <a:column name="manager_name" prompt="项目经理" width="100"/>
                                <a:column name="unit_name" prompt="业务部门" width="100"/>
                                <a:column name="times_total" prompt="期数/总期数" width="100"/>
                                <a:column name="due_date" prompt="应收日期" width="100"/>
                                <a:column name="due_amount" prompt="应收金额" width="100"/>
                                <a:column name="the_principal" prompt="本金" width="100"/>
                                <a:column name="the_interest" prompt="利息" width="100"/>
                                <a:column name="the_consulting_service_fee" prompt="咨询服务费" width="100"/>
                                <a:column name="the_margin" prompt="保证金" width="100"/>
                                <a:column name="the_lease_charge" prompt="手续费" width="100"/>
                                <a:column name="the_down_payment" prompt="首付款" width="100"/>
                                <a:column name="the_pre_rent" prompt="租前息" width="100"/>
                                <a:column name="the_residual_value" prompt="留购金" width="100"/>
                                <a:column name="the_penalty_interest" prompt="罚息" width="100"/>
                                <a:column name="received_amount" prompt="实收金额" width="100"/>
                                <a:column name="surplus_amount" prompt="未收金额" width="100"/>
                                <a:column name="currency_name" prompt="币种" width="100"/>
                                <a:column name="back_bank_name" prompt="回款银行" width="100"/>
                                <a:column name="back_bank_account_num" prompt="回款账户" width="100"/>
                                <a:column name="write_off_flag_desc" prompt="核销状态" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
        <script><![CDATA[

        Leaf.onReady(function () {

            //收款新增按钮
            var write_add_btn = document.getElementById("csh301_write_add");
            //收款反冲按钮
            var write_reverse_btn = document.getElementById("csh301_write_reverse");
            //收款退款
            var write_refund_btn = document.getElementById("csh301_write_refund");
            //匹配按钮
            var write_match_btn = document.getElementById("csh301_write_match");
            //核销按钮
            var write_off_btn = document.getElementById("csh301_write_off");

            //1、出纳新增 10019 CASHIER
            if ('${/session/@roleId}' == 10019) {

                if (write_match_btn) {
                    write_match_btn.style.display = "none";
                }

                if (write_off_btn) {
                    write_off_btn.style.display = "none";
                }
                //$('csh301_write_match').hide();
                //$('csh301_write_off').hide();


                //2、运营岗进行认领 10037 operation
            } else if ('${/session/@roleId}' == 10037) {
                if (write_add_btn) {
                    write_add_btn.style.display = "none";
                }

                if (write_reverse_btn) {
                    write_reverse_btn.style.display = "none";
                }

                if (write_refund_btn) {
                    write_refund_btn.style.display = "none";
                }

                if (write_off_btn) {
                    write_off_btn.style.display = "none";
                }
                //$('csh301_write_add').hide();
                //$('csh301_write_reverse').hide();
                //$('csh301_write_off').hide();

                //3、财务核销 10013 Financial_Controller
            } else if ('${/session/@roleId}' == 10013) {

                if (write_add_btn) {
                    write_add_btn.style.display = "none";
                }

                if (write_reverse_btn) {
                    write_reverse_btn.style.display = "none";
                }

                if (write_refund_btn) {
                    write_refund_btn.style.display = "none";
                }


                if (write_match_btn) {
                    write_match_btn.style.display = "none";
                }


                //$('csh301_write_add').hide();
                //$('csh301_write_reverse').hide();
                //$('csh301_write_match').hide();
            }
        });


	  	]]></script>
    </a:view>
</a:screen>
