<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年7月10日
    $Revision: 1.0  
    $Purpose: 银行账户新增
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <a:link id="csh301_bp_bank_account_save_link" url="${/request/@context_path}/hls/bp/bank/account/submit"/>

        <script type="text/javascript"><![CDATA[

        function csh301_receipt_bp_bank_account_save() {
            if ($('csh_transaction_receipt_bp_bank_account_ds').validate()) {
                Leaf.Masker.mask(Ext.getBody());
                var record = $('csh_transaction_receipt_bp_bank_account_ds').getAt(0);
                var saveData = [];
                record.set('_status', 'insert');
                saveData.push(record.data);
                Leaf.request({
                    url: $('csh301_bp_bank_account_save_link').getUrl(),
                    para: saveData,
                    success: function (res) {
                        var bank_account_id = res.result.record[0].bank_account_id;
                        var head_record = $('csh_transaction_receipt_head_ds').getAt(0);
                        head_record.set('bp_bank_account_id',bank_account_id)
                        head_record.set('bp_bank_account_name',record.get('bank_account_name'));
                        head_record.set('bp_bank_account_num',record.get('bank_account_num'));
                        head_record.set('bp_bank_name',record.get('bank_full_name'));
                        head_record.set('bp_bank_branch_name',record.get('bank_branch_name'));
                        csh301_receipt_bp_bank_account_back();
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }
        }

        function csh301_receipt_bp_bank_account_back() {
            $('${/parameter/@winId}').close();
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="bank_type_bp_ds" lookupCode="BANK_TYPE_BP"/>
            <a:dataSet id="csh_transaction_receipt_bp_bank_account_ds" autoCreate="true" loadData="true">
                <a:fields>
                    <a:field name="bank_account_type_n" options="bank_type_bp_ds"
                             displayField="code_value_name" valueField="code_value" returnField="bank_account_type"/>
                    <a:field name="bp_id" defaultValue="${/parameter/@bp_id}"/>
                    <a:field name="bp_name" defaultValue="${/parameter/@bp_name}" readOnly="true"/>
                    <a:field name="bank_account_num" required="true"/>
                    <a:field name="bank_full_name"/>
                    <a:field name="bank_branch_name"/>
                    <a:field name="company_id" readOnly="true" defaultValue="${/session/@companyId}"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_receipt_bp_bank_account_save" text="HLS.SAVE"/>
                <a:gridButton click="csh301_receipt_bp_bank_account_back" text="HLS.RETURN"/>
            </a:screenTopToolbar>
            <a:form>
                <a:fieldSet column="4" labelWidth="250" title="银行账号信息" width="750">
                    <a:box column="2" labelWidth="100">
                        <a:textField name="bp_name" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="商业伙伴"/>
                        <a:comboBox name="bank_account_type_n" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                    prompt="账户类型"/>
                        <a:textField name="bank_account_name" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="账户名称"/>
                        <a:textField name="bank_account_num" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="银行账号"/>
                        <a:textField name="bank_full_name" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="银行名称"/>
                        <a:textField name="bank_branch_name" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="支行名称"/>
                        <a:textField name="description" bindTarget="csh_transaction_receipt_bp_bank_account_ds"
                                     prompt="备注"/>
                    </a:box>
                </a:fieldSet>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
