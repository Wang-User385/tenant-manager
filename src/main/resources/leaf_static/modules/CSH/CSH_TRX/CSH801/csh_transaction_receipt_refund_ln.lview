<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月28日
    $Revision: 1.0  
    $Purpose: 收款退款-金融市场部节点
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>

        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>

        <script type="text/javascript"><![CDATA[

            function csh301_transaction_refund_close(){
                $('${/parameter/@winid}').close();
            }

        ]]></script>
        <a:dataSets>

            <a:dataSet id="csh_transaction_refund_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="refund_id" defaultValue="${/parameter/@refund_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_refund_head_ds" autoQuery="true" queryDataSet="csh_transaction_refund_query_ds"
                       queryUrl="${/request/@context_path}/csh/transaction/refund/query?refundId=${/parameter/@refund_id}">
                <a:fields>
                    <a:field name="transaction_date" datatype="date" readOnly="true" prompt="退款日期"/>
                    <a:field name="return_due_amount" readOnly="true" prompt="退款金额"/>

                    <a:field name="refund_date" datatype="date" readOnly="true" prompt="退款日期"/>
                    <a:field name="refund_amount" readOnly="true" prompt="退款金额"/>


                    <a:field name="bank_account_num" readOnly="true"/>
                    <a:field name="currency_name" readOnly="true"/>
                    <a:field name="currency_code" readOnly="true"/>

                    <a:field name="bank_slip_num" readOnly="true"/>
                    <a:field name="description" readOnly="true"/>
                    <a:field name="comments" readOnly="true"/>

                    <a:field name="refund_number" readOnly="true"/>


                    <a:field name="bp_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/hls/bp/queryBpMasterLov~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="商业伙伴">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="refund_method_n" displayField="code_value_name" options="payment_method_ds"
                             returnField="payment_method" valueField="code_value"/>
                    <a:field name="payment_method_n" displayField="code_value_name" options="payment_method_ds"
                             returnField="payment_method" valueField="code_value"/>
                    <a:field name="payment_method"/>
                    <a:field name="bp_bank_account_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90" readOnly="true"
                             lovService="/hls/bp/bank/account/queryLov~hls.layout.dto.LovBpBankAccountDto"
                             lovWidth="580" title="CSH511.BP_BANK_ACCOUNT_CODE" prompt="对方账户">
                        <a:mapping>
                            <a:map from="bank_account_id" to="bp_bank_account_id"/>
                            <a:map from="bank_account_num" to="bp_bank_account_num"/>
                            <a:map from="bank_account_name" to="bp_bank_account_name"/>
                            <a:map from="bank_full_name" to="bp_bank_name"/>
                            <a:map from="bank_branch_name" to="bp_bank_branch_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_bank_account_num" readOnly="true"/>
                    <a:field name="bp_bank_name" readOnly="true"/>
                    <a:field name="bp_bank_branch_name" readOnly="true"/>
                    <a:field name="company_id" readOnly="true" defaultValue="${/session/@companyId}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_refund_ln_ds" autoQuery="true" queryDataSet="csh_transaction_refund_query_ds"
                       queryUrl="${/request/@context_path}/csh/transaction/refund/ln/detail/query?refundId=${/parameter/@refund_id}"
                       submitUrl="${/request/@context_path}/csh/transaction/refund/ln/submit"
                       deleteUrl="${/request/@context_path}/csh/transaction/refund/ln/remove">
                <a:field name="bank_account_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                         lovLabelWidth="90" lovService="/csh/bank/account/query~hls.layout.dto.LovCshBankAccountDto"
                         lovWidth="850" required="true" title="CSH511.BANK_ACCOUNT_CODE" prompt="付款账户">
                    <a:mapping>
                        <a:map from="bank_account_id" to="bank_account_id"/>
                        <a:map from="bank_account_num" to="bank_account_num"/>
                        <a:map from="bank_account_name" to="bank_account_name"/>
                        <a:map from="bank_account_code" to="bank_account_code"/>
                        <a:map from="bank_branch_name" to="bank_branch_name"/>
                        <a:map from="currency" to="currency_code"/>
                        <a:map from="currency_n" to="currency_n"/>
                    </a:mapping>
                </a:field>
                <a:field name="bank_account_num" readOnly="true"/>
                <a:field name="currency_n" readOnly="true"/>
                <a:field name="currency_code" readOnly="true"/>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_transaction_refund_close" text="HLS.RETURN"/>
            </a:screenTopToolbar>
            <a:form>
                <a:fieldSet title="退款信息" width="750">
                    <a:box column="3" labelWidth="100">
                        <a:textField name="refund_number" bindTarget="csh_transaction_receipt_refund_head_ds"
                                     prompt="退款申请编号"/>
                        <a:datePicker name="refund_date" bindTarget="csh_transaction_receipt_refund_head_ds"
                                      prompt="退款日期" renderer="Leaf.formatDate"/>
                        <a:numberField name="refund_amount" bindTarget="csh_transaction_receipt_refund_head_ds"
                                       prompt="退款金额"/>
                        <a:textField name="currency_name" bindTarget="csh_transaction_receipt_refund_head_ds" prompt="币种"/>
                        <a:lov name="bp_bank_account_name" bindTarget="csh_transaction_receipt_refund_head_ds"
                               prompt="对方账户" width="200"/>
                        <a:textField name="bp_bank_account_num" bindTarget="csh_transaction_receipt_refund_head_ds"
                                     prompt="对方账号" width="150"/>
                        <a:textField name="description" bindTarget="csh_transaction_receipt_refund_head_ds"
                                     prompt="摘要" width="250"/>
                    </a:box>
                </a:fieldSet>
            </a:form>
            <a:grid id="csh_transaction_refund_ln_grid_ds"
                    bindTarget="csh_transaction_receipt_refund_ln_ds" width="750" height="300"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="bank_account_name" prompt="付款账户" width="150"/>
                    <a:column name="bank_account_num" prompt="付款账号" width="150"/>
                    <a:column name="refund_amount" align="right" prompt="付款金额" width="120" renderer="Leaf.formatMoney"/>
                    <a:column name="payment_method_n" prompt="付款方式" width="80"/>
                    <a:column name="bank_slip_num" prompt="银行流水" width="120"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
