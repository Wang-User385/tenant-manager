<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月19日
    $Revision: 1.0
    $Purpose: 收款退款管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="transaction_writeoff_refund_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_refund.lview"/>
        <a:link id="transaction_writeoff_refund_link1"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH801/csh_transaction_receipt_refund_wfl.lview"/>
        <a:link id="transaction_refund_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_refund_detail_query.lview"/>


        <a:link id="transaction_writeoff_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_writeoff_detail_query.lview"/>

        <a:link id="transaction_refund_apply_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH801/csh_transaction_receipt_refund_query.lview"/>

        <a:link id="transaction_manual_allocation_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_allocation_detail.lview"/>
        <a:link id="transaction_manual_allocation_query_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_allocation_query.lview"/>
        <script><![CDATA[


        function csh301_transaction_query() {
            $('csh_transaction_receipt_maintain_result_ds').query();
        }

        function csh301_transaction_reset() {
            $('csh_transaction_receipt_maintain_query_ds').reset();
        }


        //收款退款
        function csh301_transaction_writeoff_refund() {
            debugger;
            var ds = $('csh_transaction_receipt_maintain_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请选择一条记录！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示！', '只能勾选一条记录！');
                return;
            }

            var record = records[0];
            var transaction_id = records[0].get('transaction_id');

            if (record.get('refund_status') =='APPROVED' || record.get('refund_status') =='APPROVING') {

                var win = new Leaf.Window({
                    id: 'transaction_writeoff_refund_winId',
                    url: $('transaction_writeoff_refund_link1').getUrl(),
                    params: {
                        winId: 'transaction_writeoff_refund_winId',
                        transaction_id: transaction_id
                    },
                    title: '收款退款',
                    width: 1000,
                    height: 250,
                    draggable: true
                });
                win.on('close', function () {
                    csh301_transaction_query();
                });
            }else{
                var can_return_amount = record.get('can_return_amount');

                if (can_return_amount == 0) {
                    Leaf.showMessage('提示！', '该笔收款无剩余可退款金额！');
                    return;
                }

                var win = new Leaf.Window({
                    id: 'transaction_writeoff_refund_winId',
                    url: $('transaction_writeoff_refund_link').getUrl(),
                    params: {
                        winId: 'transaction_writeoff_refund_winId',
                        transaction_id: transaction_id,
                        un_write_off_amount:record.get('un_write_off_amount')
                    },
                    title: '收款退款',
                    width: 1000,
                    height: 250,
                    draggable: true
                });
                win.on('close', function () {
                    csh301_transaction_query();
                });
            }

        }


        function write_off_detail_renderer(value, record, name) {

            var transaction_id = record.get('transaction_id');

            return '<a  href="#' + Math.random() + '" onclick="open_write_off_detail_window(' + transaction_id + ')">' + Leaf.formatMoney(value) + '</a>';
        }


        function open_write_off_detail_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_writeoff_detail_winId',
                url: $('transaction_writeoff_detail_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_detail_winId',
                    transaction_id: transaction_id
                },
                title: '核销明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });

        }

        function refund_detail_window_renderer(value, record, name) {
            var transaction_id = record.get('transaction_id');
            return '<a  href="#' + Math.random() + '" onclick="open_refund_detail(' + transaction_id + ')">' + Leaf.formatMoney(value) + '</a>';
        }

        function open_refund_detail(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_refund_detail_winId',
                url: $('transaction_refund_detail_link').getUrl(),
                params: {
                    winId: 'transaction_refund_detail_winId',
                    transaction_id: transaction_id
                },
                title: '退款明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }

        function refund_apply_renderer(value, record, name) {
            var transaction_id = record.get('transaction_id');
            return '<a  href="#' + Math.random() + '" onclick="open_refund_apply_window(' + transaction_id + ')">退款申请记录</a>';
        }

        function open_refund_apply_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_refund_apply_winId',
                url: $('transaction_refund_apply_link').getUrl(),
                params: {
                    winId: 'transaction_refund_apply_winId',
                    transaction_id: transaction_id
                },
                title: '退款申请记录查询',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });
        }


        function allocation_renderer(value, record, name) {
            var allocation_id_str = record.get('allocation_id_str');
            return '<a  href="#' + Math.random() + '" onclick="open_allocation_window(\'' + allocation_id_str + '\')">' + value + '</a>';
        }


        function open_allocation_window(allocation_id_str) {
            var win = new Leaf.Window({
                id: 'transaction_allocation_winId',
                url: $('transaction_manual_allocation_detail_link').getUrl(),
                params: {
                    allocation_id_str: allocation_id_str,
                    winId: 'transaction_allocation_winId'
                },
                title: '匹配结果查询',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh301_transaction_query();
            });


        }


        ]]></script>

        <a:dataSets>

            <a:dataSet id="payment_method_ds" lookupCode="CSH.PAYMENT_METHOD"/>
            <a:dataSet id="posted_flag_ds" lookupCode="CSH.POST_SELECT"/>
            <a:dataSet id="yes_no_ds" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="reversed_flag_ds" lookupCode="HLS_REVERSED_FLAG"/>
            <a:dataSet id="write_off_flag_ds" lookupCode="CON.CASHFLOW_WRITE_OFF_FLAG"/>
            <a:dataSet id="write_off_match_flag_ds" lookupCode="CON.WRITE_OFF_MATCH_FLAG"/>


            <a:dataSet id="csh_transaction_receipt_maintain_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="transaction_date_from"/>
                    <a:field name="transaction_date_to"/>
                    <a:field name="write_off_flag_n" displayField="code_value_name" options="write_off_flag_ds"
                             returnField="write_off_flag" valueField="code_value"/>
                    <a:field name="write_off_flag"/>
                    <a:field name="bp_name"/>
                    <a:field name="bank_inf"/>
                    <a:field name="role_id" defaultValue="${/session/@roleId}"/>
                    <a:field name="reversed_flag_n" displayField="code_value_name" options="yes_no_ds"
                             returnField="reversed_flag" valueField="code_value"/>
                    <a:field name="reversed_flag"/>
                    <a:field name="refund_flag_n" displayField="code_value_name" options="yes_no_ds"
                             returnField="refund_flag" valueField="code_value"/>
                    <a:field name="refund_flag"/>
                    <a:field name="isReFund" defaultValue="Y"/>
                    <a:field name="canReFund" defaultValue="Y"/>
                    <a:field name="transaction_type" defaultValue="ADVANCE_RECEIPT"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_maintain_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/detail/query?roleId=${/session/@roleId}"
                       queryDataSet="csh_transaction_receipt_maintain_query_ds"
                       selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                    <a:field name="creation_date"/>
                    <a:field name="bp_name"/>
                    <a:field name="transaction_num"/>
                    <a:field name="description"/>
                    <a:field name="bank_slip_num"/>
                    <a:field name="transaction_amount"/>
                    <a:field name="write_off_amount"/>
                    <a:field name="un_write_off_amount"/>
                    <a:field name="bank_account_name"/>
                    <a:field name="bank_name"/>
                    <a:field name="bank_account_num"/>
                    <a:field name="write_off_flag"/>
                    <a:field name="write_off_flag_desc"/>
                    <a:field name="match_status"/>
                    <a:field name="reversed_date" datatype="date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form bindTarget="csh_transaction_receipt_maintain_query_ds" labelWidth="100" marginWidth="50"
                    height="175">
                <a:screenTopToolbar>
                    <a:screenTitle/>
                    <a:gridButton click="csh301_transaction_query" text="HLS.QUERY"/>
                    <a:gridButton click="csh301_transaction_reset" text="HLS.RESET"/>
                    <a:gridButton click="csh301_transaction_writeoff_refund" text="发起收款退款申请"/>
                </a:screenTopToolbar>
                <a:fieldSet column="4" labelWidth="100" title="HLS.QUERY_TITLE">
                    <a:textField name="transaction_num" bindTarget="csh_transaction_receipt_maintain_query_ds"
                                 prompt="收款编号"/>
                    <a:comboBox name="write_off_flag_n"
                                bindTarget="csh_transaction_receipt_maintain_query_ds"
                                prompt="核销状态"/>
                    <a:datePicker name="transaction_date_from"
                                  bindTarget="csh_transaction_receipt_maintain_query_ds"
                                  prompt="收款日期从"/>
                    <a:datePicker name="transaction_date_to"
                                  bindTarget="csh_transaction_receipt_maintain_query_ds"
                                  prompt="收款日期到"/>
                    <a:numberField name="transaction_amount_from"
                                   bindTarget="csh_transaction_receipt_maintain_query_ds"
                                   prompt="收款金额从"/>
                    <a:numberField name="transaction_amount_to"
                                   bindTarget="csh_transaction_receipt_maintain_query_ds"
                                   prompt="收款金额到"/>
                   <!-- <a:comboBox name="refund_flag_n"
                                bindTarget="csh_transaction_receipt_maintain_query_ds"
                                prompt="是否退款"/>-->



                    <a:numberField name="un_write_off_amount_from"
                                   bindTarget="csh_transaction_receipt_maintain_query_ds"
                                   prompt="未核销金额从"/>
                    <a:numberField name="un_write_off_amount_to"
                                   bindTarget="csh_transaction_receipt_maintain_query_ds"
                                   prompt="未核销金额到"/>
                    <a:textField name="bp_name" bindTarget="csh_transaction_receipt_maintain_query_ds"
                                 prompt="收款对象"/>
                </a:fieldSet>
            </a:form>

            <a:grid id="csh_transaction_receipt_maintain_grid_ds"
                    bindTarget="csh_transaction_receipt_maintain_result_ds" height="500"
                    marginWidth="50"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="transaction_num" prompt="收款编号" width="120"
                              renderer="allocation_renderer"/>
                    <a:column name="refund_flag_n" prompt="是否退款" align="center" width="80"/>
                    <a:column name="advance_csh_trx_id" prompt="退款申请记录" align="center" width="100"
                              renderer="refund_apply_renderer"/>
                    <a:column name="refund_status_desc" prompt="退款申请审批状态" width="120"/>
                    <a:column name="frozen_amount" prompt="冻结金额" align="right"
                             width="100"/>
                    <a:column name="refund_amount" prompt="已退款金额" align="right"
                              renderer="refund_detail_window_renderer" width="100"/>
                    <a:column name="write_off_flag_desc" prompt="核销状态" width="100"/>
                    <a:column name="transaction_date" align="center" prompt="收款日期" width="100"
                              renderer="Leaf.formatDate"/>
                    <a:column name="bp_name" prompt="收款对象" width="200"/>
                    <a:column name="contract_number" prompt="合同编号" width="200"/>
                    <a:column name="contract_name" prompt="合同名称" width="200"/>

                 <!--   <a:column name="import_date" align="center" prompt="导入日期" width="150"
                              renderer="Leaf.formatDate"/>-->
                    <a:column name="transaction_amount" prompt="收款金额" renderer="Leaf.formatMoney"
                              align="right"
                              width="120"/>
                    <a:column name="write_off_amount" prompt="已核销金额"
                              align="right" renderer="write_off_detail_renderer"
                              width="120"/>
                    <a:column name="is_allocation_flag" prompt="是否已匹配待确认" align="center" width="100"/>
                    <a:column name="un_write_off_amount" prompt="剩余可核销/退款金额"
                              align="right" renderer="Leaf.formatMoney"
                              width="120"/>
                    <a:column name="bank_account_name" prompt="入账户名" width="200"/>
                    <a:column name="bank_account_num" prompt="入账账号" width="200"/>
                    <a:column name="bank_branch_name" prompt="入账银行" width="250"/>
                    <a:column name="bank_slip_num" prompt="银行收款流水号" width="120"/>
                    <a:column name="description" prompt="摘要" width="200"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
