<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月28日
    $Revision: 1.0  
    $Purpose: 收款退款
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>

        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>

        <script type="text/javascript"><![CDATA[
        function csh801_refund_return() {
            $('${/parameter/@winId}').close();
        }

        function refund_detail_renderer(value, record, name) {
            return '<a href="javascript:winOpen_detail(\'' + record.get('refund_id') + '\');">' + value + '</a>';
        }



        function winOpen_detail(refund_id) {
            var win = new Leaf.Window({
                id: 'csh_transaction_refund_ln_winid',
                url: '${/request/@context_path}/modules/CSH/CSH_TRX/CSH801/csh_transaction_receipt_refund_ln.lview',
                params: {
                    winid: 'csh_transaction_refund_ln_winid',
                    refund_id: refund_id
                },
                title: '退款申请明细',
                width: 1150,
                height: 600
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="csh_transaction_receipt_refund_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="transaction_id" defaultValue="${/parameter/@transaction_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_refund_result_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/refund/query"
                       queryDataSet="csh_transaction_receipt_refund_query_ds">
                <a:fields>
                    <a:field name="refund_date" datatype="date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh801_refund_return" text="退出"/>
            </a:screenTopToolbar>
            <a:grid bindTarget="csh_transaction_receipt_refund_result_ds" height="500"
                    marginWidth="50"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="refund_number" prompt="退款申请编号" width="120" renderer="refund_detail_renderer"/>
                    <a:column name="refund_status_desc" prompt="退款申请状态" width="100"/>
                    <a:column name="refund_date" prompt="退款日期" align="center" renderer="Leaf.formatDate" width="100"/>
<!--
                    <a:column name="period_number" prompt="会计期间" align="center" width="80"/>
-->
                    <a:column name="refund_amount" prompt="退款金额" align="right" renderer="Leaf.formatMoney" width="120"/>
                    <!--<a:column name="bank_account_name" prompt="退款账户" width="120"/>
                    <a:column name="bank_account_num" prompt="退款账号" width="120"/>-->
                    <a:column name="currency_name" prompt="币种" width="80"/>
                    <!--<a:column name="bank_slip_num" prompt="银行流水号" width="100"/>-->
                    <a:column name="bp_bank_account_name" prompt="对方账户" width="200"/>
                    <a:column name="bp_bank_account_num" prompt="对方账号" width="150"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>

