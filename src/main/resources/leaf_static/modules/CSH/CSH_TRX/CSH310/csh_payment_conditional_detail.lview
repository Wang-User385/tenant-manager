<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        // Leaf.onReady(function () {
        //隐藏可选框
        // document.getElementsByClassName('grid-la')[0].hidden = true;
        // });

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //debugger;
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
                var records = $(ds_id).getSelected();
                var recArr = [];
                for (var i = 0; i < records.length; i++) {
                    var approvalFlag = records[i].get('approval_flag');
                    if (approvalFlag == 'NEW' || approvalFlag == 'APPROVED_RETURN') {
                        var conditionId = records[i].get('credit_condition_id');
                        recArr.push(conditionId);
                    } else {
                        Leaf.showMessage('提示', '请选择未申请或退回的付款条件申请豁免！');
                        return false;
                    }
                }
                if (recArr.length != 0) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '确定提交申请?', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/csh/condition/exempt/wfl',
                            para: {
                                rec_arr: recArr
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $L.showInfoMessage("提示", "提交审批成功!", function () {
                                    $(ds_id).query();
                                    // $('${/parameter/@winid}').close();
                                });
                            },
                            error: function (res) {
                                $L.showInfoMessage("提示", "提交审批失败,请联系管理员!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function (res) {
                                $L.showInfoMessage("提示", "提交审批失败,请联系管理员!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    })
                } else {
                    Leaf.showMessage('提示', '请至少选择一条付款条件申请豁免！');
                    return false;
                }
            })
        };

        // window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {debugger;
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
        //     if(ds_id == ds.id && ds.id){
        //         if(record.isNew){
        //             record.getField('condition').setReadOnly(true);
        //             // record.getField('condition').setRequired(true);
        //         }
        //     }
        // };


        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            var cshRec = $(ds_id).getAll();
            if (ds_id == ds.id && ds_id) {
                // for(var i=0;i<cshRec.length;i++){
                //     if (cshRec[i].get('approval_flag') != 'NEW') {
                //         cshRec[i].getField('condition').setReadOnly(true);
                //     }
                // }
                if(record){
                    if (record.get('approval_flag') !== 'NEW') {
                        record.getField('condition').setReadOnly(true);
                        record.getField('exemption_cause').setReadOnly(true);
                    }
                    if(record.get('add_flag') === 'N'){}
                    record.getField('condition').setReadOnly(true);
                }
            }
        };
        //查询时调用 form
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, record, config_records, bp_seq) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if (ds.id && ds_id == ds.id) {
                if ('${/parameter/@winid}' == 'csh_condition_exempt_win_id') {
                    // var list = '${/parameter/@list}';
                    // var array = list.split(",");
                    // ds.setQueryParameter('list', array);
                }
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if (ds.id && ds_id == ds.id) {
                record.set('add_flag', 'Y');
            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_G_CONDITION_USER_BUTTON1_layout_dynamic_tab_click'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            var records = $(ds_id).getSelected();
            var recArr = [];
            for (var i = 0; i < records.length; i++) {
                var add_flag = records[i].get('add_flag');
                var approval_flag = records[i].get('approval_flag');
                if (add_flag == 'N') {
                    Leaf.showMessage('提示', '存在不是新建的条件，无法删除');
                    return false;
                }
                if (approval_flag != 'NEW') {
                    Leaf.showMessage('提示', '存在不是未申请的条件，无法删除');
                    return false;
                }
                records[i].set('__status', 'delete');
                recArr.push(records[i].data);
            }
            Leaf.request({
                url: '${/request/@context_path}/prj/project/credit/condition/submit',
                para: recArr,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '操作成功',
                        duration: 2000
                    });
                    $(ds_id).query();
                },
                scope: this
            });

        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            // if (ds.id && ds_id == ds.id) {
            $(ds_id).query();
            // }
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
