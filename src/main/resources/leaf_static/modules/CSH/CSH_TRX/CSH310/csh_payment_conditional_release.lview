<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="csh310_project_detail_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH310/csh_payment_conditional_detail.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id).getSelected();
            if(record.length == 0){
                Leaf.showMessage('提示','请至少选择一条记录！');
                return;
            }else if (record.length > 1){
                Leaf.showMessage('提示','至多选择一条记录！');
                return;
            }
            var param = record[0].data;
            param['url_title'] = '提交申请明细';
            param['winid'] = 'project_detail_winid';
            param['function_code'] = 'CSH310F1';
            hls_doc_get_layout_code(param, 'csh310_project_detail_id', ds_id, 'CSH310F1');

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
