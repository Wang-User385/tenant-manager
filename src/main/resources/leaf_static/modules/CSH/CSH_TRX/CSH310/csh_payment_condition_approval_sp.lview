<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh_condition_exempt_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH310/csh_payment_conditional_detail_wfl.lview"/>

        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;

        // var creditConditionIds = parent.currentTaskInfo.execution_variables.filter(function (o) {
        //     return o.name == "creditConditionIds";
        // });

        var creditConditionIds = param.filter(function (o) {
            return o.name === "creditConditionIds";
        })[0].value;

        debugger;
        var pageChooser = new PageChooser({
            url: $('csh_condition_exempt_id').getUrl(),
            function_code: 'CSH310WFL',
            context_path: '${/request/@context_path}',
            opt: {
                project_id: businessKey,
                list: creditConditionIds,
                winid: 'csh_condition_exempt_win_id'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
