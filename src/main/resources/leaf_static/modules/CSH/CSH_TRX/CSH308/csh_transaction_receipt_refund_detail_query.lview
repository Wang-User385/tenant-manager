<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2022年3月1日
    $Revision: 1.0
    $Purpose: 退款明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function csh301_transaction_refund_return() {
            $('${/parameter/@winId}').close();
        }

        ]]></script>
        <a:dataSets>

            <a:dataSet id="csh_transaction_receipt_refund_query_ds">
                <a:fields>
                    <a:field name="transaction_id" defaultValue="${/parameter/@transaction_id}"/>
                    <a:field name="source_transaction_id" defaultValue="${/parameter/@source_transaction_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receipt_refund_result_ds" autoQuery="true" loadData="true"
                       queryUrl="${/request/@context_path}/csh/transaction/refund/query"
                       queryDataSet="csh_transaction_receipt_refund_query_ds">
                <a:fields>
                    <a:field name="refund_date" datatype="java.util.Date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="csh301_transaction_refund_return" text="HLS.RETURN"/>
            </a:screenTopToolbar>
            <a:grid id='csh_transaction_receipt_refund_detail_grid_id'
                    bindTarget="csh_transaction_receipt_refund_result_ds" marginHeight="70" marginWidth="10"
                    navBar="true">
                <a:columns>
                    <!--<a:column name="refund_number" prompt="退款申请编号" width="120" renderer="refund_detail_renderer"/>-->
                    <a:column name="transaction_num" prompt="现金事务编号" width="120"/>
                    <a:column name="refund_date" prompt="退款日期" renderer="Leaf.formatDate" width="100"/>
                    <a:column name="refund_amount" prompt="退款金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="bank_account_name" prompt="退款账户" width="150"/>
                    <a:column name="bank_account_num" prompt="退款账号"  width="120"/>
                    <a:column name="bank_slip_num" prompt="银行流水" width="120"/>
                    <a:column name="bp_name" prompt="商业伙伴名称" width="200"/>
                    <a:column name="bp_bank_account_name" prompt="对方账户" width="200"/>
                    <a:column name="bp_bank_account_num" prompt="对方账号" width="150"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
