<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="csh1001_csh_deposit_pay_detail_approve_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH1001/deposit_manage_hd_pay_detail.lview"/>
        <script><![CDATA[
        console.log(parent.currentTaskInfo.process_instance);
        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;
        if (!businessKey) {
            businessKey = param.filter(function (o) {
                return o.name == "businessKey";
            })[0].value;
        }
        var projectId = param.filter(function (o) {
            return o.name == "projectId";
        })[0].value;

        var function_code = 'CSH1001F2',link_url= $('csh1001_csh_deposit_pay_detail_approve_id').getUrl();

        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';

        var pageChooser = new PageChooser({

            url: link_url,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                function_code: function_code,
                maintain_type: maintain_type,
                function_usage: function_usage,
                manage_hd_id:businessKey,
                project_id:projectId
            },
            success: function (realUrl) {
                debugger;
                location.href = realUrl;
            }
        });

        /*附件超链接渲染*/
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function;
            console.log(name)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'upload') {
                link_function = '${/parameter/@layout_code}_attachment_detail';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + config_record.get('prompt') + '</a>';
            }
        };

        /*附件上传超链接函数*/
        window['${/parameter/@layout_code}_attachment_detail'] = function (record_id, name) {

            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];

            if (record.get('deposit_attachment_id')) {
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY') {

                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';

                }
                var win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('deposit_attachment_id'),
                        table_name: 'csh_deposit_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_deposit_attachment');
                    $(ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
