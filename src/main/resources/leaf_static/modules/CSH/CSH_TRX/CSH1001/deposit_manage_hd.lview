                    <a:gridButton bind="DepositManageHd_grid_id" type="refresh"/>
                </a:screenTopToolbar>
                <a:grid id="DepositManageHd_grid_id" bindTarget="DepositManageHd_ds" marginHeight="140"
                        marginWidth="50" navBar="true">
                    <a:columns>
                                <a:column name="MANAGE_NUMBER" align="right" autoAdjust="true"
                                          prompt="DepositManageHd.MANAGE_NUMBER" editor="DepositManageHd_grid_textfield"/>
