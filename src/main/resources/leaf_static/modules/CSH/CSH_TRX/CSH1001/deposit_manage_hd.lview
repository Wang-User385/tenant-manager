<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="${/parameter/@layout_code}_fin006_lon_contract_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <a:link id="${/parameter/@layout_code}_con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_rent_payment_confirm_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_payment_confirm_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_entrance_confirm_detail_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH1001/deposit_manage_hd_entrance.lview"/>
        <a:link id="${/parameter/@layout_code}_entrance_change_detail_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH1001/deposit_manage_hd_change_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_entrance_pay_detail_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH1001/deposit_manage_hd_pay_detail.lview"/>
        <script><![CDATA[

        //方案创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var param = {};
            param['url_title'] = '方案创建';
            param['function_code'] = 'CSH1001F1';
            // param['function_usage'] = 'CREATE';
            param['winid'] = '${/parameter/@layout_code}_entrance_confirm_create';
            param['screen_width'] = '600';
            param['screen_height'] = '350';

            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_deposit_manage_hd');
            param['csh1001_dsid'] = pledge_ds_id;

            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_entrance_confirm_detail_link_id', pledge_ds_id, 'CSH1001');
        }

        var hlsCusHlsCreditLineChances=[];
        //删除
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_deposit_manage_hd');
            var chanceRecord = $(ds_id).getSelected();

            var closeFlag = 'Y';
            if(chanceRecord.length != 0 ){
                // debugger;
                for (var i=0;i<chanceRecord.length;i++){
                    if(chanceRecord[i].data.execution_result == 'NEW' ){
                        hlsCusHlsCreditLineChances.push(chanceRecord[i].data);
                    }else{
                        closeFlag='N';
                    }

                }
            }

            if(chanceRecord.length == 0){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示','请选择需要删除的项目!');

            }else if(closeFlag == 'N'){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示','非新建状态的单据，无法删除!')
            }else {

                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认删除吗?', function okFun() {
                    Leaf.request({
                        url: '${/request/@context_path}/csh/deposit/manage/hd/remove',
                        para:  hlsCusHlsCreditLineChances,

                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                });

            }

        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //alert(name);
            var link_function = 'fin006f1_lon_contract_withdraw_detail';
            if(name == 'manage_number'&&value){
                link_function = 'fin006f1_lon_contract_withdraw_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
            if(name == 'contract_name'&&value){
                link_function = 'open_contract_detail_win';//'fin006f1_lon_contract_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
            if(name == 'upload_download' && record.get('invoice_id')){
                link_function = 'fin006f1_lon_contract_invoice_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">上传/下载</a>';
            }

            //window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number'&&value) {
                link_function = 'open_contract_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
        };
        function fin006f1_lon_contract_withdraw_detail(ds_id,record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data,link_id='';
            param['function_usage'] = 'CREATE';
            param['winid'] = '${/parameter/@layout_code}_deposit_create_winid';
            param['parent_winid'] = 'csh1001_deposit_manage_hd_id';
            param['default_value_dsid'] = ds_id;
            param['url_title'] = '方案创建';

            if (record.get('handling_method') == '0') {//保证金代付期中租金
                param['function_code'] = 'CSH1001F2';
                link_id = '${/parameter/@layout_code}_entrance_pay_detail_link_id';
            } else if(record.get('handling_method') == '1' || record.get('handling_method') == '2' || record.get('handling_method') == '3') {//保证金处理方式变更
                param['function_code'] = 'CSH1001F3';
                link_id = '${/parameter/@layout_code}_entrance_change_detail_link_id';
            }else{
                Leaf.showInfoMessage("提示", "保证金处理方式错误，请重新选择!", null);
                return;
            }

            if (param['execution_result'] !== 'NEW' && param['execution_result'] !== 'APPROVED_RETURN'/*&& param['execution_result'] !== 'REJECTED'*/&& param['execution_result'] !== 'CANCEL') {
                param['hidden_button_code'] = ['save', 'submit_approval'];
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                if(record.get('handling_method') == '1' || record.get('handling_method') == '2' || record.get('handling_method') == '3') {//保证金处理方式变更
                    param['function_code'] = 'CSH1001F4';
                }
                if (record.get('handling_method') == '0') {//保证金代付期中租金
                    param['function_code'] = 'CSH1001F2_QUERY';
                }
            }

            hls_doc_get_layout_code(param, link_id, ds_id, '${/parameter/@layout_code}');
        }


        //支付表确认详情
        function open_contract_detail_win(record_id, ds_id) {
            alert(111);
            debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '支付表确认详情';
            param['function_code'] = 'CONT306F2';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';

            if (param['status'] !== 'NEW' && param['status'] !== 'APPROVED_RETURN'&& param['status'] !== 'REJECTED'&& param['status'] !== 'CANCEL') {
                param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['function_code'] = 'CONT306F2';
            }
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_rent_payment_confirm_detail_link_id', ds_id, 'CONT301');
        }

        //合同明细
        function fin006f1_lon_contract_detail(ds_id,record_id){
            var record2 = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '融资合同明细';
            var contract_status = record2.get('settle_status_desc');
            param['function_code'] = 'FIN003F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['contract_id'] = record2.get('contract_id');
            param['document_id'] = record2.get('contract_id');
            param['company_id'] = '${/session/@companyId}';
            // param['layout_debugger_flag'] = 'Y';

            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_fin006_lon_contract_id', ds_id, 'FIN006');
        }


        function open_contract_detail_win(ds_id,record_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';
//            debugger;
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc', 'quotation_calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['function_code'] = 'CONT301F1';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_con_contract_detail_id', ds_id, 'CONT301');
            /*if (param['purchase_frame'] == 'Y') {
                if (('${/parameter/@function_code}' == 'CONT301F15') || (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN' && param['contract_status'] !== 'REJECTED')) {
                    param['maintain_type'] = 'READONLY';
                    param['function_usage'] = 'QUERY';
                    param['function_code'] = 'CONT301F1K';


                } else {
                    param['maintain_type'] = 'MODIFY';
                    param['function_usage'] = 'MODIFY';
                    param['function_code'] = 'CONT301F1K';
                }
                hls_doc_get_layout_code(param, 'con_contract_detail_frame_id', ds_id, 'CONT301');

            } else {
                if (('${/parameter/@function_code}' == 'CONT301F15') || (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN' && param['contract_status'] !== 'REJECTED')) {

                    param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc', 'quotation_calc'];


                    param['maintain_type'] = 'READONLY';
                    param['function_usage'] = 'QUERY';
                    param['function_code'] = 'CONT301F1';
                } else {
                    param['maintain_type'] = 'MODIFY';
                    param['function_usage'] = 'MODIFY';
                    param['function_code'] = 'CONT301F1';
                }
                hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');

            }*/
        }

        ]]></script>
        <!--    <a:dataSets>
