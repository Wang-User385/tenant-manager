<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="transaction_query_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_query.lview"/>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="transaction_writeoff_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_writeoff_detail_query.lview"/>
        <a:link id="transaction_refund_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_refund_detail_query.lview"/>
        <a:link id="transaction_deduction_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH303/csh_deposit_deduction.lview"/>
        <a:link id="transaction_refund_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH303/csh_deposit_refund.lview"/>

        <a:link id="download_link_id"
                url="${/request/@context_path}/atm_download.lsc"/>


        <script type="text/javascript"><![CDATA[

        var index_select = 'DEPOSIT';
        var WRITE_OFF_TYPE = 'DEPOSIT_CREDIT';

        function before_select_event(tabPanel, index, tab) {
            if (index === 0) {
                index_select = 'DEPOSIT';
                WRITE_OFF_TYPE = 'DEPOSIT_CREDIT';
            } else if (index === 1) {
                index_select = 'DEPOSIT_POOL';
                WRITE_OFF_TYPE = 'DEPOSIT_POOL_CREDIT';
            }
        }

        function csh303_deposit_query() {
            if (index_select == 'DEPOSIT') {
                $('csh_deposit_result_ds').query();
            } else if (index_select == 'DEPOSIT_POOL') {
                $('csh_deposit_pool_result_ds').query();
            }
        }

        function csh303_deposit_reset() {
            if (index_select == 'DEPOSIT') {
                $('csh_deposit_query_ds').reset();
            } else if (index_select == 'DEPOSIT_POOL') {
                $('csh_deposit_pool_query_ds').reset();
            }

        }

        function contract_number_renderer(value, record, name) {
            if (name = 'contract_number') {
                var contract_id = record.get('deposit_contract_id');
                var link_function = 'open_contract_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + contract_id + '\');">' + value + '</a>';
            }

        }

        function open_contract_detail_win(record_id, ds_id, contract_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细查询';
            param['function_code'] = 'CONT301F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['hidden_button_code'] = ['exit', 'save', 'user_button1', 'user_button2'];
            param['winid'] = 'con_contract_detail_winid';
            param['contract_id'] = contract_id;
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');

        }

        function transaction_num_renderer(value, record, name) {
            var transaction_id = record.get('transaction_id');
            if (transaction_id) {
                return '<a href="javascript:recepit_query_window(' + transaction_id + ')">' + value + '</a>';
            } else {
                return '';
            }
        }

        function recepit_query_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_query_winId',
                url: $('transaction_query_link').getUrl(),
                params: {
                    winId: 'transaction_query_winId',
                    transaction_id: transaction_id
                },
                title: '收款查询',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });
        }

        function write_off_detail_renderer(value, record, name) {

            var transaction_id = record.get('transaction_id');
            return '<a  href="#' + Math.random() + '" onclick="open_write_off_detail_window(' + transaction_id + ')">' + Leaf.formatMoney(value) + '</a>';
        }


        function open_write_off_detail_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_writeoff_detail_winId',
                url: $('transaction_writeoff_detail_link').getUrl(),
                params: {
                    winId: 'transaction_writeoff_detail_winId',
                    transaction_id: transaction_id
                },
                title: '核销明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });

        }

        function refund_detail_renderer(value, record, name) {
            var transaction_id = record.get('transaction_id');
            return '<a  href="#' + Math.random() + '" onclick="open_refund_detail_window(' + transaction_id + ')">' + Leaf.formatMoney(value) + '</a>';
        }

        function open_refund_detail_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_refund_detail_winId',
                url: $('transaction_refund_detail_link').getUrl(),
                params: {
                    winId: 'transaction_refund_detail_winId',
                    source_doc_id: transaction_id
                },
                title: '退款明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });
        }

        function deduction_renderer(value, record, name) {
            var contract_id = record.get("contract_id");
            return '<a  href="#' + Math.random() + '" onclick="open_deduction_window(' + value + ',' + contract_id + ')">抵扣</a>';
        }

        function open_deduction_window(transaction_id, contract_id) {

            var win = new Leaf.Window({
                id: 'transaction_deduction_winId',
                url: $('transaction_deduction_link').getUrl(),
                params: {
                    winId: 'transaction_deduction_winId',
                    transaction_id: transaction_id,
                    contract_id: contract_id,
                    write_off_type: WRITE_OFF_TYPE
                },
                title: '抵扣',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });
        }

        function refund_renderer(value, record, name) {
            return '<a  href="#' + Math.random() + '" onclick="open_refund_window(' + value + ')">退款</a>';
        }

        function open_refund_window(transaction_id) {
            var win = new Leaf.Window({
                id: 'transaction_refund_winId',
                url: $('transaction_refund_link').getUrl(),
                params: {
                    winId: 'transaction_refund_winId',
                    transaction_id: transaction_id
                },
                title: '退款',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });
        }

        function csh303_deposit_refund() {
            var ds = $('csh_deposit_result_ds');
            var records = ds.getSelected();

            if (records.length == 0) {
                Leaf.showMessage('提示', '未选择一条数据！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示', '请选择一条记录！');
                return;
            }
            var transaction_id = records[0].get('transaction_id');

            var win = new Leaf.Window({
                id: 'transaction_refund_winId',
                url: $('transaction_refund_link').getUrl(),
                params: {
                    winId: 'transaction_refund_winId',
                    transaction_id: transaction_id
                },
                title: '退款',
                width: 800,
                height: 450,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });

        }

        function csh303_deposit_deduction() {
            var ds = $('csh_deposit_result_ds');
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '未选择一条数据！');
                return;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示', '请选择一条记录！');
                return;
            }
            var transaction_id = records[0].get('transaction_id');
            var contract_id = records[0].get('contract_id');

            var win = new Leaf.Window({
                id: 'transaction_deduction_winId',
                url: $('transaction_deduction_link').getUrl(),
                params: {
                    winId: 'transaction_deduction_winId',
                    transaction_id: transaction_id,
                    contract_id: contract_id,
                    write_off_type: WRITE_OFF_TYPE
                },
                title: '抵扣',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh303_deposit_query();
            });
        }


        function test_sharing() {

            //var record = $('csh_deposit_result_ds').getAt(0);

            var removeData = [{
                "contract_id": "41"
            }];
            /*record.set('contract_id', '-1');
            record.set('share_type', 'COST_PROPORTION');
            record.set('biz_type', 'LEASE');
            record.set('cf_item', '3');
            removeData.push(record.data);*/

            /*
            record.set('contract_id', '13');
            record.set('share_type', 'INTEREST_STRAIGHT');
            record.set('biz_type', 'LEASE');
            record.set('cf_item', '1');*/



            //removeData.push(record.data);

            Leaf.request({
                url: '${/request/@context_path}/gld/finance/income/sharing',
                para: removeData,
                success: function (res) {

                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        function doExport() {
            var down_url = $('download_link_id').getUrl();

            var saveData = [{
                "sheetName": "sheet1,sheet2,sheet3",
                "downFileName": "导出.xlsx",
                "excelType": "DEPOSIT"
            }];
            var ds = $('csh_deposit_result_ds');
            var records = ds.getSelected();
            var export_list;
            for (var i = 0; i < records.length; i++) {
                if(export_list){
                    export_list = export_list + "," + records[i].data.contract_id;
                }else{
                    export_list = records[i].data.contract_id;
                }
            }

            //location.href = "${/request/@context_path}/excel/export?excelType=DEPOSIT&tableName=EXCEL_EXPORT&ids=" + export_list;
            location.href = "${/request/@context_path}/excel/export?excelType=DEPOSIT" ;

           /* Leaf.request({
                url: '${/request/@context_path}/excel/export',
                para: saveData,
                success: function (res) {

                },
                scope: this
            });*/
            //Leaf.go(down_url + '?attachment_id=' + 672);
        }


        function et_calc(){
            var data = {};
            data.config = [{
                field: 'ccr_fee',
                force: 'Y',
                value: 22
            }, {
                field: 'ccr_outstanding_times',
                force: 'Y',
                value: 1
            }, {
                field: 'ccr_start_times',
                force: 'Y',
                value: 3
            }];
            data.price_list = 'General_Calculator_PMT';
            Leaf.request({
                url: '${/request/@context_path}/hls/duration/et/calculate?hdId=' + 8,
                para: data,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });

                },
                failure: function () {

                },
                error: function () {

                },
                scope: this
            });



        }
        ]]></script>

        <a:dataSets>
            <a:dataSet id="contract_status_ds" lookupCode="CON.CONTRACT_STATUS"/>
            <a:dataSet id="csh_deposit_query_ds">
                <a:fields>
                    <a:field name="contract_status_desc" options="contract_status_ds" displayField="code_value_name"
                             returnField="contract_status" valueField="code_value" prompt="合同状态"/>
                    <a:field name="reversed_flag" defaultValue="N"/>
                    <a:field name="transaction_type" defaultValue="DEPOSIT"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_deposit_result_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/query" queryDataSet="csh_deposit_query_ds"
                       selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="csh_deposit_pool_query_ds">
                <a:fields>
                    <a:field name="reversed_flag" defaultValue="N"/>
                    <a:field name="transaction_type" defaultValue="DEPOSIT_POOL"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_deposit_pool_result_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/transaction/query"
                       queryDataSet="csh_deposit_pool_query_ds" selectable="true">
                <a:fields>
                    <a:field name="transaction_date" datatype="date"/>
                </a:fields>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh303_deposit_query" text="HLS.QUERY"/>
                <a:gridButton click="csh303_deposit_reset" text="HLS.RESET"/>
                <a:gridButton click="test_sharing" text="测试收益分摊"/>
                <a:gridButton click="doExport" text="测试合并单元格导出"/>
                <a:gridButton click="et_calc" text="测试提前结清计算"/>
            </a:screenTopToolbar>

            <a:tabPanel marginWidth="20" marginHeight="25">
                <a:tabs>
                    <a:tab prompt="合同保证金" width="130" selected="true">
                        <a:form column="4" labelWidth="100">
                            <a:textField name="deposit_contract_name" bindTarget="csh_deposit_query_ds"
                                         prompt="合同名称" width="160"/>
                            <a:textField name="deposit_contract_number_from" bindTarget="csh_deposit_query_ds"
                                         prompt="合同编号从" width="160"/>
                            <a:textField name="deposit_contract_number_to" bindTarget="csh_deposit_query_ds"
                                         prompt="合同编号到" width="160"/>
                            <a:textField name="bp_name" bindTarget="csh_deposit_query_ds"
                                         prompt="客户名称" width="160"/>
                            <a:comboBox name="contract_status_desc" bindTarget="csh_deposit_query_ds" width="160"
                                        prompt="合同状态"/>
                            <a:datePicker name="transaction_date_from" bindTarget="csh_deposit_query_ds"
                                          prompt="收款日期从" width="160"/>
                            <a:datePicker name="transaction_date_to" bindTarget="csh_deposit_query_ds"
                                          prompt="收款日期到" width="160"/>
                            <!--  <a:numberField name="transaction_amount_from" bindTarget="csh_deposit_query_ds"
                                           prompt="收款金额从" width="160"/>
                            <a:numberField name="transaction_amount_to" bindTarget="csh_deposit_query_ds"
                                           prompt="收款金额到" width="160"/>-->
                        </a:form>
                        <a:grid id="csh_deposit_grid_id"
                                bindTarget="csh_deposit_result_ds" marginHeight="200" marginWidth="80"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <!--<a:column name="guarantor_bp_name" prompt="担保人名称" width="200"/>-->
                                <a:column name="deposit_contract_number" prompt="合同编号"
                                          width="120" group="true"/>
                                <a:column name="deposit_contract_name" prompt="合同名称" width="300"/>
                                <!--<a:column name="contract_seq_num" prompt="报价编号" width="120"/>-->
                                <a:column name="contract_status_desc" prompt="合同状态" width="80"/>
                                <!--<a:column name="transaction_num" prompt="现金事务编号" width="120"
                                            renderer="transaction_num_renderer"/>-->
                                <a:column name="bp_name" prompt="客户名称" width="200"/>
                                <a:column name="cf_item_desc" prompt="现金流项目" width="80"/>
                                <a:column name="due_amount" prompt="现金流金额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="130"/>
                                <a:column name="can_return_amount" prompt="余额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="130"/>

                                <a:column name="pre_occupy_amount" prompt="预占用金额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="130"/>
                                <!--<a:column name="transaction_date" align="center" prompt="收款日期" width="100"
                                          renderer="Leaf.formatDate"/>-->
                                <!--<a:column name="currency_n" prompt="币种" width="80"/>-->
                                <a:column name="sum_write_off_amount" prompt="已冲抵金额"
                                          renderer="write_off_detail_renderer"
                                          align="right"
                                          width="130"/>
                                <a:column name="return_write_off_amount" prompt="已返还金额"
                                          renderer="refund_detail_renderer"
                                          align="right"
                                          width="130"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--<a:tab prompt="保证金池" width="130">
                        <a:form column="4" labelWidth="100">
                            <a:textField name="bp_name" bindTarget="csh_deposit_pool_query_ds"
                                         prompt="承租人名称" width="160"/>
                            <a:textField name="bp_code" bindTarget="csh_deposit_pool_query_ds"
                                         prompt="承租人编号" width="160"/>
                            <a:datePicker name="transaction_date_from" bindTarget="csh_deposit_pool_query_ds"
                                          prompt="收款日期从" width="160"/>
                            <a:datePicker name="transaction_date_to" bindTarget="csh_deposit_pool_query_ds"
                                          prompt="收款日期到" width="160"/>
                            <a:numberField name="transaction_amount_from" bindTarget="csh_deposit_pool_query_ds"
                                           prompt="收款金额从" width="160"/>
                            <a:numberField name="transaction_amount_to" bindTarget="csh_deposit_pool_query_ds"
                                           prompt="收款金额到" width="160"/>
                            <a:numberField name="transaction_num_from" bindTarget="csh_deposit_pool_query_ds"
                                           prompt="现金事务编号从" width="160"/>
                            <a:numberField name="transaction_num_to" bindTarget="csh_deposit_pool_query_ds"
                                           prompt="现金事务编号到" width="160"/>
                        </a:form>
                        <a:grid id="csh_deposit_pool_grid_id"
                                bindTarget="csh_deposit_pool_result_ds" marginHeight="200" marginWidth="80"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="承租人名称" width="200"/>
                                <a:column name="bp_code" prompt="承租人编号" width="120"/>
                                <a:column name="transaction_num" prompt="现金事务编号" width="120"
                                          renderer="transaction_num_renderer"/>
                                <a:column name="transaction_date" align="center" prompt="收款日期" width="100"
                                          renderer="Leaf.formatDate"/>
                                <a:column name="transaction_amount" prompt="收款金额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="150"/>
                                <a:column name="currency_n" prompt="币种" width="80"/>
                                <a:column name="sum_write_off_amount" prompt="已核销金额"
                                          renderer="write_off_detail_renderer"
                                          align="right"
                                          width="150"/>
                                <a:column name="return_write_off_amount" prompt="已退款金额"
                                          renderer="refund_detail_renderer"
                                          align="right"
                                          width="150"/>
                                <a:column name="can_return_amount" prompt="可退金额" renderer="Leaf.formatMoney"
                                          align="right"
                                          width="150"/>
                                <a:column name="transaction_id" prompt="抵扣" renderer="deduction_renderer"
                                          align="center" width="80"/>
                                <a:column name="transaction_id" prompt="退款" renderer="refund_renderer"
                                          align="center" width="80"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>-->
                </a:tabs>
                <a:events>
                    <a:event name="beforeselect" handler="before_select_event"/>
                </a:events>
            </a:tabPanel>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>


