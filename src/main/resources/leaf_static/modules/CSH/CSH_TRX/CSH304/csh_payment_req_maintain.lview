<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>

        <a:link id="sig001_project_modify_maintain_id"
                url="${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F1/sig_project_modify.lview"/>

        <a:link id="csh_payment_req_create_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_create.lview"/>
        <a:link id="csh_payment_req_detail_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_detail.lview"/>
        <a:link id="csh_payment_req_query_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_req_query.lview"/>
        <a:link id="csh_payment_req_modify_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_req_modify.lview"/>
        <a:link id="con_contract_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="con_contract_detail_home_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/con_contract_detail.lview"/>
        <a:link id="csh_payment_req_return_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_return.lview"/>
        <a:link id="ol_contract_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/ol_con_contract_detail.lview"/>
        <a:link id="csh_payment_req_create_check_link" url="${/request/@context_path}/csh/payment/req/create/check"/>

        <script type="text/javascript"><![CDATA[

        function csh_payment_req_create_query() {
            $('csh_payment_req_create_result_ds').query();
        }

        function csh_payment_req_create_reset() {
            $('csh_payment_req_create_query_ds').reset();
            $('csh_payment_req_create_result_ds').query();
        }

        var payment_req_id, payment_req_status;

        function setProperties(id, status){
            payment_req_id = id;
            payment_req_status = status;
        }

        function csh_payment_req_detail_open() {
            if(payment_req_id === undefined || payment_req_id == null){
                return ;
            }
            var read_only = 'N';
            if(payment_req_status === 'APPROVED' || payment_req_status === 'APPROVING'){
                read_only = 'Y';
            }
            var win = new Leaf.Window({
                id: 'csh_payment_req_modify_open_win_id',
                url: $('csh_payment_req_detail_link_id').getUrl(),
                params: {
                    winId: 'csh_payment_req_modify_open_win_id',
                    payment_req_id :  payment_req_id,
                    read_only : read_only
                },
                title: '付款维护',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh_payment_req_modify_query();
            });
        }

        function csh_payment_req_create() {
            var records = $('csh_payment_req_create_result_ds').getSelected();
            if (records.length == 0) {
                Leaf.showMessage('${l:PROMPT_MESSAGE}', '未选中行', null, 250, 100);
                return;
            }
            if (records.length > 900) {
                Leaf.showMessage('${l:PROMPT_MESSAGE}', '批量创建请勿超过九百条', null, 250, 100);
                return;
            }
            var residual_amount = 0;
            var contract_ids = records[0].get('contract_id');
            var residual_amounts = records[0].get('residual_amount');



            for (var i = 1; i < records.length; i++) {
                if(records[i].get('cf_item_n') !== records[0].get('cf_item_n')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '不可同时申请不同现金流进行付款!', null, 250, 100);
                    return;
                }
                if(records[i].get('payment_bp_id') !== records[0].get('payment_bp_id')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '付款对象不同的款项不可同时选择!', null, 250, 100);
                    return;
                }
                /*if(records[i].get('lease_channel') !== records[0].get('lease_channel')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '商业模式不同的款项不可同时选择!', null, 250, 100);
                    return;
                }*/
                if(records[i].get('factory_id') !== records[0].get('factory_id')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '经销商/主机厂不同的款项不可同时选择!', null, 250, 100);
                    return;
                }
                if(records[i].get('manufacturer_id') !== records[0].get('manufacturer_id')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '合作方不同的款项不可同时选择!', null, 250, 100);
                    return;
                }
                if(records[i].get('return_reason') === 'CANCEL'){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '合同已退回，不能发起付款!', null, 250, 100);
                    return;
                }

                if(records[i].get('cf_item') == '0' && records[i].get('lease_channel') == '20' &&records[i].get('file_flag')=='N'){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', records[i].get('file_name') + '未上传！', null, 250, 100);
                    return;
                }


                contract_ids = contract_ids + ',' + records[i].get('contract_id');
                residual_amounts = residual_amounts + ',' + records[i].get('residual_amount');
                residual_amount = plus(residual_amount, records[i].get('residual_amount'));
            }

            var win = new Leaf.Window({
                id: 'csh_payment_req_create_winId',
                url: $('csh_payment_req_create_link_id').getUrl(),
                params: {
                    winId: 'csh_payment_req_create_winId',
                    residual_amount: residual_amount,
                    residual_amounts: residual_amounts,
                    read_only : 'N'
                },
                title: '付款创建',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function (e) {
                csh_payment_req_detail_open();
            });
        }
        /*退回*/
        // function csh_payment_req_return(){
        //     var records = $('csh_payment_req_create_result_ds').getSelected();
        //     if (records.length == 0) {
        //         Leaf.showMessage('${l:PROMPT_MESSAGE}', '未选中行', null, 250, 100);
        //         return;
        //     }
        //     var contract_ids = [];
        //     for (var i = 0; i < records.length; i++) {
        //         if(records[i].get('cf_item') !== 0 || records[i].get('lease_channel') != '20' || records[i].get('residual_amount') != records[i].get('due_amount')){
        //             Leaf.showMessage('${l:PROMPT_MESSAGE}', '只能退回商业模式为汽车租赁，应付项目为投放款且应付金额和剩余可申请金额相等的合同!', null, 250, 100);
        //             return;
        //         }
        //         contract_ids.push(records[i].get('contract_id'));
        //     }
        //
        //     var win = new Leaf.Window({
        //         id: 'csh_payment_req_return_winid',
        //         url: $('csh_payment_req_return_link_id').getUrl(),
        //         params: {
        //             winid: 'csh_payment_req_return_winid',
        //             contract_ids : contract_ids.join(',')
        //         },
        //         title: '退回',
        //         width: 400,
        //         height: 300
        //     });
        //     win.on('close', function () {
        //         $('csh_payment_req_create_result_ds').query();
        //     });
        // }

        /*取消合同*/
        function csh_payment_cancel_contract(){
            var records = $('csh_payment_req_create_result_ds').getSelected();
            if (records.length == 0) {
                Leaf.showMessage('${l:PROMPT_MESSAGE}', '未选中行', null, 250, 100);
                return;
            }
            var contract_ids = [];
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('lease_channel') == '40'){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '经营租赁合同包不可取消!', null, 250, 100);
                    return;
                }

                if(records[i].get('cf_item') !== 0 || (records[i].get('lease_channel') != '20' && records[i].get('lease_channel') != '10') || records[i].get('residual_amount') != records[i].get('due_amount')){
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', '只能退回应付项目为设备款且应付金额和剩余可申请金额相等的合同!', null, 250, 100);
                    return;
                }
                contract_ids.push(records[i].get('contract_id'));
            }

            var win = new Leaf.Window({
                id: 'csh_payment_req_return_winid',
                url: $('csh_payment_req_return_link_id').getUrl(),
                params: {
                    winid: 'csh_payment_req_return_winid',
                    contract_ids : contract_ids.join(',')
                },
                title: '退回',
                width: 400,
                height: 300
            });
            win.on('close', function () {
                $('csh_payment_req_create_result_ds').query();
            });
        }

        function payment_req_number_renderer(value, record, name) {
            if (name = 'payment_req_number') {
                return '<a href="javascript:window[\'open_payment_req_modify_win\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        }

        function open_payment_req_modify_win(id, dsid){
            var record = $(dsid).findById(id);
            csh_payment_req_modify_open_function(record);
        }

        function csh_payment_req_modify_open_function(record){
            var read_only = 'N';
            if(record.get('payment_req_status') === 'APPROVED' || record.get('payment_req_status') === 'APPROVING' || record.get('payment_req_status') === 'CANCEL'){
                read_only = 'Y';
            }
            var win = new Leaf.Window({
                id: 'csh_payment_req_modify_win_id',
                url: $('csh_payment_req_detail_link_id').getUrl(),
                params: {
                    winId: 'csh_payment_req_modify_win_id',
                    payment_req_id :  record.get('payment_req_id'),
                    read_only : read_only
                },
                title: '付款维护',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                csh_payment_req_modify_query();
            });
        }

        function csh_payment_req_modify_query() {
            payment_req_id = null;
            payment_req_status = null;
            $('csh_payment_req_modify_result_ds').query();
        }

        function csh_payment_req_modify_reset() {
            $('csh_payment_req_modify_query_ds').reset();
            $('csh_payment_req_modify_result_ds').query();
        }

        function csh_payment_req_modify() {
            csh_payment_req_modify_open_function($('csh_payment_req_modify_result_ds').getCurrentRecord());
        }

        function contract_number_renderer(value, record, name) {
            if (name = 'contract_number') {
                /*return '<a href="javascript:window[\'open_contract_detail_win\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';*/
                return '<a href="javascript:window[\'win_open_sign_detail\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        }

        function win_open_sign_detail(record_id, ds_id){
            var param = $(ds_id).findById(record_id).data;
            var function_code = 'SIG001F1';
            var link_id = 'sig001_project_modify_maintain_id';
            param['url_title'] = '合同签约明细查询';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['winid'] = 'sign_project_modify_maintain_winid';
            param['submit_hide'] = true;

            param['function_code'] = function_code;
            hls_doc_get_layout_code(param, link_id, ds_id, function_code);
        }

        function open_contract_detail_win(record_id, ds_id) {
            debugger
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细查询';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['hidden_button_code'] = ['exit', 'save', 'user_button1', 'user_button2'];
            param['winid'] = 'con_contract_detail_winid';
            if(param['lease_channel'] === '10'){
                param['function_code'] = 'CONT301F1';
                hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
            }else if(param['lease_channel'] === '20'){
                param['function_code'] = 'CONT301F10';
                hls_doc_get_layout_code(param, 'con_contract_detail_home_id', ds_id, 'CONT301');
            }else if (param.lease_channel === '40') {
                param['function_code'] = 'CONT320';
                hls_doc_get_layout_code(param, 'ol_contract_detail_link_id', ds_id, 'CONT301');
            }

        }

        function tab_before_select_event(tabpanel, index, tab){
            if(index === 0){
                csh_payment_req_create_query();
            }else{
                csh_payment_req_modify_query();
            }
        }

        function formatDate(value,record,field_name){
            if(!!value){
                return Leaf.formatDate(value).split(" ")[0];
            }else{
                return '';
            }
        }
        ]]>
        </script>
        <a:screenBody>
            <!--数据源-->
            <a:dataSets>
                <a:dataSet id="cf_item_ds" lookupCode="CSH.CF_ITEM"/>
                <a:dataSet id="wfl_status_ds" lookupCode="CSH_PAYMENT_HD_STATUS"/>
                <a:dataSet id="sys_yes_no_ds" lookupCode="SYS.YES_NO"/>

                <a:dataSet id="csh_payment_req_create_query_ds">
                    <a:fields>
                        <a:field name="tenant_name"/>
                        <a:field name="manufacturer_name" autoComplete="true" lovGridHeight="360" lovHeight="510"
                                 lovLabelWidth="100" lovService="/hls/bp/master/manufacturer/query~com.hand.hls.prj.dto.BpManufacturerInfoLov"
                                 lovWidth="600"
                                 title="合作方">
                            <a:mapping>
                                <a:map from="bp_name" to="manufacturer_name"/>
                            </a:mapping>
                        </a:field>
                        <a:field name="factory_name" autoComplete="true" lovGridHeight="360" lovHeight="600"
                                 lovLabelWidth="100" lovService="/hls/bp/master/vender/query~com.hand.hls.prj.dto.BpVenderInfoLov"
                                 lovWidth="600"
                                 title="经销商/主机厂">
                            <a:mapping>
                                <a:map from="bp_name" to="factory_name"/>
                            </a:mapping>
                        </a:field>
                        <a:field name="cf_item" />
                        <a:field name="cf_item_n" returnField="cf_item"  valueField="code_value" displayField="code_value_name" prompt="现金流项目" options="cf_item_ds"/>
                        <a:field name="file_flag" />
                    </a:fields>
                </a:dataSet>
                <a:dataSet id="csh_payment_req_create_result_ds" autoPageSize="true" autoQuery="false"
                           queryDataSet="csh_payment_req_create_query_ds"
                           queryUrl="${/request/@context_path}/contract/cashflow/csh/payment/create/query"
                           selectable="true">
                    <a:fields>
                        <a:field name="due_date" datatype="date"/>
                        <a:field name="file_flag"  checkedValue="Y" uncheckedValue="N" defaultValue="N"
                                 prompt="付款资料齐全标志"/>
                    </a:fields>
                </a:dataSet>

                <a:dataSet id="csh_payment_req_modify_query_ds">
                    <a:fields>
                        <!--<a:field name="bp_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                                 lovLabelWidth="90"
                                 lovService="/hls/bp/queryBpMasterLov~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                                 title="HLS.BP_TITLE" prompt="商业伙伴">
                            <a:mapping>
                                <a:map from="bp_id" to="bp_id"/>
                                <a:map from="bp_name" to="bp_name"/>
                            </a:mapping>
                        </a:field>-->
                        <a:field name="payment_req_status_n" displayField="code_value_name" options="wfl_status_ds"
                                 returnField="payment_req_status" valueField="code_value"/>
                        <a:field name="payment_req_status"/>
                        <!--<a:field name="bp_name"/>
                        <a:field name="factory_id_name" autoComplete="true" lovGridHeight="360" lovHeight="600"
                                 lovLabelWidth="100" lovService="/hls/bp/master/vender/query~com.hand.hls.prj.dto.BpVenderInfoLov"
                                 lovWidth="600"
                                 title="主机厂/合作方">
                            <a:mapping>
                                <a:map from="bp_name" to="factory_id_name"/>
                            </a:mapping>
                        </a:field>-->
                    </a:fields>
                </a:dataSet>
                <a:dataSet id="csh_payment_req_modify_result_ds" autoPageSize="true" autoQuery="false"
                           queryDataSet="csh_payment_req_modify_query_ds"
                           queryUrl="${/request/@context_path}/csh/payment/req/hd/query"
                           selectable="true" selectionModel="single">
                    <a:fields>
                        <a:field name="payment_req_date" datatype="date"/>
                    </a:fields>
                </a:dataSet>
            </a:dataSets>


            <!--页面布局-->
            <a:tabPanel id="csh_payment_req_tab" marginWidth="20" marginHeight="1">
                <a:tabs>
                    <a:tab prompt="付款申请创建" width="130" selected="true">
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="csh_payment_req_create_query" text="HAP.QUERY"/>
                            <a:gridButton click="csh_payment_req_create_reset" text="HAP.RESET"/>
                            <a:gridButton click="csh_payment_req_create" text="创建"/>
                            <a:gridButton click="csh_payment_cancel_contract" text="取消合同"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="140">

                            <a:datePicker name="disbursement_date_from" bindTarget="csh_payment_req_create_query_ds"
                                          prompt="拟放款日期从" width="160"/>
                            <a:datePicker name="disbursement_date_to" bindTarget="csh_payment_req_create_query_ds"
                                          prompt="拟放款日期至" width="160"/>
                            <a:numberField name="loan_total_amount" bindTarget="csh_payment_req_create_query_ds"
                                           prompt="放款金额" width="160"/>
                            <a:textField name="contract_number" bindTarget="csh_payment_req_create_query_ds"
                                         prompt="合同编号" width="160"/>
<!--                            <a:textField name="contract_name" bindTarget="csh_payment_req_create_query_ds"-->
<!--                                         prompt="合同名称" width="160"/>-->
                            <a:textField name="tenant_name" bindTarget="csh_payment_req_create_query_ds"
                                         prompt="承租人" width="160"/>
                            <a:lov name="manufacturer_name" bindTarget="csh_payment_req_create_query_ds"
                                   prompt="合作方" width="160"/>
                            <a:lov name="factory_name" bindTarget="csh_payment_req_create_query_ds"
                                   prompt="经销商/主机厂" width="160"/>
                            <a:comboBox name="cf_item_n" bindTarget="csh_payment_req_create_query_ds"
                                        prompt="现金流项目" width="160"/>
                        </a:form>
                        <a:grid bindTarget="csh_payment_req_create_result_ds" marginHeight="300" marginWidth="80"
                                navBar="true">
                            <a:columns>
                                <a:column name="contract_number" prompt="合同编号" renderer="contract_number_renderer"
                                          width="250" lock="true"/>
                                <!--<a:column name="contract_name" prompt="合同名称" width="100"/>-->
                                <a:column name="due_date" renderer="Leaf.formatDate" prompt="拟投放日期" align="center" width="100"/>
                                <a:column width="100" name="times" prompt="期数" align="center"/>
                                <a:column width="120" name="cf_item_n" prompt="现金流项目" align="center" />
                                <a:column name="due_amount" align="right" renderer="Leaf.formatMoney" width="100"
                                          prompt="放款金额"/>
                                <a:column name="received_amount" align="right" renderer="Leaf.formatMoney" width="100"
                                          prompt="已付金额"/>
                                <a:column name="tenant_name" prompt="承租人" width="200"/>
                                <a:column name="manufacturer_name" prompt="合作方" width="200"/>
                                <a:column name="factory_name" prompt="经销商/主机厂" width="200"/>
                                <a:column name="payment_bp_name" prompt="付款对象" width="200"/>
                                <!--<a:column name="credit_flag" prompt="是否授信" width="60"/>-->
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="付款申请维护" width="130">
                        <a:screenTopToolbar>
                            <a:screenTitle/>
                            <a:gridButton click="csh_payment_req_modify_query" text="HAP.QUERY"/>
                            <a:gridButton click="csh_payment_req_modify_reset" text="HAP.RESET"/>
                            <a:gridButton click="csh_payment_req_modify" text="维护"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="100">
                            <a:textField name="payment_req_number" bindTarget="csh_payment_req_modify_query_ds"
                                         prompt="申请编号" width="160"/>
                            <a:datePicker name="payment_req_date_from" bindTarget="csh_payment_req_modify_query_ds"
                                          prompt="申请日期从" width="160"/>
                            <a:datePicker name="payment_req_date_to" bindTarget="csh_payment_req_modify_query_ds"
                                          prompt="申请日期至" width="160"/>
                            <a:textField name="payment_bp_name" bindTarget="csh_payment_req_modify_query_ds"
                                         prompt="付款对象名称" width="160"/>
                            <a:numberField name="amount_from" bindTarget="csh_payment_req_modify_query_ds"
                                           prompt="申请总金额从" width="160"/>
                            <a:numberField name="amount_to" bindTarget="csh_payment_req_modify_query_ds"
                                           prompt="申请总金额至" width="160"/>
                            <a:comboBox name="payment_req_status_n" bindTarget="csh_payment_req_modify_query_ds"
                                        prompt="单据状态" width="160"/>
                        </a:form>
                        <a:grid bindTarget="csh_payment_req_modify_result_ds" marginHeight="300" marginWidth="80"
                                navBar="true">
                            <a:columns>
                                <a:column name="payment_req_number" prompt="申请编号" align="center"
                                          renderer="payment_req_number_renderer" width="150"/>
                                <a:column name="payment_req_date" renderer="Leaf.formatDate" prompt="申请日期" align="center" width="100"/>
                                <a:column name="payment_bp_name" prompt="付款对象" width="200"/>
                                <a:column name="payment_bp_type_n" prompt="对象类别" width="200"/>
                                <a:column name="payment_method_n" prompt="付款方式" width="200"/>
                                <a:column name="bp_bank_account_name" prompt="付款账户" width="200"/>
                                <a:column name="bp_bank_account_num" prompt="付款账号" width="200"/>

                                <a:column name="amount" align="right" renderer="Leaf.formatMoney" width="100"
                                          prompt="申请总金额"/>

                                <a:column name="payment_req_status_n" prompt="单据状态" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                </a:tabs>
                <a:events>
                    <a:event name="beforeselect" handler="tab_before_select_event"/>
                </a:events>
            </a:tabPanel>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
