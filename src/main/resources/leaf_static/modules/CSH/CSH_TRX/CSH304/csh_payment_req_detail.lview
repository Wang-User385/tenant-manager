                    <a:numberField id="csh_payment_req_create_detail_nf" />
                </a:editors>
            </a:grid>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
