<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>

        <a:link id="csh_payment_req_create_detail_save_link" url="${/request/@context_path}/csh/payments/req/ln/save"/>
        <a:link id="csh_payment_req_ln_remove_link" url="${/request/@context_path}/csh/payments/req/ln/remove"/>
        <a:link id="csh_payment_req_create_detail_deduction_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_deduction.lview"/>

        <a:link id="sig001_project_modify_id"
                url="${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F1/sig_project_modify.lview"/>

        <a:link id="con_contract_detail2_this_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="con_contract_detail22_this_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/con_contract_detail.lview"/>
        <a:link id="csh_payment_req_hd_back_link_id" url="${/request/@context_path}/csh/payments/req/create/back"/>
        <a:link id="csh_payment_req_attach_list_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_attach.lview"/>
        <a:link id="repayment_calc_link_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/repayment_calc.lview"/>
        <a:link id="ol_contract_detail2_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/ol_con_contract_detail.lview"/>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <style>
            .text_warning{
                color:red;
            }
        </style>
        <script type="text/javascript"><![CDATA[
        var payment_req_id = '${/parameter/@payment_req_id}';
        var business_key = '${/parameter/@businessKey}';
        var read_only = !'${/parameter/@read_only}' ? 'Y' : '${/parameter/@read_only}';
        var payment_req_ln_ids = [];

        function csh_payment_req_create_save() {
            var submit_status = 'SAVE';
            var ln_ds = $('csh_payment_req_create_detail_ln_ds');
            if (ln_ds.totalCount > 900) {
                Leaf.showMessage('${l:PROMPT_MESSAGE}', '超过九百条！请分批保存。', null, 250, 100);
                return;
            }
            var hd_record = $('csh_payment_req_create_detail_hd_ds').getAt(0);
            var bp_id = hd_record.get('bp_id');
            var bp_bank_account_id = hd_record.get('bp_bank_account_id');
            var bp_bank_account_name = hd_record.get('bp_bank_account_name');
            var bp_bank_account_num = hd_record.get('bp_bank_account_num');
            var bp_bank_name = hd_record.get('bp_bank_name');
            var bp_bank_branch_name = hd_record.get('bp_bank_branch_name');
            var bp_bank_full_name = hd_record.get('bp_bank_full_name');
            var description = hd_record.get('description');
            var payment_method = hd_record.get('payment_method');

            if(!payment_method){
                Leaf.showMessage('提示！', '付款方式必选！');
                return ;
            }

            if(!bp_bank_account_id){
                Leaf.showMessage('提示！', '付款对象账户必选！');
                return ;
            }
            console.log("create_save_ln_ds:",ln_ds.getAll());

            if (ln_ds.validate()) {
                var saveData = [];
                var records = ln_ds.getAll();

                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少维护一条记录！');
                    return;
                }

                for(var i = 0;i<records.length; i++){
                    if(records[i].get('amount')>records[i].get('surplus_amount')){
                        Leaf.showMessage('${HLS.PROMPT}', '第'+(i+1)+'行本次申请金额'+records[i].get('amount')+'大于剩余可申请金额'+records[i].get('surplus_amount'));
                        return;
                    }
                    records[i].set('bp_id', bp_id);
                    records[i].set('bp_bank_account_id', bp_bank_account_id);
                    records[i].set('bp_bank_account_name', bp_bank_account_name);
                    records[i].set('bp_bank_account_num', bp_bank_account_num);
                    records[i].set('bp_bank_name', bp_bank_name);
                    records[i].set('bp_bank_branch_name', bp_bank_branch_name);
                    records[i].set('bp_bank_full_name', bp_bank_full_name);
                    records[i].set('description', description);

                    if (payment_req_ln_ids.length !== 0) {
                        var ind = 0;
                        for (var j = 0; j<payment_req_ln_ids.length; j++) {
                            if (records[i].get("payment_req_ln_id") !== payment_req_ln_ids[j].payment_req_ln_id) {
                                ind ++;
                            }
                        }
                        if (ind == payment_req_ln_ids.length) {
                            saveData.push(records[i].data);
                        }
                    } else {
                        saveData.push(records[i].data);
                    }
                }

                var total_amount = 0;
                for (var i = 0; i < saveData.length; i++) {
                    total_amount = plus(total_amount, saveData[i].amount);
                }
                hd_record.set('amount', total_amount);

                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '执行中。。');
                Leaf.request({
                    url: $('csh_payment_req_create_detail_save_link').getUrl(),
                    para: {
                        hlsCusCshPaymentReqHd : hd_record.data,
                        hlsCusCshPaymentReqLnList : saveData,
                        submitStatus : submit_status
                    },
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask($(winId).wrap);
                        $('csh_payment_req_create_detail_hd_ds').query();
                        $('csh_payment_req_create_detail_ln_ds').query();
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }
        }

        function csh_payment_req_create_submit() {
            var submit_status = 'SUBMIT';
            var ln_ds = $('csh_payment_req_create_detail_ln_ds');
            var hd_record = $('csh_payment_req_create_detail_hd_ds').getAt(0);
            var bp_id = hd_record.get('bp_id');
            var bp_bank_account_id = hd_record.get('bp_bank_account_id');
            var bp_bank_account_name = hd_record.get('bp_bank_account_name');
            var bp_bank_account_num = hd_record.get('bp_bank_account_num');
            var bp_bank_name = hd_record.get('bp_bank_name');
            var bp_bank_branch_name = hd_record.get('bp_bank_branch_name');
            var bp_bank_full_name = hd_record.get('bp_bank_full_name');
            var description = hd_record.get('description');
            var payment_method = hd_record.get('payment_method');

            if(!payment_method){
                Leaf.showMessage('提示！', '付款方式必选！');
                return ;
            }

            if(!bp_bank_account_id){
                Leaf.showMessage('提示！', '付款对象账户必选！');
                return ;
            }

            if (ln_ds.validate()) {
                var saveData = [];
                var records = ln_ds.getAll();

                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少维护一条记录！');
                    return;
                }

                for(var i = 0;i<records.length; i++){
                    if(records[i].get('amount')>records[i].get('surplus_amount')){
                        Leaf.showMessage('${HLS.PROMPT}', '第'+(i+1)+'行本次申请金额'+records[i].get('amount')+'大于剩余可申请金额'+records[i].get('surplus_amount'));
                        return;
                    }
                }

                //三一厂商提示付款账号与进件同步付款账号是否一致
                var syMessage;
                for (var i = 0; i < records.length; i++) {
                    if(records[i].get('applied_pay_amount') <= 0){
                        Leaf.showMessage('${HLS.PROMPT}', '第'+(i+1)+'行抵扣后申请金额'+records[i].get('applied_pay_amount')+'不能小于等于0');
                        return;
                    }
                    records[i].set('bp_id', bp_id);
                    records[i].set('bp_bank_account_id', bp_bank_account_id);
                    records[i].set('bp_bank_account_name', bp_bank_account_name);
                    records[i].set('bp_bank_account_num', bp_bank_account_num);
                    records[i].set('bp_bank_name', bp_bank_name);
                    records[i].set('bp_bank_branch_name', bp_bank_branch_name);
                    records[i].set('bp_bank_full_name', bp_bank_full_name);
                    records[i].set('description', description);
                    saveData.push(records[i].data);

                    if (records[i].get('manufacturer_code') == 'C000004453') {
                        if (records[i].get('bank_account_num') != bp_bank_account_num) {
                            if (Ext.isEmpty(syMessage)) {
                                syMessage = '与' + records[i].get('contract_number');
                            } else {
                                syMessage = '、' + records[i].get('contract_number') + ',';
                            }
                        }
                    }

                }

                if (!Ext.isEmpty(syMessage)) {
                    Leaf.showConfirm("确认", syMessage + '合同进件中的投放账号不一致，是否确认投放?', function () {
                        var winId = '${/parameter/@winId}';
                        Leaf.Masker.mask($(winId).wrap, '执行中。。');
                        Leaf.request({
                            url: $('csh_payment_req_create_detail_save_link').getUrl(),
                            para: {
                                hlsCusCshPaymentReqHd: hd_record.data,
                                hlsCusCshPaymentReqLnList: saveData,
                                submitStatus: submit_status
                            },
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                                    duration: 2000
                                });
                                Leaf.Masker.unmask($(winId).wrap);
                                csh_payment_req_create_return_action();
                            },
                            failure: function () {
                                Leaf.Masker.unmask($(winId).wrap);
                            },
                            error: function () {
                                Leaf.Masker.unmask($(winId).wrap);
                            },
                            scope: this
                        });
                    });
                } else {
                    var winId = '${/parameter/@winId}';
                    Leaf.Masker.mask($(winId).wrap, '执行中。。');
                    Leaf.request({
                        url: $('csh_payment_req_create_detail_save_link').getUrl(),
                        para: {
                            hlsCusCshPaymentReqHd: hd_record.data,
                            hlsCusCshPaymentReqLnList: saveData,
                            submitStatus: submit_status
                        },
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            Leaf.Masker.unmask($(winId).wrap);
                            csh_payment_req_create_return_action();
                        },
                        failure: function () {
                            Leaf.Masker.unmask($(winId).wrap);
                        },
                        error: function () {
                            Leaf.Masker.unmask($(winId).wrap);
                        },
                        scope: this
                    });
                }
            }
        }

        function csh_payment_req_create_back(){
            var winId = '${/parameter/@winId}';
            var hd_record = $('csh_payment_req_create_detail_hd_ds').getAt(0);
            Leaf.Masker.mask($(winId).wrap, '撤回中。。');
            Leaf.request({
                url: $('csh_payment_req_hd_back_link_id').getUrl()+'?paymentReqId='+hd_record.get('payment_req_id'),
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    Leaf.Masker.unmask($(winId).wrap);
                    csh_payment_req_create_return_action();
                },
                failure: function () {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                error: function () {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                scope: this
            });
        }

        function csh_payment_req_create_return() {
            csh_payment_req_create_return_action();
        }

        function csh_payment_req_create_return_action() {
            $('${/parameter/@winId}').close();
            csh_payment_req_create_query();
            csh_payment_req_modify_query();
        }

        function atm_renderer(value, record, name) {
            return '<a href="javascript:win_open_attach(\'' + value + '\',\'' + record.ds.id +'\');">附件上传</a>';
        }

		//附件预览
		function preview(contract_id){
			if (typeof(window.previewAtt) === 'function') {
        		previewAtt(contract_id);
   			 }else if(typeof(window.parent.previewAtt) === 'function'){
   		 		window.parent.previewAtt(contract_id)
   			 }else if(typeof(window.parent.parent.previewAtt) === 'function'){
   		 		window.parent.parent.previewAtt(contract_id)
   		 	 }else if(typeof(window.parent.parent.parent.previewAtt) === 'function'){
   		 		window.parent.parent.parent.previewAtt(contract_id)
   		 	}
		}

        function contract_detail_renderer(value, record){
            /*return '<a href="javascript:win_open_contract_detail(\'' + record.id + '\',\'' + record.ds.id + '\');">明细</a>';*/
            return '<a href="javascript:win_open_sign_detail(\'' + record.id + '\',\'' + record.ds.id + '\');">明细</a>';
        }

        function win_open_contract_detail(record_id, ds_id){
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细查询';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['hidden_button_code'] = ['exit', 'save', 'user_button1', 'user_button2'];
            param['winid'] = 'con_contract_detail_winid';

            if('10' === param.lease_channel){
                param['function_code'] = 'CONT301F1';
                hls_doc_get_layout_code(param, 'con_contract_detail2_this_id', ds_id, 'CONT301');
            }else if('20' === param.lease_channel){
                param['function_code'] = 'CONT301F10';
                hls_doc_get_layout_code(param, 'con_contract_detail22_this_id', ds_id, 'CONT301');
            }else if('40' === param.lease_channel){
                param['function_code'] = 'CONT320';
                hls_doc_get_layout_code(param, 'ol_contract_detail2_link_id', ds_id, 'CONT301');
            }else{
                Leaf.showErrorMessage("错误", "未知的业务模式");
            }
        }

        function win_open_sign_detail(record_id, ds_id){
            var param = $(ds_id).findById(record_id).data;
            var function_code = 'SIG001F1';
            var link_id = 'sig001_project_modify_id';
            param['url_title'] = '合同签约明细查询';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['winid'] = 'sign_project_modify_winid';
            param['submit_hide'] = true;

            param['function_code'] = function_code;
            hls_doc_get_layout_code(param, link_id, ds_id, function_code);
        }

        function win_open_attach(payment_req_ln_id,ds_id) {
            var param = {};
            param['url_title'] = '付款申请附件列表';
            param['winid'] = 'csh_payment_req_attach_winid';
            param['function_code'] = 'CSH304ATT';
            param['payment_req_id'] = payment_req_ln_id;
            param['project_attachment_category'] = 'RETAIL_PAYMENT';
            param['screen_width'] = 800;
            param['screen_height'] = 575;
            if (read_only === 'Y') {
                param['function_usage'] = 'QUERY';
                param['maintain_type'] = 'READONLY';
            }else{
                param['function_usage'] = 'MODIFY';
                param['maintain_type'] = 'MODIFY';
            }
            hls_doc_get_layout_code(param, 'csh_payment_req_attach_list_link_id',ds_id);
        }

        function deduction_renderer(value, record, name) {
            if (!record.isNew) {
                return '<a href="javascript:win_open_deduction(\'' + record.id + '\',\'' + record.ds.id + '\');">收付抵扣 </a>';
            } else {
                return ''
            }
        }

        function win_open_deduction(record_id, ds_id) {
            debugger
            var record = $(ds_id).findById(record_id);
            /*if('LEASE' === record.get('business_type')){
                Leaf.showMessage('提示', '直租项目不能坐扣!');
                return;
            }*/
            new Leaf.Window({
                id: 'open_deduction_create_winid',
                url: $('csh_payment_req_create_detail_deduction_link_id').getUrl(),
                params: {
                    quotation_id: record.get('quotation_id'),
                    contract_id: record.get('source_doc_id'),
                    payment_req_ln_id: record.get('payment_req_ln_id'),
                    amount: record.get('amount'),
                    deduct_flag:'N',
                    winId: 'open_deduction_create_winid',
                    read_only : read_only
                },
                title: '收付抵扣',
                fullScreen: true,
                draggable: true
            }).on('close', function() {
                $('csh_payment_req_create_detail_ln_ds').query();
            });
        }

        function contract_number_lov_before_event(lov) {
            var result_records_all = $('csh_payment_req_create_detail_ln_ds').getAll();
            if(result_records_all.length > 0){
                var not_cashflow_ids_str = '';
                for(var i = 0; i < result_records_all.length; i++){
                    if(!!result_records_all[i].get('source_doc_line_id')){
                        not_cashflow_ids_str += result_records_all[i].get('source_doc_line_id') + ',';
                    }
                }
                lov.para = {
                    notCashflowIdsStr : not_cashflow_ids_str,
                    paymentBpId : result_records_all[0].get('bp_id'),
                    cfItem : result_records_all[0].get('cf_item'),
                    notInContractStatusStr : 'CANCEL,PENDING,NEW'
                }
            }else{
                lov.para = {
                    paymentBpId : result_records_all[0].get('bp_id'),
                    cfDirection : 'OUTFLOW',
                    notInContractStatusStr : 'CANCEL,PENDING,NEW'
                }
            }
        }

        function bp_bank_account_name_handler(lov){
            lov.para = {
                'bpId': $('csh_payment_req_create_detail_hd_ds').getCurrentRecord().get("bp_id")
            };
        }

        function create_ln_ds_update(ds, record, name, value, oldvalue) {
            if (name == 'bp_name') {
                record.set('bp_bank_account_id', '');
                record.set('bp_bank_account_num', '');
                record.set('bp_bank_account_name', '');
                record.set('bp_bank_branch_name', '');
                record.set('bp_bank_full_name', '');
            }
            if (name == 'amount') {
                var hd_ds = $('csh_payment_req_create_detail_hd_ds');
                var hd_record = hd_ds.getAt(0);


                var total_amount = 0;
                var records = ds.getAll();
                for (var i = 0; i < records.length; i++) {
                    total_amount = plus(total_amount, records[i].get('amount'));

                }
                hd_record.set('amount', total_amount);
                record.set('applied_pay_amount', minus(record.get('amount'), record.get('deduction_amount') || 0))
            }
        }

        function create_bp_name_ds_query(ds, para) {
            para['contractId'] = $('csh_payment_req_create_detail_ln_ds').getAt(0).get('contract_id');
        }

        function create_hd_ds_query(ds, para) {
            if(!!business_key){
                para['payment_req_id'] = business_key;
            }else {
                para['payment_req_id'] = payment_req_id;
            }
        }

        function create_hd_ds_update(ds, record, name, value, oldvalue) {
            if (name === 'bp_name') {
                record.set('bp_bank_account_id', '');
                record.set('bp_bank_account_num', '');
                record.set('bp_bank_account_name', '');
                record.set('bp_bank_name', '');
                record.set('bp_bank_full_name', '');
            }
        }

        function create_hd_ds_load(ds,e) {

            debugger
            if(read_only === 'Y'){
                ds.getAt(0).getField('bp_bank_account_name').setReadOnly(true);
                ds.getAt(0).getField('description').setReadOnly(true);
                ds.getAt(0).getField('payment_bp_name').setReadOnly(true);
                ds.getAt(0).getField('payment_method_n').setReadOnly(true);
            }
            /*if(ds.getAt(0).get('cf_item') !== '0'){
                $('csh_payment_req_create_detail_ln_id').hideColumn('deduction');
                $('csh_payment_req_create_detail_ln_id').hideColumn('deduction_amount');
                $('csh_payment_req_create_detail_ln_id').hideColumn('applied_pay_amount');
            }*/
        }

        function create_ln_ds_query(ds, para) {
            if(!!business_key){
                para['payment_req_id'] = business_key;
            }else {
                para['payment_req_id'] = payment_req_id;
            }
        }

        function create_ln_ds_load(ds, e) {
            debugger;
            if(read_only === 'Y'){
                var datas = ds.getAll();
                for(var i = 0; i < datas.length; i++){
                    datas[i].getField('contract_number').setReadOnly(true);
                    datas[i].getField('amount').setReadOnly(true);
                }
            }

            if(ds.getAll().length > 0&&ds.getAt(0).get('lease_channel') == '10'){
                $jq('table[text="付款申请测算参数"]').remove();
            }
            // $('csh_payment_req_create_detail_bp_name_ds').query();
        }

        function create_ln_ds_remove(ds, record, index) {
            var hd_ds = $('csh_payment_req_create_detail_hd_ds');
            var hd_record = hd_ds.getAt(0);

            var total_amount = 0;
            var records = ds.getAll();
            for (var i = 0; i < records.length; i++) {
                total_amount = plus(total_amount, records[i].get('amount'));
            }
            hd_record.set('amount', total_amount);
            csh_payment_req_create_save();
        }

        function onChange_approval_comment_ta(ta,value,pre_value){
            var left_length = 200 - value.length;
            if(left_length >= 0){
                jQuery("#comment_wordLeft").removeClass("text_warning");
                jQuery("#comment_wordLeft").text("您还可以再输入" + left_length + "个字。");
            }else{
                jQuery("#comment_wordLeft").text("最多只能输入200个字");
                jQuery("#comment_wordLeft").addClass("text_warning");
            }
        }
        function onKeyPress_approval_comment_ta(field,e){
            var ta = $("approval_comment_detail");
            var comment = field.el.dom.value || '';
            ta.fireEvent("change",ta,comment,'');
        }

        function csh_payment_req_batch_calc(){
            var ln_ds = $('csh_payment_req_create_detail_ln_ds');
            var win = new Leaf.Window({
                id: 'payment_wfl_calc_winid',
                url: $("repayment_calc_link_id").getUrl(),
                params:{
                    payment_req_id : ln_ds.getAt(0).get("payment_req_id")
                },
                title: '付款申请测算',
                width: 1000,
                height: 575
            });
        }

        function csh_payment_req_attachment_upload(){
            var hd_ds = $('csh_payment_req_create_detail_hd_ds');
            var hd_record = hd_ds.getAt(0);
            if(read_only === 'Y'){
                new Leaf.Window({
                    id: 'open_attachment_win_id',
                    url: '${/request/@context_path}/downloadFile.lview',
                    params: {
                        header_id: hd_record.get('payment_req_id'),
                        table_name: 'CSH_PAYMENT_REQ_HD',
                        winid: 'open_attachment_win_id',
                        function_usage : 'QUERY'
                    },
                    title: '返利协议上传',
                    width: 900,
                    height: 475
                });
            }else{
                new Leaf.Window({
                    id: 'open_attachment_win_id',
                    url: '${/request/@context_path}/uploadFile.lview',
                    params: {
                        header_id: hd_record.get('payment_req_id'),
                        table_name: 'CSH_PAYMENT_REQ_HD',
                        winid: 'open_attachment_win_id'
                    },
                    title: '返利协议上传',
                    width: 900,
                    height: 475
                });
            }
        }

        function csh_payment_req_batch_remove() {
            debugger
            var ln_ds = $('csh_payment_req_create_detail_ln_ds');
            var allRecords = ln_ds.getAll();
            var selectedRecords = ln_ds.getSelected();

            var unselectRecords = [];
            var deleteRecords = [];

            if (selectedRecords.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }
            //筛选出需要后台删除的记录
            for (var i = 0; i < selectedRecords.length; i++) {
                if (selectedRecords[i].data.payment_req_ln_id !== undefined ){
                    deleteRecords.push(selectedRecords[i]);
                }
            }

            //筛选出未被选中的记录
            for (var i = 0; i < allRecords.length; i++) {
                if (allRecords[i].isSelected === false){
                    unselectRecords.push(allRecords[i]);
                }
            }



            var batchIds = [];

            for(var i=0;i<deleteRecords.length;i++){
                batchIds[i] = new Object();
                batchIds[i].paymentReqLnId = deleteRecords[i].data.payment_req_ln_id;
            }

            Leaf.showConfirm('确认', '确认删除选中的记录？', function okFun() {
                //删除
                ln_ds.removeAll();
                //未被选择的记录添加回DS中
                if (unselectRecords.length > 0){
                    for (var i = 0; i < unselectRecords.length; i++) {
                        ln_ds.add(unselectRecords[i]);
                    }
                }

                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '正在删除数据...');
                Leaf.request({
                    url: $('csh_payment_req_ln_remove_link').getUrl(),
                    para: batchIds,
                    success: function(res) {
                        Leaf.Masker.unmask($(winId).wrap);
                        //ln_ds.query();
                        payment_req_ln_ids = res.result.record;

                        console.log("payment_req_ln_ids:",payment_req_ln_ids);
                        console.log("ln_ds_after_remove:", ln_ds.getAll());

                        csh_payment_req_create_save();
                        $('csh_payment_req_create_detail_hd_ds').query();
                    },
                    failure: function() {
                        console.log('failure');
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function() {
                        console.log('error');
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            });
        }

        Leaf.onReady(function () {
            debugger
            if('${/parameter/@read_only}' == 'Y'){
                $jq('table[text="保存"]').remove();
                $jq('table[text="新增"]').remove();
                $jq('table[text="删除"]').remove();
                $jq('table[text="提交审批"]').remove();
                $jq('table[text="撤回"]').remove();
                $jq('table[text="取消"]').remove();
                $jq('table[text="返回"]').remove();
                $jq('table[text="付款申请测算参数"]').remove();
                $jq('table[text="返利协议上传"]').remove();

                $jq('table[id="PAY_REQ_DETAIL_BUTTON_RETURN"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_SAVE"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_BACK"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_SUBMIT"]').remove();

            }else if(!'${/parameter/@read_only}' || '${/parameter/@read_only}' == ''){
                $jq('table[text="保存"]').remove();
                $jq('table[text="新增"]').remove();
                $jq('table[text="删除"]').remove();
                $jq('table[text="提交审批"]').remove();
                $jq('table[text="撤回"]').remove();
                $jq('table[text="取消"]').remove();
                $jq('table[text="返回"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_RETURN"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_SAVE"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_BACK"]').remove();
                $jq('table[id="PAY_REQ_DETAIL_BUTTON_SUBMIT"]').remove();
            }else{
                $jq('table[text="付款申请测算参数"]').remove();
            }
        });

        ]]></script>
        <a:dataSets>
            <a:dataSet id="payment_method_combobox_ds" lookupCode="CSH.PAYMENT_METHOD"/>
            <a:dataSet id="csh_payment_req_create_detail_bp_name_ds" autoCreate="true" autoQuery="false"
                       queryUrl="${/request/@context_path}/csh/payment/req/bp/name/query">
                <a:fields>
                    <a:field name="contract_id"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="create_bp_name_ds_query"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="csh_payment_req_create_detail_hd_ds" autoCreate="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/csh/payment/req/hd/query">
                <a:fields>
                    <a:field name="payment_req_id"/>
                    <a:field name="payment_req_date" datatype="date" readOnly="true"/>
                    <a:field name="payment_req_number" readOnly="true"/>
                    <a:field name="amount" readOnly="true"/>
                    <a:field name="after_deduct_amount" readOnly="true" defaultValue="0"/>
                    <a:field name="bp_id"/>
                    <!--<a:field name="bp_name" required="true" returnField="bp_id" valueField="bp_id" displayField="bp_name" prompt="付款对象" options="csh_payment_req_create_detail_bp_name_ds"/>-->
                    <a:field name="bp_name" readOnly="true"/>
                    <a:field name="payment_bp_name" readOnly="true"/>
                    <a:field name="bp_bank_account_name" required="true" requiredMessage="付款对象账户必填" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/con/contract/bp/bank/lov~hls.layout.dto.LovBpBankAccountDto" lovWidth="550"
                             title="付款对象账户" prompt="付款对象账户">
                        <a:mapping>
                            <a:map from="bank_account_id" to="bp_bank_account_id"/>
                            <a:map from="bank_account_num" to="bp_bank_account_num"/>
                            <a:map from="bank_account_name" to="bp_bank_account_name"/>
                            <a:map from="bank_full_name" to="bp_bank_name"/>
                            <a:map from="bank_full_name" to="bp_bank_full_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_bank_account_id"/>
                    <a:field name="bp_bank_name" readOnly="true"/>
                    <a:field name="bp_bank_account_num" readOnly="true"/>
                    <a:field name="bp_bank_branch_name" readOnly="true"/>
                    <a:field name="bp_bank_full_name" readOnly="true"/>
                    <a:field name="payment_method" />
                    <a:field name="payment_method_n" options="payment_method_combobox_ds"
                             displayField="code_value_name"
                             valueField="code_value"
                             returnField="payment_method" />
                </a:fields>
                <a:events>
                    <a:event name="query" handler="create_hd_ds_query"/>
                    <a:event name="load" handler="create_hd_ds_load"/>
                    <a:event name="update" handler="create_hd_ds_update"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="csh_payment_req_create_detail_ln_ds" autoQuery="true" pageSize="999"
                       queryUrl="${/request/@context_path}/csh/payments/req/ln/query" selectable="true">
                <a:fields>
                    <a:field name="contract_number" autoComplete="true" required="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/csh/payment/create/query~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="contract_name" to="contract_name"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="cashflow_id" to="source_doc_line_id"/>
                            <a:map from="contract_id" to="source_doc_id"/>
                            <a:map from="cf_item_n" to="cf_item_n"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="bp_name" to="tenant_name"/>
                            <a:map from="due_amount" to="amount"/>
                            <a:map from="residual_amount" to="residual_amount"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="payment_req_id"/>
                    <a:field name="payment_req_ln_id"/>
                    <a:field name="source_doc_category" defaultValue="CON_CONTRACT"/>
                    <a:field name="tenant_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="bp_bank_account_id"/>
                    <a:field name="bp_bank_account_num"/>
                    <a:field name="bp_bank_account_name"/>
                    <a:field name="bp_bank_branch_name"/>
                    <a:field name="bp_bank_full_name"/>
                    <a:field name="service_charge_due_amount"/>
                    <a:field name="service_charge_received_amount"/>
                    <a:field name="service_charge_fee_due_amount"/>
                    <a:field name="service_charge_fee_received_amount"/>
                    <a:field name="amount" required="true" prompt="本次申请金额"/>
                    <a:field name="due_amount"/>
                    <a:field name="payment_flag" defaultValue="NOT"/>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="create_ln_ds_update"/>
                    <a:event name="query" handler="create_ln_ds_query"/>
                    <a:event name="load" handler="create_ln_ds_load"/>
                    <!--<a:event name="remove" handler="csh_payment_req_batch_remove"/>
                    <a:event name="beforeremove" handler="csh_payment_req_batch_remove"/>-->
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
