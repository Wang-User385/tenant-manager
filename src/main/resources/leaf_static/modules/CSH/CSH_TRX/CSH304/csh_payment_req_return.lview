<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: Eugene Song
    $Date: 2019年4月18日
    $Revision: 1.0
    $Purpose: 付款申请退回
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        var contract_ids = '${/parameter/@contract_ids}';
        function csh_return() {
            $('${/parameter/@winid}').close();
        }

        function payment_return() {
            var winId = '${/parameter/@winid}';
            Leaf.Masker.mask($(winId).wrap, '退回中。。');
            var record = $('csh_payment_req_return_create_ds').getAt(0);
            Leaf.request({
                url: "${/request/@context_path}/csh/payments/return",
                success: function (res) {
                    Leaf.Masker.unmask($(winId).wrap);
                    csh_return();
                },
                para: {
                    hlsCusConContract : {
                        return_date : record.get('return_date'),
                        return_reason : record.get('cancel_reason'),
                        return_description : record.get('return_description'),
                        contract_ids : contract_ids.split(',')
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                failure: function (res) {
                    Leaf.Masker.unmask($(winId).wrap);
                },
                scope: this
            });
        }

        Leaf.onReady(function(){
            var record = $('csh_payment_req_return_create_ds').getAt(0);
            record.set('return_date', new Date());
        })

        ]]></script>
        <a:screenBody>

            <a:dataSets>
                <a:dataSet id="process_cancel_reason_ds" lookupCode="PROCESS_CANCEL_REASON"/>
                <a:dataSet id="csh_payment_req_return_create_ds" autoCreate="true">
                    <a:fields>
                        <a:field name="return_date" required="true" readOnly="true" defaultValue=""/>
                        <a:field name="cancel_reason"/>
                        <a:field name="cancel_reason_n" options="process_cancel_reason_ds"
                                 displayField="code_value_name" valueField="code_value" returnField="cancel_reason"/>
                        <a:field name="return_reason"/>
                        <a:field name="return_reason_n" readOnly="true" returnField="return_reason" required="true" valueField="code_value" displayField="code_value_name" prompt="退回理由" options="process_cacel_reason_ds"/>
                        <a:field name="return_description" required="true"/>
                    </a:fields>
                </a:dataSet>
            </a:dataSets>
            <a:screenTopToolbar>
                <a:gridButton click="csh_return" text="返回"/>
                <a:gridButton click="payment_return" text="退回"/>
            </a:screenTopToolbar>
            <a:form >
                <a:datePicker name="return_date" bindTarget="csh_payment_req_return_create_ds" prompt="退回日期"/>

                <a:comboBox name="cancel_reason_n" bindTarget="csh_payment_req_return_create_ds" prompt="退回原因"/>
                <a:textArea name="return_description" bindTarget="csh_payment_req_return_create_ds"
                            prompt="退回说明" height="120" width="270"/>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>

