<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年3月5日
    $Revision: 1.0
    $Purpose: 付款申请创建
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>

        <a:link id="csh_payment_req_create_save_link" url="${/request/@context_path}/csh/payments/req/ln/save"/>
        <a:link id="csh_payment_req_create_deduction_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH304/csh_payment_req_deduction.lview"/>
        <a:link id="con_contract_detail2_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <style>
            .text_warning{
                color:red;
            }
        </style>
        <script type="text/javascript"><![CDATA[
        var residual_amount = '${/parameter/@residual_amount}';

        function csh_payment_req_create_save() {
            var submit_status = 'SAVE';
            var ln_ds = $('csh_payment_req_detail_create_ln_ds');
            var hd_record = $('csh_payment_req_detail_create_hd_ds').getAt(0);
            var bp_id = hd_record.get('bp_id');
            var bp_bank_account_id = hd_record.get('bp_bank_account_id');
            var bp_bank_account_name = hd_record.get('bp_bank_account_name');
            var bp_bank_account_num = hd_record.get('bp_bank_account_num');
            var bp_bank_name = hd_record.get('bp_bank_name');
            var bp_bank_branch_name = hd_record.get('bp_bank_branch_name');
            var bp_bank_full_name = hd_record.get('bp_bank_full_name');
            var description = hd_record.get('description');
            var payment_method = hd_record.get('payment_method');

            if(!payment_method){
                Leaf.showMessage('提示！', '付款方式必选！');
                return ;
            }

            if(!bp_bank_account_id){
                Leaf.showMessage('提示！', '付款对象账户必选！');
                return ;
            }

            if (ln_ds.validate()) {
                var saveData = [];
                var records = ln_ds.getAll();

                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少维护一条记录！');
                    return;
                }

                for(var i = 0;i<records.length; i++){
                    if(records[i].get('amount')>records[i].get('due_amount')){
                        Leaf.showMessage('${HLS.PROMPT}', '本次申请金额大于应付金额！');
                        return;
                    }

                    if(records[i].get('amount')>records[i].get('residual_amount')){
                        Leaf.showMessage('${HLS.PROMPT}', '第'+(i+1)+'行本次申请金额'+records[i].get('amount')+'大于剩余可申请金额'+records[i].get('residual_amount'));
                        return;
                    }
                    records[i].set('bp_id', bp_id);
                    records[i].set('bp_bank_account_id', bp_bank_account_id);
                    records[i].set('bp_bank_account_name', bp_bank_account_name);
                    records[i].set('bp_bank_account_num', bp_bank_account_num);
                    records[i].set('bp_bank_name', bp_bank_name);
                    records[i].set('bp_bank_branch_name', bp_bank_branch_name);
                    records[i].set('bp_bank_full_name', bp_bank_full_name);
                    records[i].set('description', description);
                    saveData.push(records[i].data);
                }

                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '执行中。。');
                Leaf.request({
                    url: $('csh_payment_req_create_save_link').getUrl(),
                    para: {
                        hlsCusCshPaymentReqHd : hd_record.data,
                        hlsCusCshPaymentReqLnList : saveData,
                        submitStatus : submit_status
                    },
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask($(winId).wrap);
                        csh_payment_req_create_return_action(res.result.record[0].payment_req_id, res.result.record[0].payment_req_status);
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }
        }

        function csh_payment_req_create_submit() {
            var submit_status = 'SUBMIT';
            var ln_ds = $('csh_payment_req_detail_create_ln_ds');
            var hd_record = $('csh_payment_req_detail_create_hd_ds').getAt(0);
            var bp_id = hd_record.get('bp_id');
            var bp_bank_account_id = hd_record.get('bp_bank_account_id');
            var bp_bank_account_name = hd_record.get('bp_bank_account_name');
            var bp_bank_account_num = hd_record.get('bp_bank_account_num');
            var bp_bank_name = hd_record.get('bp_bank_name');
            var bp_bank_branch_name = hd_record.get('bp_bank_branch_name');
            var bp_bank_full_name = hd_record.get('bp_bank_full_name');
            var description = hd_record.get('description');
            var payment_method = hd_record.get('payment_method');

            if(!payment_method){
                Leaf.showMessage('提示！', '付款方式必选！');
                return ;
            }

            if(!bp_bank_account_id){
                Leaf.showMessage('提示！', '付款对象账户必选！');
                return ;
            }

            if (ln_ds.validate()) {
                var saveData = [];
                var records = ln_ds.getAll();

                if (records.length == 0) {
                    Leaf.showMessage('提示！', '请至少维护一条记录！');
                    return;
                }

                for(var i = 0;i<records.length; i++){
                    if(records[i].get('amount')>plus(records[i].get('due_amount'), records[i].get('deduction_amount'))){
                        Leaf.showMessage('${HLS.PROMPT}', '本次申请金额大于(抵扣总额+应付金额)！');
                        return;
                    }

                    if(records[i].get('amount')>records[i].get('residual_amount')){
                        Leaf.showMessage('${HLS.PROMPT}', '第'+(i+1)+'行本次申请金额'+records[i].get('amount')+'大于剩余可申请金额'+records[i].get('residual_amount'));
                        return;
                    }
                }

                for (var i = 0; i < records.length; i++) {
                    records[i].set('bp_id', bp_id);
                    records[i].set('bp_bank_account_id', bp_bank_account_id);
                    records[i].set('bp_bank_account_name', bp_bank_account_name);
                    records[i].set('bp_bank_account_num', bp_bank_account_num);
                    records[i].set('bp_bank_name', bp_bank_name);
                    records[i].set('bp_bank_branch_name', bp_bank_branch_name);
                    records[i].set('bp_bank_full_name', bp_bank_full_name);
                    records[i].set('description', description);
                    saveData.push(records[i].data);
                }

                var winId = '${/parameter/@winId}';
                Leaf.Masker.mask($(winId).wrap, '执行中。。');
                Leaf.request({
                    url: $('csh_payment_req_create_save_link').getUrl(),
                    para: {
                        hlsCusCshPaymentReqHd : hd_record.data,
                        hlsCusCshPaymentReqLnList : saveData,
                        submitStatus : submit_status
                    },
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask($(winId).wrap);
                        csh_payment_req_create_return_action(res.result.record[0].payment_req_id, res.result.record[0].payment_req_status);
                    },
                    failure: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    error: function () {
                        Leaf.Masker.unmask($(winId).wrap);
                    },
                    scope: this
                });
            }
        }

        function csh_payment_req_create_return() {
            csh_payment_req_create_return_action();
        }

        function csh_payment_req_create_return_action(id, status) {
            setProperties(id, status);
            csh_payment_req_create_query();
            //csh_payment_req_modify_query();
            $('${/parameter/@winId}').close();

        }

        function atm_renderer(value, record, name) {
            if (!record.isNew) {
                return '<a href="javascript:win_open_attach(\'' + value + '\');">附件上传</a>';
            } else {
                return ''
            }
        }

        function contract_detail_renderer(value, record){
            if (record.isNew) {
                return '';
            }
            return '<a href="javascript:win_open_contract_detail(\'' + record.id + '\',\'' + record.ds.id + '\');">明细</a>';
        }

        function win_open_contract_detail(record_id, ds_id){
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细查询';
            param['function_code'] = 'CONT301F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['hidden_button_code'] = ['exit', 'save', 'user_button1', 'user_button2'];
            param['winid'] = 'con_contract_detail_winid';
            hls_doc_get_layout_code(param, 'con_contract_detail2_id', ds_id, 'CONT301');
        }

        function win_open_attach(payment_req_ln_id) {
            new Leaf.Window({
                id: 'open_attachment_win_id',
                url: '${/request/@context_path}/downloadFile.lview',
                params: {
                    header_id: payment_req_ln_id,
                    table_name: 'csh_payment_req_ln',
                    winid: 'open_attachment_win_id',
                    function_usage : 'QUERY'
                },
                title: '附件上传',
                width: 900,
                height: 475
            });
        }

        function deduction_renderer(value, record, name) {
            if (!record.isNew) {
                var payment_req_ln_id = record.get('payment_req_ln_id');
                var quotation_id = record.get('quotation_id');
                var amount = record.get('amount');
                return '<a href="javascript:win_open_deduction(\'' + quotation_id + '\',\'' + payment_req_ln_id + '\',\'' + amount + '\');">收付抵扣 </a>';

            } else {
                return ''
            }
        }

        function win_open_deduction(quotation_id,payment_req_ln_id, amount) {
            new Leaf.Window({
                id: 'open_deduction_create_winid',
                url: $('csh_payment_req_create_deduction_link_id').getUrl(),
                params: {
                    quotation_id: quotation_id,
                    payment_req_ln_id: payment_req_ln_id,
                    amount: amount,
                    deduct_flag:'N',
                    winId: 'open_deduction_create_winid',
                    read_only : 'Y'
                },
                title: '收付抵扣',
                width: 1350,
                height: 600
            }).on('close', function() {
                $('csh_payment_req_detail_create_ln_ds').query();
            });
        }

        function create_ln_add() {
            $('csh_payment_req_create_ln_id').showEditorByRecord($('csh_payment_req_detail_create_ln_ds').create());
            var ln_record = $('csh_payment_req_detail_create_ln_ds').getCurrentRecord();
            ln_record.set('source_doc_category', 'CON_CONTRACT');
            ln_record.set('payment_flag', 'NOT');
        }

        function contract_number_lov_before_event(lov) {
            var result_records = $('csh_payment_req_create_result_ds').getSelected();
            var result_records_all = $('csh_payment_req_detail_create_ln_ds').getAll();
            if(result_records_all.length > 0){
                var not_cashflow_ids_str = '';
                for(var i = 0; i < result_records_all.length; i++){
                    if(!!result_records_all[i].get('cashflow_id')){
                        not_cashflow_ids_str += result_records_all[i].get('cashflow_id') + ',';
                    }
                }
                lov.para = {
                    notCashflowIdsStr : not_cashflow_ids_str,
                    paymentBpId : result_records_all[0].get('bp_id'),
                    factoryId : result_records[0].get('factoryId'),
                    manufacturerId : result_records[0].get('manufacturerId'),
                    cfItem : result_records_all[0].get('cf_item'),
                    notInContractStatusStr : 'CANCEL,PENDING,NEW',
                    condition : "PAYMENT_REQ_ADD",
                    fileFlag: 'Y'
                }
            }else{
                lov.para = {
                    paymentBpId : result_records[0].get('bp_id'),
                    factoryId : result_records[0].get('factoryId'),
                    manufacturerId : result_records[0].get('manufacturerId'),
                    cfDirection : 'OUTFLOW',
                    notInContractStatusStr : 'CANCEL,PENDING,NEW',
                    condition : "PAYMENT_REQ_ADD",
                    fileFlag: 'Y'
                }
            }
        }

        function bp_bank_account_name_handler(lov){
            lov.para = {
                'bpId': $('csh_payment_req_detail_create_hd_ds').getCurrentRecord().get("bp_id")
            };
        }

        //from上的付款方式选择后事件
        function from_payment_method_n_handler_select(combo, value,  display,  record) {
            var ln_records = $('csh_payment_req_detail_create_ln_ds').getAll();
            for (var i = 0; i < ln_records.length; i++) {
                ln_records[i].set('payment_method_n', display);
            }
        }
        //from上的付款方式修改后事件
        function from_payment_method_n_handler_change(comboBox,  value, oldValue) {
            var ln_records = $('csh_payment_req_detail_create_ln_ds').getAll();
            for (var i = 0; i < ln_records.length; i++) {
                ln_records[i].set('payment_method_n', value);
            }
        }

        function csh_payment_req_detail_create_hd_ds_update(ds, record, name, value, oldvalue) {
            if (name === 'bp_name') {
                record.set('bp_bank_account_id', '');
                record.set('bp_bank_account_num', '');
                record.set('bp_bank_account_name', '');
                record.set('bp_bank_name', '');
                record.set('bp_bank_full_name', '');
            }
        }

        function create_ln_ds_update(ds, record, name, value, oldvalue) {
            if (name == 'amount') {
                var hd_ds = $('csh_payment_req_detail_create_hd_ds');
                var hd_record = hd_ds.getAt(0);


                var total_amount = 0;
                var records = ds.getAll();
                for (var i = 0; i < records.length; i++) {
                    total_amount = plus(total_amount, records[i].get('amount'));

                }
                hd_record.set('amount', total_amount);
            }
        }

        function create_bp_name_ds_query(ds, para) {
            para['contract_id'] = $('csh_payment_req_detail_create_ln_ds').getAt(0).get('contract_id');
        }

        function create_ln_ds_remove(ds, record, index) {
            var hd_ds = $('csh_payment_req_detail_create_hd_ds');
            var hd_record = hd_ds.getAt(0);

            var total_amount = 0;
            var records = ds.getAll();
            for (var i = 0; i < records.length; i++) {
                total_amount = plus(total_amount, records[i].get('amount'));
            }
            hd_record.set('amount', total_amount);
            //csh_payment_req_create_save();
        }

        function onChange_approval_comment_ta(ta,value,pre_value){
            var left_length = 200 - value.length;
            if(left_length >= 0){
                jQuery("#comment_wordLeft").removeClass("text_warning");
                jQuery("#comment_wordLeft").text("您还可以再输入" + left_length + "个字。");
            }else{
                jQuery("#comment_wordLeft").text("最多只能输入200个字");
                jQuery("#comment_wordLeft").addClass("text_warning");
            }
        }
        function onKeyPress_approval_comment_ta(field,e){
            var ta = $("approval_comment_ta");
            var comment = field.el.dom.value || '';
            ta.fireEvent("change",ta,comment,'');
        }

        Leaf.onReady(function(){
            var result_records = $('csh_payment_req_create_result_ds').getSelected();
            var form_ds = $('csh_payment_req_detail_create_hd_ds');
            form_ds.create();
            form_ds.getAt(0).set('payment_req_date', new Date());
            form_ds.getAt(0).set('amount', residual_amount);
            form_ds.getAt(0).set('bp_id', result_records[0].get('payment_bp_id'));
            form_ds.getAt(0).set('bp_name', result_records[0].get('payment_bp_name'));
            form_ds.getAt(0).set('cf_item', result_records[0].get('cf_item'));
            form_ds.getAt(0).set('contract_currency', result_records[0].get('currency'));

            for(var i = 0; i < result_records.length; i++){
                $('csh_payment_req_create_ln_id').showEditorByRecord($('csh_payment_req_detail_create_ln_ds').create());
                var ln_record = $('csh_payment_req_detail_create_ln_ds').getCurrentRecord();
                ln_record.set('cashflow_id', result_records[i].get('cashflow_id'));
                ln_record.set('bp_id', result_records[i].get('payment_bp_id'));
                ln_record.set('tenant_name', result_records[i].get('tenant_name'));
                ln_record.set('source_doc_line_id', result_records[i].get('cashflow_id'));
                ln_record.set('amount', result_records[i].get('residual_amount'));
                ln_record.set('cf_item_n', result_records[i].get('cf_item_n'));
                ln_record.set('cf_item', result_records[i].get('cf_item'));
                ln_record.set('times', result_records[i].get('times'));
                ln_record.set('due_amount', result_records[i].get('due_amount'));
                ln_record.set('residual_amount', result_records[i].get('residual_amount'));
                ln_record.set('deposit_due_amount', result_records[i].get('deposit_due_amount'));
                ln_record.set('deposit_received_amount', result_records[i].get('deposit_received_amount'));
                ln_record.set('applied_pay_amount', result_records[i].get('applied_pay_amount'));
                ln_record.set('service_charge_due_amount', result_records[i].get('service_charge_due_amount'));
                ln_record.set('service_charge_received_amount', result_records[i].get('service_charge_received_amount'));
                ln_record.set('service_charge_fee_due_amount', result_records[i].get('service_charge_fee_due_amount'));
                ln_record.set('service_charge_fee_received_amount', result_records[i].get('service_charge_fee_received_amount'));
                ln_record.set('contract_number', result_records[i].get('contract_number'));
                ln_record.set('contract_id', result_records[i].get('contract_id'));
                ln_record.set('source_doc_category', 'CON_CONTRACT');
                ln_record.set('source_doc_id', result_records[i].get('contract_id'));
                ln_record.set('payment_flag', 'NOT');
                ln_record.set('payment_type_n', result_records[i].get('payment_type_n'));
                ln_record.set('acceptance_term_n', result_records[i].get('acceptance_term_n'));
                ln_record.set('bank_deposit', result_records[i].get('bank_deposit'));
                ln_record.set('bank_lease_charge', result_records[i].get('bank_lease_charge'));
            }
            // $('csh_payment_req_detail_create_bp_name_ds').query();
        })
        ]]></script>
        <a:dataSets>
            <a:dataSet id="payment_method_combobox_ds" lookupCode="CSH.PAYMENT_METHOD"/>

            <a:dataSet id="csh_payment_req_detail_create_bp_name_ds" autoCreate="true" autoQuery="false"
                       queryUrl="${/request/@context_path}/csh/payment/req/bp/name/query">
                <a:fields>
                    <a:field name="contract_id"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="create_bp_name_ds_query"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="csh_payment_req_detail_create_hd_ds"
                       queryUrl="${/request/@context_path}/csh/payment/req/hd/query">
                <a:fields>
                    <a:field name="payment_req_date" datatype="date" readOnly="true"/>
                    <a:field name="payment_req_number" readOnly="true"/>
                    <a:field name="amount" readOnly="true"/>
                    <a:field name="bp_id"/>
                    <!--<a:field name="bp_name" required="true" returnField="bp_id" valueField="bp_id" displayField="bp_name" prompt="付款对象" options="csh_payment_req_detail_create_bp_name_ds"/>-->
                    <a:field name="bp_name" readOnly="true" />
                    <a:field name="bp_bank_account_name" required="true" requiredMessage="付款对象账户必填" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/con/contract/bp/bank/lov~hls.layout.dto.LovBpBankAccountDto" lovWidth="550"
                             title="付款对象账户" prompt="付款对象账户">
                        <a:mapping>
                            <a:map from="bank_account_id" to="bp_bank_account_id"/>
                            <a:map from="bank_account_num" to="bp_bank_account_num"/>
                            <a:map from="bank_account_name" to="bp_bank_account_name"/>
                            <a:map from="bank_full_name" to="bp_bank_name"/>
                            <a:map from="bank_full_name" to="bp_bank_full_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_bank_account_id"/>
                    <a:field name="bp_bank_name"/>
                    <a:field name="bp_bank_account_num" readOnly="true"/>
                    <a:field name="bp_bank_branch_name" readOnly="true"/>
                    <a:field name="bp_bank_full_name" readOnly="true"/>
                    <a:field name="payment_method" required="true"/>
                    <a:field name="payment_method_n" options="payment_method_combobox_ds"
                             displayField="code_value_name"
                             valueField="code_value"
                             returnField="payment_method"
                             required="true"/>
                    <a:field name="contract_currency" />
                </a:fields>
                <a:events>
                    <a:event name="update" handler="csh_payment_req_detail_create_hd_ds_update"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="csh_payment_req_detail_create_ln_ds" selectable="true">
                <a:fields>
                    <a:field name="contract_number" autoComplete="true" required="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/csh/payment/create/query~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="contract_name" to="contract_name"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="cashflow_id" to="source_doc_line_id"/>
                            <a:map from="contract_id" to="source_doc_id"/>
                            <a:map from="cf_item_n" to="cf_item_n"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="bp_name" to="tenant_name"/>
                            <a:map from="due_amount" to="amount"/>
                            <a:map from="residual_amount" to="residual_amount"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="source_doc_category" defaultValue="CON_CONTRACT"/>
                    <a:field name="tenant_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="bp_bank_account_id"/>
                    <a:field name="bp_bank_account_num"/>
                    <a:field name="bp_bank_account_name"/>
                    <a:field name="bp_bank_branch_name"/>
                    <a:field name="bp_bank_full_name"/>
                    <a:field name="service_charge_due_amount"/>
                    <a:field name="service_charge_received_amount"/>
                    <a:field name="service_charge_fee_due_amount"/>
                    <a:field name="service_charge_fee_received_amount"/>
                    <a:field name="amount" required="true" prompt="本次申请金额"/>
                    <a:field name="due_amount"/>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="create_ln_ds_update"/>
                    <a:event name="remove" handler="create_ln_ds_remove"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <!--<a:gridButton click="csh_payment_req_create_submit" text="提交审批"/>-->
                <a:gridButton click="csh_payment_req_create_return" text="HLS.RETURN"/>
                <a:gridButton click="csh_payment_req_create_save" text="HLS.SAVE"/>
            </a:screenTopToolbar>
            <a:form column="4" labelWidth="100" marginWidth="20" height="130">
                <a:textField name="payment_req_number" prompt="申请编号" width="250"
                             bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:datePicker name="payment_req_date" prompt="申请日期" width="250"
                              bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:numberField name="amount" prompt="抵扣前申请总金额" width="250" renderer="Leaf.formatMoney"
                               bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:numberField name="amount" prompt="抵扣后申请总金额" width="250" renderer="Leaf.formatMoney"
                               bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:comboBox name="bp_name" prompt="付款对象" width="250"
                             bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:lov name="bp_bank_account_name" id="bp_bank_account_name" width="250" prompt="付款对象账户" bindTarget="csh_payment_req_detail_create_hd_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="bp_bank_account_name_handler"/>
                    </a:events>
                </a:lov>
                <a:textField name="bp_bank_account_num" prompt="付款对象账号" width="250"
                             bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:textField name="bp_bank_full_name" prompt="付款对象银行" width="250"
                             bindTarget="csh_payment_req_detail_create_hd_ds"/>
                <a:comboBox name="payment_method_n" prompt="付款方式" width="250"
                            bindTarget="csh_payment_req_detail_create_hd_ds">
                    <a:events>
                        <!--<a:event name="select" handler="from_payment_method_n_handler_select"/>-->
                        <a:event name="change" handler="from_payment_method_n_handler_change"/>
                    </a:events>
                </a:comboBox>
            </a:form>
            <div id="comment_wordLeft" style="margin-left: 50px;"></div>
            <a:hBox labelSeparator=" " labelWidth="100">
                <a:textArea name="description"
                            bindTarget="csh_payment_req_detail_create_hd_ds"
                            prompt="备注" width="1200" id="approval_comment_ta" maxLength="2000">
                    <!--<a:events>
                        <a:event name="change" handler="onChange_approval_comment_ta"/>
                        <a:event name="keypress" handler="onKeyPress_approval_comment_ta"/>
                    </a:events>-->
                </a:textArea>
            </a:hBox>
            <a:grid id="csh_payment_req_create_ln_id" bindTarget="csh_payment_req_detail_create_ln_ds" marginHeight="200"
                    marginWidth="5" navBar="false" showRowNumber="true">
                <a:toolBar>
                    <a:button type="add" click="create_ln_add"/>
                    <!--<a:button text="新增" icon="${/request/@context_path}/images/add.png" style="height:16px;" click="create_ln_add"/>-->
                    <a:button type="delete"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="contract_number" prompt="合同编号" width="150" editor="csh_payment_req_create_number_lov"/>
                    <a:column name="tenant_name" width="250" prompt="承租人"/>
                    <a:column name="cf_item_n" prompt="应付项目" width="70"/>
                    <!--<a:column name="times" prompt="期数" width="50" align="right"/>-->
                    <a:column name="due_amount" prompt="应付金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="amount" prompt="本次申请金额" align="right" editor="csh_payment_req_create_nf"
                              renderer="Leaf.formatMoney" width="100"/>
                    <a:column prompt="收付抵扣" align="center" renderer="deduction_renderer" width="80"/>
                    <a:column name="deduction_amount" prompt="抵扣总额" align="right" renderer="Leaf.formatMoney"
                              width="100"/>
                    <a:column name="applied_pay_amount" prompt="已申请金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="deposit_due_amount" prompt="保证金金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="deposit_received_amount" prompt="已收保证金金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="service_charge_due_amount" prompt="服务费金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="service_charge_received_amount" prompt="已收服务费金额" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="service_charge_fee_due_amount" prompt="服务费(贴息)" align="right" renderer="Leaf.formatMoney" width="120"/>
                    <a:column name="service_charge_fee_received_amount" prompt="已收服务费(贴息)" align="right" renderer="Leaf.formatMoney" width="120"/>
                    <a:column name="payment_method_n" width="120" prompt="付款方式"/>
                    <!--<a:column name="acceptance_term_n" width="120" prompt="承兑期限"/>
                    <a:column name="bank_deposit" prompt="银承保证金" align="right" renderer="Leaf.formatMoney" width="120"/>
                    <a:column name="bank_lease_charge" prompt="银承手续费" align="right" renderer="Leaf.formatMoney" width="120"/>-->
                    <a:column name="payment_req_ln_id" prompt="附件" align="center" renderer="atm_renderer" width="80"/>
                    <a:column name="contract_detail" prompt="合同明细" align="center" renderer="contract_detail_renderer" width="80"/>
                </a:columns>
                <a:editors>
                    <a:lov id="csh_payment_req_create_number_lov">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="contract_number_lov_before_event"/>
                        </a:events>
                    </a:lov>
                    <a:numberField id="csh_payment_req_create_nf" />
                </a:editors>
            </a:grid>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
