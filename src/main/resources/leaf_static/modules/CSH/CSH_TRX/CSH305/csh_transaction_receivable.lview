<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2019年2月19日
    $Revision: 1.0
    $Purpose: 收款管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[

        Leaf.onReady(function () {
            debugger;
            var ds = $('csh_transaction_receivable_query_ds');
            var record = ds.getCurrentRecord();
            var date = new Date();
            date.setDate(1);
            var dateStart = date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate();
            record.set('due_date_from', dateStart);
            record.set('due_date_to', CurrentMonthLast());
        });

        function CurrentMonthLast() {
            debugger;
            var date = new Date();
            var currentMonth = date.getMonth();
            var nextMonth = ++currentMonth;
            var nextMonthFirstDay = new Date(date.getFullYear(), nextMonth, 1);
            var oneDay = 1000 * 60 * 60 * 24;
            return new Date(nextMonthFirstDay - oneDay);
        }

        function csh305_transaction_query() {
            $('csh_transaction_receivable_result_ds').query();
        }

        function csh305_transaction_reset() {
            $('csh_transaction_receivable_query_ds').reset();
        }

        ]]></script>

        <a:dataSets>

            <a:dataSet id="spv_company_ds" lookupCode="SPV_COMPANY"/>
            <a:dataSet id="posted_flag_ds" lookupCode="CSH.POST_SELECT"/>

            <a:dataSet id="csh_transaction_receivable_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="spv_company_n" displayField="code_value_name" options="spv_company_ds"
                             returnField="spv_company" valueField="code_value"/>
                    <a:field name="due_date_from"/>
                    <a:field name="due_date_to"/>

                    <a:field name="unit_name" autoComplete="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/csh/unit/query/lov~com.hand.hls.layout.dto.LovCshUnitDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="unit_id" to="unit_id"/>
                            <a:map from="unit_code" to="unit_code"/>
                            <a:map from="unit_name" to="unit_name"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
            </a:dataSet>
            <a:dataSet id="csh_transaction_receivable_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/csh/all/con/cashflow/home"
                       queryDataSet="csh_transaction_receivable_query_ds"
                       selectable="true">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="project_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="unit_name"/>
                    <a:field name="due_date"/>
                    <a:field name="due_amount"/>
                    <a:field name="received_amount"/>
                    <a:field name="surplus_amount"/>
                    <a:field name="cf_item_desc"/>
                    <a:field name="payment_method_n"/>
                    <a:field name="spv_company_n"/>
                </a:fields>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="csh305_transaction_query" text="HLS.QUERY"/>
                <a:gridButton click="csh305_transaction_reset" text="HLS.RESET"/>
            </a:screenTopToolbar>
            <a:form bindTarget="" labelWidth="120" marginWidth="80"
                    title="查询条件" style="margin-left:20px">
                <a:hBox>
                    <a:fieldSet column="4" labelWidth="150" title="HLS.QUERY_TITLE">
                        <a:datePicker name="due_date_from" bindTarget="csh_transaction_receivable_query_ds"
                                      prompt="起始日期"/>
                        <a:datePicker name="due_date_to" bindTarget="csh_transaction_receivable_query_ds"
                                      prompt="截止日期"/>
                        <a:textField name="bp_name" bindTarget="csh_transaction_receivable_query_ds" prompt="客户名称"/>
                        <a:textField name="project_name" bindTarget="csh_transaction_receivable_query_ds"
                                     prompt="项目名称"/>
                        <a:textField name="contract_number" bindTarget="csh_transaction_receivable_query_ds"
                                     prompt="合同编号"/>
                        <a:lov name="unit_name" bindTarget="csh_transaction_receivable_query_ds" prompt="部门"/>
                        <a:comboBox name="spv_company_n" bindTarget="csh_transaction_receivable_query_ds"
                                    prompt="公司/SPV"/>
                        <a:lov name="cf_item_desc" bindTarget="csh_transaction_receivable_query_ds" prompt="款项类型"/>
                        <a:checkBox name="receipt_flag" bindTarget="csh_transaction_receivable_query_ds"
                                    prompt="仅显示有剩余应收的记录"/>
                    </a:fieldSet>
                </a:hBox>
            </a:form>
            <a:fieldSet labelWidth="150" title="应收查询" style="margin-left:20px">
                <a:grid id="csh_transaction_receivable_grid_ds" bindTarget="csh_transaction_receivable_result_ds"
                        marginHeight="190" marginWidth="80" navBar="true">
                    <a:columns>
                        <a:column name="bp_name" prompt="客户名称" width="150" align="center"/>
                        <a:column name="project_name" prompt="项目名称" width="150" align="center"/>
                        <a:column name="contract_number" align="right" prompt="合同编号" width="120"/>
                        <a:column name="cf_item_desc" align="center" prompt="款项类型" width="100"/>
                        <a:column name="due_date" prompt="应收日期" align="right" width="100"/>
                        <a:column name="due_amount" prompt="应收金额" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="received_amount" prompt="已收金额" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="surplus_amount" prompt="未收金额" align="right" renderer="Leaf.formatMoney"
                                  width="100"/>
                        <a:column name="payment_method_n" prompt="收取方式" align="center" width="100"/>
                        <a:column name="spv_company_n" prompt="公司/SPV" align="center" width="100"/>
                        <a:column name="unit_name" prompt="部门" align="center" width="100"/>
                    </a:columns>
                </a:grid>
            </a:fieldSet>
        </a:screenBody>
        <script><![CDATA[
        ]]></script>
    </a:view>
</a:screen>
