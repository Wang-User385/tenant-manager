<?xml version="1.0" encoding="UTF-8"?>
<!--
    链接到功能号的 小微件(270x70)
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript" src="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.js"></script>
        <link href="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.css" rel="stylesheet" type="text/css"/>
        <style>
            .link_widget_${/parameter/@rule_id} {
                width: 270px;
                height: 70px;
                background: #FFFFFF;
                border: 1px solid #F0F0F3;
                cursor: pointer;
                box-sizing: border-box;
            }
            .link_widget_${/parameter/@rule_id} .icon {
                float: left;
                height: 100%;
                width: 33px;
                text-align: center;
                border-top: 4px solid #FFFFFF;
                margin-left: 20px;
            }
            .link_widget_${/parameter/@rule_id} .icon img{
                width: 33px;
                margin-top: 12px;
            }
            .link_widget_${/parameter/@rule_id} .content {
                margin-left: 20px;
                height: 100%;
                float: left;
            }
            .link_widget_${/parameter/@rule_id} .content .widget_title{
                font-size: 14px;
                color: rgba(75, 80, 90, 0.85);
                letter-spacing: 0;
                margin-top: 13px;
                width:180px;
                white-space:nowrap;
                overflow:hidden;
                text-overflow : ellipsis;
            }
            .link_widget_${/parameter/@rule_id} .content .desc{
                font-size: 12px;
                color: rgba(75, 80, 90, 0.75);
                letter-spacing: 0;
                margin-top: 4px;
                width:180px;
                white-space:nowrap;
                overflow:hidden;
                text-overflow : ellipsis;
            }
            .link_widget_${/parameter/@rule_id} .clearFloat{
                clear:both;
                height:0;
                line-height:0;
                font-size:0
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/javascripts/home_widget/home_widget.js"></script>
        <script><![CDATA[
        Leaf.onReady(function(){
            if(!!"${/parameter/@rule_id}"){
                var widget_grid_rule;
                homeWidgetCommon.getWidgetModelByRuleId({
                    ruleId: '${/parameter/@rule_id}',
                    basePath: '${/request/@context_path}',
                    pagenum: 1,
                    pagesize: 5,
                    callback:function(res,seq,metadataId){
                        new LinkWidget(res);
                    }
                });
            }
            function LinkWidget(res){
                // 属性值
                var obj = {};
                res.ruleValue.forEach(function(ruleObj,i){
                    obj[ruleObj.propField] = ruleObj.widgetsPropValue;
                });
                jQuery(".link_widget_${/parameter/@rule_id} .content .widget_title").text(obj.title || '');
                jQuery(".link_widget_${/parameter/@rule_id} .content .desc").text(obj.desc || '');
                jQuery(".link_widget_${/parameter/@rule_id} .content .desc").attr('title',(obj.desc || ''));
                jQuery(".link_widget_${/parameter/@rule_id} .icon").css("border-color",obj.themeColor || '#5A7FFF');
                jQuery(".link_widget_${/parameter/@rule_id} .icon img").attr("src","${/request/@context_path}/" + obj["icon"] || '');
                jQuery(".link_widget_${/parameter/@rule_id}").data("fncode", obj["functionCode"] || '');
                jQuery(".link_widget_${/parameter/@rule_id}").data("fnname", obj["title"] || '');
            }
        });
        window["click_link_widget_${/parameter/@rule_id}"] = function(e){
            var fncode = jQuery(e.currentTarget).data("fncode");
            var fnname = jQuery(e.currentTarget).data("fnname");
            if(!!fncode){
                if(fncode.startsWith("http")){
                    window.open(fncode);
                }else {
                    Leaf.request({
                        url: '${/request/@context_path}/sys/resource/queryMainByFnCode',
                        scope: this,
                        method: 'GET',
                        para: {
                            fncode: fncode
                        },
                        success: function (res) {
                            if (!!res.result && !!res.result.record[0].url) {
                                var fnurl = res.result.record[0].url;
                                if (fnurl.indexOf("?") == -1) {
                                    top.mainJumpUrl(fnurl + "?function_code=" + fncode, fnname, fncode, '微件', null, 'two')
                                } else {
                                    top.mainJumpUrl(fnurl + "&function_code=" + fncode, fnname, fncode, '微件', null, 'two')
                                }
                            } else {
                                Leaf.showErrorMessage("错误", "未找到功能号-" + fncode + "对应资源")
                            }
                        }
                    });
                }
            }
        }
        ]]></script>
        <a:screenBody style="display:none;"></a:screenBody>
        <div class="link_widget_${/parameter/@rule_id}" onclick="click_link_widget_${/parameter/@rule_id}(event)">
            <div class="icon">
                <img src=""/>
            </div>
            <div class="content">
                <div class="widget_title"></div>
                <div class="desc"></div>
            </div>
        </div>
    </a:view>
</a:screen>