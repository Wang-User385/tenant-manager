<?xml version="1.0" encoding="UTF-8"?>
<!--
    单列报表 微件
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript" src="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.js"></script>
        <link href="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.css" rel="stylesheet" type="text/css"/>
        <script type="text/javascript" src="${/request/@context_path}/javascripts/home_widget/home_widget.js"></script>

        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <style>
            .base_list_widget_${/parameter/@rule_id}_wrap{
                box-sizing:border-box;
                background-color:#fff;
                position:relative;
                border:1px solid #F0F0F3;
                padding:0;
                user-select:none;
                cursor:default;
                width:270px;
                height: 450px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap label, p {
                padding: 0;
                margin: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .clearFloat{
                clear: both;
                height: 0;
                line-height: 0;
                font-size: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .widget_label{
                position:absolute;
                width:40px;
                height:4px;
                top:0;
                left:16px;
                background: #5A7FFF;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .widget_title{
                position:relative;
                height:30px;
                line-height:30px;
                margin:7px 0;
                padding:0 16px;
                font-family: PingFangSC-Medium;
                font-size: 14px;
                color: rgba(75,80,90,0.85);
                letter-spacing: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid{
                position:relative;
                box-sizing: border-box;
                margin: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .hls-pagging-grid {
                width: 253px;
                height:400px;
                -webkit-box-shadow: none;
                -moz-box-shadow: none;
                box-shadow: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-title {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body {
                color: rgba(93,97,103,0.85);
                padding: 0;
                overflow: hidden;
                border-top: 1px solid #F0F0F3;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar { /*滚动条整体样式*/
                width: 4px; /*高宽分别对应横竖滚动条的尺寸*/
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 2px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background: rgba(0, 0, 0, 0.2);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background: rgba(0, 0, 0, 0.1);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table {
                border-collapse: collapse;
                width:100%;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table>tr {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr {
                font-size: 12px;
                height: 56px;
                border-bottom: 1px solid #F0F0F3;
                overflow: auto;
                color: rgba(93,97,103,0.85);
                padding:0 10px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr:hover{
                background-color: rgba(90,127,255,0.08);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot {
                position: absolute;
                /*height: 36px;*/
                bottom: 0;
                left: 0;
                width: 100%;
                text-align: right;
                background: #fff;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot>span{
                display: inline-block;
                height: 36px;
                line-height: 36px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .page-count img {
                width: 10px;
                cursor: pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_end_page {
                margin-right: 1px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_page {
                margin-right: 2px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_page_number {
                width: 16px;
                height: 16px;
                text-align: center;
                border-radius: 2px;
                box-shadow: none;
                border: 1px solid #D9D9D9;
                font-family: HelveticaNeue;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.75);
                line-height: 16px;
                margin-right: 2px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_total_message {
                margin-right: 2px;
                font-family: HelveticaNeue;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.45);
                letter-spacing: 0;
                line-height: 16px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_page {
                margin-right: 1px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_end_page {
                margin-right: 2px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message {
                min-width: 165px;
                /*最小宽度取三个数字均为三位数时的宽度*/
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_num {
                font-family: PingFangSC-Regular;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.45);
                letter-spacing: 0;
                text-align: center;
                margin-right: 2px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_refresh {
                height: 12px;
                margin-right:5px;
                cursor: pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table .hls-text-len-hidden{
                display:inline-block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .hls-text-len-hidden-pop-window{ /* 文本溢出提示框 */
                position:fixed;
                display: none;
                z-index:1000;
                padding:6px 10px;
                color:#fff;
                background: rgb(0,0,0);
                border-radius: 3px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow{
                box-sizing: border-box;
                height: 56px;
                width: 100%;
                padding: 5px 16px;
                font-family: PingFangSC-Regular;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1{
                height: 17px;
                width: 100%;
                margin-bottom: 8px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow2{
                height: 14px;
                width: 100%;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1 .listName{
                float: left;
                max-width: 130px;
                overflow: hidden;
                line-height: 17px;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-size: 12px;
                color: rgba(75,80,90,0.75);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1 .listAttr1{
                float: right;
                max-width: 90px;
                overflow: hidden;
                line-height: 17px;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-size: 12px;
                color: rgba(75,80,90,0.45);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow2 .row2Left{
                float: left;
                line-height: 14px;
                font-family: Baskerville;
                font-size: 12px;
                color: #4866CC;
                text-align: left;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow2 .attr2Icon{
                margin-right: 8px;
                max-height: 14px;
                vertical-align: bottom;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow2 .row2Right{
                float: right;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow2 .row2Right .icon{
                max-height: 14px;
                vertical-align: bottom;
                cursor: pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .file_item{
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                width: 253px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .file_item .file_name{

            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .file_item .file_description{
                cursor: pointer;
            }
        </style>
        <script><![CDATA[
        window["freshOnClose_${/parameter/@rule_id}"] = "N" ;
        window["datasetArr_${/parameter/@rule_id}"] = [];
        window['${/parameter/@rule_id}_grid_detailIconUrl'] = '';
        Leaf.onReady(function(){
            function getResData(res,dataset){
                var obj = {};
                //复制头信息
                if(res.ruleValue && res.ruleValue.length){
                    for(var i = 0; i < res.ruleValue.length;i++){
                        obj[res.ruleValue[i].propField] = res.ruleValue[i]['widgetsPropValue'];
                    }
                }
                //复制数据源
                if(res.result && res.result.record && res.result.record.length){
                    var datas = res.result.record;
                    for(var  i = 0; i < datas.length; i++){
                        dataset.add(new Leaf.Record(datas[i]));
                    }
                }
                //grid列信息
                obj.columns = [{
                    template:function (record,index){
                        var html='';
                        var listName = record.get("name");
                        var description = record.get('file');
                        var text = description;

                        html = '<div class="file_item" title="'+text+'"><img style="display: inline-block;width: 25px;" src="${/request/@context_path}/lib/assets/pages/img/mark_link.png"/><span style="vertical-align: super;padding-left: 10px;" class="file_description">'+description+'</span></div>';

                        return html;
                    }
                }];
                obj['id'] = '${/parameter/@rule_id}_base_grid';
                obj['container'] = jQuery(".base_list_widget_${/parameter/@rule_id}");
                obj['dataSource'] = dataset;
                obj['basePath'] = '${/request/@context_path}';
                obj['rowClick'] = '${/parameter/@rule_id}_grid_click';
                return obj;
            }
            if(!!"${/parameter/@rule_id}"){
                var widget_grid_rule;
                homeWidgetCommon.getWidgetModelByRuleId({
                    ruleId: '${/parameter/@rule_id}',
                    basePath: '${/request/@context_path}',
                    pagenum: 1,
                    pagesize: 5,
                    callback:function(res,seq,metadataId){
                        window["freshOnClose_${/parameter/@rule_id}"] = getRuleValueByPropField(res,"freshOnClose");
                        if(seq>1){
                            console.error("微件数据源配置错误:微件" + "${/parameter/@rule_id}" + "只能配置单个数据源");
                            return
                        }
                        var dataset = new Leaf.DataSet();
                        dataset.setQueryUrl('${/request/@context_path}/meta/data/query?ruleId=${/parameter/@rule_id}&metadataId='+metadataId);
                        dataset.totalCount = res.result.totalCount;
                        dataset.pagesize = 5;
                        var obj = getResData(res,dataset);
                        var title = getRuleValueByPropField(res,"title");
                        window['${/parameter/@rule_id}_grid_detailIconUrl'] = getRuleLinkByPropField(res,"detailLink") || '';
                        jQuery(".base_list_widget_${/parameter/@rule_id}_wrap .widget_title").text(title || '基础列表')
                        dataset['on']('load',function(){
                            widget_grid_rule.reflash(dataset);
                        });
                        window["datasetArr_${/parameter/@rule_id}"].push(dataset);
                        widget_grid_rule = new widgetGrid(obj,dataset);
                    }
                });
            }
        });
        window['${/parameter/@rule_id}_grid_click'] = function(record,index){
            var fileName = record.get('fileName');
            var attachmentId = record.get('attachmentId');
            if(checkPdf(fileName)){
                var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentId);
                window.open('${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url,'_blank');
            }else if(checkVdieo(fileName)){

                window.open('${/request/@context_path}/modules/WIDGET/WIDGET_MODEL/vdieo_common.lview?attachment_id=' + attachmentId,'_blank');
            }else{
                window.open('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentId,'_blank');
            }

        };
        function checkPdf(name){
            return /\.(pdf)$/i.test(name);
        }
        function checkVdieo(name) {
            return /\.(mp4)$/i.test(name);
        }
        function getRuleValueByPropField(res,propfield) {
            var ret = "";
            if (!!res.ruleValue && !!res.ruleValue.forEach) {
                res.ruleValue.forEach(function (obj, i) {
                    if (obj.propField.toLowerCase() == propfield.toLowerCase()) {
                        ret = obj.widgetsPropValue;
                    }
                });
            }
            return ret;
        }
        function getRuleLinkByPropField(res,propfield) {
            var ret = "";
            if (!!res.ruleLink && !!res.ruleLink.forEach) {
                res.ruleLink.forEach(function (obj, i) {
                    if (obj.propField.toLowerCase() == propfield.toLowerCase()) {
                        ret = obj.widgetsPropValue;
                    }
                });
            }
            return ret;
        }
        function transferDate(date){
            var today=new Date();
            var days=Math.floor(Math.abs(today-date)/1000/60/60/24);
            var leave1 = (date.getTime()-today.getTime()) % (24 * 3600 * 1000)    //计算天数后剩余的毫秒数
            var hours = Math.floor(leave1 / (3600 * 1000))//计算出小时数
            var leave2 = leave1 % (3600 * 1000)    //计算小时数后剩余的毫秒数
            var minutes = Math.floor(leave2 / (60 * 1000))//计算相差分钟数
            var weekday=["周日","周一","周二","周三","周四","周五","周六"];
            var dateStr='';
            if(days == 0 && hours!=0){
                dateStr = Math.abs(hours) + ((hours > 0) ? '小时后' : "小时前" );
            }else if(days == 0 && hours==0 && minutes!=0){
                dateStr = Math.abs(minutes) + ((minutes > 0) ? '分钟后' : "分钟前" );
            }else{
                dateStr=date.getFullYear()+'.'+(date.getMonth()+1)+'.'+date.getDate()+'/'+weekday[date.getDay()];
            }
            return dateStr;
        }
        function transferDouble(num){
            num = num.toString();
            return Leaf.formatNumber(num);
        }
        window['toLineCase'] = function (name) {
            return name.replace(/([A-Z])/g,"_$1").toLowerCase();
        }
        window['widgetOpenWin_${/parameter/@rule_id}'] = function (url){
            if(url.indexOf('?')<0){
                url+='?id=${/parameter/@rule_id}&winid=${/parameter/@rule_id}_winid';
            }else{
                url+='&id=${/parameter/@rule_id}&winid=${/parameter/@rule_id}_winid';
            }
            new Leaf.Window({
                id: '${/parameter/@rule_id}_winid',
                url: "${/request/@context_path}/modules/WIDGET/WIDGET_COMMON/widget_common_link.lview",
                params: {
                    url: url,
                    id:'${/parameter/@rule_id}'
                },
                title: '明细',
                side:'right',
                fullScreen: true
            }).on("close",function(){
                if(window["freshOnClose_${/parameter/@rule_id}"] && window["freshOnClose_${/parameter/@rule_id}"]=="Y"){
                    window['refreshWidgetDs_${/parameter/@rule_id}']();
                }
            });
        }
        window['refreshWidgetDs_${/parameter/@rule_id}'] = function(){
            if(window["datasetArr_${/parameter/@rule_id}"] && window["datasetArr_${/parameter/@rule_id}"].length && window["datasetArr_${/parameter/@rule_id}"].length>0){
                debugger
                window["datasetArr_${/parameter/@rule_id}"].forEach(function(ds){
                    if(ds && ds.query) ds.query();
                });
            }
        }
        ]]></script>
        <a:screenBody style="display:none;"></a:screenBody>
        <div class="base_list_widget_${/parameter/@rule_id}_wrap">
            <span class="widget_label"></span>
            <div class="widget_title"></div>
            <div class="base_list_widget_${/parameter/@rule_id} grid"></div>
        </div>
    </a:view>
</a:screen>