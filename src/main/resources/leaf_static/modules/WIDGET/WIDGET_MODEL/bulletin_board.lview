<?xml version="1.0" encoding="UTF-8"?>
<!--
    公告栏 微件
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript" src="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.js"></script>
        <link href="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.css" rel="stylesheet" type="text/css"/>
        <script type="text/javascript" src="${/request/@context_path}/javascripts/home_widget/home_widget.js"></script>
        <style>
            .base_list_widget_${/parameter/@rule_id}_wrap{
                box-sizing:border-box;
                background-color:#fff;
                position:relative;
                border:1px solid #F0F0F3;
                padding:0;
                user-select:none;
                cursor:default;
                width:264px;
                height: 342px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap label, p {
                padding: 0;
                margin: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .clearFloat{
                clear: both;
                height: 0;
                line-height: 0;
                font-size: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .widget_label{
                position:absolute;
                width:40px;
                height:4px;
                top:0;
                left:16px;
                background: #5A7FFF;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .widget_title{
                position:relative;
                height:22px;
                width: 42px;
                margin:12px 0 0 0;
                padding:0 16px;
                letter-spacing: 0;
                font-family: PingFangSC-Medium;
                font-size: 14px;
                color: rgba(93,97,103,0.85);
                text-align: left;
                line-height: 22px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .moreInformation{
                position:absolute;
                height:20px;
                width: 60px;
                top:12px;
                right:12px;
                letter-spacing: 0;
                font-family: PingFangSC-Regular;
                font-size: 12px;
                color: rgba(93,97,103,0.70);
                text-align: left;
                line-height: 20px;
                cursor:pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .dividing_line{
                position:absolute;
                height:1px;
                width: 264px;
                top:44px;
                background: #F0F0F3;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap img{
                position:relative;
                height:120px;
                width:240px;
                margin:20px 12px 7px 12px;
                background: #FFFFFF;
                border-style: none;
                cursor:pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .mask{
                position:absolute;
                height:24px;
                width: 240px;
                top:150px;
                left: 12px;
                right: 12px;
                background: rgba(41,66,97,0.70);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .mask .index{
                font-family: PingFangSC-Regular;
                font-size: 12px;
                color: #FFFFFF;
                text-align: left;
                left: 8px;
                position: absolute;
                top:4px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid{
                position:relative;
                box-sizing: border-box;
                margin: 0;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .hls-pagging-grid {
                width: 253px;
                height:160px;
                -webkit-box-shadow: none;
                -moz-box-shadow: none;
                box-shadow: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-title {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body {
                color: rgba(93,97,103,0.85);
                padding: 0;
                overflow: auto;
                border:none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar { /*滚动条整体样式*/
                width: 4px; /*高宽分别对应横竖滚动条的尺寸*/
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 2px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background: rgba(0, 0, 0, 0.2);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background: rgba(0, 0, 0, 0.1);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table {
                border-collapse: collapse;
                width:100%;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table>tr {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr {
                font-size: 12px;
                height: 32px;
                border:none;
                overflow: auto;
                color: rgba(93,97,103,0.85);
                padding:0 10px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr:hover{
                background-color: rgba(90,127,255,0.08);
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot>span{
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .page-count img {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_end_page {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_page {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_page_number {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_total_message {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_page {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_end_page {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_num {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_refresh {
                display: none;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body table .hls-text-len-hidden{
                display:inline-block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .hls-text-len-hidden-pop-window{ /* 文本溢出提示框 */
                position:fixed;
                display: none;
                z-index:1000;
                padding:6px 10px;
                color:#fff;
                background: rgb(0,0,0);
                border-radius: 3px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow{
                box-sizing: border-box;
                height: 20px;
                width: 100%;
                padding: 5px 0px;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1{
                height: 17px;
                width: 100%;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1 .listName{
                float: left;
                max-width: 170px;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-size: 12px;
                font-family: PingFangSC-Regular;
                color: rgba(0,0,0,0.56);
                text-align: left;
                line-height: 20px;
                margin-left: 12px;
                cursor: pointer;
            }
            .base_list_widget_${/parameter/@rule_id}_wrap .grid .grid-body .listRow1 .listAttr1{
                float: right;
                width: 37px;
                height: 18px;
                overflow: hidden;
                line-height: 17px;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-size: 12px;
                color: rgba(75,80,90,0.45);
            }
        </style>
        <script><![CDATA[
        window['${/parameter/@rule_id}_grid_detailIconUrl'] = '';
        window['${/parameter/@rule_id}_moreInformationUrl'] = '';
        Leaf.onReady(function(){
            function getResData(res,dataset){
                var obj = {};
                //复制头信息
                if(res.ruleValue && res.ruleValue.length){
                    for(var i = 0; i < res.ruleValue.length;i++){
                        obj[res.ruleValue[i].propField] = res.ruleValue[i]['widgetsPropValue'];
                    }
                }
                //复制数据源
                if(res.result && res.result.record && res.result.record.length){
                    var datas = res.result.record;
                    for(var  i = 0; i < datas.length; i++){
                        dataset.add(new Leaf.Record(datas[i]));
                    }
                }
                //grid列信息
                obj.columns = [{
                    template:function (record,index){
                        var html='';
                        var listName = record.get("name");
                        var listAttr1 = record.get("attr1") || '无';
                        var noticeId = record.get("noticeId");

                        html+='<div class="listRow">' +
                            '<div class="listRow1" onclick="onClick_msg_notice(\'' + noticeId + '\')">' +
                            '<span class="listName" title="'+ listName +'">' + listName + '</span>' +
                            '<span class="listAttr1">' + listAttr1 + '</span>' +
                            '<span class="clearFloat"></span>' +
                            '</div>'
                        return html;
                    }
                }];
                obj['id'] = '${/parameter/@rule_id}_base_grid';
                obj['container'] = jQuery(".base_list_widget_${/parameter/@rule_id}");
                obj['dataSource'] = dataset;
                obj['basePath'] = '${/request/@context_path}';
                // obj['rowClick'] = '${/parameter/@rule_id}_grid_click';
                return obj;
            }
            if(!!"${/parameter/@rule_id}"){
                var widget_grid_rule;
                homeWidgetCommon.getWidgetModelByRuleId({
                    ruleId: '${/parameter/@rule_id}',
                    basePath: '${/request/@context_path}',
                    pagenum: 1,
                    pagesize: 5,
                    callback:function(res,seq,metadataId){
                        if(seq>1){
                            console.error("微件数据源配置错误:微件" + "${/parameter/@rule_id}" + "只能配置单个数据源");
                            return
                        }
                        var dataset = new Leaf.DataSet();
                        dataset.setQueryUrl('${/request/@context_path}/meta/data/query?ruleId=${/parameter/@rule_id}&metadataId='+metadataId);
                        dataset.totalCount = res.result.totalCount;
                        dataset.pagesize = 5;
                        var obj = getResData(res,dataset);
                        var title = getRuleValueByPropField(res,"title");
                        var index = getRuleValueByPropField(res,"index");
                        window['${/parameter/@rule_id}_moreInformationUrl'] = getRuleLinkByPropField(res,"moreInformation") || '';
                        if(!window['${/parameter/@rule_id}_moreInformationUrl']){
                            document.getElementById("moreInformation").style.display='none';
                        }
                        jQuery(".base_list_widget_${/parameter/@rule_id}_wrap .widget_title").text(title || '基础列表')
                        jQuery(".base_list_widget_${/parameter/@rule_id}_wrap .index").text(index || '基础语句')
                        dataset['on']('load',function(){
                            widget_grid_rule.reflash(dataset);
                        });
                        widget_grid_rule = new widgetGrid(obj,dataset);
                    }
                });
            }
        });
        function onClick_msg_notice(noticeId) {
            Leaf.request({
                url: "${/request/@context_path}/hls/system/notice/query",
                para: {
                    noticeId : noticeId
                },
                success: function(res) {
                    record = res.result.record[0];
                },
                sync: true,
                scope: this
            });
            if(record.notice_url){
                var url = record.notice_url;
                if(!(url.charAt(0)=='/')){
                    url='/'+url;
                }
                var noticeWin = new Leaf.Window({
                    id: 'sys_notice_url',
                    url: '${/request/@context_path}/modules' + url,
                    params: {
                        winid: 'sys_notice_url'
                    },
                    title: '明细',
                    fullScreen: true
                });
                noticeWin.on('close', function () {
                    if(record.read_flag != "Y"){
                        setNoticeRead(record.notice_id);
                    }
                });
            }else{
                var detail = '';
                detail += !!record.notice_message ? "消息内容  :  " + record.notice_message + "</br>" : '' ;
                detail += !!record.source_user_name ? "来源用户  :  " + record.source_user_name + "(id:" + record.source_user_id + ")" + "</br>" : '' ;
                detail += (!!record.source_document_category && !!record.source_document_id) ? "来源单据  :  " + record.source_document_category + " (id:" + record.source_document_id + ") " + "</br>" : '' ;
                Leaf.showInfoMessage(record.notice_title||"消息",detail,function(){
                    if(record.read_flag != "Y"){
                        setNoticeRead(record.notice_id);
                    }
                },582,405);
            }
        }
        function setNoticeRead(notice_id){
            //消息已读
            Leaf.request({
                url: 'hls/system/notice/setread',
                scope: this,
                para: {
                    notice_id: notice_id
                },
                success: function (res) {
                }
            })
        }
        function getRuleValueByPropField(res,propfield) {
            var ret = "";
            if (!!res.ruleValue && !!res.ruleValue.forEach) {
                res.ruleValue.forEach(function (obj, i) {
                    if (obj.propField.toLowerCase() == propfield.toLowerCase()) {
                        ret = obj.widgetsPropValue;
                    }
                });
            }
            return ret;
        }
        function getRuleLinkByPropField(res,propfield) {
            var ret = "";
            if (!!res.ruleLink && !!res.ruleLink.forEach) {
                res.ruleLink.forEach(function (obj, i) {
                    if (obj.propField.toLowerCase() == propfield.toLowerCase()) {
                        ret = obj.widgetsPropValue;
                    }
                });
            }
            return ret;
        }
        window['widgetOpenWin_${/parameter/@rule_id}'] = function (url){
            new Leaf.Window({
                id: '${/parameter/@rule_id}_winid',
                url: "${/request/@context_path}/modules/WIDGET/WIDGET_COMMON/widget_common_link.lview",
                params: {
                    url: url,
                    id:'${/parameter/@rule_id}',
                    winid:'${/parameter/@rule_id}_winid'
                },
                title: '明细',
                side:'right',
                fullScreen: true
            });
        }
        function click_moreInformation(){
            url = window['${/parameter/@rule_id}_moreInformationUrl'];
            if(!url){
                return false;
            }
            new Leaf.Window({
                id: '${/parameter/@rule_id}_winid',
                url: url,
                title: '查看更多',
                side:'right',
                fullScreen: true
            });
        }
        ]]></script>
        <a:screenBody style="display:none;"></a:screenBody>
        <div class="base_list_widget_${/parameter/@rule_id}_wrap">
            <span class="widget_label"></span>
            <div class="widget_title"></div>
            <div class="moreInformation" id="moreInformation" onclick="click_moreInformation()">
                <span>查看更多></span>
            </div>
            <img src="${/request/@context_path}/leafresources/images/widget/mask@2x.png"/>
            <div class="mask">
                <span class="index"></span>
            </div>
            <span class="dividing_line"></span>
            <div class="base_list_widget_${/parameter/@rule_id} grid"></div>
        </div>
    </a:view>
</a:screen>