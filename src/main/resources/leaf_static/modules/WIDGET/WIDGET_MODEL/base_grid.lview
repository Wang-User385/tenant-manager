<?xml version="1.0" encoding="UTF-8"?>
<!--
    基础报表 微件
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <style>
            a{
                color: blue;  /*将a标签的字体修改为红色*/
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap{
                box-sizing:border-box;
                background-color:#fff;
                position:relative;
                border:1px solid #F0F0F3;
                padding:0;
                user-select:none;
                cursor:default;
                min-width: 330px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab{
                padding: 0px 16px 10px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab span{
                display: inline-block;
                width: 64px;
                height: 24px;
                line-height: 24px;
                font-family: PingFangSC-Regular;
                font-size: 12px;
                letter-spacing: 0;
                text-align: center;
                cursor: pointer;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab span:first-child{
                border-radius: 4px 0px 0px 4px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab span:last-child{
                border-radius: 0px 4px 4px 0px;
                left: -1px;
                position: relative;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab .unhover{
                position: relative;
                border: 1px solid rgba(75,80,90,0.15);
                color: rgba(75,80,90,0.75);
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .tab .hover{
                border: 1px solid #5A7FFF;
                color: #5A7FFF;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap label, p {
                padding: 0;
                margin: 0;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .widget_label{
                position:absolute;
                width:40px;
                height:4px;
                top:0;
                left:16px;
                background: #5A7FFF;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .widget_title{
                position:relative;
                height:30px;
                line-height:30px;
                margin-top:14px;
                padding:0 16px;
                font-family: PingFangSC-Medium;
                font-size: 14px;
                color: rgba(75,80,90,0.85);
                letter-spacing: 0;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid{
                position:relative;
                box-sizing: border-box;
                /*height:262px;!*${height} -2-4-10-20-22-27-5-10-10=height-110*!*/
                margin: 0 24px 0 16px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .hls-pagging-grid {
                width: auto !important;
                height:365px;
                -webkit-box-shadow: none;
                -moz-box-shadow: none;
                box-shadow: none;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-title {
                display: none;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body {
                color: rgba(93,97,103,0.85);
                padding: 0 10px;
                overflow: auto;
                border-top: 1px solid #F0F0F3;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar { /*滚动条整体样式*/
                width: 4px; /*高宽分别对应横竖滚动条的尺寸*/
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 2px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background: rgba(0, 0, 0, 0.2);
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background: rgba(0, 0, 0, 0.1);
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body table {
                border-collapse: collapse;
                width:100%;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body table>tr {
                border-bottom: 1px solid #F0F0F3;
                overflow: auto;
                height: 40px;
                font-family: PingFangSC-Regular;
                font-size: 14px;
                color: #535D7F;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr {
                font-size: 12px;
                height: 35px;
                border-bottom: 1px solid #F0F0F3;
                overflow: auto;
                color: rgba(93,97,103,0.85);
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body table tbody tr:hover{
                background-color: rgba(90,127,255,0.08);
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot {
                position: absolute;
                height: 36px;
                bottom: 0;
                left: 0;
                width: 100%;
                text-align: right;
                background: #fff;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot>span{
                display: inline-block;
                height: 36px;
                line-height: 36px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .icon{
                height:16px;
                cursor:pointer
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .page-count img {
                width: 10px;
                cursor: pointer;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_end_page {
                margin-right: 5px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_last_page {
                margin-right: 8px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_page_number {
                width: 16px;
                height: 16px;
                text-align: center;
                border-radius: 2px;
                box-shadow: none;
                border: 1px solid #D9D9D9;
                font-family: HelveticaNeue;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.75);
                line-height: 16px;
                margin-right: 4px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_total_message {
                margin-right: 10px;
                font-family: HelveticaNeue;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.45);
                letter-spacing: 0;
                line-height: 16px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_page {
                margin-right: 5px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page_count_next_end_page {
                margin-right: 8px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message {
                min-width: 175px;
                /*最小宽度取三个数字均为三位数时的宽度*/
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_num {
                font-family: PingFangSC-Regular;
                font-size: 12px;
                color: rgba(75, 80, 90, 0.45);
                letter-spacing: 0;
                text-align: center;
                margin-right: 4px;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-foot .page-message .page_message_refresh {
                height: 12px;
                margin-right: 22px;
                cursor: pointer;
            }
            .base_grid_widget_${/parameter/@rule_id}_wrap .grid .grid-body table .hls-text-len-hidden{
                display:inline-block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .hls-text-len-hidden-pop-window{ /* 文本溢出提示框 */
                position:fixed;
                display: none;
                z-index:1000;
                padding:6px 10px;
                color: #656161;
                background: rgb(192, 192, 199);
                border-radius: 3px;
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.js"></script>
        <link href="${/request/@context_path}/resources/leaf.ui.std/hap/hapGrid/hapGrid.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/javascripts/home_widget/home_widget.js"/>
        <script><![CDATA[
        window["freshOnClose_${/parameter/@rule_id}"] = "N" ;
        window["datasetArr_${/parameter/@rule_id}"] = [];
        Leaf.onReady(function(){
            if(!!"${/parameter/@rule_id}"){
                var widget_grid_rule;
                var widget_grid_rule_s;
                var widget_grid_rule_t;
                var tabTitleArr = [];
                jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width(100);
                homeWidgetCommon.getWidgetModelByRuleId({
                    ruleId: '${/parameter/@rule_id}',
                    basePath: '${/request/@context_path}',
                    pagenum: 1,
                    pagesize: 8,
                    callback:function(res,seq,metadataId){
                        console.log(seq+','+metadataId);
                        window["freshOnClose_${/parameter/@rule_id}"] = getRuleValueByPropField(res,"freshOnClose");
                        if(seq == 1) {
                            var dataset = new Leaf.DataSet();
                            dataset.setQueryUrl('${/request/@context_path}/meta/data/query?ruleId=${/parameter/@rule_id}&metadataId='+metadataId);
                            dataset.totalCount = res.result.totalCount;
                            dataset.pagesize = 8;
                            var obj = getBaseGridResData(res, dataset,jQuery(".base_grid_widget_${/parameter/@rule_id}"),'${/parameter/@rule_id}_base_grid_f',"${/parameter/@rule_id}");
                            if(obj.sumWidth > jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width()) {
                                jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width(obj.sumWidth + 100);
                            }
                            var title = getRuleValueByPropField(res,"title");
                            jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap .widget_title").text(title || '基础报表')
                            dataset['on']('load', function () {
                                widget_grid_rule.reflash(dataset);
                            });
                            window["datasetArr_${/parameter/@rule_id}"].push(dataset);
                            widget_grid_rule = new widgetGrid(obj, dataset);
                        }else if(seq == 2){
                            var dataset_s = new Leaf.DataSet();
                            dataset_s.setQueryUrl('${/request/@context_path}/meta/data/query?ruleId=${/parameter/@rule_id}&metadataId='+metadataId);
                            dataset_s.totalCount = res.result.totalCount;
                            dataset_s.pagesize = 8;
                            var obj = getBaseGridResData(res, dataset_s,jQuery(".base_grid_widget_${/parameter/@rule_id}_s"),'${/parameter/@rule_id}_base_grid_s',"${/parameter/@rule_id}");
                            if(obj.sumWidth > jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width()) {
                                jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width(obj.sumWidth + 100);
                            }
                            dataset_s['on']('load', function () {
                                widget_grid_rule_s.reflash(dataset_s);
                            });
                            window["datasetArr_${/parameter/@rule_id}"].push(dataset_s);
                            widget_grid_rule_s = new widgetGrid(obj, dataset_s);
                        }else{
                            var dataset_t = new Leaf.DataSet();
                            dataset_t.setQueryUrl('${/request/@context_path}/meta/data/query?ruleId=${/parameter/@rule_id}&metadataId='+metadataId);
                            dataset_t.totalCount = res.result.totalCount;
                            dataset_t.pagesize = 8;
                            var obj = getBaseGridResData(res, dataset_t,jQuery(".base_grid_widget_${/parameter/@rule_id}_t"),'${/parameter/@rule_id}_base_grid_t',"${/parameter/@rule_id}");
                            if(obj.sumWidth > jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width()) {
                                jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap").width(obj.sumWidth + 100);
                            }
                            dataset_t['on']('load', function () {
                                widget_grid_rule_t.reflash(dataset_t);
                            });
                            window["datasetArr_${/parameter/@rule_id}"].push(dataset_t);
                            widget_grid_rule_t = new widgetGrid(obj, dataset_t);
                        }
                        if(!!getRuleValueByPropField(res,"tab"+seq+"Title")){
                            var tabTitleStr = '<span data-index="' + seq + '">' +  getRuleValueByPropField(res,"tab"+seq+"Title") + '</span>';
                            tabTitleArr.push({
                                index:seq,
                                _html:tabTitleStr
                            });
                            initBaseGridTab("${/parameter/@rule_id}",tabTitleArr);
                        }
                    }
                });
            }
            function getBaseGridResData(res,dataset,contain,id,rule_id){
                var obj = {};
                //复制头信息
                if(res.ruleValue && res.ruleValue.length){
                    for(var i = 0; i < res.ruleValue.length;i++){
                        obj[res.ruleValue[i].propField] = res.ruleValue[i]['widgetsPropValue'];
                    }
                }
                //复制数据源
                if(res.result && res.result.record && res.result.record.length){
                    var datas = res.result.record;
                    for(var  i = 0; i < datas.length; i++){
                        dataset.add(new Leaf.Record(datas[i]));
                    }
                }
                //复制列信息
                var sumWidth  = 0,filedColumns=[];
                if(res.metadata){
                    var datas = JSON.parse(res.metadata);
                    if(datas.modelType == "sql"){
                        datas.fields = datas.sqlFields;
                    }
                    if(datas && datas.fields && datas.fields.length){
                        if(res.ruleField && res.ruleField.length){
                            for(var j = 0; j < res.ruleField.length; j++){
                                if(res.ruleField[j]['width'] != 0) {
                                    var d = {
                                        orderSeq: res.ruleField[j]['orderSeq'] || Number.MAX_SAFE_INTEGER,
                                        name: res.ruleField[j]['dataField'],
                                        width: res.ruleField[j]['width'],
                                        prompt: res.ruleField[j]['propName']
                                    };
                                    sumWidth = sumWidth + res.ruleField[j]['width'];
                                    for (var i = 0; i < datas.fields.length; i++) {
                                        if (datas.fields[i].name == res.ruleField[j].dataField) {
                                            d.dataType = datas.fields[i].typeName;
                                        }
                                    }
                                    //字段链接
                                    if(res.ruleField[j].linkFieldFlag == "Y" && !!res.ruleField[j].widgetsPropValue){
                                        var url = res.ruleField[j].widgetsPropValue;
                                        var name = res.ruleField[j]['dataField'];
                                        var type = d.dataType;
                                        (function(url,name,type){
                                            d.template=function(rowdata,index){
                                                var para = "";
                                                for(var v in rowdata.data){
                                                    para = para + toLineCase(v) + '=' + rowdata.data[v] + '&';
                                                }
                                                para = para.replace(/\&$/,"");
                                                para = para.replace(/\?/,"&");
                                                var curUrl = url + (url.indexOf("?")<0 ? "?" : "&") + para;
                                                var value = rowdata.get(name);
                                                switch(type) {
                                                    case 'MONEY':{
                                                        value = Leaf.formatMoney(value);
                                                        break;
                                                    }
                                                    case 'DATE':{
                                                        value = Leaf.formatDate(value);
                                                        break;
                                                    }
                                                    case 'DATETIME':{
                                                        value = Leaf.formatDateTime(value);
                                                        break;
                                                    }
                                                };
                                                return ('<a onclick="widgetOpenWin_'+rule_id+'(\''+curUrl+'\')" data-url="'+curUrl+'" style="cursor:pointer;" >'+value+'</a>')
                                            };
                                        })(url,name,type);
                                    }else if(d.dataType){
                                        var type = d.dataType ;
                                        var name = d.name;
                                        (function (type,name) {
                                            d.template = function (rowdata, index) {
                                                var value = rowdata.get(name);
                                                switch(type) {
                                                    case 'MONEY':{
                                                        value = Leaf.formatMoney(value);
                                                        break;
                                                    }
                                                    case 'DATE':{
                                                        var date = new Date(value);
                                                        if(date.toString() != "Invalid Date") value = Leaf.formatDate(date);
                                                        break;
                                                    }
                                                    case 'DATETIME':{
                                                        var date = new Date(value);
                                                        if(date.toString() != "Invalid Date") value = Leaf.formatDateTime(value);
                                                        break;
                                                    }
                                                };
                                                return value
                                            };
                                        })(type,name);
                                    }
                                    filedColumns.push(d);
                                }
                            }
                        }
                    }
                }
                //图标链接
                var linkColumns = [];
                if(res.ruleLink && res.ruleLink.length>0){
                    var links = res.ruleLink;
                    var fields = res.ruleField;
                    for(var i = 0; i < links.length; i++){
                        var url = links[i].widgetsPropValue;
                        if(!url){
                            console.error("微件配置错误：链接字段未配置url-"+links[i].propName||'');
                            continue;
                        }
                        var name="",template=null;
                        (function(obj,url,links){
                            linkColumns.push({
                                orderSeq: links[i]['orderSeq'] || Number.MAX_SAFE_INTEGER,
                                prompt: links[i].propName,
                                width: links[i].width || 80,
                                template: function(rowdata,index){
                                    var para = "";
                                    for(var v in rowdata.data){
                                        para = para + toLineCase(v) + '=' + rowdata.data[v] + '&';
                                    }
                                    para = para.replace(/\&$/,"");
                                    var curUrl = url + (url.indexOf("?")<0 ? "?" : "&") + para;
                                    return ('<img onclick="widgetOpenWin_'+rule_id+'(\''+curUrl+'\')" data-url="'+curUrl+'" src="${/request/@context_path}/leafresources/images/widget/flow-chart.png" class="icon"/>')
                                },
                                name:name,
                                align: "center"
                            });
                        })(obj,url,links);
                        sumWidth += links[i].width || 80;
                    }
                }
                //columns排序
                var allColumns = filedColumns.concat(linkColumns).sort(function(a,b){
                    return a.orderSeq - b.orderSeq
                });

                obj['columns'] = allColumns || [];
                obj['id'] = id;
                obj['container'] = contain;
                obj['dataSource'] = dataset;
                obj['basePath'] = '${/request/@context_path}';
                obj['rowClick'] = '${/parameter/@rule_id}_grid_click';
                obj.sumWidth = sumWidth;
                return obj;
            }
            //初始化tab页
            function initBaseGridTab(rule_id,tabTitleArr){
                debugger;
                tabTitleArr.sort(function(a,b){return a.index - b.index});
                var _html = '';
                tabTitleArr.forEach(function(i){
                    _html += i._html;
                });
                jQuery(".base_grid_widget_${/parameter/@rule_id}_wrap .tab").html(_html);
                if(tabTitleArr.length>1){
                    jQuery(".base_grid_widget_"+rule_id+"_wrap .tab span").each(function(index,obj){
                        this.index = index;
                        jQuery(this).click(function(){
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .tab span").removeClass("hover");
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .tab span").addClass("unhover");
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .grid_body").hide();

                            jQuery(this).removeClass("unhover");
                            jQuery(this).addClass("hover");
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .grid_body").eq(this.index).show();
                        });
                        if(index == 0){
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .tab span").eq(0).addClass("hover");
                        }else{
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .tab span").eq(index).addClass("unhover");
                            jQuery(".base_grid_widget_"+rule_id+"_wrap .grid_body").eq(index).hide();
                        }
                    });
                }
            };
        });
        window['${/parameter/@rule_id}_grid_click'] = function(){

        }
        function getRuleValueByPropField(res,propfield) {
            var ret = "";
            if (!!res.ruleValue && !!res.ruleValue.forEach) {
                res.ruleValue.forEach(function (obj, i) {
                    if (obj.propField.toLowerCase() == propfield.toLowerCase()) {
                        ret = obj.widgetsPropValue;
                    }
                });
            }
            return ret;
        }
        window['widgetOpenWin_${/parameter/@rule_id}'] = function (url){
            if(url.indexOf('?')<0){
                url+='?id=${/parameter/@rule_id}&winid=${/parameter/@rule_id}_winid';
            }else{
                url+='&id=${/parameter/@rule_id}&winid=${/parameter/@rule_id}_winid';
            }
            new Leaf.Window({
                id: '${/parameter/@rule_id}_winid',
                url: "${/request/@context_path}/modules/WIDGET/WIDGET_COMMON/widget_common_link.lview",
                params: {
                    url: url,
                    id:'${/parameter/@rule_id}',
                    winid:'${/parameter/@rule_id}_winid'
                },
                title: '明细',
                side:'right',
                fullScreen: true,
            }).on("close",function(){
                if(window["freshOnClose_${/parameter/@rule_id}"] && window["freshOnClose_${/parameter/@rule_id}"]=="Y"){
                    window['refreshWidgetDs_${/parameter/@rule_id}']();
                }
            });
        }
        window['toLineCase'] = function (name) {
            return name.replace(/([A-Z])/g,"_$1").toLowerCase();
        }
        window['refreshWidgetDs_${/parameter/@rule_id}'] = function(){
            if(window["datasetArr_${/parameter/@rule_id}"] && window["datasetArr_${/parameter/@rule_id}"].length && window["datasetArr_${/parameter/@rule_id}"].length>0){
                debugger
                window["datasetArr_${/parameter/@rule_id}"].forEach(function(ds){
                    if(ds && ds.query) ds.query();
                });
            }
        }
        ]]></script>
        <a:screenBody style="display:none;"></a:screenBody>
        <div class="base_grid_widget_${/parameter/@rule_id}_wrap">
            <span class="widget_label"></span>
            <div class="widget_title"></div>
            <div class="tab"></div>
            <div class="base_grid_widget_${/parameter/@rule_id} grid grid_body"> </div>
            <div class="base_grid_widget_${/parameter/@rule_id}_s grid grid_body"> </div>
            <div class="base_grid_widget_${/parameter/@rule_id}_t grid grid_body"> </div>
        </div>
    </a:view>
</a:screen>