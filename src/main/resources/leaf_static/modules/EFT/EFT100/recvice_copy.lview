<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>

        <script><![CDATA[


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('business_type', '${/parameter/@business_type}');
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT102_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }
            array.forEach(function (val) {
                val.transfer_id = '${/parameter/@transfer_id}';
                val.transfer_list_id=null;
                val.fin_transfer_id=null;
                val.apply_pay_amount=null;
                val.actual_pay_amount=null;
                val.actual_pay_date=null;
                val.__status='insert';
            });
            $L.Masker.mask(document.body, "保存中..");
            Leaf.request({
                url: "${/request/@context_path}/eft/fund/transfer/list/submit",
                para: array,
                success: function (datas) {
                    $L.Masker.unmask(document.body);
                    $('${/parameter/@winid}').close();
                },
                error: function () {
                    Leaf.showMessage("提示", "确认出错!", null);
                    $L.Masker.unmask(document.body);
                },
                scope: this
            });
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    