<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="eft101_detail_id" url="${/request/@context_path}/modules/EFT/EFT100/recvice_detail.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT100_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }
            Leaf.request({
                url: "${/request/@context_path}/eft/fund/transfer/list/create",
                para: array,
                success: function (datas) {
                    var transfer_id = datas.result.record[0].transfer_id;
                    var param = {};
                    param.transfer_id = transfer_id;
                    param['url_title'] = '资金调拨明细';
                    param['function_code'] = 'EFT101';
                    param['winid'] = 'eft101_detail_winid';
                    hls_doc_get_layout_code(param, 'eft101_detail_id', 'EFT100_G_CON_eft_fund_transfer_list_ds', 'EFT100');
                },
                error: function () {
                    Leaf.showMessage("提示", "初始化出错!", null);
                },
                scope: this
            });
        };


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    