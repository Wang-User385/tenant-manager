<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="eft101_detail_id" url="${/request/@context_path}/modules/EFT/EFT100/recvice_detail.lview"/>
        <script><![CDATA[


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT500_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }

            var isCanConfirm = array.every(function (item) {
                return item.transfer_status !== 'CONFIRM' && item.transfer_status !== 'CANCEL' && item.apply_status==='APPROVED';
            });

            if(!isCanConfirm) {
                Leaf.showMessage("提示", "不能作废已经确认或作废或者调拨单未审批通过的单据,请检查！", null);
                return;
            }

            Leaf.showConfirm("提示", "确认作废?", function () {
                Leaf.request({
                    url: "${/request/@context_path}/eft/finance/transfer/list/cancel",
                    para: array,
                    success: function (datas) {
                        $('EFT500_G_CON_eft_fund_transfer_list_ds').query();
                        Leaf.showMessage("提示", "操作成功!", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "初始化出错!", null);
                    },
                    scope: this
                });
            });
        };




        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    