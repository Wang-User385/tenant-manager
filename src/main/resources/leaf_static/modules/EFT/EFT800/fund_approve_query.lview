<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <div id="formContainer"></div>
        <script><![CDATA[


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT800_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }
            var url = '${/request/@context_path}/eft/fund/transfer/list/download';
            // formData.append("_csrf", "${/session/@_csrf.token}");


            Leaf.showConfirm("提示", "确认下载?", function () {


                var downloadURL = url;
                var testForm = jQuery("<form>");   //定义一个form表单
                testForm.attr('style','display:none');   //设置form表单属性
                testForm.attr('target','');
                testForm.attr('method','post');
                testForm.attr('action',downloadURL);

                var nameInput = jQuery('<input>'); //构造formdata
                nameInput.attr('type','hidden');
                nameInput.attr('name','param');
                nameInput.attr('value',JSON.stringify(array));

                var nameInput2 = jQuery('<input>'); //构造formdata
                nameInput2.attr('type','hidden');
                nameInput2.attr('name',"_csrf");
                nameInput2.attr('value',"${/session/@_csrf.token}");

                jQuery('body').append(testForm);  //将表单放置在web中
                testForm.append(nameInput);   //将formdata添加到表单上
                testForm.append(nameInput2);   //将formdata添加到表单上
                testForm.submit();   //表单提交
                testForm.remove();  //表单移除


            })


        };






        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    