<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="fund_transfer_detail_id"
                url="${/request/@context_path}/modules/EFT/EFT900/eft_fund_transfer_detail.lview"/>
        <script><![CDATA[
        Leaf.onReady(function() {
            if('${/parameter/@function_code}' != 'EFT900RPT') {
                var query_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','F_QUERY');
                var dsRecord = $(query_ds_id).getCurrentRecord();
                dsRecord.set('transfer_status', 'NEW');
                dsRecord.set('transfer_status_n', '新建');
                var hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd', 'G_PAYMENT');
                $(hd_ds_id).query();
            }
        });

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','G_PAYMENT');
            if('${/parameter/@contract_id}' != null){

                $(hd_ds_id).setQueryParameter('contract_id', '${/parameter/@contract_id}');
            }
            if('${/session/@unitName}' == '航空事业部'){
                $(hd_ds_id).setQueryParameter('host_unit_name', '${/session/@unitName}');
            }

        }
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','G_PAYMENT');
            var records = $(ds_id).getSelected();
            if (records.length != 1) {
                Leaf.showErrorMessage('提示', '请选择一条单据！');
            } else {
                var param = {};
                if (records[0].get('transfer_status') == 'APPROVED' || records[0].get('transfer_status') == 'APPROVING') {
                    param['function_usage'] = 'QUERY';
                } else {
                    param['function_usage'] = 'MODIFY';

                }

                param['url_title'] = '资金调拨单制作';
                param['function_code'] = 'EFT900F1';
                param['winid'] = 'EFT900F1_transfer_create_winid';
                param['payment_req_id'] = records[0].get('payment_req_id');
                param['source_doc_id'] = records[0].get('payment_req_id');
                param['contract_id'] = records[0].get('contract_id');
                param['project_id'] = records[0].get('project_id');
                param['ref_project_id'] = records[0].get('ref_project_id');
                param['prj_notice_id'] = records[0].get('prj_notice_id');
                param['funding_plan_id'] = records[0].get('funding_plan_id');
                hls_doc_get_layout_code(param, 'fund_transfer_detail_id', ds_id, 'EFT900');
            }

        };
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','G_PAYMENT');
            var records = $(ds_id).getSelected();
            var saveData = []

            for (var i = 0; i < records.length; i++) {
                saveData.push(records[i].data);
            }
            Leaf.showConfirm('${l:HLS.PROMPT}', '确认废弃该笔付款申请吗?', function okFun() {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/csh/payment/req/transfer/abandon',
                    para: saveData,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.SideBar.show({
                            msg: '废弃完成',
                            duration: 2000
                        });
                        $(ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            });
        }

        //放款审批
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','G_PAYMENT');
            var records = $(ds_id).getSelected();
            var payment_req_id = records[0].get('payment_req_id');
            //模板类型代码
            var code = "PRJ_PAYMENT_APPROVE";
            var url = "${/request/@context_path}/simple/doc/gen?code=" + code + "&paymentId=" + payment_req_id;
            //window.location.href = url;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //资金调拨
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','G_PAYMENT');
            var records = $(ds_id).getSelected();
            var payment_req_id = records[0].get('payment_req_id');
            //模板类型代码
            var code = "FOUND_ALLOCATION_A";
            var url = "${/request/@context_path}/simple/doc/gen?code=" + code + "&paymentId=" + payment_req_id;
            //window.location.href = url;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        /*function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';


            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };*/

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

