<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: huangtianyang
    Date: 2019/02/19 16:37
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="eft300_detail_id" url="${/request/@context_path}/modules/EFT/EFT300/future_detail.lview"/>
        <a:link id="eft101_detail_id" url="${/request/@context_path}/modules/EFT/EFT100/recvice_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_payment_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '明细' + '</a>';
            }
        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT300_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }
            Leaf.showConfirm("提示", "确认调拨?", function () {
                Leaf.request({
                    url: "${/request/@context_path}/eft/gap/transfer/list/create",
                    para: array,
                    success: function (datas) {
                        var transfer_id = datas.result.record[0].transfer_id;
                        var param = {};
                        param.transfer_id = transfer_id;
                        param['url_title'] = '资金调拨明细';
                        param['function_code'] = 'EFT101';
                        param['winid'] = 'eft101_detail_winid';
                        hls_doc_get_layout_code(param, 'eft101_detail_id', 'EFT300_G_CON_eft_fund_transfer_list_ds', 'EFT300');
                    },
                    error: function () {
                        Leaf.showMessage("提示", "初始化出错!", null);
                    },
                    scope: this
                });
            })

        };

        function open_payment_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param.due_date_end = record.get('apply_pay_date');
            param.bank_account_id = record.get('in_bank_account_id');
            param['url_title'] = '账户缺口收支明细';
            param['function_code'] = 'EFT301';
            param['winid'] = 'eft301_detail_winid';
            hls_doc_get_layout_code(param, 'eft300_detail_id', ds_id, 'EFT300');
        }





        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    