<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: huangtianyang
    Date: 2019/02/19 16:37
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="eft101_detail_id" url="${/request/@context_path}/modules/EFT/EFT100/recvice_detail.lview"/>
        <script><![CDATA[

        // 超链接渲染 上传附件
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name === 'transfer_number' && record.get('transfer_id')){
                return '<a href="javascript:window[\'' + 'approve_link' + '\'](\'' + record.id + '\',\'' + record.get('transfer_id') + '\');">'+ value + '</a>';
            }
            return value;
        };

        window['approve_link'] = function(record_id,transfer_id){
            Leaf.request({
                url: "${/request/@context_path}/wfl/history/process/task/queryId?workFlowKey=TREASURY_DEPARTMENT_FUND_TRANSFER_WFL&businessKey="+ transfer_id,
                success: function (r) {
                    if(!r.result.record[0].process_instance_id){
                        Leaf.showMessage("提示", "未找到对应工作流,请检查!", null);
                        return;
                    }
                    new Leaf.Window({
                        id: 'win_process_instance_info_detail',
                        url: '${/request/@context_path}/modules/WFL/WFL003/process_instance_detail.lview',
                        params: {
                            id: r.result.record[0].process_instance_id,
                            taskId: -1,
                            winid:'win_process_instance_info_detail'
                        },
                        title: '资金调拨审批流程',
                        fullScreen:true
                    });
                },
                error: function () {
                    Leaf.showMessage("提示", "初始化出错!", null);
                },
                scope: this
            });


        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            let array = $('EFT600_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }
            Leaf.showConfirm("提示", "确认退回?", function () {
                Leaf.request({
                    url: "${/request/@context_path}/eft/finance/transfer/list/cancel",
                    para: array,
                    success: function (datas) {
                        $('EFT600_G_CON_eft_fund_transfer_list_ds').query();
                        Leaf.showMessage("提示", "操作成功!", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "初始化出错!", null);
                    },
                    scope: this
                });
            })

        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            let array = $('EFT600_G_CON_eft_fund_transfer_list_ds').getSelectedJson();
            if(array.length === 0){
                return;
            }

            var isCanConfirm = array.every(function (item) {
                return item.transfer_status === 'NEW';
            });

            if(!isCanConfirm) {
                Leaf.showMessage("提示", "不能调拨已经退回的单据,请检查！", null);
                return;
            }

            Leaf.showConfirm("提示", "确认调拨?", function () {
                Leaf.request({
                    url: "${/request/@context_path}/eft/finance/transfer/list/create",
                    para: array,
                    success: function (datas) {
                        var transfer_id = datas.result.record[0].transfer_id;
                        var param = {};
                        param.transfer_id = transfer_id;
                        param['url_title'] = '资金调拨明细';
                        param['function_code'] = 'EFT101';
                        param['winid'] = 'eft101_detail_winid';
                        hls_doc_get_layout_code(param, 'eft101_detail_id', 'EFT600_G_CON_eft_fund_transfer_list_ds', 'EFT600');
                    },
                    error: function () {
                        Leaf.showMessage("提示", "初始化出错!", null);
                    },
                    scope: this
                });
            })

        };



        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    