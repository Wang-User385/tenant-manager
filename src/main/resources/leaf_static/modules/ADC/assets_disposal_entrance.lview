<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="assets_disposal_detail_id_link"
                url="${/request/@context_path}/modules/ADC/assets_disposal_detail.lview"/>
        <a:link id="assets_disposal_new_id1"
                url="${/request/@context_path}/modules/ADC/assets_disposal_add.lview"/>
        <script><![CDATA[
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            switch (ds.id) {
                case '${/parameter/@layout_code}_ADC_LIST_assets_disposal_ds':
                    //管理页面查询自己的单据
                    if ('${/parameter/@function_code}' == 'ADC001') {
                        qpara['created_by'] = '${/session/@user_id}';
                    }
                    break;
            }
        };

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //alert(123)
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            var record = $(ds_id).getSelected();
            if (record.length == 1) {
                var contractRecord = record[0].data;

                var assetsDisposalId = contractRecord.assets_disposal_id;
                if (contractRecord.approval_status == 'NEW' || contractRecord.approval_status == 'REJECTED') {
                    Leaf.request({
                        url: "${/request/@context_path}/assets/disposal/approval",
                        para: {
                            assetsDisposalId: assetsDisposalId
                        },
                        success: function (r) {
                            //  debugger;
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                //$('${/parameter/@winid}').close();
                                $(ds_id).query();
                            });
                        },
                        error: function (r) {
                            // $L.Maassets_disposal_detail_id1sker.unmask(document.body);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            // Leaf.showMessage("提示", r.error.message, null);
                            $(ds_id).query();
                        },
                        scope: this
                    });
                } else {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "单据状态错误，不予许提交", function () {
                        // $('${/parameter/@winid}').close();
                        $(ds_id).query();
                    });
                }


            }
        }

        //资产处置创建按钮
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            var param = {};
            // debugger;
            param['url_title'] = '资产处置新增';
            param['function_code'] = 'ADC001F1';
            param['unit_id'] = '${/session/@unitId}';
            param['winid'] = 'assets_disposal_new_winid12';
            param['ds_id'] = ds_id;
            param['screen_width'] = '600';
            param['side'] = 'right';

            param['proposer_employee_name'] = '${/session/@employeeName}';

            var link_id = 'assets_disposal_new_id1';
            hls_doc_get_layout_code(param, link_id, ds_id, 'ADC001F1');
        }

        //
        function assets_disposal_detail_open(record_id, ds_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var status = param.approval_status;
            var type = ('${/parameter/@function_code}' == 'ADC001F3' || status === "APPROVING" || status === 'APPROVED' || status === "CLOSED") ? 'QUERY' : 'MODIFY';
            param['url_title'] = '资产处置维护';

            param['function_code'] = 'ADC001F2';

            param['function_usage'] = type;
            param['winid'] = 'assets_disposal_detail_winid22';
            var link_id = 'assets_disposal_detail_id_link';
            hls_doc_get_layout_code(param, link_id, ds_id, 'ADC001F2', null, null);
        }

        //DISPOSAL_DETAILS
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // debugger;
            var link_function = 'assets_disposal_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'disposal_details') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">资产处置明细</a>';
            }


        }
        //

        window['approval_upload_file'] = function (record_id, asset_ln_id) {
            if (typeof (asset_ln_id) === 'undefined' || 'undefined' === asset_ln_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': asset_ln_id,
                    'table_name': 'lease_asset_ln',
                    winid: '_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lease_asset_ln');
                $(ds_id).query();
            });
        };


        //合同终止
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            var record = $(ds_id).getSelected();
            if (record.length == 1) {
                var contractRecord = record[0].data;
                var assetsDisposalId = contractRecord.assets_disposal_id;
                if (contractRecord.approval_status == 'APPROVED') {
                    Leaf.request({
                        url: "${/request/@context_path}/assets/disposal/cal",
                        para: {
                            assetsDisposalId: assetsDisposalId
                        },
                        success: function (r) {
                            //  debugger;
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "合同终止成功!", function () {
                                //$('${/parameter/@winid}').close();
                                $(ds_id).query();
                            });
                        },
                        error: function (r) {
                            // $L.Masker.unmask(document.body);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            // Leaf.showMessage("提示", r.error.message, null);
                            $(ds_id).query();
                        },
                        scope: this
                    });
                } else {

                    Leaf.showMessage("提示", '审批通过的单据才能进行此操作', null);
                }
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>