<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="a_disposal_entrance_id"
                url="${/request/@context_path}/modules/ADC/assets_disposal_entrance.lview"/>
        <a:link id="a_disposal_detail_id"
                url="${/request/@context_path}/modules/ADC/assets_disposal_detail.lview"/>
        <script><![CDATA[
        Leaf.onReady(function () {
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            $(ds_id).getCurrentRecord().set('employee_id', '${/session/@employeeId}');
            $(ds_id).getCurrentRecord().set('employee_id_n', '${/session/@employeeName}');
            //FROM_DATE
            $(ds_id).getCurrentRecord().set('from_date', new Date());

            // var document_category = 'ASSETS_APPL_NUMBER';
            // var document_type = 'ASSETS_APPL_NUMBER';
            // var business_type ='ASSETS_APPL_NUMBER';
            // Leaf.request({
            //     url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
            //     success: function (res) {
            //         var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            //         $(ds_id).getCurrentRecord().set('assets_appl_number', res.result.record[0]);
            //         $(ds_id).getCurrentRecord().set('employee_id','${/session/@employeeId}');
            //         $(ds_id).getCurrentRecord().set('employee_id_n','${/session/@employeeName}');
            //         //FROM_DATE
            //         $(ds_id).getCurrentRecord().set('from_date', new Date());
            //
            //     },
            //     error: function (res) {
            //
            //
            //     },
            //     sync: true,
            //     scope: this
            // });
        });


        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            if ($(ds_id).validate()) {
                // debugger;
                var assets_disposal_id = $(ds_id).getCurrentRecord().get('assets_disposal_id');
                var assets_appl_number = $(ds_id).getCurrentRecord().get('assets_appl_number');
                //项目方案编号
                var contract_number = $(ds_id).getCurrentRecord().get('contract_number');
                //
                var project_id = $(ds_id).getCurrentRecord().get('project_id');
                var employee_id = $(ds_id).getCurrentRecord().get('employee_id');
                //FROM_DATE
                var from_date = $(ds_id).getCurrentRecord().get('from_date');
                var param = $(ds_id).getAt(0).data;
                param['assets_disposal_id'] = assets_disposal_id;
                param['assets_appl_number'] = assets_appl_number;
                param['contract_number'] = contract_number;
                param['project_id'] = project_id;
                param['employee_id'] = employee_id;
                param['from_date'] = from_date;
                var document_category = 'ASSETS_APPL_NUMBER';
                var document_type = 'ASSETS_APPL_NUMBER';
                var business_type = 'ASSETS_APPL_NUMBER';
                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                    success: function (res) {
                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
                        $(ds_id).getCurrentRecord().set('assets_appl_number', res.result.record[0]);


                    },
                    error: function (res) {


                    },
                    sync: true,
                    scope: this
                });
                // debugger;

                Leaf.request({
                    url: "${/request/@context_path}/assets/disposal/create",
                    para: {param: param},
                    success: function (res) {
                        console.log(res);
                        var assets_disposal_id = res.result.record[0].assets_disposal_id;
                        if (assets_disposal_id == 'undefined' || assets_disposal_id == '' || assets_disposal_id == null) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showInfoMessage('创建失败!');
                            return;
                        } else {
                            Leaf.Masker.unmask(Ext.getBody());
                            param['function_code'] = 'ADC001F2';
                            //param['function_code'] = 'ADC001';
                            param['url_title'] = '资产处置明细页面';
                            param['function_usage'] = 'CREATE';
                            param['assets_disposal_id'] = assets_disposal_id;
                            var link_id = 'a_disposal_detail_id';
                            hls_doc_get_layout_code(param, link_id, ds_id, 'ADC001F2');

                            /*Leaf.showInfoMessage("提示", "创建成功!", function () {
                                $('${/parameter/@winid}').close();
                                var winId = '${/parameter/@winid}';
                                if (!!winId) {
                                    $(winId).close();
                                }

                                $('${/parameter/@ds_id}').query();
                            });*/


                        }
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });

            }


        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
