<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>


        <script><![CDATA[

        //alert("${/parameter/@assets_disposal_id}")

        var assets_disposal_id = "${/parameter/@assets_disposal_id}";

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            qpara['assets_disposal_id'] = assets_disposal_id;
        };
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // debugger;
            var assets_disposal_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal');
            var chance_record = $(assets_disposal_ds_id).getCurrentRecord();
            qpara['assets_disposal_id'] = assets_disposal_id;

        }


        window['approval_upload_file'] = function (record_id, assets_disposal_attch_id) {
            if (typeof (assets_disposal_attch_id) === 'undefined' || 'undefined' === assets_disposal_attch_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': assets_disposal_attch_id,
                    'table_name': 'assets_disposal_attch',
                    winid: 'prj320_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal_attch');
                $(ds_id).query();
            });
        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            if (name == 'upload') {
                return '<a href="javascript:approval_upload_file(\'' + record.id + '\',\'' + record.get('assets_disposal_attch_id') + '\')">附件上传</a>';
            }

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>