<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="inv_purchase_detail_link_id"
                url="${/request/@context_path}/modules/inv/INV410A/inv_purchase_detail.lview"/>
        <script><![CDATA[

        //加载时调用
       /* window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            debugger;
            console.log(11);
        };*/
        debugger;
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

/*        var contract = parent.currentTaskInfo.execution_variables.filter(function (o) {
            debugger;
            return o.name == "contractId";
        })
        var contractId = contract[0].value;*/

        var finance_purchase_id = businessKey;
        var pageChooser = new PageChooser({
            url: $('inv_purchase_detail_link_id').getUrl(),
            function_code: 'INV200DETAIL',
            context_path: '${/request/@context_path}',
            opt: {
                finance_purchase_id: finance_purchase_id,
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

