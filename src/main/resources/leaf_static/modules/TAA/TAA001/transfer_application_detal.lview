<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <script><![CDATA[

        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (record,document_type, business_type, employee_code) {
            Leaf.request({
                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    record.set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };

        //保存前调用获取项目编码
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application');
            var hd_record = $(ds_id).getCurrentRecord();
            if(!hd_record.get("transfer_application_id")){
                //设置权限字符串
                window['${/parameter/@layout_code}_set_authority_rule_string'](hd_record,"JC_TRANSFER_APPLICATION", "JC_TRANSFER_APPLICATION", '${/session/@employeeCode}');
            }

        }

        //提交审批SUBMIT_APPROVAL
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function (){
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application');

           // var dsRecord = $(ds_id).getAll();
            var dsRecord = $(ds_id).getCurrentRecord();
            var ds_id_line =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application_detal');
            var dsRecord_line = $(ds_id_line).getAll();
            if(dsRecord_line.length==0){
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                return;
            }
            if(dsRecord){
                var contractRecord= dsRecord.data;
                var transfer_application_id = contractRecord.transfer_application_id;
                if(contractRecord.status=='NEW'||contractRecord.status=='REJECTED') {
                    Leaf.request({
                        url: "${/request/@context_path}/jc/transfer/application/approval",
                        para: {
                            transfer_application_id:transfer_application_id
                        },
                        success: function (r) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                $('${/parameter/@winid}').close();
                                $(ds_id).query();
                            });
                        },
                        error: function (r) {
                            // $L.Masker.unmask(document.body);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            // Leaf.showMessage("提示", r.error.message, null);
                        },
                        scope: this
                    });
                }else{
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "正在审批中。。。。", function () {
                        $('${/parameter/@winid}').close();
                        $(ds_id).query();
                    });
                }



            }
        }



        //创建加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq){
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application');

            debugger;
            var check_flag = true;
            var transfer_application_number =$(pledge_ds_id).getCurrentRecord().get('transfer_application_number');
            var document_category = 'TAA_APPL_NUMBER';
            var document_type = 'TAA_APPL_NUMBER';
            var business_type ='TAA_APPL_NUMBER';
            debugger;

            if(pledge_ds_id!="" && $(pledge_ds_id).getCurrentRecord()!=null&&transfer_application_number==null){
                //MODIFY_PERSON  new Date() MODIFY_DATE ASSET_STATUS
                $(pledge_ds_id).getCurrentRecord().set('employee_id', '${/session/@employeeId}');
                $(pledge_ds_id).getCurrentRecord().set('employee_id_n', '${/session/@employeeName}');
                $(pledge_ds_id).getCurrentRecord().set('unit_n', '${/session/@unitName}');
                /* if(typeof ($(pledge_ds_id).getCurrentRecord().get('asset_status'))=='undefined'|| 'undefined' == ($(pledge_ds_id).getCurrentRecord().get('asset_status'))){

                 }*/
                $(pledge_ds_id).getCurrentRecord().set('status', 'NEW');
                $(pledge_ds_id).getCurrentRecord().set('status_n', '新建');
                if(typeof ($(pledge_ds_id).getCurrentRecord().get('modify_date'))=='undefined'|| 'undefined' == ($(pledge_ds_id).getCurrentRecord().get('modify_date'))){
                    $(pledge_ds_id).getCurrentRecord().set('application_date', new Date());
                }

                console.log('${/session/@unitId}')
                $(pledge_ds_id).getCurrentRecord().set('unit_id', '${/session/@unitId}');

                if(!transfer_application_number){
                    Leaf.request({
                        url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                        success: function (res) {
                            $(pledge_ds_id).getCurrentRecord().set('transfer_application_number', res.result.record[0]);
                            $(pledge_ds_id).getCurrentRecord().set('transfer_application_number_n', res.result.record[0]);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = true;
                           //$('${/parameter/@winid}').close();
                            //$(pledge_ds_id).query();

                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                            //$('${/parameter/@winid}').close();
                            //$(pledge_ds_id).query();
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                            //$('${/parameter/@winid}').close();

                        },
                        sync: true,
                        scope: this
                    });
                }


            }


            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application');
            $(pledge_ds_id).query();

        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger;
            if (ds.id == '${/parameter/@layout_code}_G_LIST_jc_transfer_application_detal_ds') {
                record.set('currency', 'CNY');
                record.set('currency_n', '人民币');
                // record.data.currency = 'CNY';
                // record.data.currency_n = '人民币';
            }

        };


        window['approval_upload_file'] = function (record_id, transfer_application_detal_id) {
            if (typeof (transfer_application_detal_id) === 'undefined' || 'undefined' === transfer_application_detal_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'transfer_open_attachment_winid',
                url: url,
                params: {
                    'header_id': transfer_application_detal_id,
                    'table_name': 'jc_transfer_application_detal',
                    winid: 'transfer_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_transfer_application_detal');
                $(ds_id).query();
            });
        };



        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq){
            var function_usage;
            if(record.get('status')=='APPROVING'||record.get('status')=='APPROVED'){
                function_usage = 'QUERY';
            }
            if (name == 'upload') {
                return '<a href="javascript:approval_upload_file(\'' + record.id + '\',\'' + record.get('transfer_application_detal_id') + '\',\''+function_usage+'\')">附件上传</a>';
            }



        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
