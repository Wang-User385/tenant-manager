<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //查询时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            if(ds.id == '${/parameter/@bp_seq}${/parameter/@layout_code}_G_ASSURANCE_INFORMATION__ds'){
                qpara['bp_role_type']='WARRANTOR';
                var form_ds_id = '${/parameter/@bp_seq}${/parameter/@layout_code}_F_QUERY__ds';
                var form_record = $(form_ds_id).getCurrentRecord();
                var contract_name = form_record.get('contract_name');
                var credit_grantor_name = form_record.get('credit_grantor_name');
                var bp_name = form_record.get('bp_name');
                var business_type = form_record.get('business_type');
                var contract_status = form_record.get('contract_status');
                if(contract_name != undefined){
                    qpara['contract_name'] = contract_name;
                }
                if(credit_grantor_name != undefined){
                    qpara['credit_grantor_name'] = credit_grantor_name;
                }
                if(bp_name != undefined){
                    qpara['bp_name'] = bp_name;
                }
                if(business_type != undefined){
                    qpara['business_type'] = business_type;
                }
                if(contract_status != undefined){
                    qpara['contract_status'] = contract_status;
                }
            }

            if(ds.id == '${/parameter/@bp_seq}${/parameter/@layout_code}_G_PLEDGE_INFORMATION__ds'){
                qpara['bp_role_type']='MORTGAGOR';
                var form_ds_id2 = '${/parameter/@bp_seq}${/parameter/@layout_code}_F_QUERY2__ds';
                var form_record2 = $(form_ds_id2).getCurrentRecord();
                var contract_name2 = form_record2.get('contract_name');
                var credit_grantor_name2 = form_record2.get('credit_grantor_name');
                var bp_name2 = form_record2.get('bp_name');
                var business_type2 = form_record2.get('business_type');
                var contract_status2 = form_record2.get('contract_status');
                if(contract_name2 != undefined){
                    qpara['contract_name'] = contract_name2;
                }
                if(credit_grantor_name2 != undefined){
                    qpara['credit_grantor_name'] = credit_grantor_name2;
                }
                if(bp_name2 != undefined){
                    qpara['bp_name'] = bp_name2;
                }
                if(business_type2 != undefined){
                    qpara['business_type'] = business_type2;
                }
                if(contract_status2 != undefined){
                    qpara['contract_status'] = contract_status2;
                }
            }

            if(ds.id == '${/parameter/@bp_seq}${/parameter/@layout_code}_G_MORTGAGE__ds'){
                qpara['bp_role_type']='PLEDGOR';
                var form_ds_id3 = '${/parameter/@bp_seq}${/parameter/@layout_code}_F_QUERY3__ds';
                var form_record3 = $(form_ds_id3).getCurrentRecord();
                var contract_name3 = form_record3.get('contract_name');
                var credit_grantor_name3 = form_record3.get('credit_grantor_name');
                var bp_name3 = form_record3.get('bp_name');
                var business_type3 = form_record3.get('business_type');
                var contract_status3 = form_record3.get('contract_status');
                if(contract_name3 != undefined){
                    qpara['contract_name'] = contract_name3;
                }
                if(credit_grantor_name3 != undefined){
                    qpara['credit_grantor_name'] = credit_grantor_name3;
                }
                if(bp_name3 != undefined){
                    qpara['bp_name'] = bp_name3;
                }
                if(business_type3 != undefined){
                    qpara['business_type'] = business_type3;
                }
                if(contract_status3 != undefined){
                    qpara['contract_status'] = contract_status3;
                }
            }
        };

        //保证信息保存按钮
        window['${/parameter/@layout_code}_G_ASSURANCE_INFORMATION_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            //debugger;
            var guarantor_ds_id = '${/parameter/@layout_code}_G_ASSURANCE_INFORMATION__ds';
            var records = $(guarantor_ds_id).getAll();
            var guarantors=[];
            for(var i=0;i<records.length;i++){
                guarantors.push(records[i].data);
                guarantors[i]['__status'] = 'update';
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
               url: '${/request/@context_path}/hls/cus/fct/chance/bp/expiry/submit',
               para:guarantors,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '成功');

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };

        //抵押保存按钮
        window['${/parameter/@layout_code}_G_PLEDGE_INFORMATION_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            //debugger;
            var pledge_ds_id = '${/parameter/@layout_code}_G_PLEDGE_INFORMATION__ds';
            var records = $(pledge_ds_id).getAll();
            var pledges=[];
            for(var i=0;i<records.length;i++){
                pledges.push(records[i].data);
                pledges[i]['__status'] = 'update';
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/hls/cus/fct/chance/bp/expiry/submit',
                para:pledges,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '成功');

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };

        //质押信息保存按钮
        window['${/parameter/@layout_code}_G_MORTGAGE_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            //debugger;
            var mortgage_ds_id = '${/parameter/@layout_code}_G_MORTGAGE__ds';
            var records = $(mortgage_ds_id).getAll();
            var mortgages=[];
            for(var i=0;i<records.length;i++){
                mortgages.push(records[i].data);
                mortgages[i]['__status'] = 'update';
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/hls/cus/fct/chance/bp/expiry/submit',
                para:mortgages,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '成功');

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };

        //查询按钮
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var guarantor_ds_id = '${/parameter/@layout_code}_G_ASSURANCE_INFORMATION__ds';
            var pledge_ds_id = '${/parameter/@layout_code}_G_PLEDGE_INFORMATION__ds';
            var mortgage_ds_id = '${/parameter/@layout_code}_G_MORTGAGE__ds';
            $(guarantor_ds_id).query();
            $(pledge_ds_id).query();
            $(mortgage_ds_id).query();
        };





        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>