                             lovService="/metadata/column/queryByTableName~hls.layout.dto.LovMetaTableColumnDto" pagesize="1000"
                             title="HLS.TABLE_COLUMN" prompt="选择字段" displayField="column_name" valueField="column_name">
                        <a:mapping>
