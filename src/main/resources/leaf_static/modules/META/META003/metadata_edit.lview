<?xml version="1.0" encoding="UTF-8"?>
<!--
    Purpose:数据建模
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <link rel="stylesheet" href="${/request/@context_path}/leafresources/css/METADATA/treeGraph.css"/>
        <script type="text/javascript" src="${/request/@context_path}/leafresources/js/METADATA/treeGraph.js"></script>
        <style>
            #metadata_model_page_mian{
                width: 100%;
                height: calc( 100% - 10px );
                margin-top: 10px;
                display: -webkit-box;
                display: -webkit-flex;
                display: -ms-flexbox;
                display: flex;
                -webkit-box-flex: 1;
                -webkit-flex: 1;
                -ms-flex: 1;
                flex: 1;
                background: #fff;
                position: relative;
            }
            #metadata_model_page_mian .mainLeft{
                box-sizing: border-box;
                width: 450px;
                height: 100%;
                position: absolute;
                left: 0;
                top: 0;
                padding: 0 10px 10px 0;
                border-right: 1px solid #d3d3d3;
                overflow: auto;
                font-family: Monospaced Number,Chinese Quote,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,Hiragino Sans GB,Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif;
            }
            #metadata_model_page_mian .mainRight{
                -webkit-box-flex: 1;
                -webkit-flex: 1;
                -ms-flex: 1;
                flex: 1;
                margin-left: 450px;
                overflow: hidden;
                padding:10px;
            }
            #metadata_model_page_mian .mainLeft .btns{
                box-sizing: border-box;
                position: absolute;
                top: 0;
                left: 0;
                height: 30px;
                width: 100%;
            }
            #metadata_model_page_mian .mainLeft .btns select{
                width: 200px;
                height: 30px;
                margin: 0 20px;
                display: inline-block;
                vertical-align: top;
                line-height: 1;
                box-sizing: border-box;
                position: relative;
                border: 1px solid rgba(0, 0, 0, 0.2);
                font-size: inherit;
                color: rgba(0,0,0,.54);
                background-color: transparent;
                background-image: none;
                border-radius: 1px;
                -webkit-transition: all .3s;
