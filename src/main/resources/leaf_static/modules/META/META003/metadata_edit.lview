                    <a:field name="relation_str"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="metadata_item_filter_logic_ds">
                <a:fields>
                    <a:field name="filter_logic" validator="filter_logic_validator"/>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="onUpdate_metadata_item_filter_logic_ds"/>
                    <a:event name="remove" handler="onUpdate_metadata_item_filter_logic_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="metadata_item_filter_rows_ds" selectable="true">
                <a:fields>
                    <a:field name="index" prompt="序号"/>
                    <a:field name="tableName" prompt="表名"/>
                    <a:field name="field1" autoComplete="false" editable="false" lovGridHeight="300" lovHeight="450"
                             required="true" lovLabelWidth="100" lovWidth="300" pagesize="1000"
                             lovService="/metadata/column/queryByTableNames~hls.layout.dto.LovMetaTableColumnDto"
                             title="选择字段1" fetchRemote="false" prompt="字段1">
                        <a:mapping>
                            <a:map from="column_name" to="field1"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="operator" required="true" prompt="比较符"/>
                    <a:field name="operator_n" returnField="operator" options="metadata_filter_operator_type_ds"
                             displayField="code_value_name" valueField="code_value" prompt="比较符"/>
                    <a:field name="field2_type" validator="filter_field2_validator" prompt="字段2类型"/>
                    <a:field name="field2_type_n" returnField="field2_type" options="metadata_filter_field_type_ds" prompt="字段2类型"
                             displayField="code_value_name" valueField="code_value" validator="filter_field2_validator"/>
                    <a:field name="field2" autoComplete="false" lovGridHeight="300" lovHeight="450" pagesize="1000"
                             lovLabelWidth="100" lovWidth="300" validator="filter_field2_validator"
                             lovService="/metadata/column/queryByTableNames~hls.layout.dto.LovMetaTableColumnDto"
                             title="选择字段2" fetchRemote="false" prompt="字段2">
                        <a:mapping>
                            <a:map from="column_name" to="field2"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="onUpdate_metadata_item_filter_rows_ds"/>
                    <a:event name="remove" handler="onUpdate_metadata_item_filter_rows_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="metadata_item_fields_ds" selectable="true">
                <a:fields>
