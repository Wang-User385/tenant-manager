                    </a:tabPanel>
                </div>
                <div class="mainRight">
                    <div class="content">
                        <a:tabPanel id="metadata_right_tabPanel" width="800" height="450" style="width:100%;height:100%">
                            <a:tabs>
                                <a:tab prompt="关联" width="80">
                                    <a:form title="关联属性" id="metadata_relation_form">
                                        <a:radio bindTarget="metadata_relation_ds" width="150" name="join_type" prompt="关联方式">
                                            <a:items>
                                                <a:item label="inner-join" value="inner-join"/>
                                                <a:item label="left-join" value="left-join"/>
                                            </a:items>
                                            <a:events>
                                                <a:event name="change" handler="onChange_metadata_joinType"/>
                                            </a:events>
                                        </a:radio>
                                        <a:label bindTarget="metadata_relation_ds" renderer="metadata_relation_str_render"
                                                 name="relation_str" prompt="关联关系" width="500"/>
                                    </a:form>
                                    <a:form title="过滤条件" id="metadata_filter_form" column="1" padding="0" cellSpacing="0" cellPadding="0" wrapperAdjust="true">
                                        <a:textField name="filter_logic" bindTarget="metadata_item_filter_logic_ds" width="600" typeCase="upper"
                                                     prompt="筛选逻辑" emptyText="使用 AND 和 OR 合并、连接条件行号。示例： (1 AND 2) OR 3。(默认使用AND连接)"/>
                                    </a:form>
                                    <a:grid id="metadata_item_filter_rows_ds_grid" bindTarget="metadata_item_filter_rows_ds"
                                            width="700" height="250" showRowNumber="true">
                                        <a:toolBar>
                                            <a:button type="add" text="新增条件"/>
                                            <a:button type="delete" text="删除"/>
                                        </a:toolBar>
                                        <a:columns>
                                            <a:column width="200" name="field1" prompt="字段1" editor="metadata_item_filter_rows_ds_grid_lov"/>
                                            <a:column width="100" name="operator_n" prompt="比较符" editor="metadata_item_filter_rows_ds_grid_comb"/>
                                            <a:column width="100" name="field2_type_n" prompt="字段2类型" editorFunction="metadata_item_filter_rows_ds_grid_ef"/>
                                            <a:column width="200" name="field2" prompt="字段2" editorFunction="metadata_item_filter_rows_ds_grid_ef"/>
                                        </a:columns>
                                        <a:editors>
                                            <a:comboBox id="metadata_item_filter_rows_ds_grid_comb">
                                                <a:events>
                                                    <a:event name="select" handler="onChange_filter_operator"/>
                                                </a:events>
                                            </a:comboBox>
                                            <a:textField id="metadata_item_filter_rows_ds_grid_tf"/>
                                            <a:lov id="metadata_item_filter_rows_ds_grid_lov" editable="false">
                                                <a:events>
                                                    <a:event name="beforetriggerclick" handler="beforetriggerclick_filter_rows_field_lov"/>
                                                </a:events>
                                            </a:lov>
                                        </a:editors>
                                    </a:grid>
                                </a:tab>
                                <a:tab prompt="字段" width="80" >
                                    <a:grid id="metadata_item_fields_ds_grid" bindTarget="metadata_item_fields_ds"
                                            width="900" height="400" navBar="false" navBarType="complex">
                                        <a:toolBar>
<!--                                            <a:button type="add" text="新增字段"/>-->
                                            <a:button click="metadata_item_fields_ds_grid_addFields" text="新增字段"/>
                                            <a:button type="delete" text="删除" />
                                            <a:button click="metadata_item_fields_ds_grid_fieldsToCamel" text="字段名转驼峰"/>
                                            <a:button click="metadata_item_fields_ds_grid_fieldsToLine" text="字段名转下划线"/>
                                        </a:toolBar>
                                        <a:columns>
                                            <a:column width="120" name="name" prompt="字段名" editorFunction="metadata_item_fields_ds_grid_multiLovEf"/>
                                            <a:column width="200" name="tableName" prompt="表名" align="center"/>
                                            <a:column width="200" name="columnName" prompt="列名" align="center"/>
                                            <a:column width="100" name="typeNameCn" prompt="字段类型" align="center"/>
                                            <a:column width="100" name="label" prompt="字段描述" editor="metadata_item_fields_ds_grid_tf"/>
                                            <a:column width="80" name="required" prompt="是否必选" editor="metadata_item_fields_ds_grid_cb"/>
                                        </a:columns>
                                        <a:editors>
                                            <a:textField id="metadata_item_fields_ds_grid_tf"/>
                                            <a:checkBox id="metadata_item_fields_ds_grid_cb"/>
                                            <a:multiLov id="metadata_item_fields_ds_grid_mulLov">
                                                <a:events>
                                                    <a:event name="beforetriggerclick" handler="beforeClick_metadata_item_fields_ds_grid_mulLov"/>
                                                </a:events>
                                            </a:multiLov>
                                        </a:editors>
                                    </a:grid>
                                </a:tab>
                                <a:tab prompt="查询参数" width="80" >
                                    <a:grid id="metadata_item_queryFields_ds_grid" bindTarget="metadata_item_queryFields_ds"
                                            width="900" height="400" navBar="false">
                                        <a:toolBar>
                                            <a:button click="metadata_item_queryFields_ds_grid_addFields" text="新增参数"/>
                                            <a:button type="delete" text="删除"/>
                                            <a:button click="metadata_item_queryFields_ds_grid_fieldsToCamel" text="字段名转驼峰"/>
                                            <a:button click="metadata_item_queryFields_ds_grid_fieldsToLine" text="字段名转下划线"/>
                                        </a:toolBar>
                                        <a:columns>
                                            <a:column width="100" name="sqlOperatorCn" prompt="后端操作符" editor="metadata_item_queryFields_ds_grid_comb"/>
                                            <a:column width="120" name="name" prompt="字段名" editorFunction="metadata_item_queryFields_ds_grid_multiLovEf"/>
                                            <a:column width="150" name="tableName" prompt="表名" align="center"/>
                                            <a:column width="150" name="columnName" prompt="列名" align="center"/>
                                            <a:column width="100" name="typeNameCn" prompt="字段类型" align="center"/>
                                            <a:column width="100" name="label" prompt="字段描述" editor="metadata_item_queryFields_ds_grid_tf"/>
                                            <a:column width="80" name="required" prompt="是否必选" editor="metadata_item_queryFields_ds_grid_cb"/>
                                        </a:columns>
                                        <a:editors>
                                            <a:textField id="metadata_item_queryFields_ds_grid_tf"/>
                                            <a:checkBox id="metadata_item_queryFields_ds_grid_cb"/>
                                            <a:comboBox id="metadata_item_queryFields_ds_grid_comb"/>
                                            <a:multiLov id="metadata_item_queryFields_ds_grid_mulLov">
                                                <a:events>
                                                    <a:event name="beforetriggerclick" handler="beforeClick_metadata_item_queryFields_ds_grid_mulLov"/>
                                                </a:events>
                                            </a:multiLov>
                                        </a:editors>
                                    </a:grid>
                                </a:tab>
                                <a:tab prompt="sql字段" width="80" disabled="true">
                                    <a:grid id="metadata_item_sqlFields_ds_grid" bindTarget="metadata_item_sqlFields_ds"
                                            width="900" height="400" navBar="false" navBarType="complex">
                                        <a:columns>
                                            <a:column width="120" name="name" prompt="字段名" editor="metadata_item_sqlFields_ds_grid_mulLov"/>
                                            <a:column width="200" name="tableName" prompt="表名" align="center"/>
                                            <a:column width="200" name="columnName" prompt="列名" align="center"/>
                                            <a:column width="100" name="typeNameCn" prompt="字段类型" editor="metadata_item_sqlFields_ds_grid_cmb" align="center"/>
                                            <a:column width="100" name="label" prompt="字段描述" editor="metadata_item_sqlFields_ds_grid_tf"/>
                                            <a:column width="80" name="required" prompt="是否必选" editor="metadata_item_sqlFields_ds_grid_cb"/>
                                        </a:columns>
                                        <a:editors>
                                            <a:textField id="metadata_item_sqlFields_ds_grid_tf"/>
                                            <a:checkBox id="metadata_item_sqlFields_ds_grid_cb"/>
                                            <a:comboBox id="metadata_item_sqlFields_ds_grid_cmb"/>
                                        </a:editors>
                                    </a:grid>
                                </a:tab>
                            </a:tabs>
                            <a:events>
                                <a:event name="beforeselect" handler="beforeSelect_metadata_right_tabPanel"/>
                            </a:events>
                        </a:tabPanel>
                    </div>
                </div>
            </div>
        </a:screenBody>
    </a:view>
</a:screen>
