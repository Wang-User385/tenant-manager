                cursor: pointer;
            }
            #metadata_model_page_mian #metadata_model_tree_container .tree-center .tree-node-inner .primary-icon{
                width: 36px;
                margin-right: 10px;
                padding: 4px;
                -webkit-flex-shrink: 0;
