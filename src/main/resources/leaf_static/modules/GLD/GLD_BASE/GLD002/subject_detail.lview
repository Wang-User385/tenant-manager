<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author:zedong huang
    $Date: 2018-12-21
    $Revision: 1.0
    $Purpose: 财务系统设置-科目表定义-明细页面
    说明：当有个字段是从数据库种查出来并需要存回去 可以用MAP
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?FREQUENCY=GLD.ACCOUNT_TYPE" type="text/javascript"></script>
        <script><![CDATA[
        var resourceTypeECMap = {};
        FREQUENCY.forEach(function (i) {
            resourceTypeECMap[i.value] = i.meaning;
        });

        <!--将type中英文存入对应的ds-->
        $L.onReady(function () {
            FREQUENCY.forEach(function (i) {
                $("subject_detail_type_ds").create({"account_type": i.value, "account_type_key": i.meaning});
            });
        });

        <!-- sys_resource_ds 加载后从type字段换成映射type_cn-->
        function onLoad_sys_resource_ds(ds) {
            var records = ds.data;
            records.forEach(function (record) {
                record.data["account_type_key"] = resourceTypeECMap[record.data["account_type"]];
            });
        }

        function subject_detail_screen_query() {
            $('subject_detail_ds').query();
        }

        function subject_detail_screen_reset() {
            $('subject_detail_query_ds').reset();
            subject_detail_screen_query();
        }

        function subject_detail_screen_save() {
            var ds = $('subject_detail_ds');
            if (ds.validate()) {
                ds.setSubmitUrl("${/request/@context_path}/hls/gld/account/submit");
                ds.submit();
            }
        }

        <!--grid渲染-->
        function subject_level_setup_window_ds_grid(value, record, name) {
            if (!record.isNew) {
                if (name == 'incremental') {
                    return '<a href="javascript:subject_level_setup_window_winOpen_access_component(\'' + record.get('account_code') + '\',\'' + record.get('account_id') + '\');">子科目</a>';
                }
                return '';
            }
            return '';
        }

        <!--打开窗口：子项目-->
        function subject_level_setup_window_winOpen_access_component(account_code, account_id) {
            new Leaf.Window({
                id: "subject_level_setup_window",
                url: "${/request/@context_path}/modules/GLD/GLD_BASE/GLD002/subject_level_setup.lview",
                title: '科目层次设置',
                fullScreen: false,
                params: {
                    account_code: account_code,
                    account_id: account_id,
                    winId: "subject_level_setup_window",
                },
                draggable: true,
                closeable: true,
                width: 400,
                height: 505
            });
        }

        function showTree(event) {
            new Leaf.Window({
                id: "subject_level_tree_window",
                url: "${/request/@context_path}/modules/GLD/GLD_BASE/GLD002/subject_level_tree.lview",
                title: '科目层次展示',
                fullScreen: false,
                params: {
                    account_set_id: "${/parameter/@account_set_id}",
                    winId: "subject_level_tree_window",
                },
                draggable: true,
                closeable: true,
                width: 340,
                height: 505
            });
        }

        function editorFunctionInsert(record, name) {
            if (record.isNew) {
                if (name == 'account_code') {
                    return 'subject_detail_ds_grid_tf';
                }
                return '';
            }
            return '';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="segment_type_ds" lookupCode="GLD.JE_SEGMENT_TYPE"/>
            <a:dataSet id="borrowing_direction_ds" lookupCode="GLD.BORROWING_DIRECTION"/>
            <a:dataSet id="subject_detail_type_ds">
                <a:fields>
                    <a:field name="account_type"/>
                    <a:field name="account_type_key"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="subject_detail_query_ds">
                <a:fields>
                    <a:field name="account_set_id" defaultValue="${/parameter/@account_set_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="subject_detail_ds" autoPageSize="false" autoQuery="true"
                       queryDataSet="subject_detail_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/hls/gld/account/query"
                       submitUrl="${/request/@context_path}/gld/account/submit"
                       deleteUrl="${/request/@context_path}/gld/account/remove">
                <a:events>
                    <a:event name="load" handler="onLoad_sys_resource_ds"/>
                </a:events>
                <a:fields>
                    <a:field name="account_set_id" defaultValue="${/parameter/@account_set_id}"/>
                    <a:field name="account_code"/>
                    <a:field name="account_name"/>
                    <a:field name="account_type_key" options="subject_detail_type_ds" displayField="account_type_key"
                             valueField="account_type" returnField="account_type"/>
                    <a:field name="enabled_flag" defaultValue="Y" type="boolean" checkedValue="Y" uncheckedValue="N"/>
                    <a:field name="summary_flag" type="boolean" checkedValue="Y" uncheckedValue="N"/>
                    <a:field name="incremental"/>
                    <a:field name="assist_type1"/>
                    <a:field name="assist_type1_n" displayField="code_value_name" options="segment_type_ds"
                             returnField="assist_type1" valueField="code_value" prompt="辅助核算段1类型"/>
                    <a:field name="assist_type2"/>
                    <a:field name="assist_type2_n" displayField="code_value_name" options="segment_type_ds"
                             returnField="assist_type2" valueField="code_value" prompt="辅助核算段2类型"/>
                    <a:field name="assist_type3"/>
                    <a:field name="assist_type3_n" displayField="code_value_name" options="segment_type_ds"
                             returnField="assist_type3" valueField="code_value" prompt="辅助核算段3类型"/>
                    <a:field name="assist_type4"/>
                    <a:field name="assist_type4_n" displayField="code_value_name" options="segment_type_ds"
                             returnField="assist_type4" valueField="code_value" prompt="辅助核算段4类型"/>
                    <a:field name="cashflow_item"/>
                    <a:field name="borrowing_direction"/>
                    <a:field name="borrowing_direction_n" displayField="code_value_name" options="borrowing_direction_ds"
                             returnField="borrowing_direction" valueField="code_value" prompt="借贷方向"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="subject_detail_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton click="subject_detail_screen_save" text="HAP.SAVE"/>
                <a:gridButton click="subject_detail_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="subject_detail_screen_reset" text="HAP.RESET" />
                <a:gridButton bind="subject_detail_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="showTree" text="层次查看"/>
            </a:screenTopToolbar>
            <a:form column="3" title="查询条件" labelwidth="100">
                <a:textField name="account_code" bindTarget="subject_detail_query_ds" prompt="科目代码"
                             emptyText="科目代码" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="subject_detail_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="account_name" bindTarget="subject_detail_query_ds" prompt="科目名称"
                             emptyText="科目名称" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="subject_detail_screen_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="subject_detail_ds_grid" bindTarget="subject_detail_ds" width="1340" marginHeight="150"  navBar="true">
                <a:columns>
                    <a:column width="120" name="account_code" prompt="科目代码" editorFunction="editorFunctionInsert"
                              align="center"/>
                    <a:column width="120" name="account_name" editor="subject_detail_ds_grid_tf" prompt="科目名称"
                              align="center"/>
                    <a:column width="120" name="account_type_key" prompt="科目类型" editor="subject_detail_ds_grid_combo"
                              align="center"/>

                    <a:column width="120" name="assist_type1_n" prompt="辅助核算段1类型" editor="subject_detail_ds_grid_combo"
                              align="center"/>

                    <a:column width="120" name="assist_type2_n" prompt="辅助核算段2类型" editor="subject_detail_ds_grid_combo"
                              align="center"/>

                    <a:column width="120" name="assist_type3_n" prompt="辅助核算段3类型" editor="subject_detail_ds_grid_combo"
                              align="center"/>

                    <a:column width="120" name="assist_type4_n" prompt="辅助核算段4类型" editor="subject_detail_ds_grid_combo"
                              align="center"/>
                    <a:column width="120" name="cashflow_item" prompt="现金流量" align="center" editor="subject_detail_ds_grid_tf"/>
                    <a:column width="120" name="borrowing_direction_n" prompt="借贷方向" editor="subject_detail_ds_grid_combo"
                              align="center"/>
                    <a:column width="80" name="enabled_flag" editor="subject_detail_ds_grid_check" prompt="启用"
                              align="center"/>
                    <a:column width="80" name="summary_flag" editor="subject_detail_ds_grid_check" prompt="汇总"
                              align="center"/>
                    <a:column  name="incremental" prompt="子科目" renderer="subject_level_setup_window_ds_grid" width="100"
                              align="center"/>
                </a:columns>
                <a:editors>
                    <a:textField id="subject_detail_ds_grid_tf"/>
                    <a:checkBox id="subject_detail_ds_grid_check"/>
                    <a:comboBox id="subject_detail_ds_grid_combo"/>

                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
