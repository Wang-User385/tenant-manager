<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="gld_exchange_rate_query" url="${/request/@context_path}/fnd/enchange/query/rate"/>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <script><![CDATA[

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            var line_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_line');
            var head_record = $(ds_id).getCurrentRecord();

            if (ds.id === ds_id) {
                if (name === 'je_date') {
                    var je_date = new Date(value);
                    // alert(je_date.getFullYear() + '-' + (je_date.getMonth()+1 < 10 ? '0'+(je_date.getMonth()+1) : je_date.getMonth()+1));
                    record.set('period_name', je_date.getFullYear() + '-' + (je_date.getMonth() + 1 < 10 ? '0' + (je_date.getMonth() + 1) : je_date.getMonth() + 1));
                    record.set('year', je_date.getFullYear());
                }
                if (name == 'currency') {
                    var je_date = record.get('je_date');
                    var company_id = record.get('company_id');
                    var currency = record.get('currency');
                    window['${/parameter/@layout_code}_exchange_rate_query'](record, je_date, company_id, currency);

                    /*  var je_date = record.get('je_date');
                      Leaf.request({
                          url: '${/request/@context_path}/fnd/exchange/rate/gld/query',
                          para: {
                              currency: value,
                              jeDate: je_date
                          },
                          scope: this,
                          success: function (res) {
                              // console.log(res);
                              if(res.result.record){
                                  var dailyRate = res.result.record[0].daily_rate;
                                  record.set('exchange_rate',dailyRate);
                              }
                          }
                      });*/
                }


            }
            if (ds.id == line_ds_id) {
                if (name === 'dr_amount') {
                    var dr_functional_amount = mul(value, head_record.get('exchange_rate'));
                    record.set('dr_functional_amount', dr_functional_amount);
                }
                if (name === 'cr_amount') {
                    var cr_functional_amount = mul(value, head_record.get('exchange_rate'));
                    record.set('cr_functional_amount', cr_functional_amount);
                }
            }
        };

        function isNaNForAmount(value) {
            if (isNaN(value)) {
                value = 0;
                return value;
            } else {
                return value;
            }
        }

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            debugger;
            var check_flag = true;

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            var line_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_line');

            var line_records = $(line_ds_id).getAll();
            var dr_sum_amount = 0;
            var cr_sum_amount = 0;
            var dr_sum_functional = 0;
            var cr_sum_functional = 0;

            var dsRecord = $(ds_id).getCurrentRecord();
            var currency = dsRecord.get('currency');
            var exchange_rate = dsRecord.get('exchange_rate');
            var creation_date = dsRecord.get('creation_date');
            var je_status = 'NEW';

            for (var i = 0; i < line_records.length; i++) {
                //校验借贷是否相等
                var dr_amount = line_records[i].get('dr_amount');
                var cr_amount = line_records[i].get('cr_amount');
                var dr_functional_amount = line_records[i].get('dr_functional_amount');
                var cr_functional_amount = line_records[i].get('cr_functional_amount');

                if ((isNaN(dr_amount) || dr_amount == 0) && (!isNaN(cr_amount) || cr_amount != 0)) {
                    line_records[i].set('dr_cr', 'CR');
                }
                if ((isNaN(cr_amount) || cr_amount == 0) && (!isNaN(dr_amount) || dr_amount != 0)) {
                    line_records[i].set('dr_cr', 'DR');
                }
                if ((!isNaN(dr_amount) && dr_amount != 0) && (!isNaN(cr_amount) && cr_amount != 0)) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showMessage('提示','凭证行借贷金额不可同时填写');
                    return false;
                }

                dr_sum_amount += isNaNForAmount(dr_amount);
                cr_sum_amount += isNaNForAmount(cr_amount);
                dr_sum_functional += isNaNForAmount(dr_functional_amount);
                cr_sum_functional += isNaNForAmount(cr_functional_amount);

                line_records[i].set('segment_1', line_records[i].get('segment1'));
                line_records[i].set('segment_2', line_records[i].get('segment2'));
                line_records[i].set('segment_3', line_records[i].get('segment3'));
                line_records[i].set('segment_4', line_records[i].get('segment4'));
                line_records[i].set('segment_5', line_records[i].get('segment5'));

                line_records[i].set('currency', currency);
                line_records[i].set('je_status', je_status);
                line_records[i].set('je_created_by', '${/session/@user_id}');
                line_records[i].set('je_creation_date', creation_date);
                line_records[i].set('creation_date', creation_date);
                line_records[i].set('last_update_login', '${/session/@user_id}');
                line_records[i].set('exchange_rate', exchange_rate);

            }

            if (dr_sum_amount != cr_sum_amount || dr_sum_functional != cr_sum_functional) {
                Leaf.showMessage("提示", "借贷不等!");
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }

            var documentCategory = 'GLD_JE_HEAD';
            var documentType = 'TRANSFER';
            var businessType = 'TRANSFER';

            if (ds_id == ds.id) {

                record.set('document_category', documentCategory);
                record.set('document_type', documentType);
                record.set('business_type', businessType);
                record.set('je_status', 'NEW');
                record.set('operate_id', '${/session/@user_id}');
                record.set('je_created_by', '${/session/@user_id}');
                record.set('je_creation_date', creation_date);
                record.set('creation_date', creation_date);
                record.set('last_update_login', '${/session/@user_id}');


                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + documentCategory
                        + "&documentType=" + documentType + "&businessType=" + businessType,
                    success: function (res) {
                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
                        $(ds_id).getCurrentRecord().set('je_number', res.result.record[0]);
                        check_flag = true;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function (res) {
                        console.log(res);
                        record.set('je_number', res.result.record[0]);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        console.log(res);
                        record.set('je_number', res.result.record[0]);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }

            // debugger;
            // if (line_ds_id == ds.id) {
            //     record.set('document_category',documentCategory);
            //     record.set('document_type',documentType);
            //     record.set('business_type',businessType);
            //     record.set('company_id',248);
            //     record.set('je_date',ds_id.getCurrentRecord().get('je_date'));
            //     record.set('period_name',ds_id.getCurrentRecord().get('period_name'));
            //     record.set('source_type','JE_TRX_DTL');
            //     record.set('set_of_books_id',10006);
            //     record.set('cost_center_id',10008);
            //     record.set('JE_TRX','MANUAL');
            // }
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            var line_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_line');
            var documentCategory = 'GLD_JE_HEAD';
            var documentType = 'TRANSFER';
            var businessType = 'TRANSFER';
            debugger;
            if (line_ds_id == ds.id) {
                record.set('document_category', documentCategory);
                record.set('document_type', documentType);
                record.set('business_type', businessType);
                record.set('company_id', 248);
                record.set('je_date', $(ds_id).getCurrentRecord().get('je_date'));
                record.set('period_name', $(ds_id).getCurrentRecord().get('period_name'));
                record.set('source_type', 'JE_TRX_DTL');
                record.set('set_of_books_id', 10006);
                record.set('cost_center_id', 10008);
                record.set('je_trx', 'MANUAL');
            }
        };

        window['${/parameter/@layout_code}_on_layout_dynamic_grid_beforecreate'] = function (ds, record, config_records, bp_seq) {
            var parentRecord = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head')).getAt(0);
            if (parentRecord.get('je_head_id')) {
                return true;
            } else {
                Leaf.showMessage("提示", "请先保存凭证头信息!", null);
                return false;
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            if (ds_id === ds.id) {
                var je_date = new Date(record.get('je_date'));
                if (!isNaN(je_date.getFullYear())) {
                    record.set('year', je_date.getFullYear());
                }
                // record.set('company_id', 248);
                record.set('creation_date', new Date());
                record.set('company_id', 248);
                record.set('company_id_n', '君成金融租赁有限公司');
            }
        }


        window['${/parameter/@layout_code}_exchange_rate_query'] = function (record, je_date, company_id, currency) {
            Leaf.Masker.mask(Ext.getBody(), '正在查询汇率...');

            var param = {
                exchange_date: je_date,
                company_id: company_id,
                foreign_currency: currency
            };

            Leaf.request({
                url: $("gld_exchange_rate_query").getUrl(),
                para: param,
                success: function (res) {
                    record.set("exchange_rate", res.result.record[0].exchange_rate);
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>