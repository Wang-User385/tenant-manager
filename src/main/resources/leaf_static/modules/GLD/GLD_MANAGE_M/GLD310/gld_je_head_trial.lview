<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
    $Revision: 1.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="gld_je_line_info_link" url="${/request/@context_path}/modules/GLD/GLD_MANAGE_M/GLD304/je_trx_line_detail.lview"/>
        <a:link id="gld_je_line_create_link" url="${/request/@context_path}/modules/GLD/GLD_MANAGE_M/GLD310/gld_je_head_create.lview"/>
        <script><![CDATA[

        function gld600_je_line_query(){
            $('gld600_je_head_ds').query();
        }

        function gld600_je_line_reset(){
            $('gld600_je_head_form_ds').reset();
        }

        function gld600_je_head_ds_indexchange(ds,record){
            var je_head_id = record.get('je_head_id');
            $('gld600_je_line_group_ds').setQueryParameter('je_head_id',je_head_id);
            $('gld600_je_line_group_ds').query();
        }

        function gld600_je_line_group_ds_indexchange(ds,record){
            var je_line_id_str = record.get('je_line_id_str');
            $('gld600_je_line_seq_ds').setQueryParameter('je_line_id_str',je_line_id_str);
            $('gld600_je_line_seq_ds').query();

        }

        function open_je_line_detail_win(record_id,ds_id){
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '凭证明细';
            param['function_code'] = 'GLD310F1';
            param['function_usage'] = 'MODIFY';
            param['je_head_id'] = record.get('je_head_id');
            param['winid'] = 'gld310_certificate_win_id';
            hls_doc_get_layout_code(param, 'gld_je_line_info_link', ds_id, 'GLD310');
        }

        function gld600_je_line_trial(){debugger;
            var ds_id = $('gld600_je_head_ds');
            var records = ds_id.getSelected();

            var data = [];
            for (var i = 0; i < records.length; i++) {
                var je_status = records[i].get('je_status');
                if (je_status != 'NEW') {
                    Leaf.showMessage('提示', '存在不是新建的凭证!');
                    return false;
                }
            }
            if (records.length != 0) {
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认初审?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody());
                    for (var i = 0; i < records.length; i++) {
                        data.push(records[i].data);
                    }
                    Leaf.request({
                        url: "${/request/@context_path}/gld/je/head/submit?jeStatus=" + 'TRIAL',
                        para: data,
                        type: "POST",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            ds_id.query();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            ds_id.query();
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            ds_id.query();
                        },
                        scope: this
                    });
                }, function cancel() {
                    Leaf.Masker.unmask(Ext.getBody());
                }, 200, 100);
            } else {
                Leaf.showMessage('提示', '请至少选择一条凭证记录!');
                return false;
            }

        }

        function gld600_je_head_grid_render(value,record,name){
            if (name = 'je_number') {
                var link_function = 'open_je_line_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        }

        function gld600_je_head_ds_query(ds, para){

        }

        function gld600_je_line_detail_grid_excel(){
            var ds_id = $('gld600_je_line_seq_ds');
            var records = ds_id.getAll();
            if(records.length != 0){
                var je_head_id = records[0].get('je_head_id');
                location.href =  '${/request/@context_path}/gld/je/line/export?jeHeadId=' + je_head_id;
            }
        }

        function sumFunction(datas, name) {
            var sum = 0;
            for (var i = 0;i < datas.length;i++) {
                var r = datas[i];
                var d = r.get(name);
                var n = parseFloat(d);
                if (!isNaN(n)) {
                    sum = plus(sum, n);
                }
            }
            var total = (typeof(sum) == 'undefined' ? '' : parseFloat(sum));
            return '<font>' + Leaf.formatNumber(total) + '</font>';
        }

        function gld600_je_line_new(){
            debugger;
            var param = {};
            param['url_title'] = '凭证新建';
            param['function_code'] = 'GLD310F2';
            param['function_usage'] = 'MODIFY';
            // param['je_head_id'] = record.get('je_head_id');
            param['winid'] = 'gld310_certificate_win_id';
            hls_doc_get_layout_code(param, 'gld_je_line_create_link', null, 'GLD310');
        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="gld600_je_head_form_je_status_ds">
                <a:datas>
                    <a:record code_value="NEW" code_value_name="新建"/>
                    <a:record code_value="CONFIRM" code_value_name="复审通过"/>
                    <a:record code_value="TRIAL" code_value_name="初审通过"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="gld600_je_head_form_ds" autoCreate="true" autoQuery="false">
                <a:fields>
                    <a:field name="je_number"/>
                    <a:field name="je_status_n" options="gld600_je_head_form_je_status_ds" displayField="code_value_name"
                             valueField="code_value"
                             returnField="je_status"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld600_je_head_ds" selectable="true"
                       queryUrl="${/request/@context_path}/gld/je/head/query?jeStatus=NEW&amp;trialFlag=Y" queryDataSet="gld600_je_head_form_ds"
                       autoQuery="true">
                <a:fields>
                    <a:field name="je_head_id"/>
                    <a:field name="je_date" datatype="date" />


                </a:fields>
                <a:events>
                    <a:event name="indexchange" handler="gld600_je_head_ds_indexchange"/>
                    <a:event name="query" handler="gld600_je_head_ds_query"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="gld600_je_line_group_ds" bindTarget="gld600_je_head_ds"
                       queryUrl="${/request/@context_path}/gld/je/line/group/query"
                       autoQuery="true">
                <a:fields>
                    <a:field name="je_head_id"/>

                </a:fields>
                <a:events>
                    <a:event name="indexchange" handler="gld600_je_line_group_ds_indexchange"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="gld600_je_line_seq_ds" bindTarget="gld600_je_line_group_ds"
                       queryUrl="${/request/@context_path}/gld/je/line/seq/query"
                       autoQuery="true">
                <a:fields>
                    <a:field name="je_head_id"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>

            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld600_je_line_query" text="HAP.QUERY"/>
                <a:gridButton click="gld600_je_line_reset" text="HAP.RESET"/>
                <a:gridButton click="gld600_je_line_trial" text="凭证初审"/>
                <a:gridButton click="gld600_je_line_new" text="凭证新建"/>
            </a:screenTopToolbar>

            <a:form title="查询框"  labelWidth="150" marginWidth="50">

                <a:box column="4" labelWidth="150">
                    <a:textField name="description" prompt="凭证事务" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="je_description" prompt="行摘要" bindTarget="gld600_je_head_form_ds"/>
                    <a:datePicker name="je_date_from" prompt="凭证日期从" bindTarget="gld600_je_head_form_ds"/>
                    <a:datePicker name="je_date_to" prompt="凭证日期到" bindTarget="gld600_je_head_form_ds"/>
                </a:box>

                <a:box column="4" labelWidth="150">
                    <a:comboBox name="je_status_n" prompt="状态" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="period_name" prompt="期间" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="payment_number" prompt="支付表编号" bindTarget="gld600_je_head_form_ds"/>

                </a:box>

            </a:form>

            <div style="width: 100%;position: relative;">
                <!--凭证头-->
                <div style="width: 49%;float: left;">
                    <a:grid id="gld600_je_head_grid" bindTarget="gld600_je_head_ds"
                            navBar="true" width="700" marginHeight="200">
                        <a:toolBar>
                            <a:button type="excel"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="company_name" prompt="凭证所属公司" width="100"/>
                            <a:column name="je_number" prompt="凭证编号" width="100" renderer="gld600_je_head_grid_render"/>
                            <a:column name="period_name" prompt="期间" width="60"/>
                            <a:column name="je_date" prompt="凭证日期" renderer="Leaf.formatDate" width="90"/>
                            <a:column name="description" prompt="凭证事务" width="130"/>
                            <a:column name="dr_amount" prompt="借方金额" renderer="Leaf.formatMoney" width="100"/>
                            <a:column name="cr_amount" prompt="贷方金额" renderer="Leaf.formatMoney" width="100"/>
                            <a:column name="trialed_by_n" prompt="初审人" width="100"/>
                            <a:column name="retrialed_by_n" prompt="复审人" width="100"/>
                            <a:column name="je_status_n" prompt="状态" width="60"/>
                        </a:columns>
                    </a:grid>
                </div>

                <!--凭证行-->
                <div style="width: 49%;float: right;">
                    <a:grid id="gld600_je_line_grid" bindTarget="gld600_je_line_group_ds"
                            navBar="true" width="700">
                        <a:toolBar>
                            <a:button type="excel"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="account_code" prompt="科目代码" width="70"/>
                            <a:column name="account_id_n" prompt="科目描述" width="250"/>
                            <a:column name="dr_total" prompt="原币借方" align="right" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="cr_total" prompt="原币贷方" align="right" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="dr_functional_amount_total" align="right" prompt="本币借方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="cr_functional_amount_total" align="right" prompt="本币贷方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                        </a:columns>
                    </a:grid>

                    <a:grid id="gld600_je_line_detail_grid" bindTarget="gld600_je_line_seq_ds"
                            navBar="true" width="700">
                        <a:toolBar>
                            <a:button type="excel" hidden="true"/>
                            <a:button click="gld600_je_line_detail_grid_excel" height="36" width="36" style="margin-left:5px;" text="导出"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="je_description" prompt="行摘要" width="250"/>
                            <a:column name="segment_1" prompt="参考段一" width="120"/>
                            <a:column name="segment_2" prompt="参考段二" width="120"/>
                            <a:column name="segment_3" prompt="参考段三" width="120"/>
                            <a:column name="segment_4" prompt="参考段四" width="60"/>
                            <a:column name="dr_total" prompt="原币借方" align="right" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="cr_total" prompt="原币贷方" align="right" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="dr_functional_amount_total" align="right" prompt="本币借方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                            <a:column name="cr_functional_amount_total" align="right" prompt="本币贷方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction"/>
                        </a:columns>
                    </a:grid>
                </div>
                <div style="clear: both;"></div>
            </div>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>