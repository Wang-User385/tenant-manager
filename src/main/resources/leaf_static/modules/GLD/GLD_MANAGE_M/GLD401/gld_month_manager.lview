        //月结 收入确认
        function pre_lease_interest_month_settle(){
            var pre_lease_interest_record = $('pre_lease_interest_ds').getSelected();
            var param = [];
            var pre_post_flag = 'N';
            var post_flag = 'N';
            for(var i=0;i<pre_lease_interest_record.length;i++){
                if(pre_lease_interest_record[i].get('pre_post_flag') == 'Y'){
                    pre_post_flag = 'Y';
                    break;
                }else if(pre_lease_interest_record[i].get('post_flag') == 'Y'){
                    post_flag = 'Y';
                    break;
                }else{
                    param.push(pre_lease_interest_record[i].data);
                }
            }
            if(pre_lease_interest_record.length == 0){
                Leaf.showMessage('提示','未选择一条记录！');
                return;
            }

            if(post_flag == 'Y'){
                Leaf.showMessage('提示','存在月结过的记录，不可重复月结！');
                return;
            }
            var period_name = $('period_name_ds').getCurrentRecord().get('period_name');
            Leaf.Masker.mask(Ext.getBody(), '执行中...');
            Leaf.request({
                url: "${/request/@context_path}/gld/contract/finance/income/monthSettle?periodName=" + period_name,
                para:param,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    $L.showInfoMessage("提示","执行成功!",function () {
                        pre_lease_interest_query();
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },

                scope: this
            });
        }

        function pre_lease_interest_reset() {
            $('pre_lease_interest_query_ds').getCurrentRecord().set('bp_name', '');
            $('pre_lease_interest_query_ds').getCurrentRecord().set('contract_number', '');
            $('pre_lease_interest_query_ds').getCurrentRecord().set('contract_name', '');
            $('pre_lease_interest_query_ds').getCurrentRecord().set('post_flag', '');
            $('pre_lease_interest_query_ds').getCurrentRecord().set('post_flag_n', '');
            pre_lease_interest_query();
        }

        function cost_accrual_reset() {
            $('cost_accrual_query_ds').getCurrentRecord().set('bp_name', '');
            $('cost_accrual_query_ds').getCurrentRecord().set('contract_number', '');
            $('cost_accrual_query_ds').getCurrentRecord().set('withdraw_number', '');
            $('cost_accrual_query_ds').getCurrentRecord().set('post_flag', '');
            $('cost_accrual_query_ds').getCurrentRecord().set('post_flag_n', '');
            cost_accrual_query();
        }

        function risk_fund_accrual_reset() {
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('bp_name', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('contract_number', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('contract_name', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('risk_reserve_ratio', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('risk_reserve_ratio_n', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('post_flag', '');
            $('risk_fund_accrual_query_ds').getCurrentRecord().set('post_flag_n', '');
            risk_fund_accrual_query();
        }

        function stamp_duty_accrual_lease_reset() {
            $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('bp_name', '');
            $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('contract_number', '');
            $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('contract_name', '');
            $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('post_flag', '');
            $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('post_flag_n', '');
            stamp_duty_accrual_lease_query();
        }

        function stamp_duty_accrual_financing_reset() {
            $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('bp_name', '');
            $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('contract_number', '');
            $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('withdraw_number', '');
            $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('post_flag', '');
            $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('post_flag_n', '');
            stamp_duty_accrual_financing_query();
        }

        var current_tab = 0;

        //上一步
        function pre_tab(){
            if(current_tab>0){
                current_tab--;
                $("monthTab").selectTab(current_tab);
            }
        }

        //下一步
        function next_tab(){
            if(current_tab<10){
                current_tab++;
                $("monthTab").selectTab(current_tab);
            }

        }

        //获取当前tab页index
        function onSelect_month_tab(tabPanel,index,tab){
            current_tab = index;
        }

        //百分数格式化
        function percentFormat(value,record,name){
            if (name == 'stamp_tax') {
                if (!isNaN(value)) {
                    return parseFloat(value * 100).toFixed(2) + '%';
                } else {
                    return '';
                }
            }

            if (name == 'risk_reserve_ratio') {
                if (!isNaN(value)) {
                    return parseFloat(value*100).toFixed(2) + '%';
                }else {
                    return '';
                }
            }

            if (name == 'stamp_duty') {
                if (!isNaN(value)) {
                    return parseFloat(value*100).toFixed(3) + '%';
                }else {
                    return '';
                }
            }
        }

        function contractType(value,record,name) {
            if (name == 'contract_type') {
                if (record.data.stamp_duty === '0.00005') {
                    return '租赁合同';
                }else if(record.data.stamp_duty === '0.0003'){
                    return '采购合同';
                }else {
                    return '';
                }
            }
        }

        function month_end(){
            Leaf.showMessage('提示','月结结束！');
        }

        // Leaf.onReady(function () {
        //     $('pre_lease_interest_query_ds').getCurrentRecord().set('company_id','${/session/@companyId}');
        //
        // });


        function con_contract_renderer(value, record, name) {
            var contract_number = record.get('contract_number');
            var contract_id = record.get('contract_id');
            var project_id = record.get('project_id');
            return '<a  href="#' + Math.random() + '" onclick="open_con_contract_window(\'' + project_id + '\')">' + contract_number + '</a>';
        }
        function lon_contract_renderer(value, record, name) {
            var contract_number = record.get('allocation_id_str');
            var contract_id = record.get('contract_id');
            return '<a  href="#' + Math.random() + '" onclick="open_lon_contract_window(\'' + contract_id + '\')">' + value + '</a>';
        }
        function lon_draw_renderer(value, record, name) {
            var contract_number = record.get('allocation_id_str');
            var withdraw_id = record.get('withdraw_id');
            return '<a  href="#' + Math.random() + '" onclick="open_lon_draw_window(\'' + withdraw_id + '\')">' + value + '</a>';
        }
        function open_con_contract_window(project_id) {
            var param = {};
            param['project_id'] = project_id;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'gld_month_manager_winid';
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc', 'quotation_calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['function_code'] = 'CONT301F1';
            hls_doc_get_layout_code(param, 'con_contract_detail_id1', null, 'GLD401');
        }
        function open_lon_contract_window(contract_id) {
            var param = {};
            param['url_title'] = '融资合同查询';
            param['function_code'] = 'FIN003F1CQUERY';
            param['maintain_type'] = 'QUERY';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'gld_month_manager_winid';
            param['contract_id'] = contract_id;
            param['document_id'] = contract_id;
            hls_doc_get_layout_code(param, 'fin003_lon_create_id1', null, 'GLD401');
        }
        function open_lon_draw_window(withdraw_id) {
            var param = {};
            param['withdrawId'] = withdraw_id;
            param['function_code'] = 'FIN003S3';
            param['function_usage'] = 'QUERY';
            param['editFlag'] = 'N';
            param['changeFlag'] = 'N';
            param['url_title'] = '融资提款详细信息';
            hls_doc_get_layout_code(param, 'fin003_tikuan_lon_detail_id1', null, 'GLD401');
        }

        ]]></script>
        <!--期间-->
        <a:dataSets>
            <a:dataSet id="pre_lease_interest_query_cease_interesst_flag_ds" lookupCode="GLD.CEASE_INTERESST_FLAG"/>
            <a:dataSet id="pre_lease_interest_query_risk_reserve_ratio_ds">
                <a:datas>
                    <a:record code_value="0.01" code_value_name="1%"/>
                    <a:record code_value="0.015" code_value_name="1.5%"/>
                    <a:record code_value="0.02" code_value_name="2%"/>
                    <a:record code_value="0.03" code_value_name="3%"/>
                    <a:record code_value="0.25" code_value_name="25%"/>
                    <a:record code_value="0.50" code_value_name="50%"/>
                    <a:record code_value="1" code_value_name="100%"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="pre_lease_interest_query_post_flag_ds" lookupCode="GLD.POST_FLAG"/>

            <a:dataSet id="period_name_ds">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" required="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="onUpdate_period_name_ds"/>
                </a:events>
            </a:dataSet>
            <!--确认收入查询的条件-->
            <a:dataSet id="pre_lease_interest_query_ds">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="contract_number"/>
                    <a:field name="vc_contract_name"/>
                    <a:field name="post_flag"/>
                    <a:field name="post_flag_n" returnField="post_flag"
                             options="pre_lease_interest_query_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="bp_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="pre_lease_interest_ds" queryDataSet="pre_lease_interest_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/finance/income/select" selectable="true">
                <a:fields>
                    <a:field name="project_id"/>
                    <a:field name="project_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="contract_name"/>
                    <a:field name="vc_contract_number"/>
                    <a:field name="finance_income_id"/>
                    <a:field name="finance_amount"/>
                    <a:field name="finance_income_includ"/>
                    <a:field name="finance_income"/>
                    <a:field name="finance_income_vat"/>
                    <a:field name="incept_date" datatype="date"/>
                    <a:field name="times"/>
                    <a:field name="start_date" datatype="date"/>
                    <a:field name="end_date" datatype="date"/>
                    <a:field name="lease_end_date" datatype="date"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_pre_lease_interest_ds"/>
                </a:events>
            </a:dataSet>
            <!--成本计提查询的条件-->
            <a:dataSet id="cost_accrual_query_ds">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="withdraw_number"/>
                    <a:field name="post_flag"/>
                    <a:field name="post_flag_n" returnField="post_flag"
                             options="pre_lease_interest_query_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="bp_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="cost_accrual_ds" queryDataSet="cost_accrual_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/cost/accrual/select" selectable="true">
                <a:fields>
                    <a:field name="due_amount"/>
                    <a:field name="currency"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="start_date" datatype="date"/>
                    <a:field name="end_date" datatype="date"/>
                    <a:field name="finance_cost"/>
                    <a:field name="period_name"/>
                    <a:field name="post_flag"/>
                    <a:field name="contract_id"/>
                    <a:field name="withdraw_id"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_pre_lease_interest_ds"/>
                </a:events>
            </a:dataSet>
            <!--风险金计提查询条件-->
            <a:dataSet id="risk_fund_accrual_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="contract_name"/>
                    <a:field name="risk_reserve_ratio"/>
                    <a:field name="risk_reserve_ratio_n" returnField="risk_reserve_ratio"
                             options="pre_lease_interest_query_risk_reserve_ratio_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="post_flag"/>
                    <a:field name="post_flag_n" returnField="post_flag"
                             options="pre_lease_interest_query_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="risk_fund_accrual_ds" queryDataSet="risk_fund_accrual_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/risk/fund/accrual" selectable="true">
                <a:fields>
                    <a:field name="contract_id"/>
                    <a:field name="project_id"/>
                    <a:field name="project_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="finance_amount"/>
                    <a:field name="inception_of_lease" datatype="date"/>
                    <a:field name="withdrawal_amount"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_pre_lease_interest_ds"/>
                </a:events>
            </a:dataSet>
            <!--印花税计提（租赁）查询条件-->
            <a:dataSet id="stamp_duty_accrual_lease_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_name"/>
                    <a:field name="contract_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="withdraw_number"/>
                    <a:field name="post_flag"/>
                    <a:field name="post_flag_n" returnField="post_flag"
                             options="pre_lease_interest_query_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="stamp_duty_accrual_lease_ds" queryDataSet="stamp_duty_accrual_lease_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/stamp/duty/lease" selectable="true">
                <a:fields>
                    <a:field name="contract_id"/>
                    <a:field name="project_id"/>
                    <a:field name="project_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="contract_amount"/>
                    <a:field name="inception_of_lease" datatype="date"/>
                    <a:field name="stamp_duty"/>
                    <a:field name="stamp_duty_accrued_amount"/>
                    <a:field name="due_date"/>
                    <a:field name="due_amount"/>
                    <a:field name="withdraw_currency_code"/>
                    <a:field name="project_id"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_pre_lease_interest_ds"/>
                </a:events>
            </a:dataSet>
            <!--印花税计提（融资）查询条件-->
            <a:dataSet id="stamp_duty_accrual_financing_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="period_name" autoComplete="true" lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_name"/>
                    <a:field name="contract_number"/>
                    <a:field name="withdraw_number"/>
                    <a:field name="post_flag"/>
                    <a:field name="post_flag_n" returnField="post_flag"
                             options="pre_lease_interest_query_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="stamp_duty_accrual_financing_ds" queryDataSet="stamp_duty_accrual_financing_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/stamp/duty/financing" selectable="true">
                <a:fields>
                    <a:field name="withdraw_id"/>
                    <a:field name="stamp_duty_accrued_amount"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="due_amount"/>
                    <a:field name="withdraw_currency_code"/>
                    <a:field name="currency_n"/>
                    <a:field name="contract_id"/>
                    <a:field name="withdraw_id"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_pre_lease_interest_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="pre_tab" text="上一步"/>
                <a:gridButton click="next_tab" text="下一步"/>
            </a:screenTopToolbar>
            <a:tabPanel marginWidth="20" marginHeight="0" id="monthTab">
                <a:tabs>
                    <a:tab prompt="期间" width="80" id="period_tab">
                        <a:form column="1" labelWidth="100" prompt="期间选择" title="期间选择">
                            <a:lov name="period_name" width="120" prompt="期间" required="true"
                                   bindTarget="period_name_ds"/>
                        </a:form>
                    </a:tab>
                    <!--确认收入-->
                    <a:tab prompt="收入确认" width="80" id="recognize_revenue_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="pre_lease_interest_month_settle" text="确认"/>
                            <a:gridButton click="pre_lease_interest_query" text="查询"/>
                            <a:gridButton click="pre_lease_interest_reset" text="重置"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="100" prompt="查询的条件" title="查询的条件" >
                            <a:lov name="period_name" width="120" prompt="期间" readOnly="true" bindTarget="pre_lease_interest_query_ds"/>
                            <a:textField name="bp_name" width="120" prompt="客户名称" bindTarget="pre_lease_interest_query_ds"/>
                            <a:textField name="contract_number" width="120" prompt="合同编号" bindTarget="pre_lease_interest_query_ds"/>
                            <a:textField name="contract_name" width="120" prompt="合同名称" bindTarget="pre_lease_interest_query_ds"/>
                            <a:comboBox name="post_flag_n" width="120" prompt="确认标志" bindTarget="pre_lease_interest_query_ds"/>
                        </a:form>

                        <a:grid bindTarget="pre_lease_interest_ds" marginHeight="270"
                                marginWidth="100"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="客户名称" width="180" align="left" footerRenderer="sum_foot"/>
                                <a:column name="project_id" hidden="true" width="0"/>
                                <a:column name="project_name" prompt="项目名称" align="left" width="180"/>
                                <a:column name="contract_number" prompt="合同编号" align="left" width="120"
                                          renderer="con_contract_renderer"/>
                                <a:column name="vc_contract_name" prompt="合同名称" align="left" width="180"/>
                                <a:column name="finance_amount" prompt="融资额(元)" width="130" align="right" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="lease_end_date" prompt="合同结束日期" width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="incept_date" prompt="起租日期" width="100" align="center" renderer="Leaf.formatDate"/>
<!--                                <a:column name="times" prompt="期项" align="center" width="80"/>-->
                                <a:column name="start_date" prompt="计算日从"  width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="end_date" prompt="计算日到" align="center" width="100" renderer="Leaf.formatDate"/>
                                <a:column name="finance_income_includ" prompt="待确认金额(含税/元)" align="right" width="130" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="finance_income" prompt="待确认金额(不含税/元)" align="right" width="140" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="finance_income_vat" prompt="销项税额(元)" align="right" width="110" renderer="Leaf.formatMoney"/>
                                <a:column name="post_flag" align="center" prompt="确认标志" width="100"/>
                                <a:column name="period_name" align="center" prompt="确认期间" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--成本计提-->
                    <a:tab prompt="成本计提" width="80" id="cost_accrual_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="cost_accrual_month_settle" text="确认"/>
                            <a:gridButton click="cost_accrual_query" text="查询"/>
                            <a:gridButton click="cost_accrual_reset" text="重置"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="100" prompt="查询的条件" title="查询的条件" >
                            <a:lov name="period_name" width="120" prompt="期间" readOnly="true" bindTarget="cost_accrual_query_ds"/>
                            <a:textField name="bp_name" width="120" prompt="交易对手" bindTarget="cost_accrual_query_ds"/>
                            <a:textField name="contract_number" width="120" prompt="融资合同编号" bindTarget="cost_accrual_query_ds"/>
                            <a:textField name="withdraw_number" width="120" prompt="提款编号" bindTarget="cost_accrual_query_ds"/>
                            <a:comboBox name="post_flag_n" width="120" prompt="确认标志" bindTarget="cost_accrual_query_ds"/>
                        </a:form>
                        <a:grid bindTarget="cost_accrual_ds" marginHeight="270"
                                marginWidth="100"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="交易对手" width="200" align="left" footerRenderer="sum_foot"/>
                                <a:column name="contract_number" prompt="融资合同编号" align="left" width="180"
                                          renderer="lon_contract_renderer"/>
                                <a:column name="withdraw_number" prompt="提款编号" align="left" width="180"
                                          renderer="lon_draw_renderer"/>
                                <a:column name="due_amount" prompt="提款金额(元)" align="right" width="130" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="currency" prompt="币种" align="center" width="80"/>
                                <a:column name="due_date" prompt="提款日期" width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="start_date" prompt="计算日从"  width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="end_date" prompt="计算日到" align="center" width="100" renderer="Leaf.formatDate"/>
                                <a:column name="finance_cost" prompt="待确认金额(元)" align="right" width="130" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="post_flag" align="center" prompt="确认标志" width="100"/>
                                <a:column name="period_name" align="center" prompt="确认期间" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--风险金计提-->
                    <a:tab prompt="风险金计提" width="150" id="risk_fund_accrual_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="stamp_duty_accrual_month_settle" text="确认"/>
                            <a:gridButton click="risk_fund_accrual_query" text="查询"/>
                            <a:gridButton click="risk_fund_accrual_reset" text="重置"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="120" prompt="查询的条件" title="查询的条件" >
                            <a:lov name="period_name" width="120" prompt="期间" readOnly="true" bindTarget="risk_fund_accrual_query_ds"/>
                            <a:textField name="bp_name" width="120" prompt="客户名称" bindTarget="risk_fund_accrual_query_ds"/>
                            <a:textField name="contract_name" width="120" prompt="合同名称" bindTarget="risk_fund_accrual_query_ds"/>
                            <a:textField name="contract_number" width="120" prompt="合同编号" bindTarget="risk_fund_accrual_query_ds"/>
                            <!--<a:comboBox name="risk_reserve_ratio_n" width="150" prompt="风险准备金率(%)" bindTarget="risk_fund_accrual_query_ds"/>-->
                            <a:comboBox name="post_flag_n" width="120" prompt="确认标志" bindTarget="risk_fund_accrual_query_ds"/>
                        </a:form>
                        <a:grid bindTarget="risk_fund_accrual_ds" marginHeight="270"
                                marginWidth="110"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="客户名称" width="180" align="left" footerRenderer="sum_foot"/>
                                <a:column name="project_id" hidden="true" width="0"/>
                                <a:column name="project_name" prompt="项目名称" align="left" width="180"/>
                                <a:column name="contract_number" prompt="合同编号" align="left" width="120"
                                          renderer="con_contract_renderer"/>
                                <a:column name="contract_name" prompt="合同名称" align="left" width="180"/>
                                <a:column name="received_amount" prompt="期末业务余额(元)" width="140" align="right" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="inception_of_lease" prompt="起租日期" width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="five_classification_result_n" prompt="资产分类" width="100" align="center"/>
                                <a:column name="risk_reserve_ratio" prompt="风险准备金率(%)" width="120" align="center" renderer="percentFormat"/>
                                <a:column name="withdrawal_amount" prompt="计提金额(元)" align="right" width="130" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="post_flag" align="center" prompt="确认标志" width="100"/>
                                <a:column name="period_name" align="center" prompt="确认期间" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--印花税计提（租赁）-->
                    <a:tab prompt="印花税计提（租赁）" width="200" id="stamp_duty_accrual_lease_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="stamp_duty_accrual_lease_month_settle" text="确认"/>
                            <a:gridButton click="stamp_duty_accrual_lease_query" text="查询"/>
                            <a:gridButton click="stamp_duty_accrual_lease_reset" text="重置"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="110" prompt="查询的条件" title="查询的条件" >
                            <a:lov name="period_name" width="120" prompt="期间" readOnly="true" bindTarget="stamp_duty_accrual_lease_query_ds"/>
                            <a:textField name="bp_name" width="120" prompt="客户名称" bindTarget="stamp_duty_accrual_lease_query_ds"/>
                            <a:textField name="contract_name" width="120" prompt="合同名称" bindTarget="stamp_duty_accrual_lease_query_ds"/>
                            <a:textField name="contract_number" width="120" prompt="合同编号" bindTarget="stamp_duty_accrual_lease_query_ds"/>
                            <a:comboBox name="post_flag_n" width="120" prompt="确认标志" bindTarget="stamp_duty_accrual_lease_query_ds"/>
                        </a:form>
                        <a:grid bindTarget="stamp_duty_accrual_lease_ds" marginHeight="270"
                                marginWidth="100"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="客户名称" width="180" align="left" footerRenderer="sum_foot"/>
                                <a:column name="project_id" hidden="true" width="0"/>
                                <a:column name="project_name" prompt="项目名称" align="left" width="180"/>
                                <a:column name="contract_number" prompt="合同编号" align="left" width="120"
                                          renderer="con_contract_renderer"/>
                                <a:column name="contract_name" prompt="合同名称" align="left" width="180"/>
                                <a:column name="contract_amount" prompt="合同金额(元)" width="130" align="right" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="inception_of_lease" prompt="起租日期" width="100" align="center" renderer="Leaf.formatDate"/>
                                <a:column name="contract_type" prompt="合同类型" width="100" align="center" renderer="contractType"/>
                                <a:column name="stamp_duty" prompt="印花税率(%)" align="center" width="90" renderer="percentFormat"/>
                                <a:column name="stamp_duty_accrued_amount" prompt="印花税计提金额(元)" align="right" width="130" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="post_flag" align="center" prompt="确认标志" width="100"/>
                                <a:column name="period_name" align="center" prompt="确认期间" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <!--印花税计提（融资）-->
                    <a:tab prompt="印花税计提（融资）" width="210" id="stamp_duty_accrual_financing_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="stamp_duty_accrual_financing_month_settle" text="确认"/>
                            <a:gridButton click="stamp_duty_accrual_financing_query" text="查询"/>
                            <a:gridButton click="stamp_duty_accrual_financing_reset" text="重置"/>
                        </a:screenTopToolbar>
                        <a:form column="4" labelWidth="100" prompt="查询的条件" title="查询的条件" >
                            <a:lov name="period_name" width="120" prompt="期间" readOnly="true" bindTarget="pre_lease_interest_query_ds"/>
                            <a:textField name="bp_name" width="120" prompt="交易对手" bindTarget="stamp_duty_accrual_financing_query_ds"/>
                            <a:textField name="contract_number" width="120" prompt="融资合同编号" bindTarget="stamp_duty_accrual_financing_query_ds"/>
