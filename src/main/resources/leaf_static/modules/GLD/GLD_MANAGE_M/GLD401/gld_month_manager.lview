<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="${/parameter/@layout_code}_gld_month_manager_history_link_id" url="${/request/@context_path}/modules/GLD/GLD_MANAGE_M/GLD401/gld_month_manager_history.lview"/>
        <a:link id="con_contract_detail_id1"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="fin003_lon_create_id1"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <a:link id="fin003_tikuan_lon_detail_id1"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>
        <style>
            /*滚动条样式*/
            .item-tab .tab::-webkit-scrollbar { /*滚动条整体样式*/
                width: 8px; /*高宽分别对应横竖滚动条的尺寸*/
                height: 8px;
            }

            .item-tab .tab::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 5px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background-color: rgb(204, 204, 204);
            }

            .item-tab .tab::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background-color: white;
            }
        </style>

        <script><![CDATA[

        function sum_foot(data, name) {
            if (name == 'bp_name') {
                return '<font color=red>' + '合计(元)：' + '</font>';
            } else if (name == 'finance_amount') {
                return colum_caculateTotal(data, name);
            }else if (name == 'finance_income') {
                return colum_caculateTotal(data, name);
            }else if (name == 'tax_seq') {
                return '<font color=red>' + '合计(元)：' + '</font>';
            }else if (name == 'contract_amount') {
                return colum_caculateTotal(data, name);
            }else if (name == 'stamp_tax_fee') {
                return colum_caculateTotal(data, name);
            }
        }

        function colum_caculateTotal(data, name) {
            var total = 0;
            var length = data.length;
            var value = 0;
            for (var i = 0;i < length;i++) {
                if (Ext.isEmpty(data[i].get(name))) {
                    value = 0;
                } else {
                    value = data[i].get(name);
                }
                total = plus(total, value);
            }
            return '<font color=red>' + Leaf.formatMoney(total) + '</font>';
        }

        function onUpdate_period_name_ds(ds, record, name, value, oldvalue){
            debugger;
            if(name == 'period_name'){
                var period_name = $('period_name_ds').getCurrentRecord().get('period_name');
                var period_name_n = $('period_name_ds').getCurrentRecord().get('period_name_n');
                if(period_name != null && period_name != ''){
                    //月结
                    $('pre_lease_interest_query_ds').getCurrentRecord().set('period_name',period_name);
                    $('pre_lease_interest_query_ds').getCurrentRecord().set('period_name_n',period_name_n);
                    pre_lease_interest_query();
                    $('risk_fund_accrual_query_ds').getCurrentRecord().set('period_name',period_name);
                    $('risk_fund_accrual_query_ds').getCurrentRecord().set('period_name_n',period_name_n);
                    risk_fund_accrual_query();
                    $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('period_name',period_name);
                    $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('period_name_n',period_name_n);
                    stamp_duty_accrual_lease_query();
                    $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('period_name',period_name);
                    $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('period_name_n',period_name_n);
                    stamp_duty_accrual_financing_query();
                    $('cost_accrual_query_ds').getCurrentRecord().set('period_name',period_name);
                    $('cost_accrual_query_ds').getCurrentRecord().set('period_name_n',period_name_n);
                    cost_accrual_query();
                }

            }

        }
        //月结
        function onQuery_pre_lease_interest_ds(){
            $('pre_lease_interest_ds').setQueryParameter('cf_item',10);
        }


        function pre_lease_interest_query(){
            if($('pre_lease_interest_query_ds').getCurrentRecord()){
                if($('pre_lease_interest_query_ds').getCurrentRecord().get('period_name')){
                    $('pre_lease_interest_ds').query();
                }else{
                    Leaf.showMessage('提示','请先选择期间再进行操作！');
                }
            }else{
                Leaf.showMessage('提示','请先选择期间再进行操作！');
            }

        }

        //成本计提
        function cost_accrual_query(){
            debugger;
            if($('cost_accrual_query_ds').getCurrentRecord()){
                var period_name = $('cost_accrual_query_ds').getCurrentRecord().get('period_name')
                if(period_name){
                    $('cost_accrual_ds').query();
                }else{
                    Leaf.showMessage('提示','请先选择期间再进行操作！');
                }
            }else{
                Leaf.showMessage('提示','请先选择期间再进行操作！');
            }
        }

        //风险金计提
        function risk_fund_accrual_query(){
            if($('risk_fund_accrual_query_ds').getCurrentRecord()){
                var period_name = $('risk_fund_accrual_query_ds').getCurrentRecord().get('period_name')
                if(period_name){
                    $('risk_fund_accrual_query_ds').getCurrentRecord().set('period_name', period_name);
                    $('risk_fund_accrual_ds').query();
                }else{
                    Leaf.showMessage('提示','请先选择期间再进行操作！');
                }
            }else{
                Leaf.showMessage('提示','请先选择期间再进行操作！');
            }
        }

        //印花税计提（租赁）
        function stamp_duty_accrual_lease_query(){
            if($('stamp_duty_accrual_lease_query_ds').getCurrentRecord()){
                var period_name = $('pre_lease_interest_query_ds').getCurrentRecord().get('period_name');
                if(period_name){
                    $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().set('period_name', period_name);
                    $('stamp_duty_accrual_lease_ds').query();
                }else{
                    Leaf.showMessage('提示','请先选择期间再进行操作！');
                }
            }else{
                Leaf.showMessage('提示','请先选择期间再进行操作！');
            }
        }

        //印花税计提（融资）
        function stamp_duty_accrual_financing_query(){
            if($('stamp_duty_accrual_financing_query_ds').getCurrentRecord()){
                var period_name = $('pre_lease_interest_query_ds').getCurrentRecord().get('period_name');
                if(period_name){
                    $('stamp_duty_accrual_financing_query_ds').getCurrentRecord().set('period_name', period_name);
                    $('stamp_duty_accrual_financing_ds').query();
                }else{
                    Leaf.showMessage('提示','请先选择期间再进行操作！');
                }
            }else{
                Leaf.showMessage('提示','请先选择期间再进行操作！');
            }
        }
        //风险金计提
        function stamp_duty_accrual_month_settle(){
            var risk_fund_accrual_record = $('risk_fund_accrual_ds').getSelected();
            var param = [];
            var pre_post_flag = 'N';
            var post_flag = 'N';
            for(var i=0;i<risk_fund_accrual_record.length;i++){
                if(risk_fund_accrual_record[i].get('pre_post_flag') == 'Y'){
                    pre_post_flag = 'Y';
                    break;
                }else if(risk_fund_accrual_record[i].get('post_flag') == 'Y'){
                    post_flag = 'Y';
                    break;
                }else{
                    param.push(risk_fund_accrual_record[i].data);
                }
            }
            if(risk_fund_accrual_record.length == 0){
                Leaf.showMessage('提示','未选择一条记录！');
                return;
            }

            if(post_flag == 'Y'){
                Leaf.showMessage('提示','存在月结过的记录，不可重复月结！');
                return;
            }
            var period_name = $('stamp_duty_accrual_lease_query_ds').getCurrentRecord().get('period_name');
            Leaf.Masker.mask(Ext.getBody(), '执行中...');
            Leaf.request({
                url: "${/request/@context_path}/gld/risk/fund/accrual/check",
                para:param,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    $L.showInfoMessage("提示","执行成功!",function () {
                        risk_fund_accrual_query();
                    });
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },

                scope: this
            });
        }

        //印花税计提（租赁）
        function stamp_duty_accrual_lease_month_settle(){
            var stamp_duty_accrual_lease_record = $('stamp_duty_accrual_lease_ds').getSelected();
