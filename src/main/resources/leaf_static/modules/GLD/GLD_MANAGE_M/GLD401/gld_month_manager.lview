                            <a:comboBox name="post_flag_n" width="120" prompt="确认标志" bindTarget="stamp_duty_accrual_financing_query_ds"/>
                        </a:form>
                        <a:grid bindTarget="stamp_duty_accrual_financing_ds" marginHeight="270"
                                marginWidth="100"
                                navBar="true">
                            <a:toolBar>
                                <a:button type="excel"/>
                            </a:toolBar>
                            <a:columns>
                                <a:column name="bp_name" prompt="交易对手" width="200" align="left" footerRenderer="sum_foot"/>
                                <a:column name="contract_number" prompt="融资合同编号" align="left" width="180"
                                          renderer="lon_contract_renderer"/>
                                <a:column name="withdraw_number" prompt="提款编号" align="left" width="180"
                                          renderer="lon_draw_renderer"/>
                                <a:column name="due_amount" prompt="提款金额(元)" align="right" width="120" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="currency_n" prompt="币种" align="center" width="80"/>
                                <a:column name="due_date" prompt="提款日期" align="center" width="120" renderer="Leaf.formatDate"/>
                                <a:column name="stamp_duty_accrued_amount" prompt="印花税计提金额(元)" align="right" width="120" renderer="Leaf.formatMoney" footerRenderer="sum_foot"/>
                                <a:column name="post_flag" align="center" prompt="确认标志" width="100"/>
                                <a:column name="period_name" align="center" prompt="确认期间" width="100"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>


                    <a:tab prompt="月结结束" width="80" id="month_end_tab">
                        <a:screenTopToolbar>
                            <a:gridButton click="month_end" text="月结结束"/>
                        </a:screenTopToolbar>
                        <a:form column="1" labelWidth="100" prompt="期间选择" title="期间选择" marginHeight="370">
                            <a:lov name="period_name" width="120" prompt="期间" required="true"
                                   bindTarget="period_name_ds"/>
                        </a:form>
                    </a:tab>
                </a:tabs>
                <a:events>
                    <a:event name="select" handler="onSelect_month_tab"/>
                </a:events>
            </a:tabPanel>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

