<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: wangchao
    $Date 2020-5-7 17:01:00
    $Description 对账入口页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[


        function gld305_check_confirm(){
            var ds_id='gld305_check_date_ds';
            if ($(ds_id).validate()) {
                var record = $('gld305_check_date_ds').getCurrentRecord();
                var check_date = record.get('check_date');
                var check_date =Leaf.formatDate(check_date);
                Leaf.Masker.mask(Ext.getBody(), '请求中。。。');
                Leaf.request({
                    url: '${/request/@context_path}/hls/check/account/data/post',
                    para:{
                        check_date:check_date
                    },
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        var is_no_count = res.result.record[0].is_no_count;
                        var is_different='否';

                        if(is_no_count>0){
                            is_different='是';
                        }

                        var win = new Leaf.Window({
                            id: 'gld305_check_date_winid',
                            url: '${/request/@context_path}/modules/GLD/GLD_MANAGE_M/GLD305/gld_reconciliation_detail.lview',
                            params: {
                                check_date: check_date,
                                is_different:is_different
                            },
                            title: '对账明细',
                            fullScreen: true,
                            draggable: true
                        });
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="gld305_check_date_ds" autoCreate="true">
                <a:fields>
                    <a:field name="check_date" required="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld305_check_confirm" text="HAP.CONFIRM"/>
            </a:screenTopToolbar>
            <a:form title="系统对账" labelwidth="120" column="5">
                <a:datePicker name="check_date" bindTarget="gld305_check_date_ds"
                             prompt="对账日期"  width="140">
                </a:datePicker>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>