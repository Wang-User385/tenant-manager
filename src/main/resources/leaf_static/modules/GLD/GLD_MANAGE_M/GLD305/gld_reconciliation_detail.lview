<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: wangchao
    $Date 2020-5-7 17:01:00
    $Description 对账明细页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <script><![CDATA[
            function gld305_check_query() {
                $('gld305_line_result_ds').query();
            }
           function gld305_check_reset() {
            $('gld305_form_query_ds').reset();
            }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="yes_no_ds" lookupCode="SYS.YES_NO"/>
            <a:dataSet id="gld305_form_query_ds">
                <a:fields>
                    <a:field name="account_name"/>
                    <a:field name="is_same"/>
                    <a:field name="is_same_n" displayField="code_value_name" options="yes_no_ds"
                             returnField="is_same" valueField="code_value_name"/>
                    <a:field name="contractNumber"/>
                    <a:field name="is_different" defaultValue="${/parameter/@is_different}" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld305_line_result_ds" autoQuery="true"
                       queryDataSet="gld305_form_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/hls/eas/account/list?checkDate=${/parameter/@check_date}">
                <a:fields>
                    <a:field name="is_same"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld305_check_query" text="HAP.QUERY"/>
                <a:gridButton click="gld305_check_reset" text="HLS.RESET"/>
            </a:screenTopToolbar>
            <a:form title="系统对账" labelwidth="120" column="5">

                <a:textField name="account_name" bindTarget="gld305_form_query_ds" prompt="科目名称"/>
                <a:comboBox name="is_same_n" bindTarget="gld305_form_query_ds" prompt="是否相同"/>
                <a:textField name="contract_number" bindTarget="gld305_form_query_ds" prompt="支付表编号"/>
                <a:textField name="is_different" bindTarget="gld305_form_query_ds" prompt="是否存在差异"/>

            </a:form>
            <a:grid id='line_result_grid' bindTarget="gld305_line_result_ds" marginHeight="150"
                    marginWidth="30" navBar="true" showRowNumber="true" >
                <a:columns>
                    <a:column name="account_code" prompt="科目代码" width="80" align="left"/>
                    <a:column name="company_name" prompt="财务组织" width="180" align="left"/>
                    <a:column name="account_name" prompt="科目名称" width="260"  align="left"/>
                    <a:column name="contract_number" prompt="支付表编号" align="left" width="140"/>
                    <a:column name="currency_name" prompt="币种" width="80"  align="center"/>
                    <a:column name="check_date" prompt="日期" width="80"  align="center"/>
                    <a:column name="before_balance" prompt="业务系统日期初"  renderer="Leaf.formatMoney" width="110" align="right"/>
                    <a:column name="day_balance" prompt="业务系统查询日发生额"  renderer="Leaf.formatMoney" width="150" align="right"/>
                    <a:column name="after_balance" prompt="业务系统余额"  renderer="Leaf.formatMoney" width="100" align="right"/>
                    <a:column name="eas_before_balance" prompt="财务系统日期初"  renderer="Leaf.formatMoney" width="110" align="right"/>
                    <a:column name="eas_day_balance" prompt="财务系统查询日发生额"  renderer="Leaf.formatMoney" width="150" align="right"/>
                    <a:column name="eas_after_balance" prompt="财务系统余额"  renderer="Leaf.formatMoney" width="100" align="right"/>
                    <a:column name="is_same" prompt="是否相同" align="center" width="60"/>
                    <a:column name="different_balance" prompt="余额差额"  renderer="Leaf.formatMoney" width="80" align="right"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>