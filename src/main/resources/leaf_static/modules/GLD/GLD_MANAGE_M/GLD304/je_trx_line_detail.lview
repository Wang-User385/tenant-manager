        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            if(ds.id === ds_id){
                if (name === 'je_date') {
                    var je_date = new Date(value);
                    // alert(je_date.getFullYear() + '-' + (je_date.getMonth()+1 < 10 ? '0'+(je_date.getMonth()+1) : je_date.getMonth()+1));
                    record.set('period_name',je_date.getFullYear() + '-' + (je_date.getMonth()+1 < 10 ? '0'+(je_date.getMonth()+1) : je_date.getMonth()+1));
                    record.set('year',je_date.getFullYear());

                }
            }

        };

        //新增和加载时调用(form)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'gld_je_head');
            if(ds_id === ds.id){
                var je_date = new Date(record.get('je_date'));
                record.set('year',je_date.getFullYear());
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>