<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: WANGCHAO
    $Revision: 1.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="gld_je_line_info_link" url="${/request/@context_path}/modules/GLD/GLD_MANAGE_M/GLD304/je_trx_line_detail.lview"/>
    <script><![CDATA[

    function gld600_je_line_query(){
        $('gld600_je_head_ds').query();
    }

    function gld600_je_line_reset(){
        $('gld600_je_head_form_ds').reset();
    }

    function gld600_je_head_ds_indexchange(ds,record){
        var je_head_id = record.get('je_head_id');
        $('gld600_je_line_group_ds').setQueryParameter('je_head_id',je_head_id);
        $('gld600_je_line_group_ds').query();
    }

    function gld600_je_line_group_ds_indexchange(ds,record){
        var je_line_id_str = record.get('je_line_id_str');
        $('gld600_je_line_seq_ds').setQueryParameter('je_line_id_str',je_line_id_str);
        $('gld600_je_line_seq_ds').query();

    }

    function sumFunction(datas, name) {
        var sum = 0;
        for (var i = 0;i < datas.length;i++) {
            var r = datas[i];
            var d = r.get(name);
            var n = parseFloat(d);
            if (!isNaN(n)) {
                sum = plus(sum, n);
            }
        }
        var total = (typeof(sum) == 'undefined' ? '' : parseFloat(sum));
        return '<font>' + Leaf.formatNumber(total) + '</font>';
    }



    function gld700_je_head_post(){
        var ds_id='gld600_je_head_ds';
        var records =  $('gld600_je_head_ds').getSelected();
        if (records.length == 0) {
            Leaf.showMessage('提示！', '请至少选择一条记录！');
            return;
        }

        var jeHeadArr = [];
        for(var i=0;i<records.length;i++){

            var gl_status= records[i].get('gl_status');
//            if(gl_status=='SYN'||gl_status=='DELETE_FAILURE'){
//                Leaf.showMessage('提示！', '所勾选记录存在已同步或者删除失败的凭证！');
//                return;
//            }

            var jeHead = {};
            jeHead.jeHeadId = records[i].get('je_head_id');
            jeHead._status = 'update';
            jeHeadArr.push(jeHead);
        }

        Leaf.showConfirm('提示', '确定进行凭证传输？', function () {
            if ($(ds_id).validate()) {
                Leaf.Masker.mask(Ext.getBody(), '正在请求。。');
                Leaf.request({
                    url: "${/request/@context_path}/gld/je/data/post",
                    para: {
                        jeHeadList:jeHeadArr,
                        session_id:'${/session/@session_id}'
                    },
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        $('gld600_je_head_ds').query();
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }

        }, null, 200, 100);
    }

    function gld700_je_head_delete(){
        var ds_id='gld600_je_head_ds';
        var records = $('gld600_je_head_ds').getSelected();
        if (records.length !=1) {
            Leaf.showMessage('提示！', '请选择一条记录！');
            return;
        }
        var gl_status= records[0].get('gl_status');
//        if(gl_status!='SYN'&&gl_status!='DELETE_FAILURE'){
//            Leaf.showMessage('提示！', '所勾选记录不是已同步或者删除失败的凭证不能进行删除操作！');
//            return;
//        }
        var record=$(ds_id).getSelected()[0];
        if(!record.get('voucher_id')){
            Leaf.showMessage('提示！', 'EAS凭证编号为空不可以进行凭证删除！');
            return;
        }

        Leaf.showConfirm('提示', '确定进行凭证删除？', function () {
            if ($(ds_id).validate()) {
                Leaf.Masker.mask(Ext.getBody(), '正在请求。。');
                Leaf.request({
                    url: "${/request/@context_path}/gld/je/data/delete",
                    para: {
                        voucher_id:record.get('voucher_id'),
                        com_org_num:record.get('com_org_num'),
                        source_id:record.get('je_head_id')
                    },
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        $('gld600_je_head_ds').query();
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }

        }, null, 200, 100);
    }

    function gld600_je_head_grid_render(value,record,name){
        if (name = 'je_number') {
            var link_function = 'open_je_line_detail_win';
            return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
        }
    }

    function open_je_line_detail_win(record_id,ds_id){
        var record = $(ds_id).findById(record_id);
        var param = {};
        param['url_title'] = '凭证明细';
        param['function_code'] = 'GLD310F1';
        param['function_usage'] = 'QUERY';
        param['je_head_id'] = record.get('je_head_id');
        param['winid'] = 'gld310_certificate_win_id';
        hls_doc_get_layout_code(param, 'gld_je_line_info_link', ds_id, 'GLD310');
    }

    ]]></script>

        <a:dataSets>
            <a:dataSet id="gld600_je_head_form_je_status_ds">
                <a:datas>
                    <a:record code_value="NEW" code_value_name="新建"/>
                    <a:record code_value="CONFIRM" code_value_name="确认"/>
                    <a:record code_value="TRIAL" code_value_name="初审通过"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="gld700_je_head_gl_status_ds" lookupCode="GLD.GL_STATUS"/>
            <a:dataSet id="gld600_je_head_form_ds" autoCreate="true" autoQuery="false">
                <a:fields>
                    <a:field name="date_from"/>
                    <a:field name="date_to"/>
                    <a:field name="amount_from"/>
                    <!--<a:field name="amount_to"/>-->
                    <a:field name="je_number"/>
                    <a:field name="voucher_number"/>
                    <a:field name="gl_status"/>
                    <a:field name="gl_status_n" options="gld700_je_head_gl_status_ds" displayField="code_value_name"
                             valueField="code_value"
                             returnField="gl_status"/>

                    <a:field name="je_status_n" options="gld600_je_head_form_je_status_ds" displayField="code_value_name"
                             valueField="code_value"
                             returnField="je_status"/>
                    <a:field name="je_status"/>
                    <a:field name="description"/>
                    <a:field name="je_description"/>
                    <a:field name="payment_number"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld600_je_head_ds" selectable="true"
                       queryUrl="${/request/@context_path}/gld/je/head/post/query" queryDataSet="gld600_je_head_form_ds"
                       autoQuery="true">
                        <a:fields>
                            <a:field name="je_head_id"/>
                            <a:field name="je_date" datatype="date" />

                        </a:fields>
                <a:events>
                    <a:event name="indexchange" handler="gld600_je_head_ds_indexchange"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="gld600_je_line_group_ds" bindTarget="gld600_je_head_ds"
                       queryUrl="${/request/@context_path}/gld/je/line/group/query"
                       autoQuery="true">
                <a:fields>
                    <a:field name="je_head_id"/>

                </a:fields>
                <a:events>
                    <a:event name="indexchange" handler="gld600_je_line_group_ds_indexchange"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="gld600_je_line_seq_ds" bindTarget="gld600_je_line_group_ds"
                       queryUrl="${/request/@context_path}/gld/je/line/seq/query"
                       autoQuery="true">
                <a:fields>
                    <a:field name="je_head_id"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>

            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld600_je_line_query" text="HAP.QUERY"/>
                <a:gridButton click="gld600_je_line_reset" text="HAP.RESET"/>
                <a:gridButton click="gld700_je_head_post" text="凭证传输"/>
                <a:gridButton click="gld700_je_head_delete" text="凭证删除"/>
            </a:screenTopToolbar>

            <a:form title="查询框">

                <a:hBox>
                    <a:textField name="description" prompt="凭证事务" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="je_description" prompt="行摘要" bindTarget="gld600_je_head_form_ds"/>
                    <a:datePicker name="date_from" prompt="凭证日期从" bindTarget="gld600_je_head_form_ds"/>
                    <a:datePicker name="date_to" prompt="凭证日期到" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="payment_number" prompt="支付表编号" bindTarget="gld600_je_head_form_ds"/>
                </a:hBox>
                <a:hBox>
                    <a:comboBox name="je_status_n" prompt="状态" bindTarget="gld600_je_head_form_ds"/>
                    <a:comboBox name="gl_status_n" prompt="传输状态" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="period_name" prompt="期间" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="je_number" prompt="凭证编号" bindTarget="gld600_je_head_form_ds"/>
                    <a:textField name="voucher_number" prompt="EAS凭证号" bindTarget="gld600_je_head_form_ds"/>
                </a:hBox>
            </a:form>
            <div style="width: 100%;position: relative;">
                <!--凭证头-->
                <div style="width: 49%;float: left;">
                    <a:grid id="gld600_je_head_grid" bindTarget="gld600_je_head_ds"
                            navBar="true" width="700" marginHeight="200">
                        <a:toolBar>
                            <a:button type="excel"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="je_number" prompt="凭证编号" width="100" renderer="gld600_je_head_grid_render"/>
                            <a:column name="je_trx_description" prompt="凭证事务" width="160" showTitle="true"/>
                            <a:column name="description" prompt="凭证摘要" width="120" showTitle="true"/>
                            <a:column name="voucher_number" prompt="EAS凭证号" width="80"/>
                            <a:column name="period_name" prompt="期间" width="60" align="center"/>
                            <a:column name="je_date" prompt="凭证日期" renderer="Leaf.formatDate" width="90"/>
                            <a:column name="je_creation_date" prompt="凭证生成日期" renderer="Leaf.formatDate" width="120"/>
                            <a:column name="currency" prompt="币种" width="60" align="center"/>
                            <a:column name="je_amount" prompt="金额" renderer="Leaf.formatMoney" width="100" align="right"/>
                            <a:column name="je_type" prompt="凭证分类" width="60" align="center"/>
                            <a:column name="gl_msg" prompt="传输消息" width="100" showTitle="true"/>
                            <a:column name="gl_status_n" prompt="传输状态" width="60" align="center"/>
                        </a:columns>
                    </a:grid>
                </div>




                <!--凭证行-->
                <div style="width: 49%;float: right;">
                    <a:grid id="gld600_je_line_grid" bindTarget="gld600_je_line_group_ds"
                            navBar="true" width="700">
                        <a:toolBar>
                            <a:button type="excel"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="account_code" prompt="科目代码" width="70"/>
                            <a:column name="account_id_n" prompt="科目描述" width="230" showTitle="true"/>
                            <a:column name="dr_total" prompt="原币借方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction" align="right"/>
                            <a:column name="cr_total" prompt="原币贷方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction" align="right"/>
                            <a:column name="dr_functional_amount_total" prompt="本币借方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction" align="right"/>
                            <a:column name="cr_functional_amount_total" prompt="本币贷方" renderer="Leaf.formatMoney" width="90" footerRenderer="sumFunction" align="right"/>
                        </a:columns>
                    </a:grid>

                    <a:grid id="gld600_je_line_detail_grid" bindTarget="gld600_je_line_seq_ds"
                            navBar="true" width="700">
                        <a:toolBar>
                            <a:button type="excel"/>
                        </a:toolBar>
                        <a:columns>
                            <a:column name="je_description" prompt="行摘要" width="250" showTitle="true"/>
                            <a:column name="segment_1" prompt="参考段一" width="80"/>
                            <a:column name="segment_2" prompt="参考段二" width="140" showTitle="true"/>
                            <a:column name="segment_3" prompt="参考段三" width="130"/>
                            <a:column name="segment_4" prompt="参考段四" width="60"/>
                        </a:columns>
                    </a:grid>
                </div>
                <div style="clear: both;"></div>
            </div>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>