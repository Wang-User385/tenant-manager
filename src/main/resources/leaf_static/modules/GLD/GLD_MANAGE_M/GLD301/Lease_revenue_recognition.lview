<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: WuJun
    $Date 2020-2-5 17:01:00
    $Description 租赁收入确认页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application"  xmlns:s="leaf.plugin.script"
          customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.gld.service.IContractFinanceIncomeService.selectDefaultPeriodName" rootpath="period_name_path"/>
        <s:server-script><![CDATA[

        ]]></s:server-script>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[
            function gld301_main_screen_query() {
                //alert('${/model/period_name_path/record/@period_name}');
                $('gld301_con_unearned_info_ds').query();
            }

            function gld301_main_screen_confirm() {
                var checkFlag = 'N';
                var saveData = [];
                var confirm_record = $('gld301_con_unearned_info_ds').getSelected();
                if (confirm_record.length < 1) {
                    $L.showInfoMessage("提示","请选择需要确认的数据!");
                } else {
                    for(var i = 0; i < confirm_record.length; i++){
                        var postFlag = confirm_record[i].get('post_flag');
                        var update_arr = {};
                        if (postFlag == 'Y') {
                            checkFlag = 'Y';
                        } else {
                            update_arr.financeIncomeId = confirm_record[i].get('finance_income_id');
                            update_arr.postFlag = 'Y';
                            update_arr._status = 'update';
                            saveData.push(update_arr);
                        }
                    }
                    if(checkFlag == 'Y') {
                        $L.showInfoMessage("提示","存在已确认的数据,不可重复确认!");
                    }else {
                        new Leaf.showConfirm('${l:HLS.PROMPT}', '确认进行收入确认吗?', function okFun() {
                            Leaf.Masker.mask(Ext.getBody(), '收入确认中...');
                            Leaf.request({
                                url: "${/request/@context_path}/gld/contract/finance/income/submit",
                                para: saveData,
                                type: "POST",
                                success: function (res) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.SideBar.show({
                                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                                        duration: 2000
                                    });
                                    gld301_main_screen_query();
                                },
                                error: function (res) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.SideBar.show({
                                        type: 'warning',
                                        msg: '操作失败',
                                        duration: 1000
                                    });
                                },
                                failure: function (res) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.SideBar.show({
                                        type: 'warning',
                                        msg: '操作失败',
                                        duration: 1000
                                    });
                                },
                                scope: this
                            });
                        }, function cancel() {
                            Leaf.Masker.unmask(Ext.getBody());
                        }, 200, 100);
                    }
                }
            }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="gld301_post_flag_ds" lookupCode="CLD.POST_FLAG"/>
            <a:dataSet id="gld301_period_name_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/gld/contract/finance/income/period/name/query" queryMethod="GET">
                <a:fields>
                    <a:field name="period_set_id"/>
                    <a:field name="period_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld301_con_unearned_query_ds">
                <a:fields>
                    <a:field name="contractName" />
                    <a:field name="postFlagDesc" returnField="postFlag" defaultValue="未确认"
                             options="gld301_post_flag_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="postFlag" defaultValue="N"/>
                    <a:field name="periodNameFrom" options="gld301_period_name_ds" defaultValue="${/model/period_name_path/record/@PERIOD_NAME}"
                             displayField="period_name" valueField="period_name" returnField="period_name">
                        <a:mapping>
                            <a:map from="period_name" to="periodNameFrom"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="periodNameTo" options="gld301_period_name_ds" defaultValue="${/model/period_name_path/record/@PERIOD_NAME}"
                             displayField="period_name" valueField="period_name" returnField="period_name">
                        <a:mapping>
                            <a:map from="period_name" to="periodNameTo"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld301_con_unearned_info_ds" autoQuery="true"
                       queryDataSet="gld301_con_unearned_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/gld/contract/finance/income/query">
                <a:fields>
                    <a:field name="finance_income_id"/>
                    <a:field name="post_flag"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld301_main_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="gld301_main_screen_confirm" text="HAP.CONFIRM"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" labelwidth="100" column="4">
                <a:textField name="contractName" bindTarget="gld301_con_unearned_query_ds" prompt="合同名称" emptyText="合同名称" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="gld301_main_screen_query"/>
                    </a:events>
                </a:textField>
                <a:comboBox name="postFlagDesc" bindTarget="gld301_con_unearned_query_ds" prompt="确认状态" emptyText="确认状态" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="gld301_main_screen_query"/>
                    </a:events>
                </a:comboBox>
                <a:comboBox name="periodNameFrom" bindTarget="gld301_con_unearned_query_ds" prompt="期间从" emptyText="期间从" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="gld301_main_screen_query"/>
                    </a:events>
                </a:comboBox>
                <a:comboBox name="periodNameTo" bindTarget="gld301_con_unearned_query_ds" prompt="期间到" emptyText="期间到" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="gld301_main_screen_query"/>
                    </a:events>
                </a:comboBox>
            </a:form>
            <a:grid id='conIncomeConfirmGrid' bindTarget="gld301_con_unearned_info_ds" marginHeight="130" marginWidth="30" navBar="true" showRowNumber="true" >
                <a:columns>
                    <a:column name="period_name" prompt="期间月份" width="120"/>
                    <a:column name="contract_number" prompt="主合同编号" width="150"/>
                    <a:column name="contract_name" prompt="合同名称" align="left" width="240"/>
                    <a:column name="bp_name" prompt="客户名称" width="260"/>
                    <a:column name="start_end_date" prompt="计提日期从到" width="200"/>
                    <a:column name="days" prompt="当月计息天数"  width="120"/>
                    <a:column name="finance_income" prompt="计提利息" align="right" renderer="Leaf.formatMoney" width="100"/>
                    <a:column name="tax_type_rate" prompt="税率" align="right" width="100"/>
                    <a:column name="cf_item_desc" prompt="现金流项目" width="100"/>
                    <a:column name="post_flag_desc" prompt="确认状态" width="80"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>