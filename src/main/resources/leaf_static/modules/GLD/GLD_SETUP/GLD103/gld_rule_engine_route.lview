<?xml version="1.0" encoding="UTF-8"?>
<!--
    Purpose: 规则引擎定义-规则树编辑
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <link href="${/request/@context_path}/leafresources/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css"/>
        <!--[if IE 8]>
        <script src="${/request/@context_path}/lib/polyfill/respond.min.js"></script>
        <script src="${/request/@context_path}/lib/polyfill/es5-shim.min.js"></script>
        <![endif]-->
        <!--<link rel="stylesheet" href="${/request/@context_path}/leafresources/css/RULEENGINE/bootstrap.min.css"/>-->
        <link rel="stylesheet" href="${/request/@context_path}/leafresources/css/RULEENGINE/jquery.jOrgChart.css"/>
        <link rel="stylesheet" href="${/request/@context_path}/leafresources/css/RULEENGINE/custom.css"/>
        <link rel="stylesheet" href="${/request/@context_path}/leafresources/css/RULEENGINE/prettify.css" type="text/css"/>
        <script type="text/javascript" src="${/request/@context_path}/leafresources/js/RULEENGINE/prettify.js"></script>
        <script type="text/javascript" src="${/request/@context_path}/leafresources/js/RULEENGINE/jquery.min.js"></script>
        <!--<script type="text/javascript" src="${/request/@context_path}/leafresources/js/RULEENGINE/jquery-ui.min.js"></script>-->
        <script src="${/request/@context_path}/leafresources/js/RULEENGINE/jquery.jOrgChart.js"></script>
        <script><![CDATA[
        // if(!!jQuery) $=jQuery;
        var levelCount = {};
        var levelDatas = [];
        var frameOpenFlag = false;
        var currentTreeScale = 1;
        var deleteLevelDatas = [];
        var movingFlag=false;
        var ruleEngineId = '${/parameter/@ruleEngineId}';
        var dataSourceId = '${/parameter/@dataSourceId}';
        var templetType = '${/parameter/@templetType}';
        var jeTrx = '${/parameter/@jeTrx}';
        jQuery(document).ajaxSend(function (e, xhr, options) {
            xhr.setRequestHeader("X-CSRF-TOKEN", "${/session/@_csrf.token}");
        });
        Leaf.onReady(function () {
            loadInitData();
            var tree = document.getElementById("ruleTreeChart");
            var box = document.getElementById("rule_engine_tree_wrapper");
            var realTree = jQuery("#ruleTreeChart .jOrgChart>table")[0];
            jQuery(document.body).on('mousewheel',function(){
                //wheelDelta值100对应缩放比例0.1
                scaleTree(Math.round(event.wheelDelta/200)/10,event.clientX,event.clientY);
            });
            //拖动事件
            jQuery(tree).on("dragstart", function (ev) {
                ev.originalEvent.dataTransfer.dropEffect = "move";
                ev.originalEvent.dataTransfer.setData("originMouseX",ev.originalEvent.clientX);
                ev.originalEvent.dataTransfer.setData("originMouseY",ev.originalEvent.clientY);
            });
            jQuery(box).on("dragover", function (ev) {
                ev.preventDefault();
            });
            jQuery(box).on("drop", function (ev) {
                ev.preventDefault();
                ev.stopPropagation();
                var disX = ev.originalEvent.clientX - ev.originalEvent.dataTransfer.getData("originMouseX");
                var disY = ev.originalEvent.clientY - ev.originalEvent.dataTransfer.getData("originMouseY");
                tree.style.left = parseFloat(tree.style.left||0) + disX + 'px';
                tree.style.top = parseFloat(tree.style.top||0) + disY + 'px';
            });
            jQuery(tree).on("click", function (ev) {
                    closeFrame();
            });
            loadInitData();
            //查询
            jQuery("#rule_engine_query_btn").on('click',function(e){
                var queryStr = jQuery("#rule_engine_query_inp").val();
                loadInitData(queryStr || null);
            });
            jQuery("#rule_engine_query_inp").on('keydown',function(e){
                if(e.keyCode == 13){
                    var queryStr = jQuery("#rule_engine_query_inp").val();
                    loadInitData(queryStr || null);
                }
        });
        });
        function loadInitData(queryStr) {
            maskTree();
            var url = "${/request/@context_path}/hls/rule/engine/routetree/query?ruleEngineId=" + ruleEngineId;
            if(!!queryStr){
                url += "&ruleDesc=" + queryStr;
            }
            jQuery.ajax({
                url: url,
                type: "get",
                dataType: "json",
                success: function (args) {
                    var datas = args.rows;
                    treeInit(datas);
                }
            });
        }
        function maskTree(){
            Leaf.Masker.mask(document.getElementById("rule_engine_tree_wrapper"),"正在加载...")
        }
        function unMaskTree(){
            Leaf.Masker.unmask(document.getElementById("rule_engine_tree_wrapper"))
        }
        function treeInit(datas) {
            initLevelCount(datas)
            initLevel(datas);
            initLevelDatas(datas);
            reloadChart();
            autoScale();
            unMaskTree();
        }
        function initLevel(datas) {
            jQuery('#ruleTree').remove();
            var html = [];
            html.push('<ul id="ruleTree" style="display: none">');
            html.push('<li id="level-0">');
            html.push('<div class="startLevel">' + 'Start' + '</div>');
            createHandleButton(html, '0', 'N');
            html.push('</li>');
            html.push('</ul>');
            jQuery('body').append(html.join(""));
            addLevelUl('0');
            for (var i = 0; i < datas.length; i++) {
                html = [];
                var data = datas[i];
                var currentLevel = data.currentLevel;
                if (!data.parentRouteId) {
                    html.push('<li id="level-' + currentLevel + '" currentLevel="' + currentLevel + '">');
                    html.push('<div class="levelDesc">' + currentLevel + '</div>');
                    var ruleDesc = data.ruleDesc.replace("GLD-EXTEND","");
                    html.push('<div class="ruleDesc" title="' + (ruleDesc || '') + '">' + (ruleDesc || '') + '</div>');
                    createHandleButton(html, currentLevel, data.finnalFlag,data.ruleDesc);
                    html.push('</li>');
                    jQuery('#levelul-' + getParentLevel(currentLevel)).append(html.join(""));
                    initChildLevel(datas, data.routeId, currentLevel);
                }
            }
        }
        function initLevelDatas(datas) {
            levelDatas = [];
            for (var i = 0; i < datas.length; i++) {
                var data = datas[i];
                var appendData = {
                    routeId: data.routeId,
                    parentRouteId: data.parentRouteId,
                    parentLevel: getParentLevel(data.currentLevel),
                    ruleDesc: data.ruleDesc,
                    currentLevel: data.currentLevel,
                    ruleEngineId: ruleEngineId,
                    finnalFlag: data.finnalFlag,
                    dataSourceId: dataSourceId
                };
                levelDatas.push(appendData);
            }
        }
        function initLevelCount(datas) {
            levelCount = {};
            for (var i = 0; i < datas.length; i++) {
                var data = datas[i];
                var currentLevel = data.currentLevel;
                var levelArr = currentLevel.split("-");
                if (levelArr.length == 1) {
                    levelCount["0"] = (levelCount["0"] || 0) * 1 + 1;
                } else {
                    var parentLevel = getParentLevel(currentLevel);
                    levelCount[parentLevel] = (levelCount[parentLevel] || 0) * 1 + 1;
                }
            }
        }
        function reloadChart() {
            jQuery('#ruleTreeChart').empty();
            jQuery("#ruleTree").jOrgChart({
                chartElement: '#ruleTreeChart',
                dragAndDrop: false
            });
            renderFinnalNode();
        }
        function addLevelUl(currentLevel) {
            var html = [];
            html.push('<ul id="levelul-' + currentLevel + '">');
            html.push('</ul>');
            jQuery('#level-' + currentLevel).append(html.join(""));
        }
        function createHandleButton(html, currentLevel, finnalFlag,ruleDesc) {
            if (finnalFlag == 'Y') {
                html.push('<div class="handleButton handleFinnalButton">');
            } else {
                if (currentLevel == '0') {
                    html.push('<div class="handleButton handleNodeButton" style="margin-top: 52px;">');
                } else {
                    html.push('<div class="handleButton handleNodeButton">');
                }
            }
            var gldExtendExistsFlag = 'N';
            var ruleResultExistFlag = 'N';
            if(ruleDesc){
                if(ruleDesc.indexOf("GLD-EXTEND")!=-1){
                    gldExtendExistsFlag = 'Y';
                }
                if(ruleDesc.indexOf(",")!=-1){
                    ruleResultExistFlag = 'Y';
                }
            }
            if (currentLevel != '0') {
                html.push('<a title="删除" onclick="deleteRule(\'' + currentLevel + '\')" finnalFlag="' + finnalFlag + '" class="hls-rule-btn global-font-size14 hls-rule-btn-delete"><img class="icon" src="${/request/@context_path}/resources/images/RULEENGINE/minus-square@2x.png"/></a>');
            }
            if (finnalFlag != 'Y') {
                html.push('<a title="新增结果" onclick="addFinnalRule(\'' + currentLevel + '\')" finnalFlag="' + finnalFlag + '" class="hls-rule-btn global-font-size14 hls-rule-btn-add"><img class="icon" src="${/request/@context_path}/resources/images/RULEENGINE/border-outer@2x.png"/></a>');
                html.push('<a title="新增条件" onclick="addRule(\'' + currentLevel + '\')" finnalFlag="' + finnalFlag + '" class="hls-rule-btn global-font-size14 hls-rule-btn-add"><img class="icon" src="${/request/@context_path}/resources/images/RULEENGINE/plus-square@2x.png"/></a>');
            }else{
                var gldResultClass='';
                if(gldExtendExistsFlag =='Y'){
                    gldResultClass = "hls-route-already-edit";
                }
                html.push('<a title="凭证规则" onclick="editGldRule(\'' + currentLevel + '\')" finnalFlag="' + finnalFlag + '" class="hls-rule-btn global-font-size14 hls-rule-btn-edit-gld '+gldResultClass+'"><img class="icon" src="${/request/@context_path}/resources/images/RULEENGINE/detail@2x.png"/></a>');
            }
            if (currentLevel != '0') {
                var ruleResultClass='';
                if(ruleResultExistFlag =='Y'){
                    ruleResultClass = "hls-route-already-edit";
                }
                html.push('<a title="编辑" onclick="editRule(\'' + currentLevel + '\')" finnalFlag="' + finnalFlag + '" class="hls-rule-btn global-font-size14 hls-rule-btn-edit editRuleBtn '+ruleResultClass+'"><img class="icon" src="${/request/@context_path}/resources/images/RULEENGINE/edit-square@2x.png"/></a>');
            }
            html.push('</div>');
        }
        function reloadLevelCount(deleteLevel) {
            levelCount[getParentLevel(deleteLevel)] = levelCount[getParentLevel(deleteLevel)] - 1;
            for (var i = 0; i < levelDatas.length; i++) {
                var levelData = levelDatas[i];
                var currentLevel = levelData.currentLevel;
                var parentLevel = getParentLevel(currentLevel);
                if (parentLevel == getParentLevel(deleteLevel) && (currentLevel.toString().split("-")[currentLevel.toString().split("-").length - 1] > deleteLevel.toString().split("-")[deleteLevel.toString().split("-").length - 1])) {
                    reloadNextLevelCount(currentLevel, deleteLevel);
                }
                if ((currentLevel+"").indexOf(deleteLevel) == 0) {
                    levelCount[currentLevel] = 0;
                }
            }
        }
        function reloadNextLevelCount(kindLevel, deleteLevel) {
            for (var i = 0; i < levelDatas.length; i++) {
                var levelData = levelDatas[i];
                var currentLevel = levelData.currentLevel;
                if ((currentLevel+"").indexOf(kindLevel) == 0) {
                    var changeLevel = currentLevel.replace(kindLevel, deleteLevel);
                    levelCount[changeLevel] = levelCount[currentLevel];
                }
            }

        }
        function reloadNextDatas(deleteLevel){
            for(var i = 0; i < levelDatas.length; i++){
                var levelData = levelDatas[i];
                var currentLevel = levelData.currentLevel;
                if (getParentLevel(currentLevel) == getParentLevel(deleteLevel) && currentLevel.split('-')[currentLevel.split('-').length - 1] > deleteLevel.split('-')[deleteLevel.split('-').length - 1]) {
                    var replaceLevel = null;
                    var array = currentLevel.split('-');
                    for (var j = 0; j < array.length; j++) {
                        var item = array[j];
                        if (array.length == 1) {
                            replaceLevel = item * 1 - 1;
                            break;
                        }
                        if (j == 0) {
                            replaceLevel = item;
                        } else {
                            replaceLevel = replaceLevel + '-' + (item * 1 - 1);
                        }
                    }
                    for (var m = 0; m < levelDatas.length; m++) {
                        if ((levelDatas[m].currentLevel+"").indexOf(currentLevel) == 0) {
                            levelDatas[m].currentLevel = levelDatas[m].currentLevel.replace(currentLevel, replaceLevel);
                            levelDatas[m].parentLevel = getParentLevel(levelDatas[m].currentLevel);
                        }
                    }
                }
            }
        }
        function reloadLevelDatas(deleteLevel) {
            for (var i = 0; i < levelDatas.length; i++) {
                var levelData = levelDatas[i];
                var currentLevel = levelData.currentLevel;
                if ((currentLevel+"").indexOf(deleteLevel) == 0) {
                    if (levelData.routeId) {
                        deleteLevelDatas.push(levelData);
                    }
                    levelDatas.splice(i, 1);
                    i=i-1;
                }
            }
            reloadNextDatas(deleteLevel);
        }
        function reloadLevel(deleteLevel) {
            jQuery.each(jQuery('li'), function (index, item) {
                var currentLevel = item.id.replace("level-", "");
                if (getParentLevel(deleteLevel) == getParentLevel(currentLevel) && currentLevel.split('-')[currentLevel.split('-').length - 1] > deleteLevel.split('-')[deleteLevel.split('-').length - 1]) {
                    var replaceLevel = null;
                    var array = currentLevel.split('-');
                    for (var i = 0; i < array.length; i++) {
                        var arrayItem = array[i];
                        if (array.length == 1) {
                            replaceLevel = arrayItem * 1 - 1;
                        } else {
                            if (i == 0) {
                                replaceLevel = arrayItem;
                            } else {
                                if (i == array.length - 1) {
                                    replaceLevel = replaceLevel + '-' + (arrayItem * 1 - 1);
                                } else {
                                    replaceLevel = replaceLevel + '-' + arrayItem;
                                }
                            }
                        }
                    }
                    jQuery.each(jQuery('li'), function (index, detail) {
                        var detailLevel = detail.id.replace("level-", '');
                        if (detailLevel.indexOf(currentLevel) == 0) {
                            jQuery('#' + detail.id).attr("currentLevel", detailLevel.replace(currentLevel, replaceLevel));
                            jQuery('#' + detail.id).attr("id", "level-" + detailLevel.replace(currentLevel, replaceLevel));
                            jQuery('#' + "level-" + detailLevel.replace(currentLevel, replaceLevel))[0].innerHTML = jQuery('#' + "level-" + detailLevel.replace(currentLevel, replaceLevel))[0].innerHTML.replace(currentLevel, replaceLevel);
                        }
                    });
                }
            });
        }
        function initChildLevel(datas, routeId, currentLevel) {
            var hasChildFlag = 'N';
            for (var i = 0; i < datas.length; i++) {
                var data = datas[i];
                var html = [];
                if (data.parentRouteId == routeId) {
                    var childLevel = data.currentLevel;
                    if (hasChildFlag == 'N') {
                        hasChildFlag = 'Y';
                        addLevelUl(currentLevel);
                    }
                    html.push('<li id="level-' + childLevel + '" currentLevel="' + childLevel + '">');
                    html.push('<div class="levelDesc">' + childLevel + '</div>');
                    var ruleDesc = data.ruleDesc.replace("GLD-EXTEND","");
                    html.push('<div class="ruleDesc" title="' + (ruleDesc || '') + '">' + (ruleDesc || '') + '</div>');
                    createHandleButton(html, childLevel, data.finnalFlag,data.ruleDesc);
                    html.push('</li>');
                    jQuery('#levelul-' + currentLevel).append(html.join(""));
                    initChildLevel(datas, data.routeId, childLevel)
                }

            }
        }
        function getParentLevel(level) {
            var levelArray = level.toString().split("-");
            var parentLevel = null;
            for (var i = 0; i < levelArray.length - 1; i++) {
                if (i == 0) {
                    parentLevel = levelArray[i];
                } else {
                    parentLevel = parentLevel + "-" + levelArray[i];
                }
            }
            if (levelArray.length == 1) {
                parentLevel = 0;
            }
            return parentLevel;
        }
        function renderFinnalNode() {
            jQuery.each(jQuery('.hls-rule-btn'), function (index, item) {
                if (item.getAttribute("finnalflag") == 'Y') {
                    if (!jQuery(item).hasClass("finnalRenderClass")) {
                        jQuery(item).addClass("finnalRenderClass");
                    }
                    if (!jQuery(item.parentNode.parentNode).hasClass("finnalNodeClass")) {
                        jQuery(item.parentNode.parentNode).addClass("finnalNodeClass");
                    }
                } else {
                    if (!jQuery(item.parentNode.parentNode).hasClass("nodeClass")) {
                        jQuery(item.parentNode.parentNode).addClass("nodeClass");
                    }
                }
            });
        }

        //  节点按钮方法
        function addRule(currentLevel, finnalFlag) {
            event.stopPropagation();
            var html = [];
            var addLevel;
            var currentLevelCount = (levelCount[currentLevel] || 0) * 1;
            if (currentLevel == '0') {
                addLevel = currentLevelCount + 1;
            } else {
                addLevel = currentLevel + '-' + (currentLevelCount + 1);
            }
            if (!levelCount[currentLevel] || levelCount[currentLevel] === 0) {
                addLevelUl(currentLevel);
            }
            levelCount[currentLevel] = currentLevelCount + 1;
            html.push('<li style="border-radius: 30px;background: #00b3b3" id="level-' + addLevel + '" currentLevel="' + addLevel + '">');
            var appendData = {
                routeId: null,
                parentRouteId: null,
                parentLevel: getParentLevel(addLevel),
                ruleDesc: finnalFlag ? "结果集":"规则条件",
                currentLevel: addLevel,
                ruleEngineId: ruleEngineId,
                finnalFlag:finnalFlag
            };
            levelDatas.push(appendData);
            html.push('<div class="levelDesc">' + addLevel + '</div>');
            html.push('<div class="ruleDesc"></div>');
            createHandleButton(html, addLevel, finnalFlag);
            html.push('</li>');
            jQuery('#levelul-' + currentLevel).append(html.join(""));
            reloadChart();
        }
        function deleteRule(currentLevel) {
            event.stopPropagation();
            jQuery('#level-' + currentLevel).remove();
            reloadLevelCount(currentLevel);
            reloadLevel(currentLevel);
            reloadLevelDatas(currentLevel);
            reloadChart();
        }
        function editRule(currentLevel,gldFlag) {
            event.stopPropagation();
            var routeId = null, finnalFlag = null;
            for (var i = 0; i < levelDatas.length; i++) {
                var levelData = levelDatas[i];
                if (levelData.currentLevel == currentLevel) {
                    if (levelData.routeId) {
                        routeId = levelData.routeId;
                        finnalFlag = levelData.finnalFlag;
                        dataSourceId = levelData.dataSourceId;
                    }
                    break;
                }
            }
            if (routeId) {
                var params = {
                    routeId: routeId,
                    ruleEngineId: ruleEngineId,
                    templetType: templetType,
                    dataSourceId:dataSourceId,
                    jeTrx:jeTrx
                };
                var frameUrl="";
                var frameTitle="";
                var para = window.location.search.substring(1);
                var paraList = [];
                var paraListInside = [];
                paraList = para.split('&');
                for (var i = 0; i < paraList.length; i++) {
                    paraListInside = paraList[i].split('=');
                    if (paraListInside[0] != 'hlsWindowId') {
                        params[paraListInside[0]] = paraListInside[1];
                    }
                }
                if (gldFlag == 'Y') {
                    frameUrl = "${/request/@context_path}/modules/FND/FND_MODEL/FND117/gld_je_rule_detail.lview";
                    frameTitle = '凭证规则明细';
                } else {
                    frameUrl = "${/request/@context_path}/modules/GLD/GLD_SETUP/GLD103/gld_rule_engine_route_detail.lview";
                    frameTitle = "规则引擎-规则条件编辑";
                    if(finnalFlag=='Y'){
                        frameUrl="${/request/@context_path}/modules/GLD/GLD_SETUP/GLD103/gld_rule_engine_route_result_detail.lview";
                        frameTitle="规则引擎-结果集编辑";
                    }
                }
                openFrame(frameTitle,frameUrl,params);
            } else {
                $L.showErrorMessage("提示","请先保存规则树",null,200,100);
            }
        }
        function addFinnalRule(currentLevel) {
            addRule(currentLevel, 'Y');
        }
        function editGldRule(currentLevel){
            editRule(currentLevel,'Y');
        }
        //  保存
        function ruleSave() {
            event.stopPropagation();
            var saveData = {};
            saveData.treeData = levelDatas;
            saveData.deleteTreeData = deleteLevelDatas;
            jQuery.ajax({
                type: 'POST',
                url: "${/request/@context_path}/hls/rule/engine/routetree/submit",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(saveData),
                success: function (args) {
                    if (args.success) {
                        treeInit(args.rows);
                        $L.SideBar.show({msg:"保存成功"});
                    } else {
                        $L.showErrorMessage("提示",args.message,null,200,100);
                    }
                }
            });
        }
        //  缩放
        function scaleTree(interval,clientX,clientY) {
            event.stopPropagation();
            if(interval>0) {
                currentTreeScale = currentTreeScale + interval;
            }else if(interval<0) {
                currentTreeScale = (currentTreeScale + interval) > 0.1 ? currentTreeScale + interval : 0.1;
            }else{
                // return;
                currentTreeScale = 1;
            }
            jQuery("#rule_engine_tree_wrapper .jOrgChart").css({
                "transform": "scale(" + currentTreeScale + ")",
                "transform-origin" : "center center"

            })
        }
        function autoScale(opt){
            opt = opt || {};
            opt.showAll = opt.showAll||true;
            var wrapperWidth = jQuery("#rule_engine_tree_wrapper")[0].clientWidth;
            var contentWidth = jQuery("#rule_engine_tree_wrapper .jOrgChart>table")[0].clientWidth;
            var wrapperHeight = jQuery("#rule_engine_tree_wrapper")[0].clientHeight;
            var contentHeight = jQuery("#rule_engine_tree_wrapper .jOrgChart>table")[0].clientHeight;
            if(wrapperWidth<contentWidth){
                var scale = (Math.floor(wrapperWidth/contentWidth*100)-1)/100;
                jQuery("#rule_engine_tree_wrapper .jOrgChart").css({
                    "transform" : "scale("+scale+")",
                    "transform-origin" : "center center"
                });
                document.getElementById("ruleTreeChart").style.left=0;
                document.getElementById("ruleTreeChart").style.top=0;
                currentTreeScale = scale;
            }else if(wrapperHeight<contentHeight){
                var scale = (Math.floor(wrapperWidth/contentWidth*100)-1)/100;
                jQuery("#rule_engine_tree_wrapper .jOrgChart").css({
                    "transform" : "scale("+scale+")",
                    "transform-origin" : "center center"
                });
                document.getElementById("ruleTreeChart").style.left=0;
                document.getElementById("ruleTreeChart").style.top=0;
                currentTreeScale = scale;
            }else{
                jQuery("#rule_engine_tree_wrapper .jOrgChart").css({
                    "transform" : "scale("+1+")",
                    "transform-origin" : "center center"
                });
                document.getElementById("ruleTreeChart").style.left=0;
                document.getElementById("ruleTreeChart").style.top=0;
                currentTreeScale = 1;
            }
        }
        //  右侧编辑窗口
        function openFrame(title,url,params){

            jQuery("#rule_engine_tree_wrapper").css("width","calc( 100% - 750px )");
            jQuery("#rule_engine_tree_editFrame_warpper").css("width","750px");
            frameOpenFlag = true;
            //加载url对应页面
            var hasParaFlag = url.indexOf("?")>=0;
            var paraStr = "";
            if(!!params){
                var paraKeys = Object.keys(params);
                for(var i=0;i<paraKeys.length;i++){
                    if(hasParaFlag){
                        paraStr+="&"+paraKeys[i]+"="+params[paraKeys[i]];
                    }else{
                        paraStr+="?"+paraKeys[i]+"="+params[paraKeys[i]];
                        hasParaFlag=true;
                    }
                }
                Leaf.Masker.mask(jQuery("#rule_engine_tree_edit_iframe")[0],"正在加载");
                jQuery("#rule_engine_tree_edit_iframe").attr("src",url+paraStr);
                jQuery("#rule_engine_tree_edit_iframe")[0].addEventListener("load",function(){
                    Leaf.Masker.unmask(jQuery("#rule_engine_tree_edit_iframe")[0]);
                });
            }
        }
        function closeFrame(title,url,params){
            if(frameOpenFlag) {
                jQuery("#rule_engine_tree_wrapper").css("width", "100%");
                jQuery("#rule_engine_tree_editFrame_warpper").css("width", "0%");
                frameOpenFlag = false;
                setTimeout(function(){
                    autoScale();
                },550);
            }
        }
        ]]></script>
        <div id="rule_engine_tree_wrapper" aria-dropeffect="move">
            <div class="rule_engine_save_btn_wrapper btn" onclick="ruleSave()" >
                <img src="${/request/@context_path}/leafresources/images/RULEENGINE/save-fill.png" alt="save"/>
                <span>保存</span>
            </div>
            <div class="rule_engine_init_btn_wrapper btn" onclick="autoScale()" >
                <img src="${/request/@context_path}/leafresources/images/RULEENGINE/save-fill.png" alt="save"/>
                <span>恢复</span>
            </div>
            <div class="rule_engine_small_btn_wrapper btn" onclick="scaleTree(-0.1)" >
                <img src="${/request/@context_path}/leafresources/images/RULEENGINE/save-fill.png" alt="save"/>
                <span>缩小</span>
            </div>
            <div class="rule_engine_big_btn_wrapper btn" onclick="scaleTree(0.1)" >
                <img src="${/request/@context_path}/leafresources/images/RULEENGINE/save-fill.png" alt="save"/>
                <span>放大</span>
            </div>
            <div class="rule_engine_query_wrapper" >
                <input type="text" id="rule_engine_query_inp" placeholder="查询条件"/>
                <img id="rule_engine_query_btn" src="${/request/@context_path}/leafresources/images/RULEENGINE/query.png" alt="查询" style="width:20px;height:20px;"/>
            </div>
            <div id="ruleTreeChart" class="orgChart" draggable="true" aria-dropeffect="move"></div>
        </div>
        <div id="rule_engine_tree_editFrame_warpper">
            <iframe id="rule_engine_tree_edit_iframe" src="" frameborder="0"></iframe>
        </div>
        <a:screenBody style="display:none;"></a:screenBody>
    </a:view>
</a:screen>