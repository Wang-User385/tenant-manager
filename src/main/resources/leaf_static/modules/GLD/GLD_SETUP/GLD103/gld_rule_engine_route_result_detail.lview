<?xml version="1.0" encoding="UTF-8"?>
<!--
    Date: 2019/1/4
    Revision: 1.0  
    Purpose:规则引擎-结果集编辑
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        if(!!$L.getCmp) $ = $L.getCmp;

        function beforetriggerclick_route_rule_result_detail_ds_grid_lov(lov){
            lov.controller = "/hls/rule/engine/resultLov?ruleEngineId=${/parameter/@ruleEngineId}&jeTrx=${/parameter/@jeTrx}&templetType=${/parameter/@templetType}&dataSourceId=${/parameter/@dataSourceId}"
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="route_rule_result_detail_query_ds">
                <a:datas>
                    <a:record ruleEngineId="${/parameter/@ruleEngineId}"
                              routeId="${/parameter/@routeId}"
                              templetType="${/parameter/@templetType}"
                              dataSourceId="${/parameter/@dataSourceId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="route_rule_result_detail_ds" autoQuery="true" selectable="true"
                       queryDataSet="route_rule_result_detail_query_ds" autoPageSize="true"
                       queryUrl="${/request/@context_path}/hls/rule/engine/route/result/routequery"
                       deleteUrl="${/request/@context_path}/hls/rule/engine/route/result/remove"
                       submitUrl="${/request/@context_path}/hls/rule/engine/route/result/submit">
                <a:fields>
                    <a:field name="route_result_description" autoComplete="false" fetchRemote="true"
                             title="规则引擎数据结果" lovWidth="500" lovHeight="450" lovGridHeight="300"
                             lovService="/hls/rule/engine/resultLov~hls.layout.dto.LovRuleEngineResultDto">
                        <a:mapping>
                            <a:map from="name" to="route_result_description"/>
                            <a:map from="code" to="route_result_value"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="route_id" defaultValue="${/parameter/@routeId}"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="route_rule_result_detail_ds_grid" type="add"/>
                <a:gridButton bind="route_rule_result_detail_ds_grid" type="save"/>
                <a:gridButton bind="route_rule_result_detail_ds_grid" type="delete"/>
                <a:gridButton bind="route_rule_result_detail_ds_grid" type="refresh"/>
            </a:screenTopToolbar>
            <a:grid id="route_rule_result_detail_ds_grid" bindTarget="route_rule_result_detail_ds"
                    width="550" marginHeight="150"  navBar="true">
                    <a:columns>
                        <a:column width="500" name="route_result_description" prompt="规则结果" align="center"
                                  editor="route_rule_result_detail_ds_grid_lov"/>
                    </a:columns>
                    <a:editors>
                        <a:lov id="route_rule_result_detail_ds_grid_lov">
                            <a:events>
                                <a:event name="beforetriggerclick" handler="beforetriggerclick_route_rule_result_detail_ds_grid_lov"/>
                            </a:events>
                        </a:lov>
                    </a:editors>
                </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
