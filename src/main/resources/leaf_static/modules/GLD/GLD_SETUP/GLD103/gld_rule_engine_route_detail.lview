<?xml version="1.0" encoding="UTF-8"?>
<!--
    Date: 2019/1/4
    Revision: 1.0  
    Purpose:规则引擎-规则条件编辑
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        if(!!$L.getCmp) $ = $L.getCmp;

        function route_rule_detail_ds_grid_ef(record,name){
            if(name=="xcondition_value"){
                if(record.get("xcondition_type")=="MANUAL"){
                    return "route_rule_detail_ds_grid_tf"
                }else if(record.get("xcondition_type")=="FIELD"){
                    return "route_rule_detail_ds_grid_lov"
                }else{
                    return ""
                }
            }
            if(name=="ycondition_value1"||name=="ycondition_value2"){
                if(record.get("ycondition_type")=="MANUAL"){
                    return "route_rule_detail_ds_grid_tf"
                }else if(record.get("ycondition_type")=="FIELD"){
                    return "route_rule_detail_ds_grid_lov"
                }else{
                    return ""
                }
            }
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="rule_engine_condition_type_ds" lookupCode="RULE_ENGINE_CONDITION_TYPE"/>
            <a:dataSet id="rule_engine_calulate_symbol_ds" lookupCode="RULE_ENGINE_CALULATE_SYMBOL"/>
            <a:dataSet id="route_rule_detail_query_ds">
                <a:datas>
                    <a:record ruleEngineId="${/parameter/@ruleEngineId}"
                              routeId="${/parameter/@routeId}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="route_rule_detail_ds" autoPageSize="true" selectable="true"
                       autoQuery="true" queryDataSet="route_rule_detail_query_ds" queryMethod="POST"
                       queryUrl="${/request/@context_path}/hls/rule/engine/condition/route/query"
                       deleteUrl="${/request/@context_path}/hls/rule/engine/condition/remove"
                       submitUrl="${/request/@context_path}/hls/rule/engine/condition/submit">
                <a:fields>
                    <a:field name="route_id" defaultValue="${/parameter/@routeId}"/>
                    <a:field name="xcondition_type_desc" returnField="xcondition_type"
                             options="rule_engine_condition_type_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="xcondition_value" title="规则引擎数据字段" autoComplete="true" fetchRemote="false"
                             lovWidth="300" lovHeight="450" lovGridHeight="300"
                             lovService="/hls/db/data/source/column/selectGldInfo?ruleEngineId=${/parameter/@ruleEngineId}~hls.layout.dto.LovHLSDBDataSourceColumnDto">
                        <a:mapping>
                            <a:map from="column_name" to="xcondition_value"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="calulate_symbol_desc" returnField="calulate_symbol"
                        options="rule_engine_calulate_symbol_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="ycondition_type_desc" returnField="ycondition_type"
                             options="rule_engine_condition_type_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="ycondition_value1" title="规则引擎数据字段" fetchRemote="false"
                             lovWidth="300" lovHeight="350" lovGridHeight="250"
                             lovService="/hls/db/data/source/column/queryByRuleEngine?ruleEngineId=${/parameter/@ruleEngineId}~hls.layout.dto.LovHLSDBDataSourceColumnDto">
                        <a:mapping>
                            <a:map from="column_name" to="ycondition_value1"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="ycondition_value2" title="规则引擎数据字段" fetchRemote="false"
                             lovWidth="300" lovHeight="350" lovGridHeight="250"
                             lovService="/hls/db/data/source/column/queryByRuleEngine?ruleEngineId=${/parameter/@ruleEngineId}~hls.layout.dto.LovHLSDBDataSourceColumnDto">
                        <a:mapping>
                            <a:map from="column_name" to="ycondition_value2"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="enabled_flag" defaultValue="Y" checkedValue="Y" uncheckedValue="N" />
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="route_rule_detail_ds_grid" type="add"/>
                <a:gridButton bind="route_rule_detail_ds_grid" type="save"/>
                <a:gridButton bind="route_rule_detail_ds_grid" type="delete"/>
                <a:gridButton bind="route_rule_detail_ds_grid" type="refresh"/>
            </a:screenTopToolbar>
            <a:grid id="route_rule_detail_ds_grid" bindTarget="route_rule_detail_ds"
                        width="550" marginHeight="150"  navBar="true">
                <a:columns>
                    <a:column name="xcondition_type_desc" prompt="左条件类型" width="70"
                              editor="route_rule_detail_ds_grid_combo"/>
                    <a:column name="xcondition_value" prompt="左条件值" width="70"
                              editorFunction="route_rule_detail_ds_grid_ef"/>
                    <a:column name="calulate_symbol_desc" prompt="判断符" width="70"
                              editor="route_rule_detail_ds_grid_combo"/>
                    <a:column name="ycondition_type_desc" prompt="右条件类型" width="70"
                              editor="route_rule_detail_ds_grid_combo"/>
                    <a:column name="ycondition_value1" prompt="右条件值1"  width="70"
                              editorFunction="route_rule_detail_ds_grid_ef"/>
                    <a:column name="ycondition_value2" prompt="右条件值2" width="70"
                              editorFunction="route_rule_detail_ds_grid_ef"/>
                    <a:column name="enabled_flag" prompt="启用" width="70"
                              editor="route_rule_detail_ds_grid_check"/>
                </a:columns>
                <a:editors>
                    <a:lov id="route_rule_detail_ds_grid_lov"/>
                    <a:textField id="route_rule_detail_ds_grid_tf"/>
                    <a:checkBox id="route_rule_detail_ds_grid_check"/>
                    <a:comboBox id="route_rule_detail_ds_grid_combo"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
