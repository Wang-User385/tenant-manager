<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?reverseRuleCode=GLD.JE_REVERSE_RULE"
                type="text/javascript"></script>
        <script><![CDATA[

        // $L.onReady(function () {
        //     console.log($('document_type_ds'));
        // });

        function gld_je_template_query() {
            $('gld_je_template_ds').query();
        }

        function gld_je_template_add() {
            $('gld_je_template_ds').create();
        }

        function gld_je_template_save() {
            var ds = $('gld_je_template_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/gld/je/template/submit');
                ds.submit();
            }
        }

        function gld_je_template_quit() {
            $('${/parameter/@winid}').close();
        }

        function onSubmitSuccess_gld_je_template_ds(ds) {
            gld_je_template_query();
        }

        function gld_je_template_detail_render(value, record, name) {
            if (!record.isNew) {
                return '<a href="javascript:open_template_detail(\'' + record.get('je_template_id') + '\',\'' + record.get('je_trx') + '\')">明细</a>';
            } else
                return "";
        }

        function open_template_detail(je_template_id, je_trx) {
            new Leaf.Window({
                id: 'gld_rg_template_detail_winid',
                url: "${/request/@context_path}/modules/GLD/GLD_SETUP/GLD103/gld_je_template_detail.lview",
                params: {
                    je_template_id: je_template_id,
                    je_trx: je_trx,
                    winid: 'gld_rg_template_detail_winid'
                },
                title: '凭证模板明细',
                side:'right',
                height: 590,
                width: 650
            });
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="gld_je_template_query_ds">
                <a:fields>
                    <a:field name="je_trx" defaultValue="${/parameter/@jeTrx}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld_document_type_ds"
                       queryUrl="${/request/@context_path}/fnd200/type/queryForLov?documentCategory=GLD_JE_HEAD&amp;enabledFlag=Y"
                       pageSize="10000" autoQuery="true"/>
            <a:dataSet id="gld_je_template_ds" autoPageSize="true" autoQuery="true"
                       queryDataSet="gld_je_template_query_ds"
                       deleteUrl="${/request/@context_path}/gld/je/template/remove"
                       queryUrl="${/request/@context_path}/gld/je/template/query" selectable="true">
                <a:fields>
                    <a:field name="document_type_name" options="gld_document_type_ds" displayField="description"
                             valueField="document_type" returnField="document_type">
                        <a:mapping>
                            <a:map from="description" to="document_type_name"/>
                            <a:map from="document_type" to="document_type"/>
                            <a:map from="business_type" to="business_type"/>
                            <a:map from="document_category" to="document_category"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="je_trx" defaultValue="${/parameter/@jeTrx}"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_gld_je_template_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld_je_template_quit" text="关闭"/>
                <a:gridButton click="gld_je_template_add" text="HAP.NEW"/>
                <a:gridButton click="gld_je_template_save" text="HAP.SAVE"/>
                <a:gridButton bind="gld_je_template_ds_grid" type="delete"/>
            </a:screenTopToolbar>
            <a:grid id="gld_je_template_ds_grid" bindTarget="gld_je_template_ds" width="960" marginHeight="70"
                    navBar="true">
                <a:columns>
                    <a:column name="je_template_name" width="400" prompt="凭证模板说明" editor="gld_je_template_ds_grid_tf"/>
                    <a:column name="document_type_name" width="200" prompt="单据类型" editor="gld_je_template_ds_grid_cb"/>
                    <a:column name="document_type" width="200" prompt="单据类型" hidden="true"/>
                    <a:column name="business_type" width="200" hidden="true"/>
                    <a:column name="document_category" width="200" hidden="true"/>
                    <a:column name="enabled_flag" width="150" prompt="启用" editor="gld_je_template_ds_grid_check"/>
                    <a:column prompt="明细" renderer="gld_je_template_detail_render" align="center"/>
                </a:columns>
                <a:editors>
                    <a:textField id="gld_je_template_ds_grid_tf"/>
                    <a:checkBox id="gld_je_template_ds_grid_check"/>
                    <a:comboBox id="gld_je_template_ds_grid_cb"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
