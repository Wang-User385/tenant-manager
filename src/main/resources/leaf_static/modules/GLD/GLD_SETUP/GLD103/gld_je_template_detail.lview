                             lovService="/lov/je/template/currency~com.hand.hls.gld.dto.LovGldJeTemplateJ" lovWidth="300"
                             title="币种" fetchRemote="false" prompt="币种">
                        <a:mapping>
                            <a:map from="je_currency" to="je_currency_desc"/>
                            <a:map from="currency" to="je_currency"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="exchange_rate"/>
                    <a:field name="exchange_rate_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
