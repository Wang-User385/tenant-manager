                                <a:lov name="segment8_desc" bindTarget="gld_je_template_detail_ds" prompt="段8"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
