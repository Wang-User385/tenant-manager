                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="gld_je_template_detail_quit" text="关闭"/>
                <a:gridButton click="gld_je_template_detail_save" text="HAP.SAVE"/>
            </a:screenTopToolbar>

            <a:tabPanel width="600" height="377">
                <a:tabs>
                    <a:tab prompt="基本信息" width="130" selected="true">
                        <a:form title="凭证模板定义基本信息" labelWidth="100">
                            <a:box column="2">
                                <a:lov name="je_company_id_desc" bindTarget="gld_je_template_detail_ds" prompt="公司"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                                <a:lov name="je_date_desc" bindTarget="gld_je_template_detail_ds" prompt="日期"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                            </a:box>
                            <a:box column="2">
                                <a:lov name="je_account_id_desc" bindTarget="gld_je_template_detail_ds" prompt="科目"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                                <a:lov name="je_cost_center_id_desc" bindTarget="gld_je_template_detail_ds" prompt="成本中心"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                            </a:box>
                            <a:box column="1">
                                <a:textField name="je_description" bindTarget="gld_je_template_detail_ds" prompt="行摘要"
                                             width="412">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:textField>
                            </a:box>
                        </a:form>
                        <div style="color:red;margin-left:30px;">行摘要可以根据数据源中的结果替换值，例:合同ID:{$xxx$}可替换为合同ID:CON2017</div>
                    </a:tab>
                    <a:tab prompt="借贷信息" width="130">
                        <a:form title="凭证模板定义借贷信息" labelWidth="100">
                            <a:box column="1">
                                <a:comboBox name="dr_cr_n" bindTarget="gld_je_template_detail_ds" prompt="借/贷"
                                            width="165">
                                </a:comboBox>
                            </a:box>
                            <a:box column="2">
                                <a:lov name="dr_amount_desc" bindTarget="gld_je_template_detail_ds" prompt="借方金额"
