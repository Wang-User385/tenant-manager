                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                                <a:lov name="cr_functional_amount_desc" bindTarget="gld_je_template_detail_ds" prompt="贷方本币金额"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                            </a:box>
                            <a:box column="2">
                                <a:lov name="je_currency_desc" bindTarget="gld_je_template_detail_ds" prompt="币种"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                                <a:lov name="exchange_rate_desc" bindTarget="gld_je_template_detail_ds" prompt="汇率"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
                                    </a:events>
                                </a:lov>
                            </a:box>
                        </a:form>

                    </a:tab>

                    <a:tab prompt="凭证段信息" width="130">
                        <a:form title="凭证模板定义参考段信息" labelWidth="100">
                            <a:box column="2">
                                <a:lov name="segment1_desc" bindTarget="gld_je_template_detail_ds" prompt="段1"
                                       width="165">
                                    <a:events>
                                        <a:event name="beforetriggerclick" handler="before_click_lov"/>
                                        <a:event name="change" handler="lov_change"/>
