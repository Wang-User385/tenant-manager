<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?reverseRuleCode=GLD.JE_REVERSE_RULE"
                type="text/javascript"></script>
        <script><![CDATA[

        /*$L.onReady(function () {
            console.log($('document_type_ds'));
        });*/

        function gld_je_template_detail_query() {
            $('gld_je_template_detail_ds').query();
        }

        function gld_je_template_detail_add() {
            $('gld_je_template_detail_ds').create();
        }

        function gld_je_template_detail_save() {
            var ds = $('gld_je_template_detail_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/gld/je/template/submitModify');
                ds.submit();
            }
        }

        function gld_je_template_detail_quit() {
            $('${/parameter/@winid}').close();
        }

        function onSubmitSuccess_gld_je_template_detail_ds(ds) {
            gld_je_template_detail_query();
        }
        function before_click_lov(lov) {
            var ds = $('gld_je_template_detail_ds');
            var record = ds.getCurrentRecord();
            var par;
            if(lov.binder.name!=null){
                par= record.getMeta().getField(lov.binder.name);
                par.setLovPara('jeTrx', '${/parameter/@je_trx}');
        }
        }
        function lov_change( component , value, oldValue){
            if(value == ""){
                var name = component.binder.name.replaceAll("_desc","");
                component.binder.ds.getAt(0).set(name,"");
            }
        }
        function commit_lov(lov,res){
            var ds = $('gld_je_template_detail_ds');
            var record = ds.getCurrentRecord();
            var par;
            if(lov.binder.name!=null){
                par= record.getMeta().getField(lov.binder.name);
                par.setLovPara('jeTrx', '${/parameter/@je_trx}');
                // par.setLovPara(toCamel(lov.binder.name), lov.binder.name);
            }
        }
        //下划线转驼峰
        function toCamel(str) {
            return str.replace(/([^_])(?:_+([^_]))/g, function ($0, $1, $2) {
                return $1 + $2.toUpperCase();
            });
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="DRCR_ds" loadData="true" lookupCode="DRCR"/>
            <a:dataSet id="gld_je_template_detail_query_ds">
                <a:fields>
                    <a:field name="je_template_id" defaultValue="${/parameter/@je_template_id}"/>
                    <a:field name="je_trx" defaultValue="${/parameter/@je_trx}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="gld_je_template_detail_ds" autoPageSize="true" autoQuery="true"
                       queryDataSet="gld_je_template_detail_query_ds"
                       deleteUrl="${/request/@context_path}/gld/je/template/remove"
                       queryUrl="${/request/@context_path}/gld/je/template/query" selectable="true">
                <a:fields>
                    <a:field name="document_type_desc" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100"
                             lovService="/fnd200/type/queryForLov?documentCategory=GLD_JE_HEAD&amp;enabledFlag=Y~com.hand.hls.gld.dto.LovDocumentType"
                             lovWidth="600"
                             title="单据类型选择">
                        <a:mapping>
                            <a:map from="description" to="document_type_desc"/>
                            <a:map from="document_type" to="document_type"/>
                            <a:map from="business_type" to="business_type"/>
                            <a:map from="document_category" to="document_category"/>
                        </a:mapping>
                    </a:field>
                    <!--<a:field name="je_template_id" defaultValue="${/parameter/@je_template_id}"/>-->
                    <a:field name="je_trx" defaultValue="${/parameter/@je_trx}"/>
                    <a:field name="je_company_id"/>
                    <a:field name="je_company_id_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/company~com.hand.hls.gld.dto.LovGldJeTemplateA" lovWidth="300"
                             title="公司" fetchRemote="false" prompt="公司">
                        <a:mapping>
                            <a:map from="company_id" to="je_company_id"/>
                            <a:map from="je_company_id" to="je_company_id_desc"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="je_date"/>
                    <a:field name="je_date_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/jeDate~com.hand.hls.gld.dto.LovGldJeTemplateB" lovWidth="300"
                             title="日期" fetchRemote="false" prompt="日期">
                        <a:mapping>
                            <a:map from="je_date_key" to="je_date"/>
                            <a:map from="je_date" to="je_date_desc"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="je_account_id"/>
                    <a:field name="je_account_id_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/account~com.hand.hls.gld.dto.LovGldJeTemplateC" lovWidth="300"
                             title="科目" fetchRemote="false" prompt="科目">
                        <a:mapping>
                            <a:map from="je_account_id" to="je_account_id_desc"/>
                            <a:map from="account_id" to="je_account_id"/>
                        </a:mapping>

                    </a:field>
                    <a:field name="je_cost_center_id"/>
                    <a:field name="je_cost_center_id_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/costCenter~com.hand.hls.gld.dto.LovGldJeTemplateD" lovWidth="300"
                             title="成本中心" fetchRemote="false" prompt="成本中心">
                        <a:mapping>
                            <a:map from="je_cost_center_id" to="je_cost_center_id_desc"/>
                            <a:map from="cost_center_id" to="je_cost_center_id"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="dr_cr_n" options="DRCR_ds" displayField="code_value_name"
                             valueField="code_value" returnField="dr_cr"/>

                    <a:field name="dr_amount"/>
                    <a:field name="dr_amount_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/drAmount~com.hand.hls.gld.dto.LovGldJeTemplateF" lovWidth="300"
                             title="借方金额" fetchRemote="false" prompt="借方金额">
                        <a:mapping>
                            <a:map from="dr_amount" to="dr_amount_desc"/>
                            <a:map from="dr_amount_key" to="dr_amount"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="dr_functional_amount"/>
                    <a:field name="dr_functional_amount_desc" autoComplete="false" editable="true" lovGridHeight="300" lovHeight="450" required="false"
                             lovLabelWidth="100"
                             lovService="/lov/je/template/drFunctionAmount~com.hand.hls.gld.dto.LovGldJeTemplateG" lovWidth="300"
                             title="借方本币金额" fetchRemote="false" prompt="借方本币金额">
                        <a:mapping>
                            <a:map from="dr_functional_amount_key" to="dr_functional_amount"/>
                            <a:map from="dr_functional_amount" to="dr_functional_amount_desc"/>
                        </a:mapping>
