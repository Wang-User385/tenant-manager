<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        Leaf.onReady(function () {
            var aa = '${/parameter/@je_head_id}';
            if (!!aa) {

            }
        });


        ]]></script>
        <a:dataSets>
            <a:dataSet id="gld204f1_gld_je_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/gld/je/line/query?jeHeadId=${/parameter/@je_head_id}">
                <a:fields>
                    <a:field name="transaction_date" datatype="java.util.Date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:tabPanel marginHeight="200" marginWidth="80">
                <a:tabs>
                    <a:tab prompt="凭证行明细" width="130" selected="true">
                        <a:grid id='gld204f1_gld_je_info_1_grid' bindTarget="gld204f1_gld_je_info_ds" marginHeight="130"
                                marginWidth="30" navBar="true">
                            <a:columns>
                                <a:column name="je_description" prompt="行摘要" width="450"/>
                                <a:column name="account_name" prompt="科目描述/成本中心" renderer="Leaf.formatDate"
                                          width="400"/>
                                <a:column name="cashflow_item" prompt="现金流量" width="400"/>
                                <!--<a:column name="dr_amount" prompt="原币借方" align="right" renderer="Leaf.formatMoney"
                                          width="120"/>
                                <a:column name="cr_amount" prompt="原币贷方" width="100" renderer="Leaf.formatMoney" align="right"/>-->
                                <a:column name="dr_functional_amount" prompt="本币借方" width="120"
                                          renderer="Leaf.formatMoney" align="right"/>
                                <a:column name="cr_functional_amount" prompt="本币贷方" width="120"
                                          renderer="Leaf.formatMoney" align="right"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="行附加信息" width="130">
                        <a:grid id='gld204f1_gld_je_info_2_grid' bindTarget="gld204f1_gld_je_info_ds" marginHeight="130"
                                marginWidth="30" navBar="true">
                            <a:columns>
                                <a:column name="je_description" prompt="行摘要" width="400"/>
                                <a:column name="segment1" prompt="参考段1" width="200"/>
                                <a:column name="segment2" prompt="参考段2" width="200"/>
                                <a:column name="segment3" prompt="参考段3" width="200"/>
                                <a:column name="segment4" prompt="参考段4" width="200"/>
                                <a:column name="segment5" prompt="参考段5" width="200"/>
                                <a:column name="segment6" prompt="参考段6" width="200"/>
                                <a:column name="segment7" prompt="参考段7" width="200"/>
                                <a:column name="segment8" prompt="参考段8" width="200"/>
                                <a:column name="segment9" prompt="参考段9" width="200"/>
                                <a:column name="segment10" prompt="参考段10" width="200"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="来源信息" width="130">
                        <a:grid id='gld204f1_gld_je_info_4_grid' bindTarget="gld204f1_gld_je_info_ds" marginHeight="130"
                                marginWidth="30" navBar="true">
                            <a:columns>
                                <a:column name="je_description" prompt="行摘要" width="400"/>
                                <a:column name="contract_number" prompt="合同编号"  width="200"/>
                                <a:column name="contract_name" prompt="合同名称" align="left" width="300"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
    </a:view>
</a:screen>