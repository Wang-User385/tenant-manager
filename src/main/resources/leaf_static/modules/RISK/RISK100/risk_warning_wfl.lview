<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="risk100_link_id"
                url="${/request/@context_path}/modules/RISK/RISK100/risk_warning_info.lview"/>
        <script><![CDATA[

        debugger;

        var bp_hide_flag = 'Y';
        var file_hide_flag = 'Y';
        var comments_hide_flag = 'N';
        var comments_readOnly_flag = 'N';
        var businessKey = '${/parameter/@businessKey}';
        var riskWarning = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "riskWarningId";
        });

        var businessKey1 = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "businessKey";
        });
        if (!businessKey) {
            if(!parent.currentTaskInfo.process_instance){
                var businesskeys = parent.currentTaskInfo.execution_variables.filter(function (o) {
                    return o.name == "businessKey";
                });
                businessKey = businesskeys[0].value;
            }else{
                businessKey = parent.currentTaskInfo.process_instance.business_key;
            }
        }


        var riskWarningId = riskWarning[0].value;
        var modifyFlag= '${/parameter/@updateFlag}';
        var function_usage;
        var maintain_type;
        if(modifyFlag == 'Y' && parent.currentTaskInfo.process_instance){
            function_usage = 'UPDATE';
            maintain_type = 'MODIFY';
        }else{
            function_usage = 'QUERY';
            maintain_type = 'READONLY';
        }
        function_code = 'RISK100F1WFL';

        var pageChooser = new PageChooser({
            url: $('risk100_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                risk_warning_id: riskWarningId,
                modifyFlag: modifyFlag,
                maintain_type: maintain_type,
                function_usage: function_usage,
                bp_hide_flag: bp_hide_flag,
                file_hide_flag: file_hide_flag,
                comments_hide_flag: comments_hide_flag,
                comments_readOnly_flag:comments_readOnly_flag,
                wflRuleControlFlag:'Y'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>