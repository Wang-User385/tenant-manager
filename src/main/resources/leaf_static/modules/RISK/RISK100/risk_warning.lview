<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="risk100_detail_link"
                url="${/request/@context_path}/modules/RISK/RISK100/risk_warning_info.lview"/>
        <script><![CDATA[


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq){
            debugger;

            switch (ds.id) {
                case '${/parameter/@layout_code}_ASS005_LIST_plm_risk_warning_ds':

                    if('${/parameter/@bp_name}'!=''&&'${/parameter/@url_title}'=='客户风险预警'){
                        qpara['bp_id_n'] = '${/parameter/@bp_name}';
                    }
                    if('${/parameter/@guarantor}'!=''&&'${/parameter/@url_title}'=='担保人风险预警'){
                        qpara['project_id'] = '${/parameter/@project_id}';
                        qpara['guarantor'] = '${/parameter/@guarantor}';
                    }
                    //管理页面查询自己的单据
                    if('${/parameter/@function_code}' == 'RISK100'){
                        qpara['created_by'] = '${/session/@user_id}';
                    }

                    break;
            }
        }



            //新增
            window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
                debugger;
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
                $(ds_id).create();

            }
            //提交
            window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function() {
                debugger;
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
                var records = $(ds_id).getSelected();
                var status = records[0].get('status');
                if(records.length == 1){
                    if(status == 'NEW' || status == 'APPROVED_RETURN' || status == 'REJECTED'){
                        var json = records[0].data;
                        Leaf.Masker.mask(Ext.getBody(), '正在提交。。');
                        Leaf.request({
                            url: '${/request/@context_path}/plm/risk/warning/submit/wfl',
                            para: json,
                            success: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                                Leaf.showMessage('提示', '提交成功');
                                $(ds_id).query();
                            },
                            failure: function () {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            error: function () {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    }else{
                        Leaf.showMessage('提示', '改单据不可提交（新建，审批退回以及审批拒绝可提交）！');
                    }
                }else{
                    Leaf.showMessage('提示', '请选择一条且只能选择一条数据进行提交！');
                }
            }

            //保存
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK']= function() {
                debugger;
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
                var record = $(ds_id).getSelected()[0];
                var bp_id = record.get('bp_id');
                if(record.isNew){
                    if (bp_id) {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/hls/risk/save/success?bpId=' + bp_id +'&riskType=ARTIFICIAL_WARNING',
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                debugger;
                                var record = $(ds_id).getSelected()[0];
                                var risk_warning_id = res.result.record[0].risk_warning_id;
                                if(risk_warning_id){
                                    var param = res.result.record[0];
                                    if(res.result.record[0].status == 'NEW'|| res.result.record[0].status == 'REJECTED'){
                                        param['function_code'] = 'RISK100F1';
                                        param['function_usage'] = 'MODIFY';
                                    }else{
                                        param['function_code'] = 'RISK100F1';
                                        param['function_usage'] = 'QUERY';
                                    }
                                    param['risk_warning_id'] = risk_warning_id;
                                    param['url_title'] = '风险预警明细';
                                    param['bp_id'] = bp_id;
                                    param['winid'] = 'risk_detailwinid';
                                    hls_doc_get_layout_code(param, 'risk100_detail_link', ds_id, 'RISK100', null, null);
                                }
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }else{
                        Leaf.showMessage('提示', '请先选择承租人！');
                    }
                }
            };

            window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
                if (name == 'risk_warning_number' && value) {
                    return '<a href="javascript:open_risk_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
                }
                return value;
            };

            function open_risk_win(ds_id, record_id) {
                var record = $(ds_id).findById(record_id);
                var param = record.data;
                var bp_id = record.get('bp_id');
                var risk_warning_id = record.get('risk_warning_id');
                if('${/parameter/@function_code}' == 'RISK100F2'){
                    param['function_code'] = 'RISK100F1';
                    param['function_usage'] = 'QUERY';
                }else if(record.get('status') == 'NEW'||record.get('status') == 'REJECTED'){
                    param['function_code'] = 'RISK100F1';
                    param['function_usage'] = 'MODIFY';
                }else{
                    param['function_code'] = 'RISK100F1';
                    param['function_usage'] = 'QUERY';
                }
                param['bp_id'] = bp_id;
                param['risk_warning_id'] = risk_warning_id;
                param['url_title'] = '项目方案明细';
                param['winid'] = 'risk100F1_window_id';
                hls_doc_get_layout_code(param, 'risk100_detail_link', ds_id, 'RISK100', null, null);

            }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>