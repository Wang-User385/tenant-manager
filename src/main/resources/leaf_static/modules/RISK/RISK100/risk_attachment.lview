<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        ]]></script>
        <a:dataSets>
            <a:dataSet id="RiskAttachment_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/plm/risk/attachment/query"
                       submitUrl="${/request/@context_path}/plm/risk/attachment/submit"
                       deleteUrl="${/request/@context_path}/plm/risk/attachment/remove" selectable="true">
                <a:fields>
                        <a:field name="CHANCE_ATTACHMENT_ID"/>
                        <a:field name="RISK_WARNING_ID"/>
                        <a:field name="DOCUMENT_NAME"/>
                        <a:field name="DESCRIPTION"/>
                        <a:field name="ATTACHMENT_CATEGORY"/>
                        <a:field name="UPLOAD_DATE"/>
                        <a:field name="UPLOAD_PERSON"/>
                        <a:field name="STATUS"/>
                        <a:field name="SOURCE_ID"/>
                        <a:field name="SOURCE_TYPE"/>
                        <a:field name="DOCUMENT_ID"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton bind="RiskAttachment_grid_id" type="add"/>
                <a:gridButton bind="RiskAttachment_grid_id" type="save"/>
                <a:gridButton bind="RiskAttachment_grid_id" type="delete"/>
                <a:gridButton bind="RiskAttachment_grid_id" type="refresh"/>
            </a:screenTopToolbar>
            <a:grid id="RiskAttachment_grid_id" bindTarget="RiskAttachment_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>
                            <a:column name="DOCUMENT_NAME" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.DOCUMENT_NAME" editor="RiskAttachment_grid_textfield"/>
                            <a:column name="DESCRIPTION" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.DESCRIPTION" editor="RiskAttachment_grid_textfield"/>
                            <a:column name="ATTACHMENT_CATEGORY" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.ATTACHMENT_CATEGORY" editor="RiskAttachment_grid_textfield"/>
                            <a:column name="UPLOAD_DATE" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.UPLOAD_DATE" editor="RiskAttachment_grid_datePicker"/>
                            <a:column name="UPLOAD_PERSON" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.UPLOAD_PERSON" editor="RiskAttachment_grid_textfield"/>
                            <a:column name="STATUS" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.STATUS" editor="RiskAttachment_grid_textfield"/>
                            <a:column name="SOURCE_TYPE" align="right" autoAdjust="true"
                                      prompt="RiskAttachment.SOURCE_TYPE" editor="RiskAttachment_grid_textfield"/>
                </a:columns>
                <a:editors>
                        <a:textField id="RiskAttachment_grid_textfield"/>
                        <a:numberField id="RiskAttachment_grid_numberField"/>
                        <a:datePicker id="RiskAttachment_grid_datePicker"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>