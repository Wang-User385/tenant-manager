<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
            var bp_id = '${/parameter/@bp_id}';
            var risk_warning_id = '${/parameter/@risk_warning_id}';
            var exception_info=null;
            var risk_info=null;
            var risk_re_me=null;
            var var1=null;
            var flag=false;
            //查询时调用(grid,table,gridBox)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
                debugger
                exception_info=qpara.exception_info;
                risk_info=qpara.risk_info;
                risk_re_me=qpara.risk_re_me;
                switch (ds.id) {
                    case '${/parameter/@layout_code}_ASS005-CON_plm_risk_warning_info_ds':
                        qpara['bp_id'] = bp_id;
                        break;
                    case '${/parameter/@layout_code}_ASS005_ATTACHMENT_plm_risk_attachment_ds':
                        qpara['risk_warning_id'] = risk_warning_id;
                        break;
                }
            }
            //查询时调用(form,fieldboxcolumn)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
                debugger;
                switch (ds.id) {
                    case '${/parameter/@layout_code}_ASS005-BASIC_plm_risk_warning_ds':
                        qpara['risk_warning_id'] = risk_warning_id;
                        break;
                    case '${/parameter/@layout_code}_ASS005-INFO_plm_risk_warning_ds':
                        qpara['risk_warning_id'] = risk_warning_id;
                        break;
                    case '${/parameter/@layout_code}_ASS005-EXCEP_plm_risk_warning_ds':
                        qpara['risk_warning_id'] = risk_warning_id;
                        break;
                    case '${/parameter/@layout_code}_ASS005-RESOV_plm_risk_warning_ds':
                        qpara['risk_warning_id'] = risk_warning_id;
                        break;
                }
            };

            window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
                debugger;

                if((var1>=7)&&(flag===true)){
                    top.refreshFrame();
                }else if(exception_info!=null&&risk_info!=null&&risk_re_me!=null){
                    top.refreshFrame();
                }else if((var1>=3&&var1<=7)&&(flag===true)){
                    $L.showInfoMessage("提示","未保存!!!");
                    return;
                }
                else{
                    $L.showInfoMessage("提示","预警详细信息预警记录不能为空!!"+"\n\t异常因素描述不能为空!\n\t" +
                        "风险化解措施风险化解措施不能为空!");
                    return;
                }
            }

            // Leaf.onReady(function () {
            //     debugger;
            //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
            //     var record = $(ds_id).getCurrentRecord();
            //     record.set('risk_warning_id', risk_warning_id);
            // });

            //新增时调用(grid,table,gridBox)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
                debugger
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_attachment');
                if(ds.id == ds_id){
                    record.set('risk_warning_id',risk_warning_id);
                    record.set('upload_person','${/session/@user_id}');
                    record.set('upload_date',new Date());
                }
            };

            //更新时调用
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
                debugger;
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
                if(ds.id == ds_id){
                   if(value!=null){
                       var1+=1;
                       flag=true;
                   }else{
                       flag=false;
                   }
                    record.set('risk_warning_id', risk_warning_id);
                }
            };

            window['upload_file'] = function(record_id,risk_attachment_id,ds_id,table){
                debugger
                var record = $(ds_id).findById(record_id);
                var tableName;
                tableName = 'plm_risk_warning';
                if(table){
                    tableName = table;
                }
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
                var base_record = $(ds_id).getCurrentRecord();
                var risk_warning_id = base_record.get('risk_warning_id');
                if(risk_warning_id == null){
                    $L.showInfoMessage("提示","请先保存再上传附件!");
                    return;
                }
                if(risk_attachment_id == null){
                    $L.showInfoMessage("提示","请先保存附件信息!");
                    return;
                }
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY'||'${/parameter/@end_flag}' == 'Y') {
                    url = '${/request/@context_path}/modules/HLS/HLS200/downloadFileCopy.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';
                }
                var win = new Leaf.Window({
                    id: 'risk100_open_attachment_winid',
                    url: url,
                    params: {
                        'header_id': risk_attachment_id,
                        'table_name': tableName,
                        winid: 'risk100_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    debugger;
                    var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_attachment');
                    $(document_list_ds_id).query();
                });
            };

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
                debugger
                var link_function ;
                if (name == 'attachment_detail' && record.get('risk_attachment_id')){
                    link_function = 'upload_file';
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('risk_attachment_id') + '\',\'' + record.ds.id + '\');">附件</a>';
                }
                if (name == 'file_name' && value) {
                    debugger;
                    var str = value.split(',');
                    var url = '' ;
                    for(var i = 0;i < str.length;i++){
                        var temp = record.get('attachment_id').split(',');
                        url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                    }
                    return url;
                }
                return value;
            };

        function hls_risk_save(){
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_warning');
            $(ds_id).submit();
        }
        //页面加载 按钮显示隐藏逻辑
        Leaf.onReady(function(){
            debugger
            $jq("#hls_save_id").hide();
            if('${/parameter/@modifyFlag}' == "Y"){
                    $jq("#hls_save_id").show();
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton id="hls_save_id"  style="display:none;"  click="hls_risk_save" text="保存"/>
            </a:screenTopToolbar>
        </a:screenBody>

    </a:view>
</a:screen>