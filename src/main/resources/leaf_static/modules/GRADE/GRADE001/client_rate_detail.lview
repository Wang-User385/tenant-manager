<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <script><![CDATA[

        //alert('${/parameter/@function_usage}');
        var socre1 = 0;
        var socre2 = 0;
        var bpName = '${/parameter/@bpName}';
        var bpCode = '${/parameter/@bpCode}';
        var scoreTemplateHdName = "${/parameter/@scoreTemplateHdName}";
        var scoreTemplateHdId = '${/parameter/@scoreTemplateHdId}';
        var scoreResultId = '${/parameter/@scoreResultId}';
        var flag2 = '${/parameter/@flag2}';

        var scoreId = '${/parameter/@scoreId}';
        // var company_id = '${/parameter/@companyId}';
        var object_type = '${/parameter/@objectType}';
        var object_id = '${/parameter/@objectId}';
        var fiscal_year = "${/parameter/@fiscalYear}";
        var fiscal_year_n = "${/parameter/@fiscalYearN}";
        var fiscal_month = "${/parameter/@fiscalMonth}";
        //var financialFlag = '${/parameter/@financialFlag}';
        var financialFlag = '${/parameter/@isFiscal}';
        var statementDate = fiscal_year_n + "年" + fiscal_month + "月";
        var processInstanceId = '${/parameter/@processInstanceId}';
        var scoreResult;
        var scoreResultDtl;
        var hlsScoreCalculation;
        debugger;
        //获取模板行 比如 商业伙伴财报模板-批发与零售（有财报）    （）
        var url = "${/request/@context_path}/fnd/score/result/dtl/byHdId?scoreTemplateHdId=" + scoreTemplateHdId;
        jQuery.ajax({
            type: 'GET',
            url: url,
            async: false,
            contentType: "application/json; charset=utf-8",
            success: function (datas) {
               // debugger;
                console.log("scoreTemplateLdId----->datas.rows---->"+datas.rows);
                if(datas.total==0){
                    Leaf.showMessage("提示", "还未配置评分指标模板!", null);
                }else{
                    scoreTemplateLdId = datas.rows;
                }



            }
        });

        var url = '${/request/@context_path}/fnd/score/result/dtl/queryByLnId?scoreTemplateLnId=' + scoreTemplateLdId[0].scoreTemplateLnId + '&scoreResultId=' + scoreResultId;
        jQuery.ajax({
            type: 'GET',
            url: url,
            async: false, //设为同步
            contentType: "application/json; charset=utf-8",
            success: function (datas) {
                console.log("scoreResultDtl----->datas.rows---->"+datas.rows);
                scoreResultDtl = datas.rows;
            }
        });


        var url = '${/request/@context_path}/fnd/score/result/queryById?scoreResultId=' + scoreResultId;
        jQuery.ajax({
            type: 'GET',
            url: url,
            async: false, //设为同步
            contentType: "application/json; charset=utf-8",
            success: function (datas) {

                console.log("scoreResult----->datas.rows---->"+datas.rows);
                scoreResult = datas.rows[0];
            }
        });


        var fiscalId = 0;
        var reviewId = 0;
        if (scoreTemplateLdId != null && scoreTemplateLdId.length > 0) {
           // debugger;
            if (null != scoreTemplateLdId[0]) {
                fiscalId = scoreTemplateLdId[0].scoreTemplateLnId;  //财务
            }
            if (null != scoreTemplateLdId[1]) {
                reviewId = scoreTemplateLdId[1].scoreTemplateLnId; //非财务
            }

        }

        var totalScore1 = 0;
        var totalScore2 = 0;


        if(financialFlag=="N"&&scoreTemplateLdId.length==1){
            reviewId = fiscalId;
           /* var url = '${/request/@context_path}/fnd/score/result/dtl/countScoreByLnId?scoreTemplateLnId=' + fiscalId + '&scoreResultId=' + scoreResultId;
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    debugger;
                    totalScore2 = datas;
                }
            });*/
        }else{
            // 财务指标评价
            var url = '${/request/@context_path}/fnd/score/result/dtl/selectTotalScore?scoreTemplateLnId=' + fiscalId + '&scoreResultId=' + scoreResultId;
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    debugger;
                    totalScore1 = datas;
                }
            });
        }

        //评议指标评价
        /*var url = '${/request/@context_path}/fnd/score/result/dtl/selectTotalScore?scoreTemplateLnId=' + reviewId + '&scoreResultId=' + scoreResultId;
        jQuery.ajax({
            type: 'GET',
            url: url,
            async: false, //设为同步
            contentType: "application/json; charset=utf-8",
            success: function (datas) {
                debugger;
                totalScore2 = datas;
            }
        });*/
        debugger;
        var url = '${/request/@context_path}/fnd/score/result/dtl/countScoreByLnId?scoreTemplateLnId=' + reviewId + '&scoreResultId=' + scoreResultId;
        jQuery.ajax({
            type: 'GET',
            url: url,
            async: false, //设为同步
            contentType: "application/json; charset=utf-8",
            success: function (datas) {
                debugger;
                if(datas!=null){
                    totalScore2 = datas.score;
                }

            }
        });



        function prj316_client_rate_detail_exit() {

            $('${/parameter/@winId}').close();
            $('GREAD001F1_G_GREAD_FORM_hls_score_calculation_ds').query();

        }

        function prj316_client_rate_detail_enter() {
            debugger;
            var refndScoreResultDtls = [];
            $('prj316_fiscal_two_ds').data.forEach(function (i) {
                refndScoreResultDtls.push(i.data);
            });

           var scoreGrade = $('prj316_client_rate_detail_ds').data[0].get("score_grade");
           var totalScore = 0;
           for(var i=0;i<refndScoreResultDtls.length;i++){
               totalScore+=refndScoreResultDtls[i].target_score
           }

            var param = {};
            param.bpCode = bpCode;
            param.bpName = bpName;
            param.processInstanceId = processInstanceId;
            param.financialFlag = financialFlag;
            var result = {
                scoreResultId: scoreResult.scoreResultId,
                scoreTemplateHdId: scoreResult.scoreTemplateHdId
            };

            param.fndScoreResult = result;
            param.refndScoreResultDtls = refndScoreResultDtls;
            param.scoreId = scoreId;
            param.scoreResultId = scoreResultId;
            param.scoreTemplateHdName = scoreTemplateHdName;
            param.statementDate = statementDate;
            //param.scoreValue = totalScore1+totalScore;
            scoreGrade = getScoreGrade(totalScore1+totalScore);
            if(scoreGrade!=undefined){
                param.scoreValue = totalScore1+totalScore;
                param.scoreGrade =scoreGrade;
            }
            function getScoreGrade(value){
                if (value) {

                    if (value >= 90) {
                        return 'AAA';
                    }
                    if (value >= 80 && value < 90) {
                        return 'AA';
                    }
                    if (value >= 70 && value < 80) {
                        return 'A';
                    }
                    if (value >= 60 && value < 70) {
                        return 'BBB';
                    }
                    if (value >= 50 && value < 60) {
                        return 'BB';
                    }

                    if (value >= 40 && value < 50) {
                        return 'B';
                    }
                    if (value >= 30 && value < 40) {
                        return 'CCC';
                    }
                    if (value >= 20 && value < 30) {
                        return 'CC';
                    }
                    if (value >= 10 && value < 20) {
                        return 'C';
                    }

                    if (value < 10) {
                        return 'D';
                    }
                }
            }
            //param.scoreGrade = getScoreGrade(totalScore1+totalScore);

                jQuery.ajax({
                type: 'post',
                url: '${/request/@context_path}/fnd/score/result/dtl/submit?_csrf=${/session/@_csrf.token}',
                async: false, //设为同步
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(param),
                success: function (datas) {
                    if (datas.success) {
                        Leaf.showMessage("提示", "保存成功!", null);
                        $('${/parameter/@winId}').refreshBtn.dom.click();
                    } else {
                        Leaf.showMessage("提示", "保存失败!", null);
                    }
                }
            });

        }


        //
        var function_usage = '${/parameter/@function_usage}';
        function grid_edit_funcq() {

            if (function_usage == 'QUERY') {
                return '';
            }
            if (function_usage == 'UPDATE') {
                return 'prj316_fiscal_two_ds_grid_lv';
            }
            return 'prj316_fiscal_two_ds_grid_lv';
        }

        $L.onReady(function () {
           /* console.log("fiscalId--->"+fiscalId);
            console.log("scoreResultId--->"+scoreResultId);

            console.log("reviewId--->"+reviewId);
            console.log("scoreResultId--->"+scoreResultId);*/
                debugger;


            if(financialFlag=="N"){
                jQuery(document).ready(function () {
                    document.getElementById('prj316_fiscal_one_ds_grid_wrap').hidden = true;

                });
                var scoreTemplateLdIds = [];
                for(var i=0;i<scoreTemplateLdId.length;i++){
                    scoreTemplateLdIds.push(scoreTemplateLdId[i].scoreTemplateLnId)
                }

                var url = '${/request/@context_path}/fnd/score/result/dtl/queryByLnIds?scoreTemplateLnId=' + scoreTemplateLdIds + '&scoreResultId=' + scoreResultId;
                $('prj316_fiscal_two_ds').setQueryUrl(url);
                $('prj316_fiscal_two_ds').query();


            }else{
                var fiscalOneUrl = '${/request/@context_path}/fnd/score/result/dtl/queryByLnId?scoreTemplateLnId=' + fiscalId + '&scoreResultId=' + scoreResultId;
                var fiscalTwoUrl = '${/request/@context_path}/fnd/score/result/dtl/queryByLnId?scoreTemplateLnId=' + reviewId + '&scoreResultId=' + scoreResultId;
                $('prj316_fiscal_one_ds').setQueryUrl(fiscalOneUrl);
                $('prj316_fiscal_one_ds').query();
                $('prj316_fiscal_two_ds').setQueryUrl(fiscalTwoUrl);
                $('prj316_fiscal_two_ds').query();



            }



           /* var url = '${/request/@context_path}/fnd/score/result/dtl/countScoreByLnId?scoreTemplateLnId=' + reviewId + '&scoreResultId=' + scoreResultId;
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    debugger;
                    totalScore2 = datas;
                }
            });*/
           // var value = scoreResult.scoreValue;
            debugger;
            var value = totalScore1+totalScore2;
            if (value) {

                $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_value', value);

                if (value >= 90) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'AAA');
                }
                if (value >= 80 && value < 90) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'AA');
                }
                if (value >= 70 && value < 80) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'A');
                }
                if (value >= 60 && value < 70) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'BBB');
                }
                if (value >= 50 && value < 60) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'BB');
                }

                if (value >= 40 && value < 50) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'B');
                }
                if (value >= 30 && value < 40) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'CCC');
                }
                if (value >= 20 && value < 30) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'CC');
                }
                if (value >= 10 && value < 20) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'C');
                }

                if (value < 10) {
                    $('prj316_client_rate_detail_ds').getCurrentRecord().set('score_grade', 'D');
                }
            }

        });

        function prj316_fiscal_one_ds_grid_score_sum(data, name) {

            var sum = 0;
            $('prj316_fiscal_one_ds').data.forEach(function (i) {
                sum = sum + i.get('target_score');
            });
            return '合计：' + sum.toFixed(2);
        }

        function prj316_fiscal_two_ds_grid_score_sum(data, name) {
            var sum = 0;
            $('prj316_fiscal_two_ds').data.forEach(function (i) {
                sum = sum + i.get('target_score');
            });
            return '合计：' + sum.toFixed(2);
        }

        function setScoreTemplateLnId(lov) {
            var scoreTemplateLnId = lov.record.data.score_template_ln_id;
            lov.controller = '/fnd/score/template/ln/value/review?scoreTemplateLnId=' + scoreTemplateLnId;
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="prj316_client_rate_detail_ds" autoCreate="true">
                <a:fields>
                    <a:field name="bp_code" defaultValue="${/parameter/@bpCode}" readOnly="true"/>
                    <a:field name="bp_name" defaultValue="${/parameter/@bpName}" readOnly="true"/>
                    <a:field name="score_template_hd_name" defaultValue="${/parameter/@scoreTemplateHdName}"
                             readOnly="true"/>
                    <a:field name="statement_date" defaultValue="${/parameter/@fiscalYearN}年"
                             readOnly="true"/>
                    <a:field name="score_value" readOnly="true"/>
                    <a:field name="score_grade" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="prj316_fiscal_one_ds">
                <a:fields>
                    <a:field name="score_value" readOnly="true"/>
                    <a:field name="score_grade" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="prj316_fiscal_two_ds" submitUrl="${/request/@context_path}/fnd/score/result/dtl/submit">
                <a:fields>
                    <a:field name="target_score_grade" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100"
                             lovService="/fnd/score/template/ln/value/review~com.hand.hls.bp.dto.LovFndScoreTemplateValue"
                             lovWidth="600"
                             title="评级">
                        <a:mapping>
                            <a:map from="score_value" to="target_score"/>
                            <a:map from="score_grade" to="target_score_grade"/>
                            <a:map from="description" to="descriptions"/>
                            <a:map from="score_target_value_id" to="score_target_value_id"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="score_grade" readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="prj316_client_rate_detail_exit" text="退出"/>
                <a:gridButton click="prj316_client_rate_detail_enter" text="保存"/>
            </a:screenTopToolbar>
            <a:form title="客户评级入口">
                <a:box column="3" labelWidth="140">
                    <a:textField name="bp_code" bindTarget="prj316_client_rate_detail_ds" prompt="商业伙伴编码"
                                 width="165">
                    </a:textField>
                    <a:textField name="bp_name" bindTarget="prj316_client_rate_detail_ds" prompt="商业伙伴名称"
                                 width="165">
                    </a:textField>
                    <a:textField name="statement_date" bindTarget="prj316_client_rate_detail_ds" prompt="财务报表年月"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="3" labelWidth="140">
                    <a:textField name="score_template_hd_name" bindTarget="prj316_client_rate_detail_ds" prompt="评级模板名称"
                                 width="165">
                    </a:textField>
                    <a:textField name="score_value" bindTarget="prj316_client_rate_detail_ds" prompt="评级得分"
                                 width="165">
                    </a:textField>
                    <a:textField name="score_grade" bindTarget="prj316_client_rate_detail_ds" prompt="评级等级"
                                 width="165">
                    </a:textField>
                </a:box>
                <!--<a:box column="3" labelWidth="140">-->
                <!--<a:textField name="description" bindTarget="prj316_client_rate_detail_ds" prompt="备注"-->
                <!--width="165">-->
                <!--</a:textField>-->
                <!--</a:box>-->
            </a:form>

            <a:grid id="prj316_fiscal_one_ds_grid" bindTarget="prj316_fiscal_one_ds" width="1306" height="440"
                    navBar="true" hidden="">
                <a:columns>
                    <a:column name="target_name" width="300" prompt="指标大类" align="center"/>
                    <a:column name="first_target_name" width="300" prompt="指标" align="center"/>
                    <a:column name="score_values" width="150" prompt="分值" align="center"/>
                    <a:column name="target_score_grade" width="300" prompt="评级" align="center"/>
                    <a:column name="descriptions" width="150" prompt="描述" align="center" hidden="true"/>
                    <a:column name="target_score" width="150" prompt="得分" align="center"
                              footerRenderer="prj316_fiscal_one_ds_grid_score_sum"/>
                </a:columns>
            </a:grid>


            <a:grid id="prj316_fiscal_two_ds_grid" bindTarget="prj316_fiscal_two_ds" width="1306" height="440"
                    navBar="true">
                <a:columns>
                    <a:column name="target_name" width="300" prompt="指标大类" align="center"/>
                    <a:column name="first_target_name" width="300" prompt="指标" align="center"/>
                    <a:column name="score_values" width="150" prompt="分值" align="center"/>
                    <a:column name="target_score_grade" width="300" prompt="评级" align="center"
                               editorFunction="grid_edit_funcq" />
                    <a:column name="descriptions" width="150" prompt="描述" align="center" hidden="true"/>
                    <a:column name="target_score" width="150" prompt="得分" align="center"
                              footerRenderer="prj316_fiscal_two_ds_grid_score_sum"/>
                </a:columns>
                <a:editors>
                    <a:lov id="prj316_fiscal_two_ds_grid_lv">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="setScoreTemplateLnId"/>
                        </a:events>
                    </a:lov>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
