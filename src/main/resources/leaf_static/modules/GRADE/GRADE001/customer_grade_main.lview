<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <script><![CDATA[
        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //alert(123) hls_score_calculation
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_score_calculation');
            var record = $(ds_id).getSelected();
            if (record.length == 1) {
                var contractRecord = record[0].data;
                var score_value = contractRecord.score_value;
                //record.get('score_template_hd_id') == undefined
                //避免栈溢出
                //contractRecord[con_contract_cashflow_id.replace('_ds','')]=undefined;
                var scoreId = contractRecord.score_id;
                var scoreDate = contractRecord.score_date;
                var isTurnUp = contractRecord.is_turn_up;
                var riskWarningId = contractRecord.risk_warning_id;
                if (score_value == undefined) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "请先进行客户评级，再提交审批！", function () {
                        //$('${/parameter/@winid}').close();
                    });
                    return;
                }

                if (contractRecord.grade_status == 'NEW' || contractRecord.grade_status == 'APPROVED_RETURN'|| contractRecord.grade_status == 'CANCEL') {
                    Leaf.request({
                        url: "${/request/@context_path}/hls/score/calculation/incept/sumbit",
                        para: {
                            scoreId: scoreId,scoreDate:scoreDate,isTurnUp:isTurnUp,riskWarningId:riskWarningId
                        },
                        success: function (r) {
                            //  debugger;
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                $('${/parameter/@winid}').close();

                            });
                        },
                        error: function (r) {
                            // $L.Masker.unmask(document.body);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            // Leaf.showMessage("提示", r.error.message, null);
                        },
                        scope: this
                    });
                } else {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "评级单据状态错误，不予许提交", function () {
                        $('${/parameter/@winid}').close();

                    });
                }


            }
        }

        /*function prj316_client_score_create_enter(ds) {
