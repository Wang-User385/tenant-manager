        function prj316_client_score_create_enter(id, ds_id) {
            // debugger;
            var record = $(ds_id).findById(id);
            var type = '';
            console.log(record);
            console.log(record.get('score_template_hd_id'));
            console.log(record.get('process_instance_id'));
            if (record.get('grade_status') == 'APPROVING' || record.get('grade_status') == 'APPROVED') {
                type = 'QUERY';
            } else {
                type = 'UPDATE';
            }

            /*if(record.get('financial_flag')=="Y"){
                if (record.get('score_template_hd_id') == undefined || record.get('fiscal_year_n') == undefined) {
                    Leaf.showMessage("提示", "请将信息填写完整!", null);
                    return;
                }
            }*/
            if (record.get('score_template_hd_id') != undefined) {
                if (record.get('financial_flag') == "Y" && record.get('fiscal_year_n') == undefined) {
                    Leaf.showMessage("提示", "请将信息填写完整!", null);
                    return;
                }
            } else {
                Leaf.showMessage("提示", "请将信息填写完整!", null);
                return;
            }

            /* if(record.get('grade_status')=="APPROVING"){
                 return Leaf.showMessage("提示", "单据正在审批中!", null);
             }*/


            var scoreTemplateHdName = record.get('score_template_hd_id_n');
            // debugger;
            var scoreId0 = record.get('score_id');
            var fiscalYear = record.get('fiscal_year');
            var fiscalYearN = record.get('fiscal_year_n');
            var fiscalMonth = record.get('fiscal_month_n');
            var gradeStatus = record.get('grade_status');
            var scoreTemplateHdId = record.get('score_template_hd_id');
            var objectId = record.get('bp_id');
            var bpName = record.get("bp_name_n");
            var bpCode = '${/parameter/@bp_code}';
            var objectType = null;
            var financialFlag = record.get('financial_flag');
            var processInstanceId = record.get('process_instance_id');
            //var objectType = 'PRJ_PROJECT';

            var scoreId = 0;

            var flag = false;    // 是否打开窗口
            var flag2 = false;   // 是否为第一次评级
            var scoreResultId = 0;
            var isFiscal;
            if (typeof (fiscalYear) === 'undefined' || 'undefined' === fiscalYear) {
                //fiscalYear = null;
                isFiscal = 'N';
                var url = "${/request/@context_path}/hls/score/calculation/selectList?objectId="
                    + objectId + '&scoreTemplateHdId=' + scoreTemplateHdId + '&scoreId=' + scoreId0;
            } else {
                var url = "${/request/@context_path}/hls/score/calculation/selectList?objectId="
                    + objectId + '&fiscalYear=' + fiscalYear + '&scoreTemplateHdId=' + scoreTemplateHdId + '&scoreId=' + scoreId0;
                isFiscal = 'Y';
            }

            // debugger;
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    // debugger;
                    if (datas.success == false || null == datas.rows[0] || datas.rows[0].scoreResultId == null) {
                        flag = false;
                        flag2 = true;
                    } else {
                        scoreId = datas.rows[0].scoreId;
                        flag = true;
                        flag2 = false;
                        scoreResultId = datas.rows[0].scoreResultId;
                    }
                }
            });

            /*      if(查询评分计算表是否有对应的评分结果ID){
             如果有，则不进行评级
             否则进行评级
             } component
             */
            // var scoreUserId = '${Session.userId}';

            // if(typeof (fiscalYear) === 'undefined' || 'undefined' === fiscalYear){
            //     flag = true;
            // }


            if (flag == false) {              // 第一次进入/条件 需要要进行客户评级
                var parameter = {};

                // map.COMPANY_ID = companyId;
                // map.SCORE_USER_ID = scoreUserId;
                // debugger;
                //parameter.FISCAL_MONTH = fiscalMonth;
                parameter.FISCAL_YEAR = record.get('fiscal_year');
                parameter.BP_ID = record.get('bp_id');
                parameter.financialFlag = record.get('financial_flag');
                parameter.processInstanceId = processInstanceId;
                parameter.RESULT_ID = record.get('result_id');
                //parameter.OBJECT_TYPE = objectType;
                parameter.SCORE_TEMPLATE_HD_ID = scoreTemplateHdId;
                parameter.SCORE_RESULT_ID = scoreResultId;
                parameter.SCORE_ID = "";
                parameter.DESCRIPTION = "";
                scoreTemplateHdId = parseInt(scoreTemplateHdId);

                var url = '${/request/@context_path}/fnd/score/template/db/source/queryByHId1?_csrf=${/session/@_csrf.token}' + '&isFiscal=' + isFiscal;

                jQuery.ajax({
                    type: 'POST',
                    url: url,
                    async: false,
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(parameter),
                    success: function (datas) {
                        console.log(datas)
                        if (datas.success == false || null == datas.rows[0]) {
                            Leaf.showMessage("提示", "未知异常!", null);
                            return;
                        } else {
                            // 如果为查询用途，则不评分
                            if ('${/parameter/@function_usage}' == 'QUERY') {
                                Leaf.showMessage('${l:HLS.PROMPT}', '未找到评级记录！');
                                return;
                            }

                            // 生成结果
                            scoreResultId = datas.rows[0];
                            scoreCalculation(scoreResultId, isFiscal);
                            flag2 = true;
                        }
                    }
                });

                function scoreCalculation(scoreResultId, isFiscal) {

                    var scoreCalculation = {};
                    scoreCalculation.objectId = objectId;

                    scoreCalculation.bpId = record.get('bp_id');
                    // debugger;
                    scoreCalculation.financialFlag = isFiscal;
                    scoreCalculation.resultId = record.get('result_id');
                    scoreCalculation.isTurnUp = record.get('is_turn_up');
                    scoreCalculation.processInstanceId = processInstanceId;
                    //scoreCalculation.objectType = objectType;
                    scoreCalculation.fiscalYear = record.get('fiscal_year');
                    scoreCalculation.fiscalMonth = fiscalMonth;
                    scoreCalculation.scoreTemplateHdId = scoreTemplateHdId;
                    scoreCalculation.scoreResultId = scoreResultId;
                    scoreCalculation.scoreId = record.get('score_id');
                    scoreCalculation.gradeStatus = gradeStatus;
                    console.log("scoreCalculation.scoreId" + scoreCalculation.scoreId);
                    // 插入计算表信息（更新评级主页面内容）
                    var url = '${/request/@context_path}/hls/score/calculation/insertsc1?_csrf=${/session/@_csrf.token}';
                    jQuery.ajax({
                        type: 'post',
                        url: url,
                        data: JSON.stringify(scoreCalculation),
                        async: false,
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            // debugger;
                            if (data.success == true)
                                // 返回一个scoreId
                                scoreId = data.rows[0].scoreId;
                            flag = true;

                        }
                    });
                }
            }


            // debugger;
            if (flag == true) {
                var detailUrl = '${/request/@context_path}/modules/GRADE/GRADE001/client_rate_detail.lview';

                // debugger;
                new Leaf.Window({
                    id: 'prj316_client_score_detail_winid',
                    url: detailUrl,
                    title: '客户评级',
                    params: {
                        bpCode: bpCode,
                        bpName: bpName,
                        scoreTemplateHdName: scoreTemplateHdName,
                        fiscalYear: fiscalYear,
                        fiscalYearN: fiscalYearN,
                        fiscalMonth: fiscalMonth,
                        financialFlag: financialFlag,
                        isFiscal: isFiscal,
                        processInstanceId: processInstanceId,
                        scoreTemplateHdId: scoreTemplateHdId,
                        objectType: objectType,
                        objectId: objectId,
                        scoreResultId: scoreResultId,
                        scoreId: scoreId,
                        flag2: flag2,
                        winId: 'prj316_client_score_detail_winid',
                        function_usage: type
                    },
                    fullScreen: true
                });
            }

        }


        function lease001_detail_open(id, ds_id, record) {
            var record1 = $(ds_id).findById(id);
            if (record1.get('score_id')) {
                prj316_client_score_create_enter(id, ds_id)
            } else {
                $L.showInfoMessage("提示","请先保存评级信息!");
            }

        }


        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'lease001_detail_open';
            // debugger;

            if (record.data.financial_flag == "N") {
                record.fields.result_id_n.setReadOnly(true);
                record.fields.fiscal_year_n.setReadOnly(true);
                record.data.result_id = -1;
            }

            if (record.data.grade_status == "APPROVED" || record.data.grade_status == "APPROVING") {
                record.fields.final_score_grade_n.setReadOnly(true);
            } else {
                record.fields.final_score_grade_n.setReadOnly(false);
            }
            //GRADE_DET
            if (name === 'grade_det') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + record + '\');">明细</a>';
            }

        }


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_GREAD_FORM_hls_score_calculation_ds':
                    qpara['bp_id'] = '${/parameter/@bp_id}';
                    break;
            }
        }


        //新增时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            // debugger;
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_score_calculation');

            if (pledge_ds_id != "" && $(pledge_ds_id).getCurrentRecord() != null) {
                $(pledge_ds_id).getCurrentRecord().set('bp_id', '${/parameter/@bp_id}');
                $(pledge_ds_id).getCurrentRecord().set('object_id', '${/parameter/@bp_id}');
                $(pledge_ds_id).getCurrentRecord().set('bp_name_n', '${/parameter/@bp_name}');
                $(pledge_ds_id).getCurrentRecord().set('score_date', new Date());
                $(pledge_ds_id).getCurrentRecord().set('grade_status_n', "新建");
                $(pledge_ds_id).getCurrentRecord().set('grade_status', "NEW");
                $(pledge_ds_id).getCurrentRecord().set('final_score_grade', "");
                $(pledge_ds_id).getCurrentRecord().set('final_score_grade_n', "");
            }

        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_score_calculation');
            if(ds.id == pledge_ds_id && pledge_ds_id != "" && $(pledge_ds_id).getCurrentRecord() != null){
                if(record.get('grade_status') == 'APPROVING' || record.get('grade_status') == 'APPROVED'){
                    record.getField('is_turn_up').setReadOnly(true);
                    record.getField('is_turn_up_n').setReadOnly(true);
                    record.getField('score_template_hd_id').setReadOnly(true);
                    record.getField('score_template_hd_id_n').setReadOnly(true);
                    record.getField('result_id').setReadOnly(true);
                    record.getField('result_id_n').setReadOnly(true);
                    record.getField('fiscal_year').setReadOnly(true);
                    record.getField('fiscal_year_n').setReadOnly(true);
                    record.getField('risk_warning_id').setReadOnly(true);
                    record.getField('risk_warning_id_n').setReadOnly(true);
                    record.getField('description').setReadOnly(true);
                    record.getField('score_date').setReadOnly(true);
                }
            }
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {

            window['${/parameter/@layout_code}_set_authority_rule_string']();
        }

        //生成权限字符串
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            // debugger;
            var check_flag = true;
            Leaf.request({
                url: "${/request/@context_path}/hls/score/calculation/generateAuthorityString",
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_score_calculation');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                },
                sync: true,
                scope: this
            });
        };

        // 删除前校验
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_score_calculation');
            var flag = true;
            if(ds.id == ds_id){
                if(record[0].get('grade_status')  != 'NEW' && record[0].get('grade_status')  != 'APPROVED_RETURN'){
                    Leaf.showMessage('提示', '只有新建、退回状态可被删除');
                    flag = false;
                }
            }
            return flag;
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
