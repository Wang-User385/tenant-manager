<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <a:link id="prj316_client_score_create_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_create.lview"/>
        <script><![CDATA[

        var bpCode = '${/parameter/@bpCode}';
        var bpName = '${/parameter/@bpName}';
        var bpId = '${/parameter/@tenantBpId}';
        function prj316_client_score_create_exit() {
            $('${/parameter/@winId}').close();
        }

        function prj316_client_score_create_enter() {
            var ds = $('prj316_client_score_create_ds');

            if (ds.getCurrentRecord().get('score_template_hd_id') == undefined || ds.getCurrentRecord().get('fiscal_month') == undefined || ds.getCurrentRecord().get('fiscal_year') == undefined) {
                Leaf.showMessage("提示", "请将信息填写完整!", null);
                return;
            }

            var scoreTemplateHdName = ds.getCurrentRecord().get('score_template_hd_id_n');
            var fiscalYear = ds.getCurrentRecord().get('fiscal_year');
            var fiscalMonth = ds.getCurrentRecord().get('fiscal_month');
            var scoreTemplateHdId = ds.getCurrentRecord().get('score_template_hd_id');
            var objectId = '${/parameter/@projectId}';
            var objectType = 'PRJ_PROJECT';

            var scoreId = 0;

            var flag = false;    // 是否打开窗口
            var flag2 = false;   // 是否为第一次评级
            var scoreResultId = 0;

            var url = "${/request/@context_path}/hls/score/calculation/selectListOfHsc?objectType="
                + objectType + '&objectId=' + objectId + '&fiscalYear=' + fiscalYear + '&fiscalMonth=' + fiscalMonth + '&scoreTemplateHdId=' + scoreTemplateHdId;


            jQuery.ajax({
                type: 'GET',
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    if (datas.success == false || null == datas.rows[0] || datas.rows[0].scoreResultId == null) {
                        flag = false;
                        flag2 = true;
                    } else {
                        scoreId = datas.rows[0].scoreId;
                        flag = true;
                        flag2 = false;
                        scoreResultId = datas.rows[0].scoreResultId;
                    }
                }
            });

            /*      if(查询评分计算表是否有对应的评分结果ID){
             如果有，则不进行评级
             否则进行评级
             } component
             */
            // var scoreUserId = '${Session.userId}';

            if (flag == false) {              // 第一次进入/条件 需要要进行客户评级
                var parameter = {};

                // map.COMPANY_ID = companyId;
                // map.SCORE_USER_ID = scoreUserId;

                parameter.FISCAL_MONTH = fiscalMonth;
                parameter.FISCAL_YEAR = fiscalYear;
                parameter.BP_ID = '${/parameter/@tenantBpId}';
                parameter.OBJECT_TYPE = objectType;
                parameter.SCORE_TEMPLATE_HD_ID = scoreTemplateHdId;
                parameter.SCORE_RESULT_ID = scoreResultId;
                parameter.SCORE_ID = "";
                parameter.DESCRIPTION = "";
                scoreTemplateHdId = parseInt(scoreTemplateHdId);

                var url = '${/request/@context_path}/fnd/score/template/db/source/queryByHId?_csrf=${/session/@_csrf.token}';

                jQuery.ajax({
                    type: 'POST',
                    url: url,
                    async: false,
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(parameter),
                    success: function (datas) {
                        if (datas.success == false || null == datas.rows[0]) {
                            Leaf.showMessage("提示", "未知异常!", null);
                            return;
                        }
                        else {
                            // 如果为查询用途，则不评分
                            if ('${/parameter/@function_usage}' == 'QUERY') {
                                Leaf.showMessage('${l:HLS.PROMPT}', '未找到评级记录！');
                                return;
                            }

                            // 生成结果
                            scoreResultId = datas.rows[0];
                            scoreCalculation(scoreResultId);
                            flag2 = true;
                        }
                    }
                });

                function scoreCalculation(scoreResultId) {

                    var scoreCalculation = {};
                    scoreCalculation.objectId = objectId;
                    scoreCalculation.objectType = objectType;
                    scoreCalculation.fiscalYear = fiscalYear;
                    scoreCalculation.fiscalMonth = fiscalMonth;
                    scoreCalculation.scoreTemplateHdId = scoreTemplateHdId;
                    scoreCalculation.scoreResultId = scoreResultId;


                    var url = '${/request/@context_path}/hls/score/calculation/insertsc?_csrf=${/session/@_csrf.token}';          // 插入计算表信息
                    jQuery.ajax({
                        type: 'post',
                        url: url,
                        data: JSON.stringify(scoreCalculation),
                        async: false,
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.success == true)
                            // 返回一个scoreId
                                scoreId = data.rows[0].scoreId;
                            flag = true;

                        }
                    });
                }
            }

            if (flag == true) {

                var detailUrl = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/client_rate_detail.lview';

                new Leaf.Window({
                    id: 'prj316_client_score_detail_winid',
                    url: detailUrl,
                    title: '客户评级',
                    params: {
                        bpCode: bpCode,
                        bpName: bpName,
                        scoreTemplateHdName: scoreTemplateHdName,
                        fiscalYear: fiscalYear,
                        fiscalMonth: fiscalMonth,
                        scoreTemplateHdId: scoreTemplateHdId,
                        objectType: objectType,
                        objectId: objectId,
                        scoreResultId: scoreResultId,
                        scoreId: scoreId,
                        flag2: flag2,
                        winId: 'prj316_client_score_detail_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    fullScreen: true
                });

            }
        }

        //选择财务模板
        function selectTemplate(combo, value, display, record) {
            var bpId = '${/parameter/@tenantBpId}';

            // 获取财报年份
            var url = "${/request/@context_path}/hls/bp/master/financial/hd/query?bp_id=" + bpId + "&documentCategory=PRJ_PROJECT";
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    if (datas.rows.length > 0) {
                        $('prj316_fiscal_year_ds').removeAll();
                        datas.rows.forEach(function (i) {
                            $('prj316_fiscal_year_ds').create(i);
                        });
                        $("prj316_client_score_create_ds_year_cb").show();
                    }
                    else {
                        Leaf.showMessage("提示", "该承租人没有对应的财务报表!", null);
                        return;
                    }

                }
            });
        }

        //选择年
        function chooseYear(combo, value, display, record) {
            var bpId = '${/parameter/@tenantBpId}';
            var url = "${/request/@context_path}/hls/bp/master/financial/hd/query?bp_id=" + bpId + "&fiscal_year=" + record.get('year');
            jQuery.ajax({
                type: 'GET',
                url: url,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    $('prj316_fiscal_month_ds').removeAll();
                    if (datas.rows.length > 0) {
                        datas.rows.forEach(function (i) {
                            $('prj316_fiscal_month_ds').create(i);
                        });
                        $("prj316_client_score_create_ds_month_cb").show();
                    }
                    else {
                        Leaf.showMessage("提示", "该承租人没有对应的财务报表!", null);
                        return;
                    }
                }
            });

        }

        Leaf.onReady(function () {
            // $("prj316_client_score_create_ds_year_cb").hide();
            // $("prj316_client_score_create_ds_month_cb").hide();
            //根据bpid获取bpname和bpcode
            if(!!bpId && !bpName && !bpCode){
                $("bp_info_ds").qpara["bp_id"] = bpId;
                $("bp_info_ds").query();
            }else{
                $("bp_info_ds").un("load",onLoad_bp_info_ds);
            }
        });
        function onLoad_bp_info_ds(ds){
            var record = ds.getAt(0);
            $("prj316_client_score_create_ds").getAt(0).set("bp_code",record.get("bp_code"));
            bpCode = record.get("bp_code");
            $("prj316_client_score_create_ds").getAt(0).set("bp_name",record.get("bp_name"));
            bpName = record.get("bp_name");
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="prj316_fiscal_year_ds"/>
            <a:dataSet id="bp_info_ds" queryUrl="${/request/@context_path}/hls/bp/queryById" autoQuery="true">
                <a:events>
                    <a:event name="load" handler="onLoad_bp_info_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="prj316_fiscal_month_ds"/>
            <a:dataSet id="prj316_score_template_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/score/template/hd/query?enabledFlag=Y"/>
            <a:dataSet id="prj316_client_score_create_ds" autoCreate="true">
                <a:fields>
                    <a:field name="bp_code" defaultValue="${/parameter/@bpCode}" readOnly="true"/>
                    <a:field name="bp_name" defaultValue="${/parameter/@bpName}" readOnly="true"/>
                    <a:field name="score_template_hd_id_n" options="prj316_score_template_ds"
                             displayField="score_template_hd_name"
                             valueField="score_template_hd_id" returnField="score_template_hd_id"/>
                    <a:field name="fiscal_year" options="prj316_fiscal_year_ds" displayField="year"
                             valueField="year" returnField="fiscal_year"/>
                    <a:field name="fiscal_month" options="prj316_fiscal_month_ds" displayField="fiscalMonth"
                             valueField="fiscalMonth" returnField="fiscal_month"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="prj316_client_score_create_exit" text="退出"/>
                <a:gridButton click="prj316_client_score_create_enter" text="进入评级"/>
            </a:screenTopToolbar>
            <a:form title="客户评级入口">
                <a:box column="1" labelWidth="140">
                    <a:textField name="bp_code" bindTarget="prj316_client_score_create_ds" prompt="商业伙伴编码"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:textField name="bp_name" bindTarget="prj316_client_score_create_ds" prompt="商业伙伴名称"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:comboBox name="score_template_hd_id_n" bindTarget="prj316_client_score_create_ds" prompt="匹配模板"
                                width="165">
                        <a:events>
                            <a:event name="select" handler="selectTemplate"/>
                        </a:events>
                    </a:comboBox>
                </a:box>
                <a:box column="1" labelWidth="140" id="fiscalYearDiv">
                    <a:comboBox name="fiscal_year" bindTarget="prj316_client_score_create_ds" prompt="请选择年份"
                                width="165" id="prj316_client_score_create_ds_year_cb" hidden="true">
                        <a:events>
                            <a:event name="select" handler="chooseYear"/>
                        </a:events>
                    </a:comboBox>
                </a:box>
                <a:box column="1" labelWidth="140" id="fiscalMonthDiv">
                    <a:comboBox name="fiscal_month" bindTarget="prj316_client_score_create_ds" prompt="请选择月份"
                                width="165" id="prj316_client_score_create_ds_month_cb" hidden="true">
                    </a:comboBox>
                </a:box>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
