<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="lease_asset_detail_winid"
                url="${/request/@context_path}/modules/GRADE/GRADE001/customer_grade_main.lview"/>
        <script><![CDATA[




        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var param = {};
            debugger;
            var  hlsLease_records = $(ds_id).getSelected();
            var bp_class = hlsLease_records[0].get("bp_class");
            if(bp_class=='NP'){
                Leaf.showMessage("提示", "自然人不能做评级!", null);
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return ;
            }
            console.log(hlsLease_records[0].get("bp_id"));
            var bp_id  = hlsLease_records[0].get("bp_id");
            var bp_name = hlsLease_records[0].get("bp_name");
            var bp_code = hlsLease_records[0].get("bp_code");
            console.log(hlsLease_records[0].get("bp_name"));
            param['url_title'] = '详细信息';
            param['function_code'] = 'GREAD001F1';
            param['winid'] = 'lease_asset1_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            param['bp_id'] = bp_id;
            param['bp_code'] = bp_code;
            param['bp_name'] = bp_name;

            var link_id = 'lease_asset_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'GREAD001');
        };



        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_name' && value) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }else if (name == 'visit_information' && value) {
                return '<a href="javascript:open_visit_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">拜访明细</a>';
            }
            return value;
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            debugger;
            var  hlsLease_records = record.data;
            var bp_class = hlsLease_records.bp_class;
            if(bp_class=='NP'){
                Leaf.showMessage("提示", "自然人不能做评级!", null);
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return ;
            }
            console.log(hlsLease_records.bp_id);
            var bp_id  = hlsLease_records.bp_id;
            var bp_name = hlsLease_records.bp_name;
            var bp_code = hlsLease_records.bp_code;
            console.log(hlsLease_records.bp_name);
            param['url_title'] = '详细信息';
            param['function_code'] = 'GREAD001F1';
            param['winid'] = 'lease_asset1_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            param['bp_id'] = bp_id;
            param['bp_code'] = bp_code;
            param['bp_name'] = bp_name;

            var link_id = 'lease_asset_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'GREAD001');

        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
