                        <a:grid id="calc_prj_project_survive_require_ds_grid" bindTarget="prj110f1_prj_project_survive_require_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="50" name="row_seq" prompt="序号"/>
                                <a:column width="450" name="manage_requirements" prompt="租后管理要求" editor="calc_prj_project_survive_require_ds_grid_textArea"/>
                            </a:columns>
                            <a:editors>
                                <a:textArea id="calc_prj_project_survive_require_ds_grid_textArea"/>
                            </a:editors>
