                    <a:event name="load" handler="prj110f1_pldge_load"/>
                </a:events>
            </a:dataSet>


            <!-- 担保人-->
            <a:dataSet id="prj110f1_prj_project_g_bp_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/prj/project/bp/query">

                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_g_bp_load"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_g_bp_change_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/prj/project/bp/query">

                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_change_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_g_bp_load"/>
                </a:events>
            </a:dataSet>

            <!-- 付款前提条件-->
            <a:dataSet id="prj110f1_prj_project_payment_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/paymentcondition?projectId=${/parameter/@ref_project_id}">
                <a:fields>
                    <a:field name="condition" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_payment_load"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_payment_change_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/paymentcondition?projectId=${/parameter/@project_id}">
                <a:fields>
                    <a:field name="condition" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_change_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_payment_load"/>
                </a:events>
            </a:dataSet>

            <!-- 存续期管理要求-->
            <a:dataSet id="prj110f1_prj_project_survive_require_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/managerequire?projectId=${/parameter/@ref_project_id}">
                <a:fields>
                    <a:field name="manage_requirements" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_survive_require_load"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_survive_require_change_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/managerequire?projectId=${/parameter/@project_id}">
                <a:fields>
                    <a:field name="manage_requirements" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj110f1_g_bp_prj_project_change_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_survive_require_load"/>
                </a:events>
            </a:dataSet>

        </a:dataSets>



        <a:screenBody>
            <a:form title="基本信息">
                <a:hBox labelWidth="120">
                    <a:textField width="425" name="project_name" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="项目名称"/>
                    <a:textField width="150" name="business_type_n" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="业务种类"/>
                    <a:textField width="150" name="company_id_n" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="公司/spv"/>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:textField width="150" name="host_project_manager_n" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="主办项目经理"/>
                    <a:textField width="150" name="host_unit_name" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="主办所属部门"/>
                    <a:textField width="150" name="assist_project_manager_n" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="协办项目经理"/>
                    <a:textField width="150" name="assist_unit_name" readOnly="true" bindTarget="prj110f1_prj_project_base_info_ds" prompt="协办所属部门"/>
                </a:hBox>
            </a:form>

            <div class="change_base_info_contain" style="display: none;">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">基本信息变更列表</span>

                <a:grid id="prj110f1_prj_project_base_change_info_ds_grid" bindTarget="prj110f1_prj_project_base_change_info_ds" height="200" marginWidth="30"
                        navBar="true">
                    <a:columns>
                        <a:column name="change_type" width="80" editor="prj110f1_prj_project_base_change_info_ds_grid_tf" prompt="变更类型"/>
                        <a:column name="used_cash_flow" width="400" editor="prj110f1_prj_project_base_change_info_ds_grid_textArea" prompt="资金用途"/>
                        <a:column name="risk_mitigation_measures" width="400" editor="prj110f1_prj_project_base_change_info_ds_grid_textArea" prompt="风险缓释措施"/>
                        <a:column name="other_thing" width="400" editor="prj110f1_prj_project_base_change_info_ds_grid_textArea" prompt="其他"/>
                        <a:column name="price_note" width="400" editor="prj110f1_prj_project_base_change_info_ds_grid_textArea" prompt="价格备注"/>
                        <a:column name="area_category" width="200" editor="prj110f1_prj_project_base_change_info_ds_grid_tf" prompt="区域类别"/>
                        <a:column name="industry_category" width="200" editor="prj110f1_prj_project_base_change_info_ds_grid_tf" prompt="行业类别"/>
                        <a:column name="assure_means" width="200" editor="prj110f1_prj_project_base_change_info_ds_grid_tf" prompt="担保方式"/>
                    </a:columns>
                    <a:editors>
                        <a:textField id="prj110f1_prj_project_base_change_info_ds_grid_tf" readOnly="true"/>
                        <a:textArea id="prj110f1_prj_project_base_change_info_ds_grid_textArea" readOnly="true"/>
                    </a:editors>
                    <a:events>
                        <a:event name="render" handler="base_change_ds_grid_render"/>
                    </a:events>
                </a:grid>
            </div>

            <a:placeHolder id="dynamicWflQuotationTreeNode_id"/>

            <!--承租人信息-->
            <div id="change_tenant_contain" style="display: none">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">承租人和共同承租人信息</span>

                <div class="prj_change_req_contain">
