                                navBar="true">
                            <a:columns>
                                <a:column width="50" name="row_seq" prompt="序号"/>
                                <a:column width="450" name="manage_requirements" prompt="租后管理要求" editor="calc_prj_project_survive_require_change_ds_grid_textArea"/>
                            </a:columns>
                            <a:editors>
