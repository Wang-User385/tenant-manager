<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectPrjQuotationLoop"
                       rootPath="project_change_quotation_path"/>
    </a:init-procedure>

    <a:view>
        <a:link id="prj_change_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="pledge_info_detaill_id"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <style>
            .prj_change_req_wfl_span{
                background: #435FBF;
                width: 8px;
                height: 8px;
                display: inline-block;
                vertical-align: middle;
                margin-right: 8px;
                margin-left: 8px;
                margin-bottom: 5px;
            }
            .prj_change_req_wfl_word{
                display: inline-block;
                vertical-align: middle;
                margin-bottom: 5px;
                color: #435FBF;
            }
            .prj_change_req_wfl_left{
                width: 600px;
                display: inline-block;
            }
            .prj_change_req_wfl_right{
                width: 600px;
                display: inline-block;
                float: right;
            }
            .prj_change_req_contain{
                margin-left: 50px;
                margin-top: 20px;
            }
        </style>

    <script><![CDATA[

    function addQueryFilter(ds){
        if(ds.queryurl.indexOf("?") == -1) {
            if (ds.queryurl.indexOf('wflRuleControlFlag') == -1) {
                ds.queryurl = ds.queryurl + '?wflRuleControlFlag=Y';
            }
        }else{
            if (ds.queryurl.indexOf('wflRuleControlFlag') == -1) {
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
        }
    }

    function prj110f1_prj_project_base_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@project_id}';
        addQueryFilter(ds);
    }

    function prj110f1_prj_project_base_change_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@project_id}';
        qpara['ref_project_id'] = '${/parameter/@ref_project_id}';
        addQueryFilter(ds);
    }

    function prj110f1_prj_project_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@ref_project_id}';
        addQueryFilter(ds);
    }

    function prj110f1_prj_project_change_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@project_id}';
        addQueryFilter(ds);
    }

    function prj110f1_bp_prj_project_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@ref_project_id}';
        qpara['tenant_flag'] = 'Y';
        addQueryFilter(ds);
    }

    function prj110f1_bp_prj_project_change_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@project_id}';
        qpara['tenant_flag'] = 'Y';
        addQueryFilter(ds);
    }

    function prj110f1_g_bp_prj_project_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@ref_project_id}';
        qpara['bp_type'] = 'WARRANTOR';
        addQueryFilter(ds);
    }

    function prj110f1_g_bp_prj_project_change_info_ds_query(ds,qpara){
        qpara['project_id'] = '${/parameter/@project_id}';
        qpara['bp_type'] = 'WARRANTOR'
        addQueryFilter(ds);
    }

    function prj110f1_prj_project_base_info_ds_load(ds){
        var changeData , baseData;
        var datas = ds.getAll();
        for(var i = 0 ; i < datas.length; i++){
            if(datas[i].get('change_type') == '变更后'){
                changeData = datas[i];
            }else{
                baseData = datas[i];
            }
        }

        for(var v in changeData.data){

        }
    }

    function lease_item_change_ds_grid_render(){
        //debugger;
        var datas = $('prj110f1_prj_project_lease_item_change_info_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_lease_item_info_ds').getAll();
        if(sourceDatas.length != datas.length){
            $jq("#change_lease_item_contain").show();
        }
        if(datas.length != 0){
            for(var i = 0; i < datas.length; i++){
                var addFlag = true;
                for(var j = 0; j < sourceDatas.length; j++){
                    if(datas[i].get('lease_item_id') == sourceDatas[j].get('lease_item_id')){
                        addFlag = false;
                    }
                }
                if(addFlag){
                    $jq("#change_lease_item_contain").show();
                    
                    var seq =  datas[i].id;
                    (function(seq) {
                        setTimeout(function () {
                            $jq('tr[_row=' + seq + ']').css({
                                "background": "#ff6633",
                                "color": "white"
                            });
                        }, 1000)
                    })(seq);
                }
            }
        }
    }

    function tenant_change_ds_grid_render() {
        var datas = $('prj110f1_prj_project_bp_change_info_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_bp_info_ds').getAll();
        if (sourceDatas.length != datas.length) {
            $jq("#change_tenant_contain").show();
        }
        if (datas.length != 0) {
            for (var i = 0; i < datas.length; i++) {
                var addFlag = true;
                for (var j = 0; j < sourceDatas.length; j++) {
                    if (datas[i].get('bp_id') == sourceDatas[j].get('bp_id')) {
                        addFlag = false;
                    }
                }
                if (addFlag) {
                    $jq("#change_tenant_contain").show();
                    var seq = datas[i].id;
                    (function (seq) {
                        setTimeout(function () {
                            $jq('tr[_row=' + seq + ']').css({
                                "background": "#ff6633",
                                "color": "white"
                            });
                        }, 1000)
                    })(seq);
                }
            }
        }
    }

    function g_change_ds_grid_render() {
        var datas = $('prj110f1_prj_project_g_bp_change_info_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_g_bp_info_ds').getAll();
        if (sourceDatas.length != datas.length) {
            $jq("#change_g_contain").show();
        }
        if (datas.length != 0) {
            for (var i = 0; i < datas.length; i++) {
                var addFlag = true;
                for (var j = 0; j < sourceDatas.length; j++) {
                    if (datas[i].get('bp_id') == sourceDatas[j].get('bp_id')) {
                        addFlag = false;
                    }
                }
                if (addFlag) {
                    $jq("#change_g_contain").show();
                    var seq = datas[i].id;
                    (function (seq) {
                        setTimeout(function () {
                            $jq('tr[_row=' + seq + ']').css({
                                "background": "#ff6633",
                                "color": "white"
                            });
                        }, 1000)
                    })(seq);
                }
            }
        }
    }

    function payment_change_ds_grid_render(){
        var datas = $('prj110f1_prj_project_payment_change_info_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_payment_info_ds').getAll();
        if(sourceDatas.length != datas.length){
            $jq("#change_payment_contain").show();
        }
        if(datas.length != 0){
            for(var i = 0; i < datas.length; i++){
                var addFlag = true;
                for(var j = 0; j < sourceDatas.length; j++){
                    if(datas[i].get('condition') == sourceDatas[j].get('condition')){
                        addFlag = false;
                    }
                    if(datas[i].get('ref_credit_condition_id') == sourceDatas[j].get('credit_condition_id')){
                        if(datas[i].get('condition') != sourceDatas[j].get('condition')){
                            addFlag = true;
                        }
                    }
                }
                if(addFlag){
                    $jq("#change_payment_contain").show();
                    var seq =  datas[i].id;
                    (function(seq){
                        setTimeout(function(){
                            $jq('tr[_row='+seq+']').css({
                                "background":"#ff6633",
                                "color":"white"
                            });
                        },1000);
                    })(seq);


                }
            }
        }
    }

    function survive_require_change_ds_grid_render(grid_id){
        var datas = $('prj110f1_prj_project_survive_require_change_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_survive_require_ds').getAll();
        if(sourceDatas.length != datas.length){
            $jq("#change_survive_require_contain").show();
        }
        if(datas.length != 0){
            for(var i = 0; i < datas.length; i++){
                var addFlag = true;
                for(var j = 0; j < sourceDatas.length; j++){
                    if(datas[i].get('manage_requirements') == sourceDatas[j].get('manage_requirements')){
                        addFlag = false;
                    }
                    if(datas[i].get('ref_prj_survive_id') == sourceDatas[j].get('prj_survive_id')){
                        if(datas[i].get('manage_requirements') != sourceDatas[j].get('manage_requirements')){
                            addFlag = true;
                        }
                    }
                }
                if(addFlag){
                    $jq("#change_survive_require_contain").show();
                    var seq =  datas[i].id;
                    (function(seq){
                        setTimeout(function(){
                            $jq('tr[_row='+seq+']').css({
                                "background":"#ff6633",
                                "color":"white"
                            });
                        },1000);
                    })(seq);
                }
            }
        }
    }

    function pldge_change_ds_grid_render(){
        var datas = $('prj110f1_prj_project_pldge_change_info_ds').getAll();
        var sourceDatas = $('prj110f1_prj_project_pldge_info_ds').getAll();
        if(sourceDatas.length != datas.length){
            $jq("#change_pldge_contain").show();
        }
        if(datas.length != 0){
            for(var i = 0; i < datas.length; i++){
                var addFlag = true;
                for(var j = 0; j < sourceDatas.length; j++){
                    if(datas[i].get('lease_item_id') == sourceDatas[j].get('lease_item_id')){
                        addFlag = false;
                    }
                }
                if(addFlag){
                    $jq("#change_pldge_contain").show();
                    var seq =  datas[i].id;
                    (function(seq) {
                        setTimeout(function () {
                            $jq('tr[_row=' + seq + ']').css({
                                "background": "#ff6633",
                                "color": "white"
                            });
                        }, 1000)
                    })(seq);
                }
            }
        }
    }

    function calc_ds_grid_render(grid_id){
        var ds = grid_id.dataset;
        var changeData , baseData;
        var datas = ds.getAll();
        for(var i = 0 ; i < datas.length; i++){
            if(datas[i].get('change_type') == '变更后'){
                changeData = datas[i];
            }else{
                baseData = datas[i];
            }
        }

        if(changeData != null) {
            for (var v in changeData.data) {
                if (changeData.data[v] !== baseData.data[v] && v !== 'change_type' && v != '_r_o_w__i_d') {
                    $jq("#"+grid_id.id).closest(".change_quotation_contain").show();
                    $jq('#' + grid_id.id + '_' + v + '_' + changeData.id).css({
                        "background-color": "#ff6633",
                        "color": "white"
                    });
                }
            }
        }
    }

    function base_change_ds_grid_render(grid_id){//debugger;
        var ds = grid_id.dataset;
        var changeData , baseData;
        var datas = ds.getAll();
        for(var i = 0 ; i < datas.length; i++){
            if(datas[i].get('change_type') == '变更后'){
                changeData = datas[i];
            }else{
                baseData = datas[i];
            }
        }

        if(changeData != null) {
            for (var v in changeData.data) {
                if (changeData.data[v] !== baseData.data[v] && v !== 'change_type' && v != '_r_o_w__i_d') {
                    $jq("#"+grid_id.id).closest(".change_base_info_contain").show();
                    $jq('#' + grid_id.id + '_' + v + '_' + changeData.id).css({
                        "background-color": "#ff6633",
                        "color": "white"
                    });
                }
            }
        }
    }

    function calc_prj_project_change_ds_grid_renderer(value, record, name){
        if(name == 'bp_detail'){
            return '<a href="javascript:calc_prj_project_bp_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户信息详情' + '</a>';
        }
        if(name == 'lease_item_detail'){
            return '<a href="javascript:calc_prj_project_lease_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '租赁物清单详情' + '</a>';
        }
        if(name == 'pldge_detail'){
            return '<a href="javascript:calc_prj_project_pldge_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '抵押物清单详情' + '</a>';
        }
        if(name == 'lease_item_excel'){
            return '<a href="javascript:calc_prj_project_lease_excel_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '租赁物明细' + '</a>';
        }

        if(name == 'pldge_excel'){
            return '<a href="javascript:calc_prj_project_lease_excel_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '抵押物明细' + '</a>';
        }
    }

    window['calc_prj_project_pldge_excel'] = function(){
        var lease_record = $(ds_id).findById(record_id).data;

        var result_id = lease_record.result_id;
        var excel_id = lease_record.excel_id;
        if (result_id == null || result_id == '' || result_id == undefined) {
            $L.showInfoMessage("提示", "请先导入抵质押物明细数据!");
            return;
        }
        if (excel_id == null || excel_id == '' || excel_id == undefined) {
            $L.showInfoMessage("提示", "模板有误!");
            return;
        }


        var win = new Leaf.Window({
            id: 'bp100_excel_detail_win_id',
            params: {
                result_id: result_id,
                excel_id: excel_id,
                source_document_category: 'MORTGAGE_PLEDGE_REPORT',
                winid: 'bp100_excel_detail_win_id',
                readOnly: 'Y'
            },
            url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
            title: '抵质押物报表明细',
            fullScreen: true
        });
    };

    window['calc_prj_project_lease_detail'] = function(ds_id,record_id){
        var param = $(ds_id).findById(record_id).data;
        param['url_title'] = '租赁物详细信息';
        param['function_code'] = 'LEASE001F1';
        param['winid'] = 'lease_item_detail_winid';
        param['ds_id'] = ds_id;
        param['function_usage'] = 'QUERY';
        var link_id = 'lease_info_detaill_id';
        hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
    };

    window['calc_prj_project_pldge_detail'] = function(ds_id,record_id){
        var param = $(ds_id).findById(record_id).data;
        param['url_title'] = '抵押物详细信息';
        param['function_code'] = 'SW001F1';
        param['winid'] = 'pldge_detail_winid';
        param['ds_id'] = ds_id;
        param['function_usage'] = 'QUERY';
        var link_id = 'pledge_info_detaill_id';
        hls_doc_get_layout_code(param, link_id, ds_id, 'SW001F1');
    }

    window['calc_prj_project_lease_excel_detail'] = function(ds_id,record_id){
        var lease_record = $(ds_id).findById(record_id).data;

        var result_id = lease_record.result_id;
        var excel_id = lease_record.excel_id;
        if (result_id == null || result_id == '' || result_id == undefined) {
            $L.showInfoMessage("提示", "没有租赁物物明细数据!");
            return;
        }
        if (excel_id == null || excel_id == '' || excel_id == undefined) {
            $L.showInfoMessage("提示", "模板有误!");
            return;
        }

        new Leaf.Window({
            id: 'lease_excel_detail_win_id',
            params: {
                result_id: lease_record.result_id,
                excel_id: lease_record.excel_id,
                source_document_category: 'HLS_LEASE_ITEM_RENTAL',
                source_document_id: lease_record.lease_item_id,
                winid: 'lease_excel_detail_win_id',
                readOnly: 'Y'
            },
            url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
            title: '租赁物明细',
            fullScreen: true
        });
    };

    window['calc_prj_project_bp_detail'] = function(ds_id,record_id){
        var record = $(ds_id).findById(record_id);
        var param = record.data;
        param['url_title'] = '客户信息维护';
        if (param['bp_class'] == 'ORG') {
            param['function_code'] = 'BP100F1';
        } else {
            param['function_code'] = 'BP100F2';
        }
        param['function_usage'] = 'QUERY';
        delete param['bp_seq'];
        param['winid'] = 'prj_change_bp_master_modify_winid';

        hls_doc_get_layout_code(param, 'prj_change_bp_master_modify_id', ds_id);
    }

    var tenant_count = 0;
    function prj110f1_tenant_load(){
        if(tenant_count == 1){
            tenant_change_ds_grid_render();
        }else{
            tenant_count++;
        }
    }

    var lease_item_count = 0;
    function prj110f1_lease_item_load(){
        if(lease_item_count == 1){
            lease_item_change_ds_grid_render();
        }else{
            lease_item_count++;
        }
    }

    var pldge_count = 0;
    function prj110f1_pldge_load(){
        if(pldge_count == 1){
            pldge_change_ds_grid_render();
        }else{
            pldge_count++;
        }
    }

    var g_bp_count = 0;
    function prj110f1_g_bp_load(){
        if(g_bp_count == 1){
            g_change_ds_grid_render();
        }else{
            g_bp_count++;
        }
    }

    var payment_count = 0;
    function prj110f1_payment_load(){
        if(payment_count == 1){
            payment_change_ds_grid_render();
        }else{
            payment_count++;
        }
    }

    var survive_require_count = 0;
    function prj110f1_survive_require_load(){
        if(survive_require_count == 1){
            survive_require_change_ds_grid_render();
        }else{
            survive_require_count++;
        }
    }

    //百分数格式化
    function percentFormat(value,record,name){
        if(name == 'deposit_ratio' || name == 'lease_charge_ratio'){
            if (!isNaN(value)) {
                return parseFloat(value * 100).toFixed(6) + '%';
            } else {
                return '';
            }
        }
        if (!isNaN(value)) {
            return parseFloat(value * 100).toFixed(2) + '%';
        } else {
            return '';
        }
    }

    ]]></script>

        <a:dataSets>
            <a:dataSet id="prj110f1_prj_project_base_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/prj/project/detail/query/second">

                <a:events>
                    <a:event name="query" handler="prj110f1_prj_project_base_info_ds_query"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_base_change_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/base/change/info?project_id=${/parameter/@project_id}&amp;ref_project_id=${/parameter/@ref_project_id}">

                <a:events>
                    <a:event name="query" handler="prj110f1_prj_project_base_change_info_ds_query"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_bp_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/prj/project/bp/query">

                <a:events>
                    <a:event name="query" handler="prj110f1_bp_prj_project_info_ds_query"/>
                    <a:event name="load" handler="prj110f1_tenant_load"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj110f1_prj_project_bp_change_info_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/ct/prj/project/bp/query">

                <a:events>
                    <a:event name="query" handler="prj110f1_bp_prj_project_change_info_ds_query"/>
