                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更前</span>

                        <a:grid id="calc_prj_project_bp_ds_grid" bindTarget="prj110f1_prj_project_bp_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="150" name="bp_code" prompt="客户编号"/>
                                <a:column width="80" name="bp_type_n" prompt="客户类型"/>
                                <a:column width="150" name="bp_name" prompt="客户名称"/>
                                <a:column width="80" name="bp_class_n" prompt="客户分类"/>
                                <a:column name="bp_detail" renderer="calc_prj_project_change_ds_grid_renderer" prompt="客户信息详情"/>
                            </a:columns>
                        </a:grid>

                    </div>

                    <div class="prj_change_req_wfl_right">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更后</span>

                        <a:grid id="calc_prj_project_bp_change_ds_grid" bindTarget="prj110f1_prj_project_bp_change_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="150" name="bp_code" prompt="客户编号"/>
                                <a:column width="80" name="bp_type_n" prompt="客户类型"/>
                                <a:column width="150" name="bp_name" prompt="客户名称"/>
                                <a:column width="80" name="bp_class_n" prompt="客户分类"/>
                                <a:column name="bp_detail" renderer="calc_prj_project_change_ds_grid_renderer" prompt="客户信息详情"/>
                            </a:columns>
                        </a:grid>

                    </div>
                </div>
            </div>

            <!--租赁物-->
            <div id="change_lease_item_contain" style="display: none;">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">租赁物</span>

                <div class="prj_change_req_contain">
                    <div class="prj_change_req_wfl_left">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更前</span>

                        <a:grid id="calc_prj_project_lease_item_ds_grid" bindTarget="prj110f1_prj_project_lease_item_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="250" align="center" name="lease_item_name" prompt="租赁物名称"/>
                                <a:column width="150" renderer="calc_prj_project_change_ds_grid_renderer" name="lease_item_detail" prompt="租赁物清单详情"/>
                                <a:column width="100" renderer="calc_prj_project_change_ds_grid_renderer" name="lease_item_excel" prompt="租赁物明细"/>
                            </a:columns>
                        </a:grid>

                    </div>

                    <div class="prj_change_req_wfl_right">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更后</span>

                        <a:grid id="calc_prj_project_lease_item_change_ds_grid" bindTarget="prj110f1_prj_project_lease_item_change_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="250" align="center" name="lease_item_name" prompt="租赁物名称"/>
                                <a:column width="150" renderer="calc_prj_project_change_ds_grid_renderer" name="lease_item_detail"  prompt="租赁物清单详情"/>
                                <a:column width="100" renderer="calc_prj_project_change_ds_grid_renderer" name="lease_item_excel" prompt="租赁物明细"/>
                            </a:columns>

                        </a:grid>

                    </div>
                </div>
            </div>

            <!--抵质押物明细-->
            <div id="change_pldge_contain" style="display: none;">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">抵质押物信息</span>

                <div class="prj_change_req_contain">
                    <div class="prj_change_req_wfl_left">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更前</span>

                        <a:grid id="calc_prj_project_pldge_ds_grid" bindTarget="prj110f1_prj_project_pldge_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="250" align="center" name="lease_item_id_n" prompt="抵质押物名称"/>
                                <a:column width="150" renderer="calc_prj_project_change_ds_grid_renderer" name="pldge_detail" prompt="抵质押物清单详情"/>
                                <a:column width="100" renderer="calc_prj_project_change_ds_grid_renderer" name="pldge_excel" prompt="抵质押物明细"/>
                            </a:columns>
                        </a:grid>

                    </div>

                    <div class="prj_change_req_wfl_right">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更后</span>

                        <a:grid id="calc_prj_project_pldge_change_ds_grid" bindTarget="prj110f1_prj_project_pldge_change_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="250" align="center" name="lease_item_id_n" prompt="抵质押物名称"/>
                                <a:column width="150" renderer="calc_prj_project_change_ds_grid_renderer" name="pldge_detail" prompt="抵质押物清单详情"/>
                                <a:column width="100" renderer="calc_prj_project_change_ds_grid_renderer" name="pldge_excel" prompt="抵质押物明细"/>
                            </a:columns>
                        </a:grid>

                    </div>
                </div>
            </div>

            <!--担保人信息-->
            <div id="change_g_contain" style="display: none;">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">担保人信息</span>

                <div class="prj_change_req_contain">
                    <div class="prj_change_req_wfl_left">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更前</span>

                        <a:grid id="calc_prj_project_g_bp_ds_grid" bindTarget="prj110f1_prj_project_g_bp_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="150" name="bp_code" prompt="客户编号"/>
                                <a:column width="150" name="bp_name" prompt="客户名称"/>
                                <a:column width="100" name="bp_class_n" prompt="客户类型"/>
                                <a:column name="bp_detail" renderer="calc_prj_project_change_ds_grid_renderer" prompt="客户信息详情"/>
                            </a:columns>
                        </a:grid>

                    </div>

                    <div class="prj_change_req_wfl_right">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更后</span>

                        <a:grid id="calc_prj_project_g_bp_change_ds_grid" bindTarget="prj110f1_prj_project_g_bp_change_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="150" name="bp_code" prompt="客户编号"/>
                                <a:column width="150" name="bp_name" prompt="客户名称"/>
                                <a:column width="100" name="bp_class_n" prompt="客户类型"/>
                                <a:column name="bp_detail" renderer="calc_prj_project_change_ds_grid_renderer" prompt="客户信息详情"/>
                            </a:columns>
                        </a:grid>

                    </div>
                </div>
            </div>

            <!--付款前提条件-->
            <div id="change_payment_contain" style="display: none;">
                <span class="prj_change_req_wfl_span"></span>
                <span class="prj_change_req_wfl_word">付款前提条件</span>

                <div class="prj_change_req_contain">
                    <div class="prj_change_req_wfl_left">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更前</span>

                        <a:grid id="calc_prj_project_payment_ds_grid" bindTarget="prj110f1_prj_project_payment_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="50" name="row_seq" prompt="序号"/>
                                <a:column width="450" name="condition" prompt="付款前提条件" editor="calc_prj_project_payment_ds_grid_textArea"/>
                            </a:columns>
                            <a:editors>
                                <a:textArea id="calc_prj_project_payment_ds_grid_textArea"/>
                            </a:editors>
                        </a:grid>

                    </div>

                    <div class="prj_change_req_wfl_right">
                        <span class="prj_change_req_wfl_span"></span>
                        <span class="prj_change_req_wfl_word">变更后</span>

                        <a:grid id="calc_prj_project_payment_change_ds_grid" bindTarget="prj110f1_prj_project_payment_change_info_ds" height="200" width="500"
                                navBar="true">
                            <a:columns>
                                <a:column width="50" name="row_seq" prompt="序号"/>
                                <a:column width="450" name="condition" prompt="付款前提条件" editor="calc_prj_project_payment_change_ds_grid_textArea"/>
                            </a:columns>
                            <a:editors>
                                <a:textArea id="calc_prj_project_payment_change_ds_grid_textArea"/>
                            </a:editors>
                        </a:grid>

                    </div>
                </div>
