            </div>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
    <a:view-config>
        <c:create-config targetId="dynamicWflQuotationTreeNode_id">
            <p:loop source="/model/project_change_quotation_path">
                <p:switch test="@quotation_id">
                    <p:case value="*">
                        <c:process-config>

                            <div class="change_quotation_contain" style="display: none;">
                                <span class="prj_change_req_wfl_span"></span>
                                <span class="prj_change_req_wfl_word">送审方案(${@seq})</span>
                                <a:dataSets>
                                    <a:dataSet id="calc_${@quotation_id}_ds" autoQuery="true"
                                               queryUrl="${/request/@context_path}/change/quotation/info?quotationId=${@quotation_id}">
                                        <a:fields>
                                            <a:field name="finance_amount" />
                                        </a:fields>
                                        <a:events>
                                            <a:event name="load" handler="prj110f1_prj_project_base_info_ds_load"/>
                                        </a:events>
                                    </a:dataSet>
                                </a:dataSets>
                                <a:grid id="calc_${@quotation_id}_ds_grid" bindTarget="calc_${@quotation_id}_ds" height="200" marginWidth="30"
                                        navBar="true">
                                    <a:columns>
                                        <a:column name="change_type" width="80" editor="calc_${@quotation_id}_ds_grid_tf" prompt="变更类型"/>
                                        <a:column name="price_list" editor="calc_${@quotation_id}_ds_grid_tf" prompt="价目表"/>
                                        <a:column name="business_type" editor="calc_${@quotation_id}_ds_grid_tf" prompt="业务类型"/>
                                        <a:column name="finance_amount" renderer="Leaf.formatMoney" editor="calc_${@quotation_id}_ds_grid_nf" prompt="融资额"/>
                                        <a:column name="currency_name" editor="calc_${@quotation_id}_ds_grid_tf" prompt="币种"/>
                                        <a:column name="lease_term" editor="calc_${@quotation_id}_ds_grid_nf" prompt="租赁期限(月)"/>
                                        <a:column name="int_rate" editor="calc_${@quotation_id}_ds_grid_pf" prompt="租赁利率" renderer="percentFormat"/>
                                        <a:column name="deposit_ratio" editor="calc_${@quotation_id}_ds_grid_pf" prompt="保证金比例" renderer="percentFormat"/>
                                        <a:column name="lease_charge_ratio" editor="calc_${@quotation_id}_ds_grid_pf" prompt="手续费比例" renderer="percentFormat"/>
                                        <a:column name="residual_value" editor="calc_${@quotation_id}_ds_grid_nf" prompt="留购金" renderer="Leaf.formatMoney"/>
                                        <a:column name="xirr" editor="calc_${@quotation_id}_ds_grid_nf" prompt="xirr" renderer="percentFormat"/>
                                        <a:column name="renting_frequency" editor="calc_${@quotation_id}_ds_grid_tf" prompt="租金支付频率（月）"/>
                                        <a:column name="int_rate_type" editor="calc_${@quotation_id}_ds_grid_tf" prompt="利率类型"/>
                                        <a:column name="other_price" editor="calc_${@quotation_id}_ds_grid_nf" prompt="其他金额" renderer="Leaf.formatMoney"/>
                                        <a:column name="subject_matter_introdution" editor="calc_${@quotation_id}_ds_grid_tf" prompt="租赁标的物"/>
                                    </a:columns>
                                    <a:editors>
                                        <a:textField id="calc_${@quotation_id}_ds_grid_tf" readOnly="true"/>
                                        <a:numberField id="calc_${@quotation_id}_ds_grid_nf" readOnly="true"/>
                                        <a:percentField id="calc_${@quotation_id}_ds_grid_pf" readOnly="true"/>
                                    </a:editors>
                                    <a:events>
                                        <a:event name="render" handler="calc_ds_grid_render"/>
                                    </a:events>
                                </a:grid>
                            </div>

                        </c:process-config>
                    </p:case>
                </p:switch>
            </p:loop>

        </c:create-config>
    </a:view-config>
</a:screen>