        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq){

            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','F_EXTERNAL_PROGRAM');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan','F_CREDIT_PROGRAM');

            debugger
            //根据是否授信动态展示报价方案与授信方案
            var credit_flag = '${/parameter/@credit_flag}';
            if(credit_flag == 'Y'){
                //隐藏报价方案组件
                $jq('#${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").next().hide();



                $jq('#${/parameter/@layout_code}_G_QUOTATION_component_id').hide();
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_QUOTATION_component_id"]').hide();//隐藏客户信息左边的定位树的标题
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_QUOTATION_component_id"]').prev().hide();//隐藏客户信息左边的定位树的标题
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_QUOTATION_component_id"]').next().hide();//隐藏客户信息左边的定位树的标题

                $jq('#${/parameter/@layout_code}_F_AUDIT_ADJUST_component_id').hide();
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_AUDIT_ADJUST_component_id"]').hide();//隐藏客户信息左边的定位树的标题
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_AUDIT_ADJUST_component_id"]').prev().hide();//隐藏客户信息左边的定位树的标题
                $jq('[name = "PROJECT_MODIFY_FINANCE_LEASE_AUDIT_AUDIT_ADJUST_component_id"]').next().hide();//隐藏客户信息左边的定位树的标题
            }else{
                //隐藏授信方案组件
                $jq('#${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").next().hide();
            }
            if(credit_flag == 'Y' && ds.id == quote_ds_id){
                //取消报价方案必填校验
                debugger
                record.getField('lease_item_amount').setRequired(false);
                record.getField('renting_method').setRequired(false);
                record.getField('renting_method_n').setRequired(false);
                record.getField('irr').setRequired(false);
                record.getField('int_rate').setRequired(false);
                record.getField('lease_term').setRequired(false);
                record.getField('lease_term_m').setRequired(false);
                record.getField('residual_value').setRequired(false);
            }
            if(credit_flag == 'N' && ds.id == credit_ds_id) {
                //取消授信方案必填校验
                record.getField('credit_amt').setRequired(false);
                record.getField('quota_type').setRequired(false);
                record.getField('quota_type_n').setRequired(false);
                record.getField('conglomerate_flag').setRequired(false);
                record.getField('conglomerate_flag_n').setRequired(false);
                record.getField('belong_conglomerate').setRequired(false);
                record.getField('date_from').setRequired(false);
                record.getField('date_to').setRequired(false);
                record.getField('credit_desc').setRequired(false);
            }
            //授信项目类型得单据业务类型/业务板块/行业分类只读
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance','F_PRJ_BASIC');
            if(credit_flag == 'Y' && ds.id == base_ds_id){
                record.getField('industry').setReadOnly(true);
                record.getField('industry').setRequired(false);
                record.getField('business_type').setReadOnly(true);
                record.getField('business_type').setRequired(false);
                record.getField('industry_type').setReadOnly(true);
                record.getField('industry_type').setRequired(false);
                record.getField('industry_n').setReadOnly(true);
                record.getField('industry_n').setRequired(false);
                record.getField('business_type_n').setReadOnly(true);
                record.getField('business_type_n').setRequired(false);
                record.getField('industry_type_n').setReadOnly(true);
                record.getField('industry_type_n').setRequired(false);
            }

        };

        window['${/parameter/@layout_code}_calc_int_rate'] = function () {

            var prj_quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(prj_quotation_ds).getCurrentRecord();
            var floating_way_rate = quotation_record.get('floating_way_rate');
            var base_rate = quotation_record.get('base_rate');
            if (floating_way_rate != null && base_rate != null) {
                //年利率=基准利率+利率浮动制（bp）*0.01%
                quotation_record.set('int_rate', plus(base_rate, div(floating_way_rate, 10000)));
            }
            if (floating_way_rate == null && base_rate != null) {
                //年利率=基准利率+利率浮动制（bp）*0.01%
                quotation_record.set('int_rate', base_rate);
            }
        };


        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (document_type, business_type, employee_code) {

            Leaf.request({
                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };

