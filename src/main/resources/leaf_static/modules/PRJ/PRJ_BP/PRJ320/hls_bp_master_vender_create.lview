        //设置权限字符串
        function set_authority_rule_string() {
            Leaf.request({
                url: "${/request/@context_path}/hls/bp/master/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var bp_master_role = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            if (bp_master_role == ds.id && record.get('bp_category') == null) {
                record.set('bp_category', ' ');

            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            if (ds_id == ds.id) {
                $(ds_id).getCurrentRecord().set('country_id_n', '中国');
                $(ds_id).getCurrentRecord().set('country_id', '46');
            }

            var band_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            if (ds.id == band_ds) {
                record.set('currency', 'CNY');
                record.set('currency_n', '人民币');
            }
            var attachment_id=get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'bp_master_attachment');
            if(attachment_id == ds.id){
                record.set('bp_attachment_category', 'LON_CONTRACT');
            }
        };

