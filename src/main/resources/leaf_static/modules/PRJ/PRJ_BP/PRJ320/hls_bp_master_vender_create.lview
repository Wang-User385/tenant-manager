<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="hls_bp_master_vender_en_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ320/hls_bp_master_vender_modify_en.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}_on_layout_dynamic_grid_beforecreate'] = function (ds, record, config_records, bp_seq) {
            var parentRecord = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master')).getAt(0);
            if (parentRecord.get('bp_id')) {
                return true;
            } else {
                Leaf.showMessage("提示", "请先保存商业伙伴基本信息!", null);
                return false;
            }
        };

        function prj_check_bp_id(record) {
            var bp_id;
            if (record) {
                bp_id = record.get('bp_id');
            }
            if (!bp_id) {
                Leaf.showMessage('${l:PROMPT}', '${l:界面存在数据更新,请先保存!}');
                bp_id = '';
            }
            return bp_id;
        }

        Leaf.onReady(function () {

            debugger
            //控制主角色不能删除
            $('${/parameter/@layout_code}_G_ROLE_hls_bp_master_role_ds').on('beforeremove', function (ds, records) {
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('primary_flag') == 'Y') {
                        Leaf.showMessage("提示", "主角色无法删除!", null);
                        return false;
                    }
                }
            });

            if ($("${/parameter/@layout_code}_G_ADD_hls_bp_master_address_layout_grid_id")) {
                $("${/parameter/@layout_code}_G_ADD_hls_bp_master_address_layout_grid_id").on("cellclick", function (grid, row, name, record) {
                    if (name = 'country_id_n') {
                        if (record.get('country_id') != '46') {
                            record.getField("province_id_n").setReadOnly(true);
                            record.getField("city_id_n").setReadOnly(true);
                            record.getField("district_id_n").setReadOnly(true);
                        } else if (record.get('country_id') == '46') {
                            record.getField("province_id_n").setReadOnly(false);
                            record.getField("city_id_n").setReadOnly(false);
                            record.getField("district_id_n").setReadOnly(false);
                            record.getField("province_id_n").setRequired(true);
                            record.getField("city_id_n").setRequired(true);
                            /*record.getField("district_id_n").setRequired(true);*/
                        }
                    }

                });
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var bp_master_role_ds = $(ds_id);
            var record = new Leaf.Record({
                'primary_flag': 'Y',
                'bp_category': '${/parameter/@bp_category}',
                'bp_category_n': '${/parameter/@bp_category_n}',
                'bp_type': '${/parameter/@bp_type}',
                'bp_type_n': '${/parameter/@bp_type_n}',
                'enabled_flag': 'Y'
            });
            bp_master_role_ds.add(record);
            record.getField('bp_category_n').setReadOnly(true);
            record.getField('bp_type_n').setReadOnly(true);
            record.getField('enabled_flag').setReadOnly(true);
        });

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            if ('${/parameter/@function_usage}' != 'QUERY') {
                if (ds_id == ds.id) {
                    if (record.get('ref_v01') == 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else if (record.get('ref_v01') == 'N') {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                }
            }
            // if (record.get('bp_category') == 'DEALER') {
            //     record.getField('extra_nam').setRequired(true);
            // }

            var bp_name = '${/parameter/@bp_name}';
            $(ds_id).getCurrentRecord().set('nationality_n', '中国');
            $(ds_id).getCurrentRecord().set('nationality', '46');
            $(ds_id).getCurrentRecord().set('bp_name', bp_name);
            $(ds_id).getCurrentRecord().set('bp_category_n','${/parameter/@bp_category_n}');
            $(ds_id).getCurrentRecord().set('bp_class', '${/parameter/@bp_class}');
            $(ds_id).getCurrentRecord().set('bp_class_n', '${/parameter/@bp_class_n}');
            // if (ds_id === ds.id && '${/parameter/@bp_category}' == 'VENDER') {
            //     $(ds_id).getCurrentRecord().getField('extra_nam').setRequired(true);
            // }

            // $("${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds")
            // var interestCalcMonthDs = $('${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds');
            // interestCalcMonthDs.setQueryParameter('column_name', 'certtype');
            // interestCalcMonthDs.setQueryParameter('tab_code', 'G_SHAREHOLDER');
            // interestCalcMonthDs.setQueryParameter('layout_code', 'PRJ306F1');
            // interestCalcMonthDs.query();

        };

        var is_regno_valid = true;
        var bp_name_valid = true;
        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //登记注册号码校验
            var orgbase_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgbase');
            var hbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var hbmr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');
            /* if(orgbase_ds!=null && orgbase_ds!="") {
                 var regno = $(orgbase_ds).getCurrentRecord().get('regno');
                 var regnotype  = $(orgbase_ds).getCurrentRecord().get('regnotype');
                 if (regno.length != 15 && regno.length != 18) {
                     if((regnotype == '01' || regnotype == '07') && '${/parameter/@bp_class}' == 'ORG'){
                         Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码为15位或18位！");
                         return false;
                     }
                 }
             }*/

            var hbm_record = $(hbm_ds_id).getCurrentRecord();
            var regno = hbm_record.get('regno');
            if (hbm_ds_id == ds.id && regno && regno != '') {
                var regnotype = hbm_record.get('regnotype');
                if (regno.length != 15 && regno.length != 18) {
                    if ((regnotype == '01' || regnotype == '07') && '${/parameter/@bp_class}' == 'ORG') {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码为15位或18位！");
                        return false;
                    }
                }
            }

            // if (!is_regno_valid) {
            //     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码重复！");
            //     return false;
            // }
            //
            // if (!bp_name_valid) {
            //     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     Leaf.showMessage('${l:PROMPT_MESSAGE}', "商业伙伴名称重复！");
            //     return false;
            // }
            //
            // if (!zipcode_flag) {
            //     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     Leaf.showMessage('${l:PROMPT_MESSAGE}', "地址信息邮编应为6位！");
            //     return false;
            // }


            var check_flag = true;

            //往hls_bp_master 存主角色的bp_category 和 bp_type

            $(hbmr_ds_id).getAll().forEach(function (item) {
                if (item.get('primary_flag') == 'Y') {
                    $(hbm_ds_id).getCurrentRecord().set('bp_category', item.get('bp_category'));
                    $(hbm_ds_id).getCurrentRecord().set('bp_type', item.get('bp_type'));
                }
            });

            //身份证校验
            if (record.get('bp_class') == 'NP' && record.get('id_type') == 'ID_CARD') {
                var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                if (reg.test(record.get('id_card_no')) === false) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "证件号码格式错误!", null);
                    return false;
                }
            }

            if (hbm_record.get('bp_type') === 'VENDER') {
                var relation_records = $(relation_ds_id).getAll();
                var relation_validate = 0;
                var relation_manufaction_id = null;
                for (var i = 0; i < relation_records.length; i++) {
                    if (relation_records[i].get('relation_type') === 'MANUFACTURER') {
                        if (relation_manufaction_id == null) {
                            relation_manufaction_id = relation_records[i].get('related_bp_id');
                            relation_validate++;
                        } else {
                            if (relation_manufaction_id != relation_records[i].get('related_bp_id')) {
                                relation_validate++;
                            }
                        }
                    }
                }

                if (relation_validate > 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "一个主机厂仅能维护一个归属厂商信息!", null);
                    return false;
                }
            }

            var bank_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            var bank_records = $(bank_ds).getAll();
            if (bank_records.length > 0) {
                var primary_bank_num = 0;
                for (var i = 0; i < bank_records.length; i++) {
                    if (bank_records[i].get('primary_flag') == 'Y') {
                        primary_bank_num++;
                    }
                }

                // if (primary_bank_num != 1) {
                //     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                //     Leaf.showMessage("提示", "必须且只能存在一条主银行账户!", null);
                //     return false;
                // }
            }

            var agreement_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_agreement');
            if(agreement_ds != null && agreement_ds != ''){
                var agreement_records = $(agreement_ds).getAll();
                if(agreement_records.length > 0){
                    var enabled_num = 0;
                    for(var i = 0;i < agreement_records.length;i++){
                        var agreement_record = agreement_records[i];
                        if(agreement_record.get('enabled_flag') == 'Y'){
                            enabled_num++;
                        }
                    }
                    if(enabled_num > 1){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage("提示", "只能有一条启用的框架协议!", null);
                        return false;
                    }
                }
            }


            set_authority_rule_string();

            if (record.get('bp_code')) {
                return true;
            }
            var documenCategory = 'HLS_BP_MASTER';
            var documentType = record.get('bp_class');
            var businessType = record.get('bp_class');
            Leaf.request({
                url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + documenCategory + "&documentType=" + documentType + "&businessType=" + businessType,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                    $(ds_id).getCurrentRecord().set('bp_code', res.result.record[0]);
                    check_flag = true;
                },
                error: function (res) {
                    record.set('bp_code', res.result.record[0]);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    record.set('bp_code', res.result.record[0]);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });
            return check_flag;
        };

        // //财务报表模板导入
        // window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
        //     var record = $(ds_id).getCurrentRecord();
        //     var bp_id = prj_check_bp_id(record);
        //     var bp_name = record.data['bp_name'];
        //     var bp_code = record.data['bp_code']
        //     bp_id = prj_check_bp_id(record);
        //     if (!bp_id) {
        //         return;
        //     }
        //     new Leaf.Window({
        //         id: 'hls_bp_master_financial_import_winid',
        //         url: '${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_financial_import.lview',
        //         params: {
        //             bp_id: bp_id,
        //             bp_master_code: bp_code,
        //             bp_master_name: bp_name,
        //             winid: 'hls_bp_master_financial_import_winid'
        //         },
        //         title: '财务报表导入',
        //         fullScreen: false,
        //         width: 500,
        //         draggable: true
        //     });
        // };
        //
        // //财务报表模板查看
        // window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
        //     var record = $(ds_id).getCurrentRecord();
        //     var bp_id = prj_check_bp_id(record);
        //     var bp_name = record.data['bp_name'];
        //     var bp_code = record.data['bp_code']
        //
        //     if (!bp_id) {
        //         return;
        //     }
        //     new Leaf.Window({
        //         id: 'hls_bp_master_financial_info_winid',
        //         url: '${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_financial_info.lview',
        //         params: {
        //             bp_id: bp_id,
        //             bp_master_code: bp_code,
        //             bp_master_name: bp_name,
        //             winid: 'hls_bp_master_financial_info_winid'
        //         },
        //         title: '财务报表查看',
        //         fullScreen: false,
        //         width: 830,
        //         height: 535,
        //         side: "right",
        //         draggable: true
        //     });
        // };

        var zipcode_flag = true;

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var role_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var bp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var ds_bp_address = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var orgbase_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgbase');
            if ('${/parameter/@function_usage}' != 'QUERY') {
                if (bp_ds == ds.id) {
                    if (record.get('ref_v01') == 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else if (record.get('ref_v01') == 'N') {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                }
            }


            // //股东
            // var ds_bp_sh = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_shareholder');
            // if (ds_bp_sh == ds.id && value) {
            //     if (name == 'stockholdertype') {
            //         record.set('certtype', '');
            //         record.set('certtype_n', '');
            //     }
            //     var stockholdertype = record.get('stockholdertype');
            //     var certtype_ds = $("${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds");
            //     certtype_ds.originData = certtype_ds.originData || certtype_ds.data;
            //     if (stockholdertype == '1') {
            //         certtype_ds.filterData = certtype_ds.originData.filter(function (record) {
            //             return record.data.value_code == "10" || record.data.value_code == "11"
            //         });
            //         record.getField("orgcode").setReadOnly(true);
            //         record.getField("orgcreditcode").setReadOnly(true);
            //     } else {
            //         certtype_ds.filterData = certtype_ds.originData.filter(function (record) {
            //             return record.data.value_code != "10" && record.data.value_code != "11"
            //         });
            //         record.getField("orgcode").setReadOnly(false);
            //         record.getField("orgcreditcode").setReadOnly(false);
            //     }
            //     certtype_ds.addListener('beforeload', function () {
            //         this.originData = this.originData || this.data;
            //         this.data = this.filterData || this.data;
            //     });
            // }

            if (ds_bp_address == ds.id && value) {
                if (name == 'country_id' && value != '46') {
                    record.set('province_id', null);
                    record.set('city_id', null);
                    record.set('district_id', null);
                    record.set('province_id_n', null);
                    record.set('city_id_n', null);
                    record.set('district_id_n', null);
                    record.getField('province_id').setReadOnly(true);
                    record.getField('province_id').setRequired(false);
                    record.getField('city_id').setReadOnly(true);
                    record.getField('city_id').setRequired(false);
                    record.getField('district_id').setReadOnly(true);
                    record.getField('district_id').setRequired(false);
                    record.getField('province_id_n').setReadOnly(true);
                    record.getField('province_id_n').setRequired(false);
                    record.getField('city_id_n').setReadOnly(true);
                    record.getField('city_id_n').setRequired(false);
                    record.getField('district_id_n').setReadOnly(true);
                    record.getField('district_id_n').setRequired(false);
                } else if (name == 'country_id' && value == '46') {
                    record.getField('province_id').setReadOnly(false);
                    record.getField('province_id').setRequired(true);
                    record.getField('city_id').setReadOnly(false);
                    record.getField('city_id').setRequired(true);
                    record.getField('district_id').setReadOnly(false);
                    /*record.getField('district_id').setRequired(true);*/
                    record.getField('province_id_n').setReadOnly(false);
                    record.getField('province_id_n').setRequired(true);
                    record.getField('city_id_n').setReadOnly(false);
                    record.getField('city_id_n').setRequired(true);
                    record.getField('district_id_n').setReadOnly(false);
                    /*record.getField('district_id_n').setRequired(true);*/
                } else if (name == 'zipcode') {
                    if (value.length != 6) {
                        zipcode_flag = false;
                        Leaf.showMessage("提示", "地址信息邮编应为6位!", null);
                    } else {
                        zipcode_flag = true;
                    }
                }
            }
            if (bp_ds == ds.id && value) {
                if (name === 'regno') {
                    $(orgbase_ds).getCurrentRecord().set('regno', value);
                    var bp_id = -1;
                    var reg_number = null;
                    var parent_ds = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds');
                    if (parent_ds.getCurrentRecord().get('bp_class') == "NP") {
                        is_regno_valid = true;
                        return;
                    }
                    reg_number = $('${/parameter/@layout_code}_F_CREDIT_INFORMATION_zx_bp_orgbase_ds').getCurrentRecord().get('regno');
                    if (!reg_number) {
                        is_regno_valid = true;
                        return;
                    }
                    if (parent_ds.getCurrentRecord().get('bp_id')) {
                        bp_id = parent_ds.getCurrentRecord().get('bp_id');
                    }
                    jQuery.ajax({
                        type: 'GET',
                        url: "${/request/@context_path}/hls/bp/master/validRegNumber?bpId=" + bp_id + "&regNumber=" + reg_number,
                        async: false,
                        success: function (args) {
                            if (!args.success) {
                                is_regno_valid = false;
                            } else {
                                is_regno_valid = true;
                            }
                        }
                    });
                }
                if (name === 'regnotype') {
                    $(orgbase_ds).getCurrentRecord().set('regnotype', value);
                }
                if (name === 'regnotype_n') {
                    $(orgbase_ds).getCurrentRecord().set('regnotype_n', value);
                }
                if (name == 'ref_v01' && value == 'N') {
                    record.set('loan_card_num', '');
                }

                if (name === 'bp_name') {
                    var bp_id = -1;
                    var bp_record = $(bp_ds).getCurrentRecord();
                    var bp_name = bp_record.get('bp_name');
                    if (!bp_name) {
                        bp_name_valid = true;
                        return;
                    }
                    if (bp_record.get('bp_id')) {
                        bp_id = bp_record.get('bp_id');
                    }
                    jQuery.ajax({
                        type: 'GET',
                        url: "${/request/@context_path}/hls/bp/master/validBpName?bpId=" + bp_id + "&bpName=" + bp_name,
                        async: false,
                        success: function (args) {
                            if (!args.success) {
                                bp_name_valid = false;
                            } else {
                                bp_name_valid = true;
                            }
                        }
                    });
                }
                //add by 20190528 商业伙伴自然人身份证信息带出
                if ('${/parameter/@bp_class}' == 'NP') {
                    var ds_bp_info_record = $(bp_ds).getCurrentRecord();
                    var id_type = ds_bp_info_record.get('id_type');
                    var id_card_no = ds_bp_info_record.get('id_card_no');
                    if (!!id_card_no && !id_type && (name == "id_type" || name == "id_card_no")) {
                        Leaf.SideBar.show({
                            type: 'warning',
                            msg: '请先选择证件类型',
                            duration: 2000
                        });
                    } else if (id_type == 'ID_CARD' && (name == "id_type" || name == "id_card_no")) {
                        //校验身份证号码
                        var id_card_no = window['${/parameter/@layout_code}_checkIdNo'](ds_bp_info_record.get('id_card_no') || '');
                        if (id_card_no) {
                            var birthStr = id_card_no.substr(6, 8);
                            if (id_card_no.length == 15) {
                                var gender = (id_card_no.substr(14, 1) % 2 == 0) ? "FEMALE" : "MALE";
                                var gender_n = (id_card_no.substr(14, 1) % 2 == 0) ? "女" : "男";
                            } else if (id_card_no.length == 18) {
                                var gender = (id_card_no.substr(16, 1) % 2 == 0) ? "FEMALE" : "MALE";
                                var gender_n = (id_card_no.substr(16, 1) % 2 == 0) ? "女" : "男";
                            }
                            var birthDate = new Date(birthStr.substr(0, 4), birthStr.substr(4, 2) - 1, birthStr.substr(6, 2));
                            var age = new Date().getFullYear() - birthStr.substr(0, 4);
                            record.set('date_of_birth', birthDate);
                            record.set('gender', gender);
                            record.set('gender_n', gender_n);
                            record.set('age', age);
                        } else {
                            record.set('date_of_birth', '');
                            record.set('gender', '');
                            record.set('gender_n', '');
                            record.set('age', '');
                        }
                    }
                }
                if (name == 'ref_v03') {
                    if (value == 'Y') {
                        record.getField('ref_v05').setReadOnly(false);
                        record.getField('ref_v05_n').setReadOnly(false);
                    } else {
                        record.set('ref_v05', null);
                        record.set('ref_v05_n', null);
                        record.getField('ref_v05').setReadOnly(true);
                        record.getField('ref_v05_n').setReadOnly(true);
                    }


