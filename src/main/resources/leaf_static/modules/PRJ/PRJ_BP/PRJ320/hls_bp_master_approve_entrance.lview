<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body{
                height:400px;
                width:1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="hls_bp_master_approve_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ320/hls_bp_master_vender_modify.lview"/>
        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;
        var bpId = param.filter(function (o) {
            return o.name == "bpId";
        })[0].value;
        debugger
        var function_code = 'PRJ320_LS_F1';
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-WkmLSIar-JkoH-4P1z-8KKI-dqDXYSNuR4ZO"  ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
        }
        var pageChooser = new PageChooser({
            url: $('hls_bp_master_approve_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                bp_id: bpId,
                source_id: businessKey,
                maintain_type: maintain_type,
                function_usage: function_usage,
                function_code: function_code,
                hidden_button_code: ['SUBMIT_APPROVAL', 'EXIT']
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    