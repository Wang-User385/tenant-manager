<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="prj351_create_attach_link" url="${/request/@context_path}/elec-verify/create/attachment"/>
        <a:link id="prj351_create_verify" url="${/request/@context_path}/elec-verify/create/record"/>

        <script><![CDATA[

        //手机号格式校验
        function check_phone(value,name){
            if(value === null || value === undefined || value ===''){
                return false;
            }
            var isPhone = /^([0-9]{3,4}-)?[0-9]{7,8}$/;//手机号码
            var isMob= /^0?1[3|4|5|8][0-9]\d{8}$/;// 座机格式
            if(name === 'phone_number'){
                return value!=null&&value!==""?isMob.test(value)||isPhone.test(value):false;
            }else if(name === 'receive_phone_number'){
               return (value!=null&&value!=="")?isMob.test(value)||isPhone.test(value):true;
            }

        }

        //身份证合法性校验
        function check_id_card_no(str,name){
            if(str === null || str === undefined || str ===''){
                return false;
            }
            if(name === 'id_number'){
                num = str.toUpperCase();
                //身份证号码为15位或者18位，15位时全为数字，18位前17位为数字，最后一位是校验位，可能为数字或字符X。
                if (!(/(^\d{15}$)|(^\d{17}([0-9]|X)$)/.test(num))) {
                    return false;
                }
                var len, re;
                len = num.length;
                if (len === 15) {
                    re = new RegExp(/^(\d{6})(\d{2})(\d{2})(\d{2})(\d{3})$/);
                    var arrSplit = num.match(re);
                    //检查生日日期是否正确
                    var dtmBirth = new Date('19' + arrSplit[2] + '/' + arrSplit[3] + '/' + arrSplit[4]);
                    var bGoodDay;
                    bGoodDay = (dtmBirth.getYear() == Number(arrSplit[2]))
                        && ((dtmBirth.getMonth() + 1) == Number(arrSplit[3]))
                        && (dtmBirth.getDate() == Number(arrSplit[4]));
                    if (!bGoodDay) {
                        return false;
                    } else {
                        //将15位身份证转成18位
                        //校验位按照ISO 7064:1983.MOD 11-2的规定生成，X可以认为是数字10。
                        var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
                        var arrCh = new Array('1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2');
                        var nTemp = 0, i;
                        num = num.substr(0, 6) + '19' + num.substr(6, num.length - 6);
                        for (i = 0; i < 17; i++) {
                            nTemp += num.substr(i, 1) * arrInt[i];
                        }
                        num += arrCh[nTemp % 11];
                        return true;
                    }
                }
                if (len === 18) {
                    re = new RegExp(/^(\d{6})(\d{4})(\d{2})(\d{2})(\d{3})([0-9]|X)$/);
                    var arrSplit = num.match(re);
                    //检查生日日期是否正确
                    var dtmBirth = new Date(arrSplit[2] + "/" + arrSplit[3] + "/" + arrSplit[4]);
                    var bGoodDay;
                    bGoodDay = (dtmBirth.getFullYear() == Number(arrSplit[2]))
                        && ((dtmBirth.getMonth() + 1) == Number(arrSplit[3]))
                        && (dtmBirth.getDate() == Number(arrSplit[4]));
                    return bGoodDay;
                    // if (!bGoodDay) {
                    //     return false;
                    // } else {
                    //     //检验18位身份证的校验码是否正确。
                    //     //校验位按照ISO 7064:1983.MOD 11-2的规定生成，X可以认为是数字10。
                    //     var valnum;
                    //     var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
                    //     var arrCh = new Array('1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2');
                    //     var nTemp = 0, i;
                    //     for (i = 0; i < 17; i++) {
                    //         nTemp += num.substr(i, 1) * arrInt[i];
                    //     }
                    //     valnum = arrCh[nTemp % 11];
                    //     if (valnum != num.substr(17, 1)) {
                    //         return false;
                    //     }
                    //     return true;
                    // }
                }
                return false;
            }
        }

        //加载时调用(grid,table,gridBox),判断字段只读
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_sign_verify');
            if(ds.id === ds_id){
                if(record){
                    if(record.get('sign_check_status') === 'Y'||record.get('sign_check_status') === 'U'){
                        record.getField('receive_phone_number').setReadOnly(true);
                        record.getField('person_name').setReadOnly(true);
                        record.getField('phone_number').setReadOnly(true);
                        record.getField('id_number').setReadOnly(true);
                        record.getField('sign_enabled_flag').setReadOnly(true);
                    }else{
                        record.getField('receive_phone_number').setReadOnly(false);
                        record.getField('person_name').setReadOnly(false);
                        record.getField('phone_number').setReadOnly(false);
                        record.getField('id_number').setReadOnly(false);
                        record.getField('sign_enabled_flag').setReadOnly(false);
                        record.getField('receive_phone_number').setRequired(true);
                        record.getField('person_name').setRequired(true);
                        record.getField('phone_number').setRequired(true);
                        record.getField('id_number').setRequired(true);
                        record.getField('sign_enabled_flag').setRequired(true);
                    }
                }
            }
        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name === 'bp_code' && value) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }

            if (name === 'attach_link') {
                return '<a href="javascript:open_attach(\'' + record.get('bp_attachment_id')+ '\',\'' + record.get('bp_id') + '\',\'' + record.get('sign_check_status') + '\')">' + '审核材料' + '</a>';
            }

            return value;
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户信息查看';
            if(param['bp_type']==='MANUFACTURER'){
                param['function_code'] = 'BP100F4'
            }else{
                if (param['bp_class'] === 'ORG') {
                    if(param['bp_type']==='VENDER' || param['bp_type']==='DEALER'){
                        param['function_code'] = 'PRJ320_LS_F1';
                    }else{
                        param['function_code'] = 'BP100F1';}
                } else {
                    param['function_code'] = 'BP100F2';
                }
            }
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';

            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
        }


        function open_attach(bp_attachment_id,bp_id,sign_check_status) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_sign_verify');
            var url = (sign_check_status=== 'Y'||sign_check_status === 'U')
                ?'${/request/@context_path}/downloadFile.lview' : '${/request/@context_path}/uploadFile.lview';
            if(bp_attachment_id === 'undefined' || bp_attachment_id === ''){
                var para = {bp_id: bp_id};
                Leaf.request({
                    url: $('prj351_create_attach_link').getUrl(),
                    scope: this,
                    para: para,
                    success: function (res) {
                        bp_attachment_id = res.result.record[0].bp_attachment_id;
                        var win = new Leaf.Window({
                            id: 'prj351_open_attachment_winid',
                            url: url,
                            params: {
                                'header_id': bp_attachment_id,
                                'table_name': 'HLS_BP_ATTACHMENT',
                                function_usage: 'QUERY'
                            },
                            title: '文件上传下载',
                            width: 800,
                            height: 475
                        });
                        win.on('close', function () {
                            $(ds_id).query();
                        });
                    },
                    failure: function () {
                        Leaf.showMessage('错误', '生成商业伙伴附件记录失败，请联系系统管理员！');
                    },
                    error: function () {
                        Leaf.showMessage('错误', '生成商业伙伴附件记录失败，请联系系统管理员！');
                    }
                });
            }else{
                var win = new Leaf.Window({
                    id: 'prj351_open_attachment_winid',
                    url: url,
                    params: {
                        'header_id': bp_attachment_id,
                        'table_name': 'HLS_BP_ATTACHMENT',
                        function_usage: 'QUERY'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }
        }

        //保存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_sign_verify');
            var records = $(ds_id).getAll();
            Leaf.Masker.mask(Ext.getBody(), '执行中。。');
            var i = 0;
            for(i = 0;i < records.length;i++){
                if(records[i].modified){
                    if (!check_id_card_no(records[i].get('id_number'),'id_number')) {
                        debugger;
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人身份证号码！");
                        Leaf.Masker.unmask(Ext.getBody());
                        return;
                    }
                    if (!check_phone(records[i].get('phone_number'),'phone_number')) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人签约手机号码！");
                        Leaf.Masker.unmask(Ext.getBody());
                        return;
                    }
                    if (!check_phone(records[i].get('receive_phone_number'),'receive_phone_number')) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人签约手机号码！");
                        Leaf.Masker.unmask(Ext.getBody());
                        return;
                    }
                }
            }
            for(i = 0;i < records.length;i++){
                if(records[i].modified){
                    var para = records[i].data;
                    Leaf.request({
                        url: $('prj351_create_verify').getUrl(),
                        scope: this,
                        para: para,
                        sync:true,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '保存成功',
                                duration: 2000
                            });
                            $(ds_id).query();
                        }
                    });
                }
            }
            Leaf.Masker.unmask(Ext.getBody());
        };

        //提交复核
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_sign_verify');
            var records = $(ds_id).getSelected();
            if(records.length === 0){
                Leaf.showMessage('错误', '请至少勾选一条记录！');
                return;
            }
            Leaf.Masker.mask(Ext.getBody(), '执行中。。');
            for(var i = 0;i < records.length;i++){
                if (!check_id_card_no(records[i].get('id_number'),'id_number')) {
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人身份证号码！");
                    Leaf.Masker.unmask(Ext.getBody());
                    return;
                }
                if (!check_phone(records[i].get('phone_number'),'phone_number')) {
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人签约手机号码！");
                    Leaf.Masker.unmask(Ext.getBody());
                    return;
                }
                if (!check_phone(records[i].get('receive_phone_number'),'receive_phone_number')) {
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "请输入正确的法人签约手机号码！");
                    Leaf.Masker.unmask(Ext.getBody());
                    return;
                }
                if(records[i].get('verify_id')===''||records[i].get('verify_id')===null||records[i].get('verify_id')===undefined){
                    Leaf.showMessage('错误', '开户信息不完整！');
                    Leaf.Masker.unmask(Ext.getBody());
                    return;
                }else{
                    if(records[i].get('sign_check_status')==='Y'||records[i].get('sign_check_status')==='U'){
                        Leaf.showMessage('错误', '不可重复提交复核！');
                        Leaf.Masker.unmask(Ext.getBody());
                        return;
                    }else{
                        if(records[i].get('receive_phone_number')&&records[i].get('person_name')&&records[i].get('phone_number')&&records[i].get('id_number')){
                            records[i].set('sign_check_status','U');
                            records[i].set('sign_check_status_n','复核中');
                            records[i].set('operate_user_id','${/session/@user_id}');
                            var para = records[i].data;
                            Leaf.request({
                                url: $('prj351_create_verify').getUrl(),
                                scope: this,
                                para: para,
                                sync:true,
                            });
                        }else{
                            Leaf.showMessage('错误', '开户信息不完整！');
                            Leaf.Masker.unmask(Ext.getBody());
                            return;
                        }
                    }
                }
            }
            Leaf.SideBar.show({
                msg: '操作成功',
                duration: 2000
            });
            Leaf.Masker.unmask(Ext.getBody());
            $(ds_id).query();
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
