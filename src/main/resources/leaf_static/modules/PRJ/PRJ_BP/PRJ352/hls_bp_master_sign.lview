<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="PRJ419f31_project_doc_winid_link_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419F3/prj_project_doc_create.lview"/>
        <a:link id="prj352_sign_link" url="${/request/@context_path}/elec-verify/sign"/>
        <a:link id="prj352_query_sign_link" url="${/request/@context_path}/elec-verify/query-sign"/>
        <a:link id="PRJ419_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify.lview"/>
        <script><![CDATA[


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name === 'attach') {
                return '<a href="javascript:prj352_open_attach(\'' + record.get('project_id') + '\')">' + '附件查看' + '</a>';
            }
            if (name === 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            debugger
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '项目明细';
            param['function_usage'] = 'QUERY';
            param['lease_channel']= '10';
            //厂商租赁
            // if(record.get('lease_channel') === '10'){
            //直接租赁
            if (param['document_type'] === 'PRJL') {
                param['function_code'] = 'PRJ419F2';
            }
            //售后回租
            if (param['document_type'] === 'PRJLB') {
                param['function_code'] = 'PRJ419F2';
            }
            //汽车租赁
            // }else if(record.get('lease_channel') === '20'){
            //     param['function_code'] = 'PRJ419F4';
            // } else if (record.get('lease_channel') === '40') {
            //     param['function_code'] = 'PRJ419F20';
            // }

            param['winid'] = 'project_modify_winid';
            var project_status = record.get('project_status');
            // var division = record.get('division');
            // if (division === 'PHOTOVOLTAIC_DEVICES') {
            //     param['parent_layout_code'] = 'PRJ419';
            // }
            //审批中、退回
            if (project_status === 'APPROVING' || project_status === 'APPROVED_RETURN') {
                param['maintain_type'] = 'READONLY';
                param['submit_hide'] = true;
            }

            //厂商租赁、直租/回租
            // if(record.get('lease_channel') === '10' && (param['document_type'] === 'PRJL' ||param['document_type'] === 'PRJLB')){
            //     hls_doc_get_layout_code(param, 'PRJ419_project_modify_id', ds_id, 'PRJ419');
            // } else if(record.get('lease_channel') === '40') {
            //     param['function_usage'] = '';
            //     hls_doc_get_layout_code(param, 'PRJ419_project_modify_ol_id', ds_id, 'PRJ419');
            // }else{
            hls_doc_get_layout_code(param, 'PRJ419_project_modify_id', ds_id, 'PRJ419');
            // }


        }

        //签约附件
        function prj352_open_attach(project_id) {

            var prj_project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(prj_project_ds_id).getCurrentRecord();
            var projectAttachmentId = record.get('projectAttachmentId');
            var url = '${/request/@context_path}/downloadFile.lview';
            var function_usage = '${/parameter/@function_usage}';
            var table_name = 'ONLINE_SIGN_CONTRACT';
            win = new Leaf.Window({
                id: 'PRJ352_open_attachment_winid',
                url: url,
                params: {
                    'header_id': projectAttachmentId,
                    'table_name': table_name,
                    winid: 'PRJ352_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
        }

        //发起签约
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var records = $(ds_id).getSelected();
            if (records.length === 0) {
                Leaf.showMessage('错误', '请至少勾选一条记录！');
                return;
            }
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('org_sign_state') === 'Y') {
                    Leaf.showMessage('错误', records[i].get('project_number') + '已完成在线签约！');
                    return;
                }
                if (records[i].get('factory_id') === null || records[i].get('factory_id') === undefined || records[i].get('factory_id') === '') {
                    Leaf.showMessage('错误', '合同编号'+records[i].get('project_number') + '，主机厂或合作方未维护！');
                    return;
                }
                if (records[i].get('id_card_no') === null || records[i].get('id_card_no') === undefined || records[i].get('id_card_no') === '') {
                    Leaf.showMessage('错误', '合同编号'+records[i].get('project_number') + '，主机厂或合作方的法人证件号未维护！');
                    return;
                }
                if (records[i].get('phone') === null || records[i].get('phone') === undefined || records[i].get('phone') === '') {
                    Leaf.showMessage('错误', '合同编号'+records[i].get('project_number') + '，主机厂或合作方的法人手机号未维护！');
                    return;
                }
                if (records[i].get('signed_flag') === null || records[i].get('signed_flag') === undefined || records[i].get('signed_flag') === '') {
                    Leaf.showMessage('错误', '合同编号'+records[i].get('project_number') + '，承租人未完成签约！');
                    return;
                }
            }
            Leaf.Masker.mask(Ext.getBody(), '执行中。。');
            for (var j = 0; j < records.length; j++) {
                var para = records[j].data;
                para.userId = '${/session/@user_id}';
                Leaf.request({
                    url: $('prj352_sign_link').getUrl(),
                    scope: this,
                    para: para,
                    sync: true,
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        if (!res.success) {
                            Leaf.showMessage('错误', records[i].get('legal_name') + '发起签约失败，错误信息：' + res.message);
                        }
                        Leaf.SideBar.show({
                            msg: '操作成功',
                            duration: 2000
                        });
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('错误', '发起签约失败！');
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('错误', '发起签约失败！');
                    }
                });
            }
            // Leaf.Masker.unmask(Ext.getBody());
            $(ds_id).query();
        }

        //签约状态查询
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var records = $(ds_id).getSelected();
            var success_list;
            if(records.length !== 1){
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.showMessage('错误', '请勾选一条记录！');
                return;
            }
            var projectId = records[0].get("project_id");
            Leaf.Masker.mask(Ext.getBody(), '执行中。。');
            Leaf.request({
                url: $('prj352_query_sign_link').getUrl(),
                para: {
                    projectId: projectId,
                    userId:'${/session/@user_id}'
                },
                success: function (res) {
                    if(res.success){
                        var resultDesc = res.result.record[0].result_desc;
                        if(resultDesc){
                            Leaf.showMessage('查询结果','签约状态：' + res.result.record[0].result_desc);
                        }else{
                            Leaf.showMessage('错误', '未查询到签约信息!');
                        }
                        Leaf.Masker.unmask(Ext.getBody());
                    }else{
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('错误', res.message);
                    }
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.showMessage('错误', '签约状态查询失败！');
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.showMessage('错误', '签约状态查询失败！');
                },
                scope: this
            });
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
