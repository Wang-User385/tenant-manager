<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="VIRTUAL_ACCOUNT"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>

    <a:view>
        <a:link id="prj320_virtual_account_excel_import_link" url="${/request/@context_path}/hls/virtual/batch/excel/import"/>
        <script><![CDATA[


        function prj330f1_prj_excel_import_error_close(datas){
            parent.$L.Masker.unmask(parent.Ext.getBody());
            /*parent.$L.showConfirm("提示", datas.error.message,function(){
                prj330f1_prj_excel_import_close();
            });*/
            prj440f1_prj_excel_import_close();
        }

        function prj440f1_prj_excel_import_close(){
            parent.$("PRJ440_G_RESULT_hls_virtual_account_ds").query();
            parent._file_upload_window.close();

        }

        parent.Leaf.request({
            url: $('prj320_virtual_account_excel_import_link').getUrl() + "?headerId=${/model/header/record/@header_id}",
            para: {headerId:'${/model/header/record/@header_id}'},
            success: function (res) {
                parent.$L.Masker.unmask(parent.Ext.getBody());
                $L.Masker.unmask(Ext.getBody());
                parent.$L.showConfirm("提示", "导入成功",function(){
                    prj440f1_prj_excel_import_close();
                });

            },
            failure: function (datas) {
                prj330f1_prj_excel_import_error_close(datas);
            },
            error: function (datas) {
                prj330f1_prj_excel_import_error_close(datas);
            },
            scope: this
        });

        ]]></script>

        <a:screenBody>

        </a:screenBody>
    </a:view>
</a:screen>
