<?xml version="1.0" encoding="UTF-8"?>
<!--
@author zedong huang
@function 额度占用申请维护
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj314_credit_occupy_project_create_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_QUOTA/PRJ314/prj_project_create.lview"/>
        <a:link id="prj314_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_QUOTA/PRJ314/prj_project_modify.lview"/>
        <a:link id="prj314_chance_credit_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_chance_detail.lview"/>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            qpara['created_by'] = '${/session/@user_id}';
        };

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            //授信编号
            if (name == 'credit_line_number' && value) {
                return '<a href="javascript:open_credit_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            //项目编号
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_project_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            //查询项目商业伙伴信息
            if (record.get('project_id')) {
                var paramData = [];
                paramData.push(record.data);

                var param = record.data;
                var business_type = param.business_type;
                param['url_title'] = '额度占用申请明细';
                param['winid'] = 'project_modify_winid';
                param['amount_flag']='true';
                var project_status = record.get('project_status');
                if (project_status === 'NEW' || project_status === 'CANCEL' || project_status === 'APPROVED_RETURN' || project_status === 'SUSPEND') {
                    param['maintain_type'] = 'UPDATE';
                    param['function_usage'] = 'MODIFY';
                } else {
                    param['maintain_type'] = 'READONLY';
                    param['function_usage'] = 'QUERY';
                }
                param['function_code'] = 'PRJ314F1';
                hls_doc_get_layout_code(param, 'prj314_project_modify_id', ds_id, 'PRJ314');
            }
        }

        function open_credit_win(ds_id, record_id) {
            debugger
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var type = 'QUERY';
            param['url_title'] = '授信明细查询';
            param['function_code'] = 'PRJ003F1_CHANGE_BP';
            param['function_usage'] = type;
            param['winid'] = 'prj_chance_detail_winid';
            var link_id = 'prj314_chance_credit_detail_link_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ003', null, null);
        }

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var param = {};
            param['url_title'] = '额度占用创建';
            param['function_code'] = 'PRJ314F3';
            param['winid'] = 'project_create_winid';
            param['ds_id'] = ds_id;
            param['screen_width'] = '650';
            param['screen_height'] = '400';
            param['amount_flag']='true';
            hls_doc_get_layout_code(param, 'prj314_credit_occupy_project_create_id', ds_id, 'PRJ314');
        }

        //删除
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();
            var record = records[0];
            if (records.length != 1) {
                Leaf.showMessage('${l:PROMPT}', '${l:HLS.SELECT_RECORD}');
                return;
            } else if (record.get('project_status') !== 'NEW') {
                Leaf.showErrorMessage('提示', '只有新建项目才允许进行删除！');
            } else {
                Leaf.showConfirm('警告', '项目' + record.get('project_number') + '即将删除（<font color="red">注：项目删除即撤销该项目，将无法再进行任何其它操作，请谨慎！</font>）', function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    debugger;
                    Leaf.request({
                        url: '${/request/@context_path}/occupy/prj/project/delete',
                        para: {
                            project_id: record.get('project_id')
                        },

                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                });
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
