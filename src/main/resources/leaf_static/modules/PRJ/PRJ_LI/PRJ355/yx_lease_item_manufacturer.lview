<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="yx_lease_item_log_create_link" url="${/request/@context_path}/yx/lease/item/log/create"/>
        <script><![CDATA[
        var changeList = [];

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yx_lease_item_manufacturer');
            var records = $(ds_id).getAll();
            var changeInfo = "";
            for(var i=0;i<records.length;i++){
                if(records[i].dirty){
                    var modifiedJson  = records[i].modified;
                    var dataJson = records[i].data;
                    for(var k in modifiedJson){
                        changeInfo += k + "从" + modifiedJson[k] + "变更为" + dataJson[k] + ";\n";
                    }
                    records[i].data["changeInfo"] = changeInfo;
                    records[i].data["creation_date"] = records[i].data["create_date"];
                    records[i].data["created_by"] = records[i].data["create_user_id"];
                    changeList.push(records[i].data);
                    changeInfo = "";
                }
            }
            if(ds_id){
                if(records.length > 0){
                    var ids = [];
                    var ids2 = [];
                    for (var i = 0; i < records.length; i++) {
                        var record = records[i];
                        ids[i] = records[i].get('bp_id');
                        ids2[i] = records[i].get('manufacturer_name');
                    }
                    for (var i = 0; i < ids.length - 1; i++){
                        for(var j = i + 1;j < ids.length;j++){
                            if(ids[i] == ids[j]&&ids2[i] == ids2[j]){
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                Leaf.showMessage("提示", "记录重复！请检查！", null);
                                return false;
                            }
                        }
                    }
                }
            }

            return true;
        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'yx_lease_item_manufacturer');
            $(ds_id).query();
            Leaf.Masker.unmask(Ext.getBody());
            Leaf.request({
                url: $('yx_lease_item_log_create_link').getUrl(),
                scope: this,
                para: {logType: 'manufacturer',changeList: changeList},
                success: function (res) {
                    changeList = [];
                },
                failure: function () {
                    changeList = [];
                },
                error: function () {
                    changeList = [];
                },
                scope: this
            });
        };

        //批量导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {

            new Leaf.Window({
                id: 'prj355_excel_import_open_winid',
                params: {
                    winid: 'prj355_excel_import_open_winid'
                },
                url: '${/request/@context_path}/modules/PRJ/PRJ_LI/PRJ355/yx_manufacturer_excel_import_file.lview',
                title: '生产厂商批量导入',
                width: 430,
                height: 360
            });

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
