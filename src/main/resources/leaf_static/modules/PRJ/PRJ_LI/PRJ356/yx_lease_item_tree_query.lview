<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function yx_lease_item_classify_tree_query() {
            $('yx_lease_item_classify_tree_ds').query();
        }

        function yx_lease_item_classify_tree_query_reset() {
            $('yx_lease_item_classify_tree_query_ds').reset();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="yx_lease_item_classify_tree_query_ds">
                <a:fields>
                    <a:field name="classify_id_desc" title="属性值" autoComplete="true" fetchRemote="false"
                             lovWidth="500" lovHeight="450" lovGridHeight="300"
                             lovService="/lease/item/classify/query/classifyId/lov~com.hand.hls.lease.dto.ClassifyIdLovDto">
                        <a:mapping>
                            <a:map from="classify_id" to="classify_id"/>
                            <a:map from="attribute_value" to="classify_id_desc"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="yx_lease_item_classify_tree_ds" autoPageSize="true" fetchAll="true" selectable="true"
                       autoQuery="true" queryDataSet="yx_lease_item_classify_tree_query_ds"
                       queryUrl="${/request/@context_path}/lease/item/classify/tree/query"/>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="yx_lease_item_classify_tree_query" text="查询"/>
                <a:gridButton click="yx_lease_item_classify_tree_query_reset" text="重置"/>
            </a:screenTopToolbar>
            <a:form column="1" title="查询条件" labelwidth="100">
                <a:lov name="classify_id_desc" bindTarget="yx_lease_item_classify_tree_query_ds" prompt="属性值"
                             width="220">
                    <a:events>
                        <a:event name="enterdown" handler="yx_lease_item_classify_tree_query"/>
                    </a:events>
                </a:lov>
            </a:form>
            <a:treeGrid id="yx_lease_item_classify_tree_grid" bindTarget="yx_lease_item_classify_tree_ds" expandField="expand_flag"
                        idField="classify_id" marginHeight="180" marginWidth="30" navBar="false"
                        parentField="superior_classify_id">
                <a:columns>
                    <a:column name="attribute_value" width="300" prompt="分类" align="center"/>
                    <a:column name="manufacturer_id_n" width="300" prompt="生产厂商" align="center"/>
                </a:columns>
            </a:treeGrid>

        </a:screenBody>
    </a:view>
</a:screen>
