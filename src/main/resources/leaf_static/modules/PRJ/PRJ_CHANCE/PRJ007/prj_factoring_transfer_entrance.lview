<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_factoring_transfer_main_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ005/prj_factoring_modify_detail.lview"/>
        <a:link id="transfer_page_factoring"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ007/prj_factoring_transfer_host.lview"/>
        <a:link id="prj_credit_jump_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_credit_modify_detail.lview"/>
        <script><![CDATA[
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'credit_line_number' && value) {
                return '<a href="javascript:open_project_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_project_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['chance_id'] = record.get('chance_id');
            var maintain_type = 'READONLY';
            var function_usage = 'QUERY';
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            param['url_title'] = '立项维护';
            param['function_code'] = 'PRJ005F1';
            param['winid'] = 'factoring_detail_winid';
            var url = 'prj_factoring_transfer_main_detail'
            if (record.get('document_type') != 'FACTORING'){
                param['function_code'] = 'PRJ003F1';
                url = 'prj_credit_jump_detail';
            }
            hls_doc_get_layout_code(param, url, ds_id, 'PRJ007');
        }


        //项目主办移交
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'G_LINE_CHANCE');
            var records = $(ds_id).getSelected();
            if (records.length === 0) {
                Leaf.showInfoMessage('提示', '请选择数据后再进行项目主办移交');
                return;
            }
            for (let i = 1; i < records.length; i++) {
                if (records[i].get('document_type') != records[i-1].get('document_type')){
                    Leaf.showErrorMessage('提示','保理项目和授信项目不能同时移交');
                    return;
                }
            }
            var transfer_data = '';
            var param = {};
            for (let i = 0; i < records.length; i++) {
                if (i === 0) {
                    transfer_data = records[i].get('chance_id');
                } else {
                    transfer_data = transfer_data + '_' + records[i].get('chance_id');
                }
            }
            param['transfer_data'] = transfer_data;
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '项目主办移交';
            if (records[0].get('document_type') === 'FACTORING'){
                param['function_code'] = 'PRJ007F1';
            }else {
                param['function_code'] = 'PRJ007F2';
            }
            param['winid'] = 'transfer_host_winid';
            param['flag'] = 'HOST';
            param['screen_width'] = 450;
            param['screen_height'] = 300;
            hls_doc_get_layout_code(param, 'transfer_page_factoring', ds_id, 'PRJ007');

        };

        //项目协办移交
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'G_LINE_CHANCE');
            var records = $(ds_id).getSelected();
            if (records.length === 0) {
                Leaf.showInfoMessage('提示', '请选择数据后再进行项目协办移交');
                return;
            }
            for (let i = 1; i < records.length; i++) {
                if (records[i].get('document_type') != records[i-1].get('document_type')){
                    Leaf.showErrorMessage('提示','保理项目和授信项目不能同时移交');
                    return;
                }
            }
            var transfer_data = '';
            var param = {};
            for (let i = 0; i < records.length; i++) {
                if (i === 0) {
                    transfer_data = records[i].get('chance_id');
                } else {
                    transfer_data = transfer_data + '_' + records[i].get('chance_id');
                }
            }
            if (records[0].get('document_type') === 'FACTORING'){
                param['function_code'] = 'PRJ007F1';
            }else {
                param['function_code'] = 'PRJ007F2';
            }
            param['transfer_data'] = transfer_data;
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '项目协办移交';
            param['function_code'] = 'PRJ007F1';
            param['winid'] = 'transfer_slave_winid';
            param['flag'] = 'SLAVE';
            param['screen_width'] = 450;
            param['screen_height'] = 300;
            hls_doc_get_layout_code(param, 'transfer_page_factoring', ds_id, 'PRJ007');
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>