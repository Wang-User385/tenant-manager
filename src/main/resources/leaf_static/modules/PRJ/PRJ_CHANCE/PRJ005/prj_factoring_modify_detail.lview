<?xml version="1.0" encoding="UTF-8"?>
<!--创建-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="factoring_bp_master_modify_link_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="factoring_finance_report_detail_link_id"
                url="${/request/@context_path}/modules/BP/BP100/financial_report_import_entrance.lview"/>
        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var file_num = record.get('file_num') || 0;
            var attach_name = file_num === 0 ? '附件' : '附件(' + file_num + ')';
            if (name == 'bp_detail') {
                return '<a href="javascript:open_master_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户明细信息</a>';
            } else if (name == 'bp_financia') {
                return '<a href="javascript:open_financia_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户财报信息</a>';
            } else if (name == 'info') {
                return '<a href="javascript:upload(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('chance_id') + '\');">' + attach_name + '</a>';
            } else if (name == 'quote') {
                return '<a href="javascript:quotation_factoring_detail_adjust(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\',\'' + record.get('chance_id') + '\')"><span style="    width: 82px;\n' +
                    '    background-color: #4CAF50;\n' +
                    '    border: none;\n' +
                    '    color: white;\n' +
                    '    padding: 1px 33px;\n' +
                    '    text-align: center;\n' +
                    '    text-decoration: none;\n' +
                    '    display: inline-block;\n' +
                    '    font-size: 13px;\n' +
                    '    margin: 0px 0px;\n' +
                    '    cursor: pointer;\n' +
                    '    border-radius: 8px;\n' +
                    '    transition: background-color 0.3s;">报价测算' +
                    '</span></a>';
            } else if (name == 'preview') {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_names').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (let i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i]) || checkXls(fileNameList[i])) {
                            html += '<a href=javascript:queryDocFile(\'' + sourcePkList[i] + '\')> ' + fileNameList[i] + '在线预览</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
        };

        //暂存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
            if (ds_id) {
                var record = $(ds_id).getCurrentRecord();
                if ('${/parameter/@function_usage}' == 'CREATE' && !record.get('credit_line_number')) {
                    setBasicInfoInCreate(record, ds_id_pq, ds_id);
                }
            }
            //忽略保存校验方法
            window['${/parameter/@layout_code}_ignore_required_before_save']();
            var root_ds = $('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            var before_flag = true;
            if (before_flag) {
                var winid = '${/parameter/@winid}';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@layout_code}');

                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE() {
                    root_ds.un('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if (!flag) {
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION() {
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds, root_record, res);
                    if (typeof (nextStep) == 'function') {
                        nextStep(ds);
                    }
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }

                root_ds.on('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                root_ds.doNewSubmit(null, root_ds.getJsonData());
            } else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        }

        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
                var ds_id_re = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_receivable', 'G_RECEIVE_PAY');
                var ds_id_at = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTA_INFO');
                if (!$(ds_id_re).getAll() || $(ds_id_re).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '应收账款信息不能为空！');
                    return;
                }
                if (!$(ds_id_at).getAll() || $(ds_id_at).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '附件信息不能为空！');
                    return;
                }
                var records = $(ds_id_at).getAll();
                for (let i = 0; i < records.length; i++) {
                    var record_at = records[i];
                    if (!record_at.get('file_num') || record_at.get('file_num') === 0) {
                        Leaf.showInfoMessage('提示', '文档名称为' + record_at.get('document_name') + '附件不能为空');
                        return;
                    }
                }
                var record = $(ds_id).getCurrentRecord();
                var chance_id = record.get('chance_id');
                if (chance_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/credit/chance/submit',
                            para: {
                                chance_id: chance_id
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();
                                var ds_id_main = 'PRJ005_G_FAC_hls_credit_line_chance_ds';
                                $(ds_id_main).query();
                                Leaf.showSuccessMessage("提示", "提交审批成功!");
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                }
            })
        }

        //一键下载
        window['${/parameter/@layout_code}_G_ATTA_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var record = $(ds_id).getCurrentRecord();
            var chance_id = parseInt(record.get('chance_id'));
            var down_url = "${/request/@context_path}/hls/credit/download?chanceId=" + chance_id + "&attachmentCategory=CHANCE_ATT";
            location.href = down_url;
        }

        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value) {
            var quo_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            if (ds.id === quo_ds) {
                if (name == 'lease_item_amount' || name == 'down_payment') {
                    var lease_item_amount = record.get('lease_item_amount') || 0;
                    var down_payment = record.get('down_payment') || 0;
                    record.set('finance_amount', minus(lease_item_amount, down_payment));
                }
            }
        };

        //新增grid前
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_beforecreate'] = function (ds, record, config_records, bp_seq) {
            var parentRecord = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance')).getAt(0);
            if (parentRecord.get('chance_id')) {
                return true;
            } else {
                Leaf.showMessage("提示", "请先保存保理立项基本信息!", null);
                return false;
            }
        };

        //保存前
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            var check_flag = true;
            debugger;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id_customer = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_bp', 'F_CUSTOMER');
            var set = new Set();
            var records_customer = $(ds_id_customer).getAll();
            for (let i = 0; i < records_customer.length; i++) {
                var record_customer = records_customer[i];
                if (set.has(record_customer.get('TRANSFEREE_ASSETS'))) {
                    Leaf.showErrorMessage('提示', '客户信息保理卖方只能有一个');
                    return false;
                }
                set.add(record_customer.get('bp_type'));
            }
            set.clear();
            var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            var records_p = $(ds_id_p).getAll();
            if (records_p) {
                for (let i = 0; i < records_p.length; i++) {
                    var record_p = records_p[i];
                    if (set.has(record_p.get('factoring_category'))) {
                        Leaf.showErrorMessage('提示', '授信明细保理种类为' + record_p.get('factoring_category_n') + '有多个');
                        return false;
                    }
                    set.add(record_p.get('factoring_category'));
                }
            }
            var ds_id_cp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var record_cp = $(ds_id_cp).getCurrentRecord();
            if (record_cp.get('date_from') > record_cp.get('date_to')) {
                Leaf.showErrorMessage('提示', '授信开始日期不能大于授信结束日期');
                return false;
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
            if (ds_id == ds.id) {
                if ('${/parameter/@function_usage}' == 'CREATE' && !record.get('credit_line_number')) {
                    setBasicInfoInCreate(record, ds_id_pq, ds_id);
                }
            }
            return check_flag;
        }

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
            if (ds.id == ds_id && '${/parameter/@function_usage}' == 'CREATE') {
                var credit_line_name = '${/parameter/@bp_id_n_n}' + '项目';
                var company_id = '${/parameter/@company_id_n}';
                var company_name = '${/parameter/@company_id_n_n}';
                var unit_id = '${/parameter/@unit_id}';
                var unit_name = '${/parameter/@unit_id_n}';
                var proposer_employee_id = '${/parameter/@proposer_employee_id}';
                var proposer_employee_id_n = '${/parameter/@proposer_employee_id_n}';
                record.set('credit_line_name', credit_line_name);
                record.set('bp_id', '${/parameter/@bp_id_n}');
                record.set('company_id', company_id);
                record.set('company_id_n', company_name);
                record.set('unit_id', unit_id);
                record.set('unit_id_n', unit_name);
                record.set('proposer_employee_id', proposer_employee_id);
                record.set('proposer_employee_id_n', proposer_employee_id_n);
                record.set('document_type', 'FACTORING');
                record.set('document_category', 'HLS_CREDIT_LINE_CHANCE');
            } else if (ds.id == ds_id_au) {
                if ('${/parameter/@function_usage}' == 'CREATE') {
                    record.set('bp_name', '${/parameter/@bp_id_n_n}');
                }
                if ('${/parameter/@credit_flag}' == 'N') {
                    record.getField('quota_type').setRequired(false);
                    record.getField('quota_type_n').setRequired(false);
                    record.getField('date_from').setRequired(false);
                    record.getField('date_to').setRequired(false);
                    record.getField('credit_desc').setRequired(false);
                }
                record.set('source_document_category', 'HLS_CREDIT_LINE_CHANCE');
            } else if (ds.id == ds_id_pq) {
                if ('${/parameter/@bp_id_n}') {
                    record.set('bp_id', '${/parameter/@bp_id_n}');
                }
                record.set('document_category', 'HLS_CREDIT_LINE_CHANCE');
                record.set('source_document_category', 'HLS_CREDIT_LINE_CHANCE');
            }

        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id_customer = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_bp', 'F_CUSTOMER');
            var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var ds_id_atta = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTA_INFO');
            if (ds_id_customer.id == ds.id && '${/parameter/@function_usage}' == 'CREATE') {
                var records = $(ds_id_customer.id).getAll();
                var query_data = [];
                for (let i = 0; i < records.length; i++) {
                    query_data.push(records[i].data);
                }
                Leaf.request({
                    url: '${/request/@context_path}/get/factoring/bp/info',
                    para: query_data,
                    success: function (res) {
                        var res_records = res.result.record;
                        for (let i = 0; i < res_records.length; i++) {
                            var record = records[i];
                            var res_record = res_records[i];
                            record.set('bp_name', res_record.bp_name);
                            record.set('bp_code', res_record.bp_code);
                            record.set('bp_type', res_record.bp_type);
                            record.set('bp_type_n', res_record.bp_type_n);
                            record.set('economic_indu_classify', res_record.economic_indu_classify);
                            record.set('economic_indu_classify_n', res_record.economic_indu_classify_n);
                            record.set('group_companies', res_record.group_companies);
                        }
                    },
                    sync: true
                });
            } else if (ds.id == ds_id_atta) {
                var record_atta = $(ds_id_atta).getCurrentRecord();
                record_atta.set('attachment_category', "CHANCE_ATT");
            } else if (ds.id == ds_id_p) {
                if (record) {
                    var record_ds_id_au = $(ds_id_au).getCurrentRecord();
                    var record_f = $(ds_id_customer).getAll()[0];
                    record.set('credit_plan_id', record_ds_id_au.get('credit_plan_id'));
                    record.set('bp_code', record_f.get('bp_code'));
                    record.set('bp_name', record_f.get('bp_name'));
                    record.set('bp_name_n', record_f.get('bp_name_n'));
                    record.set('bp_type', record_f.get('bp_type'));
                    record.set('bp_type_n', record_f.get('bp_type_n'));
                    record.set('group_companies', record_f.get('group_companies'));
                    record.set('economic_indu_classify', record_f.get('economic_indu_classify'));
                    record.set('economic_indu_classify_n', record_f.get('economic_indu_classify_n'));
                }
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            if (ds.id == ds_id_p) {
                var record = $(ds_id_au).getCurrentRecord();
                if (record) {
                    $(ds_id_p).setQueryParameter('credit_line_id', record.get('credit_line_id'));
                }
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            if (ds_root_id) {
                var root_record = $(ds_root_id).getCurrentRecord();
                if (root_record) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
                    var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
                    if (ds_id) {
                        var record_s = $(ds_id).getAll()[0];
                        if (record_s && !record_s.get('source_document_id')) {
                            record_s.set('source_document_id', root_record.get('chance_id'));
                            var quotation_id = record_s.get('quotation_id');
                            var source_document_id = record_s.get('source_document_id');
                            jQuery.ajax({
                                type: 'GET',
                                url: "${/request/@context_path}/set/chanceId/quotation?quotation_id=" + quotation_id + '&source_document_id=' + source_document_id,
                                async: false,
                                success: function (args) {

                                }
                            });
                        }
                    }
                    if (ds_id_p) {
                        var record_p = $(ds_id_p).getAll()[0];
                        if (record_p && !record_p.get('source_document_id')) {
                            record_p.set('source_document_id', root_record.get('chance_id'));
                            var credit_plan_id = record_p.get('credit_plan_id');
                            source_document_id = record_p.get('source_document_id');
                            jQuery.ajax({
                                type: 'GET',
                                url: "${/request/@context_path}/set/chanceId/plan?credit_plan_id=" + credit_plan_id + '&source_document_id=' + source_document_id,
                                async: false,
                                success: function (args) {

                                }
                            });
                        }
                    }
                }

            }
            if ('${/parameter/@wfl_flag}' == '') {
                var ds_id_main = 'PRJ005_G_FAC_hls_credit_line_chance_ds';
                $(ds_id_main).query();
            }
        }

        // 加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            if ('${/parameter/@function_usage}' == 'CREATE' && '${/parameter/@credit_flag}' == 'Y') {
                var ds_id_au_d = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
                if (ds_id_au_d) {
                    if (ds.id == ds_id_au_d) {
                        addCreditPlanInfoInCreate(ds_id_au_d);
                    }
                }
            }
        };



        Leaf.onReady(function () {
            var credit_flag = '${/parameter/@credit_flag}';
            var credit_flag_n = '${/parameter/@credit_flag_n}';
            //隐藏工作流要用组件
            if ('${/parameter/@wfl_flag}' != 'Y') {
                wflComponentHide();
            }
            //不是授信则隐藏授信组件
            if (credit_flag == 'N' || credit_flag_n == '否') {
                noCreditFlogComponentHide();
            }
            //特殊按钮让部分组件变为可编辑
            if ('${/parameter/@special_node_flag}' == 'Y'){
                specialNodeProcessing();
            }
            if ('${/parameter/@function_usage}' == 'CREATE') {
                $('factoring_add_winid').close();
                var ds_id_customer = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_bp', 'F_CUSTOMER');
                addCustomerInCreate(ds_id_customer);
                // if('${/parameter/@credit_flag}' == 'Y'){
                //     var ds_id_au_d = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
                //     addCreditPlanInfoInCreate(ds_id_au_d);
                // }
            }
            // 控制主角色不能删除
            $('${/parameter/@layout_code}_F_CUSTOMER_hls_credit_line_chance_bp_ds').on('beforeremove', function (ds, records) {
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('bp_type') == 'TRANSFEREE_ASSETS') {
                        Leaf.showMessage("提示", "客户信息为保理卖方的不允许删除!", null);
                        return false;
                    }
                }
            });
        });

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        function checkXls(name) {
            return /\.(xls|xlsx)$/i.test(name)
        }

        function open_master_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '商业伙伴信息';
            param['function_code'] = 'BP100F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'factoring_bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'factoring_bp_master_modify_link_id', null, 'PRJ005F1');
        }

        function open_financia_detail_win(record_id, ds_id) {
            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code'];
            var function_usage = 'QUERY';
            new Leaf.Window({
                id: 'factoring_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: function_usage,
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 950,
                height: 535,
                side: "right",
                draggable: true
            });
            hls_doc_get_layout_code(param, 'factoring_finance_report_detail_link_id', null, 'PRJ005F1');

        }

        function upload(ds_id, record_id, pk_id) {
            var tableName = 'HLS_CREDIT_LINE_ATTACH';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTA_INFO');
            var base_record;
            var chance_attachment_id;
            base_record = $(base_ds_id).findById(record_id);
            chance_attachment_id = base_record.get('chance_attachment_id');
            if (!chance_attachment_id) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            var url = '${/request/@context_path}/uploadFile.lview';
            var win = new Leaf.Window({
                id: 'PRJ005F1_open_attachment_factoring_winid',
                url: url,
                params: {
                    'header_id': chance_attachment_id,
                    'table_name': tableName,
                    winid: 'PRJ005F1_open_attachment_factoring_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }

        function quotation_factoring_detail_adjust(dsId, record_id, quotation_id, chance_id) {
            var price_list = $(dsId).findById(record_id).get("price_list");
            quotation_id = $(dsId).findById(record_id).get("quotation_id");
            chance_id = $(dsId).findById(record_id).get("chance_id");
            if (quotation_id == 'undefined' || quotation_id == null || quotation_id == '') {
                Leaf.showInfoMessage("提示", "请先保存后，再进行报价测算");
                return;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/prj/quotation/calc?quotationId=' + quotation_id,
                para: null,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '计算成功',
                        duration: 2000
                    });
                    var readOnly = 'N';
                    if ('${/parameter/@function_usage}' == 'QUERY') {
                        readOnly = 'Y';
                    }
                    var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list + '&readOnly=' + readOnly;
                    var win = new Leaf.Window({
                        id: 'hls901_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var quo_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
                        if (chance_id) {
                            $(quo_ds).setQueryParameter('chance_id', chance_id);
                        }
                        $(quo_ds).query();
                        var ds_id_cp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
                        var record_cp = $(ds_id_cp).getCurrentRecord();
                        if (record_cp) {
                            var record_quo = $(quo_ds).getCurrentRecord();
                            if (record_quo) {
                                record_cp.set('credit_amount', record_quo.get('finance_amount'));
                            }
                        }
                    })
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function addCustomerInCreate(ds_id) {
            var cur_ds = $(ds_id);
            var record = new Leaf.Record({
                'bp_id': '${/parameter/@bp_id_n}',
                'bp_name': '${/parameter/@bp_id_n}',
                'bp_name_n': '${/parameter/@bp_id_n_n}',
                'bp_code': '${/parameter/@bp_code}',
                'bp_type': '${/parameter/@bp_type}',
                'bp_type_n': '${/parameter/@bp_type_n}',
                'economic_indu_classify': '${/parameter/@economic_indu_classify}',
                'economic_indu_classify_n': '${/parameter/@economic_indu_classify_n}',
                'group_companies': '${/parameter/@group_companies}',
                'note': '${/parameter/@note}',
                'bp_class': 'ORG'
            })
            cur_ds.add(record);
        }

        function addCreditPlanInfoInCreate(ds_id_au_d) {
            var cur_ds_au = $(ds_id_au_d);
            var record = new Leaf.Record({
                'bp_name': '${/parameter/@bp_id_n}',
                'bp_name_n': '${/parameter/@bp_id_n_n}',
                'bp_code': '${/parameter/@bp_code}',
                'bp_type': '${/parameter/@bp_type}',
                'bp_type_n': '${/parameter/@bp_type_n}',
                'group_companies': '${/parameter/@group_companies}',
                'credit_amt': 0,
                'factoring_category': '',
                'factoring_category_n': '',
                'description': ''
            })
            cur_ds_au.add(record);
        }

        function setBasicInfoInCreate(record, ds_id_pq, ds_id) {
            record.set('creation_date', new Date());
            record.set('credit_line_status', 'NEW');
            record.set('credit_flag', '${/parameter/@credit_flag}');
            record.set('document_category', 'HLS_CREDIT_LINE_CHANCE');
            record.set('unit_id', '${/parameter/@unit_id}');
            record.set('company_id', '${/parameter/@company_id_n}');
            var credit_line_amt = 0;
            if (ds_id_pq) {
                var record_pq = $(ds_id_pq).getCurrentRecord();
                if (record_pq) {
                    credit_line_amt = record_pq.get('lease_item_amount');
                }
            }
            record.set('credit_line_amt', credit_line_amt);
            var documentCategory = 'FACTORING_BASE';
            var documentType = 'FACTORING_BASE';
            var businessType = 'FACTORING_BASE';
            Leaf.request({
                url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + documentCategory
                    + "&documentType=" + documentType + "&businessType=" + businessType,
                success: function (res) {
                    $(ds_id).getCurrentRecord().set('credit_line_number', res.result.record[0]);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });
        }

        function specialNodeProcessing() {
            debugger;
            var attach_grid_div_id = 'PRJ005F1_G_ATTA_INFO_hls_credit_line_attach_layout_grid_id_tb';
            var vote_grid_div_id = 'PRJ005F1_G_VOTE_FAC_hls_credit_line_chance_approver_layout_grid_id_tb';
            var condition_grid_div_id = 'PRJ005F1_G_CON_FAC_hls_credit_line_chance_condition_layout_grid_id_tb';
            var condition_after_grid_div_id = 'PRJ005F1_G_CON_FAC_AFTER_hls_credit_line_chance_condition_layout_grid_id_tb';
            processingGridByDivId(attach_grid_div_id);
            processingGridByDivId(vote_grid_div_id);
            processingGridByDivId(condition_grid_div_id);
            processingGridByDivId(condition_after_grid_div_id);
            var attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTA_INFO');
            var vote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_approver', 'G_VOTE_FAC');
            var condition_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_condition', 'G_CON_FAC');
            var condition_after_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_condition', 'G_CON_FAC_AFTER');
            var record = $(attach_ds_id).getCurrentRecord();
            if (record){
                record.getField('document_name').setReadOnly(false);
                record.getField('document_name').setRequired(true);
                record.getField('description').setReadOnly(false);
            }
            record = $(vote_ds_id);
            if (record){
                record.getField('name').setReadOnly(false);
                record.getField('name').setRequired(true);
                record.getField('unit_name').setReadOnly(false);
                record.getField('unit_name').setRequired(true);
                record.getField('position_name').setReadOnly(false);
                record.getField('position_name').setRequired(true);
                record.getField('vote_status').setReadOnly(false);
                record.getField('vote_status').setRequired(true);
            }
            record = $(condition_ds_id);
            if (record){
                record.getField('content').setReadOnly(false);
                record.getField('content').setRequired(true);
            }
            record = $(condition_after_ds_id);
            if (record){
                record.getField('content').setReadOnly(false);
                record.getField('content').setRequired(true);
            }

        }

        function processingGridByDivId(div_id){
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为显示
            for (var i = 0; i < buttonsInDiv.length; i++) {
                buttonsInDiv[i].style.display = 'block';
            }
        }

        function noCreditFlogComponentHide() {
            let plan_line_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_DETAIL_component_id']").attr("id");
            let plan_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_component_id']").attr("id");
            $jq('#${/parameter/@layout_code}_T_METHOD_DETAIL_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_F_METHOD_component_id').hide();//隐藏客户信息组件
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).prev().hide();
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).next().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).prev().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).next().hide();
        }

        function wflComponentHide() {
            let business_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_BUSINESS_FAC_component_id']").attr("id");
            let meeting_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_MEET_FAC_component_id']").attr("id");
            let vote_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_VOTE_FAC_component_id']").attr("id");
            let con_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_CON_FAC_component_id']").attr("id");
            let con_after_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_CON_FAC_AFTER_component_id']").attr("id");
            let attach_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_ATTA_INFO_component_id']").attr("id")
            let business_grid_id = '#' + '${/parameter/@layout_code}_G_BUSINESS_FAC_chance_business_access_compare_layout_grid_id_wrap';
            let meeting_grid_id = '#' + '${/parameter/@layout_code}_G_MEET_FAC_component_id';
            let vote_grid_id = '#' + '${/parameter/@layout_code}_G_VOTE_FAC_hls_credit_line_chance_approver_layout_grid_id_wrap';
            let con_grid_id = '#' + '${/parameter/@layout_code}_G_CON_FAC_hls_credit_line_chance_condition_layout_grid_id_wrap';
            let con_after_grid_id = '#' + '${/parameter/@layout_code}_G_CON_FAC_AFTER_hls_credit_line_chance_condition_layout_grid_id_wrap';
            let attach_grid_id = '#' + '${/parameter/@layout_code}_G_ATTA_INFO_hls_credit_line_attach_layout_grid_id_wrap';

            jQuery(business_grid_id).hide();
            jQuery(business_component_id).hide();
            jQuery(business_component_id).prev().hide();
            jQuery(business_component_id).hide();
            jQuery(business_component_id).next().hide();

            jQuery(meeting_grid_id).hide();
            jQuery(meeting_component_id).hide();
            jQuery(meeting_component_id).prev().hide();
            jQuery(meeting_component_id).hide();
            jQuery(meeting_component_id).next().hide();
            //如果节点不是特殊节点

            jQuery(vote_grid_id).hide();
            jQuery(vote_component_id).hide();
            jQuery(vote_component_id).prev().hide();
            jQuery(vote_component_id).hide();
            jQuery(vote_component_id).next().hide();

            jQuery(con_grid_id).hide();
            jQuery(con_component_id).hide();
            jQuery(con_component_id).prev().hide();
            jQuery(con_component_id).hide();
            jQuery(con_component_id).next().hide();

            jQuery(con_after_grid_id).hide();
            jQuery(con_after_component_id).hide();
            jQuery(con_after_component_id).prev().hide();
            jQuery(con_after_component_id).hide();
            jQuery(con_after_component_id).next().hide();


            //隐藏按钮
            if ('${/parameter/@wfl_flag}' == 'N') {
                jQuery('#${/parameter/@layout_code}_user_button1').hide();
                jQuery('#${/parameter/@layout_code}_user_button2').hide();
            }
        }

        //task_detail执行提交前调用
        function beforeSubmit(countiune) {
            var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var chance_id = $(ds_root_id).getCurrentRecord().get('chance_id');
            var cur_record = $('chance_appoint_user_ds').getCurrentRecord();
            var risk_host = '';
            var legal_host = '';
            var examine_host = '';
            if (cur_record) {
                var allocation_id = cur_record.get('allocation_id');
                var node_id = '${/parameter/@node_id}';
                if ('FACTORING_PROJRCT_PROPOSALS6' == node_id) {
                    risk_host = allocation_id;
                } else if ('FACTORING_PROJRCT_PROPOSALS7' == node_id) {
                    legal_host = allocation_id;
                } else if ('FACTORING_PROJRCT_PROPOSALS8' == node_id) {
                    examine_host = allocation_id;
                }
                if (node_id == 'FACTORING_PROJRCT_PROPOSALS6' || node_id == 'FACTORING_PROJRCT_PROPOSALS7' || node_id == 'FACTORING_PROJRCT_PROPOSALS8') {
                    Leaf.request({
                        url: '${/request/@context_path}/save/factoring/info',
                        para: {
                            chance_id: chance_id,
                            risk_host: risk_host,
                            legal_host: legal_host,
                            examine_host: examine_host
                        },
                        success: function (res) {
                        },
                        sync: true
                    });
                }
            }
            countiune();
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>