<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_factoring_add_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ005/prj_factoring_modify_detail.lview"/>
        <script><![CDATA[


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            Leaf.request({
                url: "${/request/@context_path}/get/factoring/info",
                success: function (res) {
                    var record = $(ds.id).getCurrentRecord();
                    record.set('unit_id', res.result.record[0].unit_id);
                    record.set('proposer_employee_id_n', res.result.record[0].proposer_employee_id_n);
                    record.set('proposer_employee_id', res.result.record[0].proposer_employee_id);
                    record.set('unit_id_n', res.result.record[0].unit_id_n);
                },
                sync: true
            });

        };

        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var record = $(ds_id).getAll()[0];
            var param = record.data;
            if (!$(ds_id).validate()) {
                return;
            }
            var query_data = [];
            query_data.push(param);
            Leaf.request({
                url: '${/request/@context_path}/get/bp/info',
                para: query_data,
                success: function (res) {
                    if (res.result.record) {
                        var res_records = res.result.record;
                        var res_record = res_records[0];
                        param['bp_name'] = res_record.bp_name;
                        param['bp_code'] = res_record.bp_code;
                        param['bp_type'] = res_record.bp_type;
                        param['bp_type_n'] = res_record.bp_type_n;
                        param['economic_indu_classify'] = res_record.economic_indu_classify;
                        param['economic_indu_classify_n'] = res_record.economic_indu_classify_n;
                        param['group_companies'] = res_record.group_companies;
                        param['note'] = '';
                    }
                },
                sync: true
            });
            param['function_usage'] = 'CREATE';
            param['url_title'] = '立项创建';
            param['function_code'] = 'PRJ005F1';
            param['winid'] = 'factoring_detail_add_modify_winid';
            hls_doc_get_layout_code(param, 'prj_factoring_add_detail', ds_id, 'PRJ005F2');
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>