<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
           debugger;
            Leaf.request({
                url: "${/request/@context_path}/get/factoring/info",
                success: function (res) {
                    var record =  $(ds.id).getCurrentRecord();
                    record.set('unit_id',res.result.record[0].unit_id);
                    record.set('proposer_employee_id_n',res.result.record[0].proposer_employee_id_n);
                    record.set('unit_id_n',res.result.record[0].unit_id_n);
                },
                sync: true
            });

        };

            //创建
            window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>