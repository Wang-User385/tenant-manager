<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_factoring_main_detail"
        url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ005/prj_factoring_modify_detail.lview"/>
        <a:link id="prj_factoring_main_add"
        url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ005/prj_factoring_add.lview"/>
        <script><![CDATA[



        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'credit_line_number' && value) {
                return '<a href="javascript:open_project_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_project_detail_win(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['chance_id'] = record.get('chance_id');
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '立项维护';
            param['function_code'] = 'PRJ005F1';
            param['winid'] = 'factoring_detail_winid';
            hls_doc_get_layout_code(param, 'prj_factoring_main_detail', ds_id, 'PRJ005');
        }



        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var param = {};
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '保理立项创建';
            param['function_code'] = 'PRJ005F2';
            param['proposer_user_id'] = '${/session/@user_id}';
            param['winid'] = 'factoring_add_winid';
            param['screen_width'] = 800;
            param['screen_height'] = 615;
            hls_doc_get_layout_code(param, 'prj_factoring_main_add', null ,'PRJ005');
        };

        //删除
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var records = $(ds_id).getSelected();
            if (records.length === 0){
                Leaf.showErrorMessage('提示','请选择所需关闭的项目！');
                return;
            }
            var delete_data = [];
            for (let i = 0; i < records.length; i++) {
                var record = records[i];
                if (record.get('credit_line_status') != 'NEW'){
                    Leaf.showErrorMessage('提示','非新建状态的单据，无法关闭!');
                    return;
                }
                delete_data.push(record.data);
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/batch/delete/info",
                para: delete_data,
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(ds_id).query();
                },
                error: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>