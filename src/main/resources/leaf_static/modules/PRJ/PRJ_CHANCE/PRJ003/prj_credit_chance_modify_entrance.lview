<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj300_prj_change_detail_link_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_chance_change_detail.lview"/>
        <a:link id="prj100_prj_change_create_link_id" url="${/request/@context_path}/chance/change/req/submit"/>
        <a:link id="prj003_project_modify_credit_id"  url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_credit.lview"/>
        <a:link id="prj_credit_amount_allocate_detail_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_amount_allocate_detail.lview"/>
        <a:link id="prj_credit_amount_allocate_add_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_amount_allocate_add.lview"/>
        <script><![CDATA[


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger
            $jq('.screenTitle').text("授信管理");//修改页面标题
            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = ds.queryurl + "&document_history_flag=N";
            }
            qpara['project_status'] = 'APPROVED';
            qpara['created_by'] = '${/session/@user_id}';
        };

        function prj001_detail_open(record_id, ds_id) {
             debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var type = 'QUERY';
            param.project_id = record.get('source_project_id');
            param['url_title'] = '授信查询';
            param['function_code'] = 'PRJ316F2_CREDIT';
            param['function_usage'] = type;
            param['project_id'] = record.get('source_project_id');
            param['winid'] = 'prj_chance_detail_winid';
            var link_id = 'prj003_project_modify_credit_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ003', null, null);
        }

        function prj003F2_allocate_detail_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var type = 'QUERY';
            if(record.get('status') =='NEW'){
                type = 'MODIFY';
            }

            var link_id = 'prj_credit_amount_allocate_detail_id';
            param['function_code'] = 'PRJ003F1_CHANGE_BP';
            param['function_usage'] = type;
            param['winid'] = 'prj_chance_amount_allocate_add_winid';
            param['url_title'] = '额度增量申请';
            param['entrance_winid'] = '${/parameter/@winid}';
            param['ds_id'] = '${/parameter/@ds_id}';
            param['project_id'] = record.get('project_id');
            param.project_id = record.get('project_id');
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ003', '${/parameter/@winid}', 'Y');
        }

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            debugger;
            var link_function = 'prj001_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'project_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name === 'change_req_number') {
                link_function = 'prj003F2_allocate_detail_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        //额度分配
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var param = {};
            param['url_title'] = '额度增量申请新增';
            param['function_code'] = 'PRJ003F2';
            param['function_usage'] = 'MODIFY';
            param['unit_id'] = '${/session/@unitId}';
            param['winid'] = 'prj_credit_amount_allocate_add_winid';
            param['ds_id'] = ds_id;
            param['screen_width'] = '640';
            var link_id = 'prj_credit_amount_allocate_add_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ003');
        };

        //授信关闭
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();

            if (records.length != 1) {
                $L.showInfoMessage("提示", "请选择一个授信!");
                return;
            }
            var record = records[0];
            var status = record.get('project_status');
            if(status == 'PENDING'){
                $L.showInfoMessage("提示","当前授信正在变更中!");
                return;
            }
            if(status != 'APPROVED'){
                $L.showInfoMessage("提示","非审批通过的授信不可关闭!");
                return;
            }
            var project_id = record.get('project_id');
            Leaf.showConfirm('提示', '是否确认授信关闭?', function () {
                $L.Masker.mask(Ext.getBody());
                Leaf.request({
                    url: '${/request/@context_path}/hls/cus/prj/project/close',
                    para: {'project_id': project_id},
                    success: function (res) {
                        $(ds_id).query();
                        $L.Masker.unmask(Ext.getBody());
                    },
                    failure: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }, function cancel() {
                $L.Masker.unmask(Ext.getBody());
            }, 200, 200);
        };

        //页面加载 按钮显示隐藏逻辑
        Leaf.onReady(function () {
            var unit_name='${/session/@unitName}';
            if(unit_name !='风险管理部'){
                document.getElementById('${/parameter/@layout_code}_user_button6').style.display = "none";
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
