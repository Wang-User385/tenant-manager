<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: zhangdan
    $Date: 2022-11-08
    $Description: 额度增量申请创建
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prjf2_credit_amount_allocate_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_amount_allocate_detail.lview"/>
        <script><![CDATA[

        // 创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id).getCurrentRecord();
            var source_project_id = record.get('project_id');
            if ($(ds_id).validate()) {
                Leaf.request({
                    url: "${/request/@context_path}/credit/project/amount/allocate/create",
                    para: {
                        project_id: source_project_id
                    },
                    success: function (res) {
                        change_req_id = res.result.record[0].change_req_id;
                        project_id = res.result.record[0].project_id;
                        $L.showInfoMessage("提示","创建成功!",function () {
                            debugger;
                            var param = $(ds_id).getAt(0).data;
                            var link_id = 'prjf2_credit_amount_allocate_detail_id';
                            param['function_code'] = 'PRJ003F1_CHANGE_BP';
                            param['winid'] = 'prj_credit_amount_allocate_detail_winid';
                            param['url_title'] = '额度增量申请创建';
                            param['entrance_winid'] = '${/parameter/@winid}';
                            param['ds_id'] = '${/parameter/@ds_id}';
                            param['project_id'] = project_id;
                            param['change_req_id'] = change_req_id;
                            param['source_project_id'] = source_project_id;
                            param['function_usage'] = 'CREATE';
                            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ003', '${/parameter/@winid}', 'Y');
                        });
                    },
                    failure: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
