<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-21
    $Description: 工作流跳转页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj003f1_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_chance_change_wfl_edit_detail.lview"/>
        <script id="scriptA"><![CDATA[
        debugger;
        var bp_hide_flag = 'Y';
        var file_hide_flag = 'Y';
        var comments_hide_flag = 'N';
        var comments_readOnly_flag = 'N';
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }
        var chance = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "chanceId";
        });
        var credit_flag = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "creditFlag";
        });
        var chanceId =  chance[0].value;
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var function_code ='PRJ003F1_CHANGE_AMT';
        var wflurl = $('prj003f1_link_id').getUrl();
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-rHAU6o6D-6QbN-4laU-89LQ-cSSMgkK3aMmb"  ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
        }

        var pageChooser = new PageChooser({
            url: wflurl,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                chance_id: chanceId,
                maintain_type: maintain_type,
                function_usage: function_usage,
                function_code: function_code,
                credit_flag : credit_flag,
                wfl_bp_flag : '${/parameter/@wflRuleControlFlag}',
                bp_hide_flag: bp_hide_flag,
                file_hide_flag: file_hide_flag,
                comments_hide_flag: comments_hide_flag,
                comments_readOnly_flag:comments_readOnly_flag
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

