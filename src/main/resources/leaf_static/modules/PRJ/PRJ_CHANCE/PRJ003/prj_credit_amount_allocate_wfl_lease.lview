<!--
    Author: lrd
    Date: 2020/02/24 14:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj003_wfl_detail_credit_link_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_modify_wfl_lease.lview"/>
        <a:link id="prj003_wfl_modify_credit_link_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_amount_allocate_detail.lview"/>
        <script><![CDATA[
        debugger;
        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var function_code ='PRJ003F1_CHANGE_ALLOCATE_WFL1';
        var wflurl = $('prj003_wfl_detail_credit_link_id').getUrl();

        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-rHAU6o6D-6QbN-4laU-89LQ-cSSMgkK3aMmb"  ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
            function_code ='PRJ003F1_CHANGE_BP';
            wflurl = $('prj003_wfl_modify_credit_link_id').getUrl();
        }

        var pageChooser = new PageChooser({
            url: wflurl,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                wfl_flag : 'Y',
                maintain_type: maintain_type,
                function_code: function_code,
                function_usage: function_usage,
                hidden_button_code: ['SUBMIT_APPROVAL', 'EXIT']
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>