<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp100_bp_master_modify_id" url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script><![CDATA[
        var source_project_id = '${/parameter/@source_project_id}';
        var project_id = '${/parameter/@project_id}';
        var credit_flag =  '${/parameter/@credit_flag}';
        var function_usage =  '${/parameter/@function_usage}';
        var change_req_id = '${/parameter/@change_req_id}';

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (ds.id === '${/parameter/@layout_code}_F_QUOTA_ALLOCATION_DETAILS_prj_project_bp_ds') {
                record.set('bp_categroy', 'PRJ_PROJECT');
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_F_CREDIT_PROGRAM_hls_credit_plan_ds':
                    var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    debugger;
                    var project_record = $(project_ds_id).getCurrentRecord();
                    if(project_record){
                        var project_id = project_record.get('project_id');
                        if (project_id) {
                            qpara['document_id'] = project_id;
                            qpara['source_document_id'] = project_id;
                        } else {
                            qpara['document_id'] = "-1";
                            qpara['source_document_id'] = "-1";
                        }
                        qpara['source_document_category'] = 'PRJ_PROJECT';
                    }else{
                        qpara['document_id'] = "-1";
                        qpara['source_document_id'] = "-1";
                    }
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(project_ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');

            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            if (ds.id === '${/parameter/@layout_code}_F_QUOTA_ALLOCATION_DETAILS_prj_project_bp_ds') {
                qpara['allocat_flag'] = 'Y';
                qpara['project_id'] = project_id;
            }

        };

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            var check_flag = true;
            debugger;
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_PRJ_BASIC');
            var project_record = $(project_ds_id).getCurrentRecord();

            var plan_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan');
            var plan_record = $(plan_ds_id).getCurrentRecord();
            var credit_amt = plan_record.get('credit_amt');
            var sum_amount = 0;

            var bp_amount_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'F_QUOTA_ALLOCATION_DETAILS');
            if (bp_amount_ds_id !='') {
                var bp_record = $(bp_amount_ds_id).getAll();
                var mul_num=0;
                for (let i = 0; i < bp_record.length; i++) {
                    var bp_type=bp_record[i].get('bp_type');
                    if(bp_type!= 'TENANT'){
                        Leaf.showErrorMessage('提示', '只能选择承租人！');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                    for (var j = 0; j < bp_record.length; j++) {
                        if (bp_record[i].get('bp_id') == bp_record[j].get('bp_id')
                            && bp_record[i].get('bp_type') == bp_record[j].get('bp_type')) {
                            mul_num++;
                        }
                    }

                    var credit_amount = bp_record[i].get('credit_amount');
                    if (credit_amount != null && credit_amount != '') {
                        sum_amount += credit_amount;
                        if (credit_amount < 0) {
                            Leaf.showErrorMessage('提示', '客户授信金额不能为负数！');
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            return false;
                        }
                    }
                }
                if (sum_amount > credit_amt) {
                    Leaf.showErrorMessage('提示', '分配金额大于剩余授信额度');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }

                if (mul_num > bp_record.length) {
                    Leaf.showMessage('提示', '同一角色的客户不能添加多次');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }

            /*if ((change_req_id == null || change_req_id == '')&& check_flag) {
                Leaf.request({
                    url: "${/request/@context_path}/credit/project/amount/allocate/create",
                    para: {
                        project_id: source_project_id
                    },
                    success: function (res) {
                        // debugger;
                        change_req_id = res.result.record[0].change_req_id;
                        project_id = res.result.record[0].project_id;
                        chance_record.set('project_id', project_id);
                    },
                    error: function () {
                        check_flag = false;
                        Leaf.showMessage("提示", "保存出错!", null);
                    },
                    sync: true,
                    scope: this
                });
            }*/

            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            //debugger;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

        };

        //忽略保存校验方法
        window['${/parameter/@layout_code}_ignore_required_before_save'] = function () {
            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
        };

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            //debugger;
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '授信主体详细信息' + '</a>';
            }
            if (name == 'finnance_info') {
                return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }

            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }

            return value;
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '授信主体伙伴详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid';

            if ('${/parameter/@wfl_bp_flag}' == 'Y') {
                parent.parent_bp_project_detail(param, ds_id);
            } else {
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win(ds_id, record_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var bp_id = param.bp_id;
            var bp_name = param.bp_id_n;
            var bp_code = param.bp_code;

            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: 'QUERY',
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 850,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function(){
                var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var project_record = $(project_ds).getCurrentRecord();

                Leaf.request({
                    url: "${/request/@context_path}/prj/allocate/change/submit",
                    para: {
                        change_req_id: change_req_id,
                        project_id : project_id
                    },
                    success: function (res) {

                        $L.showInfoMessage("提示","提交成功!",function(){
                            $('${/parameter/@winid}').close();
                        });
                    },
                    error: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            })
        };

        //取消变更
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(project_ds).getCurrentRecord();

            $L.showConfirm("提示","确定作废当前变更!",function(){
                Leaf.request({
                    url: "${/request/@context_path}/ct/prj/change/cancel",
                    para: {
                        project_id: '${/parameter/@source_project_id}',
                        change_req_id : '${/parameter/@change_req_id}'
                    },
                    success: function (res) {

                        $L.showInfoMessage("提示","已取消此次变更!",function(){
                            $('${/parameter/@winid}').close();
                        });
                    },
                    error: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            });
        };

        // 删除前校验
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq){

            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp','F_CUSTOMER_INFO');
            if(ds.id == bp_ds_id) {
                var selectData = $(bp_ds_id).getSelected();
                if (selectData.length == 0) {
                    Leaf.showMessage('提示', '请选择单据');
                }
                for (var i = 0; i < selectData.length; i++) {
                    if (selectData[i].get('contract_number') != undefined) {
                        $L.showInfoMessage("提示","已生成合同不可删除授信!");
                        return false;
                    }
                }

                // 删除项目
                debugger;
                var dataList = [];
                for (var i = 0; i < selectData.length; i++) {
                    dataList.push(selectData[i].data);
                }
                Leaf.request({
                    url: '${/request/@context_path}/project/deleteRelaProject',
                    async: true, //设为同步
                    para: dataList,
                    success: function (res) {
                       return true;
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    },
                    scope: this
                });
            }
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>