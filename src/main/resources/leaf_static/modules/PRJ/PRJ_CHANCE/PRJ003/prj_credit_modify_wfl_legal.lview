        <a:link id="${/parameter/@layout_code}_change_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANGE/PRJ110F1/prj_change_req_wfl.lview"/>
        <a:link id="prj316wfl_project_change_id"
