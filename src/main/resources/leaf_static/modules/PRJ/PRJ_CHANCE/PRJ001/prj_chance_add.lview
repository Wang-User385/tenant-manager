<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-08
    $Description: 立项创建
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_credit_add_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_credit_modify_detail.lview"/>
        <script><![CDATA[

        Leaf.onReady(function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var ds_record = $(ds_id).getCurrentRecord();
            ds_record.set('proposer_employee_id', '${/session/@allocationId}');
            ds_record.set('proposer_employee_id_n', '${/session/@employeeName}');
            ds_record.set('unit_id', '${/session/@unitId}');
            ds_record.set('unit_id_n', '${/session/@unitName}');
            ds_record.set('company_id', '${/session/@companyId}');
            ds_record.set('company_id_n', '${/session/@companyName}');
        });

        // 创建立项
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            if ($(ds_id).validate()) {
                var record = $(ds_id).getCurrentRecord();
                var param = record.data;
                var query_data = [];
                query_data.push(param);
                Leaf.request({
                    url: '${/request/@context_path}/get/bp/info',
                    para: query_data,
                    success: function (res) {
                        if (res.result.record) {
                            var res_records = res.result.record;
                            var res_record = res_records[0];
                            param['bp_name'] = res_record.bp_name;
                            param['bp_code'] = res_record.bp_code;
                            param['bp_type'] = res_record.bp_type;
                            param['bp_type_n'] = res_record.bp_type_n;
                        }
                    },
                    sync: true
                });
                param['url_title'] = '立项创建';
                param['function_code'] = 'PRJ003F1';
                param['winid'] = 'prj_chance_add_winid';
                param['entrance_winid'] = '${/parameter/@winid}';
                param['ds_id'] = '${/parameter/@ds_id}';
                param['function_usage'] = 'CREATE';
                hls_doc_get_layout_code(param, 'prj_credit_add_id', ds_id, 'PRJ001F2', '${/parameter/@winid}', 'Y');
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
