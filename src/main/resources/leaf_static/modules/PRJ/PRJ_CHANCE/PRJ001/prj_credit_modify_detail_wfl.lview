<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjQuotationService.queryBaseRateNow"
                       rootPath="quote_record_path"/>
        <a:model-query model="$com.hand.hls.fct.service.HlsCusHlsCreditLineChanceService.queryChanceId"
                       rootPath="chance_record_path"/>
    </a:init-procedure>
    <a:view>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"></script>
        <a:link id="hls200_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="hls200_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="lease_query_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="sw001_pledge_lease_query"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        //业务意向书生成 获取文档文办 pkvalue
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance','F_PRJ_BASIC');
                var record = $(ds_id).getCurrentRecord();
                if(record.get('source_pk_value') && record.get('source_pk_value') != null && record.get('source_pk_value') != '' ){
                    var source_pk_value = record.get('source_pk_value');
                    editOffice(source_pk_value);
                }else{
                    $L.showInfoMessage("提示","请先生业务意向书!");
                }
        };
        // 在线编辑
        function editOffice(source_pk_value){
            //查看
            if(source_pk_value){
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            }else{
                $L.showInfoMessage("提示","业务意向书不存在，请先生成业务意向书!");
            }
        }

        function lease001_detail_open(record_id, ds_id , contract_status) {
            debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '详细信息';
            var link_id;
            if(param.lease_item_type == 'LEASE'){
                param['function_code'] = 'LEASE001F1';
                link_id = 'lease_query_detaill_id';
            }else{
                param['function_code'] = 'SW001F1';
                link_id = 'sw001_pledge_lease_query';
            }
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        }
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_detali' ) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if(name == 'finnance_info'){
                return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }
            //ATTACHMENT_DETAIL

            /*if(name == 'file_name'){
                return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }*/

            if (name == 'download' ) {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id='+record.get('attachment_id')+'">下载</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }

            if( name == 'attachment_detail'){
                return '<a href="javascript:open_attach(\'' + record.get('chance_attachment_id') + '\')">附件查看</a>';
            }
            if( name == 'attachment_detail'){
                return '<a href="javascript:open_attach(\'' + record.get('chance_attachment_id') + '\')">附件查看</a>';
            }
            if (name === 'lease_item_code') {
                var link_function = 'lease001_detail_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id +  '\',\'' + record.get('contract_status') +  '\');">' + value + '</a>';
            }
            return value;
        };

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }

            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
               /* $L.showInfoMessage("提示","当前无法上传文件!");
                return;*/
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'chance_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_CREDIT_LINE_CHANCE',
                    winid: 'chance_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach');
                $(ds_id).query();
            });
        }

        window['approval_upload_file'] = function (record_id, chance_attachment_id) {
            if (typeof (chance_attachment_id) === 'undefined' || 'undefined' === chance_attachment_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': chance_attachment_id,
                    'table_name': 'hls_credit_line_chance',
                    winid: 'prj320_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                $(ds_id).query();
            });
        };      //CHANCE_ATT

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid';

            if('${/parameter/@wfl_bp_flag}' == 'Y'){
                parent.parent_bp_chance_detail(param , ds_id);
            }else{
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;

            var bp_id = param.bp_id;
            var bp_name = param.bp_id_n;
            var bp_code = param.bp_code;

            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code : bp_code,
                    bp_master_name : bp_name,
                    function_usage:'QUERY',
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width:850,
                height:535,
                side:"right",
                draggable: true
            });
        }

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            debugger;
            switch (ds.id) {
                case '${/parameter/@layout_code}_F_EXTERNAL_PROGRAM_prj_quotation_ds':
                    var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    var chance_id = chance_record.get('chance_id');

                    if(chance_id){
                        qpara['document_id'] = chance_id;
                        qpara['source_document_id'] = chance_id;
                    }else{
                        qpara['document_id'] = "${/model/chance_record_path/record/@chanceId}";
                        qpara['source_document_id'] = "${/model/chance_record_path/record/@chanceId}";
                    }
                    qpara['source_document_category'] = 'HLS_CREDIT_LINE_CHANCE';
                    // qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds':
                    var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    var chance_id = chance_record.get('chance_id');
                    if(chance_id){
                        qpara['document_id'] = chance_id;
                        qpara['source_document_id'] = chance_id;
                    }else{
                        qpara['document_id'] = "${/model/chance_record_path/record/@chance_id}";
                        qpara['source_document_id'] = "${/model/chance_record_path/record/@chance_id}";
                    }
                    qpara['source_document_category'] = 'HLS_CREDIT_LINE_CHANCE';
                    // qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_F_CREDIT_PROGRAM_hls_credit_plan':
                    var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    var chance_id = chance_record.get('chance_id');
                    if(chance_id){
                        qpara['document_id'] = chance_id;
                        qpara['source_document_id'] = chance_id;
                    }else{
                        qpara['document_id'] = "${/model/chance_record_path/record/@chanceId}";
                        qpara['source_document_id'] = "${/model/chance_record_path/record/@chanceId}";
                    }
                    qpara['source_document_category'] = 'HLS_CREDIT_LINE_CHANCE';
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            debugger;
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance','F_PRJ_BASIC');
            var chance_record = $(chance_ds_id).getCurrentRecord();
            var chance_id = chance_record.get("chance_id");


            //"PRJ001F1WFL_G_LEASE_ITEM_EQUIPMENT_hls_credit_chance_lease_item_ds"


            if (ds.id === '${/parameter/@layout_code}_G_ATTACHMENT_hls_credit_line_attach_ds') {
                //ds.setQueryParameter('source_key', project_id);
                if(chance_id != null || chance_id != '' ){
                    qpara['chance_id'] = chance_id;
                }
            }
            if (ds.id === '${/parameter/@layout_code}_F_CUSTOMER_INFO_hls_credit_line_chance_bp_ds') {
                var marketing_report_number =  '${/parameter/@marketing_report_number}';
                if(chance_id == null || chance_id == '' ){
                    if(marketing_report_number != null ){
                        var url = "${/request/@context_path}/hls/credit/bp/market?marketingReportId=" + marketing_report_number;
                        ds.setQueryUrl(url);
                    }

                }else{
                    qpara['chance_id'] = chance_id;
                }

            }


            var chance_business_access_compare_ds_id = "${/parameter/@layout_code}_G_BUSINESS_ADMITTANCE_chance_business_access_compare_ds";
            if(ds.id===chance_business_access_compare_ds_id){
                qpara['document_id'] = chance_id;
            }

            if (ds.id === '${/parameter/@layout_code}_F_PRJ_BASIC_hls_credit_line_chance') {
                qpara['chance_id'] = chance_id;
            }

            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';

        };


        //新增和加载时调用(form)
        /* window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
             debugger;

         };*/

        window['${/parameter/@layout_code}_G_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTACHMENT');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage("提示", "请选择需要导出的附件!", null);
                return;
            }

            var exportList = [];

            for (var i = 0; i < records.length; i++) {
                debugger;
                if(records[i].get('attachment_id') != null){
                    for(var item of records[i].get('attachment_id').split(",")) {
                        exportList.push(item);
                    }
                }
            }

            if(exportList.length == 0){
                Leaf.showMessage("提示", "无附件可导出!", null);
                return;
            }

            for (var i = 0; i < exportList.length; i++) {
                //解决多次调用location.href时只能下载最后一次的文件问题
                var a = document.createElement('a');
                a.href = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + exportList[i];
                a.download = 'filename';
                a.click();
            }
        };

        //报价计算入口
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list+'&readOnly=Y';
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel查看',
                fullScreen: true,
                document_history_flag:true
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
            });
        }


        Leaf.onReady(function() {
            var input = document.createElement('input');
            document.body.appendChild(input);
            Ext.fly(input).moveTo(-10000, -10000);
            input.focus();
            setTimeout(function() {
                Ext.fly(input).remove();
            }, 1000);

            $('${/parameter/@layout_code}_submit_approval').hide();
            $('${/parameter/@layout_code}_exit').hide();
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>