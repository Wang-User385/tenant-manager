<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-08
    $Description: 立项明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjQuotationService.queryBaseRateNow"
                       rootPath="quote_record_path"/>
        <a:model-query model="$com.hand.hls.fct.service.HlsCusHlsCreditLineChanceService.queryChanceId"
                       rootPath="chance_record_path"/>
    </a:init-procedure>

    <a:view>
        <a:link id="prj_chance_wfl_approve"
                url="${/request/@context_path}/hls/credit/line/chance/condition/submitApproval"/>
        <a:link id="prj_chance_save" url="${/request/@context_path}/hls/credit/line/chance/condition/cascadeSubmit"/>
        <a:link id="prj_add_query" url="${/request/@context_path}/hls/cus/fct/manager/query"/>

        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="prj001_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="prj001_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="prj_lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="PRJ_SW001_PLEDGE_LEASE"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="lease_query_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="sw001_pledge_lease_query"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>

        <!--<a:link id="prj100_prj_wfl_submit_link_id" url="${/request/@context_path}/ct/prj/project/change/submit/wfl"/>
        <a:link id="prj100_prj_change_cancel_link_id" url="${/request/@context_path}/ct/prj/change/cancel"/>-->

        <a:link id="prj001_chance_change_wfl_submit_link_id" url="${/request/@context_path}/hls/credit/line/chance/change/submit/wfl"/>
        <a:link id="prj001_chance_change_cancel_link_id" url="${/request/@context_path}/hls/credit/line/chance/change/cancel"/>
        <script><![CDATA[

        var chance_id_flag = '${/parameter/@chance_id}';
        var credit_flag =  '${/parameter/@credit_flag}';


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            // debugger;
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','F_EXTERNAL_PROGRAM');
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PRJ_BASIC');
            var credit_plan_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan','F_CREDIT_PROGRAM');
            if (ds.id == quotation_ds_id) {
                if(name=='lease_item_amount'  && value){
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    chance_record.set('credit_line_amt',value);
                    quotation_record.set('finance_amount',value );
                    quotation_record.set('down_payment',quotation_record.get('down_payment_ratio') * value);
                    quotation_record.set('deposit',quotation_record.get('deposit_ratio') * value);
                    quotation_record.set('lease_charge',quotation_record.get('lease_charge_ratio') * value);
                }
                if(name=='lease_item_amount_w' && value){
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    chance_record.set('credit_line_amt',value * 10000);
                    quotation_record.set('finance_amount',value * 10000);
                    quotation_record.set('lease_item_amount',value * 10000);
                }
                if(name=='renting_method' && value == 'OTHER'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.getField('other_payment_methods').setReadOnly(false);
                    quotation_record.getField('other_payment_methods').setRequired(true);
                }
                if(name=='renting_method' && value != 'OTHER'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.getField('other_payment_methods').setReadOnly(true);
                    quotation_record.getField('other_payment_methods').setRequired(false);
                    quotation_record.set('other_payment_methods','');
                }
                if(name=='lease_term_m'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.set('lease_term',div(value, 12));
                }
                if(name=='down_payment_ratio'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.set('down_payment',quotation_record.get('lease_item_amount') * value);
                }
                if(name=='deposit_ratio'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.set('deposit',quotation_record.get('lease_item_amount') * value);
                }
                if(name=='lease_charge_ratio'){
                    var quotation_record = $(quotation_ds_id).getCurrentRecord();
                    quotation_record.set('lease_charge',quotation_record.get('lease_item_amount') * value);
                }
            }
            //授信项目的项目金额赋值
            if (ds.id == credit_plan_ds_id ) {
                if(name=='credit_amt'  && value){
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    chance_record.set('credit_line_amt',value);
                }
            }
        };

        var docList=new Array();


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            //debugger;
            if(ds.id=="PRJ001F1_G_ATTACHMENT_hls_credit_line_attach_ds"){
                if(record.data != 'undefined' && record.data !=null && record.data != '') {
                    if (record.data.necessary_upload_flag == 'Y' && (record.data.document_name.indexOf("立项申请表") != -1)) {
                        var doc = "PRJ001F1_G_ATTACHMENT_hls_credit_line_attach_layout_grid_id_document_name_" + record.id;
                        docList.add(doc);
                    }
                }
            }
        };
        function f(){
            for(let i = 0, len = docList.length; i < len; i++){
                if(document.getElementById(docList[i])!=null){
                    document.getElementById(docList[i]).style.color="red";
                }
            }
        }
        setInterval(f,1);


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq){
            // debugger;
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PRJ_BASIC');
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','F_EXTERNAL_PROGRAM');

            if (ds.id == chance_ds_id) {
                var chance_record = $(chance_ds_id).getCurrentRecord();
                if (!chance_id_flag) {
                    record.set('credit_line_name', '${/parameter/@credit_line_name}');
                    record.set('project_assistant', '${/parameter/@project_assistant}');
                    record.set('project_assistant_n', '${/parameter/@project_assistant_n}');
                    record.set('credit_flag', '${/parameter/@credit_flag}');
                    record.set('credit_flag_n', '${/parameter/@credit_flag_n}');
                    record.set('business_type', '${/parameter/@business_type}');
                    record.set('business_type_n','${/parameter/@business_type_n}');
                    record.set('proposer_employee_id', '${/parameter/@proposer_employee_id}');
                    record.set('proposer_employee_id_n', '${/parameter/@proposer_employee_id_n}');
                    record.set('unit_id_n', '${/parameter/@unit_id_n}');
                    record.set('unit_id', '${/parameter/@unit_id}');
                    record.set('company_id', '${/parameter/@company_id}');
                    record.set('company_id_n', '${/parameter/@company_id_n}');
                    record.set('industry', '${/parameter/@industry}');
                    record.set('industry_n', '${/parameter/@industry_n}');
                    record.set('industry_type', '${/parameter/@industry_type}');
                    record.set('industry_type_n', '${/parameter/@industry_type_n}');
                    record.set('document_category', 'HLS_CREDIT_LINE_CHANCE');
                }
            }
            var quote_record ;
            if ('${/parameter/@function_usage}' == 'CREATE' && ds.id === quote_ds_id) {
                // debugger;
                quote_record = $(quote_ds_id).getCurrentRecord();

                if (quote_record) {
                    quote_record.set('business_type', '${/parameter/@business_type}');
                    quote_record.set('business_type_n', '${/parameter/@business_type_n}');
                    quote_record.set('int_rate_type', 'FLOATING');
                    quote_record.set('int_rate_type_n', '浮动利率');
                    if (!'${/parameter/@marketing_report_id}' && ($(chance_ds_id).getCurrentRecord().get('chance_id') == '' || $(chance_ds_id).getCurrentRecord().get('chance_id') == undefined)) {
                        quote_record.set('base_rate_collect', '${/model/quote_record_path/record/@base_rate_set}');
                        quote_record.set('base_rate_collect_n', '${/model/quote_record_path/record/@base_rate_description1}');
                        quote_record.set('base_rate_type', '${/model/quote_record_path/record/@base_rate_description2}');
                        quote_record.set('base_rate_type_n', '${/model/quote_record_path/record/@base_rate_description2}');
                        quote_record.set('base_rate', '${/model/quote_record_path/record/@base_rate}');
                        //quote_record.set('int_rate', '${/model/quote_record_path/record/@base_rate}');
                    }
                }
            }

            if (ds.id === quote_ds_id) {
                debugger;
                quote_record = $(quote_ds_id).getCurrentRecord();

                if('${/parameter/@function_usage}' != 'QUERY'){
                    if ($(quote_ds_id).getCurrentRecord().get('renting_method') === 'OTHER') {
                        quote_record.getField('other_payment_methods').setRequired(true);
                        quote_record.getField('other_payment_methods').setReadOnly(false);
                    }
                }

                //'${/parameter/@layout_code}_layoutDataSetList'
                //var name =document.getElementById('PRJ001F1_CHANGE_F_EXTERNAL_PROGRAM_PRJ_QUOTATION_LEASE_CHARGE_RATIO_prompt');
                var name =document.getElementById('${/parameter/@layout_code}_F_EXTERNAL_PROGRAM_PRJ_QUOTATION_LEASE_CHARGE_RATIO_prompt');
                if ($(chance_ds_id).getCurrentRecord().get('business_type')==='LEASE') {
                    name.innerHTML='<span class="prompt-required" title="lease_charge_ratio">*</span>手续费率(%)（以首期租金方式收取）';
                }else{
                    name.innerHTML='<span class="prompt-required" title="lease_charge_ratio">*</span>手续费率(%)（以首期租金方式收取）';
                }
            }

            //根据是否授信动态展示报价方案与授信方案
            debugger;
            if(credit_flag == 'Y'){
                //隐藏报价方案组件 #PRJ001F1WFL_T_EXTERNAL_PROGRAM_component_id
                $jq('#${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id').hide(1);
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").hide(1);
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").prev().hide(1);
                $jq("div[name='${/parameter/@layout_code}_T_EXTERNAL_PROGRAM_component_id']").next().hide(1);
            }else{
                //隐藏授信方案组件
                $jq('#${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").next().hide();
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','T_EXTERNAL_PROGRAM');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan','F_CREDIT_PROGRAM');
            if(credit_flag == 'Y' && ds.id == quote_ds_id){
                //取消报价方案必填校验
                debugger
                record.getField('lease_item_amount').setRequired(false);
                record.getField('renting_method').setRequired(false);
                record.getField('renting_method_n').setRequired(false);
                record.getField('irr').setRequired(false);
                record.getField('int_rate').setRequired(false);
                record.getField('lease_term').setRequired(false);
                record.getField('lease_term_m').setRequired(false);
                record.getField('residual_value').setRequired(false);
            }
            if(credit_flag == 'N' && ds.id == credit_ds_id) {
                //取消授信方案必填校验
                record.getField('credit_amt').setRequired(false);
                record.getField('quota_type').setRequired(false);
                record.getField('quota_type_n').setRequired(false);
                record.getField('conglomerate_flag').setRequired(false);
                record.getField('conglomerate_flag_n').setRequired(false);
                record.getField('belong_conglomerate').setRequired(false);
                record.getField('date_from').setRequired(false);
                record.getField('date_to').setRequired(false);
                record.getField('credit_desc').setRequired(false);
            }
            //授信项目类型得单据业务类型/业务板块/行业分类只读
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance','F_PRJ_BASIC');
            if(credit_flag == 'Y' && ds.id == base_ds_id){
                record.getField('industry').setReadOnly(true);
                record.getField('industry').setRequired(false);
                record.getField('business_type').setReadOnly(true);
                record.getField('business_type').setRequired(false);
                record.getField('industry_type').setReadOnly(true);
                record.getField('industry_type').setRequired(false);
                record.getField('industry_n').setReadOnly(true);
                record.getField('industry_n').setRequired(false);
                record.getField('business_type_n').setReadOnly(true);
                record.getField('business_type_n').setRequired(false);
                record.getField('industry_type_n').setReadOnly(true);
                record.getField('industry_type_n').setRequired(false);
            }

        };



        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_F_EXTERNAL_PROGRAM_prj_quotation_ds':
                    var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    if(chance_record){
                        var chance_id = chance_record.get('chance_id');
                        if (chance_id) {
                            qpara['document_id'] = chance_id;
                            qpara['source_document_id'] = chance_id;
                        } else {
                            qpara['document_id'] = "-1";
                            qpara['source_document_id'] = "-1";
                        }
                        qpara['source_document_category'] = 'HLS_CREDIT_LINE_CHANCE';
                    }else{
                        qpara['document_id'] = "-1";
                        qpara['source_document_id'] = "-1";
                    }
                    break;
                case '${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds':
                    var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    var chance_record = $(chance_ds_id).getCurrentRecord();
                    if(chance_record){
                        var chance_id = chance_record.get('chance_id');
                        if (chance_id) {
                            qpara['document_id'] = chance_id;
                            qpara['source_document_id'] = chance_id;
                        } else {
                            qpara['document_id'] = "-1";
                            qpara['source_document_id'] = "-1";
                        }
                    }else{
                        qpara['document_id'] = "-1";
                        qpara['source_document_id'] = "-1";
                    }

                    qpara['source_document_category'] = 'HLS_CREDIT_LINE_CHANCE';
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // debugger;
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var chance_record = $(chance_ds_id).getCurrentRecord();
            var chance_id;
            if (chance_id_flag) {
                chance_id = chance_id_flag;
            } else {
                chance_id = chance_record.get('chance_id');
            }


            if (ds.id === '${/parameter/@layout_code}_G_ATTACHMENT_hls_credit_line_attach_ds') {
                //ds.setQueryParameter('source_key', project_id);
                if (chance_id != null || chance_id != '') {
                    qpara['chance_id'] = chance_id;
                }
            }
            if (ds.id === '${/parameter/@layout_code}_F_CUSTOMER_INFO_hls_credit_line_chance_bp_ds') {
                var marketing_report_number = '${/parameter/@marketing_report_number}';
                if (chance_id == null || chance_id == '') {
                    if (marketing_report_number != null) {
                        var url = "${/request/@context_path}/hls/credit/bp/market?marketingReportId=" + marketing_report_number;
                        ds.setQueryUrl(url);
                    }

                } else {
                    qpara['chance_id'] = chance_id;
                }

            }

            if (ds.id === '${/parameter/@layout_code}_G_BUSINESS_ADMITTANCE_chance_business_access_compare_ds') {
                if (chance_id != null || chance_id != '') {
                    qpara['document_id'] = chance_id;
                }
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';

            debugger;
            //变更对比查询参数设置
            if(ds.id == 'PRJ001F1_CHANGE_G_CHANGE_BASE_INFO__ds'){
                qpara.chance_id = Number(chance_id);
            }
            if(ds.id == 'PRJ001F1_CHANGE_G_CHANGE_BUSINESS_ADMITTANCE__ds'){
                qpara.chance_id = Number(chance_id);
            }
        };

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            var check_flag = true;
            // debugger;
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PRJ_BASIC');
            var chance_record = $(chance_ds_id).getCurrentRecord();
            var chance_id = chance_record.get("chance_id");
            var credit_line_number = chance_record.get("credit_line_number");
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance_bp');

            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quo_reocrd = $(quotation_ds_id).getCurrentRecord();

            var proposer_employee_id=chance_record.get("proposer_employee_id");
            var project_assistant=chance_record.get("project_assistant");
            if(project_assistant != null && proposer_employee_id !=null){
                if(project_assistant == proposer_employee_id){
                    check_flag = false;
                    Leaf.showMessage("提示", "项目协办与项目主办不能为同一人!", null);
                }
            }


            //用于报价保存
            if (chance_id == null && check_flag) {
                Leaf.request({
                    url: "${/request/@context_path}/hls/credit/line/chance/id",
                    para: {
                        host_project_manager: '${/session/@userId}'
                    },
                    success: function (res) {
                        // debugger;
                        chance_id = res.result.record[0].chance_id;
                        $(chance_ds_id).getCurrentRecord().set('chance_id', chance_id);
                        quo_reocrd.set('document_id', chance_id);
                        quo_reocrd.set('source_document_id', chance_id);
                        quo_reocrd.set('source_document_category', 'HLS_CREDIT_LINE_CHANCE');
                    },
                    error: function () {
                        check_flag = false;
                        Leaf.showMessage("提示", "保存出错!", null);
                    },
                    sync: true,
                    scope: this
                });

            }
            var bp_records = $(bp_ds_id).getAll();
            var k = 0;
            var m = 0;
            //项目类型
            var business_type = chance_record.get("business_type");
            for (var i = 0; i < bp_records.length; i++) {
                for (var j = 0; j < bp_records.length; j++) {
                    if (bp_records[i].get('bp_id') == bp_records[j].get('bp_id')
                        && bp_records[i].get('bp_type') == bp_records[j].get('bp_type')) {
                        k++;
                    }
                }
                if (bp_records[i].get('bp_type') == "TENANT") {
                    m++;
                }
            }
            if (k > bp_records.length) {
                Leaf.showMessage('提示', '同一角色的客户不能添加多次');
                check_flag = false;
            }
            if (m > 1) {
                Leaf.showMessage('提示', '承租人有且只能有一个！');
                check_flag = false;
            }
            if (m == 0) {
                Leaf.showMessage('提示', '必须维护一个承租人！');
                check_flag = false;
            }

            if (credit_line_number == null && check_flag) {
                var document_category = 'PRJ_PROJECT';
                var document_type = 'PRJ_PROJECT';
                var business_type = 'LEASE';

                window['${/parameter/@layout_code}_set_authority_rule_string']();
                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                    success: function (res) {
                        chance_record.set('credit_line_number', res.result.record[0]);
                        check_flag = true;
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    },
                    sync: true,
                    scope: this
                });
            }
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        };

        //生成权限字符串
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            //debugger;
            Leaf.request({
                url: "${/request/@context_path}/hls/credit/line/chance/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };


        //忽略保存校验方法
        window['${/parameter/@layout_code}_ignore_required_before_save'] = function () {
            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
        };

        function submit() {
            // debugger;
            var checkAttachFlag = 'Y';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PRJ_BASIC');
            var record = $(ds_id).getCurrentRecord();
            var chanceId = record.get('chance_id');
            var hlsCusHlsCreditLineChance = {chanceId: chanceId};

            var attachment_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTACHMENT_INFO');

            Leaf.request({
                url: $('prj_chance_wfl_approve').getUrl(),
                jsonData: {hlsCusHlsCreditLineChance: hlsCusHlsCreditLineChance},
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    if (res.success) {
                        Leaf.showInfoMessage("提示", "提交成功!", function () {
                            $('${/parameter/@winid}').close();
                            var winId = '${/parameter/@entrance_winid}';
                            if (!!winId) {
                                $(winId).close();
                            }

                            $('${/parameter/@ds_id}').query();
                        });
                    }
                },
                failure: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "审批失败!");
                },
                error: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "审批失败，服务器错误!");
                },
                scope: this
            });
        }





        function lease001_detail_open(record_id, ds_id, contract_status) {
            //debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '详细信息';
            var link_id;
            if (param.lease_item_type == 'LEASE') {
                param['function_code'] = 'LEASE001F1';
                link_id = 'lease_query_detaill_id';
            } else {
                param['function_code'] = 'SW001F1';
                link_id = 'sw001_pledge_lease_query';
            }
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            //debugger;
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if (name == 'finnance_info') {
                return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }

            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }

            if(record.data.necessary_upload_flag=='Y' && name=='document_name'){
                return '<div  style="color: #DC143C;">'+record.data.document_name+'</div>';
            }
            if(name == 'attachment_detail'){
                return '<a href="javascript:open_attach(\'' + record.id + '\',\'' + record.get('chance_attachment_id') + '\',\'' + record.ds.id + '\')">附件上传</a>';
            }


            if (name === 'lease_item_code') {
                var link_function = 'lease001_detail_open';
                if (value) {
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + record.get('contract_status') + '\');">' + value + '</a>';

                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + record.get('contract_status') + '\');"></a>';

            }

            return value;
        };

        //打开附件窗口
        function open_attach(record_id, id, ds_id) {
            // debugger
            var record = $(ds_id).findById(record_id);
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }

            var url;
            var table_name;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                //url = '${/request/@context_path}/downloadFile.lview';
                $L.showInfoMessage("提示", "当前无法上传文件!");
                return;
            } else {
                if (record.get('attachment_category') === 'HLS_CREDIT_CHANCE_DOCX') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'HLS_CREDIT_CHANCE_DOCX';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'HLS_CREDIT_LINE_CHANCE';
                }
            }
            var win = new Leaf.Window({
                id: 'chance_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: table_name,
                    winid: 'chance_open_attachment_winid'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach');
                $(ds_id).query();
            });
        }

        window['approval_upload_file'] = function (record_id, chance_attachment_id) {
            // debugger
            if (typeof (chance_attachment_id) === 'undefined' || 'undefined' === chance_attachment_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': chance_attachment_id,
                    'table_name': 'hls_credit_line_chance',
                    winid: 'prj320_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var arr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach');
                $(arr_ds_id).query();
            });
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid';

            if ('${/parameter/@wfl_bp_flag}' == 'Y') {
                parent.parent_bp_chance_detail(param, ds_id);
            } else {
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win(ds_id, record_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var bp_id = param.bp_id;
            var bp_name = param.bp_id_n;
            var bp_code = param.bp_code;

            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: 'QUERY',
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 850,
                height: 535,
                side: "right",
                draggable: true
            });
        }


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach');
            if (ds.id === ds_id) {
                record.set('upload_person', '${/session/@user_id}');
                record.set('upload_date', new Date());
                record.set('attachment_category', 'CHANCE_ATT');
            }
        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            //debugger;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var parentRecord = $('${/parameter/@layout_code}_F_PRJ_BASIC_hls_credit_line_chance_ds').getAt(0);
            //生成资料清单
            window['${/parameter/@layout_code}_generate_sys_document_list'](parentRecord.get("chance_id"), "PRJ_CHANCE");
            //生成准入对照
            window['${/parameter/@layout_code}_generate_access_compare'](parentRecord.get("chance_id"));

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            $(ds_id).setQueryParameter('chance_id', parentRecord.get("chance_id"));
            $(ds_id).query();

            //变更比对组件更新
            $('PRJ001F1_CHANGE_G_CHANGE_BASE_INFO__ds').query();
            $('PRJ001F1_CHANGE_G_CHANGE_BUSINESS_ADMITTANCE__ds').query();
        }

        //生成资料清单
        window['${/parameter/@layout_code}_generate_sys_document_list'] = function (document_id, document_category) {
            // debugger;
            jQuery.ajax({
                type: 'GET',
                url: "${/request/@context_path}/sys/document/list/generate?documentId=" + document_id + "&documentCategory=" + document_category,
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (!response.success) {
                        $L.showErrorMessage("提示", response.message, null, 200, 100);
                    } else {
                        var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_hls_credit_line_attach_ds";
                        $(document_list_ds_id).query();
                    }
                }
            });
        }

        //生成准入对照
        window['${/parameter/@layout_code}_generate_access_compare'] = function (document_id) {
            // debugger;
            Leaf.request({
                url: "${/request/@context_path}/chance/access/compare/generate",
                para: {documentId: document_id},
                success: function (res) {
                    //debugger;
                    var chance_business_access_compare_ds_id = "${/parameter/@layout_code}_G_BUSINESS_ADMITTANCE_chance_business_access_compare_ds";
                    $(chance_business_access_compare_ds_id).setQueryParameter('document_id', document_id);
                    $(chance_business_access_compare_ds_id).query();
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        //业务准入对照导入
        window['${/parameter/@layout_code}_G_BUSINESS_ADMITTANCE_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var compare_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'chance_business_access_compare');
            var base_record = $(base_ds_id).getCurrentRecord();
            var chance_id = base_record.get('chance_id');
            if(chance_id == '' || chance_id == 'undefined' || chance_id == null){
                Leaf.showInfoMessage("提示" , "请先保存再进行导入操作！");
                return;
            }
            var win = new Leaf.Window({
                id: 'chance_access_compare_import_win_id',
                params: {
                    winid: 'chance_access_compare_import_win_id'
                },
                url: '${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/chance_access_compare_import.lview?chance_id='+chance_id,
                title: '业务准入对照导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(compare_ds_id).query();
            });
        }


        window['${/parameter/@layout_code}_G_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_ATTACHMENT');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage("提示", "请选择需要导出的附件!", null);
                return;
            }

            var exportList = [];

            for (var i = 0; i < records.length; i++) {
                debugger;
                if(records[i].get('attachment_id') != null){
                    for(var item of records[i].get('attachment_id').split(",")) {
                        exportList.push(item);
                    }
                }
            }

            if(exportList.length == 0){
                Leaf.showMessage("提示", "无附件可导出!", null);
                return;
            }

            for (var i = 0; i < exportList.length; i++) {
                //解决多次调用location.href时只能下载最后一次的文件问题
                var a = document.createElement('a');
                a.href = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + exportList[i];
                a.download = 'filename';
                a.click();
            }
        };



        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function(){
                var chance_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
                var chance_record = $(chance_ds).getCurrentRecord();


                Leaf.request({
                    url: $('prj001_chance_change_wfl_submit_link_id').getUrl(),
                    para: {
                        chance_id: chance_record.get('chance_id')
                    },
                    success: function (res) {

                        $L.showInfoMessage("提示","提交成功!",function(){
                            $('${/parameter/@winid}').close();
                        });
                    },
                    error: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            })
        };

        //变更作废
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var chance_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var chance_record = $(chance_ds).getCurrentRecord();

            $L.showConfirm("提示","确定作废当前变更!",function(){

                Leaf.request({
                    url: $('prj001_chance_change_cancel_link_id').getUrl(),
                    para: {
                        chance_id: '${/parameter/@source_chance_id}',
                        change_req_id: '${/parameter/@change_req_id}'
                    },
                    success: function (res) {

                        $L.showInfoMessage("提示","已取消此次变更!",function(){
                            $('${/parameter/@winid}').close();
                        });
                    },
                    error: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>