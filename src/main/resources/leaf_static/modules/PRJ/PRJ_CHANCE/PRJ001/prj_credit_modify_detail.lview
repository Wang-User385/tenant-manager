<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-08
    $Description: 立项明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjQuotationService.queryBaseRateNow"
                       rootPath="quote_record_path"/>
        <a:model-query model="$com.hand.hls.fct.service.HlsCusHlsCreditLineChanceService.queryChanceId"
                       rootPath="chance_record_path"/>
    </a:init-procedure>

    <a:view>
        <a:link id="prj_chance_wfl_approve"
                url="${/request/@context_path}/hls/credit/line/chance/condition/submitApproval"/>
        <a:link id="prj_chance_save" url="${/request/@context_path}/hls/credit/line/chance/condition/cascadeSubmit"/>
        <a:link id="prj_add_query" url="${/request/@context_path}/hls/cus/fct/manager/query"/>

        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="prj001_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="prj001_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="prj_lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="PRJ_SW001_PLEDGE_LEASE"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="lease_query_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="sw001_pledge_lease_query"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <script><![CDATA[
        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq){
            debugger;
            var chance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PR_BASIC');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan','F_CREDIT_PRO');
            var flag=record.data.conglomerate_flag_n;
            if("否"===flag){
                record.set("belong_conglomerate","");
                $jq('#PRJ003F1_F_CREDIT_PROGRAM_HLS_CREDIT_PLAN_BELONG_CONGLOMERATE > div > input').attr("readonly","readonly");
                $jq('#PRJ003F1_F_CREDIT_PROGRAM_HLS_CREDIT_PLAN_BELONG_CONGLOMERATE > div > input').css("background","#EEEEEE");
            }else if("是"===flag){
                $jq('#PRJ003F1_F_CREDIT_PROGRAM_HLS_CREDIT_PLAN_BELONG_CONGLOMERATE > div > input').attr("readonly",false);
                $jq('#PRJ003F1_F_CREDIT_PROGRAM_HLS_CREDIT_PLAN_BELONG_CONGLOMERATE > div > input').css("background","#FFFFFF");
            }
            if (ds.id == chance_ds_id) {
                var chance_record = $(chance_ds_id).getCurrentRecord();
                if (!chance_id_flag) {
                    record.set('credit_line_name', '${/parameter/@credit_line_name}');
                    //record.set('project_assistant', '${/parameter/@project_assistant}');
                    //record.set('project_assistant_n', '${/parameter/@project_assistant_n}');
                    record.set('bp_id', '${/parameter/@bp_id}');
                    record.set('bp_id_n', '${/parameter/@bp_id_n}');
                    record.set('credit_flag', '${/parameter/@credit_flag}');
                    record.set('credit_flag_n', '${/parameter/@credit_flag_n}');
                    record.set('business_type', '${/parameter/@business_type}');
                    record.set('business_type_n','${/parameter/@business_type_n}');
                    record.set('proposer_employee_id', '${/parameter/@proposer_employee_id}');
                    record.set('proposer_employee_id_n', '${/parameter/@proposer_employee_id_n}');
                    record.set('unit_id_n', '${/parameter/@unit_id_n}');
                    record.set('unit_id', '${/parameter/@unit_id}');
                    record.set('company_id', '${/parameter/@company_id}');
                    record.set('company_id_n', '${/parameter/@company_id_n}');
                    //record.set('industry', '${/parameter/@industry}');
                    //record.set('industry_n', '${/parameter/@industry_n}');
                    //record.set('industry_type', '${/parameter/@industry_type}');
                    //record.set('industry_type_n', '${/parameter/@industry_type_n}');
                    record.set('document_category', 'HLS_CREDIT_LINE_CHANCE');
                }

            }






        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>