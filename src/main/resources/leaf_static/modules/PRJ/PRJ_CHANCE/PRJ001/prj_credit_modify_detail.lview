        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                debugger;
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_PR_BASIC');
                var ds_id_re = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_CREDIT_PRO');
                var ds_id_at = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_attach', 'G_APPENDIX');
                // if (!$(ds_id_re).getAll() || $(ds_id_re).getAll().length === 0) {
                //     Leaf.showInfoMessage('提示', '应收账款信息不能为空！');
                //     return;
                // }
                // if (!$(ds_id_at).getAll() || $(ds_id_at).getAll().length === 0) {
                //     Leaf.showInfoMessage('提示', '附件信息不能为空！');
                // }     return;

                // var records = $(ds_id_at).getAll();
                // for (let i = 0; i < records.length; i++) {
                //     var record_at = records[i];
                //     if (!record_at.get('file_num') || record_at.get('file_num') === 0) {
                //         Leaf.showInfoMessage('提示', '文档名称为' + record_at.get('document_name') + '附件不能为空');
                //         return;
                //     }
                // }
                var record = $(ds_id).getCurrentRecord();
                var chance_id = record.get('chance_id');
                if (chance_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/hls/credit/line/chance/change/submit/wfl',
                            para: {
                                chance_id: chance_id
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();
                                Leaf.showSuccessMessage("提示", "提交审批成功!");
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                }

            })
        }


