<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_credit_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_credit_modify_detail.lview"/>
        <a:link id="prj_chance_new_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_chance_add.lview"/>
        <script><![CDATA[

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'prj001_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'credit_line_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'process_instance_id') {
                return '<a href="javascript:open_project_approve_history_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#68798a">审批明细查看</span></a>';
            }
        };

        function prj001_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var maintain_type = 'UPDATE';
            var function_usage = 'MODIFY';
            if (record.get('credit_line_status') != 'NEW' && record.get('credit_line_status') != 'REJECTED') {
                maintain_type = 'READONLY';
                function_usage = 'QUERY';
            }
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            param['url_title'] = '立项维护';
            param['function_code'] = 'PRJ003F1';
            var link_id = 'prj_credit_detail_id';
            param['winid'] = 'prj_chance_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ001', null, null);
        }

        function open_project_approve_history_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var process_instance_id = param['process_instance_id'];

            new Leaf.Window({
                id: 'PRJ001_approve_history_winid',
                params: {
                    winid: 'PRJ001_approve_history_winid',
                    id: process_instance_id
                },
                url: '${/request/@context_path}/modules/MYWFL/MYWFL002/process_approve_history.lview',
                title: '审批明细',
                fullScreen:true
            });
        };

        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var param = {};
            param['url_title'] = '立项新增';
            param['function_code'] = 'PRJ001F2';
            param['unit_id'] = '${/session/@unitId}';
            param['winid'] = 'prj_chance_new_winid';
            param['ds_id'] = ds_id;
            param['screen_width'] = '600';
            param['side'] = 'right';
            param['proposer_employee_name'] = '${/session/@employeeName}';
            var link_id = 'prj_chance_new_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ001');
        };


        //删除
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var hlsCusHlsCreditLineChances=[];
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance');
            var chanceRecord = $(ds_id).getSelected();
            var closeFlag = 'Y';
            if(chanceRecord.length != 0 ){
                for (var i=0;i<chanceRecord.length;i++){
                    if(chanceRecord[i].data.credit_line_status == 'NEW' ){
                        hlsCusHlsCreditLineChances.push(chanceRecord[i].data);
                    }else{
                        closeFlag='N';
                    }
                }
            }

            if(chanceRecord.length == 0){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示','请选择需要关闭的项目!');
            }else if(closeFlag == 'N'){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示','非新建状态的单据，无法关闭!')
            }else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认关闭吗?', function okFun() {
                    Leaf.request({
                        url: '${/request/@context_path}/hls/credit/line/chance/closeCreditChance',
                        para:  hlsCusHlsCreditLineChances,

                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                });
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
