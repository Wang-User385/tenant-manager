<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-21
    $Description: 工作流跳转页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj003f1_link_id2"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_credit_modify_detail.lview"/>

        <script id="scriptA"><![CDATA[
        debugger;
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var function_code ='PRJ003F1';
        var wflurl = $('prj003f1_link_id2').getUrl();
        var risk_flag = 'N';
        var businessKey = '${/parameter/@businessKey}';
        var nodeId = parent.currentTaskInfo.task_definition_key;
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S1"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S2"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S3"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S4"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S4"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S5"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S6"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S7"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S8"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S9"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S10"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S11"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S12"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S13"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S14"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S15"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S16"){
            if(parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S1"){
                maintain_type = 'UPDATE';
                function_usage = 'MODIFY';
                wflurl = $('prj003f1_link_id2').getUrl()
                function_code ='PRJ003F1';
            }else {
                maintain_type = 'READONLY';
                function_usage = 'QUERY';
                wflurl = $('prj003f1_link_id2').getUrl()
                function_code ='PRJ003F1';
            }



        // 风险岗，录入风险协办信息
        }else if(parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S17"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S18"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S19"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S20"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S21"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S22"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S23"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S24"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S25"||
            parent.currentTaskInfo.task_definition_key == "CREDIT_CHANCE_CREATE_WFL_S26"){
            maintain_type = 'READONLY';
            function_usage = 'QUERY';
            risk_flag = 'Y'
                wflurl = $('prj003f1_link_id2').getUrl();
                function_code ='PRJ003F1_MEETING';

        }


        var pageChooser = new PageChooser({
            url: wflurl,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                chance_id: businessKey,
                maintain_type: maintain_type,
                function_usage: function_usage,
                node_id: nodeId,
                function_code: function_code,
                stream_flag: 'Y'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
/*
        function beforeSubmit(countiune) {
            if(true){
                $L.showInfoMessage("提示","请指定审批人!");
                return;
            }
            countiune();
        };*/

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

