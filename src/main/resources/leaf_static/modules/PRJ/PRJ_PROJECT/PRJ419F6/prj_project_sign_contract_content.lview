<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lipan
    $Date: 2024-07-15
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        $L.onReady(function () {
            debugger;
            // 隐藏审批历史导出按钮
            jQuery("#project_sign_content_grid_tb .grid-excel").hide();

            var projectId = parseInt('${/parameter/@project_id}');
            $('project_sign_content_detail_ds').setQueryUrl('${/request/@context_path}/ct/prj/project/sign/content/' + projectId);
            $('project_sign_content_detail_ds').query();
        })

        <!--render函数-->
        function formateDate(value, record, name) {
            if (value != "" && value != undefined) {
                var date = new Date(parseInt(value));
                var yy = date.getFullYear();
                var mm = "0" + (date.getMonth() + 1);
                var dd = "0" + (date.getDate());
                var hh = "0" + (date.getHours());
                var min = "0" + (date.getMinutes());
                var ss = "0" + (date.getSeconds());
                mm = mm.substring(mm.length - 2, mm.length);
                dd = dd.substring(dd.length - 2, dd.length);
                hh = hh.substring(hh.length - 2, hh.length);
                min = min.substring(mm.length - 2, mm.length);
                ss = ss.substring(ss.length - 2, ss.length);
                var dateStr = yy + '-' + mm + '-' + dd + ' ' + hh + ':' + mm + ':' + ss;
                return dateStr;
            } else {
                return "";
            }
        }

        <!--events-->
        function load_content_ds(ds) {
            var contentList = ds.data;
            contentList.forEach(function (item) {
                $('project_sign_content_info_ds').create({
                    "document_name": item.data.document_name,
                    "project_attachment_id": item.data.project_attachment_id,
                    "contract_number": item.data.contract_number,
                    "attachment_sum": item.data.attachment_sum,
                    "attachment_id": item.data.attachment_id,
                    "attachment_id_n": item.data.attachment_id_n,
                    "file_name": item.data.file_name,
                    "upload_date": item.data.upload_date,
                    "project_attachment_category": item.data.project_attachment_category
                });
            });
        }

        function render_file_ds_grid(value, record, name) {
            if (name == 'file_name') {
                if (record.get('attachment_sum') > 1) {
                    return '<a href="javascript:window[\'' + 'downloadFile' + '\'](\'' + record.id + '\');"><span style="color:#678098">附件' + '(' + record.get('attachment_sum') + ')' + '</span></a>';
                } else {
                    return '<a href="javascript:window[\'' + 'downloadFile' + '\'](\'' + record.id + '\');"><span style="color:#678098">附件</span></a>';
                }
            }
            return '';
        }

        function downloadFile(record_id) {
            var tableName = 'PRJ_PROJECT_ATTACHMENT';
            var ds_id = "project_sign_content_info_ds";
            var param = $(ds_id).findById(record_id).data;
            var project_attachment_id = param['project_attachment_id'];
            var url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'prj_sign_content_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': tableName,
                    winid: 'prj_sign_content_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件下载',
                width: 800,
                height: 475
            });
        }

        function batch_down_load() {
            var projectId = parseInt('${/parameter/@project_id}');
            var down_url = "${/request/@context_path}/ct/prj/project/sign/contentFileList?projectId=" + projectId;
            location.href = down_url;
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="project_sign_content_detail_ds">
                <a:events>
                    <a:event name="load" handler="load_content_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="project_sign_content_info_ds">
                <a:fields>
                    <a:field name="document_name" readOnly="true"/>
                    <a:field name="upload_date" readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form labelwidth="110" title="合同文本" labelWidth="100">
                <a:grid id="project_sign_content_grid" autoFocus="true" bindTarget="project_sign_content_info_ds"
                        width="1306" height="350"
                        navBar="false">
                    <a:toolBar>
                        <a:button click="batch_down_load" style="color:#4CAF50;" text="一键下载"></a:button>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="document_name" width="210" prompt="文件名称" align="center"/>
                        <a:column name="file_name" width="210" renderer="render_file_ds_grid" prompt="附件"
                                  align="center"/>
                        <a:column name="upload_date" width="210" prompt="上传时间" align="center"/>
                    </a:columns>
                </a:grid>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
