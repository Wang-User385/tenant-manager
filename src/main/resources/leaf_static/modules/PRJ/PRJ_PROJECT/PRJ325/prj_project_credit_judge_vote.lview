<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="hls200_marketing_report"
                url="${/request/@context_path}/modules/HLS/HLS200/hls_marketing_report_detail.lview"/>
        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="question_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ325/prj_project_judge_question_detail.lview"/>
        <script><![CDATA[

        Leaf.onReady(function () {
            debugger;
            var ds_id = '${/parameter/@layout_code}_F_QUERY_prj_project_meeting_approver_ds';
            var record = $(ds_id).getCurrentRecord();
            record.set('vote_status', 'TO_VOTE');
            record.set('vote_status_n', '待投票');
        });

        //项目维护
        function project_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            // var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            // console.log(param);
            hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);
        }

        //營銷报备
        function marketing_report_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'HLS200F1';
            param['url_title'] = '营销报备详情';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'marketing_report_winid';
            hls_doc_get_layout_code(param, 'hls200_marketing_report', ds_id, 'HLS200', null, null, '${/parameter/@layout_code}_autoQuery');
        }

        function prj325_comment_win_open(vote_result) {
            debugger;
            var ds_id = '${/parameter/@layout_code}_G_RESULT_prj_project_meeting_approver_ds';
            var records = $(ds_id).getSelected();
            if (records.length == 1) {
                for (var i = 0; i < records.length; i++) {
                    var vote_status = records[i].get('vote_status');
                    if (vote_status == 'VOTE_FINISH' || vote_status == 'VOTE_COMPLETE') {
                        Leaf.showMessage('提示', '投票结束与投票完成的项目投票结果不允许修改!');
                        return false;
                    }
                }
                var win = new Leaf.Window({
                    id: 'prj325_voting_comment_winid',
                    url: '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ325/prj_project_voting_comment.lview',
                    params: {
                        winid: 'prj325_voting_comment_winid',
                        ds_id: ds_id,
                        vote_result: vote_result

                    },
                    title: '意见填写',
                    width: 600,
                    height: 300
                });
            } else {
                Leaf.showMessage('提示', '请选择一条单据!');
                return false;
            }
        }

        //同意
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = '${/parameter/@layout_code}_G_RESULT_prj_project_meeting_approver_ds';
            var records = $(ds_id).getSelected();
            var data = [];
            if (records.length != 0) {
                for (var i = 0; i < records.length; i++) {
                    var vote_status = records[i].get('vote_status');
                    if (vote_status == 'VOTE_FINISH' || vote_status == 'VOTE_COMPLETE') {
                        Leaf.showMessage('提示', '投票结束与投票完成的项目投票结果不允许修改!');
                        return false;
                    }
                }
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确定同意?', function okFun() {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    for (var i = 0; i < records.length; i++) {
                        records[i].set('vote_result', 'AGREE');
                        records[i].set('vote_status', 'VOTE_COMPLETE');
                        records[i].set('__status', 'update');
                        data.push(records[i].data);
                    }
                    Leaf.request({
                        url: "${/request/@context_path}/prj/project/meeting/approver/submit",
                        para: data,
                        success: function () {
                            Leaf.SideBar.show({
                                msg: '提交成功',
                                duration: 2000
                            });
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }, function cancel() {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                });
            } else {
                Leaf.showMessage('提示', '请至少选择一条单据!');
                return false;
            }
        };
        //有条件同意
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            prj325_comment_win_open('CONDITIONAL_AGREE');
        };

        //否决
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            prj325_comment_win_open('VETO');
        };

        //续议
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            prj325_comment_win_open('FURTHER');
        };

        //意见草拟
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            prj325_comment_win_open('OPINION_DRAFT');
        };

        //审查报告
        function review_attachment_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var project_id = record.get('project_id');
            var project_attachment_id = record.get('review_project_attachment_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == undefined) {
                $L.showInfoMessage("提示", "审查报告未上传!");
                return;
            }

            var url;
            url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'PRJ_PROJECT_ATTACHMENT',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 500,
                height: 475
            });
            win.on('close', function () {
            });
        }

        //尽调报告
        function project_attachment_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var project_id = record.get('project_id');
            var project_attachment_id = record.get('project_attachment_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == undefined) {
                $L.showInfoMessage("提示", "审查报告未上传!");
                return;
            }

            var url;
            url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'FCT_PROJECT_ATTACHMENT',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 500,
                height: 475
            });
            win.on('close', function () {
            });

        }

        //问题反馈
        function question_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            //debugger;
            var param = record.data;
            param['function_code'] = "PRJ325F1";
            param['url_title'] = '问题详情';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            //console.log(param);
            hls_doc_get_layout_code(param,'question_detail_link_id' , ds_id, '${/parameter/@layout_code}');

        }

        //风险管理部意见
        // window['${/parameter/@layout_code}_user_button9_layout_dynamic_click'] = function () {debugger;
        //     var ds_id = '${/parameter/@layout_code}_G_RESULT_prj_project_meeting_approver_ds';
        //     var records = $(ds_id).getSelected();
        //     if (records.length != 1) {
        //         $L.showMessage('提示','请选择一条记录！');
        //         return false;
        //     }else{
        //         var project_id = records[0].get('project_id');
        //         var risk_attachment_id = records[0].get('risk_attachment_id');
        //         if (project_id == undefined || project_id == 0) {
        //             $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
        //             return;
        //         }
        //         if (risk_attachment_id == undefined) {
        //             $L.showInfoMessage("提示", "风险管理部意见未生成!");
        //             return;
        //         }
        //
        //         var url;
        //         url = '${/request/@context_path}/downloadFile.lview';
        //         var win = new Leaf.Window({
        //             id: 'prj316wfl_open_attachment_winid',
        //             url: url,
        //             params: {
        //                 'header_id': risk_attachment_id,
        //                 'table_name': 'FCT_PROJECT_ATTACHMENT',
        //                 winid: 'prj316wfl_open_attachment_winid',
        //                 function_usage: 'QUERY'
        //             },
        //             title: '文件上传下载',
        //             width: 500,
        //             height: 475
        //         });
        //         win.on('close', function () {
        //         });
        //     }
        // };


        //超链接
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            if (name === 'project_number' && value) {
                return '<a href="javascript:window[\'' + 'project_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name === 'marketing_report_number' && value) {
                return '<a href="javascript:window[\'' + 'marketing_report_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name === 'project_attachment_id' && value) {
                return '<a href="javascript:window[\'' + 'project_attachment_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">尽调报告</a>';
            }
            if (name === 'review_project_attachment_id' && value) {
                return '<a href="javascript:window[\'' + 'review_attachment_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">审查报告</a>';
            }
            if (name === 'question_detail') {
                return '<a href="javascript:window[\'' + 'question_detail_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">问题反馈详情</a>';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
