<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        window['answer_file'] = function(record_id,question_id) {
            debugger;
            var project_id = '${/parameter/@project_id}';
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (question_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var answer_file_flag = 'N';
            var function_usage = 'QUERY';

            if('${/parameter/@answer_file_flag}' == 'N'){
                answer_file_flag = 'N';
                function_usage = 'QUERY';
            }

            var url;
            if (answer_file_flag == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': question_id,
                    'table_name': 'PRJ_PROJECT_WFL_ANSWER',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_QUESTION_prj_project_wfl_question_ds";
                $(document_list_ds_id).query();
            });
        };

        window['question_file'] = function(record_id,question_id) {
            debugger;
            var project_id = '${/parameter/@project_id}';
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (question_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var question_file_flag = 'N';
            var function_usage = 'QUERY';

            var url;
            if (question_file_flag == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }

            if('${/parameter/@question_file_flag}' == 'N'){
                question_file_flag = 'N';
                function_usage = 'QUERY';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': question_id,
                    'table_name': 'PRJ_PROJECT_WFL_QUESTION',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_QUESTION_prj_project_wfl_question_ds";
                $(document_list_ds_id).query();
            });
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_QUESTION_prj_project_wfl_question_ds':
                    debugger;
                    var project_id = '${/parameter/@project_id}';
                    qpara['project_id'] = project_id;
                    //qpara['question_type'] = 'REVIEW';
                    break;
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
            if(name == 'question_file'){
                link_function = 'question_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('question_id') + '\');">' + '上传/下载' + '</a>';
            }
            if(name == 'answer_file'){
                link_function = 'answer_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('question_id') + '\');">' + '上传/下载' + '</a>';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
