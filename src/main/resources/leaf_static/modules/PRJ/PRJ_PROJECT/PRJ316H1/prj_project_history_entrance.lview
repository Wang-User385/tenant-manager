<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="prj316_project_history_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316H2/prj_project_history.lview"/>

        <script><![CDATA[

            //查询时调用(grid,table,gridBox)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
                if(ds.id == '${/parameter/@layout_code}_G_GRID_prj_project_ds'){
                    qpara['project_id'] = '${/parameter/@project_id}';
                }
            };

            //超链接渲染
            window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
                var link_function;
                if (name == 'project_number') {
                    link_function = 'project_history';
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
                }
            };

            //报价历史
            function project_history(record_id, ds_id){
                var param = $(ds_id).findById(record_id).data;
                var function_code = 'PRJ316H2';
                param['url_title'] = '项目明细';
                param['winid'] = 'project_history_winid';
                param['function_code'] = function_code;
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                // console.log(param);
                hls_doc_get_layout_code(param, 'prj316_project_history_id', ds_id, function_code);
            }

       ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
