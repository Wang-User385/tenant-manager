<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

    <!--    <a:link id="project_credit_notice_detail_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_static.lview"/>-->
        <a:link id="project_credit_notice_detail_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_static_read.lview"/>

      <!--  <a:link id="project_credit_notice_detail_veto_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_veto.lview"/>-->
        <a:link id="project_credit_notice_detail_veto_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_veto_read.lview"/>

        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if(ds.id && '${/parameter/@layout_code}_G_INFO_prj_project_credit_notice_ds' == ds.id){
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
        };

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'project_notice_number_link') {
                return '<a href="javascript:project_credit_open_notice(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\',\'' +  record.get('credit_type')  + '\',\'' + record.get('instance_id')    + '\')">授信审批通知书</a>';
                // return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + 授信审批通知书  + '</a>';
            }
            if (name === 'risk_dept_opinion') {
                return '<a href="javascript:risk_dept_opinion(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\',\'' +  record.get('credit_type')  + '\',\'' + record.get('instance_id')    + '\')">风险部意见</a>';
            }
            if (name === 'review_committee_opinion') {
                return '<a href="javascript:review_committee_opinion(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('project_status') + '\',\'' +  record.get('credit_type') + '\')">业审委综合意见</a>';
            }
            if (name === 'project_approval_notice') {
                var credit_condition_content = record.get('credit_condition_content');
                var credit_condition_content_flag = 'N';
                if(credit_condition_content != null && credit_condition_content != '' && credit_condition_content != 'undefined'){
                    credit_condition_content_flag= 'Y';
                }
                return '<a href="javascript:project_approval_notice(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\',\'' +  record.get('credit_type')  + '\',\'' + record.get('instance_id')  + '\',\'' + credit_condition_content_flag  + '\')">项目审批通知书</a>';
            }
            if(name === 'price_approval_table'){
                return '<a href="javascript:price_approval_table(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\',\'' +  record.get('credit_type')  + '\',\'' + record.get('instance_id')    + '\')">价格审批意见</a>';
            }
            if (name === 'review_project_attachment_id' && value) {
                return '<a href="javascript:window[\'' + 'review_attachment_open' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">审查报告</a>';
            }
        };

        //审查报告
        function review_attachment_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var project_id = record.get('project_id');
            var project_attachment_id = record.get('review_project_attachment_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == undefined) {
                $L.showInfoMessage("提示", "审查报告未上传!");
                return;
            }

            var url;
            url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'PRJ_PROJECT_ATTACHMENT',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 500,
                height: 475
            });
            win.on('close', function () {
            });
        }

        function project_credit_open_notice(ds_id, record_id ,project_id , prj_notice_id , credit_type ,instance_id) {

            if(credit_type == "APPROVE"){
               var win = new Leaf.Window({
                   id: 'project_credit_notice_detail_winid',
                   url: $('project_credit_notice_detail_linkid').getUrl(),
                   params: {
                       winId: 'project_notice_detail_winid',
                       project_id: project_id,
                       function_usage: 'QUERY',
                       maintain_type: 'READONLY',
                       process_instance_id : instance_id
                   },
                   title: '授信审批通知书',
                   fullScreen: true,
                   draggable: true
               });
            }else if(credit_type == "HOLD"){
               var win = new Leaf.Window({
                   id: 'project_credit_notice_detail_veto_winid',
                   url: $('project_credit_notice_detail_veto_linkid').getUrl(),
                   params: {
                       winId: 'project_notice_detail_veto_winid',
                       project_id: project_id,
                       function_usage: 'QUERY',
                       maintain_type: 'READONLY',
                       process_instance_id : instance_id,
                       approve_result: 'HOLD'
                   },
                   title: '授信审批通知书',
                   fullScreen: true,
                   draggable: true
               });
           }else if(credit_type == "VETO"){
                var win = new Leaf.Window({
                    id: 'project_credit_notice_detail_veto_winid',
                    url: $('project_credit_notice_detail_veto_linkid').getUrl(),
                    params: {
                        winId: 'project_notice_detail_veto_winid',
                        project_id: project_id,
                        function_usage: 'QUERY',
                        maintain_type: 'READONLY',
                        process_instance_id : instance_id,
                        approve_result: 'VETO'
                    },
                    title: '授信审批通知书',
                    fullScreen: true,
                    draggable: true
                });
            }


        }

        function risk_dept_opinion(ds_id, record_id ,project_id , prj_notice_id , credit_type ,instance_id) {
            var down_url;
            var templateCode = '';
            templateCode= 'MEETING_RISK_OPINION';
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function review_committee_opinion(ds_id, record_id ,project_id , project_status, credit_type) {debugger;
            var down_url;
            var templateCode = '';
            if(credit_type == 'APPROVE'){
                //同意通知书模板
                templateCode= 'MEETING_COLLECT_OPINION';
            }else if(credit_type == 'VETO'){
                //暂缓或否决通知书模板
                templateCode = 'MEETING_COLLECT_OPINION_ANTI';
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            if(project_status == 'NOTICE_APPROVED' || project_status == 'NOTICE_VETO' || project_status == 'NOTICE_HOLD'){
                Leaf.request({
                    url: "${/request/@context_path}/ct/project/attachment/content/create?projectId=" + project_id
                        + '&templateCode=' + templateCode,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        //debugger;
                        var attachment_id = res.result.record[0].attachment_id;
                        down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                        location.href = down_url;
                        Leaf.SideBar.show({
                            msg: '生成成功',
                            duration: 2000
                        });
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }else{
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示','该项目未经上会！');
            }

        }

        function project_approval_notice(ds_id, record_id ,project_id , prj_notice_id , credit_type ,instance_id, credit_condition_content_flag) {
            var down_url;
            var templateCode = '';
            if(credit_type == 'APPROVE'){
                //同意通知书模板
                templateCode= 'NOTICE_OF_APPROVAL';
                if(credit_condition_content_flag == 'Y'){
                    templateCode= 'NOTICE_OF_APPROVAL_CHANGE';
                }
            }else if(credit_type == 'VETO'){
                //暂缓或否决通知书模板
                templateCode = 'NOTICE_OF_REJECT';
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function price_approval_table(ds_id, record_id ,project_id , prj_notice_id , credit_type ,instance_id) {
            var down_url;
            var templateCode = '';
            templateCode = 'PRICE_APPROVAL_TABLE';
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
