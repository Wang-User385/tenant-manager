<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body{
                height:2300px;
                width:1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="PRJ419_project_modify_new_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify_new.lview"/>

        <script><![CDATA[
        var nodeId = parent.currentTaskInfo.task_definition_key;
        var list = parent.currentTaskInfo.execution_variables;
        var work_flow;
        for (var i = 0; i < list.length; i++) {
            if(list[i].name === 'WORK_FLOW'){
                work_flow = list[i].value;
            }
        }

        var pageChooser = new PageChooser({
            url: $('PRJ419_project_modify_new_id').getUrl()+'?function_code=PRJ419F2',
            function_code: 'PRJ419F2',
            context_path: '${/request/@context_path}',
            opt: {
                project_id: "${/parameter/@businessKey}",
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                wfl_flag: 'Y',
                node_id:nodeId,
                work_flow:work_flow
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

