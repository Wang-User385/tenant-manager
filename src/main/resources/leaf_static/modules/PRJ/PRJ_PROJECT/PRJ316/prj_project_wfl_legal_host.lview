<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: lrd
    Date: 2020/02/24 14:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl_legal.lview"/>
        <a:link id="prj_project_wfl_detail_credit_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl_legal_credit.lview"/>
        <script><![CDATA[

        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "creditFlag";
        });
        var creditFlag = project[0].value;
        var fileFlag = 'N';
        var function_code = 'PRJ316F2WFL_LEGAL_OTHER';
        var url = $('prj_project_wfl_detail_link_id').getUrl();
        if(parent.currentTaskInfo.task_definition_key == "sid-rIua1mK8-6ELK-4qXe-8OQt-7Wq2k2f85i5J" ||
            parent.currentTaskInfo.task_definition_key == "sid-cWgYcnCs-L3MW-487O-8fKt-IgQgfrVCIJql"){
            function_code = 'PRJ316F2WFL_LEGAL_OTHER';
            url = $('prj_project_wfl_detail_link_id').getUrl();
            if(creditFlag === 'Y'){
                function_code = 'PRJ316F2WFL_CREDIT_LEGAL_OTHER';
                url = $('prj_project_wfl_detail_credit_link_id').getUrl();
            }
        }else{
            fileFlag = 'Y';
            function_code = 'PRJ316F2WFL_LEGAL';
            url = $('prj_project_wfl_detail_link_id').getUrl();
            if(creditFlag === 'Y'){
                function_code = 'PRJ316F2WFL_CREDIT_LEGAL';
                url = $('prj_project_wfl_detail_credit_link_id').getUrl();
            }
        }

        var data = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "dataType";
        });
        var dataType='';
        if(data.length>0) {
            dataType = data[0].value;
            if (dataType == 'CREDIT_NORMAL') {
                function_code = 'PRJ314F1_WFL_LEGAL';
            }
        }

        var pageChooser = new PageChooser({
            url: url,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id:      projectId,
                function_code:  function_code,
                legal_flag: "Y",
                file_flag: fileFlag,
                //,maintain_type: 'READONLY',
                //function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>