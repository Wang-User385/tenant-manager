<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: lrd
    Date: 2020/02/24 14:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl_lease.lview"/>
        <a:link id="prj_project_wfl_modify_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>

        <a:link id="prj_project_wfl_detail_credit_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl_lease_credit.lview"/>
        <a:link id="prj_project_wfl_modify_credit_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_credit.lview"/>
        <a:link id="prj314WFL_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_QUOTA/PRJ314/prj_project_modify.lview"/>
        <script><![CDATA[
        debugger;
        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "creditFlag";
        });
        var creditFlag = project[0].value;

       /* var param = parent.currentTaskInfo.execution_variables;
        var creditFlag = param.filter(function (o) {
            return o.name == "creditFlag";
        });*/

        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var function_code ='PRJ316F2WL1';
        var wflurl = $('prj_project_wfl_detail_link_id').getUrl();

        if(creditFlag == 'Y'){
            var function_code ='PRJ316F2WL1_CREDIT';
            var wflurl = $('prj_project_wfl_detail_credit_link_id').getUrl();
        }

        var data = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "dataType";
        });
        var dataType='';
        if(data.length>0) {
            dataType = data[0].value;
            if (dataType == 'CREDIT_NORMAL') {
                function_code = 'PRJ314F1_WFL';
            }
        }
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-rHAU6o6D-6QbN-4laU-89LQ-cSSMgkK3aMmb"  || parent.currentTaskInfo.task_definition_key == 'sid-8ugJcSm2-fQEr-4Zlx-87YT-lkJ29WvugfWs'){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
            function_code ='PRJ316F2';
            wflurl = $('prj_project_wfl_modify_link_id').getUrl();
            if(creditFlag == 'Y'){
                function_code ='PRJ316F2_CREDIT';
                wflurl = $('prj_project_wfl_modify_credit_link_id').getUrl();
            }
            if(dataType =='CREDIT_NORMAL'){
                function_code = 'PRJ314F1';
                wflurl = $('prj314WFL_project_modify_id').getUrl();
            }
        }

        var pageChooser = new PageChooser({
            url: wflurl,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                credit_flag: creditFlag,
                wfl_flag : 'Y',
                maintain_type: maintain_type,
                function_code: function_code,
                function_usage: function_usage,
                hidden_button_code: ['SUBMIT_APPROVAL', 'EXIT']
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>