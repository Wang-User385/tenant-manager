<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="project_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_credit.lview"/>
        <script><![CDATA[
        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'project_number') {
                return '<a href="javascript:prj316_detail_open(\'' + record.ds.id + '\',\'' + record.id + '\')">'+value+'</a>';
            }
        };
        function prj316_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '项目明细';
            param['function_code'] = 'PRJ316F1';
            var link_id = 'project_detail_id';
            param['winid'] = 'project_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ316F1', null, null);
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
