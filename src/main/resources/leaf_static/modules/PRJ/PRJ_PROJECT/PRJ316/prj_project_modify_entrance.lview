<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectProjectBp"
                       rootPath="prj_project_bp_path"/>
    </a:init-procedure>
    <a:view>
        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="prj316_project_modify_credit_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_credit.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project'):
                    qpara['created_by'] = '${/session/@user_id}';
                    break;
            }
        };
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            //查询项目商业伙伴信息
            if(record.get('project_id')){
                var paramData = [];
                paramData.push(record.data);

                var param = record.data, function_code = '';
                var business_type = param.business_type;
                param['url_title'] = '项目明细';
                param['winid'] = 'project_modify_winid';
                var project_status = record.get('project_status');
                if(project_status === 'NEW' || project_status === 'CANCEL'|| project_status === 'APPROVED_RETURN'|| project_status === 'SUSPEND'){
                    param['maintain_type'] = 'UPDATE';
                    param['function_usage'] = 'MODIFY';
                }else{
                    param['maintain_type'] = 'READONLY';
                    param['function_usage'] = 'QUERY';
                }
                if(business_type == 'T+0_LEASE_FACTORING' || business_type == 'T+N_LEASE_FACTORING' ){
                    function_code = 'PRJ316F2F2';
                }else if( business_type == 'LEASE_WITHOUT_RECOURSE_IN' || business_type == 'OPERATING_LEASE_WITHOUT_RECOURSE_IN' ){
                    function_code = 'PRJ316F2F3';
                }else{
                    function_code = 'PRJ316F2';
                }
                param['function_code'] = function_code;

                debugger;
                var credit_flag = record.get('credit_flag');
                if(credit_flag == 'Y'){
                    function_code = 'PRJ316F2_CREDIT';
                    param['function_code'] = 'PRJ316F2_CREDIT';
                    hls_doc_get_layout_code(param, 'prj316_project_modify_credit_id', ds_id, function_code);
                }else{
                    hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);
                }
            }

        }


        //关闭项目
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();
            var close_flag = 'Y';
            var project_number = '';
            var param = [];
            for(var i=0;i<records.length;i++){
                if(records[i].get('project_status') == 'APPROVED' || records[i].get('project_status') == 'APPROVING' ){
                    close_flag = 'N';
                    break;
                }else{
                    project_number = project_number + ',' + records[i].get('project_number');
                    param.push(records[i].data);
                }
            }
            if (records.length <= 0) {
                Leaf.showMessage('${l:PROMPT}', '${l:HLS.SELECT_RECORD}');
                return;
            } else if (close_flag == 'N') {
                Leaf.showErrorMessage('提示', '只有新建或者否决或者审批退回单据才可关闭！');
            } else {
                Leaf.showConfirm('警告', '项目:' + project_number + '即将关闭（<font color="red">注：项目关闭即撤销该项目，将无法再进行任何其它操作，请谨慎！</font>）' + ',${l:HLS.IS_CLOSE_CONFIRM}', function () {
                    ajax_flag = 'Y';
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/hls/cus/prj/project/close',
                        para: param,
                        success: function (res) {
                            parent.Leaf.SideBar.enable = true;
                            parent.Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            prj_project_result_ds.query(prj_project_result_ds.currentPage);
                        },
                        error: function (res) {
                            window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        faliure: function () {
                            window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }, null, 400).on('close', function () {
                    if (ajax_flag == 'N') {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }
                });
            }
        };

        //项目维护
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();


            if (records.length != 1) {
                $L.showInfoMessage("提示", "请选择一个项目进行维护!");
                return false;
            }
            var project_status = records[0].get('project_status');
            var instance_end_flag = records[0].get('instance_end_flag');
            var credit_flag = records[0].get('credit_flag');
            if (project_status != 'NEW' && project_status != 'SUSPEND' && project_status != 'NOTICE_HOLD') {
                $L.showInfoMessage("提示", "请选择项目状态为新建或者暂缓的项目进行维护!");
                return false;
            }

            if (project_status == 'SUSPEND' && instance_end_flag == 'N') {
                $L.showInfoMessage("提示", "该项目尚在制作审批通知书流程中，暂时不可维护!");
                return false;
            }

            var param = records[0].data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            param['maintain_type'] = 'MODIFY';
            param['function_usage'] = 'MODIFY';
            // console.log(param);
            if(credit_flag == 'Y'){
                param['function_code'] = 'PRJ316F2_CREDIT';
                function_code = 'PRJ316F2_CREDIT';
                hls_doc_get_layout_code(param, 'prj316_project_modify_credit_id', ds_id, function_code);
            }else{
                hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
