<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
    $Revision: 1.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <style>
            html,body{
                height: 500px;
                width: 90%;
            }

        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>

    <script id="scriptA"><![CDATA[

    var businessKey = '${/parameter/@businessKey}';
    var project_wfl_type = '${/parameter/@project_wfl_type}';
    var edit_type = '${/parameter/@edit_type}';

    var processInstanceId = '${/parameter/@processInstanceId}';
    if (businessKey != null && businessKey != '') {
        businessKey = parent.currentTaskInfo.process_instance.business_key;

        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var creditLine = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "creditLineId";
        });
        var creditLineId = creditLine[0].value;

        var finStatementHd = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "finStatementHdId";
        });
        var finStatementHdId = finStatementHd[0].value;

        var quotation = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "quotationId";
        });
        var quotationId = quotation[0].value;
    }





    function prj_project_wfl_meeting_info_grid_ds_select(ds,record){
        var num = ds.getSelected().length;
        $('prj_project_wfl_meeting_info_form_ds').getCurrentRecord().set('number_of_judges',num);
    }

    function meeting_open_project(){
        var param = {} , function_code = 'PRJ316F2';
        param['url_title'] = '项目明细';
        param['winid'] = 'project_modify_winid';
        param['function_code'] = function_code;
        param['maintain_type'] = 'READONLY';
        param['function_usage'] = 'QUERY';
        param['project_id'] = projectId;
        param['credit_line_id'] = creditLineId;
        param['fin_statement_hd_id'] = finStatementHdId;
        param['quotation_id'] = quotationId;
        hls_doc_get_layout_code(param, 'prj_project_wfl_detail_link_id', null, function_code);
    }

    function beforeSubmit(countiune) {
        if(project_wfl_type != 'meeting'){
            countiune();
            return;
        }
        if ($('prj_project_wfl_meeting_info_form_ds').validate()) {

            var data = $('prj_project_wfl_meeting_info_form_ds').getJsonData()[0];

            data.projectId = businessKey;
            data.documentId = businessKey;
            data.documentCategory = 'PRJ_PROJECT';
            data.meetingName = data.meeting_name;
            data.meetingDate = $jq('input[name="meeting_date"]').val();
            data.meetingTime = data.meetingDate;
            data.numberOfJudges = data.number_of_judges;
            data.processInstanceId = processInstanceId;

            var meetings = $('prj_project_wfl_meeting_info_grid_ds').getSelectedJson();

            if(meetings.length == 0){
                $L.showInfoMessage("提示","请至少选择一个评委进行上会！");
                return;
            }

            data.hlsCusActOnlineMeetingMemberList = [];
            for(var i = 0; i < meetings.length; i++){
                var obj = {};
                obj.onlineMeetingMemberCode = meetings[i].employee_code;
                obj.processInstanceId = processInstanceId;
                obj.projectId = businessKey;
                obj.projectDocumentCategory = 'PRJ_PROJECT';
                obj.allocationId = meetings[i].judge_user_allocation_id;
                data.hlsCusActOnlineMeetingMemberList.push(obj);
            }

            jQuery.ajax({
                url: '${/request/@context_path}/wfl/act/meeting/save?_csrf=${/session/@_csrf.token}',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (args) {
                    countiune();
                }
            })
        } else {
            return;
        }



    }

    //尽调报告附件上传
    function risk_report_file_upload() {
        if(projectId == null){
            $L.showInfoMessage("提示","获取项目信息异常，请您联系管理员处理!");
            return;
        }
        var url = '${/request/@context_path}/uploadFile.lview';

        var win = new Leaf.Window({
            id: 'prj316_open_attachment_winid',
            url: url,
            params: {
                'header_id': projectId,
                'table_name': 'PRJ_PROJECT_RISK_REPORT',
                winid: 'prj316_open_attachment_winid'
            },
            title: '文件上传下载',
            width: 800,
            height: 475
        });
        win.on('close', function () {
            $('prj_project_wfl_risk_report_info_grid_ds').query();
        });
    };

    function prj_project_wfl_risk_report_info_grid_ds_query(ds, qpara, bp_seq){
        qpara['project_id'] = projectId;
    }

    function prj_project_wfl_risk_list_info_grid_ds_query(ds, qpara, bp_seq){
        qpara['process_instance_id'] = processInstanceId;
    }

    function prj_project_wfl_risk_list_info_grid_ds_submitsuccess(ds){
        ds.query();
    }

    function risk_report_info_grid_down_load(value,record,name){
        return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id='+record.get('attachment_id')+'">下载</a>';
    }

    function prj_project_wfl_risk_list_info_grid_delete_attach_render(value,record,name){
        if(edit_type === 'read'){
            return '';
        }
        if(record.get('meeting_risk_list_id')) {
            return '<a href="javascript:removeRisk(\'' + record.get('meeting_risk_list_id') + '\')">删除</a>';
        }else{
            return "";
        }
    }

    function removeRisk(meeting_risk_list_id){
        Leaf.request({
            url: '${/request/@context_path}/act/meeting/risk/list/remove?riskId='+meeting_risk_list_id,
            success: function (res) {

                $L.showInfoMessage("提示","删除成功!",function(){
                    $('prj_project_wfl_risk_list_info_grid_ds').query();
                });
            },
            error: function (res) {
                $L.showInfoMessage("提示","删除失败!");
            },
            failure: function (res) {
                $L.showInfoMessage("提示","删除失败!");
            },
            sync: true,
            scope: this
        });
    }

    function prj_project_wfl_meeting_info_form_ds_load(ds){
        if(edit_type != null) {
            if(ds.getCurrentRecord()) {
                ds.getCurrentRecord().getField('meeting_name').setReadOnly(true);
                ds.getCurrentRecord().getField('meeting_date').setReadOnly(true);
            }else{
                ds.create({});
            }
        }
    }

    ]]></script>

        <a:dataSets>
            <a:dataSet id="meeting_risk_category_ds" lookupCode="FND.MEETING_RISK_TYPE">
            </a:dataSet>
            <a:dataSet id="prj_project_wfl_meeting_info_form_ds" autoCreate="true" autoQuery="true" queryUrl="${/request/@context_path}/wfl/act/meeting/query?processInstanceId=${/parameter/@processInstanceId}">
                <a:fields>
                    <a:field name="meeting_name" required="true"/>
                    <a:field name="meeting_date" required="true" datatype="date"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="prj_project_wfl_meeting_info_form_ds_load"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="prj_project_wfl_meeting_info_grid_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/prjmeetingjudge/query" selectable="true">
                <a:fields>
                    <a:field name="judge_id"/>
                    <a:field name="judge_user_allocation_id"/>
                </a:fields>
                <a:events>
                    <a:event name="select" handler="prj_project_wfl_meeting_info_grid_ds_select"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj_project_wfl_risk_report_info_grid_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/project/risk/report/query"
                       selectable="true">
                <a:events>
                    <a:event handler="prj_project_wfl_risk_report_info_grid_ds_query" name="query"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="prj_project_wfl_risk_list_info_grid_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/wfl/act/meeting/risk/list/query"
                       submitUrl="${/request/@context_path}/wfl/act/meeting/risk/list/save">
                <a:fields>
                    <a:field name="meeting_risk_category_desc" returnField="meeting_risk_category"
                             options="meeting_risk_category_ds" displayField="code_value_name" valueField="code_value"/>
                    <a:field name="last_updated_person" defaultValue="${/session/@employeeName}"/>
                    <a:field name="risk_status" defaultValue="NEW"/>
                    <a:field name="processInstanceId" defaultValue="${/parameter/@processInstanceId}"/>
                </a:fields>
                <a:events>
                    <a:event handler="prj_project_wfl_risk_list_info_grid_ds_query" name="query"/>
                    <a:event handler="prj_project_wfl_risk_list_info_grid_ds_submitsuccess" name="submitsuccess"/>
                </a:events>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>

            <div id="project_attachemnt_risk">


                <a:grid id='prj_project_wfl_risk_report_info_grid' title="风险评估报告" navBar="true" style="margin-top:25px;" marginWidth="100"  height="300" bindTarget="prj_project_wfl_risk_report_info_grid_ds">
                    <a:toolBar>
                        <a:button click="risk_report_file_upload" text="上传/删除附件"/>
                        <a:button click="meeting_open_project" text="查看项目明细"></a:button>
                        <a:button type="excel"/>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="file_name" prompt="附件名称" width="120" align="center"/>
                        <a:column name="upload_person" prompt="上传人" width="120" align="center"/>
                        <a:column name="upload_date" prompt="上传时间"  width="120" align="center"/>
                        <a:column name="down_load" prompt="下载" width="120" renderer="risk_report_info_grid_down_load" align="center"/>
                    </a:columns>
                </a:grid>

                <a:grid id='prj_project_wfl_risk_list_info_grid' title="投放条件及贷后管理要求" navBar="true" style="margin-top:25px;" marginWidth="100"  height="300" bindTarget="prj_project_wfl_risk_list_info_grid_ds">
                    <a:toolBar>
                        <a:button type="add"/>
                        <a:button type="save"/>
                        <a:button type="excel"/>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="seq_number" prompt="编号" width="120" align="center" editor="prj_project_wfl_risk_list_info_grid_numberField"/>
                        <a:column name="meeting_risk_category_desc" prompt="要求分类" editor="prj_project_wfl_risk_list_info_grid_combobox" width="120" align="center"/>
                        <a:column name="meeting_risk_description" prompt="具体描述" editor="prj_project_wfl_risk_list_info_grid_textfiled"  width="120" align="center"/>
                        <a:column name="last_updated_person" prompt="最后修改人"  width="120" align="center"/>
                        <a:column name="last_updated_date" prompt="最后修改时间"  width="120" align="center"/>
                        <a:column name="status_desc" prompt="状态"  width="120" align="center"/>
                        <a:column name="delete_attach" prompt="删除"  width="120" align="center" renderer="prj_project_wfl_risk_list_info_grid_delete_attach_render"/>
                    </a:columns>
                    <a:editors>
                        <a:textField id="prj_project_wfl_risk_list_info_grid_textfiled"/>
                        <a:comboBox id="prj_project_wfl_risk_list_info_grid_combobox"/>
                        <a:numberField id="prj_project_wfl_risk_list_info_grid_numberField"/>
                    </a:editors>
                </a:grid>

            </div>


            <div id="meeting_info_form_contain" style="display: none;">
                <!--秘书上会评委选择-->
                <a:form id="prj_project_wfl_meeting_info_form" labelwidth="120"  title="会议信息">
                    <a:hBox>
                        <a:textField name="meeting_name" prompt="会议名称" bindTarget="prj_project_wfl_meeting_info_form_ds" required="true"/>
                        <a:datePicker name="meeting_date" renderer="Leaf.formatDate" prompt="会议日期" bindTarget="prj_project_wfl_meeting_info_form_ds"/>

                        <a:numberField name="number_of_judges" prompt="评委人数" bindTarget="prj_project_wfl_meeting_info_form_ds" readOnly="true"/>

                        <a:button click="meeting_open_project" text="查看项目明细"></a:button>
                    </a:hBox>
                    <div id="sumMeeting" style="display: none">
                    <a:hBox>
                        <a:comboBox name="result" prompt="投票结果" bindTarget="prj_project_wfl_meeting_info_form_ds" readOnly="true"/>
                        <a:numberField name="sumApp" prompt="同意票数" bindTarget="prj_project_wfl_meeting_info_form_ds" readOnly="true"/>
                        <a:numberField name="sumRej" prompt="否决票数" bindTarget="prj_project_wfl_meeting_info_form_ds" readOnly="true"/>
                        <a:numberField name="sumCon" prompt="有条件同意票数" bindTarget="prj_project_wfl_meeting_info_form_ds" readOnly="true"/>
                    </a:hBox>
                    </div>
                </a:form>
            </div>

            <div id="meeting_info_grid_contain" style="display: none;">

                <a:grid id='prj_project_wfl_meeting_info_grid' style="margin-top:25px;" marginWidth="100"  height="300" bindTarget="prj_project_wfl_meeting_info_grid_ds">
                    <a:columns>
                        <a:column name="employee_code" prompt="员工代码" width="120" align="center"/>
                        <a:column name="name" prompt="员工名称" width="120" align="center"/>
                        <a:column name="unit_name" prompt="部门名称"  width="120" align="center"/>
                        <a:column name="position_name" prompt="岗位名称" width="120" align="center"/>
                        <a:column name="company_short_name" prompt="公司简介" width="220" align="center"/>
                    </a:columns>

                </a:grid>
            </div>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

        <script id="scriptB"><![CDATA[
        if(project_wfl_type === 'meeting'){
            $jq("#meeting_info_form_contain").show();
            $jq("#meeting_info_grid_contain").show();
        }else if(project_wfl_type === 'meeting_judges'){
            $jq("#meeting_info_form_contain").show();
        }

        if(edit_type === 'read'){
            $jq("#prj_project_wfl_risk_report_info_grid_tb table").hide();
            $jq("#prj_project_wfl_risk_list_info_grid_tb table").hide();
            $("prj_project_wfl_meeting_info_form_ds").getCurrentRecord().getField("meeting_name").setReadOnly(true);
            $("prj_project_wfl_meeting_info_form_ds").getCurrentRecord().getField("meeting_date").setReadOnly(true);
            $jq("#prj_project_wfl_meeting_info_grid .grid-la").hide();
        }else if(edit_type === 'edit_risk'){
            $("prj_project_wfl_meeting_info_form_ds").getCurrentRecord().getField("meeting_name").setReadOnly(true);
            $("prj_project_wfl_meeting_info_form_ds").getCurrentRecord().getField("meeting_date").setReadOnly(true);
            $jq("#meeting_info_grid_contain").hide();
            $jq("#sumMeeting").show();
        }

        ]]></script>
    </a:view>

</a:screen>