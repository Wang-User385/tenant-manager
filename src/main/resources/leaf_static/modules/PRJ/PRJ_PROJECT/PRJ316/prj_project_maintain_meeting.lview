<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
        <s:server-script><![CDATA[
        var str = $ctx.parameter.projectName;
        var projectNmae = decodeURIComponent(decodeURI(decodeURIComponent(decodeURI(str))));
        $ctx.parameter.project_name = projectNmae;
        ]]></s:server-script>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[
        // Leaf.onReady(function() {debugger;
        //     Leaf.Masker.unmask(Ext.getBody());
        // });
        //
        function save_meetingMaintainDs() {
            debugger;
            var ds = $('meetingMaintainDs');
            var ln_ds = $('meeting_info_ds');
            if (!ds.validate()) {
                return;
            }
            ds.submit();
            var record = ds.getCurrentRecord();
            if (record.get('project_meeting_id') != null && record.get('project_meeting_id') != undefined) {
                var ln_records = ln_ds.getAll();
                for (var i = 0; i < ln_records.length; i++) {
                    if (ln_records[i].get('project_meeting_id') == null || ln_records[i].get('project_meeting_id') == undefined) {
                        ln_records[i].set('project_meeting_id', record.get('project_meeting_id'));
                    }
                }
                ln_ds.submit();
            }
        }

        function add_approval() {
            Leaf.Masker.mask(Ext.getBody());
            var ds = $('meetingMaintainDs');
            Leaf.request({
                url: '${/request/@context_path}/prj/project/meeting/approver/add',
                para: {
                    project_id: '${/parameter/@project_id}'
                },
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    $('meeting_info_ds').query();
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                faliure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        // function validate_meeting_time(record, name, value) {
        //     var reg = /^\d\d:\d\d$/;
        //     if (reg.test(value)) {
        //         return true;
        //     }
        //     return '上会时间格式应为【hh:mm】,举例【09:05】';
        // }

        function prj_meeting_approval_query(ds, para) {
            $('meeting_info_ds').setQueryUrl('${/request/@context_path}/prj/project/meeting/approver/query');
            $('meeting_info_ds').setQueryParameter('project_id', '${/parameter/@project_id}');
        }

        //评委加载 加载时添加评委
        function prj_meeting_approval_load() {
            debugger;
            var records = $('meeting_info_ds').getAll();
            if (records.length == 0) {
                add_approval();
            }

        }

        //删除评委
        function del_approval() {
            var records = $('meeting_info_ds').getSelected();
            if (records.length == 0) {
                Leaf.showErrorMessage('提示', '请至少选择一条数据！');
            } else {
                var param = [];
                for (var i = 0; i < records.length; i++) {
                    param.push(records[i].data);
                }
                Leaf.Masker.mask(Ext.getBody());
                Leaf.request({
                    url: '${/request/@context_path}/prj/project/meeting/approver/remove',
                    para: param,
                    success: function (datas) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $('meeting_info_ds').query();
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    }
                });
            }
        }

        //保存成功查询
        function prj_meeting_approval_submitsuccess() {
            $('meeting_info_ds').query();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="prj_meeting_query_ds">
                <a:datas>
                    <a:record/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="meetingMaintainDs" submitUrl="${/request/@context_path}/prj/project/meeting/submit"
                       autoQuery="true" autoCreate="true"
                       queryUrl="${/request/@context_path}/prj/project/meeting/info/query?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}">
                <a:fields>
                    <a:field name="meeting_name" required="true" defaultValue="${/parameter/@project_name}"/>
                    <a:field name="meeting_location" required="true" defaultValue="公司本部"/>
                    <a:field name="meeting_date" required="true"
                             />
                    <!--                    <a:field name="meeting_time" required="true" validator="validate_meeting_time"/>-->
                    <a:field name="meeting_status" defaultValue="NEW"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="meeting_info_ds" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true"
                       fetchAll="true" bindTarget="meetingMaintainDs"
                       queryUrl="${/request/@context_path}/prj/project/meeting/approver/query?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}"
                       deleteUrl="${/request/@context_path}/prj/project/meeting/approver/remove">
                <a:fields>
                    <a:field name="name"/>
                    <a:field name="unit_name"/>
                    <a:field name="position_name"/>
                    <a:field name="company_id_n"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="prj_meeting_approval_load"/>
                    <a:event name="query" handler="prj_meeting_approval_query"/>
                    <a:event name="submitsuccess" handler="prj_meeting_approval_submitsuccess"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton id="add_approval_id" click="add_approval" text="添加评委"/>
                <a:gridButton id="del_approval_id" click="del_approval" text="删除评委"/>
                <a:gridButton id="save_meeting_button_id" click="save_meetingMaintainDs" text="HLS.SAVE"/>
            </a:screenTopToolbar>
            <a:form column="3">
                <a:textField name="meeting_name" bindTarget="meetingMaintainDs" width="365" prompt="上会名称"/>
                <a:datePicker name="meeting_date" bindTarget="meetingMaintainDs" renderer="Leaf.formatDate" width="120"
                              prompt="上会日期"/>
                <a:textField name="meeting_location" bindTarget="meetingMaintainDs" width="365" prompt="上会地点"/>
                <!--                <a:textField name="meeting_time" bindTarget="meetingMaintainDs" width="120" prompt="上会时间"/>-->
            </a:form>
            <a:grid id="meeting_grid" bindTarget="meeting_info_ds"
                    marginHeight="300" marginWidth="300" navBar="true">
                <a:columns>
                    <a:column width="130" name="name" prompt="评委名称"/>
                    <a:column width="130" name="unit_name" prompt="部门名称"/>
                    <a:column width="130" name="position_name" prompt="岗位名称"/>
                    <a:column width="200" name="company_id_n" prompt="公司名称"/>
                </a:columns>
            </a:grid>

        </a:screenBody>
    </a:view>
</a:screen>