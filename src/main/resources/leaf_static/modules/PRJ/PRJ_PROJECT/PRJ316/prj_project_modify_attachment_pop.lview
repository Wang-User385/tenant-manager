<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        debugger;

        var attachment_id;

        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if(ds_id == ds.id){
                record.set('project_attachment_category', 'PRJ_PROJECT_JD');
                record.set('project_id', '${/parameter/@project_id}');
            }
        };


        window['upload_file'] = function(record_id,attachment_id, editable_flag){
            debugger
            var tableName = 'PRJ_PROJECT_JD';
            var function_usage = '${/parameter/@function_usage}';
            if(attachment_id == null){
                $L.showInfoMessage("提示","请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY' || editable_flag == 'N') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfp1_open_attachment_winid',
                url: url,
                params: {
                    'header_id': attachment_id,
                    'table_name': tableName,
                    'project_id': record_id,
                    winid: 'prj316wp1_open_attachment_winid',
                    function_usage : function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                $(ds_id).query();
            });
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            var editable_flag = 'Y';
            if(record.get('project_attachment_id')){
                attachment_id = record.get('project_attachment_id');
            }
            if(record.get('editable_flag')){
                editable_flag = record.get('editable_flag');
            }
            var recordId = '${/parameter/@project_id}';
            if (name == 'upload' && record.get('project_attachment_id')/*attachment_id*/){
                if(editable_flag == 'Y'){
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + recordId + '\',\'' + attachment_id + '\',\'' + editable_flag + '\');">附件</a>';
                }else{
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + recordId + '\',\'' + attachment_id + '\',\'' + editable_flag + '\');">查看</a>';
                }
            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('project_id', '${/parameter/@project_id}');
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if (ds.id === attachment_ds_id && record != '') {
                if (record.get('editable_flag') == 'N') {
                    record.getField('document_name').setReadOnly(true);
                    record.getField('description').setReadOnly(true);
                }
            }
        };

        window['${/parameter/@layout_code}_G_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            var records = $(ds_id).getSelected();

            if (records.length != 1) {
                $L.showInfoMessage("提示", "请选择一条数据!");
                return;
            }

            var record = records[0];

            if(record.get('editable_flag') == 'N'){
                $L.showInfoMessage("提示", "只可删除自己的附件!");
                return;
            }

            Leaf.showConfirm('提示', '确定删除?', function () {
                Leaf.request({
                    url: '${/request/@context_path}/prj/jdAttachment/delete',
                    scope: this,
                    para: {
                        project_attachment_id : record.get('project_attachment_id')
                    },
                    success: function (res) {
                        if (res.success) {
                            $L.showInfoMessage("提示","删除成功!",function(){
                                $(ds_id).query();
                            });
                        }
                    }
                })
            },null,200,200)

        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

