<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <style>
            /*滚动条样式*/
            .item-tab .tab::-webkit-scrollbar {/*滚动条整体样式*/
                width: 8px;     /*高宽分别对应横竖滚动条的尺寸*/
                height: 8px;
            }
            .item-tab .tab::-webkit-scrollbar-thumb {/*滚动条里面小方块*/
                border-radius: 5px;
                -webkit-box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
                background-color: rgb(204, 204, 204);
            }
            .item-tab .tab::-webkit-scrollbar-track {/*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
                border-radius: 0;
                background-color: white;
            }
        </style>
        <script><![CDATA[




        ]]></script>
            <div id="hls_fin_calc_templet" style="height:500px;">
                <iframe id="prj_project_guarantor_iframe"
                        frameborder="0" height="100%" width="100%" background-color="#fff"
                        style="border: 1px solid #E7ECF1" onload="unlock_win()"
                        src ="" />

            </div>

        <script><![CDATA[

        $jq('#hls_fin_calc_templet').width($L.getViewportWidth()-240);
        /*settimeout(function(){
            document.getelementbyid('prj_project_tenant_sec_iframe').src = 'modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant_rec.lview?tenant_sec_id=${/parameter/@tenant_sec_id}&amp;bp_seq=${/parameter/@bp_seq}&amp;project_id=${/parameter/@project_id}';
        },500)*/

        $L.onReady(function () {//debugger;
            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor_query.lview?guarantor_id=${/parameter/@guarantor_id}&guarantor_np_id=${/parameter/@guarantor_np_id}&project_id=${/parameter/@project_id}&marketing_report_id=${/parameter/@marketing_report_id}&warrantor_count=${/parameter/@warrantor_count}&warrantor_count_np=${/parameter/@warrantor_count_np}';
            if ('${/parameter/@function_usage}' === 'QUERY') {
                $jq("#prj_project_guarantor_iframe").attr('src', url);
            }else{
                url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor.lview?guarantor_id=${/parameter/@guarantor_id}&guarantor_np_id=${/parameter/@guarantor_np_id}&project_id=${/parameter/@project_id}&marketing_report_id=${/parameter/@marketing_report_id}&warrantor_count=${/parameter/@warrantor_count}&warrantor_count_np=${/parameter/@warrantor_count_np}';
                $jq("#prj_project_guarantor_iframe").attr('src', url);
            }
        });

        var warrantor_count = '${/parameter/@warrantor_count}';
        var warrantor_count_np = '${/parameter/@warrantor_count_np}';

        if(warrantor_count == 0 && warrantor_count_np ==0){
            $jq('#hls_fin_calc_templet').height(0);
        }

        function unlock_win() {
            //debugger;
            $L.Masker.unmask(Ext.getBody());

        }

        ]]></script>
    </a:view>
</a:screen>
