<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <style>
            /*滚动条样式*/
            .item-tab .tab::-webkit-scrollbar { /*滚动条整体样式*/
                width: 8px; /*高宽分别对应横竖滚动条的尺寸*/
                height: 8px;
            }

            .item-tab .tab::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 5px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background-color: rgb(204, 204, 204);
            }

            .item-tab .tab::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background-color: white;
            }
        </style>

        <div id="tenant_tab" style="height:100%;background-color: #fff;margin-left: 8px;">
            <iframe id="prj_project_tenant_sec_iframe" frameborder="0" height="100%" width="100%"
                    background-color="#fff"
                    style="border: 1px solid #E7ECF1" onload="unlock_win()"
                    src=""/>

        </div>

        <script><![CDATA[
        var contentWindow = document.getElementById('prj_project_tenant_sec_iframe').contentWindow;
        $L.onReady(function () {//debugger;
            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant_query.lview?tenant_id=${/parameter/@tenant_id}&tenant_sec_id=${/parameter/@tenant_sec_id}&project_id=${/parameter/@project_id}&marketing_report_id=${/parameter/@marketing_report_id}&tenant_sec_count=${/parameter/@tenant_sec_count}';
            if ('${/parameter/@function_usage}' === 'QUERY') {
                $jq("#prj_project_tenant_sec_iframe").attr('src', url);
            }else{
                url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant.lview?tenant_id=${/parameter/@tenant_id}&tenant_sec_id=${/parameter/@tenant_sec_id}&project_id=${/parameter/@project_id}&marketing_report_id=${/parameter/@marketing_report_id}&tenant_sec_count=${/parameter/@tenant_sec_count}';
                $jq("#prj_project_tenant_sec_iframe").attr('src', url);
            }
        });

        // $jq('#tenant_tab').width($L.getViewportWidth() - 240);

        function lock_win() {
            //debugger;
            $L.Masker.mask(Ext.getBody(), "加载中...");
        }

        function unlock_win() {
            $L.Masker.unmask(Ext.getBody());

        }
        lock_win();

        ]]></script>
    </a:view>
</a:screen>
