        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var parentRecord = $(prj_ds_id).getCurrentRecord();
            if (parentRecord) {
                var param = parentRecord.data;
                window['${/parameter/@layout_code}_generate_prj_base_attachment'](param);
            }
        }

        //生成预设附件清单
        window['${/parameter/@layout_code}_generate_prj_base_attachment'] = function (project) {
            var param = {};
            var project_id = project.project_id;
            param['project_id'] = project_id;
            Leaf.request({
                url: "${/request/@context_path}/prj/base/attachment/generate",
                para: param,
                type: "POST",
                success: function (res) {
                    var sales_attachment_ds_id = "${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds";
                    //var bp_attachment_ds_id = "${/parameter/@layout_code}_G_BP_ATTACHMEMT_prj_project_attachment_ds";
                    var lease_attachment_ds_id = "${/parameter/@layout_code}_G_LEASE_ATTACHMENT_prj_project_attachment_ds";
                    var bp_cz_attachment_ds_id = "${/parameter/@layout_code}_G_BP_CZ_ATTACHMEMT_prj_project_attachment_ds";
                    var bp_db_attachment_ds_id = "${/parameter/@layout_code}_G_BP_DB_ATTACHMEMT_prj_project_attachment_ds";
                    $(sales_attachment_ds_id).setQueryParameter('project_id', project_id);
                    //$(bp_attachment_ds_id).setQueryParameter('project_id', project_id);
                    $(lease_attachment_ds_id).setQueryParameter('project_id', project_id);
                    $(bp_cz_attachment_ds_id).setQueryParameter('project_id', project_id);
                    $(bp_db_attachment_ds_id).setQueryParameter('project_id', project_id);
                    $(sales_attachment_ds_id).query();
                    //$(bp_attachment_ds_id).query();
                    $(lease_attachment_ds_id).query();
                    $(bp_cz_attachment_ds_id).query();
                    $(bp_db_attachment_ds_id).query();
                },
                error: function (res) {
                },
                failure: function (res) {
                },
                scope: this
            });
        }


        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var prj_project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_bp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'F_CUSTOMER_INFO');
            var projectId = $(prj_project_ds).getCurrentRecord().get('project_id');
            var prj_project_bp_record = $(prj_project_bp_ds).getAll();
            var param = {};
            var tenant_ids = [];
            var tenant_count = 0;
            var check_flag = true;
            param['project_id'] = prj_project_bp_record[0].data.project_id;
            //debugger;
            if (prj_project_bp_record.length > 0) {
                for (var j = 0; j < prj_project_bp_record.length; j++) {
                    if (prj_project_bp_record[j].data.bp_type == 'TENANT') {
                        tenant_count = tenant_count + 1;
                    }
                }
                if (tenant_count == 0){
                    Leaf.showErrorMessage('提示', '必须维护一个承租人！');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                }
                if (tenant_count > 1) {
                    Leaf.showErrorMessage('提示', '有且只能维护一个承租人！');
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                } else {
                    var tenant_id = prj_project_bp_record[0].data.bp_id;
                    tenant_ids.push(tenant_id);
                    param['tenant_id'] = tenant_ids;

                    var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                    var quotation_record=$(quotation_ds_id).getCurrentRecord();
                    param['lease_item_amount'] = quotation_record.get('lease_item_amount');
                    Leaf.request({
                        url: $('prj001_prj_project_bp_tenant_id_link_id').getUrl(),
                        type: "POST",
                        para: param,
                        success: function (res) {
                            check_flag=true;
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag= false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag= false;
                        },
                        sync: true,
                        scope: this
                    });
                }

            }
            return check_flag;
        };

        ///工作流页面执行前校验
        function beforeSubmit(countiune) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if($(ds_id).validate()) {
                $(ds_id).submit();
                countiune();
                return true;
            }else{
                return false;
            }
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
