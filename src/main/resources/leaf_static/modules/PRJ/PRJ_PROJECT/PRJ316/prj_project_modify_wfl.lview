        window['upload_file'] = function (record_id, project_attachment_id) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var url;
            if ('${/parameter/@file_upload_flag}' == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'PRJ_PROJECT_ATTACHMENT',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                //var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_ATTACHMENTS_prj_project_attachment_ds";
                var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_prj_project_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        window['question_file'] = function (record_id, question_id) {
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (question_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var question_file_flag = 'N';
            var function_usage = 'QUERY';
            var question_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_wfl_question');
            var question_record = $(question_ds_id).findById(record_id);
            if (question_record.get('question_created_by') == '${/session/@userId}') {
                question_file_flag = 'Y';
                function_usage = 'MODIFY';
            } else {
                question_file_flag = 'N';
                function_usage = 'QUERY';
            }

            var url;
            if (question_file_flag == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }

            if ('${/parameter/@question_file_flag}' == 'N') {
                question_file_flag = 'N';
                function_usage = 'QUERY';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': question_id,
                    'table_name': 'PRJ_PROJECT_WFL_QUESTION',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_QUESTION_prj_project_wfl_question_ds";
                $(document_list_ds_id).query();
            });
        };

        window['answer_file'] = function (record_id, question_id) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (question_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var answer_file_flag = 'N';
            var function_usage = 'QUERY';
            var question_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_wfl_question');
            var question_record = $(question_ds_id).findById(record_id);
            if ((question_record.get('question_answer') != null && question_record.get('question_answer') != '') || (question_record.get('answer_file_exist_flag') == 'Y')) {
                if (question_record.get('question_answered_by') == '${/session/@userId}') {
                    answer_file_flag = 'Y';
                    function_usage = 'MODIFY';
                } else {
                    answer_file_flag = 'N';
                    function_usage = 'QUERY';
                }
            } else {
                if (question_record.get('question_created_by') == '${/session/@userId}') {
                    answer_file_flag = 'N';
                    function_usage = 'QUERY';
                } else {
                    answer_file_flag = 'Y';
                    function_usage = 'MODIFY';
                }
            }

            if ('${/parameter/@answer_file_flag}' == 'N') {
                answer_file_flag = 'N';
                function_usage = 'QUERY';
            }

            var url;
            if (answer_file_flag == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': question_id,
                    'table_name': 'PRJ_PROJECT_WFL_ANSWER',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_QUESTION_prj_project_wfl_question_ds";
                $(document_list_ds_id).query();
            });
        };

        window['prj_attachement_upload'] = function (record_id, project_attachment_id, ds_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            var project_id = record.get('project_id');
            if (typeof (project_attachment_id) === 'undefined' || 'undefined' === project_attachment_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            var table_name;
            var function_usage;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            } else {
                if (record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX1') {//合同文本附件暂定不可删除
                    if ('${/parameter/@buttonFlag}' == 'B' || '${/parameter/@secretFlag}' == 'Y') {
                        function_usage = 'MODIFY';
                        url = '${/request/@context_path}/uploadFile.lview';
                    } else {
                        function_usage = 'QUERY';
                        url = '${/request/@context_path}/downloadFile.lview';
                    }
                    table_name = 'HLS_PRJ_PROJECT_DOCX1';
                } else if (record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX2') {
                    if ('${/parameter/@buttonFlag}' == 'C') {//风险节点可删除重新上传
                        function_usage = 'MODIFY';
                        url = '${/request/@context_path}/uploadFile.lview';
                    } else {
                        function_usage = 'QUERY';
                        url = '${/request/@context_path}/downloadFile.lview';
                    }
                    table_name = 'HLS_PRJ_PROJECT_DOCX2';
                } else if (record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX3') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/downloadFile.lview';
                    function_usage = 'QUERY';
                    table_name = 'HLS_PRJ_PROJECT_DOCX3';
                } else {
                    url = '${/request/@context_path}/downloadFile.lview';
                    function_usage = 'QUERY';
                    table_name = 'PRJ_PROJECT_ATTACHMENT';
                }
            }

            var document_list_ds_id;
            if (ds_id == '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds') {
                document_list_ds_id = ds_id;
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                url: url,
                params: {
                    header_id: project_attachment_id,
                    table_name: table_name,
                    winid: 'prj316_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '附件',
                width: 800,
                height: 575
            });
            win.on('close', function () {
                var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                $(prj_ds_id).query;
                $(document_list_ds_id).query();
            });
        };


        //报价查看
        function hls_quotation_id_detail() {
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list + '&readOnly=Y';
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel查看',
                fullScreen: true,
                document_history_flag: true
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_F_FORM_prj_quotation_ds').query();
                $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
            });

        }

        //尽调页面详情
        function hls_project_detail() {
            // debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var projectId = '${/parameter/@project_id}';
            var param = [];
            var function_code = '';
            var business_type = prj_record.data.business_type;
            if (business_type == 'T+0_LEASE_FACTORING' || business_type == 'T+N_LEASE_FACTORING') {
                function_code = 'PRJ316F2F2_WFL';
            } else if (business_type == 'LEASE_WITHOUT_RECOURSE_IN' || business_type == 'OPERATING_LEASE_WITHOUT_RECOURSE_IN') {
                function_code = 'PRJ316F2F3_WFL';
            } else {
                function_code = 'PRJ316F2_WFL';
            }

            param['winid'] = 'project_modify_wfl_winid';
            param['function_code'] = function_code;
            param['project_id'] = '${/parameter/@project_id}';
            var maintain_type;
            var function_usage;
            if ('${/parameter/@buttonFlag}' == 'B' || '${/parameter/@secretFlag}' == 'Y') {
                maintain_type = 'UPDATE';
                function_usage = 'MODIFY';
            } else {
                maintain_type = 'READONLY';
                function_usage = 'QUERY';
            }
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            param['wflRuleControlFlag'] = 'Y';
            var win = new Leaf.Window({
                id: 'project_modify_wfl_winid',
                url: $('prj316wfl_project_query_id').getUrl(),
                params: {
                    winId: 'project_modify_wfl_winid',
                    project_id: prj_record.get('project_id'),
                    maintain_type: maintain_type,
                    function_usage: function_usage,
                    function_code: function_code
                },
                title: '项目明细',
                fullScreen: true,
                draggable: true
            });
            win.on('close', function () {
                $(prj_ds_id).query();
            });
        }

        //尽调报告
        function prj_report_detail() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id).getCurrentRecord();
            if (record.get('source_pk_value1') && record.get('source_pk_value1') != null && record.get('source_pk_value1') != '') {
                var source_pk_value1 = record.get('source_pk_value1');
                editOffice_reprot(source_pk_value1);
            } else {
                $L.showInfoMessage("提示", "请先生成项目尽调报告!");
            }
        }

        //风险报告
        function prj_risk_report_detail() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if ($(ds_id).validate()) {
                var record = $(ds_id).getCurrentRecord();
                var source_pk_value2 = record.get('source_pk_value2');
                if ('${/parameter/@buttonFlag}' == 'C' && !source_pk_value2) {
                    if (record.get('project_id') && record.get('project_id') != null && record.get('project_id') != '') {
                        Leaf.Masker.mask(Ext.getBody(), '正在生成文本...');
                        Leaf.request({
                            url: "${/request/@context_path}/prj/project/create/content",
                            para: {project_id: record.get('project_id'), template_code: 'PRJ_REPORT_RISK'},
                            success: function (res) {
                                console.log(res);
                                var source_pk_value2 = res.result.record[0].source_pk_value1;
                                $(ds_id).query();
                                if (source_pk_value2 == 'undefined' || source_pk_value2 == '' || source_pk_value2 == null) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.showInfoMessage('未找到模板!');
                                    return;
                                } else {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    // Leaf.showInfoMessage('合同文本生成成功!');
                                    var ds_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_SEND_REVIEW_REPORT');
                                    $(ds_att).query();
                                    editOffice_risk(source_pk_value2);
                                }
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    } else {
                        $L.showInfoMessage("提示", "项目不存在请联系管理员!");
                    }
                } else {
                    if (source_pk_value2) {
                        editOffice_risk(source_pk_value2);
                    } else {
                        $L.showInfoMessage("提示", "请先生成风险审查报告!");
                    }
                }

            }
        };

        //项目批复书
        function prj_reply_detail() {
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if ($(ds_id).validate()) {
                var record = $(ds_id).getCurrentRecord();
                var source_pk_value3 = record.get('source_pk_value3');
                if ('${/parameter/@buttonFlag}' == 'E' && '${/parameter/@approvalFlag}' == 'Y') {
                    if (record.get('project_id') && record.get('project_id') != null && record.get('project_id') != '') {
                        Leaf.Masker.mask(Ext.getBody(), '正在生成文本...');
                        Leaf.request({
                            url: "${/request/@context_path}/prj/project/create/content",
                            para: {project_id: record.get('project_id'), template_code: 'PRJ_REPORT_APPROVAL'},
                            success: function (res) {
                                console.log(res);
                                var source_pk_value3 = res.result.record[0].source_pk_value1;
                                $(ds_id).query();
                                if (source_pk_value3 == 'undefined' || source_pk_value3 == '' || source_pk_value3 == null) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.showInfoMessage('未找到模板!');
                                    return;
                                } else {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    // Leaf.showInfoMessage('合同文本生成成功!');
                                    var ds_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_SEND_REVIEW_REPORT');
                                    $(ds_att).query();
                                    editOffice_reply(source_pk_value3);
                                }
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    } else {
                        $L.showInfoMessage("提示", "项目不存在请联系管理员!");
                    }
                } else {
                    if (source_pk_value3) {
                        editOffice_reply(source_pk_value3);
                    } else {
                        $L.showInfoMessage("提示", "请先生成项目批复书!");
                    }
                }

            }
        };


        //在线编辑
        function editOffice_risk(source_pk_value) {
            if ('${/parameter/@buttonFlag}' == 'C' && source_pk_value) {
                window.open("${/request/@context_path}/sys/office/review?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else if (source_pk_value) {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                $L.showInfoMessage("提示", "请先生成风险审查报告!");
            }

        }

        //在线编辑
        function editOffice_reply(source_pk_value) {
            if (source_pk_value) {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                $L.showInfoMessage("提示", "请先生成项目批复书!");
            }
        }

        //页面加载 按钮显示隐藏逻辑
        Leaf.onReady(function () {
            // debugger;
            var ref_project_id = '${/parameter/@ref_project_id}';
            if (ref_project_id != "") {
                $jq("#hls_project_detail_id").hide();
                $jq("#hls_project_detail_page_id").show();
                $jq("#hls_project_prj_quotation_id").show();
            } else {
                $jq("#hls_project_detail_id").show();
                $jq("#hls_project_detail_page_id").show();
                $jq("#hls_project_prj_quotation_id").show();
                $jq("#hls_project_report_id").hide();
                $jq("#hls_project_reply_id").hide();
                if ('${/parameter/@buttonFlag}' == 'C' || '${/parameter/@buttonFlag}' == 'D') {
                    $jq("#hls_project_report_id").show();
                } else if ('${/parameter/@buttonFlag}' == 'E') {
                    $jq("#hls_project_report_id").show();
                    $jq("#hls_project_reply_id").show();
                } else if ('${/parameter/@buttonFlag}' == 'N') {
                    $jq("#hls_project_report_id").show();
                    $jq("#hls_project_reply_id").show();
                } else {
                    $jq("#hls_project_report_id").hide();
                    $jq("#hls_project_reply_id").hide();
                }
            }
        });

        //在线编辑
        function editOffice_reprot(source_pk_value) {
            // debugger;
            // if('${/parameter/@buttonFlag}' == 'A' && source_pk_value){
            //     window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            // }else if('${/parameter/@buttonFlag}' == 'B' && source_pk_value){
            //     window.open("${/request/@context_path}/sys/office/edit?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            // }else{
            //     window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            // }
            if (source_pk_value) {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                $L.showInfoMessage("提示", "请先生成项目尽调报告!");
            }

        }

        $L.ComboBox.prototype.collapse = function () {
            Ext.get(document.documentElement).un("mousedown", this.triggerBlur, this);
            if (this.popup) {
                this.popup.moveTo(-1000, -1000);
                this.popup.removeClass('animated zoomInDownPopup');
                this.popup.addClass('animated zoomOut');
            }
            this.fireEvent("collapse", this);
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton id="hls_project_prj_quotation_id" style="display:none;" click="hls_quotation_id_detail"
                              text="报价详情"/>
                <a:gridButton id="hls_project_detail_id" style="display:none;" click="hls_project_detail"
                              text="尽调页面详情"/>
                <a:gridButton id="hls_project_detail_page_id" style="display:none;" click="prj_report_detail"
                              text="尽调报告"/>
                <a:gridButton id="hls_project_report_id" style="display:none;" click="prj_risk_report_detail"
                              text="风险审查报告"/>
                <a:gridButton id="hls_project_reply_id" style="display:none;" click="prj_reply_detail" text="项目批复书"/>
            </a:screenTopToolbar>
        </a:screenBody>
