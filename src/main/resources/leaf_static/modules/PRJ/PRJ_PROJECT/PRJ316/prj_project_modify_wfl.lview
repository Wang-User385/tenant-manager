        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            if (ds.id == '${/parameter/@layout_code}_F_BASIC_INFO_prj_project_ds') {
                qpara['project_id'] = '${/parameter/@project_id}';
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
            if (ds.id == '${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds') {
                var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var prj_record = $(prj_ds_id).getCurrentRecord();
                // var project_id = prj_record.get('project_id');

                var project_id = '${/parameter/@project_id}';
                qpara['source_document_id'] = project_id;
                qpara['source_document_category'] = 'PRJ_PROJECT';
                qpara['data_class'] = '';
            }
            if (ds.id == '${/parameter/@layout_code}_F_INDUSTRY_CATEGORY_prj_project_ds') {
                var project_id = '${/parameter/@project_id}';
                qpara['source_document_id'] = project_id;
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
            if (ds.id == '${/parameter/@layout_code}_G_OTHER_DESCRIPTION_prj_project_ds') {
                var project_id = '${/parameter/@project_id}';
                qpara['project_id'] = project_id;
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // debugger;
            if (ds.id = '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds') {
                var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var prj_record = $(prj_ds_id).getCurrentRecord();
                var project_id = prj_record.get('project_id');
                qpara['project_id'] = project_id;
                qpara['project_attachment_category'] = 'PRJ_SEND_REVIEW_REPORT';

            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // debugger;
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'bp_detali') {
                link_function = 'open_bp_modify_win';
                // return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '客户详细信息' + '</a>';
            } else if (name == 'finnance_info') {
                link_function ='open_finance_modify_win';
                // return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '客户详细信息' + '</a>';
            } else if (name == 'lease_item_code') {
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            } else if (name == 'attachment_data_t' && record.get('project_attachment_id')) {
                link_function = 'prj_attachement_upload';
                var file_number = record.get('file_number');
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\',\'' + record.ds.id + '\');">' + '附件上传(' + file_number + ')' + '</a>';
            } else if (name == 'upload') {
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">' + '上传/下载' + '</a>';
            } else if (name == 'question_file') {
                link_function = 'question_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('question_id') + '\');">' + '上传/下载' + '</a>';
            } else if (name == 'answer_file') {
                link_function = 'answer_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('question_id') + '\');">' + '上传/下载' + '</a>';
            } else if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }
        };

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

