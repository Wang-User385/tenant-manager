<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl.lview"/>
        <script><![CDATA[
        /*注意，明细页面 在线编辑 三个按钮控制如下：
        1.buttonFlag=A 显示尽调详情按钮且只读，其他按钮隐藏
        2.buttonFlag=B 显示尽调详情按钮且可编辑，其他按钮隐藏
        3.buttonFlag=C 显示尽调详情按钮且只读，显示风险审查意见按钮且可编辑，其他按钮隐藏
        4.buttonFlag=D 显示尽调详情按钮且只读，显示风险审查意见按钮且只读，其他按钮隐藏
        5.buttonFlag=E 显示尽调详情按钮且只读，显示风险审查意见按钮且只读，显示项目批复按钮且只读
        6.buttonFlag=E&meettingFlag=Y 显示所有按钮且只读，显示可编辑会议页面
        7.buttonFlag=E&approvalFlag=Y 显示所有按钮且只读，显示会议结果节批复制作页面
        approvalFlag=N 显示所有按钮且只读，显示会议结果节批复只读页面
        PRJ_REPORT_APPROVAL     项目批复书模板
        PRJ_REPORT_RISK    项目风险意见审查书模板
        PRJ_REPORT_CONTENT 项目尽调模板*/
        debugger;
        var bp_hide_flag = 'Y';
        var file_hide_flag = 'Y';
        var comments_hide_flag = 'N';
        var comments_readOnly_flag = 'N';
        //console.log(parent.currentTaskInfo.process_instance);
        // var businessKey = '${/parameter/@businessKey}';
        // if (!businessKey) {
        //     businessKey = parent.currentTaskInfo.process_instance.business_key;
        // }

//debugger;

        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var accountFlag = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "accountFlag";
        });

        var refProjectId = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectIdOld";
        });
        var financeAmount = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "financeAmount";
        });
        var projectName = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectName";
        });
        var financeAmount1 = financeAmount[0].value;
        var project_name = projectName[0].value;
        //alert(financeAmount1);
        if(refProjectId && refProjectId.length === 1){
            refProjectId = refProjectId[0].value;
        }
        var approval = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "approvalId";
        });

        var projectId = project[0].value;
        var account_flag = accountFlag[0].value;
        var meettingFlag= '${/parameter/@meettingFlag}';
        var buttonFlag= '${/parameter/@buttonFlag}';
        var approvalFlag = '${/parameter/@approvalFlag}';
        var secretFlag = '${/parameter/@secretFlag}';
        var approvalId = approval[0].value;
        //秘书  PRJ316WFLM PROJECT_MODIFY_FINANCE_LEASE_WFL_MEET
        //表决结果 PRJ316WFLP PROJECT_MODIFY_FINANCE_LEASE_WFL_MEETAP
        //项目批复 PRJ316WFLQ PROJECT_MODIFY_FINANCE_LEASE_WFL_MEETAQ
        /*var quotation = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "quotationId";
        });
        var quotationId = quotation[0].value;*/
        var function_code;
        if(meettingFlag == 'Y'){
            function_code = 'PRJ316WFLM';
        }else if(approvalFlag == 'Y'){
            function_code = 'PRJ316WFLP';
        }else if(approvalFlag == 'N'){
            function_code = 'PRJ316WFLQ';
        }else{
            function_code = 'PRJ316WFL';
        }
        var pageChooser = new PageChooser({
            url: $('prj_project_wfl_detail_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                ref_project_id: refProjectId,
                buttonFlag:buttonFlag,
                meettingFlag:meettingFlag,
                approval_id:approvalId,
                secretFlag:secretFlag,
                function_code:function_code,
                maintain_type: 'UPDATE',
                function_usage: 'MODIFY',
                financeAmount:financeAmount1,
                projectName:project_name,
                approvalFlag:approvalFlag,
                // layout_debugger_flag:'Y',
                bp_hide_flag: bp_hide_flag,
                file_hide_flag: file_hide_flag,
                comments_hide_flag: comments_hide_flag,
                comments_readOnly_flag:comments_readOnly_flag
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>