<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: hxh
    $Date: 2020年4月17日
    $Revision: 1.0
    $Purpose: 尽调报告维护（项目报告维护）
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action" xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectProjectGuarantorLoop" rootPath="prj_project_guarantor_path"/>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectProjectGuarantorNpLoop" rootPath="prj_project_guarantor_np_path"/>
    </a:init-procedure>
    <a:view>

        <style>
            html, body {
                background: #fff;
            }

            .item-tab-table {
                -webkit-box-shadow: none !important;
                -moz-box-shadow: none !important;
                -o-box-shadow: none !important;
                -ms-box-shadow: none !important;
                box-shadow: none !important;
            }

            /*滚动条样式*/
            .item-tab .tab::-webkit-scrollbar { /*滚动条整体样式*/
                width: 8px; /*高宽分别对应横竖滚动条的尺寸*/
                height: 8px;
            }

            .item-tab .tab::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 5px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background-color: rgb(204, 204, 204);
            }

            .item-tab .tab::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background-color: white;
            }
        </style>

        <script><![CDATA[

        var guarantor_obj={};

        ]]>
        </script>


        <a:screenBody>
            <a:tabPanel marginWidth="270" marginHeight="20" id="guarantor_info">
                <a:tabs>
                    <a:tab prompt="法人担保" width="110" id="org">
                        <a:tabPanel marginWidth="270" marginHeight="80" id="guarantor_info_org">
                            <a:tabs>
                                <a:placeHolder id="dynamicTreeNode_id_org"/>
                            </a:tabs>
                        </a:tabPanel>
                    </a:tab>
                    <a:tab prompt="自然人担保" width="80" id="np">
                        <a:tabPanel marginWidth="270" marginHeight="100" id="guarantor_info_np">
                            <a:tabs>
                                <a:placeHolder id="dynamicTreeNode_id_np"/>
                            </a:tabs>
                        </a:tabPanel>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
    </a:view>
    <a:view-config>
        <c:create-config targetId="dynamicTreeNode_id_org">
            <p:loop source="/model/prj_project_guarantor_path">
                <p:switch test="@bp_seq">
                    <p:case value="*">
                        <c:process-config>

                            <a:tab prompt="法人担保${@bp_seq}" width="110" id="org${@bp_seq}">
                                <a:screen-include screen="modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor_tab.lview?guarantor_id=${@guarantor_id}&amp;bp_seq=${@bp_seq}&amp;project_id=${/parameter/@project_id}&amp;marketing_report_id=${/parameter/@marketing_report_id}"/>
                            </a:tab>

                        </c:process-config>
                    </p:case>
                </p:switch>
            </p:loop>

        </c:create-config>
        <c:create-config targetId="dynamicTreeNode_id_np">
            <p:loop source="/model/prj_project_guarantor_np_path">
                <p:switch test="@bp_seq">
                    <p:case value="*">
                        <c:process-config>

                            <a:tab prompt="自然人担保${@bp_seq}" width="110" id="np${@bp_seq}">
                                <a:screen-include screen="modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor_tab_np.lview?guarantor_np_id=${@guarantor_np_id}&amp;bp_seq=${@bp_seq}&amp;project_id=${/parameter/@project_id}&amp;marketing_report_id=${/parameter/@marketing_report_id}"/>
                            </a:tab>

                        </c:process-config>
                    </p:case>
                </p:switch>
            </p:loop>

        </c:create-config>
    </a:view-config>
</a:screen>
