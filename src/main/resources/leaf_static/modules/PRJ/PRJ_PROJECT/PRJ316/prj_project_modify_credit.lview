<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            debugger;
            var file_num = record.get('file_num') || 0;
            var attach_name = file_num === 0 ? '附件' : '附件(' + file_num + ')';
            if (name == 'customer_detail_information') {
                return '<a href="javascript:open_master_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户明细信息</a>';
            } else if (name == 'client_financial_reports') {
                return '<a href="javascript:open_financia_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户财报信息</a>';
            } else if (name == 'info') {
                return '<a href="javascript:upload(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('project_id') + '\');">' + attach_name + '</a>';
            } else if (name == 'quote') {
                return '<a href="javascript:quotation_factoring_detail_adjust(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\',\'' + record.get('chance_id') + '\')"><span style="    width: 82px;\n' +
                    '    background-color: #4CAF50;\n' +
                    '    border: none;\n' +
                    '    color: white;\n' +
                    '    padding: 1px 33px;\n' +
                    '    text-align: center;\n' +
                    '    text-decoration: none;\n' +
                    '    display: inline-block;\n' +
                    '    font-size: 13px;\n' +
                    '    margin: 0px 0px;\n' +
                    '    cursor: pointer;\n' +
                    '    border-radius: 8px;\n' +
                    '    transition: background-color 0.3s;">报价测算' +
                    '</span></a>';
            } else if (name == 'preview') {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_names').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (let i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i]) || checkXls(fileNameList[i])) {
                            html += '<a href=javascript:queryDocFile(\'' + sourcePkList[i] + '\')> ' + fileNameList[i] + '在线预览</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
        };
        //暂存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            //忽略保存校验方法
            window['${/parameter/@layout_code}_ignore_required_before_save']();
            var root_ds = $('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            var before_flag = true;
            if (before_flag) {
                var winid = '${/parameter/@winid}';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@layout_code}');

                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE() {

                    root_ds.un('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if (!flag) {
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION() {
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds, root_record, res);
                    if (typeof (nextStep) == 'function') {
                        nextStep(ds);
                    }
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                root_ds.on('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);

                root_ds.doNewSubmit(null, root_ds.getJsonData());
            } else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        };
        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_PR_BASIC');
                var record = $(ds_id).getCurrentRecord();
                var project_id = record.get('project_id');
                if (project_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/submit/credit/project',
                            para: {
                                project_id: project_id
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();
                                Leaf.showSuccessMessage("提示", "提交审批成功!");
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                }

            })
        };

        //task_detail执行提交前调用
        function beforeSubmit(countiune) {
            debugger;
            // var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_PR_BASIC');
            // if (ds_root_id) {
            //     var project_id = $(ds_root_id).getCurrentRecord().get('project_id');
            // }
            if ($('chance_appoint_user_ds').getAll().length != 0) {
                var cur_record = $('chance_appoint_user_ds').getCurrentRecord();
            }
            var service_record = $('project_legal_staff_advice_ds').getCurrentRecord();
            var risk_record = $('project_risk_back_ds').getCurrentRecord();
            var node_id = '${/parameter/@node_id}';
            var project_id = '${/parameter/@project_id}';
            if (service_record != null) {
                var legal_staff_advice = service_record.get('legal_staff_advice');
                if (node_id === 'CREDIT_TENANT_AMOUNT_WFL_S7' || node_id === 'CREDIT_TENANT_AMOUNT_WFL_S5') {
                    Leaf.request({
                        url: '${/request/@context_path}/prj/project/Legal/update/Advice',
                        para: {
                            project_id: project_id,
                            legal_staff_advice: legal_staff_advice
                        },
                        success: function (res) {
                        },
                        sync: true
                    });
                }
            }
            if (risk_record != null) {
                var risk_staff_advice = risk_record.get('risk_staff_advice');
                if ( node_id === 'CREDIT_TENANT_AMOUNT_WFL_S6' || node_id === 'CREDIT_TENANT_AMOUNT_WFL_S4') {
                    Leaf.request({
                        url: '${/request/@context_path}/prj/project/risk/update/Advice',
                        para: {
                            project_id: project_id,
                            risk_staff_advice: risk_staff_advice
                        },
                        success: function (res) {
                        },
                        sync: true
                    });
                }
            }

            countiune();
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
