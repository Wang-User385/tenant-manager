        //租赁物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_EQUIPMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var param = {};
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_detail_new_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'lease_info_detaill_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        //抵质押物创建
        window['${/parameter/@layout_code}_G_LIST_OF_COLLATERAL_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';

            param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
            hls_doc_get_layout_code(param, 'SW001_PLEDGE_LEASE', null, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
        };

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid';

            if ('${/parameter/@wfl_bp_flag}' == 'Y') {
                parent.parent_bp_chance_detail(param, ds_id);
            } else {
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;

            var bp_id = param.bp_id;
            var bp_name = param.bp_name;
            var bp_code = param.bp_code;

            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: 'QUERY',
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 850,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // debugger;
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
            var project_attachment_id = record.get('project_attachment_id');
            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }
            if (name == 'upload') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">附件</a>';
            }
            if (name == 'lease_item_code') {
                //debugger;
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }
            if (name == 'quotation_cal') {
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    link_function = 'quotation_ready_detail';
                    return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 30px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '报价详情' + '</a>';
                } else {
                    link_function = 'quotation_cal_detail';
                    return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 30px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '报价引用' + '</a>';
                }

            }
            if (name == 'quotation_detail') {
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    if (('${/parameter/@project_status}' == 'NOTICE_APPROVED' || '${/parameter/@project_status}' == 'NOTICE_VETO' || '${/parameter/@project_status}' == 'NOTICE_HOLD') && '${/parameter/@business_type}' != 'GENERAL_CREDIT_APPROVAL' && '${/parameter/@business_type}' != 'VENDOR_CREDIT_APPROVAL' && '${/parameter/@business_type}' != 'UNION_CREDIT_APPROVAL') {
                        link_function = 'price_approval_table';
                        return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;margin-left: -102px;" href="javascript:window[\'' + link_function + '\'](\'' + record.get('source_document_id') + '\',\'' + record.get('quotation_id') + '\');">' + '价格审批意见' + '</a>';
                    } else {
                        return '<a style="display: inline-block;background: #fff;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;margin-left: -102px;"></a>';
                    }
                } else {
                    link_function = 'quotation_detail';
                    return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;margin-left: -102px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '新建报价' + '</a>';
                }
            }
            if (name == 'attachment_data_t' && project_attachment_id) {
                link_function = 'prj_attachement_upload';
                var file_number = record.get('file_number');
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\',\'' + record.ds.id + '\');">' + '附件上传(' + file_number + ')' + '</a>';
            }
            if (name == 'lease_item_details') {
                link_function = 'lease_item_details';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '租赁物明细' + '</a>';
            }
            if (name == 'pledge_pledge_details') {
                link_function = 'pledge_pledge_details';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '抵质押物明细' + '</a>';
            }

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if (name == 'finnance_info') {
                return '<a href="javascript:open_finance_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }
        };

        function price_approval_table(project_id, quotation_id) {
            var down_url;
            var templateCode = '';
            templateCode = 'PRICE_APPROVAL_TABLE';
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&quotationId=' + quotation_id,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    // debugger;
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        window['quotation_cal_detail'] = function (record_id, ds_id) {
            var quotation_record = $(ds_id).findById(record_id);
            var quotation_id = quotation_record.get('quotation_id');
            /*if (quotation_id == undefined) {
                quotation_id = 0;
            }*/
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var project_id = prj_record.get('project_id');
            var project_name = prj_record.get('project_name');
            if (project_id == 0 || quotation_id == undefined) {
                Leaf.showMessage('提示', '请先保存再引用报价');
            } else {
                var param = quotation_record.data;
                param['url_title'] = '报价方案选择';
                param['function_code'] = 'PRJ316S2';
                param['function_usage'] = 'CREATE';
                //param['parent_ds_id'] = ds_id;
                //param['screen_width'] = '900';
                //param['side']='right';
                param['project_id'] = project_id;
                param['project_name'] = project_name;
                param['parent_ds_id'] = prj_ds_id;
                var button_hide_flag = 'N';
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    button_hide_flag = 'Y';
                }
                param['button_hide_flag'] = button_hide_flag;
                var link_id = 'PRJ316S2_QUOTATION_SELECT';
                hls_doc_get_layout_code(param, link_id, null, '${/parameter/@layout_code}');
            }

        };


        window['prj_attachement_upload'] = function (record_id, project_attachment_id,ds_id) {
            var record = $(ds_id).findById(record_id);
            var project_id = record.get('project_id');
            if (typeof (project_attachment_id) === 'undefined' || 'undefined' === project_attachment_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            var table_name;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                if(record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX1') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'HLS_PRJ_PROJECT_DOCX1';
                }else if(record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX2') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'HLS_PRJ_PROJECT_DOCX2';
                }else if(record.get('project_attachment_category') === 'HLS_PRJ_PROJECT_DOCX3') {//合同文本附件暂定不可删除
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'HLS_PRJ_PROJECT_DOCX3';
                }else {
                    url = '${/request/@context_path}/uploadFile.lview';
                    table_name = 'PRJ_PROJECT_ATTACHMENT';
                }
            }

            var document_list_ds_id;
            if (ds_id == '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds') {
                document_list_ds_id = ds_id;
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                url: url,
                params: {
                    header_id: project_attachment_id,
                    table_name:table_name,
                    winid: 'prj316_open_attachment_winid'
                },
                title: '附件',
                width: 800,
                height: 575
            });
            win.on('close', function () {
                var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                $(prj_ds_id).query;
                $(document_list_ds_id).query();
            });
        };

        window['lease_item_detail'] = function (record_id, ds_id) {
            //debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                param['function_usage'] = 'QUERY';
            }
            var link_id = 'lease_info_detaill_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        window['pledge_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.lease_item_id;
            var type = 'MODIFY';
            param['url_title'] = '抵质押物详细';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['ds_id'] = ds_id;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                param['function_usage'] = 'QUERY';
            }
            var link_id = 'SW001_PLEDGE_LEASE';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        };

        window['lease_item_details'] = function (record_id, ds_id) {
            //debugger;
            var lease_record = $(ds_id).findById(record_id).data;

            var result_id = lease_record.result_id;
            var excel_id = lease_record.excel_id;
            if (result_id == null || result_id == '' || result_id == undefined) {
                $L.showInfoMessage("提示", "请先导入租赁物物明细数据!");
                return;
            }
            if (excel_id == null || excel_id == '' || excel_id == undefined) {
                $L.showInfoMessage("提示", "模板有误!");
                return;
            }

            new Leaf.Window({
                id: 'lease_excel_detail_win_id',
                params: {
                    result_id: lease_record.result_id,
                    excel_id: lease_record.excel_id,
                    source_document_category: 'HLS_LEASE_ITEM_RENTAL',
                    source_document_id: lease_record.lease_item_id,
                    winid: 'lease_excel_detail_win_id',
                    readOnly: 'Y'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '租赁物明细',
                fullScreen: true
            });
        };

        window['pledge_pledge_details'] = function (record_id, ds_id) {
            //debugger;
            var lease_record = $(ds_id).findById(record_id).data;

            var result_id = lease_record.result_id;
            var excel_id = lease_record.excel_id;
            if (result_id == null || result_id == '' || result_id == undefined) {
                $L.showInfoMessage("提示", "请先导入抵质押物明细数据!");
                return;
            }
            if (excel_id == null || excel_id == '' || excel_id == undefined) {
                $L.showInfoMessage("提示", "模板有误!");
                return;
            }


            var win = new Leaf.Window({
                id: 'bp100_excel_detail_win_id',
                params: {
                    result_id: result_id,
                    excel_id: excel_id,
                    source_document_category: 'MORTGAGE_PLEDGE_REPORT',
                    winid: 'bp100_excel_detail_win_id',
                    readOnly: 'Y'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '抵质押物报表明细',
                fullScreen: true
            });
        };

        window['upload_file'] = function (record_id, project_attachment_id) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'PRJ_PROJECT_ATTACHMENT',
                    winid: 'prj316_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                //var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_ATTACHMENTS_prj_project_attachment_ds";
                var document_list_ds_id = "${/parameter/@layout_code}_G_BASIC_DATA_prj_project_attachment_ds";
                $(document_list_ds_id).query();
            });
        }

        //保存前调用
        function prj316f1_before_save() {
            //debugger;
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');

            var project_record = $(project_ds).getCurrentRecord();

            if (tenant_sec_count == 0) {
                project_record.set('tenant_sec_id', '');
            }

            if (warrantor_count == 0) {
                project_record.set('guarantor_id', '');
            }

            if (warrantor_count_np == 0) {
                project_record.set('guarantor_np_id', '');
            }

            //校验承租人信息
            //var bpDatas = $('${/parameter/@layout_code}_G_COUNTERPATRY_INFO_prj_project_bp_ds').getAll();

            //承租人保存
            /*var tenant_records = [];
            var tenant_record = $jq("#prj_project_tenant_sec_iframe")[0].contentWindow.$('prj_create_tenant_ds').getCurrentRecord();
            tenant_records.push(tenant_record);
            tenant_records[0].set('project_id', project_record.get('project_id'));
            tenant_records[0].set('bp_categroy', 'PRJ_PROJECT');
            tenant_records[0].set('bp_type', 'TENANT');


            var tenant_exist_flag = false;
            for (var i = 0; i < tenant_records.length; i++) {
                var bp_record = tenant_records[i];
                if (bp_record.get('bp_type') === 'TENANT') {
                    tenant_exist_flag = true;
                    //project_record.set('project_name', bp_record.get('bp_name') + project_record.get('business_type_n'));
                }
            }
            if (ds.id === project_ds) {
                if (!tenant_exist_flag) {
                    $L.showInfoMessage("提示", "请在交易方信息（必输）填写承租人信息!");
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }
            //删除额度信息，财务信息，这两个信息不需要保存
            var dataObj = $('${/parameter/@layout_code}_virtual_ds').getCurrentRecord().data;
            if (dataObj['${/parameter/@layout_code}_F_CREDIT_PLAN_hls_credit_line']) {
                delete dataObj['${/parameter/@layout_code}_F_CREDIT_PLAN_hls_credit_line'];
            }
            if (dataObj['${/parameter/@layout_code}_F_FINANCIAL_INFO_hls_fin_statement_hd']) {
                delete dataObj['${/parameter/@layout_code}_F_FINANCIAL_INFO_hls_fin_statement_hd'];
            }*/


            var check_flag = true;

            var document_category = "PRJ_PROJECT";
            var document_type = 'PRJ_PROJECT';
            var business_type = project_record.get('business_type');
            var employee_code = project_record.get('employee_code');


            if (project_record.get('project_number')) {
                return true;
            }


            //设置权限字符串
            window['${/parameter/@layout_code}_set_authority_rule_string'](document_type, business_type, employee_code);

            Leaf.request({
                url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    $(ds_id).getCurrentRecord().set('project_number', res.result.record[0]);
                    check_flag = true;
                },
                error: function (res) {
                    check_flag = false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    check_flag = false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });


            return check_flag;
        }

        //忽略保存校验方法
