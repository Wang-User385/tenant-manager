        Leaf.onReady(function () {
            tenant_sec_count = '${/parameter/@tenant_sec_count}';
            tenant_sec_max = '${/parameter/@tenant_sec_max}';
            warrantor_count = '${/parameter/@warrantor_count}';
            warrantor_max = '${/parameter/@warrantor_max}';
            warrantor_count_np = '${/parameter/@warrantor_count_np}';
            warrantor_max_np = '${/parameter/@warrantor_max_np}';
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC_INFO');

            if ('${/parameter/@create_flag}' != '') {
                create_flag = '${/parameter/@create_flag}';
            }


            // setTimeout(function () {
            //     //判断是否有值 没值 自动创建一条空记录
            //     var prj_quotation_ds = $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds');
            //     var records = prj_quotation_ds.getAll();
            //     if (records.length == 0) {
            //         prj_quotation_ds.create();
            //     }
            // }, 1000);

            if (warrantor_count == 0 && warrantor_count_np == 0) {
                $jq("#prj_project_guarantor_iframe").hide();
            }

            if ('${/parameter/@return_flag}' == 'Y') {
                $('PROJECT_MODIFY_FINANCE_LEASE_user_button2').hide();
                $('PROJECT_MODIFY_FINANCE_LEASE_user_button6').hide();
            }


        });

        <!--打开窗口：指标明细-->
        function parent_winOpen_indicator_anaysis(header_id, report_year_one, report_year_two, report_year_three, report_year_four) {
            // debugger;
            if (report_year_one == null || report_year_one == 'undefined' || report_year_one == '') {
                report_year_one = '';
            }
            if (report_year_two == null || report_year_two == 'undefined' || report_year_two == '') {
                report_year_two = '';
            }
            if (report_year_three == null || report_year_three == 'undefined' || report_year_three == '') {
                report_year_three = '';
            }
            if (report_year_four == null || report_year_four == 'undefined' || report_year_four == '') {
                report_year_four = '';
            }
            new Leaf.Window({
                id: 'sys_resource_access_component_detail_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_indicator_info.lview',
                params: {
                    header_id: header_id,
                    report_year_one: report_year_one,
                    report_year_two: report_year_two,
                    report_year_three: report_year_three,
                    report_year_four: report_year_four,
                    winId: "sys_resource_access_component_detail_winId"
                },
                title: '报表明细',
                width: 830,
                height: 535,
                side: "right",
                draggable: true
            });

        }

        <!--打开窗口：报表明细-->
        function parent_winOpen_access_detail_component(result_id, excel_id) {
            if (result_id == null || result_id == '') {
                $L.showInfoMessage("提示", "参数获取失败!");
                return;
            }
            new Leaf.Window({
                id: 'bp100_excel_detail_win_id',
                params: {
                    result_id: result_id,
                    excel_id: excel_id,
                    source_document_category: 'HLS_BP_MASTER',
                    winid: 'bp100_excel_detail_win_id'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '财务报表明细',
                fullScreen: true
            });

        }

        <!--打开窗口：报表分期明细-->
        function parent_winOpen_access_component(header_id, fiscal_year) {
            new Leaf.Window({
                id: 'sys_resource_access_component_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_period_info.lview',
                params: {
                    header_id: header_id,
                    fiscal_year: fiscal_year,
                    bp_id: '${/parameter/@bp_id}',
                    winId: "sys_resource_access_component_winId"
                },
                title: '报表明细',
                width: 830,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //报价计算入口
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            if (!$('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').validate()) {
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'](function () {
                Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                Leaf.request({
                    url: $('prj316_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                    type: "GET",
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '计算成功',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        win.on('close', function () {
                            $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
                            $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
                        });
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }, 'N');
        }

        //报价计算
        window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'] = function (func, calcFlag) {
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            var excelEdit = '${/parameter/@excel_edit}';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = url + '&readOnly=Y';
            }
            // 进入excel前打包数据存入excel
            var param = {};
            var data = $(quote_ds_id).getCurrentRecord();
            if (data) {
                // param = data[0];
                param = data.data;
            }
            if (calcFlag == 'N') {
                param['calc_flag'] = 'N';
            }
            //param带入excel
            Leaf.request({
                url: $('prj316_quotation_info_save_link_id').getUrl(),
                type: "POST",
                para: param,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                    if (typeof func == 'function') {
                        func();
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
