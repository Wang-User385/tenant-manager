        //报告生成
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if ($(ds_id).validate()) {
                var record = $(ds_id).getCurrentRecord();
                var source_pk_value1 = record.get('source_pk_value1');
                if (!source_pk_value1) {
                    if (record.get('project_id') && record.get('project_id') != null && record.get('project_id') != '') {
                        Leaf.Masker.mask(Ext.getBody(), '正在生成项目尽调报告...');
                        Leaf.request({
                            url: "${/request/@context_path}/prj/project/create/content",
                            para: {project_id: record.get('project_id'), template_code: 'PRJ_REPORT_CONTENT'},
                            success: function (res) {
                                console.log(res);
                                var source_pk_value1 = res.result.record[0].source_pk_value1;
                                $(ds_id).query();
                                if (source_pk_value1 == 'undefined' || source_pk_value1 == '' || source_pk_value1 == null) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.showInfoMessage('未找到项目尽调报告模板!');
                                    return;
                                } else {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    // Leaf.showInfoMessage('合同文本生成成功!');
                                    var ds_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_SEND_REVIEW_REPORT');
                                    $(ds_att).query();
                                    editOffice(source_pk_value1);
                                }
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    } else {
                        $L.showInfoMessage("提示", "请先保存再生成项目尽调报告!");
                    }
                } else {
                    editOffice(source_pk_value1);
                }
            }
        };


        // 在线编辑
        function editOffice(source_pk_value) {
            //查看
            if (source_pk_value) {
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
                } else {
                    //编辑
                    window.open("${/request/@context_path}/sys/office/review?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
                }
            } else {
                $L.showInfoMessage("提示", "合同文本不存在，请先生成项目尽调报告!");
            }

            //转PDF
            // window.open(/sys/office/convert?sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=15961', '_blank');
        }


        //客户信息维护
        function bp_modify(param_temp) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var param = {
                bp_id: param_temp.bp_id,
                bp_class: param_temp.bp_class
            };
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'MODIFY';
            param['enabled_flag'] = 'Y';
            param['url_title'] = '客户信息维护';
            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', prj_ds_id, 'BP100F1');
        }

        //主承租人变化
        function tenant_id_change(bp_record) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            prj_record.set('tenant_id', bp_record.bp_id);
            prj_record.set('tenant_id_n', bp_record.bp_id_n);
            prj_record.set('bp_name', bp_record.bp_id);
            prj_record.set('bp_name_n', bp_record.bp_id_n);
        }

        //共同承租人变化
        function tenant_sec_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var tenant_sec_id = '';
            var tenant_sec_id_n = '';
            for (var i = 1; i <= tenant_sec_count; i++) {
                var tenant_sec_ds_id = 'prj_create_tenant_rec_' + i + '_ds';
                var tenant_sec_record = $jq("#prj_project_tenant_sec_iframe")[0].contentWindow.$(tenant_sec_ds_id).getCurrentRecord();
                if (tenant_sec_record != null) {
                    if (tenant_sec_id == '') {
                        if (tenant_sec_record.get('bp_id')) {
                            tenant_sec_id = tenant_sec_id + tenant_sec_record.get('bp_id');
                            tenant_sec_id_n = tenant_sec_id_n + tenant_sec_record.get('bp_id_n');
                        }
                    } else {
                        if (tenant_sec_record.get('bp_id')) {
                            tenant_sec_id = tenant_sec_id + ',' + tenant_sec_record.get('bp_id');
                            tenant_sec_id_n = tenant_sec_id_n + ',' + tenant_sec_record.get('bp_id_n');
                        }
                    }
                }

            }
            prj_record.set('tenant_sec_id', tenant_sec_id);
            prj_record.set('tenant_sec_id_n', tenant_sec_id_n);
        }

        //法人担保人变化
        function guarantor_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var guarantor_id = '';
            var guarantor_id_n = '';
            for (var i = 1; i <= warrantor_count; i++) {
                var guarantor_ds_id = 'prj_create_guarantor_' + i + '_ds';
                var guarantor_record = $jq("#prj_project_guarantor_iframe")[0].contentWindow.$(guarantor_ds_id).getCurrentRecord();
                if (guarantor_record != null) {
                    if (guarantor_id == '') {
                        if (guarantor_record.get('bp_id')) {
                            guarantor_id = guarantor_id + guarantor_record.get('bp_id');
                            guarantor_id_n = guarantor_id_n + guarantor_record.get('bp_id_n');
                        }
                    } else {
                        if (guarantor_record.get('bp_id')) {
                            guarantor_id = guarantor_id + ',' + guarantor_record.get('bp_id');
                            guarantor_id_n = guarantor_id_n + ',' + guarantor_record.get('bp_id_n');
                        }
                    }
                }

            }
            prj_record.set('guarantor_id', guarantor_id);
            prj_record.set('guarantor_id_n', guarantor_id_n);
        }

        //自然人担保人变化
        function guarantor_np_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var guarantor_np_id = '';
            var guarantor_np_id_n = '';
