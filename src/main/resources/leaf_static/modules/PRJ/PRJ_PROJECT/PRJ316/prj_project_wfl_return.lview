<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl.lview"/>
        <script><![CDATA[
        //debugger;


        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }


        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var refProjectId = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectIdOld";
        });
        if(refProjectId && refProjectId.length === 1){
            refProjectId = refProjectId[0].value;
        }

        Leaf.Masker.mask(Ext.getBody());
        Leaf.request({
            url: '${/request/@context_path}/ct/prj/project/prjHomePageProjectInfoGrid?projectId=' + projectId,
            type: "POST",
            success: function (res) {
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.SideBar.show({
                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                    duration: 2000
                });
                //debugger;
                //console.log(res);
                var tenant_id = res.result.record[0].tenant_id;
                var tenant_sec_id = res.result.record[0].tenant_sec_id;
                var marketing_report_id = res.result.record[0].marketing_report_id;
                var tenant_sec_count = res.result.record[0].tenant_sec_count;
                var warrantor_count = res.result.record[0].warrantor_count;
                var warrantor_count_np = res.result.record[0].warrantor_count_np;
                var pageChooser = new PageChooser({
                    url: $('prj_project_wfl_detail_link_id').getUrl(),
                    function_code: 'PRJ316WFL',
                    context_path: '${/request/@context_path}',
                    opt: {
                        project_id:      projectId,
                        ref_project_id: refProjectId,
                        tenant_id: tenant_id,
                        tenant_sec_id: tenant_sec_id,
                        marketing_report_id: marketing_report_id,
                        tenant_sec_count: tenant_sec_count,
                        warrantor_count: warrantor_count,
                        warrantor_count_np: warrantor_count_np,
                        //quotation_id:    quotationId,
                        maintain_type: 'READONLY',
                        function_usage: 'QUERY',
                        return_flag: 'Y'
                    },
                    success: function (realUrl) {
                        location.href = realUrl;
                    }
                });
            },
            error: function (res) {
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.SideBar.show({
                    type: 'warning',
                    msg: '操作失败',
                    duration: 1000
                });
            },
            failure: function (res) {
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.SideBar.show({
                    type: 'warning',
                    msg: '操作失败',
                    duration: 1000
                });
            },
            scope: this
        });




        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>