<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj316wfl_project_query_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var creditLine = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "creditLineId";
        });
        var creditLineId = creditLine[0].value;

        var finStatementHd = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "finStatementHdId";
        });
        var finStatementHdId = finStatementHd[0].value;

        var pageChooser = new PageChooser({
            url: $('prj316wfl_project_query_id').getUrl(),
            function_code: 'PRJ316F2',
            context_path: '${/request/@context_path}',
            opt: {
                project_id:      projectId,
                credit_line_id:  creditLineId,
                fin_statement_hd_id:finStatementHdId,
                function_usage: 'MODIFY',
                function_code:  'PRJ316F2',
                hidden_button_code: ['SUBMIT_APPROVAL','EXIT']
                //hidden_button_code: ['SUBMIT_APPROVAL' ]
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>