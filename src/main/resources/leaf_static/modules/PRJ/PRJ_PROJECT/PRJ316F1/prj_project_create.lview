<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
    $Date: 2019-2-13 上午16:09:00
    $Revision: 1.0
    $Purpose: 项目创建入口
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj316f2_project_create_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="prj316s1_tenant_sec_select_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316S1/prj_project_tenant_sec_select.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

        };
        function PRJ316F1_CLOSE(){
            $('${/parameter/@winid}').close();
        }
        function PRJ316F1_SURE(){
            if ($('${/parameter/@layout_code}_F_FORM__ds').validate()) {
                var record = $('${/parameter/@layout_code}_F_FORM__ds').getAt(0);
                var param = record.data;
                var function_code,windId;
                windId = 'prj316f2_project_create_id';
                function_code = 'PRJ316F2';
                param['function_code'] = function_code;
                param['function_usage'] = 'CREATE';
                param['url_title'] = '项目新建';
                param['create_flag'] = 'Y';
                param['project_id'] = 0;
                param['tenant_sec_max'] = record.data.tenant_sec_count;
                param['warrantor_max'] = record.data.warrantor_count;
                param['warrantor_max_np'] = record.data.warrantor_count_np;
                /*param['tenant_sec_id'] = '0';
                param['guarantor_id'] = '0';
                param['guarantor_id_np'] = '0';*/

                //console.log(record);
                console.log(param);
                hls_doc_get_layout_code(param, windId, null, function_code,null,null,'PRJ316F1_CLOSE');
            }
        }

        Leaf.onReady(function() {
            var record = $('${/parameter/@layout_code}_F_FORM__ds').getCurrentRecord();
            record.set('project_manager','${/session/@employeeName}');
            record.set('employee_id','${/session/@employeeId}');
            record.set('lease_organization_n','${/session/@unitName}');
            record.set('lease_organization','${/session/@unitId}');

            $jq("#PRJ316F1_F_FORM_NULL_TENANT_SEC_ID_N").click(function(){
                var ds_id = '${/parameter/@layout_code}_F_FORM__ds';
                var param = {
                    function_code: 'PRJ316S1',
                    function_usage: 'CREATE',
                    url_title: '共同承租人选择',
                    parent_ds_id: ds_id,
                    screen_width: '800',
                    side: 'right'
                };

                hls_doc_get_layout_code(param, 'prj316s1_tenant_sec_select_id', null, 'PRJ316S1');
            })

            setTimeout(function() {
                //判断是否有值 没值 自动创建一条空记录
                var prj_quotation_ds = $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds');
                var records =prj_quotation_ds.getAll();
                if(records.length == 0){
                    prj_quotation_ds.create();
                }
            }, 1000);

        });







        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="PRJ316F1_CLOSE" text="关闭"/>
                <a:gridButton click="PRJ316F1_SURE" text="确定"/>
            </a:screenTopToolbar>
        </a:screenBody>
    </a:view>
</a:screen>
