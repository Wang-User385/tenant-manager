<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="prj_meeting_summary_notice_link"  url="${/request/@context_path}/hls/contract/summary/noticeFile"/>
        <script><![CDATA[
        //业审委综合意见
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;

            //上个页面需要传主键id  : project_meeting_id
            var project_meeting_id = '${/parameter/@project_meeting_id}' ;
            var project_id = '${/parameter/@project_id}' ;
            //先假设一个
            project_meeting_id =  2 ;
            project_id = 804

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_meeting');
            if($(ds_id).validate()){
                var dsRecord = $(ds_id).getCurrentRecord().data;
                dsRecord.project_meeting_id = project_meeting_id;
                dsRecord.project_id = project_id;
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                //保存数据
                //生成word
                Leaf.request({
                    url: $('prj_meeting_summary_notice_link').getUrl(),
                    para: dsRecord,
                    success: function (res) {
                        /*Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });*/
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示","成功！");
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });


            }

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
