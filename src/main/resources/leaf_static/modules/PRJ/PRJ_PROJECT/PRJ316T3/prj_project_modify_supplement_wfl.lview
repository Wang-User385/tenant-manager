        function hls_project_detail(){
            //debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();

            //报价方案
            var pq_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            //一、尽调工作开展概况
            var verification_work_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_VERIFICATION_WORK');
            //二、尽调真实性工作开展情况
            var do_the_work_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_DO_THE_WORK');
            //三、租赁物现场核实资料
            var information_site_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_INFORMATION_SITE');
            //四、用资项目现场核实资料
            var funded_project_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_FUNDED_PROJECT');
            //五、抵质押物现场核实资料
            var verify_information_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_VERIFY_INFORMATION');
            //送审流程材料
            var review_material_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_REVIEW_MATERIAL');
            //基础档案资料
            var basic_materials_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_BASIC_MATERIALS');
            //风险管理部意见
            var review_comments_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project','F_REVIEW_COMMENTS');
            var price_note_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project','F_PRICE_NOTE');
            var project_bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp','G_PROJECT_BP');
            var file_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_FILE');
            var question_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_wfl_question','G_QUESTION');

            //补充尽调
            var prj_project_supplement_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_supplement', 'F_PROJECT_SUPPLEMENT');



            var param = prj_record.data , function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = prj_record.get('project_status');
            //if (project_status == 'APPROVING' || project_status == 'APPROVED' || project_status == 'PENDING') {
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            //}
           /* if('${/parameter/@return_flag}' == 'Y'){
                param['maintain_type'] = 'UPDATE';
                param['function_usage'] = 'MODIFY';
                param['return_flag'] = 'Y';
            }*/
            //去除ds,防止栈溢出
            param[pq_ds_id.replace('_ds','')]=undefined;
            param[verification_work_attach_ds_id.replace('_ds','')]=undefined;
            param[do_the_work_attach_ds_id.replace('_ds','')]=undefined;
            param[information_site_attach_ds_id.replace('_ds','')]=undefined;
            param[funded_project_attach_ds_id.replace('_ds','')]=undefined;
            param[verify_information_attach_ds_id.replace('_ds','')]=undefined;
            param[review_material_attach_ds_id.replace('_ds','')]=undefined;
            param[basic_materials_attach_ds_id.replace('_ds','')]=undefined;
            param[review_comments_ds_id.replace('_ds','')]=undefined;
            param[price_note_ds_id.replace('_ds','')]=undefined;
            param[project_bp_ds_id.replace('_ds','')]=undefined;
            param[file_ds_id.replace('_ds','')]=undefined;
            param[question_ds_id.replace('_ds','')]=undefined;
            param[prj_project_supplement_ds_id.replace('_ds','')]=undefined;
            //console.log(param);

            hls_doc_get_layout_code(param, 'prj316wfl_project_query_id', prj_ds_id, function_code);
        }

        function hls_chance_detail(){
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            if(prj_record.get('chance_id') == null || prj_record.get('chance_id') == ''){
                Leaf.showMessage('提示','该尽调报告免于立项！');
            }else{
                var param = {};
                param['chance_id'] = prj_record.get('chance_id');
                //var status = param.credit_line_status;
                param['url_title'] = '立项查询';
                param['function_code'] = 'PRJ001F1';
                param['function_usage'] = 'QUERY';
                param['winid'] = 'prj_chance_detail_winid';
                param['ds_id'] = prj_ds_id;
                var link_id = 'prj_chance_detail_id';
                hls_doc_get_layout_code(param, link_id, prj_ds_id, 'PRJ316T3WFL');
            }
        }

        function hls_project_notice_meeting(){
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();

            var param = {};
            param['project_id'] = prj_record.get('project_id');
            param['url_title'] = '授信审批通知书详情';
            param['function_code'] = 'PRJ316T1';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            param['winid'] = 'project_credit_notice_id';
            param['ds_id'] = prj_ds_id;
            var link_id = 'project_credit_credit_notice_link';
            hls_doc_get_layout_code(param, link_id, prj_ds_id, 'PRJ316T3WFL');
        }



        ]]></script>


        <a:screenBody>
