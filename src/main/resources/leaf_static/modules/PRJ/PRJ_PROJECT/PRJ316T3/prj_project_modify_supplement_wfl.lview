        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            if (ds.id === '${/parameter/@layout_code}_G_PRE_LEASE_INTEREST_con_contract_before_rent_h_ds') {
                record.set('company_id', '${/session/@companyId}');
            }
            if (ds.id === '${/parameter/@layout_code}_G_OTHER_RECEIVABLES_prj_quotation_cashflow_ds') {
                record.set('cf_item', 0);
                record.set('source_document_id', project_record.get('project_id'));
                record.set('source_document_category', 'PRJ_PROJECT_INVEST');
                record.set('data_class', 'PRJ_PROJECT');
            }
            if (ds.id === '${/parameter/@layout_code}_G_VERIFICATION_WORK_prj_project_attachment_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('serial_number_t', length);
            }
            if (ds.id === '${/parameter/@layout_code}_G_DO_THE_WORK_prj_project_attachment_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('serial_number_t', length);
            }
            if (ds.id === '${/parameter/@layout_code}_G_INFORMATION_SITE_prj_project_attachment_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('serial_number_t', length);
            }
            if (ds.id === '${/parameter/@layout_code}_G_FUNDED_PROJECT_prj_project_attachment_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('serial_number_t', length);
            }
            if (ds.id === '${/parameter/@layout_code}_G_VERIFY_INFORMATION_prj_project_attachment_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('serial_number_t', length);
            }
        };

        $L.ComboBox.prototype.collapse = function () {
            Ext.get(document.documentElement).un("mousedown", this.triggerBlur, this);
            if (this.popup) {
                this.popup.moveTo(-1000, -1000);
                this.popup.removeClass('animated zoomInDownPopup');
                this.popup.addClass('animated zoomOut');
            }
            this.fireEvent("collapse", this);
        }

        //尽调报告附件上传
        window['${/parameter/@layout_code}_G_DUE_DILIGENCE_REPORT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == null) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                //url = '${/request/@context_path}/downloadFile.lview';
                $L.showInfoMessage("提示", "当前无法编辑页面!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': project_id,
                    'table_name': 'PRJ_PROJECT',
                    winid: 'prj316_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_DUE_DILIGENCE_REPORT_prj_project_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        //基础资料附件上传
        window['${/parameter/@layout_code}_G_BASIC_DATA_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == null) {
