        //保存前调用
        function prj316f1_before_save() {
            debugger;
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');

            var project_record = $(project_ds).getCurrentRecord();

            if (tenant_sec_count == 0) {
                project_record.set('tenant_sec_id', '');
            }

            if (warrantor_count == 0) {
                project_record.set('guarantor_id', '');
            }

            if (warrantor_count_np == 0) {
                project_record.set('guarantor_np_id', '');
            }

            //校验承租人信息
            //var bpDatas = $('${/parameter/@layout_code}_G_COUNTERPATRY_INFO_prj_project_bp_ds').getAll();

            //承租人保存
            /*var tenant_records = [];
            var tenant_record = $jq("#prj_project_tenant_sec_iframe")[0].contentWindow.$('prj_create_tenant_ds').getCurrentRecord();
            tenant_records.push(tenant_record);
            tenant_records[0].set('project_id', project_record.get('project_id'));
            tenant_records[0].set('bp_categroy', 'PRJ_PROJECT');
            tenant_records[0].set('bp_type', 'TENANT');


            var tenant_exist_flag = false;
            for (var i = 0; i < tenant_records.length; i++) {
                var bp_record = tenant_records[i];
                if (bp_record.get('bp_type') === 'TENANT') {
                    tenant_exist_flag = true;
                    //project_record.set('project_name', bp_record.get('bp_name') + project_record.get('business_type_n'));
                }
            }
            if (ds.id === project_ds) {
                if (!tenant_exist_flag) {
                    $L.showInfoMessage("提示", "请在交易方信息（必输）填写承租人信息!");
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }
            //删除额度信息，财务信息，这两个信息不需要保存
            var dataObj = $('${/parameter/@layout_code}_virtual_ds').getCurrentRecord().data;
            if (dataObj['${/parameter/@layout_code}_F_CREDIT_PLAN_hls_credit_line']) {
                delete dataObj['${/parameter/@layout_code}_F_CREDIT_PLAN_hls_credit_line'];
            }
            if (dataObj['${/parameter/@layout_code}_F_FINANCIAL_INFO_hls_fin_statement_hd']) {
                delete dataObj['${/parameter/@layout_code}_F_FINANCIAL_INFO_hls_fin_statement_hd'];
            }*/


            var check_flag = true;

            var document_category = "PRJ_PROJECT";
            var document_type = 'PRJ_PROJECT';
            var business_type = project_record.get('business_type');
            var employee_code = project_record.get('employee_code');


            if (project_record.get('project_number')) {
                return true;
            }


            //设置权限字符串
            window['${/parameter/@layout_code}_set_authority_rule_string'](document_type, business_type, employee_code);

            Leaf.request({
                url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    $(ds_id).getCurrentRecord().set('project_number', res.result.record[0]);
                    check_flag = true;
                },
                error: function (res) {
                    check_flag = false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    check_flag = false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });


            return check_flag;
        }

        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            //报价方案
            var pq_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            //基础资料
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            //附件
            //送审流程材料
            //var review_material_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_REVIEW_MATERIAL');
            //基础档案资料
            var basic_materials_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_BASIC_MATERIALS');
            //补充尽调
            var prj_project_supplement_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_supplement', 'F_PROJECT_SUPPLEMENT');


            //报价方案
            var pq_records = $(pq_ds_id).getAll();
            var hlsCusPrjQuotationList = [];
            for (var i = 0; i < pq_records.length; i++) {
                hlsCusPrjQuotationList.push(pq_records[i].data);
            }
            var project_record = $(prj_ds_id).getCurrentRecord();

            //送审业务方案
            var hlsCusPrjProject = $(prj_ds_id).getCurrentRecord().data;
            //var hlsCusPrjProjectBpList = $(prj_bp_ds_id).getAll();


            //附件
            var hlsCusPrjProjectAttachmentList = [];

            //送审流程材料
            /*var review_material_attachs = $(review_material_attach_ds_id).getAll();
            for(var i=0;i<review_material_attachs.length;i++){
                review_material_attachs[i].data['project_attachment_category'] = 'PRJ_REVIEW_MATERIAL';
                hlsCusPrjProjectAttachmentList.push(review_material_attachs[i].data);
            }*/
            //基础档案资料
            debugger;
            var basic_materials_attachs = $(basic_materials_attach_ds_id).getAll();
            if(basic_materials_attachs.length == 0){
                Leaf.showMessage('提示','请先维护基础档案材料！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }
            for (var i = 0; i < basic_materials_attachs.length; i++) {
                basic_materials_attachs[i].data['project_attachment_category'] = 'PRJ_BASIC_MATERIALS';
                hlsCusPrjProjectAttachmentList.push(basic_materials_attachs[i].data);
            }
            var prj_project_supplement_record = $(prj_project_supplement_ds_id).getCurrentRecord();
            var prj_supplement_result = prj_project_supplement_record.get('prj_supplement_result');
            if(prj_supplement_result == null || prj_supplement_result == '' || prj_supplement_result == undefined){
                $L.showInfoMessage("提示" , "请输入补充尽调内容");
                return;
            }
            var hlsCusPrjProjectSupplement = prj_project_supplement_record.data;

            //去除ds,防止栈溢出
            hlsCusPrjProject[pq_ds_id.replace('_ds', '')] = undefined;
            hlsCusPrjProject[attachment_ds_id.replace('_ds', '')] = undefined;
            //hlsCusPrjProject[review_material_attach_ds_id.replace('_ds','')]=undefined;
            hlsCusPrjProject[basic_materials_attach_ds_id.replace('_ds', '')] = undefined;
            hlsCusPrjProject[prj_project_supplement_ds_id.replace('_ds', '')] = undefined;


            if ($(prj_ds_id).validate()) {
                //上会类型
                hlsCusPrjProject['meeting_type'] = 'PROJECT_CREDIT';
                // hlsCusPrjProject['prj_supple_id'] = prj_project_supplement_record.data.prj_supple_id;

                        Leaf.request({
                            url: $('prj316f2_prj_wfl_supple_submit_link_id').getUrl(),
                            para: {
                                project_id: project_record.get('project_id'),
                                assist_unit_id: project_record.get('assist_unit_id'),
                                prj_supple_id : prj_project_supplement_record.get('prj_supple_id')
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $L.showInfoMessage("提示", "提交成功!", function () {
                                    $('${/parameter/@ds}').query();
                                    $('${/parameter/@winid}').close();
                                });
                            },
                            error: function (res) {
                                $L.showInfoMessage("提示", "提交失败!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function (res) {
                                $L.showInfoMessage("提示", "提交失败!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this

                });
            }


        };

        //保存
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            //送审业务方案
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            if (prj_record.get('business_type') == null || prj_record.get('business_type') == '') {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示', '必须填写业务种类才能保存!');
            } else {
                //报价方案
                var pq_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                //基础资料
                var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

                //附件
                //送审流程材料
                //var review_material_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_REVIEW_MATERIAL');
                //基础档案资料
                var basic_materials_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_BASIC_MATERIALS');

                //补充尽调
                var prj_project_supplement_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_supplement', 'F_PROJECT_SUPPLEMENT');

                //送审业务方案
                var hlsCusPrjProject = $(prj_ds_id).getCurrentRecord().data;
                //报价方案
                var pq_records = $(pq_ds_id).getAll();
                var hlsCusPrjQuotationList = [];
                for (var i = 0; i < pq_records.length; i++) {
                    hlsCusPrjQuotationList.push(pq_records[i].data);
                }

                //附件
                var hlsCusPrjProjectAttachmentList = [];

                //送审流程材料
                /*var review_material_attachs = $(review_material_attach_ds_id).getAll();
                for(var i=0;i<review_material_attachs.length;i++){
                    review_material_attachs[i].data['project_attachment_category'] = 'PRJ_REVIEW_MATERIAL';
                    hlsCusPrjProjectAttachmentList.push(review_material_attachs[i].data);
                }*/
                //基础档案资料
                var basic_materials_attachs = $(basic_materials_attach_ds_id).getAll();
                for (var i = 0; i < basic_materials_attachs.length; i++) {
                    basic_materials_attachs[i].data['project_attachment_category'] = 'PRJ_BASIC_MATERIALS';
                    hlsCusPrjProjectAttachmentList.push(basic_materials_attachs[i].data);
                }
                //console.log(hlsCusPrjProjectAttachmentList);

                var prj_project_supplement_record = $(prj_project_supplement_ds_id).getCurrentRecord();
                var prj_supplement_result = prj_project_supplement_record.get('prj_supplement_result');
                if(prj_supplement_result == null || prj_supplement_result == '' || prj_supplement_result == undefined){
                    $L.showInfoMessage("提示" , "请输入补充尽调内容");
                    return;
                }
                var hlsCusPrjProjectSupplement = prj_project_supplement_record.data;


                //去除ds,防止栈溢出
                hlsCusPrjProject[pq_ds_id.replace('_ds', '')] = undefined;
                hlsCusPrjProject[attachment_ds_id.replace('_ds', '')] = undefined;
                //hlsCusPrjProject[review_material_attach_ds_id.replace('_ds','')]=undefined;
                hlsCusPrjProject[basic_materials_attach_ds_id.replace('_ds', '')] = undefined;
                hlsCusPrjProject[prj_project_supplement_ds_id.replace('_ds', '')] = undefined;
                Leaf.request({
                    url: '${/request/@context_path}/ct/prj/project/submit/supple',
                    para: {
                        hlsCusPrjProject: hlsCusPrjProject,
                        hlsCusPrjQuotationList: hlsCusPrjQuotationList,
                        hlsCusPrjProjectAttachmentList: hlsCusPrjProjectAttachmentList,
                        hlsCusPrjProjectSupplement : hlsCusPrjProjectSupplement
                    },
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        //debugger;
                        //console.log(res);
                        prj_record.set('project_id', res.result.record[0].project_id);
                        prj_project_supplement_record.set('prj_supple_id' , res.result.record[0].prj_supple_id );
                        Leaf.showSuccessMessage('提示', '保存成功', function () {
                            create_flag = 'N';
                            supple_flag = 'N';
                            // $(prj_ds_id).query();
                            $(prj_project_supplement_ds_id).query();

                        });
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });


            }


        };

        //客户个数修改
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            //Leaf.showMessage('提示','开发中...');
            var param = {
                function_code: 'PRJ316S3',
                function_usage: 'MODIFY',
                url_title: '客户个数修改'
            };
