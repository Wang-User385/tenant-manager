        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
            if (name == 'download') {
                return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
            }
            if (name == 'upload') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">附件</a>';
            }
            if (name == 'lease_item_code') {
                debugger;
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }
            if (name == 'quotation_cal') {
                // link_function = 'quotation_cal_detail';
                link_function = 'quotation_cal_detail_wfl';
                return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 30px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '报价详情' + '</a>';
            }
            /*if(name == 'quotation_detail'){
                link_function = 'quotation_detail';
                return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 305px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '新建报价' + '</a>';
            }*/
            if (name == 'attachment_data_t') {
                link_function = 'prj_attachement_upload';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传' + '</a>';
            }
            if (name == 'lease_item_details') {
                link_function = 'lease_item_details';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '租赁物明细' + '</a>';
            }
            if (name == 'pledge_pledge_details') {
                link_function = 'pledge_pledge_details';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '抵质押物明细' + '</a>';
            }

            if (name == 'file_name'){
                if(record.get('file_name') != null && record.get('attachment_id_list') != null) {
                    var html = '';
                    var fileNameList = record.get('file_name').split(',');
                    var attachmentIdList = record.get('attachment_id_list').split(',');
                    for(var  i = 0; i < fileNameList.length; i++){
                        if(html != ''){
                            html += ',';
                        }
                        if(atmTypeRef(fileNameList[i])){
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }else if(checkPdf(fileNameList[i])){
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        }else{
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }

        };

        function atmTypeRef(name){
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }
        function checkPdf(name){
            return /\.(pdf)$/i.test(name)
        }


