<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="project_credit_credit_notice_link2"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition.lview"/>

        <a:link id="prj316_project_modify_id2"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>

        <a:link id="project_supplement_link_id2"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T3/prj_project_modify_supplement.lview"/>

        <a:link id="project_supplement_detail_link_id2"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T3/prj_project_modify_supplement.lview"/>


        <script><![CDATA[


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            if(ds.id && '${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds' == ds.id){
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
        };


        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
           /* if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }*/
           /* if (name == 'prj_notice_id' && value ) {
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\')">授信审批通知书</a>';
            }*/
            if (name == 'prj_supple_number' && value ) {
                return '<a href="javascript:open_supple_detail_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_supple_id') + '\',\'' + record.get('supple_status')  + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_project_modify_win2(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';

            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            hls_doc_get_layout_code(param, 'prj316_project_modify_id2', ds_id, function_code);
        }

        function open_notice_detail_win2(ds_id, record_id ,project_id , prj_notice_id){
            debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '授信审批通知书';
            param['function_code'] = 'PRJ316T1';
            param['winid'] = 'project_credit_notice_id';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            param['screen_width'] = '600';
            param['side'] = 'right';
            hls_doc_get_layout_code(param, 'project_credit_credit_notice_link2', ds_id, 'PRJ316');

        }

        function open_supple_detail_win(ds_id, record_id ,project_id , prj_supple_id , supple_status){
            debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '补充尽调报告';
            param['function_code'] = 'PRJ316T3';
            param['winid'] = 'project_supplement_win_id';

            if(supple_status == 'APPROVING' || supple_status == 'APPROVED'){
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
            }

            hls_doc_get_layout_code(param, 'project_supplement_link_id2', ds_id, 'PRJ316');

        }

        //补充尽调
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            /*var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();
            if (records.length != 1) {
                $L.showInfoMessage("提示", "请选择一个项目进行补充尽调!");
                return;
            }
            var record = records[0];
            var project_id = record.get('project_id');
            var param = record.data;*/
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');

            debugger;
            var param = {};
            param['project_id'] = '${/parameter/@project_id}';
            param['url_title'] = '补充尽调报告';
            param['function_code'] = 'PRJ316T3';
            param['tenant_sec_id'] = '${/parameter/@tenant_sec_id}';
            param['tenant_sec_count'] = '${/parameter/@tenant_sec_count}';
            param['guarantor_id'] = '${/parameter/@guarantor_id}';
            param['warrantor_count'] = '${/parameter/@warrantor_count}';
            param['guarantor_np_id'] = '${/parameter/@guarantor_np_id}';
            param['warrantor_count_np'] = '${/parameter/@warrantor_count_np}';
            param['marketing_report_id'] = '${/parameter/@marketing_report_id}';
            //param['create_flag'] = 'Y';
            param['supple_flag'] = 'Y';
            // param['function_code'] = 'PRJ316T2';
            param['winid'] = 'project_supplement_detail_info_winid';
            param['ds'] = ds_id;

            hls_doc_get_layout_code(param, 'project_supplement_detail_link_id2', null, 'PRJ316');
            // hls_doc_get_layout_code(param, 'project_query_supplement_link_id', ds_id, 'PRJ316');


        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
