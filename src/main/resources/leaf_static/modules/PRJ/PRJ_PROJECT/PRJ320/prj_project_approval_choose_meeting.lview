<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="pageLink_maintain_meeting" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ320/prj_project_approval_maintain_meeting.lview"/>
        <script><![CDATA[

        Leaf.onReady(function(){debugger;
            var ds_id = $('para_meetingDs');
            ds_id.getCurrentRecord().set('meeting_date',new Date());
        });

        function query_meeting() {
            $('meetingDs').query();
        }

        function save_meeting() {
            $('meetingDs').submit();
        }

        function add_meeting() {

            var win = new Leaf.Window({
                id: 'prj_project_approval_maintain_meeting',
                params: {
                    maintain_type : 'ADD'
                },
                url: $('pageLink_maintain_meeting').getUrl(),
                title: '添加上会',
                width: 280,
                height: 220
            });

            win.on('close',function (){
                query_meeting();
            });

            // $('meetingDs').create();
        }

        function onDbclick_meetingDs_grid(grid, record, row, name) {debugger;
            $('${/parameter/@lovid}').commit(record);
        }

        function grid_edit_func(record, name) {
            if (record.isNew) {
                if (name == 'meeting_name') {
                    return 'meetingDs_grid_tf';
                }
                if (name == 'meeting_location') {
                    return 'meetingDs_grid_tf';
                }
                if (name == 'meeting_date') {
                    return 'meetingDs_grid_dp';
                }
            }
            return '';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="para_meetingDs" autoCreate="true">
            </a:dataSet>
            <a:dataSet id="meetingDs" queryDataSet="para_meetingDs" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/project/meeting/info/query"
                       submitUrl="${/request/@context_path}/prj/project/meeting/submit">
                <a:fields>
                    <a:field name="meeting_date" datatype="date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="add_meeting" text="添加会议"/>
<!--                <a:gridButton click="save_meeting" text="保存"/>-->
                <a:gridButton click="query_meeting" text="查询"/>
            </a:screenTopToolbar>
            <a:form column="2" title="HLS.QUERY_TITLE" width="580">
                <a:textField name="meeting_name" bindTarget="para_meetingDs" prompt="上会名称"/>
                <a:datePicker name="meeting_date" bindTarget="para_meetingDs" prompt="上会日期"/>
            </a:form>
            <a:grid id="prj320_meeting_choose_grid" bindTarget="meetingDs" width="580" height="350" navBar="true">
                <a:columns>
                    <a:column name="meeting_name" prompt="上会名称" width="200" editorFunction="grid_edit_func"/>
                    <a:column name="meeting_location" prompt="上会地点" width="200" editorFunction="grid_edit_func"/>
                    <a:column name="meeting_date" prompt="上会日期" editorFunction="grid_edit_func" renderer="Leaf.formatDate"/>
                </a:columns>
                <a:editors>
                    <a:datePicker id="meetingDs_grid_dp"/>
                    <a:textField id="meetingDs_grid_tf"/>
                    <a:lov id="meetingDs_grid_lov"/>
                    <a:comboBox id="meetingDs_grid_comb"/>
                </a:editors>
                <a:events>
                    <a:event name="dblclick" handler="onDbclick_meetingDs_grid"/>
                </a:events>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>