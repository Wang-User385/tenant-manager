<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="PRJ316WFL_QUOTATION_SELECT"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316S2/prj_project_quotation_select.lview"/>
        <a:link id="prj316wfl_project_query_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="prj_chance_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_chance_modify_detail.lview"/>
        <a:link id="PRJ320_QUOTATION_SELECT"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316S2/prj_project_quotation_select.lview"/>
        <a:link id="${/parameter/@layout_code}_calc_price_quotation_common_link_id" url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900/quotation_calc_common.lview"/>
        <a:link id="prj320_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="prj320_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <script><![CDATA[

        var bp_hide_flag = 'N';
        var file_hide_flag = 'N';
        var comments_hide_flag = 'N';
        var comments_readOnly_flag = 'N';

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            if (ds.id == '${/parameter/@layout_code}_F_BASIC_INFO_prj_project_ds') {
                qpara['project_id'] = '${/parameter/@project_id}';

            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    //var project_id = '${/parameter/@project_id}';
                    qpara['source_document_id'] = project_id;
                    qpara['source_document_category'] = 'PRJ_PROJECT';
                    qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_G_VERIFICATION_WORK_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_VERIFICATION_WORK';
                    break;
                case '${/parameter/@layout_code}_G_DO_THE_WORK_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_DO_THE_WORK';
                    break;
                case '${/parameter/@layout_code}_G_INFORMATION_SITE_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_INFORMATION_SITE';
                    break;
                case '${/parameter/@layout_code}_G_FUNDED_PROJECT_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_FUNDED_PROJECT';
                    break;
                case '${/parameter/@layout_code}_G_VERIFY_INFORMATION_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_VERIFY_INFORMATION';
                    break;
                case '${/parameter/@layout_code}_G_REVIEW_MATERIAL_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_REVIEW_MATERIAL';
                    break;
                case '${/parameter/@layout_code}_G_BASIC_MATERIALS_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_BASIC_MATERIALS';
                    break;
                case '${/parameter/@layout_code}_G_PROJECT_BP_prj_project_bp_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    break;
                case '${/parameter/@layout_code}_G_FILE_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_REVIEW_REPORT';
                    break;
                case '${/parameter/@layout_code}_G_APPROVAL_prj_project_meeting_approver_ds':
                    // var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    // var prj_record = $(prj_ds_id).getCurrentRecord();
                    var approval_id = '${/parameter/@approval_id}';
                    qpara['approval_id'] = approval_id;
                    break;
                case '${/parameter/@layout_code}_G_CREDIT_INFO_prj_quotation_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['source_document_id'] = project_id;
                    qpara['source_document_category'] = 'PRJ_PROJECT';
                    qpara['data_class'] = '';
                    break;
                case '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds':
                    var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(prj_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_SEND_REVIEW_REPORT';
                    break;
            }
        };

        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            //debugger;
            var ds_id = '${/parameter/@layout_code}_F_OPINION_SUM_prj_project_ds';
            if (ds_id == ds.id && ds_id) {
                if(name == 'vote_status'){
                    if(value == 'FURTHER' || value == 'VETO'){
                        record.getField('five_categories').setReadOnly(true);
                        record.getField('five_categories').setRequired(false);
                        record.getField('five_categories_n').setReadOnly(true);
                        record.getField('five_categories_n').setRequired(false);
                    }else{
                        record.getField('five_categories').setReadOnly(false);
                        record.getField('five_categories').setRequired(true);
                        record.getField('five_categories_n').setReadOnly(false);
                        record.getField('five_categories_n').setRequired(true);
                    }
                }
                if(name == 'vote_status' || name == 'vote_comment' || name == 'five_categories'){
                    if (old_value != value) {
                        Leaf.request({
                            url: '${/request/@context_path}/prj/project/update/sum/comment',
                            para: {
                                projectId: '${/parameter/@project_id}',
                                value: value,
                                type: name
                            },
                            success: function (res) {
                                $(ds_id).query();
                            },
                            failure: function () {
                            },
                            error: function () {
                            },
                            scope: this
                        });
                    }
                }
            }
            var approver_ds_id = '${/parameter/@layout_code}_G_APPROVAL_prj_project_meeting_approver_ds';
            if (approver_ds_id == ds.id && approver_ds_id) {
                if (old_value != value) {
                    Leaf.request({
                        url: '${/request/@context_path}/prj/project/meeting/approver/submit/wfl',
                        para: record.data,
                        success: function (res) {
                        },
                        failure: function () {
                        },
                        error: function () {
                        },
                        scope: this
                    });
                }
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {

            var ds_id = '${/parameter/@layout_code}_F_OPINION_SUM_prj_project_ds';
            if (ds_id == ds.id && ds_id && '${/parameter/@function_usage}' == 'MODIFY') {
                if(record.get('vote_status') == 'FURTHER' || record.get('vote_status') == 'VETO'){
                    record.getField('five_categories').setReadOnly(true);
                    record.getField('five_categories').setRequired(false);
                    // record.set('five_categories','');
                    record.getField('five_categories_n').setReadOnly(true);
                    record.getField('five_categories_n').setRequired(false);
                    // record.set('five_categories_n','');

                }else{
                    record.getField('five_categories').setReadOnly(false);
                    record.getField('five_categories').setRequired(true);
                    record.getField('five_categories_n').setReadOnly(false);
                    record.getField('five_categories_n').setRequired(true);
                }
            }
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            //debugger;
            if (ds.id === '${/parameter/@layout_code}_G_PRJ_CONDITION_prj_project_credit_condition_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('row_seq', length);
            }
            if (ds.id === '${/parameter/@layout_code}_G_PRJ_REQUIRE_prj_project_survive_require_ds') {
                var work_record = $(ds.id).getAll();
                var length = work_record.length;
                record.set('row_seq', length);
            }
        };

        //grid保存
        window['${/parameter/@layout_code}_G_CREDIT_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //debugger;
            var pq_ds_id = '${/parameter/@layout_code}_G_CREDIT_INFO_prj_quotation_ds';
            var records = $(pq_ds_id).getAll();
            for(var i=0;i<records.length;i++){
                if(records[i].dirty === true){
                    var param = $(pq_ds_id).getJsonData()[i];
                    quotation_save(param);
                }
            }
        };

        function atmTypeRef(name){
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }
        function checkPdf(name){
            return /\.(pdf)$/i.test(name)
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
            var project_attachment_id = record.get('project_attachment_id');
            var approver_record_id = record.get('approver_record_id');
            if (name == 'quotation_cal') {
                    link_function = 'quotation_ready_detail';
                    return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 30px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '报价详情' + '</a>';
            }
            if (name == 'attachment_data_t' && project_attachment_id) {
                link_function = 'prj_attachement_upload';
                var file_number = record.get('file_number');
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传(' + file_number + ')' + '</a>';
            }
            if (name == 'upload') {
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">' + '上传/下载' + '</a>';
            }
            if (name == 'approval_detail') {
                link_function = 'approval_upload_file';
                var file_number = record.get('file_number');
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('approver_record_id') + '\');">' + '上传/下载(' + file_number + ')' + '</a>';
            }
            if (name == 'file_name'){
                if(record.get('file_name') != null && record.get('attachment_id_list') != null) {
                    var html = '';
                    var fileNameList = record.get('file_name').split(',');
                    var attachmentIdList = record.get('attachment_id_list').split(',');
                    for(var  i = 0; i < fileNameList.length; i++){
                        if(html != ''){
                            html += ',';
                        }
                        if(atmTypeRef(fileNameList[i])){
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }else if(checkPdf(fileNameList[i])){
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        }else{
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
        };

        window['quotation_ready_detail'] = function(record_id, ds_id){
            var quotation_record = $(ds_id).findById(record_id);
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var project_id = prj_record.get('project_id');
            var project_name = prj_record.get('project_name');
            if (project_id == 0 || quotation_id == undefined) {
                Leaf.showMessage('提示', '报价未计算成功，无法查看');
            } else {
                //debugger;
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                param['priceList'] = price_list;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                //console.log(param);
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_calc_price_quotation_common_link_id', ds_id, '${/parameter/@layout_code}');
            }
        };

        window['quotation_cal_detail'] = function (record_id, ds_id) {
            var quotation_record = $(ds_id).findById(record_id);
            var quotation_id = quotation_record.get('quotation_id');
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var project_id = prj_record.get('project_id');
            var project_name = prj_record.get('project_name');
            if (project_id == 0 || quotation_id == undefined) {
                Leaf.showMessage('提示', '请先保存再引用报价');
            } else {
                var param = quotation_record.data;
                param['url_title'] = '报价方案选择';
                param['function_code'] = 'PRJ316S2';
                param['function_usage'] = 'CREATE';
                //param['parent_ds_id'] = ds_id;
                //param['screen_width'] = '900';
                //param['side']='right';
                param['project_id'] = project_id;
                param['project_name'] = project_name;
                param['parent_ds_id'] = prj_ds_id;
                var button_hide_flag = 'N';
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    button_hide_flag = 'Y';
                }
                param['button_hide_flag'] = button_hide_flag;
                var link_id = 'PRJ320_QUOTATION_SELECT';
                hls_doc_get_layout_code(param, link_id, null, '${/parameter/@layout_code}');
            }

        };

        window['quotation_detail'] = function (record_id, ds_id) {
            var quotation_record = $(ds_id).findById(record_id);
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var project_id = prj_record.get('project_id');
            var project_name = prj_record.get('project_name');
            if (project_id == 0 || quotation_id == undefined) {
                Leaf.showMessage('提示', '报价未计算成功，无法查看');
            } else {
                //debugger;
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                param['priceList'] = price_list;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                if(quotation_record.get('source_quotation_id') == null){
                    param['new_flag'] = 'Y';
                }
                console.log(param);
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_calc_price_quotation_common_link_id', ds_id, '${/parameter/@layout_code}');
            }

        };

        window['upload_file'] = function (record_id, project_attachment_id) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == 'undefined') {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var url;
            if ('${/parameter/@file_upload_flag}' == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'PRJ_PROJECT_ATTACHMENT',
                    winid: 'prj316wfl_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                //var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_ATTACHMENTS_prj_project_attachment_ds";
                var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_prj_project_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        window['approval_upload_file'] = function (record_id, approver_record_id) {
            var url;
            if ('${/parameter/@file_upload_flag}' == 'Y') {
                url = '${/request/@context_path}/uploadFile.lview';
            } else {
                url = '${/request/@context_path}/downloadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': approver_record_id,
                    'table_name': 'PRJ_PROJECT_MEETING_APPROVER',
                    winid: 'prj320_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_APPROVAL_prj_project_meeting_approver_ds";
                $(document_list_ds_id).query();
            });
        };

        window['prj_attachement_upload'] = function (record_id, ds_id) {
            //debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(prj_ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            var prj_attach_record = $(ds_id).findById(record_id);
            var project_attachment_id = prj_attach_record.get('project_attachment_id');
            if (project_attachment_id == undefined) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url = '${/request/@context_path}/downloadFile.lview';
            var table_name;
            var document_list_ds_id;
            if (ds_id == '${/parameter/@layout_code}_G_VERIFICATION_WORK_prj_project_attachment_ds') {
                //console.log('一、尽调工作开展概况');
                //table_name = 'PRJ_VERIFICATION_WORK';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_DO_THE_WORK_prj_project_attachment_ds') {
                //console.log('二、尽调真实性工作开展情况');
                //table_name = 'PRJ_DO_THE_WORK';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_INFORMATION_SITE_prj_project_attachment_ds') {
                //console.log('三、租赁物现场核实资料');
                //table_name = 'PRJ_INFORMATION_SITE';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_FUNDED_PROJECT_prj_project_attachment_ds') {
                //console.log('四、用资项目现场核实资料');
                //table_name = 'PRJ_FUNDED_PROJECT';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_VERIFY_INFORMATION_prj_project_attachment_ds') {
                //console.log('五、抵质押物现场核实资料');
                //table_name = 'PRJ_VERIFY_INFORMATION';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_REVIEW_MATERIAL_prj_project_attachment_ds') {
                //console.log('送审流程材料');
                //table_name = 'PRJ_REVIEW_MATERIAL';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_BASIC_MATERIALS_prj_project_attachment_ds') {
                //console.log('基础档案资料');
                //table_name = 'PRJ_BASIC_MATERIALS';
                document_list_ds_id = ds_id;
            }
            if (ds_id == '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds') {
                document_list_ds_id = ds_id;
            }

            table_name = 'PRJ_PROJECT_ATTACHMENT';

            var win = new Leaf.Window({
                id: 'prj316_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table_name,
                    winid: 'prj316_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                //var document_list_ds_id = "${/parameter/@layout_code}_G_FILE_ATTACHMENTS_prj_project_attachment_ds";
                //var document_list_ds_id = "${/parameter/@layout_code}_G_BASIC_DATA_prj_project_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        function quotation_calc_func(quotation_id){
            // Leaf.Masker.mask(Ext.getBody(), '正在计算...');
            Leaf.request({
                url: $('prj320_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                type: "GET",
                success: function (res) {
                    $L.showInfoMessage("提示","计算成功!",function(){
                        $('${/parameter/@layout_code}_G_CREDIT_INFO_prj_quotation_ds').query();
                    });
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }

        function quotation_save(param){
            Leaf.Masker.mask(Ext.getBody(), '正在操作...');
            Leaf.request({
                url: $('prj320_quotation_info_save_link_id').getUrl(),
                type: "POST",
                para: param,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                    // console.log(param.quotation_id);
                    quotation_calc_func(param.quotation_id);
                    // Leaf.Masker.unmask(Ext.getBody());
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });

        }

        function hls_project_detail() {
            //debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();

            //报价方案
            var pq_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            //一、尽调工作开展概况
            var verification_work_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_VERIFICATION_WORK');
            //二、尽调真实性工作开展情况
            var do_the_work_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_DO_THE_WORK');
            //三、租赁物现场核实资料
            var information_site_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_INFORMATION_SITE');
            //四、用资项目现场核实资料
            var funded_project_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_FUNDED_PROJECT');
            //五、抵质押物现场核实资料
            var verify_information_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_VERIFY_INFORMATION');
            //送审流程材料
            var review_material_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_REVIEW_MATERIAL');
            //基础档案资料
            var basic_materials_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_BASIC_MATERIALS');
            //送审报告
            var send_review_report_attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_SEND_REVIEW_REPORT');
            //风险管理部意见
            var review_comments_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_REVIEW_COMMENTS');
            var project_bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'G_PROJECT_BP');
            var file_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_FILE');
            //评委信息
            var approval_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_meeting_approver', 'G_APPROVAL');
            //授信方案
            var credit_quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'G_CREDIT_INFO');
            //汇总意见
            var opinion_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_OPINION_SUM');
            //前提条件
            var ocondition_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition', 'G_PRJ_CONDITION');
            //存续期
            var survive_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_survive_require', 'G_PRJ_REQUIRE');


            var param = prj_record.data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = prj_record.get('project_status');
            if (project_status == 'APPROVING' || project_status == 'APPROVED' || project_status == 'PENDING') {
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
            }
            if ('${/parameter/@return_flag}' == 'Y') {
                param['maintain_type'] = 'UPDATE';
                param['function_usage'] = 'MODIFY';
                param['return_flag'] = 'Y';
            }
            //去除ds,防止栈溢出
            param[pq_ds_id.replace('_ds', '')] = undefined;
            param[verification_work_attach_ds_id.replace('_ds', '')] = undefined;
            param[do_the_work_attach_ds_id.replace('_ds', '')] = undefined;
            param[information_site_attach_ds_id.replace('_ds', '')] = undefined;
            param[funded_project_attach_ds_id.replace('_ds', '')] = undefined;
            param[verify_information_attach_ds_id.replace('_ds', '')] = undefined;
            param[review_material_attach_ds_id.replace('_ds', '')] = undefined;
            param[basic_materials_attach_ds_id.replace('_ds', '')] = undefined;
            param[review_comments_ds_id.replace('_ds', '')] = undefined;
            param[project_bp_ds_id.replace('_ds', '')] = undefined;
            param[file_ds_id.replace('_ds', '')] = undefined;
            param[approval_ds_id.replace('_ds', '')] = undefined;
            param[opinion_ds_id.replace('_ds', '')] = undefined;
            param[credit_quotation_ds_id.replace('_ds', '')] = undefined;
            param[ocondition_ds_id.replace('_ds', '')] = undefined;
            param[survive_ds_id.replace('_ds', '')] = undefined;
            param[send_review_report_attach_ds_id.replace('_ds', '')] = undefined;
            console.log(param);

            hls_doc_get_layout_code(param, 'prj316wfl_project_query_id', prj_ds_id, function_code);
        }

        function hls_chance_detail() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            if (prj_record.get('chance_id') == null || prj_record.get('chance_id') == '') {
                Leaf.showMessage('提示', '该尽调报告免于立项！');
            } else {
                var param = {};
                param['chance_id'] = prj_record.get('chance_id');
                //var status = param.credit_line_status;
                param['url_title'] = '立项查询';
                param['function_code'] = 'PRJ001F1';
                param['function_usage'] = 'QUERY';
                param['winid'] = 'prj_chance_detail_winid';
                param['ds_id'] = prj_ds_id;
                var link_id = 'prj_chance_detail_id';
                hls_doc_get_layout_code(param, link_id, prj_ds_id, 'PRJ001');
            }
            //Leaf.showMessage('提示','开发中...');
        }

        //业审委综合意见
        function meeting_comment_collect() {

            var comment_ds_id = '${/parameter/@layout_code}_F_OPINION_SUM_prj_project_ds';
            var down_url;
            var templateCode = 'MEETING_COLLECT_OPINION';
            if ($(comment_ds_id).validate()) {
                //先保存
                // window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var record = $(comment_ds_id).getCurrentRecord();
                if (record.get('vote_status') == 'VETO' || record.get('vote_status') == 'FURTHER') {
                    templateCode = 'MEETING_COLLECT_OPINION_ANTI';
                }
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/ct/project/attachment/content/create?projectId=" + '${/parameter/@project_id}'
                        + '&templateCode=' + templateCode,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        // $L.Masker.unmask(document.body);
                        var attachment_id = res.result.record[0].attachment_id;
                        // alert(attachment_id);
                        // Leaf.go(down_url + '?attachment_id=' + attachment_id);
                        down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                        location.href = down_url;
                        Leaf.SideBar.show({
                            msg: '生成成功',
                            duration: 2000
                        });
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        // Leaf.showMessage("提示", "生成失败!", null);
                    },
                    scope: this
                });
            }
        }

        //风险管理部部门意见
        function meeting_risk_comment_collect() {
            //先保存
            var down_url;
            // window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/ct/project/attachment/content/create?projectId=" + '${/parameter/@project_id}'
                        + '&templateCode=' + 'MEETING_RISK_OPINION',
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        // $L.Masker.unmask(document.body);
                        var attachment_id = res.result.record[0].attachment_id;
                        // alert(attachment_id);
                        // Leaf.go(down_url + '?attachment_id=' + attachment_id);
                        down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                        location.href = down_url;
                        Leaf.SideBar.show({
                            msg: '生成成功',
                            duration: 2000
                        });
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        // Leaf.showMessage("提示", "生成失败!", null);
                    },
                    scope: this
                });
            // });
        }

        Leaf.onReady(function () {
            //
            var bp_hide_flag = '${/parameter/@bp_hide_flag}';
            var file_hide_flag = '${/parameter/@file_hide_flag}';
            var comments_hide_flag = '${/parameter/@comments_hide_flag}';
            var comments_readOnly_flag = '${/parameter/@comments_readOnly_flag}';
            /*if(bp_hide_flag == 'Y'){
                jQuery('#${/parameter/@layout_code}_G_PROJECT_BP_prj_project_bp_layout_grid_id_wrap').hide();
            }
            if(file_hide_flag == 'Y'){
                jQuery('#${/parameter/@layout_code}_G_FILE_prj_project_attachment_layout_grid_id_wrap').hide();
            }
            if(comments_hide_flag == 'Y'){
                jQuery('#${/parameter/@layout_code}_F_REVIEW_COMMENTS_component_id').hide();
            }*/
        });


        ]]></script>

        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="hls_project_detail" text="尽调报告详情"/>
                <a:gridButton click="hls_chance_detail" text="立项报告详情"/>
                <a:gridButton click="meeting_risk_comment_collect" text="风险管理部部门意见"/>
                <a:gridButton click="meeting_comment_collect" text="业审委综合意见"/>
