<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function prj320_chooseApproverDs_query(ds, para) {
            para['approval_id'] = '${/parameter/@approval_id}';
        }

        function save_chooseApproverDs() {
            $('saveBtn_id').disable();
            var ds = $('chooseApproverDs');
            ds.setSubmitParameter('approval_id', '${/parameter/@approval_id}');
            ds.submitSelected();
        }

        function close_chooseApproverPage() {
            $('prj_project_approval_choose_approver').close();
        }

        function submitsuccess() {
            close_chooseApproverPage();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="chooseApproverDs" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/prj/project/meeting/judge/info/query"
                       submitUrl="${/request/@context_path}/prj/project/meeting/approver/insert">
                <a:events>
                    <a:event name="submitsuccess" handler="submitsuccess"/>
                    <a:event name="query" handler="prj320_chooseApproverDs_query"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton id="closeBtn_id" click="close_chooseApproverPage" text="HLS.CLOSE"/>
                <a:gridButton id="saveBtn_id" click="save_chooseApproverDs" text="HLS.SAVE"/>
            </a:screenTopToolbar>
            <a:grid id="chooseApproverDs_grid" bindTarget="chooseApproverDs" marginHeight="100" navBar="true" marginWidth="200">
                <a:columns>
                    <a:column name="name" prompt="员工名称" width="300" align="center" />
<!--                    <a:column name="unit_name" prompt="部门名称" width="200" align="center"/>-->
                    <a:column name="position_name" prompt="岗位名称" width="300" align="center"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>