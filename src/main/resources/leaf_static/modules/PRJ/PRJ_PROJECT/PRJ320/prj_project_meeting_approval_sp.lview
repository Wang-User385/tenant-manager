<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html, body {
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_meeting_wfl_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ320/prj_project_meeting_approval_sp_wfl.lview"/>
        <script><![CDATA[

debugger;
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }


        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var hlsCusPrjProject = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "hlsCusPrjProject";
        });
        hlsCusPrjProject = hlsCusPrjProject[0].value;

        var prjApproval = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "approvalId";
        });
        var approvalId = prjApproval[0].value;


        var pageChooser = new PageChooser({
            url: $('prj_project_meeting_wfl_link_id').getUrl(),
            function_code: 'PRJ320WFL',
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                function_code: 'PRJ320WFL',
                approval_id: approvalId
                // maintain_type: 'READONLY',
                // function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>