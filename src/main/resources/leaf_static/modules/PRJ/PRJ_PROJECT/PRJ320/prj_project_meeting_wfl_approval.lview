    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html, body {
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_meeting_wfl_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ320/prj_project_meeting_wfl.lview"/>
        <script><![CDATA[
        // debugger;


        //console.log(parent.currentTaskInfo.process_instance);
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        debugger;
        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var hlsCusPrjProject = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "hlsCusPrjProject";
        });
        hlsCusPrjProject = hlsCusPrjProject[0].value;

        var prjApproval = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "approvalId";
        });
        var approvalId = prjApproval[0].value;

        var functionUsage = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "functionUsage";
        });
        functionUsage = functionUsage[0].value;

        var maintainType = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "maintainType";
        });
        maintainType = maintainType[0].value;

        var task_id = 'sid-tUOZ5cVL-2S2X-4KQf-8FAA-QugRFk0CFSmM';
        var change_task_id = 'sid-GsqiMnMs-2dkX-4mxm-8RIJ-nNDAi7xmQQdb';
        var current_activity_id = parent.currentTaskInfo.task_definition_key;
        if(current_activity_id == task_id || current_activity_id == change_task_id ){
            functionUsage = 'MODIFY';
            maintainType = 'MODIFY';
        }

        var pageChooser = new PageChooser({
            url: $('prj_project_meeting_wfl_link_id').getUrl(),
            function_code: 'PRJ316WFL_N',
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                approval_id: approvalId,
                maintain_type: maintainType,
                function_code: 'PRJ316WFL_N',
                function_usage: functionUsage
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>