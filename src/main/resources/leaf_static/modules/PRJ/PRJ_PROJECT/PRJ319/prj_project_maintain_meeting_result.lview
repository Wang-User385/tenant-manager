<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[


        function save_approvalMaintainDs() {
            var ds = $('approvalMaintainDs');
            if(!ds.validate() ){
                return;
            }
            ds.submit();
        }

        function add_approval() {
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: '${/request/@context_path}/prj/project/meeting/approver/add',
                para: {
                    project_id : '${/parameter/@project_id}'
                },
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    $('approval_info_ds').query();
                },
                error: function (res) {
                     Leaf.Masker.unmask(Ext.getBody());
                },
                faliure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        function validate_meeting_time(record, name, value) {
            var reg = /^\d\d:\d\d$/;
            if (reg.test(value)) {
                return true;
            }
            return '上会时间格式应为【hh:mm】,举例【09:05】';
        }

        function prj_meeting_approval_query(ds, para) {
            $('approval_info_ds').setQueryUrl('${/request/@context_path}/prj/project/meeting/approver/reply/query');
            $('approval_info_ds').setQueryParameter('project_id', '${/parameter/@project_id}');
            $('approval_info_ds').setQueryParameter('data_class', 'CHANGE');
        }
        function prj_approval_condition1_query(ds, para) {
            $('approval_info_ds1').setQueryUrl('${/request/@context_path}/prj/project/approval/condition/query/all1');
            $('approval_info_ds1').setQueryParameter('project_id', '${/parameter/@project_id}');
            $('approval_info_ds1').setQueryParameter('approval_id', '${/parameter/@approval_id}');
            $('approval_info_ds1').setQueryParameter('approval_type', 'OTHER');
            $('approval_info_ds1').setQueryParameter('approval_data_class', 'CHANGE');
        }
        function prj_approval_condition2_query(ds, para) {
            $('approval_info_ds2').setQueryUrl('${/request/@context_path}/prj/project/approval/condition/query/all2');
            $('approval_info_ds2').setQueryParameter('project_id', '${/parameter/@project_id}');
            $('approval_info_ds2').setQueryParameter('approval_id', '${/parameter/@approval_id}');
            $('approval_info_ds2').setQueryParameter('approval_type', 'BEFORE');
            $('approval_info_ds2').setQueryParameter('approval_data_class', 'CHANGE');
        }
        function prj_approval_condition3_query(ds, para) {
            $('approval_info_ds3').setQueryUrl('${/request/@context_path}/prj/project/approval/condition/query/all3');
            $('approval_info_ds3').setQueryParameter('project_id', '${/parameter/@project_id}');
            $('approval_info_ds3').setQueryParameter('approval_id', '${/parameter/@approval_id}');
            $('approval_info_ds3').setQueryParameter('approval_type', 'AFTER');
            $('approval_info_ds3').setQueryParameter('approval_data_class', 'CHANGE');
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="approval_type_ds" lookupCode="APPROVAL_TYPE"/>
            <a:dataSet id="prj_meeting_query_ds">
                <a:datas>
                    <a:record/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="meetingMaintainDs" submitUrl="${/request/@context_path}/prj/project/meeting/submit" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/project/meeting/info/reply/query?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;dataClass=CHANGE">
                <a:fields>
                    <a:field name="meeting_name" readOnly="true"/>
                    <a:field name="meeting_location" readOnly="true"/>
                    <a:field name="meeting_date"   readOnly="true"/>
<!--                    <a:field name="meeting_time" readOnly="true" validator="validate_meeting_time"/>-->
                    <a:field name="meeting_status" defaultValue="NEW"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="approval_info_ds" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/prj/project/meeting/approver/reply/query?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;dataClass=CHANGE"
                       deleteUrl="${/request/@context_path}/prj/project/meeting/approver/remove">
                <a:fields>
                    <a:field name="name"/>
                    <a:field name="unit_name"/>
                    <a:field name="position_name"/>
                    <a:field name="company_id_n"/>
                </a:fields>
                <a:events>
<!--                    <a:event name="load" handler="prj_meeting_approval_load"/>-->
                    <a:event name="query" handler="prj_meeting_approval_query"/>
<!--                    <a:event name="submitsuccess" handler="prj_meeting_approval_submitsuccess"/>-->
                </a:events>
            </a:dataSet>
            <a:dataSet id="approvalMaintainDs" submitUrl="${/request/@context_path}/prj/project/approval/submit" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/project/approval/query/reply/all?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;approvalId=${/parameter/@approval_id}&amp;dataClass=CHANGE">
                <a:fields>
                    <a:field name="approval_number" required="true"/>
                    <a:field name="approval_date" required="true" />
                    <a:field name="approval_term"   required="true" />
                    <a:field name="approval_note"  />
                    <a:field name="business_type_n" readOnly="true"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                    <a:field name="business_type_n" readOnly="true"/>
                    <a:field name="finance_amount" readOnly="true"/>
                    <a:field name="lease_term" readOnly="true"/>
                    <a:field name="int_rate" readOnly="true"/>
                    <a:field name="lessor_name" readOnly="true"/>
                    <a:field name="tenant_id_n" readOnly="true"/>
                    <a:field name="charge_method" required="true"/>
                    <a:field name="guar_method" required="true"/>
                    <a:field name="deposit_method" required="true"/>
                    <a:field name="founding_method" required="true"/>
                    <a:field name="payment_method" required="true"/>
                    <a:field name="repayment_method" required="true"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="approval_info_ds1" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true" bindTarget="approvalMaintainDs" fetchAll="true"
                       queryUrl="${/request/@context_path}/prj/project/approval/condition/query/all1?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;approvalId=${/parameter/@approval_id}&amp;approvalType=OTHER"
                       submitUrl="${/request/@context_path}/prj/project/approval/condition/submit" deleteUrl="${/request/@context_path}/prj/project/approval/condition/remove">
                <a:fields>
                    <a:field name="approval_seq" required="true"/>
                    <a:field name="condition_type" required="true"/>
                    <a:field name="condition_type_n" options="approval_type_ds" displayField="code_value_name"
                             valueField="code_value" returnField="condition_type"  />
                    <a:field name="condition_content" required="true"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                    <a:field name="approval_id" defaultValue="${/parameter/@approval_id}"/>
                    <a:field name="approval_type" defaultValue="OTHER"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj_approval_condition1_query"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="approval_info_ds2" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true" bindTarget="approvalMaintainDs" fetchAll="true"
                       queryUrl="${/request/@context_path}/prj/project/approval/condition/query/all2?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;approvalId=${/parameter/@approval_id}&amp;approvalType=BEFORE"
                       submitUrl="${/request/@context_path}/prj/project/approval/condition/submit" deleteUrl="${/request/@context_path}/prj/project/approval/condition/remove">
                <a:fields>
                    <a:field name="approval_seq"  required="true"/>
                    <a:field name="condition_type" required="true"/>
                    <a:field name="condition_type_n" options="approval_type_ds" displayField="code_value_name"
                             valueField="code_value" returnField="condition_type"  />
                    <a:field name="condition_content" required="true"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                    <a:field name="approval_id" defaultValue="${/parameter/@approval_id}"/>
                    <a:field name="approval_type" defaultValue="BEFORE"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj_approval_condition2_query"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="approval_info_ds3" autoPageSize="true" autoCreate="true" autoQuery="true" selectable="true" bindTarget="approvalMaintainDs" fetchAll="true"
                       queryUrl="${/request/@context_path}/prj/project/approval/condition/query/all3?wflRuleControlFlag=Y&amp;projectId=${/parameter/@project_id}&amp;approvalId=${/parameter/@approval_id}&amp;approvalType=AFTER"
                       submitUrl="${/request/@context_path}/prj/project/approval/condition/submit" deleteUrl="${/request/@context_path}/prj/project/approval/condition/remove">
                <a:fields>
                    <a:field name="approval_seq" required="true"/>
                    <a:field name="condition_type" required="true"/>
                    <a:field name="condition_type_n" options="approval_type_ds" displayField="code_value_name"
                             valueField="code_value" returnField="condition_type"  />
                    <a:field name="condition_content" required="true"/>
                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>
                    <a:field name="approval_id" defaultValue="${/parameter/@approval_id}"/>
                    <a:field name="approval_type" defaultValue="AFTER"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="prj_approval_condition3_query"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:tabPanel marginHeight="250" marginWidth="250" >
                <a:tabs>
                    <a:tab prompt="会议信息" width="200">
                        <a:form column="3" >
                            <a:textField name="meeting_name" bindTarget="meetingMaintainDs" width="365" prompt="上会名称"/>
                            <a:datePicker name="meeting_date" bindTarget="meetingMaintainDs" renderer="Leaf.formatDate"  width="120"  prompt="上会日期"/>
                            <a:textField name="meeting_location" bindTarget="meetingMaintainDs" width="365"  prompt="上会地点"/>
<!--                            <a:textField name="meeting_time" bindTarget="meetingMaintainDs" width="120" prompt="上会时间"/>-->
                        </a:form>
                        <a:grid  id="meeting_grid" bindTarget="approval_info_ds"
                                 marginHeight="300" marginWidth="300" navBar="true" >
                            <a:columns>
                                <a:column width="130" name="name" prompt="评委名称"/>
                                <a:column width="130" name="unit_name" prompt="部门名称"/>
                                <a:column width="130" name="position_name" prompt="岗位名称"/>
                                <a:column width="200" name="company_id_n" prompt="公司名称"/>
                                <a:column width="200" name="vote_result" prompt="表决结果"/>
                                <a:column width="200" name="vote_comment" prompt="表决意见"/>
                            </a:columns>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="项目批复信息" width="200">
                        <a:screenTopToolbar>
                            <a:gridButton id="save_meeting_button_id" click="save_approvalMaintainDs" text="HLS.SAVE"/>
                        </a:screenTopToolbar>
                        <a:form column="1" labelWidth="100" title="项目批复" >
                            <a:box column="3" labelWidth="120">
                                <a:textField name="approval_number" bindTarget="approvalMaintainDs" width="200" prompt="批复编号"   />
                                <a:datePicker name="approval_date" bindTarget="approvalMaintainDs" renderer="Leaf.formatDate"  width="120"  prompt="批复生效时间" />
                                <a:textField name="approval_term" bindTarget="approvalMaintainDs" width="120"  prompt="批复有效期（月）" />
                            </a:box>
                            <a:box column="1" labelWidth="120">
                                <a:textArea name="approval_note" bindTarget="approvalMaintainDs"
                                            prompt="批复说明" width="860" height="100"/>
                            </a:box>
                        </a:form>
                        <a:form column="1" labelWidth="100" title="项目方案" >
                            <a:box column="4" labelWidth="120">
                                <a:textField name="business_type_n" bindTarget="approvalMaintainDs" width="120" prompt="项目类型" readOnly="true"/>
                                <a:textField name="finance_amount" bindTarget="approvalMaintainDs" renderer="Leaf.formatMoney"  width="120"  prompt="融资金额" readOnly="true"/>
                                <a:textField name="lease_term" bindTarget="approvalMaintainDs" width="120"  prompt="融资期限(月)" readOnly="true"/>
                                <a:textField name="int_rate" bindTarget="approvalMaintainDs" width="120"  prompt="融资利率" readOnly="true"/>
                            </a:box>
                            <a:box column="2" labelWidth="120">
                                <a:textField name="lessor_name" bindTarget="approvalMaintainDs" width="366" prompt="出租人" readOnly="true"/>
                                <a:textField name="tenant_id_n" bindTarget="approvalMaintainDs"  width="366"  prompt="客户名称" readOnly="true"/>
                            </a:box>
                            <a:box column="2" labelWidth="120">
                                <a:textField name="charge_method" bindTarget="approvalMaintainDs" width="366" prompt="手续费及收取方式"  />
                                <a:textField name="guar_method" bindTarget="approvalMaintainDs"  width="366"  prompt="担保方式"  />
                            </a:box>
                            <a:box column="2" labelWidth="120">
                                <a:textField name="deposit_method" bindTarget="approvalMaintainDs" width="366" prompt="保证金及收取方式"  />
                                <a:textField name="founding_method" bindTarget="approvalMaintainDs"  width="366"  prompt="资金投放方式" />
                            </a:box>
                            <a:box column="2" labelWidth="120">
                                <a:textField name="payment_method" bindTarget="approvalMaintainDs" width="366" prompt="支付方式" />
                                <a:textField name="repayment_method" bindTarget="approvalMaintainDs"  width="366"  prompt="还款方式" />
                            </a:box>
                        </a:form>
                        <a:form title="其他审批条件" >
                            <a:grid id="meeting_grid1" bindTarget="approval_info_ds1"
                                    marginHeight="500" marginWidth="600" navBar="true" >
                                <a:toolBar>
                                    <a:button type="add"/>
                                    <a:button type="save"/>
                                    <a:button type="delete"/>
                                </a:toolBar>
                                <a:columns>
                                    <a:column width="80" name="approval_seq" editor="text_edit1"  prompt="序号"/>
                                    <a:column width="130" name="condition_type_n" editor="meetingDs_grid_comb" prompt="条件类型"/>
                                    <a:column width="360" name="condition_content" editor="text_edit1"  prompt="条件内容"/>
                                </a:columns>
                                <a:editors>
                                    <a:textField id="text_edit1"/>
                                    <a:comboBox id="meetingDs_grid_comb"/>
                                </a:editors>
                            </a:grid>
                        </a:form>
                        <a:form title="放款前需要落实的限制性条件" >
                            <a:grid id="meeting_grid2" bindTarget="approval_info_ds2"
                                    marginHeight="500" marginWidth="600" navBar="true" >
                                <a:toolBar>
                                    <a:button type="add"/>
                                    <a:button type="save"/>
                                    <a:button type="delete"/>
                                </a:toolBar>
                                <a:columns>
                                    <a:column width="80" name="approval_seq" editor="text_edit2"  prompt="序号"/>
                                    <a:column width="130" name="condition_type_n" editor="meetingDs_grid_comb2" prompt="条件类型"/>
                                    <a:column width="360" name="condition_content" editor="text_edit2"  prompt="条件内容"/>
                                </a:columns>
                                <a:editors>
                                    <a:textField id="text_edit2"/>
                                    <a:comboBox id="meetingDs_grid_comb2"/>
                                </a:editors>
                            </a:grid>
                        </a:form>
                        <a:form title="放款后需要落实的条件" >
                            <a:grid id="meeting_grid3" bindTarget="approval_info_ds3"
                                    marginHeight="500" marginWidth="600" navBar="true" >
                                <a:toolBar>
                                    <a:button type="add"/>
                                    <a:button type="save"/>
                                    <a:button type="delete"/>
                                </a:toolBar>
                                <a:columns>
                                    <a:column width="80" name="approval_seq"  editor="text_edit3"  prompt="序号"/>
                                    <a:column width="130" name="condition_type_n" editor="meetingDs_grid_comb3" prompt="条件类型"/>
                                    <a:column width="360" name="condition_content" editor="text_edit3" prompt="条件内容"/>
                                </a:columns>
                                <a:editors>
                                    <a:textField id="text_edit3"/>
                                    <a:comboBox id="meetingDs_grid_comb3"/>
                                </a:editors>
                            </a:grid>
                        </a:form>
                </a:tab>
                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
    </a:view>
</a:screen>