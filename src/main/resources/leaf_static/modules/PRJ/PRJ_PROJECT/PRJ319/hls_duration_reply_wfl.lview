<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html, body {
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="duration_reply_wfl_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ319/hls_duration_reply_modify_wfl.lview"/>

        <script><![CDATA[
        var businessKey = '${/parameter/@businessKey}';

        var param = parent.currentTaskInfo.execution_variables;

        if (!businessKey) {
            var businessKey = param.filter(function (o) {
                return o.name == "hdId";
            })[0].value;
        }

        var projectId = param.filter(function (o) {
            return o.name == "projectId";
        })[0].value;

        var durationType = param.filter(function (o) {
            return o.name == "durationType";
        })[0].value;

        var projectName = param.filter(function (o) {
            return o.name == "projectName";
        })[0].value;
        if(durationType =='REPLY'){
            var approvalId = param.filter(function (o) {
                return o.name == "approvalId";
            })[0].value;
        }


        var function_code = '';
        var buttonFlag = '${/parameter/@buttonFlag}';
        //业务类变更申请 需要上会
        if (buttonFlag == 'B') {
            function_code = 'PRJ319F3';
        } else if (buttonFlag == 'C') {
            function_code = 'PRJ319F5';
        } else if (buttonFlag == 'D') {
            function_code = 'PRJ319F4';
        } else {
            function_code = 'PRJ319F6';
        }

        var pageChooser = new PageChooser({
            url: $('duration_reply_wfl_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                hd_id: businessKey,
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: function_code,
                duration_type: durationType,
                data_class: 'CHANGE',
                projectName:projectName,
                buttonFlag: buttonFlag,
                approval_id: approvalId,
                wfl_flag: 'Y'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
