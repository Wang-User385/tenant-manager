<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_factoring_approval_query_main_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ516/project_factoring_modify_detail.lview"/>

        <script><![CDATA[
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_prj_project_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        }

        function open_prj_project_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            var maintain_type = 'READONLY';
            var function_usage = 'QUERY';
            param['investigation_readonly_flag'] = 'Y';
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            param['url_title'] = '项目审批';
            param['function_code'] = 'PRJ516F1';
            param['winid'] = 'factoring_approval_prj_detail_winid';
            hls_doc_get_layout_code(param, 'prj_factoring_approval_query_main_detail', ds_id, 'PRJ517');
        }
        ]]>

        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
