        function hideBigSaveButton() {
            // 获取特定 class 的 div
            const div = document.querySelector('.screenTopToolbar.clearfix');
            // 获取 div 下的所有 button
            const buttons = div.querySelectorAll('button');
            buttons.forEach(button => {
                if (button.textContent === '保存') {
                    button.style.display = 'none';
                }
            });
        }

        function processingGridByDivId(div_id) {
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为不显示
            for (var i = 0; i < buttonsInDiv.length; i++) {
                if (buttonsInDiv[i].textContent !== '导出') {
                    buttonsInDiv[i].style.display = 'none';
                }
            }
        }

        function noCreditFlogComponentHide() {
            let plan_line_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_DETAIL_component_id']").attr("id");
            let plan_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_component_id']").attr("id");
            $jq('#${/parameter/@layout_code}_T_METHOD_DETAIL_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_F_METHOD_component_id').hide();//隐藏客户信息组件
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).prev().hide();
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).next().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).prev().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).next().hide();
        }

        function wflCommonHide() {
            hideBusinessComponent();
            hideExamRiskComponent();
            hideExamLawComponent();
            hideExamApproveComponent();
            hideExamPrjComponent();
            let investigation_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_INVESTIGATION_component_id']").attr("id");
            $jq('#${/parameter/@layout_code}_F_INVESTIGATION_component_id').hide();//隐藏客户信息组件
            jQuery(investigation_component_id).hide();
            jQuery(investigation_component_id).prev().hide();
            jQuery(investigation_component_id).hide();
            jQuery(investigation_component_id).next().hide();
        }

        function wflComponentHide() {
            wflCommonHide();
            //隐藏按钮
            jQuery('#${/parameter/@layout_code}_user_button1').hide();
            jQuery('#${/parameter/@layout_code}_user_button2').hide();
        }

        function wflComponentHideTo14Component() {
            var node_id = '${/parameter/@node_id}';
            if (node_id === 'FACTORING_BUSINESS_APPROVALS6' || node_id === 'FACTORING_BUSINESS_APPROVALS8') {
                hideExamLawComponent();
                hideExamApproveComponent();
                hideExamPrjComponent();
            }
            if (node_id === 'FACTORING_BUSINESS_APPROVALS7' || node_id === 'FACTORING_BUSINESS_APPROVALS9') {
                hideExamRiskComponent();
                hideExamApproveComponent();
                hideExamPrjComponent();
            }
        }

        function wflComponentHideTo15Component() {
            hideExamApproveComponent();
            hideExamPrjComponent();
        }

        function wflComponentHideTo16Component() {
            hideExamPrjComponent();
        }

        function openBigSaveButton() {
            // 获取特定 class 的 div
            const div = document.querySelector('.screenTopToolbar.clearfix');
            // 获取 div 下的所有 button
            const buttons = div.querySelectorAll('button');
            buttons.forEach(button => {
                if (button.textContent === '保存') {
                    button.style.display = 'block';
                }
            });
        }

        function hideBigExitButton() {
            // 获取特定 class 的 div
            const div = document.querySelector('.screenTopToolbar.clearfix');
            // 获取 div 下的所有 button
            const buttons = div.querySelectorAll('button');
            buttons.forEach(button => {
                if (button.textContent === '退出') {
                    button.style.display = 'none';
                }
            });
        }

