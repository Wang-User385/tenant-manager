        function processingGridByDivIdShow(div_id) {
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为显示
            for (var i = 0; i < buttonsInDiv.length; i++) {
                buttonsInDiv[i].style.display = 'block';
            }
        }

        function projectFieldSetting() {
            var ds_id_investigation = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id_investigation).getAll()[0];
            record.getField('spot_check_desc').setRequired(true);
            record.getField('spot_check_desc').setReadOnly(false);
            record.getField('risk_invest_desc').setReadOnly(false);
            record.getField('risk_invest_desc').setRequired(true);
        }

        function businessFieldSetting() {
            debugger;
            var ds_id_business = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'project_business_access_compare', 'G_BUSINESS_FAC');
            var records = $(ds_id_business).getAll();
            for (let i = 0; i < records.length; i++) {
