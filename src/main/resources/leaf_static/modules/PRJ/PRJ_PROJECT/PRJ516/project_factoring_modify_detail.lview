        function generateText(template_code,ds_id_con) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var record = $(ds_id).getCurrentRecord();
            var project_id = record.get('project_id');
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/prj/factoring/content",
                para: {
                    project_id: project_id,
                    template_code: template_code
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成成功!", null);
                    $(ds_id_con).query();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                scope: this
            });
        }


        //task_detail执行提交前调用
        function beforeSubmit(countiune) {
            var node_id = '${/parameter/@node_id}';
            if ((
                node_id == 'FACTORING_BUSINESS_APPROVALS6' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS7' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS12' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS13' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS17' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS26' ||
                node_id == 'FACTORING_BUSINESS_APPROVALS27')) {
                //提交时自动保存
                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                    countiune();
                });
                return;
            }
            countiune();
        }




        ]]></script>
