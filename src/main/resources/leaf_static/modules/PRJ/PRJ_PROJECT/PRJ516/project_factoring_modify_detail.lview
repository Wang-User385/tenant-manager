<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="factoring_approval_bp_master_modify_link_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="factoring_finance_approval_report_detail_link_id"
                url="${/request/@context_path}/modules/BP/BP100/financial_report_import_entrance.lview"/>
        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <script><![CDATA[
        var wfl_is_save = true;
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var file_num = record.get('file_num') || 0;
            var attach_name = file_num === 0 ? '附件' : '附件(' + file_num + ')';
            if (name == 'bp_detail') {
                return '<a href="javascript:open_master_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户明细信息</a>';
            } else if (name == 'bp_financia') {
                return '<a href="javascript:open_financia_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户财报信息</a>';
            } else if (name == 'info') {
                return '<a href="javascript:upload(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('project_id') + '\');">' + attach_name + '</a>';
            } else if (name == 'quote') {
                return '<a href="javascript:quotation_factoring_detail_adjust(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\',\'' + record.get('chance_id') + '\')"><span style="    width: 82px;\n' +
                    '    background-color: #4CAF50;\n' +
                    '    border: none;\n' +
                    '    color: white;\n' +
                    '    padding: 1px 33px;\n' +
                    '    text-align: center;\n' +
                    '    text-decoration: none;\n' +
                    '    display: inline-block;\n' +
                    '    font-size: 13px;\n' +
                    '    margin: 0px 0px;\n' +
                    '    cursor: pointer;\n' +
                    '    border-radius: 8px;\n' +
                    '    transition: background-color 0.3s;">报价测算' +
                    '</span></a>';
            } else if (name == 'preview') {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_names').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (let i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i]) || checkXls(fileNameList[i])) {
                            html += '<a href=javascript:queryDocFile(\'' + sourcePkList[i] + '\')> ' + fileNameList[i] + '在线预览</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
        };

        //暂存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line_chance', 'F_BASIC');
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATIO_FINANCIA');
            if (ds_id) {
                var record = $(ds_id).getCurrentRecord();
                if ('${/parameter/@function_usage}' == 'CREATE' && !record.get('credit_line_number')) {
                    setBasicInfoInCreate(record, ds_id_pq, ds_id);
                }
            }
            //忽略保存校验方法
            window['${/parameter/@layout_code}_ignore_required_before_save']();
            var root_ds = $('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            var before_flag = true;
            if (before_flag) {
                var winid = '${/parameter/@winid}';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@layout_code}');

                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE() {
                    root_ds.un('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if (!flag) {
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION() {
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds, root_record, res);
                    if (typeof (nextStep) == 'function') {
                        nextStep(ds);
                    }
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }

                root_ds.on('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                root_ds.doNewSubmit(null, root_ds.getJsonData());
            } else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        }

        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
                var ds_id_re = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_receivable', 'G_RECEIVE_PAY');
                var ds_id_at = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
                var ds_id_cf = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_PLAN');
                if (!$(ds_id_cf).getAll() || $(ds_id_cf).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '请生成现金流计划后再提交审批');
                    return;
                }
                if (!$(ds_id_re).getAll() || $(ds_id_re).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '应收账款信息不能为空！');
                    return;
                }
                if (!$(ds_id_at).getAll() || $(ds_id_at).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '附件信息不能为空！');
                    return;
                }
                var records = $(ds_id_at).getAll();
                for (let i = 0; i < records.length; i++) {
                    var record_at = records[i];
                    if (!record_at.get('file_num') || record_at.get('file_num') === 0) {
                        Leaf.showInfoMessage('提示', '文档名称为' + record_at.get('document_name') + '附件不能为空');
                        return;
                    }
                }


                var record = $(ds_id).getCurrentRecord();
                var project_id = record.get('project_id');
                if (project_id != null) {
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/prj/factoring/submit',
                            para: {
                                project_id: project_id
                            },
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();
                                var ds_id_main = 'PRJ516_G_FAC_APPROVAL_prj_project_ds';
                                $(ds_id_main).query();
                                Leaf.showSuccessMessage("提示", "提交审批成功!");
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    }, function cancel() {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    }, 200, 100);
                } else {
                    $L.showInfoMessage("提示", "请先保存!", null);
                }
            })
        }

        //一键下载
        window['${/parameter/@layout_code}_G_ATTA_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var record = $(ds_id).getCurrentRecord();
            var project_id = parseInt(record.get('project_id'));
            var down_url = "${/request/@context_path}/prj/factoring/download?projectId=" + project_id + "&projectAttachmentCategory=CHANCE_PRJ_ATT";
            location.href = down_url;
        }


        //合同文本生成
        window['${/parameter/@layout_code}_G_EXAMINATION_RISK_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id_risk = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_RISK');
            var template_code = "FACTORING_RISK";
            generateText(template_code,ds_id_risk);
        }
        //合同文本生成
        window['${/parameter/@layout_code}_G_EXAMINATION_LAW_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var ds_id_law = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_LAW');
            var template_code = "FACTORING_LAW";
            generateText(template_code,ds_id_law);
        }
        //合同文本生成
        window['${/parameter/@layout_code}_G_EXAMINATION_APPROVE_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var template_code = "FACTORING_APPROVE";
            var ds_id_approve = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_APPROVE');
            generateText(template_code,ds_id_approve);
        }
        //合同文本生成
        window['${/parameter/@layout_code}_G_EXAMINATION_PRJ_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var template_code = "FACTORING_PRJ";
            var ds_id_prj = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_PRJ');
            generateText(template_code,ds_id_prj);
        }

        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value) {
            wfl_is_save = false;
            var quo_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            if (ds.id === quo_ds) {
                if (name == 'lease_item_amount' || name == 'down_payment') {
                    var lease_item_amount = record.get('lease_item_amount') || 0;
                    var down_payment = record.get('down_payment') || 0;
                    record.set('finance_amount', minus(lease_item_amount, down_payment));
                }
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var ds_id_investigation = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATION_FINANCIA');
            var node_id = '${/parameter/@node_id}';
            if (ds.id == ds_id_au) {
                if ('${/parameter/@credit_flag}' == 'N') {
                    record.getField('quota_type').setRequired(false);
                    record.getField('quota_type_n').setRequired(false);
                    record.getField('date_from').setRequired(false);
                    record.getField('date_to').setRequired(false);
                    record.getField('credit_desc').setRequired(false);
                }
            } else if (ds.id == ds_id_investigation) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS6' || node_id == 'FACTORING_BUSINESS_APPROVALS12'
                    || node_id == 'FACTORING_BUSINESS_APPROVALS7' || node_id == 'FACTORING_BUSINESS_APPROVALS13') {
                    projectFieldSetting();
                }else {
                    record.getField('spot_check_desc').setRequired(false);
                    record.getField('spot_check_desc').setReadOnly(false);
                    record.getField('risk_invest_desc').setRequired(false);
                    record.getField('risk_invest_desc').setReadOnly(false);
                }
            } else if (ds.id == ds_id_pq) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS27') {
                    quotationFieldSetting();
                }
            }

        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id_atta = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
            var ds_id_pre = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_condition', 'G_CON_FAC');
            var ds_id_after = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_condition', 'G_CON_FAC_AFTER');
            if (ds.id == ds_id_pre) {
                record.set('stage', 'STAGE_PRE');
            } else if (ds.id == ds_id_after) {
                record.set('stage', 'STAGE_AFTER');
            } else if (ds.id == ds_id_atta) {
                record.set('project_attachment_category', 'CHANCE_PRJ_ATT');
            }
        };


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id_pre = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_condition', 'G_CON_FAC');
            var ds_id_after = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_condition', 'G_CON_FAC_AFTER');
            var ds_id_atta = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
            var ds_id_risk = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_RISK');
            var ds_id_law = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_LAW');
            var ds_id_approve = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_APPROVE');
            var ds_id_prj = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_PRJ');
            var ds_id_business = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'project_business_access_compare', 'G_BUSINESS_FAC');

            if (ds.id == ds_id_pre) {
                $(ds_id_pre).setQueryParameter('stage', 'STAGE_PRE')
            } else if (ds.id == ds_id_after) {
                $(ds_id_after).setQueryParameter('stage', 'STAGE_AFTER')
            } else if (ds.id == ds_id_atta) {
                $(ds_id_atta).setQueryParameter('project_attachment_category', 'CHANCE_PRJ_ATT')
            } else if (ds.id == ds_id_risk) {
                $(ds_id_risk).setQueryParameter('project_attachment_category', 'CHANCE_PRJ_RISK_ATT')
            } else if (ds.id == ds_id_law) {
                $(ds_id_law).setQueryParameter('project_attachment_category', 'CHANCE_PRJ_LAW_ATT')
            } else if (ds.id == ds_id_approve) {
                $(ds_id_approve).setQueryParameter('project_attachment_category', 'CHANCE_PRJ_APPROVE_ATT')
            } else if (ds.id == ds_id_prj) {
                $(ds_id_prj).setQueryParameter('project_attachment_category', 'CHANCE_PROJECT_ATT')
            } else if (ds.id == ds_id_business) {
                $(ds_id_business).fetchall == true;
                $(ds_id_business).setQueryParameter('user_id', '${/session/@user_id}');
            }
        };


        //保存前
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            var check_flag = true;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id_customer = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'F_CUSTOMER');
            var set = new Set();
            var records_customer = $(ds_id_customer).getAll();
            for (let i = 0; i < records_customer.length; i++) {
                var record_customer = records_customer[i];
                if (set.has(record_customer.get('TRANSFEREE_ASSETS'))) {
                    Leaf.showErrorMessage('提示', '客户信息保理卖方只能有一个');
                    return false;
                }
                set.add(record_customer.get('bp_type'));
            }
            set.clear();
            var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            var records_p = $(ds_id_p).getAll();
            if (records_p) {
                for (let i = 0; i < records_p.length; i++) {
                    var record_p = records_p[i];
                    if (set.has(record_p.get('factoring_category'))) {
                        Leaf.showErrorMessage('提示', '授信明细保理种类为' + record_p.get('factoring_category_n') + '有多个');
                        return false;
                    }
                    set.add(record_p.get('factoring_category'));
                }
            }
            var ds_id_cp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var record_cp = $(ds_id_cp).getCurrentRecord();
            if (record_cp.get('date_from') > record_cp.get('date_to')) {
                Leaf.showErrorMessage('提示', '授信开始日期不能大于授信结束日期');
                return false;
            }
            var ds_id_pq = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATION_FINANCIA');
            var record_quo = $(ds_id_pq).getCurrentRecord();
            if (record_quo) {
                record_cp.set('credit_amt', record_quo.get('finance_amount'));
            }
            return check_flag;
        }


        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            wfl_is_save = true;
        }

        // 加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var node_id = '${/parameter/@node_id}';
            var ds_id_risk = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_RISK');
            var ds_id_law = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_LAW');
            var ds_id_approve = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_APPROVE');
            var ds_id_atta = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
            var ds_id_exam = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_PRJ');
            //当前节点可以编辑业务准入信息
            var ds_id_business = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'project_business_access_compare', 'G_BUSINESS_FAC');
            if (ds.id == ds_id_business) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS6' ||
                    node_id == 'FACTORING_BUSINESS_APPROVALS12' ||
                    node_id == 'FACTORING_BUSINESS_APPROVALS7' ||
                    node_id == 'FACTORING_BUSINESS_APPROVALS13' ||
                    node_id == 'FACTORING_BUSINESS_APPROVALS17') {
                    businessFieldSetting();
                }else {
                    noBusinessFieldSetting();
                }
            } else if (ds.id == ds_id_risk) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS6' || node_id == 'FACTORING_BUSINESS_APPROVALS12') {
                    unitFieldSetting('G_EXAMINATION_RISK');
                }
            } else if (ds.id == ds_id_law) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS7' || node_id == 'FACTORING_BUSINESS_APPROVALS13') {
                    unitFieldSetting('G_EXAMINATION_LAW');
                }
            } else if (ds.id == ds_id_approve) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS17') {
                    unitFieldSetting('G_EXAMINATION_APPROVE');
                }
            } else if (ds.id == ds_id_exam) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS27') {
                    unitFieldSetting('G_EXAMINATION_PRJ');
                }
            } else if (ds.id == ds_id_atta) {
                if (node_id == 'FACTORING_BUSINESS_APPROVALS26' || node_id == 'FACTORING_BUSINESS_APPROVALS31') {
                    var attach_grid_div_id = 'PRJ516F1_G_ATTA_INFO_prj_project_attachment_layout_grid_id_tb';
                    processingGridByDivIdShow(attach_grid_div_id);
                    unitFieldSetting('G_ATTA_INFO');
                }
            }
        };

        Leaf.onReady(function () {
            debugger;
            var credit_flag = '${/parameter/@credit_flag}';
            var credit_flag_n = '${/parameter/@credit_flag_n}';
            //隐藏工作流要用组件
            if (!'${/parameter/@wfl_flag}') {
                if ('${/parameter/@function_usage}' === 'QUERY'){
                    hideBigSaveButton();
                }
                wflCommonHide();
            } else {
                hideBigExitButton();
                jQuery('#${/parameter/@layout_code}_user_button1').hide();
                jQuery('#${/parameter/@layout_code}_user_button2').hide();
            }
            if ('${/parameter/@wfl_flag}' == 'A') {
                wflComponentHide();
            }
            if ('${/parameter/@wfl_flag}' == 'B') {
                wflComponentHideTo14Component();
            }
            if ('${/parameter/@wfl_flag}' == 'C') {
                wflComponentHideTo15Component();
            }
            if ('${/parameter/@wfl_flag}' == 'D') {
                wflComponentHideTo16Component();
            }
            //不是授信则隐藏授信组件
            if (credit_flag == 'N' || credit_flag_n == '否') {
                noCreditFlogComponentHide();
            }
            if ('${/parameter/@special_node_flag}' == 'Y') {
                specialNodeProcessing();
            }
            var node_id = '${/parameter/@node_id}';
            if (node_id == 'FACTORING_BUSINESS_APPROVALS26' || node_id == 'FACTORING_BUSINESS_APPROVALS31') {
                $('${/parameter/@layout_code}_G_ATTA_INFO_prj_project_attachment_ds').on('beforeremove', function (ds, records) {
                    for (var i = 0; i < records.length; i++) {
                        if (records[i].get('created_by') != '${/session/@userId}') {
                            Leaf.showMessage("提示", "不允许删除不是自己创建的附件记录!", null);
                            return false;
                        }
                    }
                });
            }
            // 控制主角色不能删除
            $('${/parameter/@layout_code}_F_CUSTOMER_prj_project_bp_ds').on('beforeremove', function (ds, records) {
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('bp_type') == 'TRANSFEREE_ASSETS') {
                        Leaf.showMessage("提示", "客户信息为保理卖方的不允许删除!", null);
                        return false;
                    }
                }
            });
        });

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        function checkXls(name) {
            return /\.(xls|xlsx)$/i.test(name)
        }

        //在线预览
        function queryDocFile(source_pk_value) {
            window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
        }

        function open_master_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '商业伙伴信息';
            param['function_code'] = 'BP100F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'factoring_bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'factoring_approval_bp_master_modify_link_id', null, 'PRJ561F1');
        }

        function open_financia_detail_win(record_id, ds_id) {
            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code'];
            var function_usage = 'QUERY';
            new Leaf.Window({
                id: 'factoring_financial_approval_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: function_usage,
                    winid: 'hls_bp_master_financial_approval_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 950,
                height: 535,
                side: "right",
                draggable: true
            });
            hls_doc_get_layout_code(param, 'factoring_finance_approval_report_detail_link_id', null, 'PRJ561F1');

        }

        function upload(ds_id, record_id, pk_id) {
            debugger;
            var tableName = 'PRJ_PROJECT_ATTACHMENT';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
            var ds_id_risk = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_RISK');
            var ds_id_law = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_LAW');
            var ds_id_approve = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_APPROVE');
            var ds_id_prj = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_EXAMINATION_PRJ');
            var base_record;
            var project_attachment_id;
            if (ds_id == base_ds_id){
                base_record = $(base_ds_id).findById(record_id);
            }else if (ds_id == ds_id_risk){
                base_record = $(ds_id_risk).findById(record_id);
            }else if (ds_id == ds_id_law){
                base_record = $(ds_id_law).findById(record_id);
            }else if (ds_id == ds_id_approve){
                base_record = $(ds_id_approve).findById(record_id);
            }else if (ds_id == ds_id_prj){
                base_record = $(ds_id_prj).findById(record_id);
            }
            project_attachment_id = base_record.get('project_attachment_id');
            if (!project_attachment_id) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            var title = '文件上传下载';
            var url = '${/request/@context_path}/uploadFile.lview';
            var created_by = base_record.get('created_by');
            var cur_by = '${/session/@user_id}';
            var function_usage = 'MODIFY';
            if (created_by && created_by !== cur_by) {
                function_usage = 'QUERY';
                url = '${/request/@context_path}/downloadFile.lview';
                title = '文件下载';
            }
            var win = new Leaf.Window({
                id: 'PRJ516F1_open_attachment_factoring_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': tableName,
                    winid: 'PRJ516F1_open_attachment_factoring_winid',
                    function_usage: function_usage
                },
                title: title,
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }

        function quotation_factoring_detail_adjust(dsId, record_id, quotation_id, project_id) {
            var price_list = $(dsId).findById(record_id).get("price_list");
            quotation_id = $(dsId).findById(record_id).get("quotation_id");
            project_id = $(dsId).findById(record_id).get("project_id");
            if (quotation_id == 'undefined' || quotation_id == null || quotation_id == '') {
                Leaf.showInfoMessage("提示", "请先保存后，再进行报价测算");
                return;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/prj/quotation/calc?quotationId=' + quotation_id,
                para: null,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '计算成功',
                        duration: 2000
                    });
                    var readOnly = 'N';
                    var node_id = '${/parameter/@node_id}';
                    if ('${/parameter/@function_usage}' == 'QUERY' && node_id != 'FACTORING_BUSINESS_APPROVALS27') {
                        readOnly = 'Y';
                    }
                    var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list + '&readOnly=' + readOnly;
                    var win = new Leaf.Window({
                        id: 'hls901_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var quo_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATION_FINANCIA');
                        if (project_id) {
                            $(quo_ds).setQueryParameter('project_id', project_id);
                        }
                        $(quo_ds).query();
                        var ds_id_cp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
                        var record_cp = $(ds_id_cp).getCurrentRecord();
                        if (record_cp) {
                            var record_quo = $(quo_ds).getCurrentRecord();
                            if (record_quo) {
                                record_cp.set('credit_amt', record_quo.get('finance_amount'));
                            }
                        }
                    })
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }


