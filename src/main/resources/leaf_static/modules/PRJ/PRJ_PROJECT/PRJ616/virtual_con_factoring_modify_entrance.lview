<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="contract_approve_detatil_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ616/virtual_con_factoring_modify_detail.lview"/>
        <a:link id="project_detatil_open_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ516/project_factoring_modify_detail.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            var link_function = '';
            if (name == 'contract_number') {
                link_function = 'contract_approve_detatil_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }else if (name == 'project_number') {
                link_function = 'project_detatil_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        //合同审批明细页面
        function contract_approve_detatil_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['url_title'] = '合同审批明细页面';
            param['function_code'] = 'PRJ616F1';
            param['winid'] = 'contract_approve_detatil_winid';
            var maintain_type = 'UPDATE';
            var function_usage = 'MODIFY';
            if (record.get('contract_status') != 'NEW' && record.get('contract_status') != 'REJECTED') {
                maintain_type = 'READONLY';
                function_usage = 'QUERY';
            }
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            hls_doc_get_layout_code(param, 'contract_approve_detatil_link_id', ds_id, 'PRJ616F1');
        }

        //项目详情信息页面
        function project_detatil_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['url_title'] = '项目详情信息页面';
            param['function_code'] = 'PRJ516F1';
            param['winid'] = 'project_detatil_open_winid';

            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'project_detatil_open_link_id', ds_id, 'PRJ616F1');
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>