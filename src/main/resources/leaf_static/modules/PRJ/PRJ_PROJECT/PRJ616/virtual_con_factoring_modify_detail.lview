<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="factoring_approval_bp_master_modify_link_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>

        <a:link id="factoring_finance_approval_report_detail_link_id"
                url="${/request/@context_path}/modules/BP/BP100/financial_report_import_entrance.lview"/>

        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <script><![CDATA[
        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        function checkXls(name) {
            return /\.(xls|xlsx)$/i.test(name)
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var file_num = record.get('file_num') || 0;
            var attach_name = file_num === 0 ? '附件' : '附件(' + file_num + ')';
            if (name == 'bp_detail') {
                return '<a href="javascript:open_master_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户明细信息</a>';
            } else if (name == 'bp_financia') {
                return '<a href="javascript:open_financia_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">客户财报信息</a>';
            } else if (name == 'info') {
                return '<a href="javascript:upload(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('project_id') + '\');">' + attach_name + '</a>';
            } else if (name == 'quote') {
                return '<a href="javascript:quotation_factoring_detail_adjust(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\',\'' + record.get('chance_id') + '\')"><span style="    width: 82px;\n' +
                    '    background-color: #4CAF50;\n' +
                    '    border: none;\n' +
                    '    color: white;\n' +
                    '    padding: 1px 33px;\n' +
                    '    text-align: center;\n' +
                    '    text-decoration: none;\n' +
                    '    display: inline-block;\n' +
                    '    font-size: 13px;\n' +
                    '    margin: 0px 0px;\n' +
                    '    cursor: pointer;\n' +
                    '    border-radius: 8px;\n' +
                    '    transition: background-color 0.3s;">报价测算' +
                    '</span></a>';
            } else if (name == 'preview') {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_names').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (let i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i]) || checkXls(fileNameList[i])) {
                            html += '<a href=javascript:queryDocFile(\'' + sourcePkList[i] + '\')> ' + fileNameList[i] + '在线预览</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
        };

        //在线预览
        function queryDocFile(source_pk_value) {
            window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
        }
        //商业伙伴信息
        function open_master_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '商业伙伴信息';
            param['function_code'] = 'BP100F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'factoring_bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'factoring_finance_approval_report_detail_link_id', null, 'PRJ561F1');
        }

        //财务报表查看
        function open_financia_detail_win(record_id, ds_id) {
            debugger;
            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code'];
            var function_usage = 'QUERY';
            new Leaf.Window({
                id: 'factoring_financial_approval_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    function_usage: function_usage,
                    winid: 'hls_bp_master_financial_approval_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 950,
                height: 535,
                side: "right",
                draggable: true
            });
            hls_doc_get_layout_code(param, 'factoring_finance_approval_report_detail_link_id', null, 'PRJ561F1');

        }

        //文件上传下载
        function upload(ds_id, record_id, pk_id) {
            debugger;
            var tableName = 'PRJ_PROJECT_ATTACHMENT';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CON_TEXT');
            var base_record;
            var project_attachment_id;
            base_record = $(base_ds_id).findById(record_id);
            project_attachment_id = base_record.get('project_attachment_id');
            if (!project_attachment_id) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            var url = '${/request/@context_path}/uploadFile.lview';
            var win = new Leaf.Window({
                id: 'PRJ516F1_open_attachment_factoring_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': tableName,
                    winid: 'PRJ516F1_open_attachment_factoring_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }

        //报价测算
        function quotation_factoring_detail_adjust(dsId, record_id, quotation_id, project_id) {
            var price_list = $(dsId).findById(record_id).get("price_list");
            quotation_id = $(dsId).findById(record_id).get("quotation_id");
            project_id = $(dsId).findById(record_id).get("project_id");
            if (quotation_id == 'undefined' || quotation_id == null || quotation_id == '') {
                Leaf.showInfoMessage("提示", "请先保存后，再进行报价测算");
                return;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/prj/quotation/calc?quotationId=' + quotation_id,
                para: null,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '计算成功',
                        duration: 2000
                    });
                    var readOnly = 'N';
                    if ('${/parameter/@function_usage}' == 'QUERY') {
                        readOnly = 'Y';
                    }
                    var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list + '&readOnly=' + readOnly;
                    var win = new Leaf.Window({
                        id: 'hls901_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var quo_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATION_FINANCIA');
                        if (project_id) {
                            $(quo_ds).setQueryParameter('project_id', project_id);
                        }
                        $(quo_ds).query();
                        var ds_id_cp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
                        var record_cp = $(ds_id_cp).getCurrentRecord();
                        if (record_cp) {
                            var record_quo = $(quo_ds).getCurrentRecord();
                            if (record_quo) {
                                record_cp.set('credit_amt', record_quo.get('finance_amount'));
                            }
                        }
                    })
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var ds_id_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTA_INFO');
            var ds_id_con_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CON_TEXT');
            var ds_id_customer = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'F_CUSTOMER');
            var ds_id_p = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');

            if (ds_id_customer.id == ds.id && '${/parameter/@function_usage}' == 'CREATE') {
                var records = $(ds_id_customer.id).getAll();
                var query_data = [];
                for (let i = 0; i < records.length; i++) {
                    query_data.push(records[i].data);
                }
                Leaf.request({
                    url: '${/request/@context_path}/get/factoring/bp/info',
                    para: query_data,
                    success: function (res) {
                        var res_records = res.result.record;
                        for (let i = 0; i < res_records.length; i++) {
                            var record = records[i];
                            var res_record = res_records[i];
                            record.set('bp_name', res_record.bp_name);
                            record.set('bp_code', res_record.bp_code);
                            record.set('bp_type', res_record.bp_type);
                            record.set('bp_type_n', res_record.bp_type_n);
                            record.set('economic_indu_classify', res_record.economic_indu_classify);
                            record.set('economic_indu_classify_n', res_record.economic_indu_classify_n);
                            record.set('group_companies', res_record.group_companies);
                        }
                    },
                    sync: true
                });
            } else if (ds.id == ds_id_p) {
                if (record) {
                    var record_ds_id_au = $(ds_id_au).getCurrentRecord();
                    var record_f = $(ds_id_customer).getAll()[0];
                    record.set('credit_plan_id', record_ds_id_au.get('credit_plan_id'));
                    record.set('bp_code', record_f.get('bp_code'));
                    record.set('bp_name', record_f.get('bp_name'));
                    record.set('bp_name_n', record_f.get('bp_name_n'));
                    record.set('bp_type', record_f.get('bp_type'));
                    record.set('bp_type_n', record_f.get('bp_type_n'));
                    record.set('group_companies', record_f.get('group_companies'));
                    record.set('economic_indu_classify', record_f.get('economic_indu_classify'));
                    record.set('economic_indu_classify_n', record_f.get('economic_indu_classify_n'));
                }
            } else if (ds.id == ds_id_con_att){
                $(ds_id_con_att).getCurrentRecord().set('project_attachment_category','VIRTUAL_CON_CONTENT');
                $(ds_id_con_att).getCurrentRecord().set('project_id','${/parameter/@project_id}');
            } else if (ds.id == ds_id_att){
                $(ds_id_con_att).getCurrentRecord().set('project_attachment_category','VIRTUAL_CON_ATT');
                $(ds_id_con_att).getCurrentRecord().set('project_id','${/parameter/@project_id}');
            }
        };

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var ds_id_at = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CON_TEXT');

            if (!$(ds_id_at).getAll() || $(ds_id_at).getAll().length === 0) {
                Leaf.showInfoMessage('提示', '合同文本附件信息不能为空！');
                return;
            }
            var records = $(ds_id_at).getAll();
            for (let i = 0; i < records.length; i++) {
                var record_at = records[i];
                if (!record_at.get('file_num') || record_at.get('file_num') === 0) {
                    Leaf.showInfoMessage('提示', '文档名称为' + record_at.get('document_name') + '附件不能为空');
                    return;
                }
            }

            var record = $(ds_id).getCurrentRecord();
            var project_id = record.get('project_id');
            if (project_id != null) {
                new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/prj/virtual/contract/wfl/submit',
                        para: {
                            project_id: project_id
                        },
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $('${/parameter/@winid}').close();
                            var ds_id_main = 'PRJ005_G_FAC_hls_credit_line_chance_ds';
                            $(ds_id_main).query();
                            Leaf.showSuccessMessage("提示", "提交审批成功!");
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }, function cancel() {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }, 200, 100);
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        }

        //task_detail执行提交前调用
        function beforeSubmit(countiune) {
            debugger;
            var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var project_id = $(ds_root_id).getCurrentRecord().get('project_id');
            var ds_id_con_make = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CON_MAKING');
            var cur_record = $('chance_appoint_user_ds').getCurrentRecord();
            var fin = '';
            var finance_charge_id = '';
            var legal_host = '';
            var node_id = '${/parameter/@node_id}';
            //S9节点校验合同审查表附件
            if ('CONTRACT_APPROVALS9' == node_id){
                if (!$(ds_id_con_make).getAll() || $(ds_id_con_make).getAll().length === 0) {
                    Leaf.showInfoMessage('提示', '请先制作合同审查简表，再操作！');
                    return;
                }
            }

            if (cur_record) {
                var allocation_id = cur_record.get('allocation_id');
                if ('CONTRACT_APPROVALS5' == node_id) {
                    finance_charge_id = allocation_id;
                } else if ('CONTRACT_APPROVALS8' == node_id) {
                    legal_host = allocation_id;
                }
                if (node_id == 'CONTRACT_APPROVALS5' || node_id == 'CONTRACT_APPROVALS8') {
                    Leaf.request({
                        url: '${/request/@context_path}/prj/virtual/contract/save/approver',
                        para: {
                            project_id: project_id,
                            finance_charge_id: finance_charge_id,
                            legal_host: legal_host
                        },
                        success: function (res) {
                        },
                        sync: true
                    });
                }
            }
            countiune();
        }

        //初始化页面
        Leaf.onReady(function () {
            debugger;
            var node_id = '${/parameter/@node_id}';
            var function_usage = '${/parameter/@function_usage}';

            //从工作流来到的这个页面
            if ('${/parameter/@wfl_flag}') {
                hideBigExitButton();
                //业务复核人节点设置可输字段
                if (node_id == 'CONTRACT_APPROVALS3' ){
                    contractApprovedModify();
                }
                //隐藏保存按钮
                if (node_id !== 'CONTRACT_APPROVALS3' ){
                    hideBigSaveButton();
                    //附件按钮不显示
                    unHideConContentGridBtn();
                    //业务准入审核设置为非必填只读
                    businessFieldSetting();
                }

                if(node_id !== 'CONTRACT_APPROVALS9'){
                    //隐藏合同审批表附件
                    hideConApproveTable();
                    //隐藏外聘法律信息
                    hideOutLawInfo();
                }
            }else{
                if(function_usage === 'QUERY'){
                    //只读页面隐藏保存
                    hideBigSaveButton();
                    //附件按钮不显示
                    unHideConContentGridBtn();
                }
                //隐藏法律相关信息
                hideOutLawInfo();
                //隐藏合同审批表附件
                hideConApproveTable();
            }

        });

        //新增和加载时调用(grid)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            debugger;
            var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var ds_id_au = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var prj_info = $(ds_root_id).getCurrentRecord();
            var credit_method = $(ds_id_au).getCurrentRecord();
            //非授信项目隐藏授信方案和明细
            if(prj_info.get('credit_flag') !== 'Y'){
                //设置授信相关字段非必填
                credit_method.getField("quota_type").setRequired(false);
                credit_method.getField('quota_type_n').setRequired(false);
                credit_method.getField("date_from").setRequired(false);
                credit_method.getField("date_to").setRequired(false);
                credit_method.getField("credit_desc").setRequired(false);
                //隐藏授信组件
                hideCreditMethod();
            }


        }


        function contractApprovedModify() {
            var ds_root_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var ds_quotation_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'F_QUOTATION_FINANCIA');
            var ds_credit_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan', 'F_METHOD');
            var ds_business_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'project_business_access_compare', 'G_BUSINESS_FAC');

            //基本信息
            var prj_info = $(ds_root_id).getCurrentRecord();
            //报价信息
            var quo_info = $(ds_quotation_id).getCurrentRecord();
            //授信方案
            var credit_info = $(ds_credit_id).getCurrentRecord();
            //业务准入审核
            var business_infos = $(ds_business_id).getAll();

            //基本信息字段设置
            prj_info.getField("contract_number").setReadOnly(false);
            prj_info.getField("contract_number").setRequired(true);
            prj_info.getField("contract_content_number").setReadOnly(false);
            prj_info.getField("contract_content_number").setRequired(true);
            prj_info.getField("contract_sign_address").setReadOnly(false);
            prj_info.getField("contract_sign_address").setRequired(true);
            prj_info.getField("contract_sign_times").setReadOnly(false);
            prj_info.getField("contract_sign_times").setRequired(true);
            prj_info.getField("factoring_category").setReadOnly(false);
            prj_info.getField("credit_measures").setReadOnly(false);
            prj_info.getField("credit_measures").setRequired(true);
            prj_info.getField("contract_special_condit").setReadOnly(false);
            prj_info.getField("contract_special_condit").setRequired(true);

            //报价信息
            quo_info.getField("lease_start_date").setReadOnly(false);
            quo_info.getField("lease_start_date").setRequired(true);

            //授信方案
            credit_info.getField("date_from").setReadOnly(false);
            credit_info.getField("date_from").setRequired(true);
            credit_info.getField("date_to").setReadOnly(false);
            credit_info.getField("date_to").setRequired(true);

            //业务准入审核
            for (var i = 0; i < business_infos.length; i++){
                business_infos[i].getField("check_result").setReadOnly(false);
                business_infos[i].getField("check_result").setRequired(true);
            }

        }

        function hideCreditMethod(){
            let plan_line_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_DETAIL_component_id']").attr("id");
            let plan_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_METHOD_component_id']").attr("id");
            $jq('#${/parameter/@layout_code}_T_METHOD_DETAIL_component_id').hide();//隐藏授信明细信息组件
            $jq('#${/parameter/@layout_code}_F_METHOD_component_id').hide();//隐藏授信信息组件
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).prev().hide();
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).next().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).prev().hide();
            jQuery(plan_component_id).hide();
            jQuery(plan_component_id).next().hide();
        }

        function hideOutLawInfo(){
            let plan_line_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_OUT_LAW_component_id']").attr("id");
            $jq('#${/parameter/@layout_code}_T_OUT_LAW_component_id').hide();//隐藏授信明细信息组件
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).prev().hide();
            jQuery(plan_line_component_id).hide();
            jQuery(plan_line_component_id).next().hide();
        }

        //业务准入审核
        function businessFieldSetting() {
            var ds_id_business = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'project_business_access_compare', 'G_BUSINESS_FAC');
            var record = $(ds_id_business).getAll()[0];
            record.getField('item_detail').setRequired(false);
            record.getField('item_detail').setReadOnly(true);
            record.getField('check_result').setRequired(false);
            record.getField('check_result').setReadOnly(true);
            record.getField('check_result_n').setRequired(false);
            record.getField('check_result_n').setReadOnly(true);
        }


        function hideConApproveTable(){
            let con_making_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_CON_MAKING_component_id']").attr("id");
            let con_making_grid_id = '#' + '${/parameter/@layout_code}_G_CON_MAKING_prj_project_attachment_layout_grid_id_wrap';
            jQuery(con_making_grid_id).hide();
            jQuery(con_making_component_id).hide();
            jQuery(con_making_component_id).prev().hide();
            jQuery(con_making_component_id).hide();
            jQuery(con_making_component_id).next().hide();
        }

        //隐藏合同文本、附件、授信明细新增删除按钮
        function unHideConContentGridBtn(){
            var con_attach_grid_div_id = 'PRJ616F1_G_CON_TEXT_prj_project_attachment_layout_grid_id_tb';
            var attach_grid_div_id = 'PRJ616F1_G_ATTA_INFO_prj_project_attachment_layout_grid_id_tb';
            var method_detail_grid_div_id = 'PRJ616F1_G_METHOD_DETAIL_hls_credit_plan_line_layout_grid_id_tb';
            processingGridByDivIdHide(con_attach_grid_div_id);
            processingGridByDivIdHide(attach_grid_div_id);
            processingGridByDivIdHide(method_detail_grid_div_id);
        }

        function hideBigExitButton() {
            // 获取特定 class 的 div
            const div = document.querySelector('.screenTopToolbar.clearfix');
            // 获取 div 下的所有 button
            const buttons = div.querySelectorAll('button');
            buttons.forEach(button => {
                if (button.textContent === '退出') {
                    button.style.display = 'none';
                }
            });
        }

        //隐藏保存按钮
        function hideBigSaveButton() {
            // 获取特定 class 的 div
            const div = document.querySelector('.screenTopToolbar.clearfix');
            // 获取 div 下的所有 button
            const buttons = div.querySelectorAll('button');
            buttons.forEach(button => {
                if (button.textContent === '保存') {
                    button.style.display = 'none';
                }
            });
        }

        function processingGridByDivIdHide(div_id) {
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为隐藏
            for (var i = 0; i < buttonsInDiv.length; i++) {
                buttonsInDiv[i].style.display = 'none';
            }
        }


        //合同文本grid按钮
        function processingConGridByDivId(div_id) {
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为显示
            for (var i = 0; i < buttonsInDiv.length; i++) {
                //展示新增按钮
                if (buttonsInDiv[i].textContent == '新增') {
                    buttonsInDiv[i].style.display = '';
                }
                //展示删除按钮
                if (buttonsInDiv[i].textContent == '删除') {
                    buttonsInDiv[i].style.display = '';
                }
            }
        }

        //附件信息grid按钮
        function processingAttGridByDivId(div_id) {
            var targetDiv = document.getElementById(div_id);
            // 获取该 div 下的所有 button 元素
            var buttonsInDiv = targetDiv.getElementsByTagName('button');
            // 遍历按钮并设置为显示
            for (var i = 0; i < buttonsInDiv.length; i++) {
                //展示新增按钮
                if (buttonsInDiv[i].textContent == '新增') {
                    buttonsInDiv[i].style.display = '';
                }
                //展示删除按钮
                if (buttonsInDiv[i].textContent == '删除') {
                    buttonsInDiv[i].style.display = '';
                }
                if (buttonsInDiv[i].textContent == '附件下载') {
                    buttonsInDiv[i].style.display = '';
                }
                if (buttonsInDiv[i].textContent == '导出') {
                    buttonsInDiv[i].style.display = '';
                }
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>