<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body{
                height:1200px;
                width:1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_approve_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify.lview"/>
        <a:link id="prj_project_wfl_approve_link_new_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify_new.lview"/>
        <a:link id="prj_project_wfl_approve_link_ol_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_operating_lease.lview"/>
        <script><![CDATA[
        var bussinessKey='${/parameter/@businessKey}';
        var list = parent.currentTaskInfo.execution_variables;
        var function_code;
        var lease_channel;
        var urlPart;
        var division;
        var work_flow;
        var manufacturerId = '';
        // var manufacturerId=list.filter(function(o){
        //     return o.name=="manufacturerId";
        // })[0].value;
        var nodeId = parent.currentTaskInfo.task_definition_key;
        debugger
        for (var i = 0; i < list.length; i++) {
            if (list[i].name === 'leaseChannel') {
                lease_channel = list[i].value;
            }
            if (list[i].name === 'manufacturerId') {
                manufacturerId = list[i].value;
            }
            if (list[i].name === 'DIVISION') {
                division = list[i].value;
            }
            if(list[i].name === 'WORK_FLOW'){
                work_flow = list[i].value;
            }
            //由于存量流程没有加division，先这么判断下
            if (!division && division !== 'undefined' && list[i].name === 'project') {
                var jsonObj = JSON.parse(list[i].value)
                division = jsonObj.division
            }
            if (!division && division !== 'undefined' && list[i].variable_name === 'project') {
                var jsonObj = JSON.parse(list[i].value)
                division = jsonObj.division
            }
        }






        var function_code = 'PRJ419F2';
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
            urlPart = $('prj_project_wfl_approve_link_new_id').getUrl();
        if(parent.currentTaskInfo.task_definition_key == "sid-rHAU6o6D-6QbN-4laU-89LQ-cSSMgkK3aMmb"  ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
        }
        var pageChooser = new PageChooser({
            url: urlPart +'?function_code=' + function_code  + '&division=' + division,
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: "${/parameter/@businessKey}",
                maintain_type: maintain_type,
                function_usage: function_usage,
                wfl_flag: 'Y',
                node_id:nodeId,
                work_flow:work_flow,
                manufacturer_id:manufacturerId,
                hidden_button_code: ['USER_BUTTON1', 'EXIT']
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <!--<a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>-->
    </a:view>
</a:screen>
    
    