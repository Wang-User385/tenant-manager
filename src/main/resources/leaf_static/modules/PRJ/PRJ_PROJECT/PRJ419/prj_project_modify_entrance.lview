        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project'),
                select_datas = $(ds_id).getSelected();
            debugger
            if(select_datas.length === 0){
                Leaf.showMessage('提示！', '至少选择一行!');
                return;
            }
            var ids = [];
            for(var i = 0; i < select_datas.length; i++){
                if(select_datas[i].data.project_status != 'APPROVED'){
                    Leaf.showMessage("提示","未审批通过不能进行经销商确认函打印!");
                    return;
                }
                ids.push(select_datas[i].get('project_id'));
            }
            // Leaf.request({
            //     url: $('prj_check_download_confirm_pdf_link_id').getUrl()+'?projectIdsStr='+ids.join(','),
            //     success: function (res) {
            //         window.location.href = '${/request/@context_path}/prj/download/confirm/pdf?attachmentIdStr='+res.result.record.join(',');
            //     },
            //     failure: function () {
            //         Leaf.Masker.unmask(document);
            //     },
            //     error: function () {
            //         Leaf.Masker.unmask(document);
            //     },
            //     scope: this
            // });
            Leaf.request({
                url: "${/request/@context_path}/prj/check/download/confirm/text",
                para: ids,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var down_url ='';
                    var attachment_ids = "";
                    for(var i = 0; i < res.result.record.length; i++){
                        if(i == 0){
                            attachment_ids = res.result.record[0].attachment_id;
                        }else{
                            attachment_ids = attachment_ids + ',' + res.result.record[i].attachment_id;
                        }
                    }
                    debugger
                    down_url = "${/request/@context_path}/fnd/attachment/download/zip?attachment_id=" + attachment_ids;
                    location.href = down_url;
                    Leaf.showMessage("提示", "生成成功!", null);

                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                scope: this
            });
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project'):
                    qpara['created_by'] = '${/session/@user_id}';
                    break;
            }
        };

        //风险引擎结果查看
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();
            if (records.length === 0) {
                Leaf.showMessage('${HLS.PROMPT}', '至少选择一条数据！');
                return;
            }
            var saveResultData = [];
            for (var i = 0; i < records.length; i++) {
                saveResultData.push(records[i].get('project_id'));
            }
            var param = {};
            param['records'] = saveResultData.join(',');
            param['url_title'] = '风险引擎结果查看';
            param['function_code'] = 'PRJ419F11';
            hls_doc_get_layout_code(param, 'PRJ419_project_risk_result_link_id', ds_id, 'PRJ419F11');
        };



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
