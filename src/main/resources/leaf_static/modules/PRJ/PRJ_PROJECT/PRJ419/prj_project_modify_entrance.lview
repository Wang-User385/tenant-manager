            param['function_code'] = 'PRJ419F7';
            param['winid'] = 'reply_verify_detail_win';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'PRJ419_reply_verify_detail_id', ds_id, 'PRJ419');
        }

