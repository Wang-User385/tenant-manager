        //创建项目
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var returnFlag=true;
            var employeeFlag=false;
            Leaf.request({
                url: '${/request/@context_path}/hls/defalut/para/query',
                success: function (res) {
                    debugger
                    if(res.result.record[0].unit_code=='MANAGEMENT_COMPANY'||res.result.record[0].unit_code=='LEADER_DEPT'||res.result.record[0].unit_code=='BUSINESS_DEPT_ONE'||res.result.record[0].unit_code=='BUSINESS_DEPT_FOUR'||res.result.record[0].unit_code=='BUSINESS_DEPT_THREE'||res.result.record[0].unit_code=='BUSINESS_DEPT_COMPREHENSIVE'){
                        employeeFlag=true;
                    }else{
                        if (res.result.record[0].ref_v02==null||res.result.record[0].ref_v02==''||res.result.record[0].ref_v02==undefined){
                            Leaf.showMessage('提示', '该用户未关联对应的主机厂/经销商/管理公司，不能进行进件创建');
                            returnFlag=false;
                        }
                    }
                },
                sync: true
            });
            if(!returnFlag){
                return false;
            }
            var param = {};
            param['url_title'] = '进件申请创建';
            param['function_code'] = 'PRJ419F1';
            // param['function_usage'] = 'CREATE';
            param['winid'] = 'project_create_winid';
            param['screen_width'] = '600';
            param['screen_height'] = '350';
            param['employeeFlag'] = employeeFlag;

            hls_doc_get_layout_code(param, 'PRJ419_project_create_id', "${/parameter/@layout_code}_G_PROJECT_RESULT_prj_project_ds", 'PRJ419');
        }
