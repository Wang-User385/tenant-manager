        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_project_result_ds = $(ds_id);
            var records = prj_project_result_ds.getSelected();
            var url;

            if (records.length == 0) {
                Leaf.showMessage('${HLS.PROMPT}', '至少选择一条数据！');
                return;
            }

            var result = [];
            var obj = {};
            for (var i = 0; i<records.length; i++) {
                if(!obj[records[i].data.lease_channel]){
                    result.push(records[i].data.lease_channel);
                    obj[records[i].data.lease_channel] = true;
                }
            }
            if (result.indexOf('40') !== -1) {
                if (result.indexOf('10') !== -1 || result.indexOf('20') !== -1) {
                    Leaf.showMessage('提示！', '经营租赁和融资租赁的进件不能同时提交!');
                    return;
                }
            }


            var saveData = [];
            for (var i = 0; i < records.length; i++) {
                var project_status = records[i].get('project_status');
                if (project_status != 'NEW'&&project_status != 'REJECTED'&&project_status != 'CANCEL'&&project_status!= 'APPROVED_RETURN') {
                    Leaf.showMessage('${HLS.PROMPT}', '编号为'+records[i].get('project_number')+'的单据状态有误，不可提交审批！');
                    return;
                }
                var lease_channel = records[i].get('lease_channel');
                saveData.push(records[i].get('project_id'));
            }

            if (lease_channel === '40') {
                url = '${/request/@context_path}/ol/project/wfl/submit';
            } else {
                url = '${/request/@context_path}/prj/batch/submit';
            }

            Leaf.Masker.mask(Ext.getBody(), '执行中。。')

            Leaf.request({
                url: url,
                para: {
                    projectIdList: saveData.join(','),
                    submitType : "batch"
                },
                success: function (res) {
                    if(res.error.message && res.error.message != ''){
                        $L.showInfoMessage("提示",res.error.message,null,1000,800);
                    }else {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                    }
                    $(ds_id).query();
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });


        };

        window['${/parameter/@layout_code}_user_button7_layout_dynamic_click'] = function() {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var datas = $(ds_id).getSelected();
            if(datas == null || datas.length == 0){
                $L.showInfoMessage("提示","请勾选要退回的数据!");
                return;
            }
            var manufacturer_code = datas[0].get('manufacturer_code');
            if(manufacturer_code != 'C000004453'){
                $L.showInfoMessage("提示","非三一单据请使用“退回”按钮进行单据退回操作!");
                return;
            }
            var lease_channel = datas[0].get('lease_channel');
            for(var i = 0; i < datas.length; i++){
                var data = datas[i].data;
                if(data.lease_channel !== lease_channel){
                    $L.showInfoMessage("提示","商业模式不同的数据不能一起退回!");
                    return;
                }
                if(data.project_status === 'APPROVING' || data.project_status === 'APPROVED'){
                    $L.showInfoMessage("提示", "编号为"+ data.project_number + "单据状态有误，不能进行合作方退回操作!");
                    return;
                }
            }
            sig001_view_model.returnDatas = datas;
            var returnWin = new Leaf.Window({
                id: 'sig001f2_project_partners_return_open_winid',
                params: {
                    winid: 'sig001f2_project_partners_return_open_winid',
                    lease_channel: lease_channel,
                    parent_function_code : 'PRJ419',
                    return_stage : 'PROJECT'
                },
                    url: '${/request/@context_path}/modules/SIG/SIG_PROJECT/SIG001F2/project_partners_reject.lview',
                title: '合作方退回',
                width: 630,
                height: 360
            });
            returnWin.on('close',function(){
                $(ds_id).query();
            });

        };

        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function() {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var datas = $(ds_id).getSelected();
            if(datas == null || datas.length == 0){
                $L.showInfoMessage("提示","请勾选要退回的数据!");
                return;
            }
            var manufacturer_code = datas[0].get('manufacturer_code');
            if(manufacturer_code == 'C000004453'){
                $L.showInfoMessage("提示","不可对三一单据在此页面进行退回操作!");
                return;
            }
            var lease_channel = '10';
            for(var i = 0; i < datas.length; i++){
                var data = datas[i].data;
                // if(data.lease_channel !== lease_channel){
                //     $L.showInfoMessage("提示","商业模式不同的数据不能一起退回!");
                //     return;
                // }
                if(data.project_status === 'APPROVING' || data.project_status === 'APPROVED'){
                    $L.showInfoMessage("提示", "编号为"+ data.project_number + "单据状态有误，不能进行退回操作!");
                    return;
                }
            }
            sig001_view_model.returnDatas = datas;
            var returnWin = new Leaf.Window({
                id: 'sig001f2_project_return_open_winid',
                params: {
                    winid: 'sig001f2_project_return_open_winid',
                    lease_channel: lease_channel,
