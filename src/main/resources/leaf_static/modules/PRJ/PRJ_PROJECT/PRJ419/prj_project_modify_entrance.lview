        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            if (name == 'approve_info') {
                return '<a href="javascript:open_project_approve_history_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#68798a">审批明细查看</span></a>';
            }
            // if (name == 'rejected_description'){
            //     return '<a href="javascript:open_project_reject_description_win(\'' + record.ds.id + '\',\'' + record.id + '\')">退回理由</a>';
            // }
            // if (name == 'result_message'){
            //     return '<a href="javascript:open_reply_verify_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">规则返回明细</a>';
            // }
            return value;
        };

