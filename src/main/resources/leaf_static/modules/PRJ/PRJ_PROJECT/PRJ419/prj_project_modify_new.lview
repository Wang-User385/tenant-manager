<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <!--        <script type="text/javascript" src="${/request/@context_path}/javascripts/calculateNull.js"></script>-->
        <a:link id="prj306_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="PRJ419_open_insurance_information_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419F5/lease_item_insurance.lview"/>
        <a:link id="PRJ419_open_invoice_information_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419F6/lease_item_invoice.lview"/>
        <a:link id="PRJ419f3_project_doc_winid_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419F3/prj_project_doc_create.lview"/>
        <a:link id="PRJ419f2_prj_wfl_submit_link_id" url="${/request/@context_path}/prj/project/new/wfl/submit"/>
        <a:link id="prj318f1_prj_manufacturer_confirm_link_id" url="${/request/@context_path}/prj/manufacturer/confirm"/>
        <a:link id="PRJ419f2_prj_bp_create_link_id" url="${/request/@context_path}/prj/project/bp/create"/>
        <a:link id="PRJ419f2_prj_factory_link_id" url="${/request/@context_path}/hls/bp/master/factory/reply/query"/>
        <a:link id="PRJ419f2_prj_lease_item_amount_link_id"
                url="${/request/@context_path}/prj/project/lease/item/amount/query"/>
        <a:link id="PRJ419f2_prj_lease_item_check_id"
                url="${/request/@context_path}/prj/project/lease/item/check"/>
        <a:link id="PRJ419f2_prj_get_quotation_number_link_id"
                url="${/request/@context_path}/prj/create/quotation/number"/>
        <a:link id="PRJ419_calculate_quotation_link_id" url="${/request/@context_path}/quotaion/auto/calc"/>
        <a:link id="retry_generate_docx_link_id" url="${/request/@context_path}/prj/retry/generate/docx"/>
        <a:link id="PRJ419f2_prj_get_divison_id"
                url="${/request/@context_path}/prj/project/get/division"/>
        <a:link id="PRJ419f2_prj_get_manufacturer_code"
                url="${/request/@context_path}/prj/project/get/manufacturerCode"/>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <a:link id="lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <script><![CDATA[

        /*定义全局对象变量*/
        var PRJ419f2_viewModel = {
            productList: [],
            function_usage: '${/parameter/@function_usage}',
            reply_id: 0,
            lease_item_amount: 0
        };
        var	contextPath = '${/request/@context_path}';
        var license_length_flag = true;
        var special_char_valid = true;
        let currentDivision = '${/parameter/@division}'
        var manufacturerCode = '${/parameter/@manufacturer_code}'
        var manufacturer_id='${/parameter/@manufacturer_id}'
        let project_date='${/parameter/@project_date}';
        let project_id='${/parameter/@project_id}';
        var parent_layout_code = '${/parameter/@parent_layout_code}';
        var ref_v02='${/parameter/@ref_v02}';
        var finance_amount=0;
        '${/parameter/@lease_channel}' == '10'

        $L.onReady(function () {
            debugger
            getDivision();
            getManufacturerCode();
            var function_usage = '${/parameter/@function_usage}';
            var wfl_flag = '${/parameter/@wfl_flag}';
            var submit_hide = '${/parameter/@submit_hide}';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var lease_item_ds= get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_lease_item');
            var record = $(ds_id);
            var lease_item_record = $(lease_item_ds);
            /*if(wfl_flag == 'Y'){
                $(ds_id).getCurrentRecord().getField("project_number_replace").setReadOnly(true);
                $(ds_id).getCurrentRecord().getField("project_number_replace_n").setReadOnly(true);
            }
            if(manufacturerCode && manufacturerCode !== 'C000030601' ){
                if(record.getField('partners_contract_number')){
                    record.getField('partners_contract_number').setReadOnly(true);
                }
                if(record.getField('partners_payment_number')){
                    record.getField('partners_payment_number').setReadOnly(true);
                }
            }*/
            //三一进件整机编号允许为空
            /*if (manufacturerCode && manufacturerCode == 'C000004453') {
                lease_item_record.getField('serial_number').setRequired(false);
            }*/

            //根据业务线隐藏租赁物
            hideGird();
            debugger
            if("DEALER"==ref_v02){
                //承租人授信额度grid_id
                let quta_grid_id = '#' + '${/parameter/@layout_code}_F_QUTA_component_id'
                //承租人授信额度导航栏ID
                let quta_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_QUTA_component_id']").attr("id");
                //隐藏承租人授信额度
                jQuery(quta_grid_id).hide();
                jQuery(quta_component_id).hide();
                jQuery(quta_component_id).prev().hide();
                jQuery(quta_component_id).hide();
                jQuery(quta_component_id).next().hide();
            }
            if (function_usage === 'QUERY' && (currentDivision === 'Vehicle_Leasing' )&&(currentDivision === 'COMMERCIAL_VEHICLE' )&& parent_layout_code === 'PRJ419') {
                jQuery('#${/parameter/@layout_code}_save').hide();
                jQuery('#${/parameter/@layout_code}_user_button1').hide();
                jQuery(".navigationBarContent").css("margin-left", "130px");
            } else if (function_usage === 'QUERY' && currentDivision === 'Construction_machinery' && parent_layout_code === 'PRJ419') {
                jQuery('#${/parameter/@layout_code}_save').hide();
                if (submit_hide) {
                    jQuery('#${/parameter/@layout_code}_user_button1').hide();
                }
                jQuery(".navigationBarContent").css("margin-left", "130px");
            }
            if (function_usage === 'QUERY' && parent_layout_code === 'PRJ317' && currentDivision === 'PHOTOVOLTAIC_DEVICES') {
                //隐藏天合附件按钮
                jQuery('#${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_ADD_layout_dynamic_button_id').hide();
                jQuery('#${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_DELETE_layout_dynamic_button_id').hide();
                jQuery('#${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_SAVE_layout_dynamic_button_id').hide();
            }
            if (wfl_flag == 'Y') {
                jQuery('#${/parameter/@layout_code}_project_doc').hide();
                jQuery(".navigationBarId").hide();
                jQuery(".navigationBarContent").css("margin-left", "0px");
            }

            //新增时带出创建页面的承租人
            if ('${/parameter/@function_usage}' == 'CREATE') {
                debugger
                var tenant_ds_id = '${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds';
                var record = new Leaf.Record({
                    'bp_id': '${/parameter/@bp_id}',
                    'bp_id_n': '${/parameter/@bp_id_n}',
                    'tenant_name': '${/parameter/@bp_id_n}',
                    'bp_categroy': 'TENANT',
                    'bp_categroy_n': '${/parameter/@bp_categroy_n}',
                    'bp_class': '${/parameter/@bp_class}',
                    'bp_class_n': '${/parameter/@bp_class_n}',
                    'bp_type': 'TENANT',
                    'bp_type_n': '${/parameter/@bp_type_n}'
                });
                $(tenant_ds_id).add(record);
            }
            //查询额度信息
            if('${/parameter/@function_usage}' != 'CREATE' && '${/parameter/@function_code}' != 'PRJ318F1'){
                debugger
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                qureyAmount();
            }
        });

        function qureyAmount() {
            var record = $('${/parameter/@layout_code}_F_QUTA__ds').getCurrentRecord();
            Leaf.request({
                url: '${/request/@context_path}/prj/manufacturer/query/amount?projectId='+project_id,
                success: function (res) {
                    record.set('credit_amt',res.result.record[0].creditAmt);
                    record.set('tenant_amount',res.result.record[0].tenantAmount);
                    record.set('release_amount',res.result.record[0].releaseAmount);
                    record.set('surplus_amount',res.result.record[0].creditAmt - res.result.record[0].surplusAmount);
                    record.set('current_margin',res.result.record[0].currentMargin);
                    record.set('remaining_invested',res.result.record[0].remainingInvested);
                    record.set('deposit_already_invested',res.result.record[0].depositAlreadyInvested);

                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function getDivision() {
            currentDivision = '${/parameter/@division}'
            let contractNumber;
            if (!currentDivision) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('PRJ419f2_prj_get_divison_id').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber,projectId:'${/parameter/@project_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            currentDivision = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        function getManufacturerCode() {
            manufacturerCode = '${/parameter/@manufacturer_code}'
            let contractNumber;
            if (!manufacturerCode) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('PRJ419f2_prj_get_manufacturer_code').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber,projectId:'${/parameter/@project_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            manufacturerCode = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            debugger;
            if (name == 'bp_info_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#0000FF">客户明细信息</span></a>';
            } else if (name == 'bp_supplier_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#0000FF">查看供应商</span></a>';
            } else if (name == 'bp_security_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:#0000FF">查看担保人</span></a>';
            }else if(name == 'vehicle_info_link' && !record.isNew){
                link_function = 'lease_item_details';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');"><span style="color:#0000FF">详情</span></a>';
            } else if (name == 'quote' && !record.isNew) {
                if (PRJ419f2_viewModel.function_usage == 'QUERY') {
                    return '<a href="javascript:quotation_calc_detail_adjust(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\')"><span style="    width: 82px;\n' +
                        '    background-color: #4CAF50;\n' +
                        '    border: none;\n' +
                        '    color: white;\n' +
                        '    padding: 1px 33px;\n' +
                        '    text-align: center;\n' +
                        '    text-decoration: none;\n' +
                        '    display: inline-block;\n' +
                        '    font-size: 13px;\n' +
                        '    margin: 0px 0px;\n' +
                        '    cursor: pointer;\n' +
                        '    border-radius: 8px;\n' +
                        '    transition: background-color 0.3s;">报价详情</span></a>';
                }
            }
            else if (name == 'file_names' && record.isNew) {
                return null;
            }
            else if (name == 'file_names' && !record.isNew) {

                var table_name = record.get("project_attachment_category");
                var th_back_flag = record.get("th_back_flag");
                var document_name  = record.get("document_name");
                if (record.get('file_num') > 0) {
                    return '<a href="javascript:PRJ419_open_attach(\'' + record.get('project_attachment_id') + '\',\''+'PRJ_PROJECT_ATTACHMENT' + '\',\''+ document_name +'\',\''+ th_back_flag +'\')">附件' + '(' +record.get("file_num") + ')' + '</a>';
                } else {
                    return '<a href="javascript:PRJ419_open_attach(\'' + record.get('project_attachment_id') + '\',\''+'PRJ_PROJECT_ATTACHMENT' + '\',\''+ document_name +'\',\''+ th_back_flag +'\')">附件</a>';
                }
            }
            else if (name == 'insurance_information' && !record.isNew) {
                return '<a style="color: red;" href="javascript:PRJ419_open_insurance_information(\'' + record.ds.id + '\',\'' + record.id + '\')">保险信息</a>';
            }
            else if (name == 'bill_information' && !record.isNew) {
                return '<a style="color: red;" href="javascript:PRJ419_open_invoice_information(\'' + record.ds.id + '\',\'' + record.id + '\')">' + config_record.get('prompt') + '</a>';
            }
            else if (name == 'calculate' && !record.isNew) {
                if (PRJ419f2_viewModel.function_usage != 'QUERY' && '${/parameter/@lease_channel}'!= '20' && '${/parameter/@function_code}'!= 'PRJ318F1') {
                    return '<a style="color: red;" href="javascript:PRJ419_calculate_quotation(\'' + record.ds.id + '\',\'' + record.id + '\')">计算</a>';
                } else {
                    return '计算成功';
                }
            }

            return value;
        };


        //附件
        var win;

        function PRJ419_open_attach(project_attachment_id, table_name,document_name,th_back_flag) {
            debugger;
            var url;
            var function_usage = '${/parameter/@function_usage}';
            var parent_layout_code = '${/parameter/@parent_layout_code}';
            var submit_hide = '${/parameter/@submit_hide}';
            var work_flow = '${/parameter/@work_flow}';
            var node_id = '${/parameter/@node_id}';
            if (function_usage === 'QUERY'&&('${/parameter/@sign_status}'!='REJECTED'&&'${/parameter/@sign_status}'!='NEW')) {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            // url = '${/request/@context_path}/uploadFile.lview';aaa
            // if(document_name == '审查文件'){
            //     url = '${/request/@context_path}/downloadFile.lview';
            //     function_usage = 'QUERY';
            // }
            //厂商风险审查流程,投放审查流程 ，风险审查岗位，资管部负责人,投放审查岗，租后管理岗节点可以上传下载附件“审查文件”
            // if(document_name == '审查文件' && (node_id  == 'sid-NADqOrSA-McJQ-4fHc-8uYZ-BKWVs7HBI46d'  || node_id == 'sid-jN5Ah6L5-KH8s-42iD-88b0-RquXNoZVcvvN'||
            //     node_id == 'sid-QEd1QUWf-46Bo-4RUr-8G0I-bH5cZ9VKnVKo' ) ){
            //     url = '${/request/@context_path}/uploadFile.lview';
            //     function_usage = '${/parameter/@function_usage}';
            // }
            win = new Leaf.Window({
                id: 'PRJ419_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    header_id: project_attachment_id,
                    table_name: table_name,
                    winid: 'PRJ419_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                debugger
                var ds_id;
                if (currentDivision === 'PHOTOVOLTAIC_DEVICES' || manufacturerCode == 'C000004453') {
                    ds_id = "${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds";
                } else {
                    ds_id = "${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds";
                }
                $(ds_id).query();
                if(parent_layout_code=='PRJ329'){
                    record.getField('document_name').setReadOnly(false);
                    record.getField('description').setReadOnly(false);
                }
            });
        }

        //根据业务线隐藏租赁物、报价方案
        function hideGird() {
            debugger
            //商用车租赁物信息grid_id
            let vehicle_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_layout_grid_id_wrap'
            //工程机械租赁物信息grid_id
            let machine_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_layout_grid_id_wrap'
            //租赁物信息_光伏设备grid_id
            let photovoltaic_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_layout_grid_id_wrap'
            //附件
            let attachment_grid_id = '#' + '${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_layout_grid_id_wrap'
            //天合附件grid_id
            let th_attachment_grid_id = '#' + '${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_layout_grid_id_wrap'
            //报价方案
            //let quotation_ds_id = '${/parameter/@layout_code}_G_QUOTATION_prj_quotation_layout_grid_id'
            //租赁物信息_光伏设备
            let lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_layout_grid_id'

            //工程机械导航栏ID
            let machine_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_MACHINE_component_id']").attr("id")
            //商用车导航栏ID
            let vehicle_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_VEHICLE_component_id']").attr("id")
            //光伏设备导航栏ID
            let photovoltaic_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_PHOTOVOLTAIC_component_id']").attr("id")
            //附件
            let attachment_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_CC_PRJ_BASIC_INFO_component_id']").attr("id")
            //天合附件
            let th_attachment_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_TH_PRJ_BASIC_INFO_component_id']").attr("id")

            //隐藏左侧导航栏
            if (currentDivision === 'Vehicle_Leasing' || currentDivision === 'COMMERCIAL_VEHICLE') {//商用车
                //隐藏租赁物_工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).prev().hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).next().hide();
                //隐藏租赁物_光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).prev().hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).next().hide();
                //隐藏天合附件
                //jQuery(th_attachment_grid_id).hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).prev().hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).next().hide();
            }else if (currentDivision === 'Construction_machinery' || currentDivision === 'ENGINEERING_MACHINERY'){ //工程机械
                //隐藏商用车
                //jQuery(vehicle_grid_id).hide();
                //jQuery(vehicle_component_id).hide();
                //jQuery(vehicle_component_id).prev().hide();
                //jQuery(vehicle_component_id).hide();
                //jQuery(vehicle_component_id).next().hide();
                //隐藏租赁物_光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).prev().hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).next().hide();

                //三一厂商
                if (manufacturerCode == 'C000004453'){
                    //隐藏附件
                    //jQuery(attachment_grid_id).hide();
                    //jQuery(attachment_component_id).hide();
                    //jQuery(attachment_component_id).prev().hide();
                    //jQuery(attachment_component_id).hide();
                    //jQuery(attachment_component_id).next().hide();
                }else {
                    //隐藏天合附件
                    //jQuery(th_attachment_grid_id).hide();
                    jQuery(th_attachment_component_id).hide();
                    jQuery(th_attachment_component_id).prev().hide();
                    jQuery(th_attachment_component_id).hide();
                    jQuery(th_attachment_component_id).next().hide();
                }
            }else { //光伏
                //隐藏商用车
                //jQuery(vehicle_grid_id).hide();
                //jQuery(vehicle_component_id).hide();
                //jQuery(vehicle_component_id).prev().hide();
                //jQuery(vehicle_component_id).hide();
                //jQuery(vehicle_component_id).next().hide();
                //隐藏租赁物_工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).prev().hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).next().hide();
                //隐藏附件
                //jQuery(attachment_grid_id).hide();
                //jQuery(attachment_component_id).hide();
                //jQuery(attachment_component_id).prev().hide();
                //jQuery(attachment_component_id).hide();
                //jQuery(attachment_component_id).next().hide();
            }
            //非天合光伏业务线, 报价方案隐藏 装机量、单价、每期租金
            if (currentDivision !== 'PHOTOVOLTAIC_DEVICES') {
                /*$(quotation_ds_id).hideColumn('installed_capacity');
                $(quotation_ds_id).hideColumn('unit_price');
                $(quotation_ds_id).hideColumn('each_rental');*/
            } else {
                // debugger
                //厂商非碳银
                /*if (manufacturerCode !== 'C000032182') {
                    //租赁物隐藏组件生产商
                    $(lease_item_ds_id).hideColumn('module_producer');
                } else {
                    //碳银厂商报价方案隐藏每期租金
                    $(quotation_ds_id).hideColumn('each_rental');
                }*/
            }
        }
        function lease_item_details(record_id, ds_id ) {
            debugger;
            var param = $(ds_id).findById(record_id).data;
            /*var project_lease_item_id =  param['project_lease_item_id'];
