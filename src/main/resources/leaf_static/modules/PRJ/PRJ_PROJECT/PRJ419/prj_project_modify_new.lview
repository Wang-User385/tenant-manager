            if (currentDivision === 'Vehicle_Leasing' || currentDivision === 'COMMERCIAL_VEHICLE') { //商用车
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds'
            } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') { //光伏设备
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds'
            } else { //工程机械
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds'
            }

            // //对车架号或者整机编号进行校验
            // if ($(lease_item_ds_id) && $(lease_item_ds_id).data) {
            //     let itemNumberArr = []
            //     var headInfoDs = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds');
            //     let project_number = headInfoDs.data[0].get('project_number')
            //     for (let i = 0; i < $(lease_item_ds_id).data.length; i++) {
            //         let itemNumber;
            //         let checkFlag = '';
            //
            //         if (currentDivision === 'COMMERCIAL_VEHICLE') {
            //             itemNumber = $(lease_item_ds_id).data[i].get('frame_number')
            //             if (itemNumber && itemNumber.length > 0 && itemNumber.length !== 17) {
            //                 Leaf.showMessage('${l:PROMPT_MESSAGE}','车架号长度应为17位!')
            //                 window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //                 return false
            //             }
            //             checkFlag = checkItemNumber(itemNumber, 'COMMERCIAL_VEHICLE','null')
            //         } else {
            //             itemNumber = $(lease_item_ds_id).data[i].get('serial_number')
            //             let classifyId = $(lease_item_ds_id).data[i].get('classify_id')
            //             checkFlag = checkItemNumber(itemNumber, currentDivision,classifyId)
            //             itemNumber = itemNumber + '-.-' + classifyId;
            //         }
            //         if(itemNumber){
            //             if(itemNumberArr.indexOf(itemNumber) === -1){
            //                 itemNumberArr.push(itemNumber)
            //             }else{
            //                 checkFlag = project_number
            //             }
            //         }
            //         if (checkFlag && currentDivision !== 'PHOTOVOLTAIC_DEVICES') {
            //             window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //             if(itemNumber.indexOf('-.-') > 0){
            //                 itemNumber = itemNumber.substr(0,itemNumber.indexOf('-.-'));
            //             }
            //             Leaf.showMessage('${l:PROMPT_MESSAGE}','与' + checkFlag + '合同车架号/(规格型号+整机编号)重复<br>重复号码：'+ itemNumber +'。',null,600,800);
            //             return false;
            //         }
            //     }
            // }


            setPrice();
            debugger
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quotation_ds).getAll();
            var check_flag = true;
            if (quotation_record.length>0) {
                if (quotation_record[0].dirty) {
                    $("${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds").on("submitsuccess", calcQuotation);
                }
            }

            debugger
            //保存承租人备注
            var tenant_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp','G_TENANT_BASIC_INFO');
            var tenant_record = $(tenant_ds).getCurrentRecord();
            //if(tenant_record.data.description&&'${/parameter/@function_usage}' != 'CREATE'){
                saveDescription(tenant_record);
            //}


            //校验融资额与租赁物总价款
            var records = $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').getNewRecords();
            for (var i = 0; i < records.length; i++) {
                if (records[i].get('finance_amount') > records[i].get('lease_item_amount')) {
                    $L.showInfoMessage("提示", "融资额不能高于租赁物总价款!", null);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }

            var document_category = "PRJ_PROJECT";
            var document_type = record.get('document_type');
            var business_type = record.get('business_type');
            var division = record.get('division');
            var employee_code = record.get('employee_code');
            var factory_id = record.get('factory_id');
            var manufacturer_id = record.get('manufacturer_id');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var partners_contract_number = $(ds_id).getCurrentRecord().get('partners_contract_number');
            var partners_payment_number = $(ds_id).getCurrentRecord().get('partners_payment_number');
            debugger
            if(partners_contract_number!=undefined||partners_payment_number!=undefined){
                //处理进件序号及支付表编号中的空格
