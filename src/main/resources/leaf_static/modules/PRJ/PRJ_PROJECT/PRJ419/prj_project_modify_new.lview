        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            debugger
            //disableDs()
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow');
            if('${/parameter/@function_code}' == 'PRJ318F1' && ds_id == ds.id){
                $(ds_id).setQueryParameter('templet_type', 'PROJECT_SIGN');
            }else if(ds.id == cashflow_ds_id && '${/parameter/@function_code}' == 'PRJ419F2'){
                $(cashflow_ds_id).setQueryParameter('user_id', '${/session/@user_id}');
            }
            if(ds.id=='${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds'){
                var tenant_ds_id = '${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds';
                var tenant_ds_record=$(tenant_ds_id).getCurrentRecord();
                if(tenant_ds_record){
                    qpara['prj_bp_id']= tenant_ds_record.data.prj_bp_id;
                }
            }
