                    url: '${/request/@context_path}/project/partners_number/check',
                    para: {
                        partners_contract_number:partners_contract_number,
                        partners_payment_number:partners_payment_number
                    },
                    success: function (res) {
                        if(res.result.record[0].partners_contract_number != 'null') {
                            $(ds_id).getCurrentRecord().set('partners_contract_number', res.result.record[0].partners_contract_number);
                        }
                        if(res.result.record[0].partners_payment_number != 'null') {
                            $(ds_id).getCurrentRecord().set('partners_payment_number', res.result.record[0].partners_payment_number);}

                    },
                    failure: function () {
                    },
                    error: function () {
                    },
                    sync: true,
                    scope: this

                });
            }



            /*for (i = 0; i < quotation_record.length - 1; i++) {
                if (quotation_record[i].data.contract_seq == quotation_record[i + 1].data.contract_seq) {
                    Leaf.showMessage('提示', '序号不能相同，请重输');
                    return false;
                }
            }*/
            if (record.get('project_number')) {
                return true;
            }

            //设置权限字符串
            // window['${/parameter/@layout_code}_set_authority_rule_string'](document_type, business_type, division, employee_code);
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var requestUrl = '${/request/@context_path}/project/common/coding/getCodeValue';
            requestUrl = requestUrl + "?documentCategory=" + document_category;
            requestUrl = requestUrl + "&documentType=" + document_type;
            requestUrl = requestUrl + "&businessType=" + business_type;
            requestUrl = requestUrl + "&employeeCode=" + employee_code;
            requestUrl = requestUrl + "&manufacturerId=" + manufacturer_id;
            if ($(ds_id).getCurrentRecord().get('lease_channel') == '10') {
                requestUrl = requestUrl + "&factoryId=" + factory_id;
            }
            Leaf.request({
                url: requestUrl,
                success: function (res) {
                    $(ds_id).getCurrentRecord().set('project_number', res.result.record[0]);
                    $(ds_id).getCurrentRecord().set('contract_text_status',"UNCREATED");
                    check_flag = true;
                },
                error: function (res) {
                    $L.showInfoMessage("提示", "编号生成失败，请联系管理员!");
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    $L.showInfoMessage("提示", "编号生成失败，请联系管理员!");
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });
            //清空用于展示de bp承租人信息
            //var tenant_ds_id = '${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds';
            //$(tenant_ds_id).removeAll();
            return check_flag;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            disableDs()
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var projectNumberReplace = $(ds_id).getCurrentRecord().get('project_number_replace');
            var project_id = $(ds_id).getCurrentRecord().get('project_id');
            debugger
            var headInfoDs = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds');
            headInfoDs.setQueryParameter('project_id', project_id);
            headInfoDs.query();
            var quta_record = $('${/parameter/@layout_code}_F_QUTA__ds').getCurrentRecord();
            if(projectNumberReplace && projectNumberReplace !== "" && project_id && project_id !== ""){
                //如果有进件编号（替换）,就把这个值更新到字段上
                Leaf.request({
                    url: '${/request/@context_path}/document/number/replace/replace',
                    para: {
                        project_id:project_id,
                        project_number:projectNumberReplace
                    },
                    success: function (res) {
                        setTimeout(function() {
                            var headInfoDs = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds');
                            headInfoDs.setQueryParameter('project_id', project_id);
                            debugger
                            headInfoDs.query();
                            debugger
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }, 1000);
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
            if(!quta_record.get('credit_amt')){
                qureyAmount()
            }
            debugger
            //保存承租人备注
            var tenant_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp','G_TENANT_BASIC_INFO');
            var tenant_record = $(tenant_ds).getCurrentRecord();
            if(tenant_record.data.description&&'${/parameter/@function_usage}' == 'CREATE'){
                saveDescription(tenant_record);
            }

            // if(project_id != null){
            //     window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //     Leaf.request({
            //         url: '${/request/@context_path}/prj/generate/project/sign/attach',
            //         para: {
            //             project_id:project_id
            //         },
            //         success: function (res) {
            //             $('${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds').query();
            //             window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         },
            //         failure: function () {
            //             window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         },
            //         error: function () {
            //             window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         },
            //         scope: this
            //     });
            // }

            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

            $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
            debugger
            $('${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds').query();

            if (currentDivision === 'Vehicle_Leasing' || currentDivision === 'COMMERCIAL_VEHICLE') { //商用车
                $('${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds').query();
            }else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') { //光伏设备
                $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds').query();
            }else { //工程机械
                $('${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds').query();
            }
        };

        //提交审批
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            if ('${/parameter/@function_code}' == 'PRJ419F3') {
                return $L.showInfoMessage("提示", "抱歉，该功能只允许查看", null);
            }
            debugger
            if('${/parameter/@lease_channel}' == '10'){
                var prjProjectBpRecord = $('${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds').getAt(0);
                if (typeof prjProjectBpRecord == "undefined") {
                    $L.showInfoMessage("提示", "必须添加承租人!", null);
                    // $L.Masker.unmask(document.body);
                    return;
                }
                var division = $("${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds").getCurrentRecord().get("division");
                var quotationTypeNflag = false;
                var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                var record_quotation;
                var project_id = $("${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds").getCurrentRecord().get("project_id");
                if ($(quotation_ds).data.length) {
                    jQuery.each($(quotation_ds).data, function (i, v) {
                        if (v.isNew || v.dirty) {
                            quotationTypeNflag = true;
                        }
                    });
                    if (quotationTypeNflag) {
                        quotationTypeNflag = false;
                        $L.showMessage('提示', '请保存报价信息!');
                        // $L.Masker.unmask(document.body);
                        return;
                    }
                    jQuery.each($(quotation_ds).data, function (i, v) {
                        if (v.data.quotation_count === 0) {
                            quotationTypeNflag = true;
                        }
                    });
                    if (quotationTypeNflag) {
                        quotationTypeNflag = false;
                        $L.showMessage('提示', '存在报价方案未维护，请先维护!');
                        // $L.Masker.unmask(document.body);
                        return;
                    }
                } else if (project_id == null) {
                    $L.showMessage('提示', '请先保存!');
                    // $L.Masker.unmask(document.body);
                    return;
                }

                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var payment_bp_id = $(ds_id).getCurrentRecord().get('payment_bp_id');
                if(!payment_bp_id || payment_bp_id == ''){
                    $L.showMessage('提示', '付款对象为空，请核对相应产品信息!');
                    // $L.Masker.unmask(document.body);
                    return;
                }
            }


            var obj = window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'];
            if (!obj.approve) {
                obj.approve = function () {
                    //先执行保存操作,保存成功后提交数据
                    // 增加是否确认提示
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        // $L.Masker.mask(document.body, "正在提交数据,请稍等..");
                        if (!$('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds').validate()) {
                            // $L.Masker.unmask(document.body);
                            return;
                        }
                        window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                            var parentRecord = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds').getAt(0);
                            var datas = {projectId: parentRecord.get("project_id")};
                            Leaf.request({
                                url: $('PRJ419f2_prj_wfl_submit_link_id').getUrl(),
                                para: datas,
                                success: function (res) {
                                    // $L.Masker.unmask(document.body);
                                    Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '进件提交成功', function () {
                                        if ('${/parameter/@winid}') {
                                            $('${/parameter/@winid}').close();
                                        } else {
                                            location.href = '${/request/@context_path}/user_role_home_page.lview';
                                            parent.shMenu('show');
                                        }
                                    });
                                    //$L.showInfoMessage("提示", "项目提交成功,已进入工作流审批!", null);
                                },
                                error: function () {
                                    // $L.Masker.unmask(document.body);
                                },
                                scope: this
                            });
                        });
                    }, function cancel() {
                        // $L.Masker.unmask(document.body);
                    }, 200, 100);
                }
            }

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](obj.approve);
        };
        // window['${/parameter/@layout_code}_set_authority_rule_string'] = function (document_type, business_type, division, employee_code) {
        //     debugger
        //     Leaf.request({
