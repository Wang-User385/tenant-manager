        function disableDs() {
            try{
                if (currentDivision === 'Vehicle_Leasing' || currentDivision === 'COMMERCIAL_VEHICLE') { //商用车
                    //删除工程机械ds
                    // $('${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds').fields = {}
                    // $('${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds').removeAll
                    // //删除光伏
                    // $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds').fields = {}
                    // $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds').removeAll
                    // //删除天合附件
                    // $('${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds').fields = {}
                    // $('${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds').removeAll
                } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') { //光伏设备
                    //删除工程机械ds
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds').removeAll
                    //删除商用车ds
                    //$('${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds').fields = {}
                    //$('${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds').removeAll
                    //删除附件
                    //$('${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds').fields = {}
                    //$('${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds').removeAll
                } else { //工程机械
                    //删除商用车
                    //$('${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds').fields = {}
                    //$('${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds').removeAll
                    //删除光伏
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds').removeAll
                    //三一厂商
                    if (manufacturerCode == 'C000004453'){
                        //删除附件
                        //$('${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds').fields = {}
                        //$('${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds').removeAll
                    }else {
                        //删除天合附件
                        $('${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds').fields = {}
                        $('${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds').removeAll
                    }
                }
            }catch (e) {
                console.log(e)
            }
        }
