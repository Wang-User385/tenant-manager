        function isAdvancedEquipment(record){
            debugger
            Leaf.request({
                url: '${/request/@context_path}/prj/manufacturer/query/isAdvancedEquipment',
                para: {
                    classify_id:record.get('classify_id'),
                    manufacturer_id:record.get('manufacturer_id')
                },
                scope: this,
                success: function (res) {
                    debugger
                    for(var i=0;i<res.result.record.length;i++){
                        if(res.result.record[i].classify_id==record.get('classify_id')){
                            record.set('advanced_equipment_flag',res.result.record[i].advanced_equipment_flag)
                            if(res.result.record[i].advanced_equipment_flag=="Y"){
                                record.set('advanced_equipment_flag_n','是')
                            }else{
                                record.set('advanced_equipment_flag_n','否')
                            }
                        }
                    }
                }
            });
        }

