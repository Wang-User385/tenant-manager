        function quotation_calc_detail_adjust(dsId,record_id,quotation_id) {
            //debugger;
            var price_list = $(dsId).findById(record_id).get("price_list");
            if(quotation_id == 'undefined' || quotation_id == null || quotation_id == ''){
                Leaf.showInfoMessage("提示" , "请先进行调息计算");
                return ;
            }

            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId='+quotation_id + '&priceList=' + price_list  + '&readOnly=Y' ;
            var win = new Leaf.Window({
                id: 'hls901_open_price_winid',
                url: url,
                title: '项目报价',
                fullScreen: true
            });

        }
        //报价
        function PRJ419_open_price(dsId, record_id, quotationId) {
            debugger
            if ($(dsId).validate()) {
                if (quotationId != 'undefined') {
                    debugger
                    PRJ419_calculate_quotation(dsId,record_id);
                    //打开报价窗口
                    var price_list = $(dsId).findById(record_id).get("price_list");
                    var url = '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/prj_project_fin_contract_calculate.lview?quotationId=' + quotationId + "&priceList=" + price_list;
                    if ('${/parameter/@maintain_type}' === 'READONLY' || '${/parameter/@lease_channel}' == '20') {
                        url = url + '&readOnly=Y';
                    }
                    var win = new Leaf.Window({
                        id: 'PRJ419_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                        var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow');
                        $(ds_id).query();
                        $(cashflow_ds_id).query();
                    });
                } else {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
        }

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '商业伙伴信息';
            if (param['bp_class'] == 'ORG') {
                if(param['bp_type']=='MANUFACTURER'){
                    param['function_code'] = 'BP100F4'

                }else {
                    param['function_code'] = 'BP100F1';
                }
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'prj306_bp_master_modify_id', null, 'PRJ306');
        }

        function PRJ419_calculate_quotation(ds_id, record_id) {
            var quotation_ds = $("${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds");
            quotation_ds.on("submitsuccess", calcQuotation);
            quotation_ds.submit();
        }

        function calcQuotation(ds) {
            debugger
            var quotation_ds = $("${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds");
            var cashflow_ds = $("${/parameter/@layout_code}_G_CASHFLOW_prj_quotation_cashflow_ds");
            quotation_ds.un("submitsuccess", calcQuotation);
            // $L.Masker.mask(Ext.getBody(), '正在计算...');
            var record = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds').getAt(0);
            var prj_project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var projectId = $(prj_project_ds_id).getCurrentRecord().get("project_id");
            var quotationId = ds.getCurrentRecord().get("quotation_id");
            var leaseStartDate = record.get('lease_start_date');
            var url = $('PRJ419_calculate_quotation_link_id').getUrl();
            url = url + "?leaseStartDate=" + leaseStartDate;
            url = url + "&quotationId=" + quotationId;
            url = url + "&projectId=" + projectId;
            Leaf.request({
                url: url,
                success: function (res) {
                    debugger
                    // $L.Masker.unmask(Ext.getBody());
                    quotation_ds.query();
                    cashflow_ds.query();
                    if(quotation_ds.getCurrentRecord().get("calc_check_flag") == 'N'){
                        $L.showInfoMessage("提示", quotation_ds.getCurrentRecord().get("calc_check_info"));
                    }else{
                        // $L.showInfoMessage("提示", "计算成功!");
                        var record = $('${/parameter/@layout_code}_F_QUTA__ds').getCurrentRecord();
                        finance_amount=quotation_ds.getCurrentRecord().get('finance_amount');
                        record.set('release_amount',quotation_ds.getCurrentRecord().get('finance_amount'));
                    }
                },
                failure: function (datas) {
                    // $L.Masker.unmask(Ext.getBody());
                },
                error: function (datas) {
                    // $L.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }


        function PRJ419_open_insurance_information(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var parent_layout_code = '${/parameter/@parent_layout_code}';
            var submit_hide = '${/parameter/@submit_hide}';
            var function_usage = '${/parameter/@function_usage}';
            param['url_title'] = '保险信息维护';
            param['function_code'] = 'PRJ419F5';
            param['winid'] = 'PRJ419_open_insurance_information_winid';
            param['screen_width'] = '1100';
            param['screen_height'] = '450';
            //param['function_usage'] = 'MODIFY';
            param['function_usage'] = function_usage;
            param['maintain_type'] = 'READONLY';
            param['manufacturer_code'] = manufacturerCode;
            if ((parent_layout_code === 'PRJ419' && submit_hide)
                || (parent_layout_code === 'PRJ317' && function_usage === 'QUERY')
                || '${/parameter/@wfl_flag}' === 'Y') {
                param['function_usage'] = 'QUERY';
            }
            hls_doc_get_layout_code(param, 'PRJ419_open_insurance_information_link_id', ds_id, 'PRJ419F2');
        }

