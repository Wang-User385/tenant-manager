        //根据主机厂查询归属厂商, 根据归属厂商带出批复编号
        window['${/parameter/@layout_code}_get_manufacturer'] = function (ds_id, document_id, type) {
            debugger
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(ds_id).getAt(0);
            var para = {
                manufacturer_id: manufacturer_id,
                dealer_id:prj_record.get('bp_id_vender')
            };
            // if (type == 'FACTORY') {
            //     para = {factory_id: document_id};
            // }


            //根据主机厂查询
            Leaf.request({
                url: $('PRJ419f2_prj_factory_link_id').getUrl(),
                scope: this,
                para: para,
                success: function (res) {
                    if (res.success) {
                        debugger
                        if (res.result && res.result.record && res.result.record.length == 1) {
                            /*批复编号*/
                            // $(ds_id).getCurrentRecord().set('reply_number', res.result.record[0].reply_code);
                            //报价方案设置
                            //var plan_combobox = $("${/parameter/@layout_code}_G_QUOTATION_plan_id_combobox_ds");
                            PRJ419f2_viewModel.reply_id = res.result.record[0].reply_id;
                            PRJ419f2_viewModel.productList = res.result.record[0].hls_product_definition_list;
                            if (PRJ419f2_viewModel.productList.length == 0) {
                                // $L.showInfoMessage("提示", "未查询到价目表信息!");
                                console.log("res=" + res);
                            }
                        } else {
                            PRJ419f2_viewModel.reply_id=0;
                            // $L.showInfoMessage("提示", "没有查询到产品信息，请先配置产品信息！");
                        }
                    } else {
                        // $L.showInfoMessage("提示", "未查询到产品信息,请检查相关配置!");
                    }
                }
            });

        };

        //设置批复查询参数
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_cp_object_focus'] = function (object, tab_code, bp_seq) {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(ds_id).getAt(0);
            var record = object.record;
            if (tab_code == 'G_QUOTATION') {
                if (PRJ419f2_viewModel.reply_id != null) {
                    var field = record.getField("plan_id_n");
                    field.setLovPara("reply_id", PRJ419f2_viewModel.reply_id);
                    field.setLovPara("manufacturer_id", prj_record.get('manufacturer_id'));
                    field.setLovPara("factory_id", prj_record.get('factory_id'));
                    field.setLovPara("dealer_id", prj_record.get('bp_id_vender'));
                    field.setLovPara("lease_channel", prj_record.get('lease_channel'));
                    if(prj_record.get('bp_id_vender')){
                        field.setLovPara("dealer_flag", 'Y');
                    }else{
                        field.setLovPara("dealer_flag", 'N');
                        field.setLovPara("dealer_id", -1);
                    }
                }
            }
        };

        //请求报价编号
        window['${/parameter/@layout_code}_get_quotation_number'] = function (record, project_id) {
            debugger
            Leaf.request({
                url: $('PRJ419f2_prj_get_quotation_number_link_id').getUrl() + "?projectId=" + project_id,
                scope: this,
                success: function (res) {
                    if (res.success && res.result && res.result.record) {
                        record.set("quotation_number", res.result.record[0].quotation_number);
                    }
                }
            });

        };

        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger
            disableDs()
            let lease_item_ds_id
            if (currentDivision === 'Vehicle_Leasing' || currentDivision === 'COMMERCIAL_VEHICLE') { //商用车
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds'
            } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') { //光伏设备
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds'
            } else { //工程机械
                lease_item_ds_id =  '${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds'
            }
            //var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_QUOTATION');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow','G_CASHFLOW');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var parentRecord = $('${/parameter/@layout_code}_F_PRJ_BASIC_INFO_prj_project_ds').getAt(0);
            var wfl_flag = '${/parameter/@wfl_flag}';
            if(ds.id == lease_item_ds_id){
                record.set('manufacturer_id',$(ds_id).getCurrentRecord().get('manufacturer_id'));
            }
            if (ds.id === lease_item_ds_id && wfl_flag !== 'Y'){
                if (parentRecord.get("division") === "COMMERCIAL_VEHICLE") {
                    if(record.get("trailer_flag") !== "TRAILER"){
                        record.getField("engine_number").setReadOnly(false);
                        record.getField("engine_number").setRequired(true);
                        record.getField("frame_number").setReadOnly(false);
                        record.getField("frame_number").setRequired(true);
                        record.getField("province_code").setReadOnly(false);
                        record.getField("province_code").setRequired(true);
                        record.getField("city_code").setReadOnly(false);
                        record.getField("city_code").setRequired(true);
                    }else{
                        record.getField("engine_number").setReadOnly(false);
                        record.getField("engine_number").setRequired(false);
                        record.getField("frame_number").setReadOnly(false);
                        record.getField("frame_number").setRequired(false);
                        record.getField("province_code").setReadOnly(false);
                        record.getField("province_code").setRequired(false);
                        record.getField("city_code").setReadOnly(false);
                        record.getField("city_code").setRequired(false);
                    }
                }
            }
            if (ds.id == "${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds") {
                if (parentRecord.get('project_id')) {
                    debugger
                    var source_document_id = parentRecord.get('project_id');
                    var source_document_category = 'PRJ_PROJECT';
                    record.set('source_document_id', source_document_id);
                    record.set('status', 'NEW');
                    record.set('source_document_category', source_document_category);
                    record.set('business_type',$(ds_id).getCurrentRecord().data.business_type);
                    record.set('business_type_n',$(ds_id).getCurrentRecord().data.business_type_n);
                    record.set('payment_type', 'CASH');
                    record.set('payment_type_n', '现金支付');

                    /*设置报价编号*/
                    window['${/parameter/@layout_code}_get_quotation_number'](record, parentRecord.get('project_id'));
                }
                if(record.get('int_rate_calc_flag') === 'Y' || record.get('int_rate_calc_flag_n') === '是'){
                    record.getField('int_rate').setReadOnly(true);
                    record.getField('int_rate').setRequired(false);
                }else if (judgeReadOnly()) {
                    record.getField('int_rate').setReadOnly(false);
                    record.getField('int_rate').setRequired(true);
                }
            }

            if (ds.id === "${/parameter/@layout_code}_C_PRJ_BASIC_INFO_prj_project_attachment_ds" || ds.id === "${/parameter/@layout_code}_C_TH_PRJ_BASIC_INFO_prj_project_attachment_ds") {
                record.set('project_attachment_category', 'prj_project_attachment');
            }
            //计算名义价格
            /*if (ds.id == lease_item_ds_id && $(quotation_ds_id).data.length>0) {
                var residual_price_type = $(quotation_ds_id).data[0].get("residual_price_type");
                var default_residual_value = $(quotation_ds_id).data[0].get("default_residual_value");
                if (residual_price_type == 1){
                    // var pic = div($(quotation_ds_id).data[0].get("residual_value"),minus($(lease_item_ds_id).getAll().length,1));
                    var residual_value = mul(default_residual_value , $(lease_item_ds_id).getAll().length);
                    $(quotation_ds_id).data[0].set("residual_value",residual_value);
                }
                debugger;
            }*/
        };

        function checkItemNumber(itemNumber, division,classifyId) {
            let result = null;
            if ('PHOTOVOLTAIC_DEVICES' === division) {
                return result;
            }
            if (itemNumber && itemNumber.length > 0) {
                Leaf.request({
                    url: $('PRJ419f2_prj_lease_item_check_id').getUrl(),
                    scope: this,
                    para: {itemNumber: itemNumber,division:division,classifyId:classifyId},
                    success: function (res) {
                        if(res && res.result.record && res.result.record.length > 0 && res.result.record[0]){
                            result = res.result.record[0]
                        }
                    },failure: function () {
                        result = "未查询合同"
                    },
                    error: function () {
                        result = "未查询合同"
                    },
                    sync: true
                });
            }
            return result;
        }


        function setPrice() {
            let vehicleDs = '${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds'
            debugger
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                debugger
                for (i = 0; i < $(vehicleDs).getAll().length; i++) {
                    //租赁物净价
                    let netPrice = $(vehicleDs).getAt(i).data.net_price
                    //购置税
                    let purchaseTax = $(vehicleDs).getAt(i).data.purchase_tax
                    if(purchaseTax==undefined){
                        purchaseTax=0;
                    }
                    //保险费
                    let insurancePremium = $(vehicleDs).getAt(i).data.insurance_premium
                    if(insurancePremium==undefined){
                        insurancePremium=0;
                    }
                    //配件费
                    let accessoryFee = $(vehicleDs).getAt(i).data.accessory_fee
                    if(accessoryFee==undefined){
                        accessoryFee=0;
                    }
                    //租赁物总价
                    let price = plus(plus(plus(netPrice, purchaseTax), insurancePremium), accessoryFee)
                    $(vehicleDs).getAt(i).data.price = price
                }
            }
        }

        //保存前调用获取项目编码
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            debugger
            //window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var tenant_ds_id = '${/parameter/@layout_code}_G_TENANT_BASIC_INFO_prj_project_bp_ds';
            var tenant_ds_record=$(tenant_ds_id).getCurrentRecord();
            record.set('prj_bp_id',tenant_ds_record.data.prj_bp_id);
            if(ds.id==tenant_ds_id){
                return true;
            }
            if (!license_length_flag) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "车架号长度应为17位！");
                return false;
            }

            if (!special_char_valid) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "字段含有非法字符（包括空格），请检查！");
                return false;
            }

