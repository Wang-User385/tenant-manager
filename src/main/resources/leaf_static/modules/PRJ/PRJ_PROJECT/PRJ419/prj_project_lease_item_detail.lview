<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: lipan
    $Date: 2024年7月9日
    $Revision: 1.0
    $Purpose: 租赁物详细信息
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function lease_item_detail_return() {
            $('${/parameter/@winid}').close();
        }
        <!--render函数-->
        function formatDate(value, record, name){
            debugger;
            if(value!=""&&value!=undefined){
                var date = new Date(value);
                var yy = date.getFullYear();
                var mm = date.getMonth() + 1;
                var dd = date.getDate();
                mm = (mm < 10) ? '0' + mm : mm;
                dd = (dd < 10) ? '0' + dd : dd;
                var dateStr=yy + '-' + mm + '-' + dd;
                return dateStr;
            }
            else{
                return "";
            }
        }

        function do_formatDate(value){
            console.log(123456);
            if (!Ext.isEmpty(value)){
                return value.parseDate('yyyy-mm-dd').format('yyyy-mm-dd');
            }
            return '';
        }
        function load_detail_ds(ds) {
            debugger;
            /*let record = $(ds).getCurrentRecord();
            if(record.get("product_date") instanceof Date){
                do_formatDate(record.get("product_date"));
            }
            if(record.get("first_registration_date") instanceof Date){
                do_formatDate(record.get("first_registration_date"));
            }
            if(record.get("transfer_registration_date") instanceof Date){
                do_formatDate(record.get("transfer_registration_date"));
            }*/
        }
        ]]></script>
        <!--/ct/prj/project/lease/item/query  租赁物基本信息查询
        /prj/leaseItem/detail/info/query
        /prj/leaseItem/detail/insurance/query 保险
        /prj/leaseItem/detail/sales/query 销售
        /prj/leaseItem/detail/condition/query 车辆情况
        /prj/leaseItem/detail/mortgage/query 抵押-->

        <a:dataSets>
            <a:dataSet id="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="project_lease_item_id" defaultValue="${/parameter/@project_lease_item_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="project_lease_item_detail_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/leaseItem/detail/info/query"
                       queryDataSet="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="manufacturer" readOnly="true"/>
                    <a:field name="lease_item_name" readOnly="true"/>
                    <a:field name="voiture_type" readOnly="true"/>
                    <a:field name="brand_c" readOnly="true"/>
                    <a:field name="model_c" readOnly="true"/>
                    <a:field name="series_c" readOnly="true"/>
                    <a:field name="color_c" readOnly="true"/>
                    <a:field name="vehicle_capacity" readOnly="true"/>
                    <a:field name="frame_number" readOnly="true"/>
                    <a:field name="engine_number" readOnly="true"/>
                    <a:field name="evaluation_value" readOnly="true"/>
                    <a:field name="price" readOnly="true" />
                    <a:field name="selling_price" readOnly="true"/>
                    <a:field name="list_price" readOnly="true" />
                    <a:field name="loan_purpose" readOnly="true"/>
                    <a:field name="lease_item_amount" readOnly="true"/>
                    <a:field name="product_date" readOnly="true"/>
                    <a:field name="first_registration_date" readOnly="true"/>
                    <a:field name="transfer_registration_date" readOnly="true"/>
                    <a:field name="plate_type" readOnly="true"/>
                    <a:field name="license_plate_number" readOnly="true"/>
                    <a:field name="nature_of_vehicle" readOnly="true"/>
                    <a:field name="city_code" readOnly="true"/>
                    <a:field name="first_plate_date" readOnly="true"/>
                    <a:field name="license_plate_ownership" readOnly="true"/>
                    <a:field name="odometer_reading" readOnly="true"/>
                    <a:field name="gps_is_installation" readOnly="true"/>
                    <a:field name="gps_fee" readOnly="true"/>
                    <a:field name="plate_invoice_amount" readOnly="true"/>
                    <a:field name="accessory_amount" readOnly="true"/>
                    <a:field name="vehicle_age" readOnly="true"/>
                    <a:field name="prop_person" readOnly="true"/>
                    <a:field name="purchase_tax" readOnly="true"/>
                    <a:field name="vehicle_tax" readOnly="true"/>
                    <a:field name="fuel_type" readOnly="true"/>
                    <a:field name="is_import" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="load_detail_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="project_lease_item_insurance_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/leaseItem/detail/insurance/query"
                       queryDataSet="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="is_compulsory_insurance" readOnly="true"/>
                    <a:field name="compulsory_amount" readOnly="true"/>
                    <a:field name="compulsory_end_date" readOnly="true"/>
                    <a:field name="commercial_insurance" readOnly="true"/>
                    <a:field name="extended_warranty_amount" readOnly="true"/>
                    <a:field name="insurance_amount" readOnly="true"/>
                    <a:field name="is_vehicle_damage" readOnly="true"/>
                    <a:field name="vehicle_end_date" readOnly="true"/>
                    <a:field name="is_third_party" readOnly="true"/>
                    <a:field name="third_end_date" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="project_lease_item_mortgage_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/leaseItem/detail/mortgage/query"
                       queryDataSet="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="number_of_mortgages" readOnly="true"/>
                    <a:field name="number_of_transfers" readOnly="true"/>
                    <a:field name="number_of_mortgages_one" readOnly="true"/>
                    <a:field name="number_of_transfers_one" readOnly="true"/>
                    <a:field name="number_of_transfers_two" readOnly="true"/>
                    <a:field name="is_renewal_record" readOnly="true"/>
                    <a:field name="is_half_renewal_record" readOnly="true"/>
                    <a:field name="last_transfers_date" readOnly="true"/>
                    <a:field name="recently_transfers_date" readOnly="true"/>
                    <a:field name="transfers_status" readOnly="true"/>
                    <a:field name="days_to_release" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="project_lease_item_condition_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/leaseItem/detail/condition/query"
                       queryDataSet="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="is_water_damaged" readOnly="true"/>
                    <a:field name="is_conversion" readOnly="true"/>
                    <a:field name="accident_status" readOnly="true"/>
                    <a:field name="is_annual_inspection" readOnly="true"/>
                    <a:field name="is_significantly_modified" readOnly="true"/>
                    <a:field name="engine_overhaul" readOnly="true"/>
                    <a:field name="premium_add_on" readOnly="true"/>
                    <a:field name="maintenance_info" readOnly="true"/>
                    <a:field name="original_owner_card_type" readOnly="true"/>
                    <a:field name="original_owner_name" readOnly="true"/>
                    <a:field name="original_owner_card_num" readOnly="true"/>
                    <a:field name="original_owner_address" readOnly="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="project_lease_item_sales_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/prj/leaseItem/detail/sales/query"
                       queryDataSet="project_lease_item_detail_query_ds">
                <a:fields>
                    <a:field name="unified_social_credit_code" readOnly="true"/>
                    <a:field name="sales_name" readOnly="true"/>
                    <a:field name="register_social_credit_code" readOnly="true"/>
                    <a:field name="register_name" readOnly="true"/>
                    <a:field name="mortgage_social_credit_code" readOnly="true"/>
                    <a:field name="mortgage_name" readOnly="true"/>
                    <a:field name="mortgage_city" readOnly="true"/>
                    <a:field name="dealer_address" readOnly="true"/>
                    <a:field name="dealer_social_credit_code" readOnly="true"/>
                    <a:field name="dealer_name" readOnly="true"/>
                    <a:field name="dealer_number" readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="lease_item_detail_return" text="退出"/>
            </a:screenTopToolbar>
            <a:form  title="基本信息">
                <a:hBox labelWidth="200">
                    <a:textField name="manufacturer" bindTarget="project_lease_item_detail_form_ds" prompt="制造商" width="150"/>
                    <a:textField name="lease_item_name" bindTarget="project_lease_item_detail_form_ds" prompt="租赁物名称" width="150"/>
                    <a:textField name="voiture_type" bindTarget="project_lease_item_detail_form_ds" prompt="车辆类型" width="150"/>
                    <a:textField name="brand_c" bindTarget="project_lease_item_detail_form_ds" prompt="车辆品牌" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="model_c" bindTarget="project_lease_item_detail_form_ds" prompt="车辆型号" width="150"/>
                    <a:textField name="series_c" bindTarget="project_lease_item_detail_form_ds" prompt="车系" width="150"/>
                    <a:textField name="color_c" bindTarget="project_lease_item_detail_form_ds" prompt="车辆颜色" width="150"/>
                    <a:textField name="vehicle_capacity" bindTarget="project_lease_item_detail_form_ds" prompt="车辆准载(定员)" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="frame_number" bindTarget="project_lease_item_detail_form_ds" prompt="车架号" width="150"/>
                    <a:textField name="engine_number" bindTarget="project_lease_item_detail_form_ds" prompt="发动机号码" width="150"/>
                    <a:textField name="evaluation_value" bindTarget="project_lease_item_detail_form_ds" prompt="车辆评估价格" width="150"/>
                    <a:textField name="price" bindTarget="project_lease_item_detail_form_ds" prompt="车辆交易价" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="selling_price" bindTarget="project_lease_item_detail_form_ds" prompt="车辆销售价格" width="150"/>
                    <a:textField name="list_price" bindTarget="project_lease_item_detail_form_ds" prompt="车辆厂商指导价格" width="150"/>
                    <a:textField name="loan_purpose" bindTarget="project_lease_item_detail_form_ds" prompt="贷款用途" width="150"/>
                    <a:textField name="lease_item_amount" bindTarget="project_lease_item_detail_form_ds" prompt="融资金额" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:datePicker name="product_date" bindTarget="project_lease_item_detail_form_ds" prompt="车辆出厂日期" width="150"/>
                    <a:datePicker name="first_registration_date" bindTarget="project_lease_item_detail_form_ds" prompt="首次登记日期" renderer="do_formatDate" width="150"/>
                    <a:datePicker name="transfer_registration_date" bindTarget="project_lease_item_detail_form_ds" prompt="转让登记日期" renderer="do_formatDate" width="150"/>
                    <a:textField name="plate_type" bindTarget="project_lease_item_detail_form_ds" prompt="上牌类型" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="license_plate_number" bindTarget="project_lease_item_detail_form_ds" prompt="车牌号" width="150"/>
                    <a:textField name="nature_of_vehicle" bindTarget="project_lease_item_detail_form_ds" prompt="车辆使用性质" width="150"/>
                    <a:textField name="city_code" bindTarget="project_lease_item_detail_form_ds" prompt="上牌城市" width="150"/>
                    <a:datePicker name="first_plate_date" bindTarget="project_lease_item_detail_form_ds" prompt="首次上牌日" renderer="do_formatDate" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="license_plate_ownership" bindTarget="project_lease_item_detail_form_ds" prompt="牌照归属" width="150"/>
                    <a:textField name="odometer_reading" bindTarget="project_lease_item_detail_form_ds" prompt="表显里程(公里数)" width="150"/>
                    <a:textField name="gps_is_installation" bindTarget="project_lease_item_detail_form_ds" prompt="是否安装GPS" width="150"/>
                    <a:textField name="gps_fee" bindTarget="project_lease_item_detail_form_ds" prompt="GPS费用" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="plate_invoice_amount" bindTarget="project_lease_item_detail_form_ds" prompt="上牌发票金额" width="150"/>
                    <a:textField name="accessory_amount" bindTarget="project_lease_item_detail_form_ds" prompt="装饰品金额" width="150"/>
                    <a:textField name="vehicle_age" bindTarget="project_lease_item_detail_form_ds" prompt="车辆年限" width="150"/>
                    <a:textField name="prop_person" bindTarget="project_lease_item_detail_form_ds" prompt="车辆所有人" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="purchase_tax" bindTarget="project_lease_item_detail_form_ds" prompt="购置税" width="150"/>
                    <a:textField name="vehicle_tax" bindTarget="project_lease_item_detail_form_ds" prompt="车辆税额" width="150"/>
                    <a:textField name="fuel_type" bindTarget="project_lease_item_detail_form_ds" prompt="燃料类型" width="150"/>
                    <a:textField name="is_import" bindTarget="project_lease_item_detail_form_ds" prompt="是否进口" width="150"/>
                </a:hBox>
            </a:form>

            <a:form title="保险信息">
                <a:hBox labelWidth="200">
                    <a:textField name="is_compulsory_insurance" bindTarget="project_lease_item_insurance_form_ds" prompt="是否有交强险" width="150"/>
                    <a:numberField name="compulsory_amount" bindTarget="project_lease_item_insurance_form_ds" prompt="强制保险金额" width="150"/>
                    <a:datePicker name="compulsory_end_date" bindTarget="project_lease_item_insurance_form_ds" prompt="交强险到期日期" renderer="do_formatDate" width="150"/>
                    <a:textField name="commercial_insurance" bindTarget="project_lease_item_insurance_form_ds" prompt="商业保险" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:numberField name="extended_warranty_amount" bindTarget="project_lease_item_insurance_form_ds" prompt="延保金额" width="150"/>
                    <a:numberField name="insurance_amount" bindTarget="project_lease_item_insurance_form_ds" prompt="车辆保险金额" width="150"/>
                    <a:textField name="is_vehicle_damage" bindTarget="project_lease_item_insurance_form_ds" prompt="是否有车损险" width="150"/>
                    <a:textField name="vehicle_end_date" bindTarget="project_lease_item_insurance_form_ds" prompt="车损险到期日期" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="is_third_party" bindTarget="project_lease_item_insurance_form_ds" prompt="是否有第三者责任险" width="150"/>
                    <a:textField name="third_end_date" bindTarget="project_lease_item_insurance_form_ds" prompt="第三者责任险到期日期" width="150"/>
                </a:hBox>
            </a:form>
            <a:form title="抵押信息">
                <a:hBox labelWidth="200">
                    <a:textField name="number_of_mortgages" bindTarget="project_lease_item_mortgage_form_ds" prompt="抵押次数" width="150"/>
                    <a:textField name="number_of_transfers" bindTarget="project_lease_item_mortgage_form_ds" prompt="过户次数" width="150"/>
                    <a:textField name="number_of_mortgages_one" bindTarget="project_lease_item_mortgage_form_ds" prompt="近1年抵押次数" width="150"/>
                    <a:textField name="number_of_transfers_one" bindTarget="project_lease_item_mortgage_form_ds" prompt="近1年过户次数" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="number_of_transfers_two" bindTarget="project_lease_item_mortgage_form_ds" prompt="近2年过户次数" width="150"/>
                    <a:textField name="is_renewal_record" bindTarget="project_lease_item_mortgage_form_ds" prompt="是否有车辆登记证补领记录" width="150"/>
                    <a:textField name="is_half_renewal_record" bindTarget="project_lease_item_mortgage_form_ds" prompt="近半年是否有车辆登记证补领记录" width="150"/>
                    <a:datePicker name="last_transfers_date" bindTarget="project_lease_item_mortgage_form_ds" renderer="do_formatDate" prompt="上一次抵押登记日期" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:datePicker name="recently_transfers_date" bindTarget="project_lease_item_mortgage_form_ds" renderer="do_formatDate" prompt="最近一次解押日期" width="150"/>
                    <a:textField name="transfers_status" bindTarget="project_lease_item_mortgage_form_ds" prompt="抵押状态" width="150"/>
                    <a:textField name="days_to_release" bindTarget="project_lease_item_mortgage_form_ds" prompt="解押天数" width="150"/>
                </a:hBox>
            </a:form>
            <a:form title="车况信息">
                <a:hBox labelWidth="200">
                    <a:textField name="is_water_damaged" bindtarget="project_lease_item_condition_form_ds" prompt="是否水泡" width="150"/>
                    <a:textField name="is_conversion" bindTarget="project_lease_item_condition_form_ds" prompt="是否营转非" width="150"/>
                    <a:textField name="accident_status" bindTarget="project_lease_item_condition_form_ds" prompt="事故状况" width="150"/>
                    <a:textField name="is_annual_inspection" bindTarget="project_lease_item_condition_form_ds" prompt="是否年检" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="is_significantly_modified" bindTarget="project_lease_item_condition_form_ds" prompt="是否重大改装车" width="150"/>
                    <a:textField name="engine_overhaul" bindTarget="project_lease_item_condition_form_ds" prompt="发动机大修" width="150"/>
                    <a:textField name="premium_add_on" bindTarget="project_lease_item_condition_form_ds" prompt="精品加装" width="150"/>
                    <a:textField name="maintenance_info" bindTarget="project_lease_item_condition_form_ds" prompt="维修保养情况" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="original_owner_card_type" bindTarget="project_lease_item_condition_form_ds" prompt="原车主证件类型" width="150"/>
                    <a:textField name="original_owner_name" bindTarget="project_lease_item_condition_form_ds" prompt="原车主姓名" width="150"/>
                    <a:textField name="original_owner_card_num" bindTarget="project_lease_item_condition_form_ds" prompt="原车主证件号" width="150"/>
                    <a:textField name="original_owner_address" bindTarget="project_lease_item_condition_form_ds" prompt="原车主户籍所在地" width="150"/>
                </a:hBox>
            </a:form>
            <a:form title="销售信息">
                <a:hBox labelWidth="200">
                    <a:textField name="unified_social_credit_code" bindtarget="project_lease_item_sales_form_ds" prompt="销售方统一社会信用代码" width="150"/>
                    <a:textField name="sales_name" bindTarget="project_lease_item_sales_form_ds" prompt="销售方名称" width="150"/>
                    <a:textField name="register_social_credit_code" bindTarget="project_lease_item_sales_form_ds" prompt="上牌主体社会代码" width="150"/>
                    <a:textField name="register_name" bindTarget="project_lease_item_sales_form_ds" prompt="上牌主体名称" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="dealer_name" bindTarget="project_lease_item_sales_form_ds" prompt="经销商名称" width="150"/>
                    <a:textField name="dealer_social_credit_code" bindtarget="project_lease_item_sales_form_ds" prompt="经销商统一社会信用代码" width="150"/>
                    <a:textField name="dealer_number" bindTarget="project_lease_item_sales_form_ds" prompt="经销商编号" width="150"/>
                    <a:textField name="dealer_address" bindTarget="project_lease_item_sales_form_ds" prompt="经销商所在地" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                    <a:textField name="mortgage_social_credit_code" bindTarget="project_lease_item_sales_form_ds" prompt="抵押人社会代码" width="150"/>
                    <a:textField name="mortgage_name" bindTarget="project_lease_item_sales_form_ds" prompt="抵押人名称" width="150"/>
                    <a:textField name="mortgage_city" bindTarget="project_lease_item_sales_form_ds" prompt="抵押城市名称" width="150"/>
                </a:hBox>
                <a:hBox labelWidth="200">
                </a:hBox>
            </a:form>


        </a:screenBody>

    </a:view>
</a:screen>