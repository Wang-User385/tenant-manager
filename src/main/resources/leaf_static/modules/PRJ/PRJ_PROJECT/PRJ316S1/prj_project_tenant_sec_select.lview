<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var tenant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var tenant_sec_records = $(tenant_ds_id).getSelected();
            var tenant_sec_id = '';
            var tenant_sec_id_n = '';
            var parent_ds_id = '${/parameter/@parent_ds_id}';
            if (tenant_sec_records.length == 0){
                Leaf.showMessage('提示','未选择数据！');
            }else{
                console.log(tenant_sec_records);
                for(var i = 0;i<tenant_sec_records.length;i++){
                    if (tenant_sec_id == ''){
                        tenant_sec_id = tenant_sec_records[i].data.bp_id + '';
                        tenant_sec_id_n = tenant_sec_records[i].data.bp_name;
                    }else{
                        tenant_sec_id = tenant_sec_id + ',' + tenant_sec_records[i].data.bp_id;
                        tenant_sec_id_n = tenant_sec_id_n + ',' + tenant_sec_records[i].data.bp_name;
                    }

                }
                //console.log(tenant_sec_id);
                //console.log(tenant_sec_id_n);
                var parent_record = $(parent_ds_id).getCurrentRecord();
                parent_record.set('tenant_sec_id',tenant_sec_id);
                parent_record.set('tenant_sec_id_n',tenant_sec_id_n);
                $('${/parameter/@winid}').close();

            }

        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            var tenant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            if(ds.id == tenant_ds_id){
                ds.setQueryParameter('bp_type','TENANT_SEC');
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
