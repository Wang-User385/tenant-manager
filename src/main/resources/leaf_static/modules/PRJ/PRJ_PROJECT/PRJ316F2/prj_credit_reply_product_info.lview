<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="false">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function hls_bp_reply_product_index_change() {
            var reply_product_id = $('hls_reply_product_ds_id').getCurrentRecord().get('reply_product_id');
            $('hls_reply_product_para_ds_id').setQueryParameter('replyProductId', reply_product_id);
            $('hls_reply_product_para_ds_id').query();
        }

        function product_add() {
            debugger;
            var reply_id='${/parameter/@project_id}';
            $('product_grid').showEditorByRecord($('hls_reply_product_ds_id').create({
                reply_id: reply_id
            }));
        }

        function product_para_add() {
            debugger;
            var hls_bp_reply_product_ds = $('hls_reply_product_ds_id');
            var record = hls_bp_reply_product_ds.getCurrentRecord();
            if (Ext.isEmpty(record)) {
                return;
            }
            else if (record.isNew) {
                Leaf.showMessage('${l:HLS.PROMPT}', '请先保存产品信息,才能新增产品参数!');
                return;
            }
            $('product_para_grid').showEditorByRecord($('hls_reply_product_para_ds_id').create({
                reply_product_id: record.get('reply_product_id')
            }));

        }

        $L.onReady(function () {
            debugger;
            if("${/parameter/@function_usage}" == "QUERY" || "${/parameter/@function_usage}"== ""){
                jQuery(document).ready(function () {
                    document.getElementById('product_add_button').hidden = true;
                    document.getElementById('product_delete_button').hidden = true;
                    document.getElementById('product_save_button').hidden = true;
                    document.getElementById('product_para_add_button').hidden = true;
                    document.getElementById('product_para_delete_button').hidden = true;
                    document.getElementById('product_para_save_button').hidden = true;
                });
            }
        })

        function hls_reply_product_para_submitsuccess() {
            $('hls_reply_product_ds_id').query();
            $('hls_reply_product_para_ds_id').query();
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="reply_product_para_ds" lookupCode="HLS500_PRODUCT_PARA"/>
            <a:dataSet id="credit_type_ds" lookupCode="FINANCING_LOAN"/>
            <a:dataSet id="pay_type_ds" lookupCode="HLS500_PAY_TYPE"/>
            <a:dataSet id="annual_pay_times_ds" lookupCode="HLS500_ANNUAL_PAY_TIMES"/>
            <a:dataSet id="exempt_penalty_int_ds" lookupCode="EXEMPT_PENALTY_INT"/>
            <a:dataSet id="residual_price_type_ds" lookupCode="RESIDUAL_PRICE_TYPE"/>
            <a:dataSet id="hls_reply_product_ds_id" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/manufacturer/reply/product/query?replyId=${/parameter/@project_id}"
                       deleteUrl="${/request/@context_path}/hls/reply/product/remove"
                       submitUrl="${/request/@context_path}/hls/reply/product/submit"
                       selectable="true" selectionModel="single" autoPageSize="true" autoCount="true">
                <a:fields>
                    <a:field name="reply_product_code" required="true"/>
                    <a:field name="difinition_name" required="true"/>
                    <a:field name="credit_type_n" options="credit_type_ds" required="true" prompt="额度类型"
                             displayField="code_value_name" returnField="credit_type" valueField="code_value"/>

                    <a:field name="price_list_n" autoComplete="true" lovGridHeight="350" lovHeight="500" lovLabelWidth="90"
                             lovWidth="500" title="还款方式" prompt="还款方式"  required="true"
                             lovService="/hls/calcConfig/adjust/queryLov~com.hand.hls.layout.dto.LovHlsCalcConfigDto">
                        <a:mapping>
                            <a:map from="price_list" to="price_list"/>
                            <a:map from="description" to="price_list_n"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="pay_type_n" options="pay_type_ds" required="true" prompt="支付方式"
                             displayField="code_value_name" returnField="pay_type" valueField="code_value"/>
                    <a:field name="annual_pay_times_n" options="annual_pay_times_ds" required="true" prompt="支付频率"
                             displayField="code_value_name" returnField="annual_pay_times" valueField="code_value"/>
                    <a:field name="exempt_penalty_int_n" options="exempt_penalty_int_ds" required="true" prompt="逾期宽限类型"
                             displayField="code_value_name" returnField="exempt_penalty_int" valueField="code_value"/>
                    <a:field name="residual_price_type_n" options="residual_price_type_ds" required="true" prompt="名义货价类型"
                             displayField="code_value_name" returnField="residual_price_type" valueField="code_value"/>
                </a:fields>
                <a:events>
                    <a:event name="indexchange" handler="hls_bp_reply_product_index_change"/>
                    <a:event name="submitsuccess" handler="hls_reply_product_para_submitsuccess"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="hls_reply_product_para_ds_id" bindName="product_bn" bindTarget="hls_reply_product_ds_id"
                       queryUrl="${/request/@context_path}/hls/manufacturer/product/para/query"
                       deleteUrl="${/request/@context_path}/hls/reply/product/para/remove"
                       submitUrl="${/request/@context_path}/hls/reply/product/para/submit"
                       selectable="true" selectionModel="single" autoPageSize="true" autoCount="true" autoQuery="true">
                <a:fields>
                    <a:field name="reply_product_para"/>
                    <a:field name="reply_product_para_n" options="reply_product_para_ds" required="true" prompt="产品参数"
                         displayField="code_value_name" returnField="reply_product_para" valueField="code_value"/>
                    <a:field name="default_value" required="true"/>
                    <a:field name="vaule_from" required="true"/>
                    <a:field name="vaule_to" required="true"/>
                    <!-- <a:field name="system_control_flag" checkedValue="Y" defaultValue="N" uncheckedValue="N"
                              readOnly="true"/>-->
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="hls_reply_product_para_submitsuccess"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:hBox column="2">
                <a:grid id="product_grid" bindTarget="hls_reply_product_ds_id" marginHeight="220" width="750" navBar="true" canWheel="false" title="产品信息">
                    <a:toolBar>
                        <a:button click="product_add" height="36" text="新增" width="36" id="product_add_button"/>
                        <a:button bind="product_grid" text="删除" type="delete" id="product_delete_button"/>
                        <a:button type="save" id="product_save_button"/>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="reply_product_code" prompt="产品编号" width="150" align="left" editor="reply_product_grid_tf"/>
                        <a:column name="difinition_name" prompt="产品名称" width="120" align="right" editor="reply_product_grid_tf"/>
                        <a:column name="credit_type_n" prompt="额度类型" width="120" align="right" editor="reply_product_grid_combox"/>
                        <a:column name="price_list_n" prompt="还款方式" width="120" align="right" editor="reply_product_grid_lov"/>
                        <a:column name="pay_type_n" prompt="支付方式" width="120" align="center" editor="reply_product_grid_combox"/>
                        <a:column name="annual_pay_times_n" prompt="支付频率" width="120" align="center" editor="reply_product_grid_combox"/>
                        <a:column name="exempt_penalty_int_n" prompt="逾期宽限类型" width="120" align="left" editor="reply_product_grid_combox"/>
                        <a:column name="residual_price_type_n" prompt="名义货价类型" width="120" align="center" editor="reply_product_grid_combox"/>
                    </a:columns>
                    <a:editors>
                        <a:textField id="reply_product_grid_tf"/>
                        <a:comboBox id="reply_product_grid_combox"/>
                        <a:lov id="reply_product_grid_lov"/>
                    </a:editors>
                </a:grid>
                <a:grid id="product_para_grid" bindTarget="hls_reply_product_para_ds_id" marginHeight="220" width="450" navBar="true" canWheel="false" title="参数信息">
                    <a:toolBar>
                        <a:button click="product_para_add" height="36" text="新增" width="36" id="product_para_add_button"/>
                        <a:button type="delete" id="product_para_delete_button"/>
                        <a:button type="save"  id="product_para_save_button"/>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="reply_product_para_n" prompt="参数名" width="160" align="left" editor="product_para_grid_combox"/>
                        <a:column name="default_value" prompt="缺省值" width="80" align="right" renderer="Leaf.formatNumber" editor="product_para_grid_nf"/>
                        <a:column name="vaule_from" prompt="范围从" width="80" align="center" renderer="Leaf.formatNumber" editor="product_para_grid_nf"/>
                        <a:column name="vaule_to" prompt="范围到" width="80" align="center" renderer="Leaf.formatNumber" editor="product_para_grid_nf"/>
                        <!--<a:column name="system_control_flag" prompt="系统控制标志" width="80" align="center"
                                  editor="product_para_grid_cb"/>-->
                    </a:columns>
                    <a:editors>
                        <a:checkBox id="product_para_grid_cb"/>
                        <a:comboBox id="product_para_grid_combox"/>
                        <a:numberField id="product_para_grid_nf" decimalPrecision="2"/>
                    </a:editors>
                </a:grid>
            </a:hBox>
        </a:screenBody>
    </a:view>
</a:screen>
