        function onUpdate_approve_creditperiod_fun() {
            debugger;
            var credit_ds = $('prj_meeting_approve_creditperiod_ds');
            var creditRecord = credit_ds.getAt(0);
            console.log(creditRecord.data);
            var credit_period = creditRecord.data.credit_period;
            var credit_period_from = new Date(creditRecord.data.credit_period_from);
            var oldDay = credit_period_from.getDate();
            var credit_period_to = credit_period_from;

            credit_period_to.setMonth(credit_period_from.getMonth() + credit_period);
            var newDay= new Date(credit_period_to.getYear(), credit_period_to.getMonth(), 0).getDate();
            credit_period_to.setDate(Math.min(oldDay, newDay));
            creditRecord.set('credit_period_to' , credit_period_to);
        }

        function onQuery_approve_creditperiod_fun(ds, para) {

            para['process_instance_id'] = '${/parameter/@process_instance_id}';
            para['task_def_key'] = '${/parameter/@task_def_key}';
            para['project_id'] = '${/parameter/@project_id}';
            if('${/parameter/@edit_flag}' == 'Y' && '${/parameter/@change_flag}' == 'Y'){
                para['project_id'] = '${/parameter/@ref_project_id}';
                para['process_instance_id'] = '${/parameter/@refProcessInstanceId}';
            }

        }


        function onSubmitSuccess_vat_waiting_receipt_ds(ds) {
            vat_waiting_receipt_query();
        }

        function vat_waiting_receipt_query() {
            $('prj_meeting_approve_condition_ds').query();
            $('prj_meeting_manage_require_ds').query();
        }

        function parent_quotation_detail(project_id,quotation_id,ds_id){
            //alert(quotation_id);
            if (project_id == undefined || quotation_id == undefined) {
                Leaf.showMessage('提示', '报价未计算成功，无法查看');
            } else {
                //debugger;
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                //param['priceList'] = price_list;
                param['function_code'] = "HLS900WFL";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['readyOnlyFlag'] = 'Y';
                //console.log(param);
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_calc_price_quotation_common_link_id', ds_id, '${/parameter/@layout_code}');
            }
        }

        function risk_dept_opinion_click(){
            var approve_notice_record = $('prj_meeting_approve_notice_ds').getCurrentRecord();
            risk_dept_opinion(approve_notice_record.get('project_id'),approve_notice_record.get('prj_notice_id'));
        }

        function risk_dept_opinion(project_id , prj_notice_id) {
            var down_url;
            var templateCode = '';
            templateCode= 'MEETING_RISK_OPINION';
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    //debugger;
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }


        function approve_notice_make_online(){
            //debugger;
            // approve_notice_make();
            var notice_record = $('prj_meeting_approve_notice_ds').getCurrentRecord();


            var down_url;
            var templateCode = '';
            var project_id = notice_record.get('project_id');
            var prj_notice_id = notice_record.get('prj_notice_id') || '';
            templateCode= 'NOTICE_OF_APPROVAL';

            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id,
                success: function (res) {
                    //debugger;
                    var attachment_id = res.result.record[0].record_id;
                    editDocFile(attachment_id);
                },
                error: function () {
                },
                scope: this
            });

        }

        //在线编辑
        function editDocFile(source_pk_value) {
            window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
        }

        ]]>
        </script>

        <a:dataSets>

            <!--            projectId均取上个页面传的参数 project_id='${/parameter/@project_id}';     -->
            <!--            项目审批意见书-->
            <a:dataSet id="prj_meeting_approve_notice_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/notice?projectId=${/parameter/@project_id}" >
                <a:datas>
                    <a:record name="unit_name"  />
                    <a:record name="unit_id"  />
                    <a:record name="meeting_notice"  />
                </a:datas>
            </a:dataSet>

            <!--            申请人-->
            <a:dataSet id="prj_meeting_approve_bp_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/noticebp?projectId=${/parameter/@project_id}" >
                <a:datas>
                    <a:record name="project_bp_name"  />
                </a:datas>
            </a:dataSet>

            <!--            授信期限-->
            <a:dataSet id="prj_meeting_approve_creditperiod_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/notice/leasetermQuery?projectId=${/parameter/@project_id}" >

                <a:fields>
                    <a:field name="credit_period_from" datatype="date" />
                    <a:field name="credit_period_to" datatype="date" />
                </a:fields>
                <a:events>
                    <a:event   name="update" handler="onUpdate_approve_creditperiod_fun"/>
                    <a:event   name="query" handler="onQuery_approve_creditperiod_fun"/>
                </a:events>
            </a:dataSet>

            <!--            付款前提条件-->
            <a:dataSet id="prj_meeting_approve_condition_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/paymentcondition?projectId=${/parameter/@project_id}"
                       submitUrl="${/request/@context_path}/prj/project/credit/condition/submit"
                       deleteUrl="${/request/@context_path}/prj/project/credit/condition/remove">

                <a:fields>
                    <a:field name="project_id" defaultValue='${/parameter/@project_id}'/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_waiting_receipt_ds"/>
                </a:events>
            </a:dataSet>
            <!--            租后管理要求-->
            <a:dataSet id="prj_meeting_manage_require_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/managerequire?projectId=${/parameter/@project_id}"
                       submitUrl="${/request/@context_path}/prj/project/survive/require/submit"
                       deleteUrl="${/request/@context_path}/prj/project/survive/require/remove">
                <a:fields>
                    <a:field name="project_id" defaultValue='${/parameter/@project_id}'/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_waiting_receipt_ds"/>
                </a:events>
            </a:dataSet>

            <!--            五级分类-->
            <a:dataSet id="prj_meeting_risk_class_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/riskclass?projectId=${/parameter/@project_id}">

            </a:dataSet>

        </a:dataSets>

        <a:screenBody style="background-color:#fff">

<!--            <a:screenTopToolbar>-->
<!--                <a:screenTitle/>-->
<!--                <a:gridButton text="审批通知书制作完成"  click="approve_notice_make"/>-->
<!--            </a:screenTopToolbar>-->

                <a:screenTopToolbar>
                    <a:screenTitle/>
<!--                    <a:gridButton text="风险管理部意见"  click="risk_dept_opinion_click"/>-->
                    <a:gridButton text="授信审批通知书在线预览"  click="approve_notice_make_online"/>
                </a:screenTopToolbar>

            <a:form title="项目审批意见书" column="1"  width="1300" labelwidth="110"  >
                <a:box column="2" labelWidth="100">
                    <a:textField name="unit_name" prompt="部门名称" width="160" readOnly="true" bindTarget="prj_meeting_approve_notice_ds"/>
                    <a:hBox labelWidth="120" style="margin-left:355px;">
                        <a:textField name="project_notice_number"  prompt="审批通知书编号"  width="160" readOnly="true" bindTarget="prj_meeting_approve_notice_ds"/>
                    </a:hBox>
<!--                    <a:textField name="project_notice_number" prompt="审批通知书编号" width="160" readOnly="true" bindTarget="prj_meeting_approve_notice_ds"/>-->
                </a:box>
                <a:box column="1" labelWidth="100">
                    <a:textArea name="meeting_notice" readOnly="true" prompt="审批意见" width="800" height="80" bindTarget="prj_meeting_approve_notice_ds"/>
                </a:box>
            </a:form>

            <a:form title="一.申请人"   width="1300" labelwidth="110" >
                <a:box column="1" labelWidth="100">
                    <a:textArea name="project_bp_name" readOnly="true" prompt="申请人" width="800" height="40" bindTarget="prj_meeting_approve_bp_ds" />
                </a:box>
            </a:form>

            <a:placeHolder id="dynamicTreeNode_id"/>

            <a:form title="额度有效期"    column="1"   width="1300"  >
                <a:box column="3" labelwidth="110">
                    <a:numberField name="credit_period" prompt="额度有效期(月)" allowDecimals="false" width="160" readOnly="true" bindTarget="prj_meeting_approve_creditperiod_ds"  />
                    <a:datePicker name="credit_period_from" prompt="额度有效期从" width="160" readOnly="true" renderer="Leaf.formatDate" bindTarget="prj_meeting_approve_creditperiod_ds" />
                    <a:datePicker name="credit_period_to" prompt="额度有效期到" width="160" readOnly="true" renderer="Leaf.formatDate" bindTarget="prj_meeting_approve_creditperiod_ds"  />
                </a:box>


            </a:form>

            <a:form title="三.付款前提条件"  width="1300"  navBar="true" >

                <a:grid id="payment_conditon_id"  marginHeight="200" marginWidth="120" bindTarget="prj_meeting_approve_condition_ds" >
<!--                    <a:toolBar>-->
<!--                        <a:button type="add"/>-->
<!--                        <a:button type="save"/>-->
<!--                        <a:button type="delete"/>-->

<!--                    </a:toolBar>-->
                    <a:columns>
                        <a:column name="row_seq" prompt="序号" width="100" align="center"/>
                        <a:column name="condition" prompt="付款前提条件" width="900" />
                    </a:columns>
<!--                    <a:editors>-->
<!--                        <a:textField id="payment_condition_grid_tf"/>-->
<!--                    </a:editors>-->
                </a:grid>
            </a:form>

            <a:form title="四.存续期管理要求"  width="1300" >
                <a:grid id="survive_manage_require_id"  marginHeight="200" marginWidth="120"  bindTarget="prj_meeting_manage_require_ds" >
<!--                    <a:toolBar>-->
<!--                        <a:button type="add"/>-->
<!--                        <a:button type="save"/>-->
<!--                        <a:button type="delete"/>-->
<!--                    </a:toolBar>-->
                    <a:columns>
                        <a:column name="row_seq" prompt="序号" width="100" align="center"/>
                        <a:column name="manage_requirements" prompt="存续期管理要求" width="900"/>
                    </a:columns>
<!--                    <a:editors>-->
<!--                        <a:textField id="manage_require_grid_tf"/>-->
<!--                    </a:editors>-->
                </a:grid>
            </a:form>

            <a:form title="五.风险分类"  width="1300" >
                <a:box column="2" labelWidth="100">
                    <a:textField name="five_categories_n" prompt="风险分类" width="200" readOnly="true" bindTarget="prj_meeting_risk_class_ds"/>
                </a:box>
            </a:form>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
    <a:view-config>
        <c:create-config targetId="dynamicTreeNode_id">
            <p:loop source="/model/prj_project_meeting_notice_path">
                <p:switch test="@order_seq">
                    <p:case value="*">
                        <c:process-config>

                            <a:form title="二.项目要素(方案${@order_seq})">
                                <a:screen-include screen="modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_quatation_query.lview?quotation_id=${@quotation_id}&amp;order_seq=${@order_seq}&amp;project_id=${@project_id}"/>
                            </a:form>

                        </c:process-config>
                    </p:case>
                </p:switch>
            </p:loop>

        </c:create-config>
    </a:view-config>
</a:screen>
