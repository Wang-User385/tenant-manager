<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        var query_flag = 'Y';
        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            //上个页面需要传 project_id
            debugger;
            var project_id = '${/parameter/@project_id}';
            //暂时 设置一个 虚拟 project_id
            project_id = 804;
            var prj_project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if( query_flag == 'Y' ){
                if(ds.id == prj_project_ds ){
                    var project_record = $(prj_project_ds).getCurrentRecord();
                    project_record.set('project_id',project_id);
                    query_flag='N';
                    ds.query();
                }
            }


        };

        //审批通知书制作完成
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            //上个页面需要传 project_id
            var project_id = '${/parameter/@project_id}';
            //虚拟设置一个project_id
            project_id = 804;


        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
