<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html, body {
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_veto.lview"/>
        <a:link id="prj_project_wfl_query_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_veto_query.lview"/>
        <script><![CDATA[
        //debugger;


        var businessKey = '${/parameter/@businessKey}';
        var url;
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }
        //debugger;
        var process_instance_id = parent.currentTaskInfo.process_instance.id;
        var current_activity_id = parent.currentTaskInfo.task_definition_key;

        var task_def_key = 'sid-uSYSH3Qa-Eo67-4Jje-8Ujp-ZaeChYIi7szk';

        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        if (current_activity_id != 'sid-xHzoE0Sh-zc35-41c2-8o0D-d77ZDWeKGj1O' && current_activity_id != 'sid-orHPhPDR-J2CG-4xmn-8wx8-ZA3hNZxag9bP'
            && current_activity_id != 'sid-mAmBB7Gi-zYNM-4y8J-8fGm-NCNin61UKVk2' && current_activity_id != 'sid-mAmBB7Gi-zYNM-4y8J-8fGm-NCNin61UKVkk'
            && current_activity_id != 'sid-oEyH1LWb-YmjB-4a3P-8AI2-bBjAGywbaNND' && current_activity_id != 'sid-6UXFHvLO-3X60-42OH-8O6s-EvdSIAXi7fTO'
            && current_activity_id != 'sid-e8J9H4oz-5YrJ-4aKR-8mb8-tQ8XN4pu3UTq' && current_activity_id != 'sid-9Ur6ZzPO-9hzZ-4Tlz-87IJ-CXuzDRmCp1h2'
            && current_activity_id != 'sid-BQyohpPZ-RZO0-49HH-8Hqa-jUVmEpSlL2P3' && current_activity_id != 'sid-Oa6AFoKE-TeBG-4PnC-8F1n-v6E95Vmv8Nbg') {
            url = $('prj_project_wfl_query_link_id').getUrl();
        } else {
            url = $('prj_project_wfl_detail_link_id').getUrl();
        }
        var approve_result = "VETO";

        //debugger;

        var pageChooser = new PageChooser({
            url: url,
            function_code: 'PRJ316F2',
            context_path: '${/request/@context_path}',
            opt: {
                project_id: projectId,
                // credit_line_id:  creditLineId,
                // maintain_type: maintain_type,
                // function_usage: function_usage,
                process_instance_id: process_instance_id,
                approve_result : approve_result,
                task_def_key: task_def_key
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>