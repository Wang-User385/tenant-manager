<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.prj.service.HlsCusPrjProjectService.selectProjectQuotationNoticeLoop"
                       rootPath="prj_project_meeting_notice_path"/>
    </a:init-procedure>
    <a:view>


        <a:link id="approve_notice_make_link"
                url="${/request/@context_path}/hls/prj/create/notice"/>
        <a:link id="${/parameter/@layout_code}_calc_price_quotation_common_link_id" url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900WFL/quotation_calc_common_wfl.lview"/>

        <style>
            html, body {
                background: #fff;
            }

            .item-tab-table {
                -webkit-box-shadow: none !important;
                -moz-box-shadow: none !important;
                -o-box-shadow: none !important;
                -ms-box-shadow: none !important;
                box-shadow: none !important;
            }

            /*滚动条样式*/
            .item-tab .tab::-webkit-scrollbar { /*滚动条整体样式*/
                width: 8px; /*高宽分别对应横竖滚动条的尺寸*/
                height: 8px;
            }

            .item-tab .tab::-webkit-scrollbar-thumb { /*滚动条里面小方块*/
                border-radius: 5px;
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                background-color: rgb(204, 204, 204);
            }

            .item-tab .tab::-webkit-scrollbar-track { /*滚动条里面轨道*/
                -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
                border-radius: 0;
                background-color: white;
            }
        </style>
        <script><![CDATA[

        var ref_project_id = '${/parameter/@ref_project_id}';

        //审批通知书制作 即生成通知书编号
        function approve_notice_make() {
            // debugger;
            var  process_instance_id = '${/parameter/@process_instance_id}';
            var notice_ds = $('prj_meeting_approve_notice_ds');
            var notice_record = notice_ds.getAt(0);
            notice_record.set('approve_result' , 'APPROVE');
            notice_record.set('process_instance_id' , process_instance_id);

            var credit_ds = $('prj_meeting_approve_creditperiod_ds');
            var creditRecord = credit_ds.getAt(0);

            if(creditRecord != null && creditRecord != '' && creditRecord != undefined){
                if(creditRecord.data.credit_period_from == null || creditRecord.data.credit_period_from == '' || creditRecord.data.credit_period_from == undefined ){
                    Leaf.showInfoMessage("提示","授信期限从 未获取!");
                    return false;
                }

                if( creditRecord.data.credit_period == null  || creditRecord.data.credit_period == '' || creditRecord.data.credit_period == undefined ){
                    Leaf.showInfoMessage("提示","请先输入授信期限!");
                    return false;
                }

                if(creditRecord.data.credit_period_to == null || creditRecord.data.credit_period_to == '' || creditRecord.data.credit_period_to == undefined ){
                    notice_record.set('credit_period', creditRecord.data.credit_period);
                    notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                    notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
                }

                notice_record.set('credit_period', creditRecord.data.credit_period);
                notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
            }else{
                Leaf.showInfoMessage("提示","授信期限数据未获取!");
                return false;
            }

            var five_class_ds = $('prj_meeting_risk_class_ds');
            var five_class_record = five_class_ds.getAt(0);
            if(five_class_record != null && five_class_record != '' && five_class_record != undefined){
                if(five_class_record.data.five_categories_n == null || five_class_record.data.five_categories_n == '' || five_class_record.data.five_categories_n  == undefined ){
                    Leaf.showInfoMessage("提示","风险分类未获取!");
                    return false;
                }
                // debugger;
                notice_record.set('five_categories', five_class_record.data.five_categories);
                notice_record.set('five_categories_n', five_class_record.data.five_categories_n);

            }else{
                Leaf.showInfoMessage("提示","风险分类未获取!");
                return false;
            }

            var condition_ds =  $('prj_meeting_approve_condition_ds');
            var condition_record = condition_ds.getAll();
            if(condition_record.length == 0){
                Leaf.showInfoMessage("提示","请输入付款前提条件!");
                return false;
            }

            var require_ds = $('prj_meeting_manage_require_ds');
            var require_record = require_ds.getAll();
            if(require_record.length == 0){
                Leaf.showInfoMessage("提示","请输入存续期管理要求!");
                return false;
            }




            var saveData = [];
            saveData.push(notice_record.data);

            //上个节点传值,审批结果
            var approveResult  = $('prj_meeting_approve_notice_ds');


            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: $('approve_notice_make_link').getUrl(),
                para: saveData,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    Leaf.Masker.unmask(Ext.getBody());
                    notice_ds.query();
                    //credit_ds.query();
                    five_class_ds.query();
                    return true;
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    return false;
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    return false;
                },
                scope: this
            });

        }

        function onUpdate_approve_creditperiod_fun(ds, record, name, value, oldValue) {
            // debugger;
            if(name == 'credit_period'){
                var credit_ds = $('prj_meeting_approve_creditperiod_ds');
                var creditRecord = credit_ds.getAt(0);
                var credit_period = creditRecord.data.credit_period;
                var credit_period_from = new Date(creditRecord.data.credit_period_from);
                var oldDay = credit_period_from.getDate();
                var credit_period_to = credit_period_from;

                credit_period_to.setMonth(credit_period_from.getMonth() + credit_period);
                var newDay= new Date(credit_period_to.getYear(), credit_period_to.getMonth(), 0).getDate();
                credit_period_to.setDate(Math.min(oldDay, newDay));
                creditRecord.set('credit_period_to' , credit_period_to);
            }

        }

        function onQuery_approve_creditperiod_fun(ds, para) {
            debugger;
            para['process_instance_id'] = '${/parameter/@process_instance_id}';
            para['task_def_key'] = '${/parameter/@task_def_key}';
            para['project_id'] = '${/parameter/@project_id}';

            var approve_notice_record = $('prj_meeting_approve_notice_ds').getCurrentRecord();
            if(approve_notice_record != null){
                if(approve_notice_record.get('prj_notice_id') != 'undefined' && approve_notice_record.get('prj_notice_id') != null && approve_notice_record.get('prj_notice_id') != ''){
                    //通知书id存在时，即生成了通知书，则传参直接查prj_project_credit_notice表里的数据；否则不传参数，只查节点的审批时间作为授信期限从
                    para['prj_notice_id'] = approve_notice_record.get('prj_notice_id');
                }
            }

        }

        function onLoad_approve_creditperiod_fun(){
            debugger;
            var record = $('prj_meeting_approve_creditperiod_ds').getCurrentRecord();
            if(record == null || record.get('credit_period_from') == null || record.get('credit_period_from') == ''){
                //变更时的工作流才会走，用当前的项目去查询，查询不出数据时，即未生成通知书时，把老项目的授信期限从查询出来，作为变更的授信期限从
                Leaf.request({
                    url: "${/request/@context_path}/hls/prj/approve/notice/leasetermQuery",
                    para: {
                        project_id: '${/parameter/@ref_project_id}'
                    },
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        debugger;
                        var credit_period_from = res.result.record[0].credit_period_from;
                        $('prj_meeting_approve_creditperiod_ds').create();
                        var new_record = $('prj_meeting_approve_creditperiod_ds').getCurrentRecord();
                        new_record.set('credit_period_from',new Date(credit_period_from));
                        console.log(new_record);
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });


                /*$('prj_meeting_approve_creditperiod_ds').setQueryParameter('project_id','${/parameter/@ref_project_id}');
                $('prj_meeting_approve_creditperiod_ds').setQueryParameter('process_instance_id','${/parameter/@refProcessInstanceId}');
                $('prj_meeting_approve_creditperiod_ds').query();*/
            }

        }


        function onLoad_prj_meeting_approve_notice_ds(){
            debugger;
            var record = $('prj_meeting_approve_notice_ds').getCurrentRecord();
            if(record != null){
                if(record.get('prj_notice_id') != 'undefined' && record.get('prj_notice_id') != null && record.get('prj_notice_id') != ''){
                    //通知书id存在时，即生成了通知书，则传参直接查prj_project_credit_notice表里的数据；否则不传参数，只查节点的审批时间作为授信期限从
                    $('prj_meeting_approve_creditperiod_ds').setQueryParameter('prj_notice_id',record.get('prj_notice_id'));
                    //$('prj_meeting_approve_creditperiod_ds').query();
                }
                $('prj_meeting_approve_creditperiod_ds').query();
            }

        }


        function onSubmitSuccess_vat_waiting_receipt_ds(ds) {
            vat_waiting_receipt_query();
        }

        function vat_waiting_receipt_query() {
            $('prj_meeting_approve_condition_ds').query();
            $('prj_meeting_manage_require_ds').query();
        }

        function onAdd_require_condition_ds(ds,record) {
            var require_records = $('prj_meeting_manage_require_ds').getAll();
            record.set('row_seq',require_records.length);
        }

        function onAdd_approve_condition_ds(ds,record) {
            var condition_records = $('prj_meeting_approve_condition_ds').getAll();
            record.set('row_seq',condition_records.length);
        }

        function parent_quotation_detail(project_id,quotation_id,ds_id){
            //alert(quotation_id);
            if (project_id == undefined || quotation_id == undefined) {
                Leaf.showMessage('提示', '报价未计算成功，无法查看');
            } else {
                //debugger;
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                //param['priceList'] = price_list;
                param['function_code'] = "HLS900WFL";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'UPDATE';
                param['function_usage'] = 'MODIFY';
                param['readyOnlyFlag'] = 'Y';
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_calc_price_quotation_common_link_id', ds_id, '${/parameter/@layout_code}');
            }
        }

        function onLoad_risk_class_ds(ds , record ) {

            // debugger;
            var risk_records = $('prj_meeting_risk_class_ds').getCurrentRecord();

            if(risk_records.get('five_categories') == null || risk_records.get('five_categories') == undefined || risk_records.get('five_categories') == ''){
                risk_records.set('five_categories', 'NORMAL');
                risk_records.set('five_categories_n', '正常类');
            }

        }

        function approve_notice_make_online(){
            //debugger;

            var  process_instance_id = '${/parameter/@process_instance_id}';
            var notice_ds = $('prj_meeting_approve_notice_ds');
            var notice_record = notice_ds.getAt(0);
            notice_record.set('approve_result' , 'APPROVE');
            notice_record.set('process_instance_id' , process_instance_id);

            var credit_ds = $('prj_meeting_approve_creditperiod_ds');
            var creditRecord = credit_ds.getAt(0);

            if(creditRecord != null && creditRecord != '' && creditRecord != undefined){
                if(creditRecord.data.credit_period_from == null || creditRecord.data.credit_period_from == '' || creditRecord.data.credit_period_from == undefined ){
                    Leaf.showInfoMessage("提示","授信期限从 未获取!");
                    return false;
                }

                if( creditRecord.data.credit_period == null  || creditRecord.data.credit_period == '' || creditRecord.data.credit_period == undefined ){
                    Leaf.showInfoMessage("提示","请先输入授信期限!");
                    return false;
                }

                if(creditRecord.data.credit_period_to == null || creditRecord.data.credit_period_to == '' || creditRecord.data.credit_period_to == undefined ){
                    notice_record.set('credit_period', creditRecord.data.credit_period);
                    notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                    notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
                }

                notice_record.set('credit_period', creditRecord.data.credit_period);
                notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
            }else{
                Leaf.showInfoMessage("提示","授信期限数据未获取!");
                return false;
            }

            var five_class_ds = $('prj_meeting_risk_class_ds');
            var five_class_record = five_class_ds.getAt(0);
            if(five_class_record != null && five_class_record != '' && five_class_record != undefined){
                if(five_class_record.data.five_categories_n == null || five_class_record.data.five_categories_n == '' || five_class_record.data.five_categories_n  == undefined ){
                    Leaf.showInfoMessage("提示","风险分类未获取!");
                    return false;
                }
                notice_record.set('five_categories', five_class_record.data.five_categories);
                notice_record.set('five_categories_n', five_class_record.data.five_categories_n);

            }else{
                Leaf.showInfoMessage("提示","风险分类未获取!");
                return false;
            }

            var condition_ds =  $('prj_meeting_approve_condition_ds');
            var condition_record = condition_ds.getAll();
            if(condition_record.length == 0){
                Leaf.showInfoMessage("提示","请输入付款前提条件!");
                return false;
            }

            var require_ds = $('prj_meeting_manage_require_ds');
            var require_record = require_ds.getAll();
            if(require_record.length == 0){
                Leaf.showInfoMessage("提示","请输入存续期管理要求!");
                return false;
            }

            var saveData = [];
            saveData.push(notice_record.data);

            //上个节点传值,审批结果
            var approveResult  = $('prj_meeting_approve_notice_ds');


            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: $('approve_notice_make_link').getUrl(),
                para: saveData,
                success: function (res) {

                    Leaf.Masker.unmask(Ext.getBody());
                    notice_ds.query();
                    five_class_ds.query();

                    var notice_record = $('prj_meeting_approve_notice_ds').getCurrentRecord();
                    var down_url;
                    var templateCode = '';
                    var project_id = notice_record.get('project_id');
                    //var prj_notice_id = notice_record.get('prj_notice_id') || '';
                    var prj_notice_id = res.result.record[0].prj_notice_id || '';

                    var url = "";
                    if(ref_project_id == '' || ref_project_id == 'undefined'){
                        templateCode= 'NOTICE_OF_APPROVAL';
                        url = "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                            + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id;
                    }else{
                        templateCode= 'NOTICE_OF_APPROVAL_CHANGE';
                        url = "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                            + '&templateCode=' + templateCode + '&prjNoticeId=' + prj_notice_id + '&oldProjectId=' + ref_project_id;
                    }

                    Leaf.request({
                        url: url,
                        success: function (res) {
                            //debugger;
                            var attachment_id = res.result.record[0].record_id;
                            editDocFile(attachment_id);
                        },
                        error: function () {
                        },
                        scope: this
                    });

                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });



        }

        //在线编辑
        function editDocFile(source_pk_value) {
            window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
        }

        function beforeSubmit(countiune) {
            var  process_instance_id = '${/parameter/@process_instance_id}';
            var notice_ds = $('prj_meeting_approve_notice_ds');
            var notice_record = notice_ds.getAt(0);
            notice_record.set('approve_result' , 'APPROVE');
            notice_record.set('process_instance_id' , process_instance_id);

            var credit_ds = $('prj_meeting_approve_creditperiod_ds');
            var creditRecord = credit_ds.getAt(0);

            if(creditRecord != null && creditRecord != '' && creditRecord != undefined){
                if(creditRecord.data.credit_period_from == null || creditRecord.data.credit_period_from == '' || creditRecord.data.credit_period_from == undefined ){
                    Leaf.showInfoMessage("提示","授信期限从 未获取!");
                    return false;
                }

                if( creditRecord.data.credit_period == null  || creditRecord.data.credit_period == '' || creditRecord.data.credit_period == undefined ){
                    Leaf.showInfoMessage("提示","请先输入授信期限!");
                    return false;
                }

                if(creditRecord.data.credit_period_to == null || creditRecord.data.credit_period_to == '' || creditRecord.data.credit_period_to == undefined ){
                    notice_record.set('credit_period', creditRecord.data.credit_period);
                    notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                    notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
                }

                notice_record.set('credit_period', creditRecord.data.credit_period);
                notice_record.set('credit_period_from', creditRecord.data.credit_period_from);
                notice_record.set('credit_period_to', creditRecord.data.credit_period_to);
            }else{
                Leaf.showInfoMessage("提示","授信期限数据未获取!");
                return false;
            }

            var five_class_ds = $('prj_meeting_risk_class_ds');
            var five_class_record = five_class_ds.getAt(0);
            if(five_class_record != null && five_class_record != '' && five_class_record != undefined){
                if(five_class_record.data.five_categories_n == null || five_class_record.data.five_categories_n == '' || five_class_record.data.five_categories_n  == undefined ){
                    Leaf.showInfoMessage("提示","风险分类未获取!");
                    return false;
                }
                // debugger;
                notice_record.set('five_categories', five_class_record.data.five_categories);
                notice_record.set('five_categories_n', five_class_record.data.five_categories_n);

            }else{
                Leaf.showInfoMessage("提示","风险分类未获取!");
                return false;
            }

            var condition_ds =  $('prj_meeting_approve_condition_ds');
            var condition_record = condition_ds.getAll();
            if(condition_record.length == 0){
                Leaf.showInfoMessage("提示","请输入付款前提条件!");
                return false;
            }

            var require_ds = $('prj_meeting_manage_require_ds');
            var require_record = require_ds.getAll();
            if(require_record.length == 0){
                Leaf.showInfoMessage("提示","请输入存续期管理要求!");
                return false;
            }




            var saveData = [];
            saveData.push(notice_record.data);

            //上个节点传值,审批结果
            var approveResult  = $('prj_meeting_approve_notice_ds');


            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: $('approve_notice_make_link').getUrl(),
                para: saveData,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    Leaf.Masker.unmask(Ext.getBody());
                    notice_ds.query();
                    credit_ds.query();
                    five_class_ds.query();
                    countiune();
                    return true;
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    return false;
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                    return false;
                },
                scope: this
            });
        };

        ]]>
        </script>

        <a:dataSets>

            <!--            projectId均取上个页面传的参数 project_id='${/parameter/@project_id}';     -->
            <!--            项目审批意见书-->
            <a:dataSet id="prj_meeting_approve_notice_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/notice?projectId=${/parameter/@project_id}&amp;processInstanceId=${/parameter/@process_instance_id}" >
                <a:fields>
                    <a:field name="unit_name" />
                    <a:field name="unit_id" />
                    <a:field name="meeting_notice" />
                    <a:field name="prj_notice_id"/>
                </a:fields>
                <a:events>
                    <a:event   name="load" handler="onLoad_prj_meeting_approve_notice_ds"/>
                </a:events>
            </a:dataSet>

            <!--            申请人-->
            <a:dataSet id="prj_meeting_approve_bp_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/noticebp?projectId=${/parameter/@project_id}" >
                <a:datas>
                    <a:record name="project_bp_name"  />
                </a:datas>
            </a:dataSet>

            <!--            授信期限-->
            <a:dataSet id="prj_meeting_approve_creditperiod_ds" autoPageSize="true"  autoCreate="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/notice/leaseterm?projectId=${/parameter/@project_id}" >
                <a:fields>
                    <a:field name="credit_period_from" datatype="date" />
                    <a:field name="credit_period_to" datatype="date" />
                </a:fields>
                <a:events>
                    <a:event   name="update" handler="onUpdate_approve_creditperiod_fun"/>
                    <a:event   name="query" handler="onQuery_approve_creditperiod_fun"/>
                    <a:event   name="load" handler="onLoad_approve_creditperiod_fun"/>
                </a:events>
            </a:dataSet>

            <!--            付款前提条件-->
            <a:dataSet id="prj_meeting_approve_condition_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/paymentcondition?projectId=${/parameter/@project_id}"
                       submitUrl="${/request/@context_path}/prj/project/credit/condition/submit"
                       deleteUrl="${/request/@context_path}/prj/project/credit/condition/remove">

                <a:fields>
                    <!--                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>-->
                    <a:field name="project_id" defaultValue='${/parameter/@project_id}'/>
                    <a:field name="condition" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="add" handler="onAdd_approve_condition_ds" />
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_waiting_receipt_ds"/>
                </a:events>
            </a:dataSet>
            <!--            租后管理要求-->
            <a:dataSet id="prj_meeting_manage_require_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/managerequire?projectId=${/parameter/@project_id}"
                       submitUrl="${/request/@context_path}/prj/project/survive/require/submit"
                       deleteUrl="${/request/@context_path}/prj/project/survive/require/remove">
                <a:fields>
                    <!--                    <a:field name="project_id" defaultValue="${/parameter/@project_id}"/>-->
                    <a:field name="project_id" defaultValue='${/parameter/@project_id}'/>
                    <a:field name="manage_requirements" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="add" handler="onAdd_require_condition_ds" />
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_waiting_receipt_ds"/>
                </a:events>
            </a:dataSet>

            <!--            五级分类-->
            <a:dataSet id="prj_meeting_risk_class_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/riskclass?projectId=${/parameter/@project_id}">
                <a:fields>
                    <a:field name="five_categories_n"   displayField="code_value_name" returnField="five_categories" valueField="code_value" options="hls_five_class_combox_ds"/>
                </a:fields>
                <a:events>
                    <a:event name="load" handler="onLoad_risk_class_ds"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="hls_five_class_combox_ds" lookupCode="FIVE_RISK_CLASS"/>


        </a:dataSets>

        <a:screenBody style="background-color:#fff">

            <a:screenTopToolbar>
                <a:screenTitle/>
                <!--<a:gridButton text="审批通知书生成"  click="approve_notice_make"/>-->
                <a:gridButton text="在线预览"  click="approve_notice_make_online"/>
            </a:screenTopToolbar>

            <a:form title="项目审批意见书" column="1"  width="1300" labelwidth="110"  >
                <a:box column="2" labelWidth="120">
                    <a:textField name="unit_name" prompt="部门名称" width="160" readOnly="true" bindTarget="prj_meeting_approve_notice_ds"/>

                    <a:hBox labelWidth="120" style="margin-left:355px;">
                        <a:textField name="project_notice_number"  prompt="审批通知书编号"  width="160" readOnly="true" bindTarget="prj_meeting_approve_notice_ds"/>
                    </a:hBox>
                </a:box>
                <a:box column="1" labelWidth="120">
                    <a:textArea name="meeting_notice" required="true" prompt="审批意见" width="800" height="80" bindTarget="prj_meeting_approve_notice_ds"/>
                </a:box>
            </a:form>

            <a:form title="一.申请人"   width="1300" labelwidth="110" >
                <a:box column="1" labelWidth="120">
                    <a:textArea name="project_bp_name" readOnly="true" prompt="申请人" width="800" height="40" bindTarget="prj_meeting_approve_bp_ds" />
                </a:box>
            </a:form>

            <a:placeHolder id="dynamicTreeNode_id"/>

            <a:form title="额度有效期"    column="1"   width="1300"  >
                <a:box column="3" labelwidth="110">
                    <a:numberField name="credit_period" prompt="额度有效期(月)" allowDecimals="false" width="160" required="true" bindTarget="prj_meeting_approve_creditperiod_ds"  />
                    <a:datePicker name="credit_period_from" prompt="额度有效期从" width="160" readOnly="true" renderer="Leaf.formatDate" bindTarget="prj_meeting_approve_creditperiod_ds" />
                    <a:datePicker name="credit_period_to" prompt="额度有效期到" width="160" readOnly="true" renderer="Leaf.formatDate"  bindTarget="prj_meeting_approve_creditperiod_ds"  />
                </a:box>


            </a:form>

            <a:form title="三.付款前提条件"  width="1300"  navBar="true" >

                <a:grid id="payment_conditon_id"  marginHeight="200" marginWidth="120" bindTarget="prj_meeting_approve_condition_ds" >
                    <a:toolBar>
                        <a:button type="add"/>
                        <a:button type="save"/>
                        <a:button type="delete"/>

                    </a:toolBar>
                    <a:columns>
                        <a:column name="row_seq" prompt="序号" width="100" align="center"/>
                        <a:column name="condition" prompt="付款前提条件" width="900"  editor="payment_condition_grid_tf"/>
                    </a:columns>
                    <a:editors>
                        <a:textField id="payment_condition_grid_tf"/>
                    </a:editors>
                </a:grid>
            </a:form>

            <a:form title="四.存续期管理要求"  width="1300" >
                <a:grid id="survive_manage_require_id"  marginHeight="200" marginWidth="120"  bindTarget="prj_meeting_manage_require_ds" >
                    <a:toolBar>
                        <a:button type="add"/>
                        <a:button type="save"/>
                        <a:button type="delete"/>
                    </a:toolBar>
                    <a:columns>
                        <a:column name="row_seq" prompt="序号" width="100" align="center"/>
                        <a:column name="manage_requirements" prompt="存续期管理要求" width="900" editor="manage_require_grid_tf" />
                    </a:columns>
                    <a:editors>
                        <a:textField id="manage_require_grid_tf"/>
                    </a:editors>
                </a:grid>
            </a:form>

            <a:form title="五.风险分类"  width="1300" >
                <a:box column="2" labelWidth="100">
                    <a:comboBox name="five_categories_n" prompt="风险分类" width="200" required="true"   bindTarget="prj_meeting_risk_class_ds"/>
                </a:box>
            </a:form>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
    <a:view-config>
        <c:create-config targetId="dynamicTreeNode_id">
            <p:loop source="/model/prj_project_meeting_notice_path">
                <p:switch test="@order_seq">
                    <p:case value="*">
                        <c:process-config>

                            <a:form title="二.项目要素(方案${@order_seq})">
                                <a:screen-include screen="modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_quatation.lview?quotation_id=${@quotation_id}&amp;order_seq=${@order_seq}&amp;project_id=${@project_id}"/>
                            </a:form>

                        </c:process-config>
                    </p:case>
                </p:switch>
            </p:loop>

        </c:create-config>
    </a:view-config>
</a:screen>
