<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: hxh
    Date: 2020/05/11 9:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_static.lview"/>
        <a:link id="prj_project_wfl_query_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_static_query.lview"/>
        <script><![CDATA[
       // debugger;

        var current_activity_id = parent.currentTaskInfo.task_definition_key;

        var process_instance_id = 0;

        var businessKey = '${/parameter/@businessKey}';
        var url;
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        if(parent.currentTaskInfo.process_instance != undefined){
            process_instance_id = parent.currentTaskInfo.process_instance.id;
        }else{
            process_instance_id = parent.currentTaskInfo.execution_variables[0].execution_id;
        }

        var task_def_key = 'sid-OtsAK3uZ-Z0bF-4pyb-Bcmg-CG0cn3Wn2b2M';
        var task_def_key_temp = 'sid-OtsAK3uZ-Z0bF-4pyb-Bcmg-CG0cn3Wn2b2M';

        var change_flag = 'N';
        var process_definition_id =  parent.currentTaskInfo.process_definition_id;
        if(process_definition_id != undefined){
            var workflow_types = process_definition_id.split(':');
            if(workflow_types[0] == 'PRJ_PROJECT_CHANGEWILL_WFL'){
                change_flag = 'Y';
                task_def_key_temp = 'sid-Tv7WuCW0-Vx8S-4ETp-8CWA-4ZqJgm1Ux1Bi';
            }
        }else{
            var execution_variables = parent.currentTaskInfo.execution_variables;
            for(var i =0;i<execution_variables.length;i++){
                var str = execution_variables[i].cached_value;
                if(typeof(str)=='string'){
                    if(str.indexOf('PRJ_PROJECT_CHANGEWILL_WFL') != -1){
                        change_flag = 'Y';
                        task_def_key_temp = 'sid-Tv7WuCW0-Vx8S-4ETp-8CWA-4ZqJgm1Ux1Bi';
                    }
                }
            }
        }

        /*if(current_activity_id == 'sid-DXwbrged-H3zl-4rlu-8CBD-vB3fNCeUONBr' ){
            task_def_key = 'sid-Tv7WuCW0-Vx8S-4ETp-8CWA-4ZqJgm1Ux1Bi';
        }*/



        var project = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        var projectId = project[0].value;

        var projectOld = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectIdOld";
        });

        var projectIdOld = projectOld[0].value;

        var refProcessInstanceId = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "refProcessInstanceId";
        });
        debugger;
        if(refProcessInstanceId && refProcessInstanceId.length === 1){
            refProcessInstanceId = refProcessInstanceId[0].value;
        }
        if(refProcessInstanceId == undefined){
            refProcessInstanceId = null;
        }

        var edit_flag = 'Y';
        if(current_activity_id != 'sid-0GCxTvA5-IIga-4uMM-8i8A-fb0ZhGmDACw8' && current_activity_id != 'sid-DXwbrged-H3zl-4rlu-8CBD-vB3fNCeUONBr'){
            edit_flag = 'N';
            url = $('prj_project_wfl_query_link_id').getUrl();
            if(change_flag == 'Y'){
                task_def_key = task_def_key_temp;
            }
        }else{
            edit_flag = 'Y';
            url = $('prj_project_wfl_detail_link_id').getUrl();
        }


        var pageChooser = new PageChooser({
            url: url,
            function_code: 'PRJ316F2',
            context_path: '${/request/@context_path}',
            opt: {
                project_id:      projectId,
                // credit_line_id:  creditLineId,
                // maintain_type: maintain_type,
                // function_usage: function_usage,
                process_instance_id: process_instance_id,
                task_def_key: task_def_key,
                change_flag: change_flag,
                refProcessInstanceId: refProcessInstanceId,
                ref_project_id: projectIdOld,
                edit_flag: edit_flag
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>