<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
    <script><![CDATA[

   /* var manufacturerCode = '${/parameter/@manufacturer_code}';
    $L.onReady(function () {
        //碳银隐藏新增、保存、删除
        if (manufacturerCode === 'C000032182') {
            jQuery('#PRJ316F6_D_GRID_ADD_layout_dynamic_button_id').hide();
            jQuery('#PRJ316F6_D_GRID_SAVE_layout_dynamic_button_id').hide();
            jQuery('#PRJ316F6_D_GRID_DELETE_layout_dynamic_button_id').hide();
        }
    });*/

    //新增时调用(grid,table,gridBox)
    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
        if(ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_item_invoice')) {
            record.set("project_lease_item_id", '${/parameter/@project_lease_item_id}');
        }
    };
    //查询时调用(grid,table,gridBox)
    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
        if(ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_item_invoice')) {
            qpara['project_lease_item_id'] = '${/parameter/@project_lease_item_id}';
        }
    };
   ]]></script>
    </a:view>
</a:screen>
