<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ast_fc_estimate_detail_wfl_id"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_ten_enstimate_detial.lview"/>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq){
            //debugger;
            //alert("score_id-->"+'${/parameter/@score_id}');
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_RESULT_ast_fc_estimate_ds':
                    qpara['fc_estimate_id'] = '${/parameter/@fc_estimate_id}';
                    break;
            }
        }

        function ast_fc_estimate_detail_wfl_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            // var status = param.status;
            // var business_type = param.business_type;
            // var type = (status === "APPROVING" || status === 'APPROVED' || status === "CLOSED") ? 'QUERY' : 'MODIFY';

            param['url_title'] = '指标计算明细';
            param['function_usage'] = 'MODIFY';
            param['function_code'] = 'AST010F2';
            param['winid'] = 'ast_fc_estimate_detail_wfl_winid';
            var link_id = 'ast_fc_estimate_detail_wfl_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'AST010', null, null);
        }


        //
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq){
            debugger;
            //BREAK_RATE
            //record.fields.break_rate.setReadOnly(false);
            //record.fields.now_count_status_n.setReadOnly(false);

            var link_function = 'ast_fc_estimate_detail_wfl_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            // if(name=='break_rate'){
            //     record.fields.break_rate.setReadOnly(false);
            // }
            // if(name=='now_count_status'){
            //     record.fields.now_count_status.setReadOnly(false);
            // }
            if (name === 'detial_plan') {
                // record.fields.break_rate.setReadOnly(false);
                // record.fields.now_count_status.setReadOnly(false);
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">计算明细</a>';
            }


        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
