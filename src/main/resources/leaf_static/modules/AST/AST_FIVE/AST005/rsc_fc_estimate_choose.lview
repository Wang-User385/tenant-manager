<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-21
    $Description: 工作流跳转页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="link_id"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_fc_estimate_main_wfl.lview"/>
        <script id="scriptA"><![CDATA[
        // alert(1);
        var businessKey = '${/parameter/@businessKey}';
        if (!businessKey) {
            businessKey = parent.currentTaskInfo.process_instance.business_key;
        }

        var pageChooser = new PageChooser({
            url: $('link_id').getUrl(),
            function_code: 'AST010WFL',
            context_path: '${/request/@context_path}',
            opt: {
                fc_estimate_id: "${/parameter/@businessKey}",
                maintain_type: 'READONLY',
                function_usage: 'UPDATE',
                function_code: 'AST010WFL',
                wfl_bp_flag : '${/parameter/@wflRuleControlFlag}'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

