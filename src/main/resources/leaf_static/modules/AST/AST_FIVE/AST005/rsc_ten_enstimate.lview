<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: yy.chen
    $Date: 2020-02-08
    $Description:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="rsc_create_id_1"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_fc_estimate_add.lview"/>
        <a:link id="ast_fc_estimate_detail_id"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_ten_enstimate_detial.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function (){
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            var param = {};
           // debugger;
            param['url_title'] = '资产分类创建入口';
            param['function_code'] = 'AST010F1';
            param['unit_id'] = '${/session/@unitId}';
            param['winid'] = 'rsc001_detail_win_id';
            param['ds_id'] = ds_id;
            param['screen_width'] = '600';
            param['side'] = 'right';
            param['proposer_employee_name'] = '${/session/@employeeName}';
            var link_id = 'rsc_create_id_1';
            hls_doc_get_layout_code(param, link_id, ds_id, 'AST010F1');
        }



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq){
            //debugger;
            //alert("score_id-->"+'${/parameter/@score_id}');
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_RESULT_ast_fc_estimate_ds':
                    qpara['contract_number'] = '${/parameter/@contract_number}';
                    //管理页面查询自己的单据
                    if('${/parameter/@function_code}' == 'AST010'){
                        qpara['created_by'] = '${/session/@user_id}';
                    }
                    break;
            }
        }

        //评级
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function (){
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            var record = $(ds_id).getSelected();

            if(record.length == 1){
                var contractRecord= record[0].data;
                var fcEstimateId = contractRecord.fc_estimate_id;
                var five_class_plan = contractRecord.five_class_plan;
                Leaf.request({
                    url: "${/request/@context_path}/ast/fc/estimate/result/assessment?fcEstimateId=" + fcEstimateId + "&fiveClassPlan=" + five_class_plan,
                    para: contractRecord,
                    success: function (r) {
                        //  debugger;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "操作成功!", function () {
                            //$('${/parameter/@winid}').close();
                            $(ds_id).query();
                        });
                    },
                    error: function (r) {
                        // $L.Maassets_disposal_detail_id1sker.unmask(document.body);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        // Leaf.showMessage("提示", r.error.message, null);
                        $(ds_id).query();
                    },
                    scope: this
                });
            }
        }


        function ast_fc_estimate_detail_open(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
             var status = param.raise_status;
            var type = (status === "APPROVING" || status === 'APPROVED' || status === "CLOSED") ? 'QUERY' : 'MODIFY';

            param['url_title'] = '指标计算明细';
            param['function_usage'] = type;
            param['function_code'] = 'AST010F2';
            param['winid'] = 'ast_fc_estimate_detail_winid';
            var link_id = 'ast_fc_estimate_detail_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'AST010', null, null);
        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            if(ds.id === ds_id && record){
                if(record.data.raise_status=='APPROVING'||record.data.raise_status=='APPROVED'||'${/parameter/@function_code}' == 'AST010_F1'){
                    record.getField('start_score_desc_n').setReadOnly(true);
                    record.getField('start_ten_class_result_n').setReadOnly(true);
                    record.getField('final_assets_class_result_n').setReadOnly(true);
                    record.getField('plan_id').setReadOnly(true);
                    record.getField('plan_id_n').setReadOnly(true);
                }
            }
        };
        //
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq){

            var link_function = 'ast_fc_estimate_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'detial_plan') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">计算明细</a>';
            }


        };


        //
        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function (){
            //alert(123)
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //debugger;
            var ds_id =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            var record = $(ds_id).getSelected();
            if (record.length != 1) {
                Leaf.showMessage('提示', '至少选择一条评级分类信息提交审批！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }

            if(record.length == 1){
                var contractRecord= record[0].data;

                var fcEstimateId = contractRecord.fc_estimate_id;
                var start_ten_class_result = contractRecord.start_ten_class_result;
               //  if(start_ten_class_result == '' ||  start_ten_class_result == null ){
               //      Leaf.showMessage('提示', '请填写初分十级分类结果！');
               //      return false;
               // }else{
                    if(contractRecord.raise_status=='NEW'||contractRecord.raise_status=='REJECTED') {
                        Leaf.request({
                            url: "${/request/@context_path}/ast/fc/estimate/approval",
                            para: {
                                fcEstimateId:fcEstimateId
                            },
                            success: function (r) {
                                //  debugger;
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                    //$('${/parameter/@winid}').close();
                                    $(ds_id).query();
                                });

                            },
                            error: function (r) {
                                // $L.Maassets_disposal_detail_id1sker.unmask(document.body);
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                // Leaf.showMessage("提示", r.error.message, null);
                                $(ds_id).query();
                            },
                            scope: this
                        });
                    }else{
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "单据状态错误，不予许提交", function () {
                            // $('${/parameter/@winid}').close();
                            $(ds_id).query();
                        });

                    }
               // }




            }else {
                Leaf.showMessage('提示', '只能勾选一条进行审批！');
                return false;
            }
        }

        //忽略保存校验方法
        window['${/parameter/@layout_code}_ignore_required_before_save'] = function() {

            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
        };

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record){

           // debugger;
            window['${/parameter/@layout_code}_not_ignore_required_flag'] = true;
            var check_flag = true;
            //

            var rsc_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            var rsc_record = $(rsc_ds_id).getCurrentRecord();
            var sys_ten_class_result = rsc_record.get('sys_ten_class_result');
            if(sys_ten_class_result==null&& check_flag){
                record.fields.sys_ten_class_result.setReadOnly(true);
                record.fields.start_ten_class_result.setReadOnly(true);
                record.fields.final_assets_class_result.setReadOnly(true);

            }else{

                console.log(rsc_record.get('sys_ten_class_result'))
                console.log(rsc_record.get('start_ten_class_result'))
                record.fields.start_ten_class_result.setReadOnly(false);
                record.fields.final_assets_class_result.setReadOnly(false);

            }



            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        }



        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //debugger;
            var rsc_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            if($(rsc_ds_id).validate()){
                var record = $(rsc_ds_id).data[0].data;
                var planId = record.plan_id;
                Leaf.request({
                    url: "${/request/@context_path}/ast/fc/estimate/update",
                    para: {
                        planId:planId
                    },
                    success: function (r) {

                    },
                    error: function (r) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq){
            debugger;
            var rsc_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_fc_estimate');
            var rsc_record = $(rsc_ds_id).getCurrentRecord();
            var start_score_desc = rsc_record.get('start_score_desc');
            var start_score_desc_n = rsc_record.get('start_score_desc_n');

            //start_ten_class_result
            var start_ten_class_result = rsc_record.get('start_ten_class_result');
            //final_assets_class_result
            var final_assets_class_result = rsc_record.get('final_assets_class_result');
            //A  -
            if(start_score_desc){
                if(start_score_desc=='A'){
                    //
                    rsc_record.set('start_ten_class_result','A');
                    rsc_record.set('start_ten_class_result_n','正常一级');
                    //
                    rsc_record.set('final_assets_class_result','AAA');
                    rsc_record.set('final_assets_class_result_n','正常一级');
                }else if(start_score_desc=='B'){
                    //正常二级
                    //
                    rsc_record.set('start_ten_class_result','B');
                    rsc_record.set('start_ten_class_result_n','正常二级');
                    //
                    rsc_record.set('final_assets_class_result','BBB');
                    rsc_record.set('final_assets_class_result_n','正常二级');
                }else if(start_score_desc=='C'){
                    //正常三级
                    //
                    rsc_record.set('start_ten_class_result','C');
                    rsc_record.set('start_ten_class_result_n','正常三级');
                    //
                    rsc_record.set('final_assets_class_result','CCC');
                    rsc_record.set('final_assets_class_result_n','正常三级');
                }else if(start_score_desc=='D'){
                    //正常四级
                    //
                    rsc_record.set('start_ten_class_result','D');
                    rsc_record.set('start_ten_class_result_n','正常四级');
                    //
                    rsc_record.set('final_assets_class_result','DDD');
                    rsc_record.set('final_assets_class_result_n','正常四级');
                }else if(start_score_desc=='E'){
                    //正常五级
                    //
                    rsc_record.set('start_ten_class_result','E');
                    rsc_record.set('start_ten_class_result_n','正常五级');
                    //
                    rsc_record.set('final_assets_class_result','EEE');
                    rsc_record.set('final_assets_class_result_n','正常五级');
                }else if(start_score_desc=='F'){
                    //关注一级
                    //
                    rsc_record.set('start_ten_class_result','F');
                    rsc_record.set('start_ten_class_result_n','关注一级');
                    //
                    rsc_record.set('final_assets_class_result','FFF');
                    rsc_record.set('final_assets_class_result_n','关注一级');
                }else if(start_score_desc=='G'){
                    //关注二级
                    //
                    rsc_record.set('start_ten_class_result','G');
                    rsc_record.set('start_ten_class_result_n','关注二级');
                    //
                    rsc_record.set('final_assets_class_result','GGG');
                    rsc_record.set('final_assets_class_result_n','关注二级');
                }else if(start_score_desc=='H'){
                    //次级类
                    //
                    rsc_record.set('start_ten_class_result','H');
                    rsc_record.set('start_ten_class_result_n','次级类');
                    //
                    rsc_record.set('final_assets_class_result','HHH');
                    rsc_record.set('final_assets_class_result_n','次级类');
                }else if(start_score_desc=='I'){
                    //可疑类
                    //
                    rsc_record.set('start_ten_class_result','I');
                    rsc_record.set('start_ten_class_result_n','可疑类');
                    //
                    rsc_record.set('final_assets_class_result','III');
                    rsc_record.set('final_assets_class_result_n','可疑类');
                }else if(start_score_desc=='J'){
                    //损失类
                    //
                    rsc_record.set('start_ten_class_result','J');
                    rsc_record.set('start_ten_class_result_n','损失类');
                    //
                    rsc_record.set('final_assets_class_result','JJJ');
                    rsc_record.set('final_assets_class_result_n','损失类');
                }
            }

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
