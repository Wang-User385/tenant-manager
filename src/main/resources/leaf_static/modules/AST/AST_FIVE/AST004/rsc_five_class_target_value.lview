<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: chenli $
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure><![CDATA[
    ]]></a:init-procedure>
    <a:view>
        <div/>
        <script><![CDATA[
            function rsc201_class_target_value_query() {
                $('rsc_five_class_target_value_result_ds').query();
            }
            
            function rsc201_class_target_value_grid_submit() {
                var result_ds = $('rsc_five_class_target_value_result_ds');
                if (result_ds.validate()) {
                    result_ds.submit();
                }
            }


        function rsc201_class_target_value_grid_delete() {
            $('rsc_five_class_target_value_result_ds').remove();
        }
            
            function rsc201_class_target_value_grid_add() {
                $('rsc201_class_target_value_grid').showEditorByRecord($('rsc_five_class_target_value_result_ds').create());
            }
            
            function rsc201_class_target_value_next() {
                history.go(1);
            }
            
            function rsc201_class_target_value_back() {
                history.go(-1);
            }
            
            function rsc201_class_target_value_quit() {
                $('rsc_five_class_target_value').close();
            }
            
         
            
            function five_class_target_value_ef(record, name) {
                if (record.isNew) {
                    return 'rsc_five_class_value_tf';
                } else {
                    return '';
                }
            }
            function rsc201ClassTargetOnAdd(ds, record, index) {
                debugger;
                record.set('five_class_target', '${/parameter/@five_class_target_code}');
                record.set('five_class_target_name', '${/parameter/@five_class_target_name}');

            }
            
            
        ]]></script>
        <a:dataSets>
            <a:dataSet id="rsc_five_class_target_value_query_ds">
                <a:fields>
                    <a:field name="five_class_target" required="true" defaultValue="${/parameter/@five_class_target_code}"/>
                    <a:field name="five_class_target_name" required="true" defaultValue="${/parameter/@five_class_target_name}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="rsc_five_class_target_value_result_ds" autoCount="true" autoQuery="true" queryUrl="${/request/@context_path}/ast/five/class/target/value/query"
                       submitUrl="${/request/@context_path}/ast/five/class/target/value/submit"
                       fetchAll="false"  pageSize="15" queryDataSet="rsc_five_class_target_value_query_ds"  selectable="true">
                <a:fields>
                    <a:field name="five_class_target" required="true"/>
                    <a:field name="five_class_target_name" required="true"/>
                    <a:field name="target_value" required="true"/>
                    <a:field name="value_name" required="true"/>
                    <a:field name="description"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
                <a:events>
                    <a:event name="add" handler="rsc201ClassTargetOnAdd"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:toolbarButton click="rsc201_class_target_value_quit" text="HLS.EXIT"/>
                <a:toolbarButton click="rsc201_class_target_value_query" text="HLS.QUERY"/>
                <a:toolbarButton click="rsc201_class_target_value_grid_add" text="HLS.NEW"/>
                <a:toolbarButton click="rsc201_class_target_value_grid_submit" text="HLS.SAVE"/>
                <a:toolbarButton click="rsc201_class_target_value_grid_delete" text="HLS.REMOVE"/>
            </a:screenTopToolbar>
            <a:grid id="rsc201_class_target_value_grid" bindTarget="rsc_five_class_target_value_result_ds"
                    marginHeight="200" navBar="true" marginWidth="700">
                <a:columns>
                    <a:column name="five_class_target" width="100" prompt="RSC_FIVE_CLASS_TARGET_VALUE.FIVE_CLASS_TARGET"/>
                    <a:column name="five_class_target_name" width="100" prompt="分类指标"/>
                    <a:column name="target_value" prompt="RSC_FIVE_CLASS_TARGET_VALUE.TARGET_VALUE" editorFunction="five_class_target_value_ef" sortable="true" width="100"/>
                    <a:column name="value_name" prompt="RSC_FIVE_CLASS_TARGET_VALUE.VALUE_NAME" editor="rsc_five_class_value_tf" width="100"/>
                    <a:column name="description" prompt="RSC_FIVE_CLASS_TARGET_VALUE.DESCRIPTION" editor="rsc_five_class_value_tf" width="200"/>
                    <a:column name="enabled_flag" prompt="RSC_FIVE_CLASS_TARGET_VALUE.ENABLED_FLAG" editor="rsc_five_class_value_ccb" width="50"/>
                </a:columns>
                <a:editors>
                    <a:textField id="rsc_five_class_value_tf"/>
                    <a:checkBox id="rsc_five_class_value_ccb"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
