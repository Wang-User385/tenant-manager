<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: zhangxing $
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <a:link id="sys_service_welcome_link" url="${/request/@context_path}/welcome.lview"/>
        <div/>
        <script><![CDATA[
        function rsc201_class_target_query() {
            $('rsc_five_class_targets_result_ds').query();
        }

        function rsc201_class_target_grid_submit() {
            var result_ds = $('rsc_five_class_targets_result_ds');
            if (result_ds.validate()) {
                result_ds.submit();
            }
        }

        function  rsc201_class_target_grid_delete(){
           $("rsc201_class_target_grid").remove();
        }

        function rsc201_class_target_grid_add() {
            $('rsc201_class_target_grid').showEditorByRecord($('rsc_five_class_targets_result_ds').create());
        }
        /*function rsc201_class_target_quit() {
            location.href = $('sys_service_welcome_link').getUrl();
            parent.shMenu('show');
        }*/
        function rsc201ModifyPageRenderer(value, record, name) {
            debugger;
            if(record.get('include_target_value')=='Y')
            {
                var five_class_target_code = record.get('five_class_target');
                var five_class_target_name = record.get('five_class_target_name');
                if (record.isNew) {
                    return '';
                }
                return '<a href="javascript:rsc201OpenPage(' + five_class_target_code + ',\''+ five_class_target_name + '\')">${l:RSC_FIVE_CLASS_TARGET.TARGET_VALUE_DEFINE}</a>';
            }
        }

        function rsc201OpenPage(fiveClassTargetCode,fiveClassTargetName) {
            debugger;
            new Leaf.Window({
                id: 'rsc_five_class_target_value',
                url: 'rsc_five_class_target_value.lview?five_class_target_code=' + fiveClassTargetCode+'&five_class_target_name='+fiveClassTargetName,
                title: '资产分类指标明细定义',
                height: 430,
                width: 680
            });
        }function five_class_target_code_ef(record, name) {
            if(record.isNew)
            {
                return 'rsc_five_class_targets_result_grid_tf';
            }
            else
            {
                return '';
            }

        }

        function submitSuccess_reflashResultDs(ds,rec)
        {
            ds.query();
        }


        function usageTypeFunction(record,name)
        {
            if(record.isNew)
            {
                return 'rsc_five_class_targets_result_grid_comb';
            }
            else
            {
                return '';
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="rsc_five_class_target_object" lookupCode="RSC201_TARGET_OBJECT"/>
            <a:dataSet id="rsc_five_class_targets_query_ds"/>
            <a:dataSet id="rsc_data_type" lookupCode="HLS050_DATA_TYPE"/>
            <a:dataSet id="rec200_usage_type_ds" lookupCode="RSC_FIVE_CLASS_USAGE_TYPE"/>
            <a:dataSet id="rsc_five_class_targets_result_ds" autoCount="true"
                       queryUrl="${/request/@context_path}/ast/five/class/target/query"
                       submitUrl="${/request/@context_path}/ast/five/class/target/submit"
                       deleteUrl="${/request/@context_path}/ast/five/class/target/remove"
                       autoQuery="true" fetchAll="false"  pageSize="15" queryDataSet="rsc_five_class_targets_query_ds" selectable="true">
                <a:fields>
                    <a:field name="five_class_target" required="true"/>
                    <a:field name="five_class_target_name" required="true"/>
                    <a:field name="name" required="true"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="include_target_value" checkedValue="Y" defaultValue="N" uncheckedValue="N"/>
                    <!--<a:field name="usage_type_desc" displayField="code_value_name" options="rec200_usage_type_ds" prompt="RSC_FIVE_CLASS_TARGET.USAGE_TYPE" required="true" returnField="usage_type" valueField="code_value"/>-->
                    <a:field name="target_object_desc" displayField="code_value_name" options="rsc_five_class_target_object" prompt="RSC_FIVE_CLASS_TARGET.TARGET_OBJECT" required="true" returnField="target_object" valueField="code_value"/>
                    <a:field name="target_uom_n" lovWidth="500" lovHeight="450" lovGridHeight="300" lovAutoQuery="true"
                             lovService="/ast/uom/selectForLov~com.hand.hls.ast.dto.FndUomCodeLov" prompt="RSC_FIVE_CLASS_TARGET.TARGET_UOM">
                        <a:mapping>
                            <a:map from="uom_code" to="target_uom"/>
                            <a:map from="description" to="target_uom_n"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="target_type_desc" displayField="code_value_name" options="rsc_data_type" required="true" returnField="target_type" valueField="code_value"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="submitSuccess_reflashResultDs"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <!--<a:gridButton click="rsc201_class_target_quit" text="HLS.EXIT"/>-->
               <!-- <a:gridButton click="rsc201_class_target_query" text="HLS.QUERY"/>-->
                <a:gridButton click="rsc201_class_target_grid_add" text="HLS.NEW"/>
                <a:gridButton click="rsc201_class_target_grid_submit" text="HLS.SAVE"/>
                <a:gridButton click="rsc201_class_target_grid_delete" text="HAP.DELETE"/>
            </a:screenTopToolbar>
            <a:grid id="rsc201_class_target_grid" bindTarget="rsc_five_class_targets_result_ds" marginHeight="50"
                    marginWidth="30" navBar="true">
                <a:columns>
                    <a:column name="five_class_target" editorFunction="five_class_target_code_ef" prompt="序号" sortable="true" width="130"/>
                    <a:column name="five_class_target_name" editorFunction="five_class_target_code_ef" prompt="资产分类指标" sortable="true" width="130"/>
                    <a:column name="name" editor="rsc_five_class_targets_result_grid_tf" prompt="RSC_FIVE_CLASS_TARGET.NAME" sortable="true" width="100"/>
                    <a:column name="description" editor="rsc_five_class_targets_result_grid_tf" prompt="RSC_FIVE_CLASS_TARGET.DESCRIPTION" sortable="true" width="200"/>
                    <!--<a:column name="usage_type_desc" editorFunction="usageTypeFunction"  prompt="RSC_FIVE_CLASS_TARGET.USAGE_TYPE"/>-->
                    <a:column name="target_type_desc" editor="rsc_five_class_targets_result_grid_comb" prompt="RSC_FIVE_CLASS_TARGET.TARGET_TYPE" sortable="true" width="100"/>
                    <a:column name="target_uom_n" editor="rsc_five_class_targets_result_grid_lov" prompt="RSC_FIVE_CLASS_TARGET.TARGET_UOM" width="80"/>
                    <a:column name="target_object_desc" editor="rsc_five_class_targets_result_grid_comb" prompt="RSC_FIVE_CLASS_TARGET.TARGET_OBJECT"  width="100"/>
                    <a:column name="include_target_value" editor="rsc_five_class_targets_result_grid_ckb" prompt="RSC_FIVE_CLASS_TARGET.INCLUDE_TARGET_VALUE" width="50"/>
                    <a:column align="center" prompt="RSC_FIVE_CLASS_TARGET.TARGET_VALUE_DEFINE" renderer="rsc201ModifyPageRenderer" width="80"/>
                    <a:column name="enabled_flag" prompt="RSC_FIVE_CLASS_TARGET.ENABLED_FLAG" editor="rsc_five_class_targets_result_grid_ckb" width="50"/>
                </a:columns>
                <a:editors>
                    <a:textField id="rsc_five_class_targets_result_grid_tf"/>
                    <a:checkBox id="rsc_five_class_targets_result_grid_ckb"/>
                    <a:comboBox id="rsc_five_class_targets_result_grid_comb"/>
                    <a:lov id="rsc_five_class_targets_result_grid_lov"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
