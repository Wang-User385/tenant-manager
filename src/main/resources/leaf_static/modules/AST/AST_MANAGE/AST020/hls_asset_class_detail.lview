<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ast020_asset_class_con_detail_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST020/hls_asset_class_contract_detail.lview"/>
        <script><![CDATA[
        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');

            if (ds_id == ds.id) {
                var current_record = $(ds_id).getAll()[0];
                current_record.set('document_type', 'TEMPORARY');
                current_record.set('document_type_n', '临时');
                var currentDate = new Date();
                current_record.set('class_year', currentDate.getFullYear());
                current_record.set('class_year_n', currentDate.getFullYear());
                var currentSeason=getSeasonByMonth(currentDate.getMonth()+1);
                current_record.set('class_season', currentSeason.class_season);
                current_record.set('class_season_n', currentSeason.class_season_n);
            }
        };
        /*根据月份获取对应的季度*/
        function getSeasonByMonth(month) {
            var seasonMap={};
            if (month <= 3) {
                seasonMap['class_season']=1;
                seasonMap['class_season_n']='第一季度';
            }
            else if (month <= 6) {
                seasonMap['class_season']=2;
                seasonMap['class_season_n']='第二季度';
            }
            else if (month <= 9) {
                seasonMap['class_season']=3;
                seasonMap['class_season_n']='第三季度';
            }
            else if(month <= 12){
                seasonMap['class_season']=4;
                seasonMap['class_season_n']='第四季度';
            }
            return seasonMap;
        }

        //确认(分类明细页面)
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            var record=$(ds_id).getAll()[0].data;
            if(!record.bp_id){
                $L.showInfoMessage("提示", "厂商/合作方必填!");
                return;
            }
            var param = {};
            param.bp_id=record.bp_id;
            param.document_type=record.document_type;
            param.class_year=record.class_year;
            param.class_season= record.class_season;
            Leaf.request({
                url: '${/request/@context_path}/hls/asset/class/info/create',
                para: param,
                success: function (data) {
                    var params =data.result.record[0];
                    params['url_title'] = '临时分类明细页面';
                    params['function_code']='AST020_LS_F3';
                    params['function_usage'] = 'CREATE';
                    params['bp_id_n'] = record.bp_id_n;
                    params['document_type_n'] = record.document_type_n;
                    params['class_year_n'] = record.class_year_n;
                    params['class_season_n'] = record.class_season_n;
                    params['winid'] = 'asset_class_con_detail_winid';
                    hls_doc_get_layout_code(params, 'ast020_asset_class_con_detail_id', ds_id, 'AST020_LS_F1');
                },
            });
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
