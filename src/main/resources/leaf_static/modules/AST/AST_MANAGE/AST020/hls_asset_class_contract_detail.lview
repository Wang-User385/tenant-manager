<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ast020_asset_class_con_add"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST020/hls_asset_class_contract_add.lview"/>
        <script><![CDATA[
        //定义一个全局变量，解决新增资产明细时关闭选择页面没有主键问题
        var global_class_head_id;
        var layout_code = '${/parameter/@layout_code}'

        Leaf.onReady(function (){
            debugger
            if (layout_code !== 'AST020S2') {
                //隐藏租赁物分类明细导入按钮
                jQuery('#${/parameter/@layout_code}_G_CON_CLASSIFITION_USER_BUTTON2_layout_dynamic_button_id').hide();
            }
            if('${/parameter/@function_usage}' == 'CREATE'){
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
                var record = $(ds_id).getCurrentRecord();
                record.set('batch_num','${/parameter/@batch_num}');
                record.set('class_year','${/parameter/@class_year}');
                record.set('class_season','${/parameter/@class_season}');
                record.set('approve_status','${/parameter/@approve_status}');
                record.set('bp_id','${/parameter/@bp_id}');
                record.set('document_type','${/parameter/@document_type}');
                record.set('document_type_n','${/parameter/@document_type_n}');
                record.set('submit_by','${/parameter/@submit_by}');
                record.set('unit_id','${/parameter/@unit_id}');
                record.set('bp_name','${/parameter/@bp_id_n}');
                record.set('class_season_n','${/parameter/@class_season_n}');
            }
        });

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var line_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_line');
            var approve_role = '${/parameter/@approve_role}';
            if (line_ds === ds.id) {
                if (record != null && record !== "") {
                    if (approve_role === 'MANAGE') {
                        record.getField("approve_initial_level").setRequired(true);
                        record.getField("approve_initial_level_n").setRequired(true);
                        record.getField("approve_review_level").setRequired(false);
                        record.getField("approve_review_level_n").setRequired(false);
                        record.getField("approve_review_level").setReadOnly(true);
                        record.getField("approve_review_level_n").setReadOnly(true);
                    } else if(approve_role === 'ASSET'){
                        record.getField("approve_initial_level").setRequired(false);
                        record.getField("approve_initial_level").setRequired(false);
                        record.getField("approve_initial_level_n").setReadOnly(true);
                        record.getField("approve_initial_level_n").setReadOnly(true);
                        record.getField("approve_review_level").setRequired(true);
                        record.getField("approve_review_level_n").setRequired(true);
                    }else if(approve_role === 'QUERY'){
                        record.getField("approve_initial_level").setRequired(false);
                        record.getField("approve_initial_level").setRequired(false);
                        record.getField("approve_initial_level_n").setReadOnly(true);
                        record.getField("approve_initial_level_n").setReadOnly(true);
                        record.getField("approve_review_level").setRequired(false);
                        record.getField("approve_review_level_n").setRequired(false);
                        record.getField("approve_review_level").setReadOnly(true);
                        record.getField("approve_review_level_n").setReadOnly(true);
                    }
                }
            }
        };

        //form加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var head_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            var approve_role = '${/parameter/@approve_role}';
            if (head_ds === ds.id) {
                if (approve_role == 'ASSET') {
                    record.getField("description").setRequired(false);
                    record.getField("description").setReadOnly(true);
                }else if(approve_role == 'MANAGE' || approve_role == 'QUERY'){
                    record.getField("description").setRequired(true);
                    record.getField("description").setReadOnly(false);
                }
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            if('${/parameter/@function_usage}' == 'CREATE'){
                var auth_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
                if (ds.id == auth_ds_id) {
                    $(auth_ds_id).setQueryParameter('class_head_id', global_class_head_id);
                }
            }
        };

        //添加
        window['${/parameter/@layout_code}_G_CON_CLASSIFITION_USER_BUTTON1_layout_dynamic_tab_click'] = function (){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            var class_head_id =  $(ds_id).getCurrentRecord().get('class_head_id');

            if(class_head_id == 'undefined' || class_head_id == ''||class_head_id == null){
                Leaf.showMessage("提示", "请先保存!");
                return ;
            }

            var params={};
            params['bp_id']=$(ds_id).getAll()[0].data.bp_id;
            params['class_head_id']=$(ds_id).getAll()[0].data.class_head_id;
            params['url_title'] = '临时合同新增';
            params['function_code']='AST020_LS_S1';
            params['function_usage'] = 'MODIFY';
            params['winid'] = 'asset_class_con_detail_add';
            params['screen_width'] = '1000';
            params['screen_height'] = '750';
            hls_doc_get_layout_code(params, 'ast020_asset_class_con_add', ds_id, 'AST020_LS_F3');
        }

        /*提交审批*/
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function (){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            var record = $(ds_id).getCurrentRecord();
            var class_head_id = record.get('class_head_id');
            var approve_status = record.get('approve_status');
            if (approve_status == 'APPROVING' || approve_status == 'APPROVED') {
                Leaf.showMessage('${HLS.PROMPT}', '该单据不可提交审批，请核对单据状态！');
                return;
            }

            if ($(ds_id).isModified()) {
                Leaf.showMessage('${HLS.PROMPT}', '${l:EXIT_BEFORE_SAVE}');
                return;
            }

            if($(ds_id).validate()){
                new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/hls/asset/class/wfl/submit',
                        para: {
                            class_head_id: class_head_id
                        },
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $('${/parameter/@winid}').close();
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }, function cancel() {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }, 200, 100);
            }
        }


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var line_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_line');
            if(line_ds === ds.id){
                if(name === 'initial_level'){
                    record.set('review_level', value);
                    record.set('approve_initial_level', value);
                    record.set('approve_review_level', value);
                }

                if(name === 'initial_level_n'){
                    record.set('review_level_n', value);
                    record.set('approve_initial_level_n', value);
                    record.set('approve_review_level_n', value);
                }

                if(name === 'approve_initial_level'){
                    record.set('approve_review_level', value);
                }

                if(name === 'approve_initial_level_n'){
                    record.set('approve_review_level_n', value);
                }
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var head_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            global_class_head_id = $(head_ds).getCurrentRecord().get('class_head_id');


            var line_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_line');
            $(line_ds).query();
            $(head_ds).query();
        };

        //导入
        window['${/parameter/@layout_code}_G_CON_CLASSIFITION_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            debugger;
            var layoutCode = '${/parameter/@layout_code}'
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            var class_head_id =  $(ds_id).getCurrentRecord().get('class_head_id');
            var win = new Leaf.Window({
                id: 'ast020_excel_import_open_winid',
                params: {
                    winid: 'ast020_excel_import_open_winid',
                    classHeadId: class_head_id,
                    layoutCode: layoutCode
                },
                url: '${/request/@context_path}/modules/AST/AST_MANAGE/AST020/review_level_excel_import_file.lview',
                title: '资产分类复核级别导入',
                width: 430,
                height: 360
            });
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
