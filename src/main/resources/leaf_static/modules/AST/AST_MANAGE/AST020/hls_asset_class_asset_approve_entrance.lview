<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="ast020_asset_class_detail_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST020/hls_asset_class_contract_detail.lview"/>
        <script><![CDATA[
        var list = parent.currentTaskInfo.execution_variables;
        var param;
        for (var i = 0; i < list.length; i++) {
            if (list[i].name === 'assetClassHead') {
                param = JSON.parse(list[i].value);
            }
        }


        var pageChooser = new PageChooser({
            url: $('ast020_asset_class_detail_id').getUrl() + '?function_code=AST020_LS_S2',
            function_code: 'AST020_LS_S2',
            context_path: '${/request/@context_path}',
            opt: {
                class_head_id: "${/parameter/@businessKey}",
                maintain_type: 'MODIFY',
                function_usage: 'MODIFY',
                batch_num: param.batchNum,
                class_year: param.classYear,
                class_season: param.classSeason,
                class_season_n: param.classSeasonN,
                approve_role:'ASSET'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <!--<a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>-->
    </a:view>
</a:screen>
    
    