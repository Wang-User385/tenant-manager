<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ast020_asset_class_detail_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST020/hls_asset_class_contract_detail.lview"/>
        <script><![CDATA[
        var page = null ;
        var pageSize  = null;
        var index = null;

        var bpIds;
        //查询前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head')
            if (ds === $(ds_id)){
                //详情页返回 需要定位到之前的行
                if(pageSize != null && page!= null && index != null) {
                    $(ds_id).pagesize = pageSize;
                    $(ds_id).goPage(page);
                    $(ds_id).locate(index);
                    page = null;
                    pageSize = null;
                    index = null ;
                }
            }

            if (bpIds !== undefined && bpIds.data.length > 0){
                var ids =[];
                for ( var i = 0; i< bpIds.data.length; i++){
                    console.log("===="+bpIds.data[i])
                    console.log("===="+bpIds.data[i].data.bpId)
                    ids.push(bpIds.data[i].data.bpId)
                }
                console.log(ids)
                ds.setQueryParameter('bp_ids',ids)
            }
        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'class_detail') {
                return '<a href="javascript:open_asset_class_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + config_record.get('prompt') + '</a>';
            }
            if (name == 'bp_id') {
                return '<a href="javascript:open_asset_class_bpid_multilov_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + config_record.get('prompt') + '</a>';
            }
            return value;
        };

        function open_asset_class_detail_win(ds_id, record_id) {
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '分类明细页面';
            if(record.get('document_type') === 'PERIOD' ){
                //调整类型：定时
                param['function_code'] = 'AST020_LS_F2';
            } else{
                //调整类型：临时
                param['function_code'] = 'AST020_LS_F3';
            }
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            param['winid'] = 'asset_class_detail_winid';
            hls_doc_get_layout_code(param, 'ast020_asset_class_detail_id', ds_id, 'AST021');
        }

        function open_asset_class_bpid_multilov_win(ds_id,record_id) {
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            new Leaf.Window({
                id: "bpIdMultiLov",
                url: "${/request/@context_path}/modules/AST/AST_MANAGE/AST021/hls_asset_class_bpid_multilov.lview",
                title: '厂商/合作方选择',
                params: {
                    winId:'bpIdMultiLov'
                },
                fullScreen: false,
                draggable: true,
                closeable: true,
                width: 600,
                height: 500
            }).on('close', function () {
                console.log(bpIds);
                $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head')).query();
            });
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
