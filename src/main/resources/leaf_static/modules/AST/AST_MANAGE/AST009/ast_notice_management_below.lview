<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: tianjie.ge
    $Date: 2020-03-11
    $Revision: 1.0
    $Purpose: AST-AST009-寄送台账
    $Description
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="ast009_new_detail_win_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST009/ast_notice_management_below_new.lview"/>

        <a:link id="ast009_modify_detail_win_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST009/ast_notice_management_below_modify.lview"/>

        <script><![CDATA[
        //查询
        function ast_notice_management_below_query() {
            $('ast_notice_management_below_ds').query();
        }

        //新建
        function ast_notice_management_below_create() {

            var win = new Leaf.Window({
                id: 'ast009_open_detail_winid',
                url: $('ast009_new_detail_win_id').getUrl(),
                params: {
                    winid: 'ast009_open_detail_winid',
                    function_usage: 'CREATE'
                },
                title: '寄送台账新增',
                width: 650,
                height: 475
            });
            win.on('close', function () {
                ast_notice_management_below_query();
            });
        }

        //明细
        function ast_notice_management_below_detail_renderer(value, record, name) {
            if (name = 'notice_id') {
                var notice_id = record.get('notice_id');
                var link_function = 'open_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + notice_id + '\');">明细</a>';
            }
        }

        function open_detail_win(notice_id) {

           var win = new Leaf.Window({
                id: 'ast009_open_detail_winid',
                url:  $('ast009_modify_detail_win_id').getUrl(),
                params: {
                    notice_id: notice_id,
                    winid: 'ast009_open_detail_winid',
                    function_usage: 'MODIFY'
                },
                title: '寄送台账维护',
                width: 650,
                height: 475
            });

            win.on('close', function () {
                ast_notice_management_below_query();
            });

        }


        ]]></script>
        <a:dataSets>

            <a:dataSet id="combo_box_type_notice_type_code_ds" lookupCode="AST008.NOTICE_TYPE"/>
            <a:dataSet id="ast_notice_management_below_query_ds">
                <a:fields>
                    <a:field name="bp_name"/>
                    <a:field name="notice_type" displayField="code_value_name" valueField="code_value"
                             returnField="notice_type"
                             options="combo_box_type_notice_type_code_ds"/>
                    <a:field name="due_date_start"/>
                    <a:field name="due_date_end"/>
                    <a:field name="shipping_date_start"/>
                    <a:field name="shipping_date_end"/>
                </a:fields>
            </a:dataSet>


            <a:dataSet id="ast_notice_management_below_ds" autoPageSize="true" autoQuery="false"
                       queryDataSet="ast_notice_management_below_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/plm/notice/sent/all/query">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="bp_name"/>
                    <a:field name="times"/>
                    <a:field name="cfProject"/>
                    <a:field name="dueAmount"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="calcDate" datatype="date"/>
                    <a:field name="fineDays"/>
                    <a:field name="writeOffFlagDesc"/>
                    <a:field name="notice_type"/>
                    <a:field name="printStatus"/>
                    <a:field name="shipping_date" datatype="date"/>

                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>

            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="ast_notice_management_below_query" text="HAP.QUERY"/>
                <a:gridButton click="ast_notice_management_below_create" text="PROMPT.CREATE"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" labelwidth="100">
                <a:hBox labelWidth="100">
                    <a:textField name="bp_name" bindTarget="ast_notice_management_below_query_ds"
                                 prompt="客户名称"
                                 emptyText="客户名称" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:textField>
                    <a:comboBox name="notice_type" bindTarget="ast_notice_management_below_query_ds"
                                prompt="通知书类型"
                                emptyText="通知书类型" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:comboBox>
                    <a:datePicker name="due_date_start" bindTarget="ast_notice_management_below_query_ds"
                                  prompt="应收日期从"
                                  emptyText="应收日期从" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="due_date_end" bindTarget="ast_notice_management_below_query_ds"
                                  prompt="应收日期到"
                                  emptyText="应收日期到" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:datePicker>
                </a:hBox>
                <a:hBox labelWidth="100">
                    <a:datePicker name="shipping_date_start" bindTarget="ast_notice_management_below_query_ds"
                                  prompt="寄送日期从"
                                  emptyText="寄送日期从" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="shipping_date_end" bindTarget="ast_notice_management_below_query_ds"
                                  prompt="寄送日期到"
                                  emptyText="寄送日期到" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="ast_notice_management_below_query"/>
                        </a:events>
                    </a:datePicker>
                </a:hBox>
            </a:form>
            <a:grid id="ast_notice_management_below_ds_grid" bindTarget="ast_notice_management_below_ds"
                    marginHeight="200" marginWidth="60" navBar="true">
                <a:columns>
                    <a:column width="130" name="contract_number" prompt="业务合同编号"/>
                    <a:column width="200" name="bp_name" prompt="商业伙伴名称"/>
                    <a:column width="50" name="times" prompt="期数" align="center"/>
                    <a:column width="80" name="due_date" prompt="应收日期" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="130" name="notice_type_desc" prompt="通知书类型"/>
                    <a:column width="130" name="courier_company" prompt="快递公司"/>
                    <a:column width="130" name="tracking_number" prompt="快递单号"/>
                    <a:column width="80" name="shipping_date" prompt="寄送日期" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="130" name="recipient" prompt="收件人"/>
                    <a:column width="130" name="recipient_call" prompt="收件电话"/>
                    <a:column width="450" name="recipient_address" prompt="收件地址"/>
                    <a:column width="80" name="notice_id" prompt="明细" align="center"
                              renderer="ast_notice_management_below_detail_renderer"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>