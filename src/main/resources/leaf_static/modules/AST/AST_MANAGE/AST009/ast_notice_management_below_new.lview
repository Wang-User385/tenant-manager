<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020-03-16
    $Revision: 1.0
    $Purpose: AST-AST009-寄送台账-维护
    $Description
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        var notice_id = "";


        function ast_notice_management_below_new_save() {
            var ds = $('ast_notice_management_below_new_ds');
            if (ds.validate()) {
                Leaf.Masker.mask(Ext.getBody(), '保存中。。');
                var record = ds.getAt(0);
                var saveData = [];
                record.set('document_style', 'CON_CONTRACT');

                saveData.push(record.data);
                Leaf.request({
                    url: '${/request/@context_path}/plm/notice/sent/all/submit',
                    para: saveData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        notice_id = res.result.record[0].notice_id;
                        record.set('notice_id',notice_id);
                        //ast_notice_management_below_new_return();
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    sync: true,
                    scope: this
                });

            }
        }

        function attachment_button() {


            var ds = $('ast_notice_management_below_new_ds');
            if (ds.validate()) {
                var record = ds.getCurrentRecord();
                if (record.length == 0 || notice_id == "") {
                    Leaf.showMessage('提示', '请先保存');
                    return
                }
                var table_name = 'PLM_NOTICE_SENT';
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'ast009_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: notice_id,
                        table_name: table_name,
                        winid: 'ast009_open_attachment_winid'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
            }

        }

        function ast_notice_management_below_new_return() {
            $('${/parameter/@winid}').close();
        }

        function recipient_address_lov_click(lov){
            var ds = $('ast_notice_management_below_new_ds');
            var record = ds.getCurrentRecord();
            var recipient_address = record.getMeta().getField('recipient_address');
            recipient_address.setLovPara('bpId', record.get('bp_id'));
        }
        function recipient_lov_click(lov){
            var ds = $('ast_notice_management_below_new_ds');
            var record = ds.getCurrentRecord();
            var recipient = record.getMeta().getField('recipient');
            recipient.setLovPara('bpId', record.get('bp_id'));
        }

        ]]></script>
        <a:dataSets>

            <a:dataSet id="ast_notice_management_below_new_ds"
                       autoCreate="true">
                <a:fields>
                    <a:field name="bp_name"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="notice_type" displayField="code_value_name" valueField="code_value"
                             returnField="notice_type"
                             options="combo_box_type_notice_type_code_ds"/>
                    <a:field name="contract_number" autoComplete="true" required="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/contract/cashflow/queryLov~hls.layout.dto.LovContractCashflowDto"
                             lovWidth="850"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="times" to="times"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="due_date" to="due_date"/>
                            <a:map from="approval_number" to="approval_number"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="notice_type_desc" displayField="code_value_name" valueField="code_value"
                             returnField="notice_type"
                             options="combo_box_type_notice_type_code_ds" required="true" prompt="通知书类型"/>

                    <a:field name="courier_company" required="true" prompt="快递公司"/>
                    <a:field name="tracking_number" required="true" prompt="快递单号"/>
                    <a:field name="shipping_date" datatype="date" required="true" prompt="寄送日期"/>


                    <a:field name="recipient" autoComplete="true" lovGridHeight="350" lovHeight="500"
                             lovLabelWidth="90" lovService="/hls/bp/contact/info/all/query~com.hand.hls.layout.dto.LovHlsBpMasterContactInfoDto"
                             lovWidth="850" required="true" title="收件人" prompt="收件人">
                        <a:mapping>
                            <a:map from="contact_person" to="recipient"/>
                            <a:map from="cell_phone" to="recipient_call"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="recipient_call" readOnly="true" prompt="收件电话"/>
                    <a:field name="recipient_address" required="true" prompt="收件地址"/>

                    <a:field name="recipient_address" autoComplete="true" lovGridHeight="350" lovHeight="500"
                             lovLabelWidth="90" lovService="/hls/bp/address/query~com.hand.hls.layout.dto.LovHlsBpMasterAddressDto"
                             lovWidth="850" required="true" title="收件地址" prompt="收件地址">
                        <a:mapping>
                            <a:map from="address_detail" to="recipient_address"/>
                            <a:map from="zipcode" to="zip_code"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="ast_notice_management_below_new_save" text="保存"/>
                <a:gridButton click="ast_notice_management_below_new_return" text="关闭"/>
            </a:screenTopToolbar>
            <a:form title="寄送信息">
                <a:hBox labelWidth="120">
                    <a:lov name="contract_number" bindTarget="ast_notice_management_below_new_ds"
                           prompt="合同查询编号" width="165"/>
                    <a:textField name="approval_number" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="业务合同编号" width="165" readOnly="true"/>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:textField name="bp_name" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="客户名称" width="165" readOnly="true"/>
                    <a:lov name="times" bindTarget="ast_notice_management_below_new_ds"
                           prompt="期数" width="165" readOnly="true"/>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:datePicker name="due_date" renderer="Leaf.formatDate"
                                  bindTarget="ast_notice_management_below_new_ds"
                                  prompt="应收日期" width="165" readOnly="true"/>

                    <a:comboBox name="notice_type_desc" bindTarget="ast_notice_management_below_new_ds" prompt="通知书类型"
                                width="165"/>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:textField name="courier_company" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="快递公司" width="165"/>

                    <a:textField name="tracking_number" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="快递单号" width="165"/>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:datePicker name="shipping_date" bindTarget="ast_notice_management_below_new_ds"
                                  prompt="寄送日期" width="165"/>

                    <a:lov name="recipient" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="收件人" width="165">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="recipient_lov_click"/>
                        </a:events>
                    </a:lov>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:textField name="recipient_call" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="收件电话" width="165"/>
                    <a:textField name="zip_code" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="邮编" width="165"/>

                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:lov name="recipient_address" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="收件地址" width="455">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="recipient_address_lov_click"/>
                        </a:events>
                    </a:lov>
                </a:hBox>
                <a:hBox labelWidth="120">
                    <a:textField name="description" bindTarget="ast_notice_management_below_new_ds"
                                 prompt="备注" width="455"/>
                </a:hBox>

                <a:hBox labelWidth="120">
                    <a:button click="attachment_button" height="36" text="附件" width="36"/>
                </a:hBox>


            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>