<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_project_detail_win_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST006/ast_asset_management_detail.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            return '<a href="javascript:open_project_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '明细' + '</a>';
        };


        function open_project_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '租金催收';
            param['function_code'] = 'AST006F1'
            param['winid'] = 'project_detail_win';
            param['contract_id'] = record.get('contract_id');
            param['contract_number'] = record.get('contract_number');
            param['function_usage'] = 'QUERY';
            param['collection_status'] = 'APPROVED';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_project_detail_win_id', ds_id, 'AST006F1');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
