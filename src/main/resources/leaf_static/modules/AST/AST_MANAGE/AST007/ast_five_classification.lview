<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ast_five_classification_create_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST007/ast_five_classification_create.lview"/>

        <a:link id="ast_five_classification_list_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST007/ast_five_classification_list.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/plm/five/classification/submit',
                para:{
                    five_classification_type:'FC'
                },
                success: function (res) {
                    debugger;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    console.log(res);

                    var five_classification_id= res.result.record[0].five_classification_id;

                    var ds_id = {};
                    var param = {};
                    param['url_title'] = '五级分类创建创建';
                    param['function_code'] = 'AST007F1';
                    param['five_classification_id']=five_classification_id;


                    param['winid'] = 'ast_five_classification_create_winid';
                    hls_doc_get_layout_code(param, 'ast_five_classification_create_id', ds_id, 'AST007F1');
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = {};
            var param = {};
            param['url_title'] = '五级分类清单';
            param['function_code'] = 'AST007F3';

            param['winid'] = 'ast_five_classification_list_winid';
            hls_doc_get_layout_code(param, 'ast_five_classification_list_id', ds_id, 'AST007F3');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
