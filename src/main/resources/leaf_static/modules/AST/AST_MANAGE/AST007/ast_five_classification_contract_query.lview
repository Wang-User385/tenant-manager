<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        // 取出每条记录的data组成数组传到后台
        function records_handle(record) {
            var new_record = [];
            record.forEach(function (e) {
                new_record.push(e.data);
            });
            return new_record
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var line_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_five_classify_con');
            var select_records = $(line_id).getSelected();
            var five_classification_id='${/parameter/@five_classification_id}';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_five_classification');
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/plm/five/classification/contract/save',
                para: {
                    fiveClassificationContracts: records_handle(select_records),
                    five_classification_id:five_classification_id
                },
                success: function (res) {

                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                   //查询上一页面grid
                   // $(ds_id).query();
                    //$('${/parameter/@ds_id}').query();

                   // 关闭当前页面
                    $('${/parameter/@winid}').close();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });


        };





        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
