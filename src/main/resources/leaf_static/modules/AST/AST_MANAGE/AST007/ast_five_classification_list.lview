<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="classification_list_detail_link_id"
                url="${/request/@context_path}/modules/AST/AST_MANAGE/AST007/ast_five_classification_create.lview"/>
        <script><![CDATA[


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            return '<a href="javascript:open_classification_list_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '明细' + '</a>';
        };

        function open_classification_list_detail_win(ds_id, record_id) {debugger;
            var record = $(ds_id).findById(record_id);
            var status=record.get('status');
            var function_code='';
            var param = {};
            param['url_title'] = '五级分类创建清单';
            param['function_code'] = 'AST007F3';
            param['winid'] = 'classification_list_detail_win';
            param['five_classification_id'] = record.get('five_classification_id');

            if (status == 'NEW' || status == 'APPROVED_RETURN'){
                param['function_usage'] = 'CREATE';
                param['function_code'] = 'AST007F1';
                function_code='AST007F1';

            }
            else {
                param['function_usage'] = 'QUERY';
                param['function_code'] = 'AST007F1';
                function_code='AST007F1';
            }

            hls_doc_get_layout_code(param, 'classification_list_detail_link_id', ds_id, function_code);
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
