<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[


        function sending_management_invoice_screen_query() {
            $('notice_management_above_ds').query();
        }

        function sending_management_invoice_screen_delete() {
            Leaf.showConfirm('${l:HLS.PROMPT}', '确认删除?', function okFun() {
                var records = $('notice_management_above_ds').getSelected();
                var removeData = [];
                for(var i = 0; i < records.length; i++){
                    records[i].set('__status','delete');
                    removeData.push(records[i].data);
                }
                Leaf.request({
                    url: '${/request/@context_path}/ast/notice/manage/remove',
                    para: removeData,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        sending_management_invoice_screen_query();
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody())
                    },
                    sync: true,
                    scope: this
                });
            });
        }


        function sending_management_invoice_screen_print() {
            debugger;
            var ds = $('notice_management_above_ds');
            var records = ds.getSelected();
            var notice_type = records[0].get('notice_type');
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }

            var saveData = [];
            for (var i = 0; i < records.length; i++) {
                if(notice_type == records[i].get('notice_type')){
                    saveData.push(records[i].data);
                }else{
                    $L.showMessage('提示！', '请选择相同类型的通知书进行打印！');
                    return false;
                }
            }

            var win = new Leaf.Window({
                id: 'notice_print_winid',
                url: '${/request/@context_path}/modules/AST/AST_MANAGE/AST008/notice_print_detail.lview',
                params: saveData,
                title: '',
                fullScreen: true
            });
            win.on('close', function () {
                $("notice_management_above_ds").query();
            });
            // Leaf.Masker.mask(Ext.getBody(), '正在打印。。');
            // Leaf.request({
            //     url: '${/request/@context_path}/fct/cashflow/notice/print/file/download',
            //     para: saveData,
            //     success: function (res) {
            //         Leaf.SideBar.show({
            //             msg: '${l:HLS.SUBMIT_SUCCESS}',
            //             duration: 2000
            //         });
            //         sending_management_invoice_screen_query();
            //
            //         Leaf.Masker.unmask(Ext.getBody());
            //     },
            //     error: function () {
            //         Leaf.Masker.unmask(Ext.getBody())
            //     },
            //     failure: function () {
            //         Leaf.Masker.unmask(Ext.getBody())
            //     },
            //     sync: true,
            //     scope: this
            // });
        }

        function sending_management_invoice_screen_create() {
            $('notice_management_above_ds').create();
        }

        function sending_management_invoice_screen_save() {
            debugger;
            var ds = $('notice_management_above_ds');
            if (ds.validate()) {
                var records = ds.getNewRecords();
                if (records.length != 0) {
                    var saveData = [];
                    for(var i = 0; i < records.length; i++){
                        records[i].set('__status','insert');
                        saveData.push(records[i].data);
                    }
                    Leaf.Masker.mask(Ext.getBody(), '正在保存。。');
                    Leaf.request({
                        url: '${/request/@context_path}/ast/notice/manage/submit',
                        para: saveData,
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            sending_management_invoice_screen_query();
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        error: function () {
                            Leaf.Masker.unmask(Ext.getBody())
                        },
                        failure: function () {
                            Leaf.Masker.unmask(Ext.getBody())
                        },
                        sync: true,
                        scope: this
                    });
                }
            }
        }

        function sending_management_invoice_screen_reset() {
            $('sending_management_invoice_query_ds').reset();
        }

        function notice_editor_func(record, name) {
            debugger;
            if (name == 'contract_number') {
                if (record.isNew) {
                    return 'notice_editor_lov';
                }
            }
            if (name == 'notice_type_desc') {
                if (record.isNew) {
                    return 'notice_editor_comboBox';
                }
            }
            if (name == 'templet_name') {
                if (record.isNew) {
                    return 'notice_editor_lov';
                }
            }
        }


        ]]></script>

        <a:dataSets>
            <a:dataSet id="combo_box_type_cf_project_code_ds" lookupCode="CSH301_TRANSACTION_TYPE"/>
            <a:dataSet id="combo_box_type_notice_type_code_ds" lookupCode="AST008.NOTICE_TYPE"/>
            <a:dataSet id="combo_box_type_write_off_flag_code_ds" lookupCode="AST.WRITE_OFF_FLAG"/>
            <a:dataSet id="combo_box_type_print_status_code_ds" lookupCode="AST.PRINT_STATUS"/>
            <a:dataSet id="combo_box_type_cf_project_ds" queryUrl="${/request/@context_path}/fnd/HlsCfItem/query"
                       autoQuery="true"/>
            <!--   查询条件ds-->
            <a:dataSet id="sending_management_invoice_query_ds">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="bp_name"/>

                    <a:field name="cf_project" autoComplete="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/ast/contract/cashflow/item/queryLov~com.hand.hls.layout.dto.LovConCashflowItemLov"
                             lovWidth="450"
                             title="现金流项目" prompt="现金流项目">
                        <a:mapping>
                            <a:map from="cf_project" to="cf_project"/>
                            <a:map from="cf_item" to="cf_item"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="write_off_flag_desc" displayField="code_value_name" valueField="code_value"
                             returnField="write_off_flag"
                             options="combo_box_type_write_off_flag_code_ds"/>
                    <a:field name="print_status_desc" displayField="code_value_name" valueField="code_value"
                             returnField="print_status"
                             options="combo_box_type_print_status_code_ds"/>
                    <a:field name="notice_type_desc" displayField="code_value_name" valueField="code_value"
                             returnField="notice_type"
                             options="combo_box_type_notice_type_code_ds"/>
                </a:fields>
            </a:dataSet>
            <!--通知书grid_ds-->
            <a:dataSet id="notice_management_above_ds" autoPageSize="true" autoQuery="true" fetchAll="false"
                       queryDataSet="sending_management_invoice_query_ds" selectable="true"
                       queryUrl="${/request/@context_path}/ast/notice/manage/cashflow/query">
                <a:fields>
                    <a:field name="contract_number" autoComplete="true" required="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/ast/contract/cashflow/queryLov~com.hand.hls.layout.dto.LovConContractDto"
                             lovWidth="450"
                             title="合同编号" prompt="合同编号">
                        <a:mapping>
                            <a:map from="contract_number" to="contract_number"/>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="cashflow_id" to="cashflow_id"/>
                            <a:map from="contract_name" to="contract_name"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="sending_object" to="sending_object"/>
                            <a:map from="times" to="times"/>
                            <a:map from="cf_project" to="cf_project"/>
                            <a:map from="due_amount" to="due_amount"/>
                            <a:map from="due_date" to="due_date"/>
                            <a:map from="calc_date" to="calc_date"/>
                            <a:map from="fine_days" to="fine_days"/>
                            <a:map from="write_off_flag_desc" to="write_off_flag_desc"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="notice_type_desc" displayField="code_value_name" valueField="code_value"
                             returnField="notice_type" required="true"
                             options="combo_box_type_notice_type_code_ds"/>
                    <a:field name="bp_name"/>
                    <a:field name="send_bp_name"/>
                    <a:field name="times"/>
                    <a:field name="cf_project"/>
                    <a:field name="due_amount"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="calc_date" datatype="date"/>
                    <a:field name="fine_days"/>
                    <a:field name="write_off_flag_desc"/>
                    <a:field name="notice_type"/>
                    <a:field name="print_status"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>

            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="sending_management_invoice_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="sending_management_invoice_screen_reset" text="HAP.RESET"/>
                <a:gridButton bind="notice_management_above_ds_grid" text="手工创建" type="add"/>
                <a:gridButton click="sending_management_invoice_screen_save" text="HAP.SAVE"/>
                <a:gridButton click="sending_management_invoice_screen_delete" text="HAP.DELETE"/>
                <a:gridButton click="sending_management_invoice_screen_print" text="制作/维护通知书"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" labelwidth="140" marginWidth="60">
                <a:hBox labelWidth="140">
                    <a:textField name="contract_number" bindTarget="sending_management_invoice_query_ds"
                                 prompt="合同编号"
                                 emptyText="合同编号" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:textField>
                    <a:textField name="bp_name" bindTarget="sending_management_invoice_query_ds"
                                 prompt="客户名称"
                                 emptyText="客户名称" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:textField>
                    <a:lov name="cf_project" bindTarget="sending_management_invoice_query_ds"
                                prompt="现金流项目"
                                emptyText="现金流项目" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:lov>
                    <a:comboBox name="notice_type_desc" bindTarget="sending_management_invoice_query_ds"
                                prompt="通知书类型"
                                emptyText="通知书类型" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:comboBox>
                </a:hBox>
                <a:hBox labelWidth="140">
                    <a:datePicker name="due_date_start" bindTarget="sending_management_invoice_query_ds"
                                  prompt="应收日期从"
                                  emptyText="应收日期从" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="due_date_end" bindTarget="sending_management_invoice_query_ds"
                                  prompt="应收日期到"
                                  emptyText="应收日期到" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:comboBox name="write_off_flag_desc" bindTarget="sending_management_invoice_query_ds"
                                prompt="核销状态" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:comboBox>
                    <a:comboBox name="print_status_desc" bindTarget="sending_management_invoice_query_ds"
                                prompt="打印状态" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="sending_management_invoice_screen_query"/>
                        </a:events>
                    </a:comboBox>
                </a:hBox>
            </a:form>
            <a:grid id="notice_management_above_ds_grid" bindTarget="notice_management_above_ds"
                    marginHeight="200" marginWidth="60" navBar="true" >
                <a:columns>
                    <a:column width="130" name="payment_number" prompt="支付表编号"/>
                    <a:column width="130" name="contract_number" prompt="合同编号" editorFunction="notice_editor_func"/>
                    <a:column width="200" name="bp_name" prompt="客户名称"/>
                    <a:column width="130" name="sending_object" prompt="发送对象"/>
                    <a:column width="50" name="times" prompt="期数" align="right"/>
                    <a:column width="130" name="cf_project" prompt="现金流项目" align="left"/>
                    <a:column width="130" name="due_amount" prompt="应收金额" renderer="Leaf.formatMoney" align="right"/>
                    <a:column width="80" name="due_date" prompt="应收日期" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="80" name="calc_date" prompt="计算日" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="80" name="fine_days" prompt="逾期天数" align="right"/>
                    <a:column width="100" name="write_off_flag_desc" prompt="核销状态"/>
                    <a:column width="120" name="notice_type_desc" prompt="通知书类型" editorFunction="notice_editor_func"/>
                    <a:column width="180" name="templet_code" prompt="通知书代码" editorFunction="notice_editor_func"/>
                    <a:column width="180" name="templet_name" prompt="通知书模版" editorFunction="notice_editor_func"/>
                    <a:column width="80" name="print_status_desc" prompt="打印状态"/>
                </a:columns>
                <a:editors>
                    <a:lov id="notice_editor_lov"/>
                    <a:textField id="notice_editor_text"/>
                    <a:comboBox id="notice_editor_comboBox"/>
                </a:editors>
            </a:grid>

        </a:screenBody>
    </a:view>
</a:screen>

