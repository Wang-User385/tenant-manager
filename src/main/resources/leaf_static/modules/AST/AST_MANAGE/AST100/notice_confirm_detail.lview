<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.bp.service.HlsCusBpMasterService.queryCreatedName"
                       rootPath="user_name_query"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        Leaf.onReady(function () {
            var record = $('notice_management_templet_ds').getCurrentRecord();
            record.set('creation_date', new Date());
            record.set('created_by', '${/model/user_name_query/record/@NAME}');
            record.set('unit_name', '${/model/user_name_query/record/@UNIT_NAME}');
        });

        function notice_management_detail_ds_query() {
            $('notice_management_detail_ds').query();
        }

        function sending_management_invoice_detail_quit() {
            $('notice_print_winid').close();
            $('notice_management_detail_ds').query();
        }

        function sending_management_invoice_detail_save() {
            debugger;
            var ds_id = $('notice_management_detail_ds');
            // if(ds.getSelected().length = 0){
            //     var records = ds.getAll();
            // }else{
            // var records = ds.getSelected();
            // // }
            // var saveData = [];
            // for (var i = 0; i < records.length; i++) {
            //     records[i].set('__status', 'update');
            //     saveData.push(records[i].data);
            // }
            // Leaf.request({
            //     url: '${/request/@context_path}/ast/notice/manage/submit',
            //     para: saveData,
            //     success: function (res) {
            //         Leaf.SideBar.show({
            //             msg: '${l:HLS.SUBMIT_SUCCESS}',
            //             duration: 2000
            //         });
            //         notice_management_detail_ds_query();
            //         Leaf.Masker.unmask(Ext.getBody());
            //     },
            //     error: function () {
            //         Leaf.Masker.unmask(Ext.getBody())
            //     },
            //     failure: function () {
            //         Leaf.Masker.unmask(Ext.getBody())
            //     },
            //     sync: true,
            //     scope: this
            // });
            ds_id.submit();
        }

        function sending_management_invoice_detail_print() {
            // debugger;
            var temp_ds = $('notice_management_detail_ds');
            if (temp_ds.validate()) {
                var records = temp_ds.getSelected();
                if (records.length < 1) {
                    Leaf.showMessage('提示！', '请至少选择一条记录！');
                    return false;
                }
                var saveData = [];
                var printData = [];
                for (var a = 0; a < records.length; a++) {
                    records[a].set('__status','update');
                    saveData.push(records[a].data);
                }
                Leaf.request({
                    url: "${/request/@context_path}/ast/notice/manage/submit",
                    para: saveData,
                    type: "POST",
                    success: function (res) {
                        Leaf.Masker.mask(Ext.getBody(), '正在打印。。');
                        for (var i = 0; i < records.length; i++) {
                            printData.push(records[i].data.notice_manage_id);
                        }
                        console.log(printData);
                        jQuery('#download_notice').attr('href', '${/request/@context_path}/ast/notice/print/file/download?saveData=' + printData);
                        jQuery('#download_notice')[0].click();
                        setTimeout(function() {
                            temp_ds.query();
                        }, 2000);
                        //temp_ds.query();
                        $L.Masker.unmask(document.body);
                    },
                    scope: this
                });
                temp_ds.query();
            }
        }

        function attachment_file_render(value, record) {
            var table_name = 'AST_NOTICE_MANAGE';
            if (record.get('attachment_id') == null || record.get('attachment_id') == undefined || record.get('attachment_id') == '') {
                return '';
            } else {
                return '<a href="javascript:rw100a_open_attach(\'' + record.get('notice_manage_id') + '\',\'' + table_name + '\')">附件</a>';
            }
        }

        function rw100a_open_attach(notice_manage_id, table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'ast008_open_attachment_winid',
                url: url,
                params: {
                    header_id: notice_manage_id,
                    table_name: table_name,
                    winid: 'ast008_open_attachment_winid',
                    function_usage:'QUERY'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('rw_detail_file_data_ds').query();
            });
        }

        function sending_management_invoice_detail_edit() {
            debugger;
            var temp_ds = $('notice_management_detail_ds');
            var records = temp_ds.getSelected();
            if (records.length == 0) {
                $L.showMessage('提示！', '请至少选择一条记录！');
                return false;
            } else {
                var data = [];
                for (var i = 0; i < records.length; i++) {
                    var print_status = records[i].get('print_status');
                    if (print_status === 'APPLY' || print_status === 'Y') {
                        $L.showMessage('提示！', '请选择未打印和已退回的通知书提交申请！');
                        return false;
                    }
                }

                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认提交打印申请?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody());
                    for (var i = 0; i < records.length; i++) {
                        // records[i].set('unit_id', '${/session/@unitId}');
                        records[i].set('user_id', '${/session/@userId}');
                        records[i].set('apply_time', new Date());
                        records[i].set('print_status', 'APPLY');
                        records[i].set('__status', 'update');
                        data.push(records[i].data);
                    }
                    Leaf.request({
                        url: "${/request/@context_path}/ast/notice/manage/submit",
                        para: data,
                        type: "POST",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            temp_ds.query();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            temp_ds.query();
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            temp_ds.query();
                        },
                        scope: this
                    });
                }, function cancel() {
                    Leaf.Masker.unmask(Ext.getBody());
                }, 200, 100);
            }
        }

        function notice_management_detail_ds_query_event() {
            debugger;
            // var records = $(ds).getSelected();
            var a = '${/parameter/@saveData}'.split(',');

            var noticeManageIds = [];
            for (var i = 0; i < a.length; i++) {
                noticeManageIds.push(a[i]);
            }
            $('notice_management_detail_ds').setQueryParameter('noticeManageIds', noticeManageIds);
        }

        function temp_lov_before_event(lov) {
            debugger;
            var ds = $('notice_management_detail_ds');
            var record = ds.getCurrentRecord();
            var notice_type = record.get('notice_type');
            var templet_code = record.getMeta().getField('templet_code');
            templet_code.setLovPara('templetNameStr', notice_type);

        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="notice_management_detail_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/ast/notice/manage/cashflow/query"
                       submitUrl="${/request/@context_path}/ast/notice/manage/submit">
                <a:fields>
                    <a:field name="templet_code" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100" required="true"
                             lovService="/ast/notice/templet/queryLov~com.hand.hls.layout.dto.LovNoticeTempDto"
                             lovWidth="600"
                             title="模板选择">
                        <a:mapping>
                            <a:map from="templet_code" to="templet_code"/>
                            <a:map from="templet_name" to="templet_name"/>
                            <a:map from="templet_id" to="templet_id"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_name"/>
                    <a:field name="sending_object"/>
                    <a:field name="times"/>
                    <a:field name="cf_project"/>
                    <a:field name="due_amount"/>
                    <a:field name="due_date" datatype="date"/>
                    <a:field name="calc_date" datatype="date"/>
                    <a:field name="fine_days"/>
                    <a:field name="write_off_flag_desc"/>
                    <a:field name="notice_type"/>
                    <a:field name="print_status"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="notice_management_detail_ds_query_event"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="notice_management_templet_ds" autoCreate="true">
                <a:fields>
                    <!--                    <a:field name="notice_type_desc" displayField="code_value_name" valueField="code_value"-->
                    <!--                             required="true"-->
                    <!--                             returnField="notice_type"-->
                    <!--                             options="combo_box_type_notice_type_code_ds"/>-->
                    <!--                    <a:field name="templet_code" autoComplete="true" lovGridHeight="300" lovHeight="510"-->
                    <!--                             lovLabelWidth="100" required="true"-->
                    <!--                             lovService="/ast/notice/templet/queryLov~com.hand.hls.layout.dto.LovNoticeTempDto"-->
                    <!--                             lovWidth="600"-->
                    <!--                             title="模板选择">-->
                    <!--                        <a:mapping>-->
                    <!--                            <a:map from="templet_code" to="templet_code"/>-->
                    <!--                            <a:map from="templet_name" to="templet_name"/>-->
                    <!--                            <a:map from="templet_id" to="templet_id"/>-->
                    <!--                        </a:mapping>-->
                    <!--                    </a:field>-->
                    <!--                    <a:field name="templet_name" readOnly="true"/>-->
                    <a:field name="created_by" readOnly="true"/>
                    <a:field name="creation_date" readOnly="true"/>
                    <a:field name="unit_name" readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a id="download_notice" style="display: none"/>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="sending_management_invoice_detail_quit" text="退出"/>
<!--                <a:gridButton click="sending_management_invoice_detail_save" text="HAP.SAVE"/>-->
<!--                <a:gridButton click="sending_management_invoice_detail_print" text="生成并下载通知书"/>-->
<!--                <a:gridButton click="sending_management_invoice_detail_edit" text="提交打印申请"/>-->
            </a:screenTopToolbar>
            <a:form title="模板选择">
                <a:box column="3" labelWidth="150">
                    <a:textField name="created_by" bindTarget="notice_management_templet_ds" prompt="创建人" width="150"/>
                    <a:textField name="unit_name" bindTarget="notice_management_templet_ds" prompt="部门" width="150"/>
                    <a:datePicker name="creation_date" bindTarget="notice_management_templet_ds" prompt="创建时间"
                                  width="150"/>
                </a:box>
            </a:form>
            <a:grid id="notice_management_detail_ds_grid" bindTarget="notice_management_detail_ds"
                    marginHeight="200" marginWidth="60" navBar="true">
                <a:columns>
                    <a:column width="130" name="payment_number" prompt="支付表编号"/>
                    <a:column width="130" name="contract_number" prompt="合同编号"/>
                    <a:column width="200" name="bp_name" prompt="商业伙伴名称"/>
                    <a:column width="130" name="sending_object" prompt="发送对象" editor="detail_text"/>
                    <a:column width="50" name="times" prompt="期数" align="right"/>
                    <a:column width="130" name="cf_project" prompt="现金流项目" align="left"/>
                    <a:column width="130" name="due_amount" prompt="应收金额" renderer="Leaf.formatMoney" align="right"/>
                    <a:column width="80" name="due_date" prompt="应收日期" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="80" name="calc_date" prompt="计算日" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="80" name="fine_days" prompt="逾期天数" align="right"/>
                    <a:column width="100" name="write_off_flag_desc" prompt="核销状态"/>
                    <a:column width="120" name="notice_type_desc" prompt="通知书类型"/>
                    <a:column width="180" name="templet_code" prompt="通知书模版" editor="detail_lov"/>
                    <a:column width="180" name="templet_name" prompt="模版名称"/>
                    <a:column width="80" name="print_status_desc" prompt="打印状态"/>
                    <a:column width="80" name="detail" prompt="通知书附件" renderer="attachment_file_render"/>
                </a:columns>
<!--                <a:editors>-->
<!--                    <a:editor>-->
<!--                        <a:textField id="detail_text"/>-->
<!--                        <a:lov id="detail_lov">-->
<!--                            <a:events>-->
<!--                                <a:event name="beforetriggerclick" handler="temp_lov_before_event"/>-->
<!--                            </a:events>-->
<!--                        </a:lov>-->
<!--                    </a:editor>-->
<!--                </a:editors>-->
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>