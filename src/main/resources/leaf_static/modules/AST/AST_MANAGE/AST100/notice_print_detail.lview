<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        function rw100a_open_attach(notice_manage_id, table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'ast008_open_attachment_winid',
                url: url,
                params: {
                    header_id: notice_manage_id,
                    table_name: table_name,
                    winid: 'ast008_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('rw_detail_file_data_ds').query();
            });
        }

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_notice_manage');
            if(ds_id && ds_id == ds.id){
                ds.setQueryParameter('dis_print_status', 'N');
            }
        };

        //批量下载
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var temp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_notice_manage');
            if ($(temp_ds).validate()) {
                var records = $(temp_ds).getSelected();
                if (records.length < 1) {
                    Leaf.showMessage('提示！', '请至少选择一条记录！');
                    return;
                }
                var saveData = [];
                for (var i = 0; i < records.length; i++) {
                    saveData.push(records[i].data.notice_manage_id);
                }

                Leaf.Masker.mask(Ext.getBody(), '正在打印。。');
                console.log(saveData);
                jQuery('#download_notice').attr('href', '${/request/@context_path}/ast/notice/print/file/download?saveData=' + saveData);
                jQuery('#download_notice')[0].click();
                $L.Masker.unmask(document.body);
            }
        };



        //确认打印
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var temp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_notice_manage');
            debugger;
            var records = $(temp_ds).getSelected();
            if (records.length == 0) {
                $L.showMessage('提示！', '请至少选择一条记录！');
                return false;
            } else {
                var data = [];
                for (var i = 0; i < records.length; i++) {
                    var print_status = records[i].get('print_status');
                    if (print_status != 'APPLY') {
                        $L.showMessage('提示！', '请选择已申请打印的通知书退回！');
                        return false;
                    }
                }

                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认已经打印?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody());
                    for (var i = 0; i < records.length; i++) {
                        records[i].set('print_status', 'Y');
                        records[i].set('__status', 'update');
                        data.push(records[i].data);
                    }
                    Leaf.request({
                        url: "${/request/@context_path}/ast/notice/manage/submit",
                        para: data,
                        type: "POST",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(temp_ds).query();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            $(temp_ds).query();
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            $(temp_ds).query();
                        },
                        scope: this
                    });
                }, function cancel() {
                    Leaf.Masker.unmask(Ext.getBody());
                }, 200, 100);
            }
        };

        //退回修改
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var temp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_notice_manage');
            debugger;
            var records = $(temp_ds).getSelected();
            if (records.length === 0) {
                $L.showMessage('提示！', '请至少选择一条记录！');
                return false;
            } else {
                var data = [];
                for (var i = 0; i < records.length; i++) {
                    var print_status = records[i].get('print_status');
                    if (print_status !== 'APPLY') {
                        $L.showMessage('提示！', '请选择已申请打印的通知书退回！');
                        return false;
                    }
                }

                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认退回?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody());
                    for (var i = 0; i < records.length; i++) {
                        records[i].set('print_status', 'REJUST');
                        records[i].set('__status', 'update');
                        data.push(records[i].data);
                    }
                    Leaf.request({
                        url: "${/request/@context_path}/ast/notice/manage/submit",
                        para: data,
                        type: "POST",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                msg: '${l:HLS.SUBMIT_SUCCESS}',
                                duration: 2000
                            });
                            $(temp_ds).query();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            $(temp_ds).query();
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            $(temp_ds).query();
                        },
                        scope: this
                    });
                }, function cancel() {
                    Leaf.Masker.unmask(Ext.getBody());
                }, 200, 100);
            }
        };

        //查看明细
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            debugger;
            var ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ast_notice_manage');
            var records = $(ds).getSelected();
            var notice_type = records[0].get('notice_type');
            if (records.length == 0) {
                Leaf.showMessage('提示！', '请至少选择一条记录！');
                return;
            }

            var saveData = [];
            for (var i = 0; i < records.length; i++) {
                if(notice_type == records[i].get('notice_type')){
                    saveData.push(records[i].data.notice_manage_id);
                }else{
                    $L.showMessage('提示！', '请选择相同类型的通知书进行打印！');
                    return false;
                }
            }

            var win = new Leaf.Window({
                id: 'notice_print_winid',
                url: '${/request/@context_path}/modules/AST/AST_MANAGE/AST100/notice_confirm_detail.lview',
                params: {saveData:saveData.join(',')},
                title: '',
                fullScreen: true
            });
            win.on('close', function () {
            });
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var table_name = 'AST_NOTICE_MANAGE';
            debugger;
            if (name === 'detail') {
                if (record.get('attachment_id') == null || record.get('attachment_id') == undefined || record.get('attachment_id') == '') {
                    return '';
                } else {
                    return '<a href="javascript:window[\'' + 'rw100a_open_attach' + '\'](\'' + record.get('notice_manage_id') + '\',\'' + table_name + '\')">附件</a>';
                }
            }
        };

        ]]></script>
        <a id="download_notice" style="display: none"/>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
