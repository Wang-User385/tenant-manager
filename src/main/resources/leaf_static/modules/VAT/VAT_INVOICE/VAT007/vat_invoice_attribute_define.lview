<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        
        function onLoad_vat_invoice_attribute_define_ds() {

        }

        /**
         * 保存
         */
        function vat_invoice_attribute_define_save() {
            var ds = $('vat_invoice_attribute_define_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/vat/invoice/attribute/submit');
                ds.submit();
            }
        }

        function onSubmitSuccess_vat_invoice_attribute_define_ds() {
            
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_invoice_attribute_define_query_ds">
            </a:dataSet>

            <a:dataSet id="vat_invoice_attribute_define_ds"
                       queryDataSet="vat_invoice_attribute_define_query_ds" autoQuery="true" autoPageSize="true"
                       queryUrl="${/request/@context_path}/vat/invoice/attribute/query">
                <a:fields>
                    <a:field name="company_code"/>

                </a:fields>
                <a:events>
                    <a:event name="load" handler="onLoad_vat_invoice_attribute_define_ds"/>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_invoice_attribute_define_ds"/>
                </a:events>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="vat_invoice_attribute_define_save" text="HLS.SAVE"/>
            </a:screenTopToolbar>
            <a:form>
                <a:box column="2" labelWidth="100">
                    <a:textField name="company_code" prompt="公司代码" bindTarget="vat_invoice_attribute_define_ds" width="200" readOnly="true"/>
                    <a:textField name="company_full_name" prompt="公司名称" bindTarget="vat_invoice_attribute_define_ds" width="500" readOnly="true"/>
                </a:box>

                <a:box column="3" labelWidth="100">
                    <a:numberField name="special_invoice_limit" prompt="增值税专票限额" renderer="Leaf.formatMoney" allowDecimals="true" allowNegative="false" allowFormat="true" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:numberField name="normal_invoice_limit" prompt="增值税普票限额" renderer="Leaf.formatMoney" allowDecimals="true" allowNegative="false" allowFormat="true" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:numberField name="line_limit" prompt="最大发票行数" allowDecimals="false" allowNegative="false" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                </a:box>

                <a:box column="4" labelWidth="100">
                    <a:textField name="invoice_title" prompt="开票公司名称" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:textField name="tax_registry_num" prompt="纳税人识别号" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:textField name="invoice_address" prompt="地址" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:textField name="invoice_phone" prompt="电话" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                </a:box>

                <a:box column="1" labelWidth="100">
                    <a:textField name="invoice_bank" prompt="开户行" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                    <a:textField name="invoice_bank_account" prompt="银行账号" bindTarget="vat_invoice_attribute_define_ds" width="200"/>
                </a:box>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
