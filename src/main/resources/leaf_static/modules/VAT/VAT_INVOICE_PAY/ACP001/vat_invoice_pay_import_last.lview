<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="ACP_INVOICE_LN"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function saveBtn() {
            $("temp_interface_ds").getAll().forEach(function (i) {
                i.dirty = true;
            });
            $("temp_interface_ds").submit();
            // top.refreshFrame();
        }

        function disableBtn() {
            $('saveBtn_id').disable();
            top.refreshFrame();
        }

        function returnBack() {
            top.refreshFrame();
        }

        function dateFormat(value,record,name) {
            debugger
            if (name == 'record_date') {
                return value.split(' ')[0]
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="tax_type_rate_ds">
                <a:datas>
                    <a:record code_value="0.03" code_value_name="3%"/>
                    <a:record code_value="0.05" code_value_name="5%"/>
                    <a:record code_value="0.06" code_value_name="6%"/>
                    <a:record code_value="0.09" code_value_name="9%"/>
                    <a:record code_value="0.13" code_value_name="13%"/>
                    <a:record code_value="0" code_value_name="0%"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="temp_interface_ds" fetchAll="true" autoQuery="true"
                       queryDataSet="temp_interface_query_ds"
                       queryUrl="${/request/@context_path}/acp/invoice/ln/selectImportTempList?headerId=${/model/header/record/@header_id}"
                       submitUrl="${/request/@context_path}/acp/invoice/ln/confirmImport">
                <a:fields>
                        <a:field name="tax_type_rate_n" options="tax_type_rate_ds" displayField="code_value_name"
                                 valueField="code_value"
                                 returnField="tax_type_rate"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="THE_IMPORTED_DATA" width="980">
                <a:grid id="temp_interface_grid_id" bindTarget="temp_interface_ds" marginHeight="150" navBar="true"
                        width="980">
                    <a:columns>
                        <a:column name="error_msg" prompt="错误信息"/>
                        <a:column name="contract_id_n" prompt="合同编号"/>
                        <a:column name="contract_name" prompt="合同名称"/>
                        <a:column name="cf_item_n" prompt="应付项目"/>
                        <a:column name="invoice_type_n" prompt="发票类别"/>
                        <a:column name="invoice_code" prompt="发票代码"/>
                        <a:column name="invoice_number" prompt="发票号码"/>
                        <a:column name="record_date" prompt="开票日期" renderer="dateFormat"/>
                        <a:column name="bp_name" prompt="销售方名称"/>
                        <a:column name="ref_v01" prompt="货物或应税劳务、服务名称"/>
<!--
                        <a:column name="bp_tax_registry_num" prompt="销方税号"/>
-->
                        <a:column name="total_amount" prompt="价税合计" renderer="Leaf.formatMoney"/>
                        <a:column name="tax_type_rate_n" prompt="税率" renderer="Leaf.formatMoney"/>
<!--
                        <a:column name="tax_amount" prompt="税额" renderer="Leaf.formatMoney"/>
-->
                        <a:column name="description" prompt="备注"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
