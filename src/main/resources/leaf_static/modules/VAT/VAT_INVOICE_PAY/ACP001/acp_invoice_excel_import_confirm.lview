    $Purpose: 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId" rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator="," template_code="ACP_INVOICE_LN"
                        status_field="/parameter/@ImportSuccess" user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function import_confirm() {
            debugger;
            Leaf.request({
                type : 'POST',
                url : "${/request/@context_path}/vat/acp/invoice/excel/import?headerId=" + '${/model/header/record/@header_id}',
                async: false, //设为同步
                contentType : "application/json; charset=utf-8",
                success : function(res) {
                    var success = res.success;
                    new Leaf.showConfirm('${l:HLS.PROMPT}', res.message, function okFun() {
                        top.refreshFrame();
                    }, function cancel() {
                        top.refreshFrame();
                    }, 200, 100);
                }
                // Leaf.Masker.mask(Ext.getBody(), '收入确认中...');
        });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_invoice_pay_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/acp/invoice/ln/selectImportTempList?headerId=${/model/header/record/@header_id}" selectable="true">
                <a:fields>
                    <a:field name="invoice_code" required="true"/>
                    <a:field name="invoice_number" required="true"/>
                    <a:field name="record_date" required="true" datatype="date"/>
                    <a:field name="net_amount" required="true"/>
                    <a:field name="tax_amount" required="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody id="testScreenBody">
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="import_confirm" text="确认导入"/>
            </a:screenTopToolbar>
            <a:grid id="vat_invoice_import_grid" bindTarget="vat_invoice_pay_ds" marginHeight="190" marginWidth="10">
                <a:columns>
                    <a:column name="attributes_1" width="130" prompt="序号" align="left"/>
                    <a:column name="attributes_2" width="160" prompt="发票代码" align="left"/>
                    <a:column name="attributes_3" width="160" prompt="发票号码" align="left"/>
                    <a:column name="attributes_4" width="100" prompt="开票日期" align="left" renderer="Leaf.formatDate"/>
                    <a:column name="attributes_5" width="100" prompt="销方税号" align="left"/>
                    <a:column name="attributes_6" width="130" prompt="销方名称" align="left"/>
                    <a:column name="attributes_7" width="150" prompt="金额" align="right" renderer="Leaf.formatMoney"/>
                    <a:column name="attributes_8" width="160" prompt="税额" align="right" renderer="Leaf.formatMoney"/>
                    <a:column name="attributes_9" width="160" prompt="认证方式" align="left"/>
                    <a:column name="attributes_10" width="100" prompt="确认/认证日期"  align="left" renderer="Leaf.formatDate"/>
                    <a:column name="attributes_11" width="100" prompt="发票类型" align="left"/>
                    <a:column name="attributes_12" width="100" prompt="发票状态" align="left"/>
                    <a:column name="attributes_13" width="150" prompt="合同编号" align="left"/>
                    <a:column name="attributes_14" width="150" prompt="合同名称" align="left"/>
                </a:columns>
                <a:editors>
                    <a:textField id="vat_invoice_pay_ds_grid_tf"/>
                    <a:datePicker id="vat_invoice_pay_ds_grid_dp"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
        <script><![CDATA[
	  	]]></script>
    </a:view>
</a:screen>
