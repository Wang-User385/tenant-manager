<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function vat_invoice_pay_confirm_query() {
            $('vat_invoice_pay_confirm_ds').query();
        }

        function vat_invoice_pay_confirm_reset() {
            $('vat_invoice_pay_confirm_query_ds').reset();
            $('vat_invoice_pay_confirm_ds').query();
        }

        function vat_invoice_pay_confirm_confirm() {
            debugger;
            var records = $('vat_invoice_pay_confirm_ds').getSelected();
            if (records.length == 0) {
                Leaf.showMessage("提示", "请选择发票!", null);
                return;
            }
            /*for (var i = 0; i < records.length; i++) {
                var record = records[i];
                var attach_count = record.get('attach_count');
                if (attach_count == 0) {
                    Leaf.showMessage('提示', '发票需要的附件未上传，不能做确认!');
                    return;
                }
            }*/
            $('vat_invoice_pay_confirm_ds').submitSelected();
        }

        function onSubmitSuccess_vat_invoice_pay_confirm_ds(ds) {
            vat_invoice_pay_confirm_query();
        }

        function atm_render(value, record, name) {
            return '<a href="javascript:winOpen_attach(\'' + value + '\');">附件上传</a>';
        }

        function winOpen_attach(invoice_ln_id) {
            new Leaf.Window({
                id: 'open_attachment_winid',
                url: '${/request/@context_path}/downloadFile.lview',
                params: {
                    header_id: invoice_ln_id,
                    table_name: 'acp_invoice_ln',
                    winid: 'open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '附件上传',
                width: 800,
                height: 475
            });
        }

        function reversed_flag_render(value, record, name) {
            if (value == 'N') {
                return "否";
            } else {
                return "是";
            }
        }

        function vat_invoice_pay_ds_grid_editor(record, name) {
            if (name == 'tax_type_rate') {
                if (!isNaN(value)) {
                    return parseFloat(value * 100) + '%';
                } else {
                    return '';
                }
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_invoice_status_ds" lookupCode="VAT.INVOICE_STATUS">
            </a:dataSet>
            <a:dataSet id="vat_yes_no_ds" lookupCode="SYS.YES_NO">
            </a:dataSet>
            <a:dataSet id="vat_invoice_kind_ds"
                       queryUrl="${/request/@context_path}/acp/invoice/ln/selectInvoiceKind"
                       autoQuery="true">
            </a:dataSet>
            <a:dataSet id="vat_invoice_pay_confirm_query_ds">
                <a:fields>
                    <a:field name="contract_number" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovService="/ast/con/contract/lov/query~com.hand.hls.ast.dto.ConContractLov" lovWidth="500"
                             title="HLS.CONTRACT_NUMBER">
                        <a:mapping>
                            <a:map from="contract_id" to="contract_id"/>
                            <a:map from="contract_number" to="contract_number"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="vat_invoice_pay_confirm_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/acp/invoice/ln/queryAcpInvoiceDetail"
                       submitUrl="${/request/@context_path}/acp/invoice/ln/confirmInvoice"
                       queryDataSet="vat_invoice_pay_confirm_query_ds" selectable="true">
                <a:fields>
                    <a:field name="record_date" datatype="date"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_invoice_pay_confirm_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="vat_invoice_pay_confirm_query" text="HAP.QUERY"/>
                <a:gridButton click="vat_invoice_pay_confirm_reset" text="HAP.RESET"/>
                <a:gridButton click="vat_invoice_pay_confirm_confirm" text="HAP.CONFIRM"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" style="width:100%">
                <a:box column="4" labelWidth="150">
                    <a:lov name="contract_number" bindTarget="vat_invoice_pay_confirm_query_ds" prompt="合同编号">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:lov>
                    <a:textField name="contract_name" bindTarget="vat_invoice_pay_confirm_query_ds" prompt="合同名称">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:textField>
                    <a:textField name="invoice_code" bindTarget="vat_invoice_pay_confirm_query_ds" prompt="发票代码">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:textField>
                    <a:textField name="invoice_number" bindTarget="vat_invoice_pay_confirm_query_ds" prompt="发票号码">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:textField>
                </a:box>
                <a:box column="4" labelWidth="150">
                    <a:datePicker name="acpInvoiceDateFrom" bindTarget="vat_invoice_pay_confirm_query_ds"
                                  prompt="开票日期从">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="acpInvoiceDateTo" bindTarget="vat_invoice_pay_confirm_query_ds" prompt="开票日期到">
                        <a:events>
                            <a:event name="enterdown" handler="vat_invoice_pay_confirm_query"/>
                        </a:events>
                    </a:datePicker>
                </a:box>
            </a:form>
            <a:grid id="vat_invoice_pay_confirm_ds_grid" bindTarget="vat_invoice_pay_confirm_ds" marginHeight="190"
                    marginWidth="10"
                    navBar="true">
                <a:columns>
                    <a:column name="contract_number" width="130" prompt="合同编号" align="left"/>
                    <a:column name="contract_name" width="160" prompt="合同名称" align="left"/>
                    <a:column name="cf_item_n" width="100" prompt="应付项目" align="left"/>
                    <a:column name="invoice_type_n" width="100" prompt="发票类别" align="left"/>
                    <a:column name="invoice_code" width="100" prompt="发票代码" align="left"/>
                    <a:column name="invoice_number" width="130" prompt="发票号码" align="right"/>
                    <a:column name="record_date" width="150" prompt="开票日期" align="right" renderer="Leaf.formatDate"/>
                    <a:column name="bp_name" width="200" prompt="销售方名称" align="left"/>
                    <a:column name="ref_v01" width="200" prompt="货物或应税劳务、服务名称" align="left"/>
<!--
                    <a:column name="bp_tax_registry_num" width="160" prompt="销方税号" align="left"/>
-->
                    <a:column name="total_amount" width="100" prompt="价税合计(元)" renderer="Leaf.formatMoney" align="right"/>
                    <a:column name="tax_type_rate_n" width="100" prompt="税率(%)" align="right"/>
<!--
                    <a:column name="tax_amount" width="100" prompt="税额" align="right" renderer="Leaf.formatMoney"/>
-->
                    <a:column name="description" width="200" prompt="备注" align="left"/>
                    <a:column name="invoice_status_n" width="100" prompt="发票状态" align="left"/>
                    <a:column name="invoice_ln_id" width="100" prompt="附件" renderer="atm_render" align="center"/>
                </a:columns>
            </a:grid>
        </a:screenBody>

    </a:view>
</a:screen>