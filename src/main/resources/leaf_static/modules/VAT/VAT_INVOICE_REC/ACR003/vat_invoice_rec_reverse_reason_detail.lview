<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function vat_invoice_pay_reverse_reverse_reason_confirm() {
            if (!$('vat_invoice_rec_reverse_reason_ds').validate()) {
                return;
            }
            $('vat_invoice_rec_ds').getSelected()[0].set("red_invoice_notice", $('vat_invoice_rec_reverse_reason_ds').getCurrentRecord().get('red_invoice_notice'));
            reverse();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_invoice_rec_reverse_reason_ds" autoCreate="true">
                <a:fields>
                    <a:field name="red_invoice_notice" defaultValue="${/parameter/@red_invoice_notice}" readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form labelWidth="110">
                <a:box column="4">
                    <a:textArea name="red_invoice_notice" bindTarget="vat_invoice_rec_reverse_reason_ds" prompt="红票通知单"
                                width="410" height="280">
                    </a:textArea>
                </a:box>
            </a:form>

        </a:screenBody>
    </a:view>
</a:screen>
