<?xml version="1.0" encoding="UTF-8"?>
<!--
    $author zedong huang
    $Date: 2019-3-13
    $Revision: 1.0
    $Purpose: 销项发票维护详情
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function vat_invoice_rec_detail_close() {
            $('${/parameter/@winId}').close();
        }


        function vat_invoice_rec_detail_save() {
            $('vat_invoice_rec_detail_hd_ds').submit();
            $('vat_invoice_rec_detail_ln_ds').submit();
        }

        function onSubmitSuccess_vat_invoice_rec_detail_ds() {
            $('vat_invoice_rec_detail_hd_ds').query();
            $('vat_invoice_rec_detail_ln_ds').query();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_invoice_line_type_ds" lookupCode="VAT.INVOICE_LINE_TYPE"/>
            <a:dataSet id="vat_invoice_rec_detail_hd_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/acr/invoice/hd/queryById?invoiceHdId=${/parameter/@invoice_hd_id}"
                       submitUrl="${/request/@context_path}/acr/invoice/hd/submit"
                       selectable="true">
                <a:fields>
                    <a:field name="invoice_date" datatype="date"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_invoice_rec_detail_ds"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="vat_invoice_rec_detail_ln_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/acr/invoice/ln/queryByHdId?invoiceHdId=${/parameter/@invoice_hd_id}"
                       submitUrl="${/request/@context_path}/acr/invoice/ln/submit"
                       selectable="true">
                <a:fields>
                    <a:field name="line_type_n" options="vat_invoice_line_type_ds" displayField="code_value_name"
                             valueField="code_value" returnField="line_type"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_vat_invoice_rec_detail_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="vat_invoice_rec_detail_close" text="HAP.BACK"/>
            </a:screenTopToolbar>

            <a:form title="基本信息">
                <a:box column="4" labelWidth="130">
                    <a:textField name="invoice_code" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="发票号" readOnly="true"/>
                    <a:textField name="invoice_kind_n" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="发票种类"
                                 readOnly="true"/>
                    <a:textField name="document_number" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="单据编号"
                                 readOnly="true">
                    </a:textField>
                    <a:lov name="invoice_status_n" bindTarget="vat_invoice_rec_detail_hd_ds" prompt="发票状态"
                           readOnly="true"/>
                </a:box>

                <a:box column="4" labelWidth="130">
                    <a:numberField name="total_amount" bindTarget="vat_invoice_rec_detail_hd_ds"
                                   prompt="价税合计"
                                   readOnly="true"/>
                    <a:numberField name="tax_amount" bindTarget="vat_invoice_rec_detail_hd_ds" prompt="税额"
                                   readOnly="true"/>
                    <a:textField name="invoice_period" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="期间名"
                                 readOnly="true"/>
                    <a:lov name="bp_id_n" bindTarget="vat_invoice_rec_detail_hd_ds" prompt="商业伙伴"
                           readOnly="true">
                    </a:lov>
                </a:box>

                <a:box column="4" labelWidth="130">
                    <a:lov name="billing_method_n" bindTarget="vat_invoice_rec_detail_hd_ds" prompt="开票规则"
                           readOnly="true">
                    </a:lov>
                    <a:datePicker name="invoice_date" bindTarget="vat_invoice_rec_detail_hd_ds"
                                  prompt="发票日期" readOnly="true">
                    </a:datePicker>
                    <a:textField name="currency_n" bindTarget="vat_invoice_rec_detail_hd_ds" prompt="币种"
                                 readOnly="true">
                    </a:textField>
                    <!--<a:comboBox name="exchange_rate_type" bindTarget="vat_invoice_rec_detail_hd_ds"
                                prompt="汇率类型" readOnly="true">
                    </a:comboBox>-->
                    <a:comboBox name="taxpayer_type_n" bindTarget="vat_invoice_rec_detail_hd_ds"
                                readOnly="true"
                                prompt="纳税人类型">
                    </a:comboBox>
                </a:box>

                <a:box column="4" labelWidth="130">
                    <!--  <a:textField name="exchange_rate" bindTarget="vat_invoice_rec_detail_hd_ds"
                                   prompt="汇率" readOnly="true"/>-->
                    <a:textField width="400" name="bp_name" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="发票抬头" readOnly="true">
                    </a:textField>
                    <a:textField width="400" name="description" readOnly="true"
                                 bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="发票备注">
                    </a:textField>

                </a:box>
                <a:box column="2" labelWidth="130">
                    <a:textField width="400" name="bp_address_phone_num" readOnly="true"
                                 bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="地址及电话">
                    </a:textField>
                    <a:textField width="400" name="bp_bank_account" readOnly="true"
                                 bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="开户行及账号">
                    </a:textField>
                </a:box>
                <a:box column="3" labelWidth="130">
                    <a:comboBox name="billing_way_n" bindTarget="vat_invoice_rec_detail_hd_ds"
                                prompt="开票方式"
                                readOnly="true">
                    </a:comboBox>
                    <a:textField name="bp_tax_registry_num" bindTarget="vat_invoice_rec_detail_hd_ds"
                                 prompt="纳税人识别号" readOnly="true">
                    </a:textField>
                    <!--  <a:comboBox name="taxpayer_type_n" bindTarget="vat_invoice_rec_detail_hd_ds"
                                  readOnly="true"
                                  prompt="纳税人类型">
                      </a:comboBox>-->
                </a:box>
            </a:form>

            <a:grid id="vat_invoice_rec_detail_ln_ds_grid" bindTarget="vat_invoice_rec_detail_ln_ds"
                    marginHeight="200" marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column width="40" name="line_number" align="right" prompt="行号"/>
                    <a:column width="114" name="line_type_n" prompt="行类型" align="left"/>
                    <!--<a:column width="104" name="cash_flow_description"-->
                    <!--editor="vat_invoice_rec_detail_ds_grid_lov" prompt="现金流描述"/>-->
                    <a:column width="64" name="product_name" prompt="应税劳务名称" align="left"/>
                    <a:column width="54" name="quantity" prompt="数量" align="right"/>
                    <a:column width="114" name="price" prompt="单价" align="right"/>
                    <a:column width="114" name="tax_type_rate" prompt="税率" align="right"/>
                    <a:column width="114" name="tax_amount" prompt="税额" align="right"/>
                    <a:column width="114" name="net_amount" align="right" prompt="未含税金额"/>
                    <a:column width="114" name="total_amount" align="right" prompt="金额"/>
                    <a:column width="164" name="description" align="left" prompt="说明"/>
                    <a:column width="114" name="net_price" prompt="未含税单价" align="right"/>
                </a:columns>
            </a:grid>


        </a:screenBody>
    </a:view>
</a:screen>
