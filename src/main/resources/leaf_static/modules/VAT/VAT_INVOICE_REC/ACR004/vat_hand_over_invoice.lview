<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
      window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
        debugger;
            if(ds.id && '${/parameter/@layout_code}_G_RESULT_invoice_handover_application_ds' == ds.id){
                ds.setQueryParameter('handover_person', '${/session/@user_id}');
            }

            if('${/parameter/@layout_code}' =='ACR006'){
                ds.setQueryParameter('invoice_handover_id', '${/parameter/@invoice_handover_id}');

            }
        };


        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'invoice_handover_application');
            var cshRec = $(ds_id).getAll();
            if(ds.id == ds_id&&record){
debugger;
                if(record.get('handover_status') == 'NOT_TRANSFER' || record.get('handover_status') == 'TRANSFER_BACK'){
                    record.getField('handover_person').setReadOnly(false);
                    record.getField('handover_person_n').setReadOnly(false);

                }else{
                    record.getField('handover_person').setReadOnly(true);
                    record.getField('handover_person_n').setReadOnly(true);

                }
            }
        };

        //批量移交
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'invoice_handover_application');
            var dsRecord = $(ds_id).getSelected();
            var handoverRecord= [];
            var handoverFlag = 'Y';

            if(dsRecord.length == 0 ){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                $L.showInfoMessage("提示","请至少选择一条数据进行批量移交!");
            }else{
                debugger;
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                for(var k = 0 ;k<dsRecord.length ;k++){
                    debugger;
                    handoverRecord.push(dsRecord[k].data);
                    if(dsRecord[k].data.handover_person == null){
                        handoverFlag = 'N';
                    }
                    if(dsRecord[k].data.handover_status == 'TRANSFERING' || dsRecord[k].data.handover_status == 'TRANSFER_END' ){
                        handoverFlag = 'NO';
                    }

                }

                if(handoverFlag == 'N'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示","请输入申请移交对象!");

                }else if(handoverFlag == 'NO'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示","请选择移交状态为未移交的数据!");

                }else{

                    Leaf.request({
                        url: '${/request/@context_path}/invoice/handover/application/Newupdate',
                        para: handoverRecord,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示', '成功');
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).query();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).query();
                        },
                        scope: this
                    });
                }

            }


        };
        //批量移交
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'invoice_handover_application');
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();


            Leaf.request({
                        url: '${/request/@context_path}/invoice/handover/application/newCreate',

                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示', '成功');
                            $(ds_id).query();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).query();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).query();
                        },
                        scope: this
                    });





        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
