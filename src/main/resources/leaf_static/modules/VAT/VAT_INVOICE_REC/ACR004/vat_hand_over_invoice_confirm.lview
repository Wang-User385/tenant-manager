<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if(ds.id == '${/parameter/@layout_code}_F_QUERY__ds'){
                if(record.get('handover_status') == null){
                  /*  record.set('handover_status','TRANSFERING');
                    record.set('handover_status_n','移交中');*/
                }

            }

        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
        debugger;
            if(ds.id && '${/parameter/@layout_code}_G_RESULT_invoice_handover_application_ds' == ds.id){
                ds.setQueryParameter('handover_person', '${/session/@user_id}');
            }
        };

            //确认移交
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'invoice_handover_application');
            var dsRecord = $(ds_id).getSelected();
            var handoverRecord= [];
            if(dsRecord.length == 0 ){
                $L.showInfoMessage("提示","请至少选择一条数据进行确认移交!");
            }else{
                debugger;
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                for(var k = 0 ;k<dsRecord.length ;k++){
                    handoverRecord.push(dsRecord[k].data);
                }

                Leaf.request({
                    url: '${/request/@context_path}/invoice/handover/application/confirm/update',
                    para: handoverRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('提示', '成功');
                        $(ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    scope: this
                });


            }


        };
        //确认移交
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
        debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'invoice_handover_application');
            var dsRecord = $(ds_id).getSelected();
            var handoverRecord= [];
            if(dsRecord.length == 0 ){
                $L.showInfoMessage("提示","请至少选择一条数据进行移交退回!");
            }else{

            debugger;
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                for(var k = 0 ;k<dsRecord.length ;k++){
                    if(dsRecord[k].data.handover_status =='TRANSFER_END'){
                        $L.showInfoMessage("提示","该单据不允许退回!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        return false;

                    }
                    handoverRecord.push(dsRecord[k].data);
                }

                Leaf.request({
                    url: '${/request/@context_path}/invoice/handover/application/reject/update',
                    para: handoverRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('提示', '成功');
                        $(ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    scope: this
                });


            }


        };
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
var  link_function;
            if (name == 'upload') {
                link_function = '${/parameter/@layout_code}_attachment_detail';

                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.get('handover_status') + '\',\'' + record.get('invoice_handover_id') + '\');">' + config_record.get('prompt') + '</a>';
            }


        }


        /*附件上传超链接函数*/
        window['${/parameter/@layout_code}_attachment_detail'] = function (handover_status, invoice_handover_id) {
            debugger;
            var url, usage;
                if (handover_status == 'TRANSFERING') {
                    url = '${/request/@context_path}/uploadFile.lview';
                    usage = 'CREATE';
                } else {
                    url = '${/request/@context_path}/downloadFile.lview';
                    usage = 'QUERY';
                }
                new Leaf.Window({
                id: 'open_attachment_winid',
                url: url,
                params: {
                    header_id: invoice_handover_id,
                    table_name: 'invoice_handover_application',
                    winid: 'open_attachment_winid',
                    function_usage: usage
                },
                title: '附件上传',
                width: 800,
                height: 475
            });

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
