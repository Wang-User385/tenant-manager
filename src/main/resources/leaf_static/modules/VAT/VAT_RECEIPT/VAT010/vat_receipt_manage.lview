<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function vat_receipt_query() {
            $('vat_receipt_ds').query();
        }

        function vat_receipt_reset() {
            $('vat_receipt_query_ds').reset();
            $('vat_receipt_ds').query();
        }

        function vat_receipt_print() {
            Leaf.Masker.mask(Ext.getBody());
            var down_url;
            var ds_id = $('vat_receipt_ds');
            var records = ds_id.getSelected();
            if (records.length != 1) {
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.showMessage('提示', '请选择一条收据进行打印！');
                return false;
            }
            var saveData = [];

            for (var i = 0; i < records.length; i++) {
                records[i].set('company_id','${/session/@companyId}');
                saveData.push(records[i].data);
            }

            Leaf.request({
                url: "${/request/@context_path}/vat/acr/receipt/download",
                para: saveData,
                success: function (res) {
                    console.log(res);
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                    vat_receipt_query();
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url="${/request/@context_path}/fnd/attachment/download?attachment_id="+attachment_id;
                    location.href=down_url;
                },
                error: function (res) {
                    console.log("error"+res);

                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    console.log("failure"+res);

                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });

        }

        function vat_receipt_add() {
            new Leaf.Window({
                id: 'vat_receipt_winid',
                url: '${/request/@context_path}/modules/VAT/VAT_RECEIPT/VAT010/vat_receipt_create.lview',
                params: {
                    winid: 'vat_receipt_winid'
                },
                title: '收据创建',
                fullScreen: true
            }).on('close', function () {
                vat_receipt_query();
            });
        }

        function vat_receipt_cf_item_desc_render(value, record, name) {
            if (value && value == '租金') {
                return "回租本金";
            } else {
                return value;
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="vat_receipt_query_ds">
                <a:fields>
                    <a:field name="bp_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/hls/bp/queryBpMasterLov?~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="交款单位">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="business_unit" autoComplete="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/csh/unit/query/lov~com.hand.hls.layout.dto.LovCshUnitDto"
                             lovWidth="850"
                             title="部门" prompt="部门">
                        <a:mapping>
                            <a:map from="unit_id" to="unit_id"/>
                            <a:map from="unit_code" to="unit_code"/>
                            <a:map from="unit_name" to="business_unit"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="business_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/fnd/employee/queryEmployeesForLov?~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             lovWidth="550"
                             title="HLS.BP_TITLE" prompt="业务经办">
                        <a:mapping>
                            <a:map from="name" to="business_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="document_number"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="vat_receipt_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/acr/receipt/hd/query"
                       queryDataSet="vat_receipt_query_ds" selectable="true">
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="vat_receipt_query" text="HAP.QUERY"/>
                <a:gridButton click="vat_receipt_reset" text="HAP.RESET"/>
                <a:gridButton click="vat_receipt_add" text="HAP.NEW"/>
                <a:gridButton click="vat_receipt_print" text="收据打印"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" style="width:100%">
                <a:box column="4" labelWidth="150">
                    <a:lov name="bp_name" bindTarget="vat_receipt_query_ds" prompt="交款单位" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:lov>
                    <a:textField name="document_number" bindTarget="vat_receipt_query_ds" prompt="编号" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:textField>
                    <a:lov name="business_name" bindTarget="vat_receipt_query_ds" prompt="业务经办" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:lov>
                    <a:lov name="business_unit" bindTarget="vat_receipt_query_ds" prompt="业务部门" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:lov>
                </a:box>
                <a:box column="4" labelWidth="150">
                    <a:datePicker name="receipt_date_from" bindTarget="vat_receipt_query_ds" prompt="收款日期从"
                                  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="receipt_date_to" bindTarget="vat_receipt_query_ds" prompt="收款日期到"
                                  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="vat_receipt_query"/>
                        </a:events>
                    </a:datePicker>
                </a:box>
            </a:form>
            <a:grid id="vat_receipt_ds_grid" bindTarget="vat_receipt_ds" marginHeight="130" marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column name="document_number" width="200" prompt="编号" align="center"/>
                    <a:column name="receipt_date" width="130" prompt="收款日期" align="left"/>
                    <a:column name="total_amount" width="130" prompt="收款金额" align="right" renderer="Leaf.formatMoney"/>
                    <a:column name="bp_name" width="300" prompt="交款单位" align="center"/>
                    <a:column name="company_name" width="260" prompt="收款单位" align="center"/>
                    <a:column name="business_name" width="180" prompt="业务经办" align="center"
                              renderer="vat_receipt_cf_item_desc_render"/>
                    <a:column name="business_unit" width="260" prompt="业务部门" align="center"/>
                    <a:column name="receipt_status_n" width="100" prompt="打印状态" align="center"/>
                    <a:column name="receipt_type_n" width="100" prompt="收据类型" align="left"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
