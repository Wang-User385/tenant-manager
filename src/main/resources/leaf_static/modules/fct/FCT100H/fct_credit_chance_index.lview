<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true">
    <a:view>
        <a:link id="project_detail_link_id"
                url="${/request/@context_path}/modules/fct/FCT110A/fct_credit_chance_detail.lview"/>
        <script><![CDATA[

            function detailFunction(chanceId,creditLineStatus) {
                var param = {};
                param['chanceId'] = chanceId;
                param['function_code'] = 'PRJ4001S1';
                param['function_usage'] = 'CREATE';
                param['url_title'] = '项目详细信息';
                hls_doc_get_layout_code(param, 'project_detail_link_id', null, 'PRJ4001S1');
            };

            //超链接渲染
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
                var link_function = 'detailFunction';
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
                if (name == 'detail') {
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.chanceId + '\',\'' + record.creditLineStatus + '\');">' + config_record.get('prompt') + '</a>';
                }
            };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>