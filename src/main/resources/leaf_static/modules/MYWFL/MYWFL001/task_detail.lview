                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.SideBar.show({
                                type: 'warning',
                                msg: '操作失败',
                                duration: 1000
                            });
                        },
                        scope: this
                    });
                });
            }else{
                Leaf.Masker.unmask(Ext.getBody());
                Leaf.showMessage('提示','请维护审查人再指派！');
            }
        });
