        //提交复审 btn-review-approved
        jQuery('#btn-review-approved').click(function () {
            //debugger;
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
                return false;
            }
            var projectId = currentTaskInfo.process_instance.business_key;
            var execution_variables = currentTaskInfo.execution_variables;
            var accountFlag = '';
            var quotaFlag = '';
            for(var i=0;i<execution_variables.length;i++){
                if(execution_variables[i].name == 'accountFlag'){
                    accountFlag = execution_variables[i].value;
                }
                if(execution_variables[i].name == 'quotaFlag'){
                    quotaFlag = execution_variables[i].value;
                }
            }
            if(quotaFlag == 'N' && accountFlag == 'N'){
                Leaf.showMessage('提示','价格未经计财审定，初审无法提交至复审！');
                return;
            }
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            var param = {project_id:projectId,comment:comment};
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: '${/request/@context_path}/ct/prj/project/detail/query/second',
                para: param,
                type: "POST",
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    //console.log(res);
                    if(res.result.record[0].review_comments == '' || res.result.record[0].review_comments == null){
                        Leaf.showMessage('提示','请填写审查人意见！');
                        return;
                    }
                    var industry_category_n = '';
                    var message_flag = 'N';
                    if(res.result.record[0].industry_category == 'FIRST_SPECIAL_INDUSTRY'){
                        industry_category_n = '一类专项行业';
                        message_flag = 'Y';
                    }
                    if(res.result.record[0].industry_category == 'SECOND_SPECIAL_INDUSTRY'){
                        industry_category_n = '二类专项行业';
                        message_flag = 'Y';
                    }
                    if(message_flag == 'Y'){
                        Leaf.showOkCancelWindow("确认",'此项目为<font color="red">' + industry_category_n + '</font>项目，请慎重审查！确认提交？',function () {
                            taskAction({approveResult: 'REVIEW_APPROVED', approveResultDesc: jQuery('#text-review-approved').text()});
                        },function () {return true;},200,200);
                    }else{
                        Leaf.showOkCancelWindow("确认",'确认提交？',function () {
                            taskAction({approveResult: 'REVIEW_APPROVED', approveResultDesc: jQuery('#text-review-approved').text()});
                        },function () {return true;},200,200);
                    }

                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });

        });

