<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="wfl_project_query_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="wfl_project_change_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANGE/PRJ100/prj_project_change_modify.lview"/>
        <a:link id="wfl_chance_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_chance_modify_detail.lview"/>
        <a:link id="wfl_bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <!--<script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>-->
        <!--<script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>-->
        <!--<link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet" type="text/css"/>-->
        <style>
            .text_warning{
                color:red;
            }
            .btn{
                cursor: pointer;
                padding: 3px 15px;
                border-radius: 0px;
                line-height: 1.7;
                vertical-align: middle;
                transition: all .25s;
                display: inline-block;
                margin-bottom: 0;
                font-size: 14px;
                font-weight: 400;
                text-align: center;
                white-space: nowrap;
                user-select: none;
                background-image: none;
                border: 1px solid transparent;
                margin-right:8px;
            }
            .btn-primary {
                color:#fff;
                background-color: #1D92AF;
                border-color: #198099;
            }
            .btn-primary:hover, .btn-primary:focus, .btn-primary:active, .btn-primary.active, .btn-primary .open .dropdown-toggle.btn-primary {
                background-color: #198099;
            }
            .btn-info {
                color:#fff;
                background-color: #46B0CF;
                border-color: #34a6c8;
            }
            .btn-info:hover, .btn-info:focus, .btn-info:active, .btn-info.active, .btn-info .open .dropdown-toggle.btn-info {
                background-color: #34a6c8;
            }

            .btn-success:hover, .btn-success:focus, .btn-success:active, .btn-success.active, .btn-success .open .dropdown-toggle.btn-success {
                background-color: #439643;
            }
            .btn-success {
                color: #fff;
                background-color: #449d44;
                border-color: #398439;
            }
            .btn-warning:hover, .btn-warning:focus, .btn-warning:active, .btn-warning.active, .btn-warning .open .dropdown-toggle.btn-warning {
                background-color: #e49626;
            }
            .btn-warning {
                color: #fff;
                background-color: #ec971f;
                border-color: #d58512;
            }
            html, body {
                background: white;
            }
        </style>
        <script><![CDATA[
        //保存当前流程信息用于子页面取值
        var processInfo = null;
        // 优先级等级
        var priorityArr = [
            {min:null,max:33},
            {min:34,max:66},
            {min:67,max:null}
        ];
        // 当前待办信息
        var currentTaskInfo = {};
        function getTaskWin(){
            if('${/parameter/@winid}' != '' && '${/parameter/@winid}' != null){
                return $("${/parameter/@winid}");
            }
            if('${/parameter/@winId}' != '' && '${/parameter/@winId}' != null){
                return $("${/parameter/@winId}");
            }
            return $("task_detail_win");
            //return ($("task_detail_win") || $("${/parameter/@winid}") || $("${/parameter/@winId}"))
        }
        function getTaskWinId(){
            if('${/parameter/@winid}' != '' && '${/parameter/@winid}' != null){
                return "${/parameter/@winid}";
            }
            if('${/parameter/@winId}' != '' && '${/parameter/@winId}' != null){
                return "${/parameter/@winId}";
            }
            return "task_detail_win";
            //return ("task_detail_win" || "${/parameter/@winid}" || "${/parameter/@winId}")
        }
        $L.onReady(function(){
            // 隐藏审批历史导出按钮
            jQuery("#process_instance_history_grid_tb .grid-excel").hide();

            // 隐藏抄送列表导出按钮
            jQuery("#carbon_copy_employee_grid_tb .grid-excel").hide();

            // 请求当前待办详细信息
            var adminflag = "${/request/@isAdmin}" || false ,
                adminUrl = adminflag ? 'admin/' : '';
            var queryUrl = '${/request/@context_path}/wfl/runtime/' + adminUrl + 'tasks/' + "${/parameter/@taskId}" + '/details';
            var taskPriority
            Ext.Ajax.request({
                url: queryUrl,
                success: function(res){
                    on_current_task_detail_load_success(res);
                },
                failure: function(res){
                    Leaf.showErrorMessage("错误","查询流程失败"+res.error.message||'',function(){
                        getTaskWin().close();
                    },300,200)
                },
                method: "GET",
                headers: {
                    'X-CSRF-TOKEN': "${/session/@_csrf.token}",
                    'springflag': "Y"
                }
            });

            // debugger
            // //校验当前登录人是否是正确的审批人员
            // var checkUrl = '${/request/@context_path}/wfl/check/audit_user/${/parameter/@taskId}';
            // Ext.Ajax.request({
            //     url: checkUrl,
            //     success: function(res){
            //         res = JSON.parse(res.responseText);
            //         if(!res.success) {
            //             Leaf.showErrorMessage("错误","请用正确的审批人员审批",function(){
            //                 getTaskWin().close();
            //             },300,200)
            //         }
            //     },
            //     method: "GET",
            //     headers: {
            //         'X-CSRF-TOKEN': "${/session/@_csrf.token}",
            //         'springflag': "Y"
            //     }
            // });


        });
        // 当前待办信息加载成功执行
        function on_current_task_detail_load_success(res){
            //debugger;
            res = JSON.parse(res.responseText);
            processInfo = res;
            if(res.success){
                // 审批事项数据-current_task_detail_ds
                res = res.result.record[0];
                var dataObj = {
                    "process_instance_name" : res.process_instance.process_definition_name,
                    "process_instance_id" : res.id,
                    "start_user_id" : res.process_instance.start_user_id,
                    "start_user_name" : res.process_instance.start_user_name,
                    "start_time" : res.process_instance.start_time,
                    "priority" : res.priority>66 ? '高' : (res.priority>33 ? '中' : '低')
                };
                $("current_task_detail_ds").create(dataObj);
                currentTaskInfo = res;
                var param = currentTaskInfo.execution_variables;
                if (param.filter(function (o) {
                    return o.name == "conEndTask";
                }).length != 0) {
                    var conEndTask = param.filter(function (o) {
                        return o.name == "conEndTask";
                    })[0].value;
                }
                var conEndTaskN;
                var con_end_task_records = $('con_end_task_syscode_ds').getAll();
                for (var i = 0; i < con_end_task_records.length; i++) {
                    if(conEndTask == con_end_task_records[i].get('code_value')){
                        conEndTaskN = con_end_task_records[i].get('code_value_name');
                    }
                }
                if($('con_end_task_ds').getCurrentRecord().get('con_end_task') == null){
                    $('con_end_task_ds').getCurrentRecord().set('con_end_task',conEndTask);
                    $('con_end_task_ds').getCurrentRecord().set('con_end_task_n',conEndTaskN);
                }

                if (param.filter(function (o) {
                    return o.name == "durationPerson";
                }).length != 0) {
                    var durationPerson = param.filter(function (o) {
                        return o.name == "durationPerson";
                    })[0].value;
                }
                var durationPersonN;
                var duration_person_records = $('duration_person_choose_syscode_ds').getAll();
                for (var i = 0; i < duration_person_records.length; i++) {
                    if(durationPerson == duration_person_records[i].get('code_value')){
                        durationPersonN = duration_person_records[i].get('code_value_name');
                    }
                }
                if($('duration_person_choose_ds').getCurrentRecord().get('duration_person') == null){
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_person',durationPerson);
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_person_n',durationPersonN);
                }

                if (param.filter(function (o) {
                    return o.name == "durationEmployee";
                }).length != 0) {
                    var durationEmployee = param.filter(function (o) {
                        return o.name == "durationEmployee";
                    })[0].value;
                }if (param.filter(function (o) {
                    return o.name == "durationEmployeeN";
                }).length != 0) {
                    var durationEmployeeN = param.filter(function (o) {
                        return o.name == "durationEmployeeN";
                    })[0].value;
                }

                if($('duration_person_choose_ds').getCurrentRecord().get('duration_employee') == null
                &&durationEmployee!="null"){
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_employee',durationEmployee);
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_employee_n',durationEmployeeN);
                }
                if (param.filter(function (o) {
                    return o.name == "durationEmployeeTwo";
                }).length != 0) {
                    var durationEmployeeTwo = param.filter(function (o) {
                        return o.name == "durationEmployeeTwo";
                    })[0].value;
                }
                if (param.filter(function (o) {
                    return o.name == "durationEmployeeTwoN";
                }).length != 0) {
                    var durationEmployeeTwoN = param.filter(function (o) {
                        return o.name == "durationEmployeeTwoN";
                    })[0].value;
                }

                if($('duration_person_choose_ds').getCurrentRecord().get('duration_employee_two') == null
                &&durationEmployeeTwo!="null"){
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_employee_two',durationEmployeeTwo);
                    $('duration_person_choose_ds').getCurrentRecord().set('duration_employee_two_n',durationEmployeeTwoN);
                }

                // 审批历史数据-task_approve_history_ds
                var approveHistory = res.historic_task_list;
                approveHistory.forEach(function(i){
                    $('task_approve_history_ds').create({
                        "end_time":i.end_time,
                        "name":i.name,
                        "assignee_id":i.assignee,
                        "assignee":i.assignee_name,
                        "process_instance_id":i.process_instance_id,
                        "action":i.action,
                        "action_desc":i.action_desc,
                        "comment":i.comment,
                        "execution_id":i.execution_id,
                        "id":i.id,
                        "process_definition_id":i.process_definition_id,
                        "start_time":i.start_time,
                        "tenant_id":i.tenant_id,
                        "variables":i.variables,
                        "processInstanceId":i.process_instance_id
                    });
                });
                // 事项详情iframe
                if(!!res.form_key && !!res.process_instance.business_key){
                    var formKey = res.form_key||'';
                    var businessKey = res.process_instance.business_key||'';
                    if(formKey.indexOf("?") != -1){
                        var iframeUrl = '${/request/@context_path}' + '/' + formKey + '&businessKey=' + businessKey + '&wflRuleControlFlag=Y' + '&processInstanceId=${/parameter/@processInstanceId}&taskId=${/parameter/@taskId}';
                    }else {
                        var iframeUrl = '${/request/@context_path}' + '/' + formKey + '?businessKey=' + businessKey + '&wflRuleControlFlag=Y' + '&processInstanceId=${/parameter/@processInstanceId}&taskId=${/parameter/@taskId}';
                    }
                    document.getElementById('includeFrame').src = iframeUrl;
                }
                // 根据数据更新操作按钮
                updateApproveButton(res);
            }else{
                Leaf.showErrorMessage("错误","查询流程失败"+res.error.message||'',function(){
                    getTaskWin().close();
                },300,200)
            }
        }
        // 审批动作 renderer
        function actionRender(value,record,name){
            if(!!value) {
                if(record.get('action_desc') != null){
                    return record.get('action_desc');
                }
                if (value == 'APPROVED') {
                    value = "<span class='action_ok'>同意</span>";
                } else if (value == 'REJECTED') {
                    value = "<span class='action_dangerous'>拒绝</span>";
                } else if (value == 'ADD_SIGN') {
                    value = "<span class='action_dangerous'>加签</span>";
                } else if (value == 'DELEGATE') {
                    value = "<div class='action_dangerous'>转交</div>";
                } else if (value == 'JUMP') {
                    value = "<span class='action_dangerous'>跳转</span>";
                } else if (value == 'RECALL') {
                    value = "<span class='action_dangerous'>撤回</span>";
                } else if (value == 'SAVE') {
                    value = "<span class='action_dangerous'>保留</span>";
                } else if (value == 'CHANGE') {
                    value = "<span class='action_dangerous'>变更</span>";
                } else if (value == "CARBON_COPY") {
                    value = "<span class='action_dangerous'>抄送</span>";
                } else if (value == 'APPOINT') {
                    value = "<span class='action_dangerous'>确认指派</span>";
                } else if (value == 'WITHDRAW') {
                    value = "<span class='action_dangerous'>项目撤回</span>";
                } else if (value == 'APPROVED_RETURN') {
                    value = "<span class='action_dangerous'>项目退回</span>";
                } else if (value == 'APPROVED_LAST') {
                    value = "<span class='action_dangerous'>回到退回节点</span>";
                } else if (value == 'addAssign') {
                    value = "<span class='action_dangerous'>指派</span>";
                } else if (value == 'REVIEW') {
                    value = "<span class='action_dangerous'>提交业审委审议</span>";
                } else if (value == 'POWERFUL_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'DURATION_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'END_TASK_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'PAY_END_TASK_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'CONDITION_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'SUSPEND') {
                    value = "<span class='action_dangerous'>暂缓</span>";
                } else if(value == 'REVIEW_APPROVED'){
                    value = "<span class='action_dangerous'>提交复审</span>";
                } else if(value == 'RETURN_RESEND'){
                    value = "<span class='action_dangerous'>退回项目经理重发</span>";
                } else if(value == 'PEER_REJECTED'){
                    value = "<span class='action_dangerous'>点对点退回业务经理</span>";
                } else if(value == 'REJECTED_ACCEPT'){
                    value = "<span class='action_dangerous'>拒绝受理</span>";
                } else if(value == 'AUTO_DELEGATE'){
                    value = "<span class='action_dangerous'>自动转交</span>";
                } else if(value == 'APPROVED_GENERAL'){
                    value = "<span class='action_dangerous'>指派审批人</span>";
                }
                else{
                        value = value || ''
                    }
                    return value;
                }
            return "";
        }
        // 待办事项数据加载后 根据数据更新底部操作按钮
        function updateApproveButton(res){
            jQuery('#btn-add-appoint').hide();
            jQuery('#btn-approved_general').hide();
            jQuery('#btn-withdraw').hide();
            jQuery('#btn-return').hide();
            jQuery('#btn-review-approved').hide();
            jQuery('#risk_appoint').hide();
            jQuery('#powerful_choose').hide();
            jQuery('#btn-powerful-choose').hide();
            jQuery('#duration_choose').hide();
            jQuery('#btn-duration-choose').hide();
            jQuery('#btn-con-endTask').hide();
            jQuery('#btn-pay-endTask').hide();
            jQuery('#con_end_task').hide();
            jQuery('#payment_end_task').hide();
            jQuery('#btn-review').hide();
            jQuery('#btn-suspend').hide();
            jQuery('#btn-peer-rejected').hide();
            jQuery('#btn-rejected-accept').hide();
            jQuery('#btn-condition-task').hide();
            jQuery('#condition_task').hide();
            //jQuery('#price_appoint').hide();
            var currentTaskInfo = res;

            if ('pending' == currentTaskInfo.delegation_state) {
                jQuery('#btn-add-approver').attr({"disabled": "disabled"});
                jQuery('#btn-add-assign').attr({"disabled": "disabled"});
            } else if ('resolved' == currentTaskInfo.delegation_state) {
                jQuery('#btn-add-approver').attr({"disabled": "disabled"});
                jQuery('#btn-add-assign').attr({"disabled": "disabled"});
            }
            var hasSetApproveResult = false;
            var approval_action_exists_flag = 'N';
            //指派节点标记
            var point_exists_flag = 'N';
            currentTaskInfo.form_data.form_properties.forEach(function(value,i,arr){
                if(value.id == 'APPROVAL_ACTION' && value.type == 'enum'&&value.enum_values.length){
                    approval_action_exists_flag='Y';
                }
                //判断审批按钮是否是指派
                if(value.id == 'approveResult' && value.type == 'enum' && value.enum_values.length){
                    value.enum_values.forEach(function(value2,i,arr){
                        if(value2.id == 'APPOINT'){
                            point_exists_flag='Y';
                        }
                    });
                }
            });
            if(!currentTaskInfo.form_data.form_properties.length||approval_action_exists_flag=='N'){
                jQuery('#head_flag').show();
                jQuery('#approval_comments').show();
                //debugger;
                var current_activity_id = currentTaskInfo.task_definition_key;
                var task_id = 'sid-MIsoxvsm-m65O-4CJK-8fn0-iJ4czlsn8Rc4';
                if(task_id == current_activity_id){
                    var ds_id = $('approval_comments_ds');
                    var record = ds_id.getCurrentRecord();
                    record.set('general_com','80');
                    record.set('general_com_cn','同意审查意见,请业审委审议');
                    record.set('comment','同意审查意见,请业审委审议');
                }
            }
            currentTaskInfo.form_data.form_properties.forEach(function(value,i,arr){
                if (value.id == 'approveResult' && value.type == 'enum') {
                    //debugger;
                    var findApproved = false, findReject = false, findAppoint=false, findWithdraw=false, findReturn=false,findApprovedGeneral=false,
                        findReviewApproved=false,findPowerful=false,findDuration=false,findEndTask=false,findPayEndTask=false,findReview=false,findSuspend=false,
                        findPeerRejected = false, findRejectAccept = false, findCondition = false;
                    hasSetApproveResult = true;
                    value.enum_values.forEach(function (rr,i) {
                        if (isContains(rr.id) && rr.name) {
                            var openBox = jQuery("<button/>").attr({
                                'id': 'btn-custom-' + rr.id,
                                'type': "button",
                                'class': "btn btn-primary",
                                'action': rr.id
                            });
                            openBox.text(rr.name);
                            jQuery('#custom-btn-container').append(openBox);
                            openBox.click(function () {
                                openBoxAction(rr.id, rr.name);
                            });
                            //debugger;
                        } else if (rr.id == 'APPROVED' && rr.name) {
                            findApproved = true;
                            jQuery('#text-approved').text(rr.name)
                        } else if (rr.id == 'REJECTED' && rr.name) {
                            findReject = true;
                            jQuery('#text-rejected').text(rr.name)
                        } else if (rr.id == 'APPOINT' && rr.name) {
                            findAppoint = true;
                            jQuery('#text-add-appoint').text(rr.name)
                        }else if (rr.id == 'POWERFUL_APPROVED' && rr.name) {
                            findPowerful = true;
                            jQuery('#text-powerful-choose').text(rr.name)
                        }else if (rr.id == 'DURATION_APPROVED' && rr.name) {
                            findDuration = true;
                            jQuery('#text-duration-choose').text(rr.name)
                        }else if (rr.id == 'END_TASK_APPROVED' && rr.name) {
                            findEndTask = true;
                            jQuery('#text-con-endTask').text(rr.name)
                        }else if (rr.id == 'PAY_END_TASK_APPROVED' && rr.name) {
                            findPayEndTask = true;
                            jQuery('#text-pay-endTask').text(rr.name)
                        }else if (rr.id == 'CONDITION_APPROVED' && rr.name) {
                            findCondition = true;
                            jQuery('#text-condition-task').text(rr.name)
                        }else if (rr.id == 'WITHDRAW' && rr.name){
                            findWithdraw = true;
                            jQuery('#text-withdraw').text(rr.name)
                        }else if (rr.id == 'APPROVED_RETURN' && rr.name){
                            findReturn = true;
                            jQuery('#text-return').text(rr.name)
                        }else if(rr.id == 'REVIEW_APPROVED' && rr.name){
                            findReviewApproved = true;
                            jQuery('#text-review-approved').text(rr.name)
                        }else if(rr.id == 'SUSPEND' && rr.name){
                            findSuspend = true;
                            jQuery('#text-suspend').text(rr.name)
                        } else if(rr.id == 'REVIEW' && rr.name){
                            findReview = true;
                            jQuery('#text-review').text(rr.name)
                        }else if(rr.id == 'PEER_REJECTED' && rr.name){
                            findPeerRejected = true;
                            jQuery('#text-peer-rejected').text(rr.name)
                        } else if(rr.id == 'REJECTED_ACCEPT' && rr.name){
                            findRejectAccept = true;
                            jQuery('#text-rejected-accept').text(rr.name)
                        }else if(rr.id == 'APPROVED_GENERAL'){
                            findApprovedGeneral = true;
                            jQuery('#text-approved-general').text(rr.name)

                        }
                        else {
                            //  custom button
                            var cb0 = jQuery("<button/>").attr({
                                'id': 'btn-custom-' + rr.id,
                                'type': "button",
                                'class': "btn btn-primary",
                                'action': rr.id
                            });
                            cb0.text(rr.name);
                            jQuery('#custom-btn-container').append(cb0);
                            cb0.click(function () {
                                customApproveAction(rr.id);
                            });
                        }
                    });
                    if (findApproved) {
                        jQuery('#btn-approved').show();
                    }
                    if (findReject) {
                        jQuery('#btn-rejected').show();
                    }
                    if(findAppoint){
                        jQuery('#btn-add-appoint').show();
                        jQuery('#risk_appoint').show();
                        //jQuery('#price_appoint').show();
                    }
                    if(findApprovedGeneral){
                        jQuery('#btn-approved_general').show();
                        jQuery('#risk_appoint').show();
                    }
                    if(findPowerful){
                        jQuery('#btn-powerful-choose').show();
                        jQuery('#powerful_choose').show();
                    }
                    if(findDuration){
                        jQuery('#btn-duration-choose').show();
                        jQuery('#duration_choose').show();
                    }
                    if(findEndTask){
                        jQuery('#btn-con-endTask').show();
                        jQuery('#con_end_task').show();
                    }
                    if(findPayEndTask){
                        jQuery('#btn-pay-endTask').show();
                        jQuery('#payment_end_task').show();
                    }
                    if(findWithdraw){
                        jQuery('#btn-withdraw').show();
                    }
                    if(findReturn){
                        jQuery('#btn-return').show();
                    }
                    if(findReviewApproved){
                        jQuery('#btn-review-approved').show();
                    }
                    if(findCondition){
                        jQuery('#btn-condition-task').show();
                        jQuery('#condition_task').show();
                    }
                    if(findReview){
                        jQuery('#btn-review').show();
                    }
                    if(findSuspend){
                        jQuery('#btn-suspend').show();
                    }
                    if(findPeerRejected){
                        jQuery('#btn-peer-rejected').show();
                    }
                    if(findRejectAccept){
                        jQuery('#btn-rejected-accept').show();
                    }
                    if(findApprovedGeneral){
                        jQuery('#btn-approved_general').show();
                    }

                }
                if (value.id == 'APPROVAL_ACTION' && value.type == 'enum') {
                    // ADD_SIGN DELEGATE
                    var hide_header_flag_exists = 'N';
                    var hide_info_flag_exists = 'N';
                    jQuery.each(value.enum_values, function (ii, rr) {
                        if (rr.id == 'DELEGATE_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                jQuery('#btn-delegate').show();
                            }
                        } else if (rr.id == 'ADD_SIGN_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                jQuery('#btn-add-approver').show();
                            }
                        } else if (rr.id == 'HIDE_HEADER_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                hide_header_flag_exists = 'Y';
                            }
                        } else if (rr.id == 'HIDE_HISTORY_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                // jQuery("#approve_his_tab").hide();
                                // $("approve_info_tab").selectTab(1);
                            }
                        } else if (rr.id == 'HIDE_INFO_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                hide_info_flag_exists = 'Y';
                            }
                        } else if (rr.id == 'ADD_ASSIGN_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                jQuery('#btn-add-assign').show();
                            }
                        }
                    });
                    if (hide_header_flag_exists == 'Y') {
                        jQuery('#head_flag').hide();
                    }
                    if (hide_info_flag_exists == 'N') {
                        jQuery('#approval_comments').show();
                        var current_activity_id = currentTaskInfo.task_definition_key;
                        var task_id = 'sid-MIsoxvsm-m65O-4CJK-8fn0-iJ4czlsn8Rc4';
                        if(task_id == current_activity_id){
                            var ds_id = $('approval_comments_ds');
                            var record = ds_id.getCurrentRecord();
                            record.set('general_com','80');
                            record.set('general_com_cn','同意审查意见,请业审委审议');
                            record.set('comment','同意审查意见,请业审委审议');
                        }
                    }
                }
            });
            if (!hasSetApproveResult) {
                jQuery('#btn-approved').show();
                jQuery('#btn-rejected').show();
            }
            //指派节点不显示输入意见
            if(point_exists_flag == 'Y'){
                //jQuery('#head_flag').hide();
                jQuery('#approval_comments').hide();
                var ds_id = $('approval_comments_ds');
                var record = ds_id.getCurrentRecord();
                record.set('general_com','120');
                record.set('general_com_cn','确认');
                record.set('comment','指派');
            }
            //所有节点都不需要展示意见下拉框
            jQuery('#general_approval_comments_combo').hide();
        }
        // 常用审批意见 select事件
        function onSelect_general_approval_comments_combo(combo,value,display,record){
            var record = $("approval_comments_ds").data[0];
            var pre_comments = record.get("comment") || '';
            record.set("comment",pre_comments + display);
            $("approval_comment_ta").fireEvent("change",$("approval_comment_ta"),record.get("comment"),pre_comments);
        }
        // 审批意见输入栏 change事件
        function onChange_approval_comment_ta(ta,value,pre_value){
            var left_length = 300 - value.length;
            if(left_length >= 0){
                jQuery("#comment_wordLeft").removeClass("text_warning");
                jQuery("#comment_wordLeft").text("您还可以再输入" + left_length + "个字。");
            }else{
                jQuery("#comment_wordLeft").text("最多只能输入300个字");
                jQuery("#comment_wordLeft").addClass("text_warning");
            }
        }
        // 审批意见输入栏 keypress事件触发change事件
        function onKeyPress_approval_comment_ta(field,e){
            var ta = $("approval_comment_ta");
            var comment = field.el.dom.value || '';
            ta.fireEvent("change",ta,comment,'');
        }
        // 审批意见输入栏 valid
        function approval_comment_validator(record,name,value){
            if(!!value && value.length >300 ){
                return "审批意见最多只能输入300个字！"
            }
            return true;
        }
        // 抄送列表grid add
        function carbon_copy_employee_grid_add(){
            $('carbon_copy_employee_grid').showEditorByRecord($('carbon_copy_employee_ds').create());
        }
        // 抄送列表grid del
        function carbon_copy_employee_grid_del(){
            var ds = $('carbon_copy_employee_ds');
            var records = ds.getSelected();
            var length = records.length;
            for(var i=0;i<length;i++){
                ds.remove(records[i]);
            }
        }
        jQuery('#btn-approved').click(function () {
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
