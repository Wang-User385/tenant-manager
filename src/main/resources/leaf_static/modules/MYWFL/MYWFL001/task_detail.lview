<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-10-24
    $Revision: 1.0
    $Purpose: 我的待办详情
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <style>
            .text_warning{
                color:red;
            }
            .btn{
                cursor: pointer;
                padding: 3px 15px;
                border-radius: 0px;
                line-height: 1.7;
                vertical-align: middle;
                transition: all .25s;
                display: inline-block;
                margin-bottom: 0;
                font-size: 14px;
                font-weight: 400;
                text-align: center;
                white-space: nowrap;
                user-select: none;
                background-image: none;
                border: 1px solid transparent;
                margin-right:8px;
            }
            .btn-primary {
                color:#fff;
                background-color: #1D92AF;
                border-color: #198099;
            }
            .btn-primary:hover, .btn-primary:focus, .btn-primary:active, .btn-primary.active, .btn-primary .open .dropdown-toggle.btn-primary {
                background-color: #198099;
            }
            .btn-info {
                color:#fff;
                background-color: #46B0CF;
                border-color: #34a6c8;
            }
            .btn-info:hover, .btn-info:focus, .btn-info:active, .btn-info.active, .btn-info .open .dropdown-toggle.btn-info {
                background-color: #34a6c8;
            }

            .btn-success:hover, .btn-success:focus, .btn-success:active, .btn-success.active, .btn-success .open .dropdown-toggle.btn-success {
                background-color: #439643;
            }
            .btn-success {
                color: #fff;
                background-color: #449d44;
                border-color: #398439;
            }
            .btn-warning:hover, .btn-warning:focus, .btn-warning:active, .btn-warning.active, .btn-warning .open .dropdown-toggle.btn-warning {
                background-color: #e49626;
            }
            .btn-warning {
                color: #fff;
                background-color: #ec971f;
                border-color: #d58512;
            }
            html, body {
                background: white;
            }
        </style>
        <script><![CDATA[
        //保存当前流程信息用于子页面取值
        var processInfo = null;
        // 优先级等级
        var priorityArr = [
            {min:null,max:33},
            {min:34,max:66},
            {min:67,max:null}
        ];
        // 当前待办信息
        var currentTaskInfo = {};

        var process_definition_id = '';//工作流代码
        var task_definition_key = '';//工作流节点key

        function getTaskWin(){
            if('${/parameter/@winid}' != '' && '${/parameter/@winid}' != null){
                return $("${/parameter/@winid}");
            }
            if('${/parameter/@winId}' != '' && '${/parameter/@winId}' != null){
                return $("${/parameter/@winId}");
            }
            return $("task_detail_win");
        }
        function getTaskWinId(){
            if('${/parameter/@winid}' != '' && '${/parameter/@winid}' != null){
                return "${/parameter/@winid}";
            }
            if('${/parameter/@winId}' != '' && '${/parameter/@winId}' != null){
                return "${/parameter/@winId}";
            }
            return "task_detail_win";
        }
        $L.onReady(function(){
            // 隐藏审批历史导出按钮
            jQuery("#process_instance_history_grid_tb .grid-excel").hide();

            // 隐藏抄送列表导出按钮
            jQuery("#carbon_copy_employee_grid_tb .grid-excel").hide();

            // 请求当前待办详细信息
            var adminflag = "${/request/@isAdmin}" || false ,
                adminUrl = adminflag ? 'admin/' : '';
            var queryUrl = '${/request/@context_path}/wfl/runtime/' + adminUrl + 'tasks/' + "${/parameter/@taskId}" + '/details';
            var taskPriority
            Ext.Ajax.request({
                url: queryUrl,
                success: function(res){
                    on_current_task_detail_load_success(res);
                },
                failure: function(res){
                    Leaf.showErrorMessage("错误","查询流程失败"+res.error.message||'',function(){
                        getTaskWin().close();
                    },300,200)
                },
                method: "GET",
                headers: {
                    'X-CSRF-TOKEN': "${/session/@_csrf.token}",
                    'springflag': "Y"
                }
            });

        });
        // 当前待办信息加载成功执行
        function on_current_task_detail_load_success(res){
            res = JSON.parse(res.responseText);
            processInfo = res;
            if(res.success){
                // 审批事项数据-current_task_detail_ds
                res = res.result.record[0];
                var dataObj = {
                    "process_instance_name" : res.process_instance.process_definition_name,
                    "process_instance_id" : res.id,
                    "start_user_id" : res.process_instance.start_user_id,
                    "start_user_name" : res.process_instance.start_user_name,
                    "start_time" : res.process_instance.start_time,
                    "priority" : res.priority>66 ? '高' : (res.priority>33 ? '中' : '低')
                };
                $("current_task_detail_ds").create(dataObj);
                currentTaskInfo = res;

                // 审批历史数据-task_approve_history_ds
                var approveHistory = res.historic_task_list;
                approveHistory.forEach(function(i){
                    $('task_approve_history_ds').create({
                        "end_time":i.end_time,
                        "name":i.name,
                        "assignee_id":i.assignee,
                        "assignee":i.assignee_name,
                        "process_instance_id":i.process_instance_id,
                        "action":i.action,
                        "action_desc":i.action_desc,
                        "comment":i.comment,
                        "execution_id":i.execution_id,
                        "id":i.id,
                        "process_definition_id":i.process_definition_id,
                        "start_time":i.start_time,
                        "tenant_id":i.tenant_id,
                        "variables":i.variables,
                        "processInstanceId":i.process_instance_id
                    });
                });
                // 事项详情iframe
                if(!!res.form_key && !!res.process_instance.business_key){
                    var formKey = res.form_key||'';
                    var businessKey = res.process_instance.business_key||'';
                    if(formKey.indexOf("?") != -1){
                        var iframeUrl = '${/request/@context_path}' + '/' + formKey + '&businessKey=' + businessKey + '&wflRuleControlFlag=Y' + '&processInstanceId=${/parameter/@processInstanceId}&taskId=${/parameter/@taskId}';
                    }else {
                        var iframeUrl = '${/request/@context_path}' + '/' + formKey + '?businessKey=' + businessKey + '&wflRuleControlFlag=Y' + '&processInstanceId=${/parameter/@processInstanceId}&taskId=${/parameter/@taskId}';
                    }
                    document.getElementById('includeFrame').src = iframeUrl;
                }
                // 根据数据更新操作按钮
                updateApproveButton(res);
            }else{
                Leaf.showErrorMessage("错误","查询流程失败"+res.error.message||'',function(){
                    getTaskWin().close();
                },300,200)
            }
        }
        // 审批动作 renderer
        function actionRender(value,record,name){
            if(!!value) {
                if(record.get('action_desc') != null){
                    return record.get('action_desc');
                }
                if (value == 'APPROVED') {
                    value = "<span class='action_ok'>同意</span>";
                } else if (value == 'REJECTED') {
                    value = "<span class='action_dangerous'>拒绝</span>";
                } else if(value == 'PEER_REJECTED'){
                    value = "<span class='action_dangerous'>点对点退回业务经理</span>";
                } else if (value == 'DELEGATE') {
                    value = "<div class='action_dangerous'>转交</div>";
                }
                else{
                        value = value || ''
                    }
                    return value;
                }
            return "";
        }
        // 待办事项数据加载后 根据数据更新底部操作按钮
        function updateApproveButton(res){
            jQuery('#head_flag').show();
            jQuery('#approval_comments').show();
            jQuery('#btn-approved').show();
            jQuery('#btn-rejected').show();
            jQuery('#btn-peer-rejected').hide();
            var currentTaskInfo = res;

            currentTaskInfo.form_data.form_properties.forEach(function(value,i,arr){
                if (value.id == 'approveResult' && value.type == 'enum') {
                    var findApproved = false, findReject = false, findPeerRejected = false;
                    value.enum_values.forEach(function (rr,i) {
                        if (isContains(rr.id) && rr.name) {
                            var openBox = jQuery("<button/>").attr({
                                'id': 'btn-custom-' + rr.id,
                                'type': "button",
                                'class': "btn btn-primary",
                                'action': rr.id
                            });
                            openBox.text(rr.name);
                            jQuery('#custom-btn-container').append(openBox);
                            openBox.click(function () {
                                openBoxAction(rr.id, rr.name);
                            });
                        } else if (rr.id == 'APPROVED' && rr.name) {
                            findApproved = true;
                            jQuery('#text-approved').text(rr.name)
                        } else if (rr.id == 'REJECTED' && rr.name) {
                            findReject = true;
                            jQuery('#text-rejected').text(rr.name)
                        } else if(rr.id == 'PEER_REJECTED' && rr.name){
                            findPeerRejected = true;
                            jQuery('#text-peer-rejected').text(rr.name)
                        } else {
                            //  custom button
                            var cb0 = jQuery("<button/>").attr({
                                'id': 'btn-custom-' + rr.id,
                                'type': "button",
                                'class': "btn btn-primary",
                                'action': rr.id
                            });
                            cb0.text(rr.name);
                            jQuery('#custom-btn-container').append(cb0);
                            cb0.click(function () {
                                customApproveAction(rr.id);
                            });
                        }
                    });
                    if (findApproved) {
                        jQuery('#btn-approved').show();
                    }
                    if (findReject) {
                        jQuery('#btn-rejected').show();
                    }
                    if(findPeerRejected){
                        jQuery('#btn-peer-rejected').show();
                    }
                }
                if (value.id == 'APPROVAL_ACTION' && value.type == 'enum') {
                    jQuery.each(value.enum_values, function (ii, rr) {
                        if (rr.id == 'DELEGATE_FLAG' && rr.name) {
                            if (rr.name == 'Y') {
                                jQuery('#btn-delegate').show();
                            }
                        }
                    });
                }
            });

            process_definition_id = currentTaskInfo.process_definition_id;
            task_definition_key = currentTaskInfo.task_definition_key;
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S4' ||
                task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S5' ||
                task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S6' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS6'||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS7'||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS8'){
                jQuery('#chance_appoint_form').show();
                jQuery('#btn-rejected').hide();
            }
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S14' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS16'){
                jQuery('#chance_meeting_select_form').show();
            }
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S15' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS18'){
                jQuery('#chance_vote_form').show();
            }


        }

        function onChange_approval_comment_ta(ta,value,pre_value){
            var left_length = 1000 - value.length;
            if(left_length >= 0){
                jQuery("#comment_wordLeft").removeClass("text_warning");
                jQuery("#comment_wordLeft").text("您还可以再输入" + left_length + "个字。");
            }else{
                jQuery("#comment_wordLeft").text("最多只能输入1000个字");
                jQuery("#comment_wordLeft").addClass("text_warning");
            }
        }

        function approval_comment_validator(record,name,value){
            if(!!value && value.length >1000 ){
                // 保留前 1000 个字符
                //record.set('comment', value.substring(0, 1000));
                return "审批意见最多只能输入1000个字！"
            }
            return true;
        }

        jQuery('#btn-approved').click(function () {
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
                return false;
            }
            //长度不能超过1000字符
            if(comment.length > 1000){
                Leaf.showMessage('提示','审批意见最多只能输入1000个字！');
                return false;
            }
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S4' ||
                task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S5' ||
                task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S6' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS6'||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS7'||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS8'){
                var appoint_record = $('chance_appoint_user_ds').getCurrentRecord();
                if(Ext.isEmpty(appoint_record)){
                    Leaf.showMessage('提示','请先分配审查人员，再操作！');
                    return false;
                }
                var allocation_id = appoint_record.get('allocation_id');
                if(Ext.isEmpty(allocation_id)){
                    Leaf.showMessage('提示','请先分配审查人员，再操作！');
                    return false;
                }
            }
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S14' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS16'){
                var chance_meeting = $('chance_meeting_select_ds').getCurrentRecord();
                if(Ext.isEmpty(chance_meeting)){
                    Leaf.showMessage('提示','请选择会议形式');
                    return false;
                }
                var meeting_type = chance_meeting.get('meeting_type');
                if(Ext.isEmpty(meeting_type)){
                    Leaf.showMessage('提示','请选择会议形式');
                    return false;
                }
            }
            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S15' ||
                task_definition_key == 'FACTORING_PROJRCT_PROPOSALS18'){
                var chance_vote = $('chance_vote_ds').getCurrentRecord();
                if(Ext.isEmpty(chance_vote)){
                    Leaf.showMessage('提示','请选择投票结果');
                    return false;
                }
                var vote_status = chance_vote.get('vote_status');
                if(Ext.isEmpty(vote_status)){
                    Leaf.showMessage('提示','请选择投票结果');
                    return false;
                }
            }

            Leaf.showOkCancelWindow("确认","确认提交？",function () {
                taskAction({approveResult: 'APPROVED', approveResultDesc: jQuery('#text-approved').text()});
            },function () {return true;},200,200)
        });

        jQuery('#btn-rejected').click(function () {
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
                return false;
            }
            //长度不能超过1000字符
            if(comment.length > 1000){
                Leaf.showMessage('提示','审批意见最多只能输入1000个字！');
                return false;
            }
            Leaf.showOkCancelWindow("提示","确认拒绝？",function (e) {
                taskAction({approveResult: 'REJECTED', approveResultDesc: jQuery('#text-rejected').text()});
            },function () {return true;},200,200);
        });

        jQuery('#btn-delegate').click(function () {
            var processInstanceId = currentTaskInfo.process_instance_id;
            var taskId = currentTaskInfo.id;
            var pWinId = 'task_detail_win';
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
                return false;
            }
            //长度不能超过1000字符
            if(comment.length > 1000){
                Leaf.showMessage('提示','审批意见最多只能输入1000个字！');
                return false;
            }
            if('${/parameter/@winid}' != '' && '${/parameter/@winid}' != null){
                pWinId = '${/parameter/@winid}';
            }
            var win = new Leaf.Window({
                id: 'win_delegate_task',
                url: '${/request/@context_path}/modules/WFL/WFL003/process_delegate_task.lview',
                params: {
                    id: processInstanceId,
                    taskId: taskId,
                    action:"delegate",
                    winId: 'win_delegate_task',
                    pWinId: pWinId,
                    comment: comment
                },
                title: '转交',
                width: 800,
                height: 535
            });
        });

        jQuery('#btn-peer-rejected').click(function () {
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if(comment == "" || comment == null){
                Leaf.showMessage('提示','请先输入审批意见，再操作！');
                return false;
            }
            //长度不能超过1000字符
            if(comment.length > 1000){
                Leaf.showMessage('提示','审批意见最多只能输入1000个字！');
                return false;
            }
            Leaf.showOkCancelWindow("提示","确认？",function (e) {
                taskAction({approveResult: 'PEER_REJECTED', approveResultDesc: jQuery('#text-peer-rejected').text()});
            },function () {return true;},200,200);
        });

        function openBoxAction(url, title) {
            url = "${request/@context_path}" + url;
            new Leaf.Window({
                id: 'openBoxWindow'+title,
                url: url,
                title: title,
                width:800,
                height:400
            });
        }

        function customApproveAction(actionId) {
            var cb0 = jQuery('#btn-custom-' + actionId);
            Leaf.showInfoMessage("提示", cb0.text(), function (e) {
                taskAction({approveResult: actionId, approveResultDesc: cb0.text()});
            }, 200, 200);
        }

        function taskAction(p) {
            debugger;
            p = p || {};
            p.action = p.action || 'complete'
            if ('pending' == currentTaskInfo.delegation_state && 'delegate' != p.action) {
                p.action = 'resolve'
            }
            var variables = [];
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if (p.action != 'delegate') {
                var formVars = {};
                if (includeFrame.getFormProperties) {
                    formVars = includeFrame.getFormProperties() || {};
                }
                formVars.approveResult = p.approveResult;
                formVars.approveResultDesc = p.approveResultDesc;
                formVars.comment = comment;
                jQuery.each(formVars, function (k, v) {
                    variables.push({name: k, value: v});
                })
            }
            var params = {};
            var includeContentWindow = document.getElementById('includeFrame').contentWindow;
            if (includeContentWindow.getParams && typeof(includeContentWindow.getParams) == 'function') {
                params = includeContentWindow.getParams();
            }

            var beforeSubmit = null;
            if (includeContentWindow.beforeSubmit && typeof(includeContentWindow.beforeSubmit) == 'function') {
                beforeSubmit = includeContentWindow.beforeSubmit;
            }

            var carbonCopyUsers = "";
            var usersData = $("carbon_copy_employee_ds").data;
            for (var i = 0; i < usersData.length; i++) {
                if (i == 0) {
                    carbonCopyUsers = usersData[i].data.employee_code;
                } else {
                    carbonCopyUsers = carbonCopyUsers + "," + usersData[i].data.employee_code;
                }
            }

            var param = {
                assignee: p.targetUser || null,
                action: p.action,
                comment: comment,
                variables: variables,
                jumpTarget: p.jumpTarget || null,
                carbonCopyUsers: carbonCopyUsers,
                //processInstanceId: '${/parameter/@processInstanceId}',
            };
            if (beforeSubmit != null) {
                beforeSubmit(function () {
                    submit(p, param);
                });
                return;
            }
            submit(p, param);
        }

        function submit(p, param) {
            Leaf.Masker.mask(getTaskWin().wrap,"正在操作...");
            var isAdmin = '${/parameter/@isAdmin}' ? "/admin" : "";
            jQuery.ajax({
                url: '${/request/@context_path}/wfl/runtime' + isAdmin + '/tasks/${/parameter/@taskId}',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(param),
                success: function (args) {
                    if (args.success === false) {
                        Leaf.Masker.unmask(getTaskWin().wrap);
                        Leaf.showInfoMessage("错误",JSON.stringify(args.error.message),null,200,200);
                    } else {
                        if (p.callback) {
                            p.callback(args);
                        } else {
                            Leaf.Masker.unmask(getTaskWin().wrap);
                            Leaf.showInfoMessage("提示","操作完成",function () {
                                getTaskWin().close();
                            },200,200);
                        }
                    }
                },
                error: function (args) {
                    Leaf.Masker.unmask(getTaskWin().wrap);
                    Leaf.showInfoMessage("错误",JSON.stringify(args),null,200,200);
                },
                headers: {
                    'X-CSRF-TOKEN': "${/session/@_csrf.token}",
                    'springflag': "Y"
                }
            })
        }

        function isContains(str) {
            var strView = ".view";
            var strHtml = ".html";
            return ((str.indexOf(strView) >= 0) || (str.indexOf(strHtml) >= 0));
        }

        function onIncludeFrameLoad() {
            var ifm = document.getElementById("includeFrame");
            var subWeb = document.frames ? document.frames["includeFrame"].document : ifm.contentDocument;
            if (ifm != null && subWeb != null) {
                ifm.height = subWeb.body.scrollHeight + 30;
                if (parent.autoResizeIframe) {
                    parent.autoResizeIframe(_currentFunctionCode)
                }

            }
        }

        function approval_comments_ds_beforeload(){

        }

        function chance_appoint_handler(lov) {
            var ds = $('chance_appoint_user_ds');
            ds.create();
            var record = ds.getCurrentRecord();
            var name = record.getMeta().getField('name');

            if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S4'){
                name.setLovPara('unit_code','EXAMINATION_APPROVAL_DEPARTMENT');
            }else if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S5'){
                name.setLovPara('unit_code','RISK_AUDIT_DEPARTMENT');
            }else if(task_definition_key == 'CREDIT_CHANCE_CREATE_WFL_S6'){
                name.setLovPara('unit_code','MINISTRY_LAW_DEPT');
            }
        }

        ]]></script>
        <a:dataSets>
            <!--审批事项信息-->
            <a:dataSet id="current_task_detail_ds">
                <a:fields>
                    <a:field name="process_instance_name"/>
                    <a:field name="process_instance_id"/>
                    <a:field name="start_user_id"/>
                    <a:field name="start_user_name"/>
                    <a:field name="start_time"/>
                    <a:field name="priority"/>
                </a:fields>
            </a:dataSet>
            <!--审批历史-->
            <a:dataSet id="task_approve_history_ds">
                <a:fields>
                    <a:field name="end_time"/><!--审批时间-->
                    <a:field name="name"/><!--审批环节-->
                    <a:field name="assignee"/><!--审批人-->
                    <a:field name="action"/><!--审批动作-->
                    <a:field name="action_desc"/>
                    <a:field name="comment" readOnly="true"/><!--审批意见-->
                    <a:field name="start_time"/>
                    <a:field name="assignee_id"/>
                    <a:field name="execution_id"/>
                    <a:field name="process_definition_id"/>
                    <a:field name="start_time"/>
                    <a:field name="tenant_id"/>
                    <a:field name="variables"/>
                </a:fields>
            </a:dataSet>
            <!--审批意见-->
            <a:dataSet id="approval_comments_ds" autoCreate="true">
                <a:fields>
                    <a:field name="comment" required="true"  validator="approval_comment_validator"/>
                </a:fields>
                <a:events>
                    <a:event name="beforeload" handler="approval_comments_ds_beforeload"/>
                </a:events>
            </a:dataSet>
            <!--抄送列表-->
            <a:dataSet id="carbon_copy_employee_ds" selectable="true" pageSize="5">
                <a:fields>
                    <a:field name="employee_name" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovLabelWidth="100" lovService="/fnd/employee/query~com.hand.hls.sys.dto.LovFndEmployee" lovWidth="600"
                             title="员工选择" fetchRemote="false">
                        <a:mapping>
                            <a:map from="name" to="employee_name"/>
                            <a:map from="employee_code" to="employee_code"/>
                            <a:map from="employee_id" to="employee_id"/>
                            <a:map from="unit_name" to="unit_name"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
            </a:dataSet>
            <a:dataSet id="chance_appoint_user_ds" pageSize="1">
                <a:fields>
                    <a:field name="allocation_id"/>
                    <a:field name="name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov" lovWidth="550"
                             title="经办人员" prompt="经办人员">
                        <a:mapping>
                            <a:map from="allocation_id" to="allocation_id"/>
                            <a:map from="name" to="name"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="company_short_name"/>
                    <a:field name="unit_name"/>
                    <a:field name="position_name"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="meeting_type_ds" lookupCode="CHANCE.MEETING_TYPE"/>
            <a:dataSet id="chance_meeting_select_ds" autoCreate="true">
                <a:fields>
                    <a:field name="meeting_type_n" displayField="code_value_name" options="meeting_type_ds"
                             returnField="meeting_type" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="vote_status_ds" lookupCode="CHANCE.FACTORING_RESULT"/>
            <a:dataSet id="chance_vote_ds" autoCreate="true">
                <a:fields>
                    <a:field name="vote_status_n" displayField="code_value_name" options="vote_status_ds"
                             returnField="vote_status" valueField="code_value"/>
                    <a:field name="vote_comment"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <!--审批事项信息-->
            <a:form  title="审批事项" id="head_flag">
                <a:box column="3" labelWidth="133">
                    <a:label name="process_instance_name" prompt="流程" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                    <a:label name="start_time" prompt="申请时间" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                    <a:label name="start_user_name" prompt="申请人" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                </a:box>
            </a:form>
            <!--审批事项详情iframe-->
            <a:form title="事项详情">
                <iframe onLoad="onIncludeFrameLoad()" scrolling="yes" id="includeFrame" style="border:0;"/>
                <script><![CDATA[
                    var screenWidth = $L.getViewportWidth();
                    var ifm = document.getElementById("includeFrame");
                    ifm.width = screenWidth-50;
                    ]]></script>
            </a:form>
            <!--审批历史/流程图-->
            <a:tabPanel marginWidth="150" height="350" id="approve_info_tab">
                <a:tabs>
                    <a:tab prompt="审批历史" width="110" selected="true" id="approve_his_tab">
                        <a:grid id="process_instance_history_grid" bindTarget="task_approve_history_ds"
                                width="1300" canWheel="false" height="220" navBar="false">
                            <a:columns>
                                <a:column name="end_time" width="150" prompt="处理时间" align="center"/>
                                <a:column name="name" width="250" prompt="处理环节" align="center"/>
                                <a:column name="assignee" width="150" prompt="处理人" align="center"/>
                                <a:column name="action" width="250" prompt="处理动作" align="center" renderer="actionRender"/>
                                <a:column name="comment" editor="process_instance_history_grid_textArea" showTitle="true" width="450" prompt="处理意见" align="center"/>
                            </a:columns>
                            <a:editors>
                                <a:textArea id="process_instance_history_grid_textArea"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="流程图" width="130" id="approve_process_img_tab">
                        <div class="tab-pane fade" id="processImg">
                            <embed id="svg" type="image/svg+xml"
                                   src="${/request/@context_path}/wfl/runtime/process-instances/${/parameter/@processInstanceId}/diagram"/>
                        </div>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
            <!--审批意见-->
            <a:form title="处理意见" id="approval_comments" style="display: none;">
                <a:textArea bindTarget="approval_comments_ds" name="comment" id="approval_comment_ta" width="1300" height="150" emptyText="请输入处理意见">
                    <a:events>
                        <a:event name="change" handler="onChange_approval_comment_ta"/>
                    </a:events>
                </a:textArea>
                <div id="comment_wordLeft"></div>
            </a:form>
            <a:form title="分配经办员" id="chance_appoint_form" labelWidth="120" style="display: none;">
                <a:lov name="name" width="365" prompt="指派经办人员" required="true"
                       bindTarget="chance_appoint_user_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="chance_appoint_handler"/>
                    </a:events>
                </a:lov>
            </a:form>
            <a:form title="会议形式" id="chance_meeting_select_form" labelWidth="120" style="display: none;">
                <a:comboBox name="meeting_type_n" bindTarget="chance_meeting_select_ds" prompt="会议形式" required="true"/>
            </a:form>
            <a:form title="投票信息" id="chance_vote_form" labelWidth="120" style="display: none;">
                <a:comboBox name="vote_status_n" bindTarget="chance_vote_ds" prompt="投票结果" required="true"/>
                <a:textField name="vote_comment" width="1300" prompt="投票意见" bindTarget="chance_vote_ds"/>
            </a:form>
            <!--操作按钮-->
            <div style="height:40px;">
                <button id='btn-approved' type="button" class="btn btn-success" style="display: none;">
                    <span class="fa fa-check-circle"></span><span id='text-approved'>同意</span>
                </button>
                <button id='btn-rejected' type="button" class="btn btn-warning" style="display: none;">
                    <span class="fa fa-times-circle"></span><span id='text-rejected'>拒绝</span>
                </button>
                <button id="btn-delegate" type="button" class="btn btn-primary" style="display: none;">
                    <span class="fa fa-arrow-circle-right"></span><span id='text-delegate'>转交</span>
                </button>
                <button id='btn-peer-rejected' type="button" class="btn btn-warning" style="display: none;">
                    <span class="fa fa-times-circle"></span><span id='text-peer-rejected'>点对点退回业务经理</span>
                </button>
                <div id="custom-btn-container" style="display: inline-block;"> </div>
                <div id="custom-btn-open" style="display: inline-block;"> </div>
            </div>
        </a:screenBody>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
