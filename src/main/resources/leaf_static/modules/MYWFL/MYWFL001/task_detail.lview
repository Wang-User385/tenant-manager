            var taskId = currentTaskInfo.id;
            var projectId = currentTaskInfo.process_instance.business_key;
            if($('risk_appoint_user_ds').getCurrentRecord() != null && $('risk_appoint_user_ds').getCurrentRecord().get('allocation_id') != undefined){
                var appointRisk = $('risk_appoint_user_ds').getCurrentRecord().get('allocation_id');
                //var appointPrice = $('price_appoint_user_ds').getCurrentRecord().get('allocation_id');
                var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
                var paramList = [];
                var param = {"appointRisk": appointRisk, "action": 'APPROVED_GENERAL', taskId: taskId, projectId: projectId, comment: comment, approveResultDesc: jQuery('#text-approved-general').text() , documentCategory : documentCategory};
                paramList.push(param);
                Leaf.showOkCancelWindow("提示","确认指派？",function (e) {
                    Leaf.Masker.mask(Ext.getBody());
                    Leaf.request({
                        url: '${/request/@context_path}/wfl/leaf/runtime/execute/general/' + processInstanceId + '?appointRisk=' + appointRisk,
                        para: paramList,
