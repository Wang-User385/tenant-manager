        </a:dataSets>
        <a:screenBody>
            <!--审批事项信息-->
            <a:form  title="审批事项" id="head_flag">
                <a:box column="3" labelWidth="133">
                    <a:label name="process_instance_name" prompt="流程" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                    <a:label name="start_time" prompt="申请时间" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                    <a:label name="start_user_name" prompt="申请人" bindTarget="current_task_detail_ds" width="165" readOnly="true"/>
                </a:box>
                <!--<a:box column="3" labelWidth="133">

                </a:box>-->
            </a:form>
            <!--审批事项详情iframe-->
            <a:form title="事项详情">
                <iframe onLoad="onIncludeFrameLoad()" scrolling="yes" id="includeFrame" style="border:0;"/>
                <script><![CDATA[
                    var screenWidth = $L.getViewportWidth();
                    var ifm = document.getElementById("includeFrame");
                    ifm.width = screenWidth-50;
                    ]]></script>
            </a:form>
            <!--审批历史/流程图-->
            <a:tabPanel marginWidth="150" height="350" id="approve_info_tab">
                <a:tabs>
                    <a:tab prompt="审批历史" width="110" selected="true" id="approve_his_tab">
                        <a:grid id="process_instance_history_grid" bindTarget="task_approve_history_ds"
                                width="1300" canWheel="false" height="220" navBar="false">
                            <a:columns>
                                <a:column name="end_time" width="150" prompt="处理时间" align="center"/>
                                <a:column name="name" width="250" prompt="处理环节" align="center"/>
                                <a:column name="assignee" width="150" prompt="处理人" align="center"/>
                                <a:column name="action" width="250" prompt="处理动作" align="center" renderer="actionRender"/>
                                <a:column name="comment" editor="process_instance_history_grid_textArea" showTitle="true" width="450" prompt="处理意见" align="center"/>
                            </a:columns>
                            <a:editors>
                                <a:textArea id="process_instance_history_grid_textArea"/>
                            </a:editors>
                        </a:grid>
                    </a:tab>
                    <a:tab prompt="流程图" width="130" id="approve_process_img_tab">
                        <div class="tab-pane fade" id="processImg">
                            <embed id="svg" type="image/svg+xml"
                                   src="${/request/@context_path}/wfl/runtime/process-instances/${/parameter/@processInstanceId}/diagram"/>
                        </div>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
            <!--抄送-添加员工-->
<!--            <a:form title="抄送列表">-->
<!--                <a:box column="2">-->
<!--                    <a:button click="carbon_copy_employee_grid_add" id="carbon_copy_btn" text="添加"/>-->
<!--                    <a:button click="carbon_copy_employee_grid_del" id="carbon_del_btn" text="删除"/>-->
<!--                </a:box>-->
<!--                <a:grid id="carbon_copy_employee_grid" bindTarget="carbon_copy_employee_ds"-->
<!--                        height="220" canWheel="false" width="1300" navBar="false">-->
<!--                    <a:columns>-->
<!--                        &lt;!&ndash;                        <a:column width="200" name="employee_code"&ndash;&gt;-->
<!--                        &lt;!&ndash;                                  editor="carbon_copy_employee_grid_lov" prompt="员工编码" align="center"/>&ndash;&gt;-->
<!--                        <a:column width="600" name="employee_name"  editor="carbon_copy_employee_grid_lov"  prompt="员工名称" align="center"/>-->
<!--                        <a:column width="600" name="unit_name" prompt="部门" align="center"/>-->
<!--                    </a:columns>-->
<!--                    <a:editors>-->
<!--                        <a:lov id="carbon_copy_employee_grid_lov"/>-->
<!--                    </a:editors>-->
<!--                </a:grid>-->
<!--            </a:form>-->
            <!--审批意见-->
            <a:form title="处理意见" id="approval_comments" style="display: none;">
                <a:comboBox bindTarget="approval_comments_ds" name="general_com_cn" id="general_approval_comments_combo" emptyText="常用审批语" width="230">
                    <a:events>
                        <a:event name="select" handler="onSelect_general_approval_comments_combo"/>
                    </a:events>
                </a:comboBox>
                <a:textArea bindTarget="approval_comments_ds" name="comment" id="approval_comment_ta" width="1300" height="150" emptyText="请输入处理意见">

                </a:textArea>
                <div id="comment_wordLeft"></div>
            </a:form>
            <!--项目指派审查岗-->
            <a:form title="分配审查员" id="risk_appoint" labelWidth="120">
                <a:lov name="name" width="365" prompt="审查人员" required="true"
                       bindTarget="risk_appoint_user_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="risk_appoint_handler"/>
                    </a:events>
                </a:lov>
            </a:form>
            <!--上会选择有权人-->
            <a:form title="审批路径" id="powerful_choose">
                <a:comboBox name="powerful_person_n" width="365" prompt="有权人" required="true"
                       bindTarget="powerful_person_choose_ds">
                </a:comboBox>
                <a:lov name="powerful_employee_n" width="365" prompt="主任委员" required="true"
                            bindTarget="powerful_person_choose_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="powerful_employee_handler"/>
                    </a:events>
                </a:lov>
            </a:form>
            <!--存续期选择有权人-->
            <a:form title="审批路径" id="duration_choose">
                <a:comboBox name="duration_person_n" width="365" prompt="有权人" required="true"
                            bindTarget="duration_person_choose_ds">
                </a:comboBox>
                <a:lov name="duration_employee_n" width="365" prompt="副总裁审批节点一"
                       bindTarget="duration_person_choose_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="duration_employee_handler"/>
                    </a:events>
                </a:lov>
                <a:lov name="duration_employee_two_n" width="365" prompt="副总裁审批节点二"
                       bindTarget="duration_person_choose_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="duration_employee_handler_two"/>
                    </a:events>
                </a:lov>
            </a:form>
<!--            合同节点选择-->
            <a:form title="节点选择" id="con_end_task">
                <a:comboBox name="con_end_task_n" width="365" prompt="审批路径" required="true"
                            bindTarget="con_end_task_ds">
                </a:comboBox>

            </a:form>
<!--            付款结束节点选择-->
            <a:form title="节点选择" id="payment_end_task">
                <a:comboBox name="con_end_task_n" width="365" prompt="审批路径" required="true"
                            bindTarget="payment_end_task_ds">
                </a:comboBox>
            </a:form>
<!--            付款前提条件节点选择-->
            <a:form title="审批路径" id="condition_task">
                <a:comboBox name="end_task_node_id_n" width="365" prompt="审批路径" required="true"
                            bindTarget="condition_task_ds">
                </a:comboBox>
                <a:lov name="condition_employee_n" width="365" prompt="副总裁选择" required="true"
                       bindTarget="condition_task_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="condition_employee_handler"/>
                    </a:events>
                </a:lov>
            </a:form>
            <!--<a:form title="价格审查" id="price_appoint">
                <a:lov name="name" width="365" prompt="审批人" required="true"
                       bindTarget="price_appoint_user_ds">
                    <a:events>
                        <a:event name="beforetriggerclick" handler="price_appoint_handler"/>
                    </a:events>
                </a:lov>
            </a:form>-->
            <!--操作按钮-->
            <div style="height:40px;">
                <button id="btn-review" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-review'>提交业审委审议</span>
                </button>
                <button id="btn-print" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-arrow-down"></span><span id='text-print'>打印报表</span>
                </button>
                <button id='btn-approved' type="button" class="btn btn-success" style="display: none;">
                    <span class="fa fa-check-circle"></span><span id='text-approved'>同意</span>
                </button>
                <button id="btn-add-appoint" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-add-appoint'>确认指派</span>
                </button>
                <button id="btn-approved_general" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-approved-general'>确认指派</span>
                </button>
                <button id="btn-review-approved" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-review-approved'>提交复审</span>
                </button>
                <button id="btn-con-endTask" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-con-endTask'>同意</span>
                </button>
                <button id="btn-pay-endTask" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-pay-endTask'>同意</span>
                </button>
                <button id="btn-powerful-choose" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-powerful-choose'>同意</span>
                </button>
                <button id="btn-duration-choose" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-duration-choose'>同意</span>
                </button>
                <button id="btn-condition-task" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-condition-task'>同意</span>
                </button>
                <button id="btn-suspend" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-suspend'>暂缓</span>
                </button>
                <button id='btn-rejected' type="button" class="btn btn-warning" style="display: none;">
                    <span class="fa fa-times-circle"></span><span id='text-rejected'>拒绝</span>
                </button>
                <button id='btn-peer-rejected' type="button" class="btn btn-warning" style="display: none;">
                    <span class="fa fa-times-circle"></span><span id='text-peer-rejected'>点对点退回业务经理</span>
                </button>
                <button id='btn-rejected-accept' type="button" class="btn btn-warning" style="display: none;">
                    <span class="fa fa-times-circle"></span><span id='text-rejected-accept'>拒绝</span>
                </button>
                <div id="custom-btn-container" style="display: inline-block;"> </div>
                <div id="custom-btn-open" style="display: inline-block;"> </div>
                <button id="btn-add-approver" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-add-approver'>添加审批人</span>
                </button>
                <button id="btn-add-assign" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-add-assign'>指派</span>
                </button>
                <button id="btn-withdraw" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-withdraw'>项目撤回</span>
                </button>
                <button id="btn-return" type="button" class="btn btn-info" style="display: none;">
                    <span class="fa fa-user-plus"></span><span id='text-return'>退回项目经理</span>
                </button>
                <button id="btn-delegate" type="button" class="btn btn-primary" style="display: none;">
                    <span class="fa fa-arrow-circle-right"></span><span id='text-delegate'>转交</span>
                </button>
            </div>
            <!--placeholder-->
            <!--<div style="height:280px;"></div>-->

        </a:screenBody>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
