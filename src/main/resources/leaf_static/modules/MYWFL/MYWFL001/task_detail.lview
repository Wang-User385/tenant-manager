        function taskAction(p) {
            p = p || {};
            p.action = p.action || 'complete'
            if ('pending' == currentTaskInfo.delegation_state && 'delegate' != p.action) {
                p.action = 'resolve'
            }
            var variables = [];
            var comment = $("approval_comments_ds").data[0] ? $("approval_comments_ds").data[0].data["comment"] : "";
            if (p.action != 'delegate') {
                var formVars = {};
                if (includeFrame.getFormProperties) {
                    formVars = includeFrame.getFormProperties() || {};
                }
                formVars.approveResult = p.approveResult;
                formVars.approveResultDesc = p.approveResultDesc;
                formVars.comment = comment;
                jQuery.each(formVars, function (k, v) {
                    variables.push({name: k, value: v});
                })
            }
            var params = {};
            var includeContentWindow = document.getElementById('includeFrame').contentWindow;
            if (includeContentWindow.getParams && typeof(includeContentWindow.getParams) == 'function') {
                params = includeContentWindow.getParams();
            }

            var beforeSubmit = null;
            if (includeContentWindow.beforeSubmit && typeof(includeContentWindow.beforeSubmit) == 'function') {
                beforeSubmit = includeContentWindow.beforeSubmit;
            }

            var carbonCopyUsers = "";
            var usersData = $("carbon_copy_employee_ds").data;
            for (var i = 0; i < usersData.length; i++) {
                if (i == 0) {
                    carbonCopyUsers = usersData[i].data.employee_code;
                } else {
                    carbonCopyUsers = carbonCopyUsers + "," + usersData[i].data.employee_code;
                }
            }

            var param = {
                assignee: p.targetUser || null,
                action: p.action,
                comment: comment,
                variables: variables,
                jumpTarget: p.jumpTarget || null,
                carbonCopyUsers: carbonCopyUsers,
                //processInstanceId: '${/parameter/@processInstanceId}',
            };

            if (beforeSubmit != null && (p.approveResult == 'APPROVED' || p.approveResult == 'SIGN' || p.approveResult == 'VOTED' || p.approveResult == 'REVIEW_APPROVED' || p.approveResult == 'SUSPEND')) {
                beforeSubmit(function () {
                    submit(p, param);
                });
                return;
            }
            submit(p, param);
        }
        function submit(p, param) {
            debugger
            Leaf.Masker.mask(getTaskWin().wrap,"正在操作...");
            var isAdmin = '${/parameter/@isAdmin}' ? "/admin" : "";
            jQuery.ajax({
                url: '${/request/@context_path}/wfl/runtime' + isAdmin + '/tasks/${/parameter/@taskId}',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(param),
                success: function (args) {
                    if (args.success === false) {
                        Leaf.Masker.unmask(getTaskWin().wrap);
                        Leaf.showInfoMessage("错误",JSON.stringify(args.error.message),null,200,200);
                    } else {
                        if (p.callback) {
                            p.callback(args);
                        } else {
                            Leaf.Masker.unmask(getTaskWin().wrap);
                            Leaf.showInfoMessage("提示","操作完成",function () {
                                getTaskWin().close();
                            },200,200);
                        }
                    }
                },
                error: function (args) {
                    Leaf.Masker.unmask(getTaskWin().wrap);
                    Leaf.showInfoMessage("错误",JSON.stringify(args),null,200,200);
                },
                headers: {
                    'X-CSRF-TOKEN': "${/session/@_csrf.token}",
                    'springflag': "Y"
                }
            })
        }
        function isContains(str) {
            var strView = ".view";
            var strHtml = ".html";
            return ((str.indexOf(strView) >= 0) || (str.indexOf(strHtml) >= 0));
        }
        function isEmptyObject(e) {
            var t;
            for (t in e)
                return !1;
            return !0
        }

        function onIncludeFrameLoad() {
            var ifm = document.getElementById("includeFrame");
            var subWeb = document.frames ? document.frames["includeFrame"].document : ifm.contentDocument;
            if (ifm != null && subWeb != null) {
                ifm.height = subWeb.body.scrollHeight + 30;
                // if(subWeb.body.scrollWidth > (document.body.clientWidth-100)){
                //     ifm.width = document.body.clientWidth-100;
                // }else{
                //     ifm.width = subWeb.body.scrollWidth
                // }
                if (parent.autoResizeIframe) {
                    parent.autoResizeIframe(_currentFunctionCode)
                }

            }
        }

        function risk_appoint_handler(lov) {
            //debugger;
            //lov.controller = '/fnd/employee/queryEmployeesForLov?unitName=风险管理部审查岗';
            /*lov.para = {
                unitName:'风险管理部审查岗'
            };*/

            var ds = $('risk_appoint_user_ds');
            ds.create();
            var record = ds.getCurrentRecord();
            var name = record.getMeta().getField('name');

             if('${/session/@unitId}' == 11){
                 name.setLovPara('unit_name', '风险管理部');
             }else if('${/session/@unitId}' == 16){
                 name.setLovPara('unit_name', '法务部');
             }

            //name.setLovPara('unit_name', '航空事业部');
            /*if('${/session/@unitId}' == 114){
                name.setLovPara('unit_name', '航空事业部');
            }else{
                name.setLovPara('unit_name', '风险管理部');
            }*/
            // name.setLovPara('unit_name', '风险管理部');
            // name.setLovPara('position_name', '风险管理部审查岗');
            //ds.setQueryParameter('unit_name','风险管理部审查岗');
        }

        function powerful_employee_handler(lov) {
            var ds = $('powerful_person_choose_ds');
            var record = ds.getCurrentRecord();
            var powerful_employee_n = record.getMeta().getField('powerful_employee_n');
            powerful_employee_n.setLovPara('position_name', '委员会主任委员');
            powerful_employee_n.setLovPara('unit_name', '');
        }
        function duration_employee_handler(lov) {
            var ds = $('duration_person_choose_ds');
            var record = ds.getCurrentRecord();
            var duration_employee_n = record.getMeta().getField('duration_employee_n');
            duration_employee_n.setLovPara('position_name', '分管副总裁');
            duration_employee_n.setLovPara('unit_name', '');
        }
        function duration_employee_handler_two(lov) {
            var ds = $('duration_person_choose_ds');
            var record = ds.getCurrentRecord();
            var duration_employee_two_n = record.getMeta().getField('duration_employee_two_n');
            duration_employee_two_n.setLovPara('position_name', '分管副总裁');
            duration_employee_two_n.setLovPara('unit_name', '');
        }
        function condition_employee_handler(lov) {
            var ds = $('condition_task_ds');
            var record = ds.getCurrentRecord();
            var powerful_employee_n = record.getMeta().getField('condition_employee_n');
            powerful_employee_n.setLovPara('position_name', '分管副总裁');
            powerful_employee_n.setLovPara('unit_name', '');
        }

        function condition_task_ds_update_event(ds, record, name, value, oldValue) {
            if(name == 'end_task_node_id'){
                if(value == '1'){
                    record.getField('condition_employee_n').setReadOnly(true);
                    record.getField('condition_employee').setReadOnly(true);
                    record.getField('condition_employee').setRequired(false);
                    record.getField('condition_employee_n').setRequired(false);
                }else{
                    record.getField('condition_employee_n').setReadOnly(false);
                    record.getField('condition_employee').setReadOnly(false);
                    record.getField('condition_employee').setRequired(true);
                    record.getField('condition_employee_n').setRequired(true);
                }
            }
        }
        function duration_task_ds_update_event(ds, record, name, value, oldValue) {

            if(name == 'duration_person'){
                if(value == 'PRESIDENT'||value == 'VICE_PRESIDENT'){
                    record.getField('duration_employee_n').setReadOnly(false);
                    record.getField('duration_employee').setReadOnly(false);
                    record.getField('duration_employee').setRequired(true);
                    record.getField('duration_employee_n').setRequired(true);

                    record.getField('duration_employee_two_n').setReadOnly(false);
                    record.getField('duration_employee_two').setReadOnly(false);
                    record.getField('duration_employee_two').setRequired(false);
                    record.getField('duration_employee_two_n').setRequired(false);
                }else{
                    record.getField('duration_employee_n').setReadOnly(true);
                    record.getField('duration_employee').setReadOnly(true);
                    record.getField('duration_employee').setRequired(false);
                    record.getField('duration_employee_n').setRequired(false);

                    record.getField('duration_employee_two_n').setReadOnly(true);
                    record.getField('duration_employee_two').setReadOnly(true);
                    record.getField('duration_employee_two').setRequired(false);
                    record.getField('duration_employee_two_n').setRequired(false);
                }
            }
        }

        /*function price_appoint_handler(lov) {
            /!*lov.para = {
                unitName:'营销管理部业务管理岗'
            };*!/

            var ds = $('price_appoint_user_ds');
            ds.create();
            var record = ds.getCurrentRecord();
            var name = record.getMeta().getField('name');
            name.setLovPara('unit_name', '营销管理部');
            name.setLovPara('position_name', '营销管理部业务管理岗');
        }*/

        //项目跳转全屏
        function parent_hls_project_detail(param,prj_ds_id){
            param['wflRuleControlFlag'] = 'Y';
            if(param['function_code'] == 'PRJ110F1'){
                //变更
                param['hidden_button_code'] = ['user_button2', 'user_button3','user_button6'];
                param['return_flag'] = 'N';
                param['wflRuleControlFlag'] = 'Y';
                hls_doc_get_layout_code(param, 'wfl_project_change_id', 'wfl_task_detail_query', param['function_code']);
            }else{
                hls_doc_get_layout_code(param, 'wfl_project_query_id', 'wfl_task_detail_query', param['function_code']);
            }

        }

        function approval_comments_ds_beforeload(){

        }

        //立项跳转全屏
        function parent_hls_chance_detail(param,prj_ds_id){
            hls_doc_get_layout_code(param, 'wfl_chance_detail_id', 'wfl_task_detail_query', 'PRJ001');
        }

        //立项客户超链接
        function parent_bp_chance_detail(param,prj_ds_id){
            param['wflRuleControlFlag'] = 'Y';
            hls_doc_get_layout_code(param, 'wfl_bp100_bp_master_modify_id', 'wfl_task_detail_query', 'BP100');
        }

        ]]></script>
        <a:dataSets>
            <!--审批常用语-->
            <a:dataSet id="general_approval_comments_ds" lookupCode="SYS_DEFAULT_WFL_COMMENT"/>
            <a:dataSet id="powerful_person_choose_syscode_ds" lookupCode="PRJ.MEETING_POWERFUL_CHOOSE"/>
            <a:dataSet id="duration_person_choose_syscode_ds" lookupCode="PRJ.DURATION_CHOOSE"/>
            <a:dataSet id="con_end_task_syscode_ds" lookupCode="CON.END_TASK_NAME"/>
            <a:dataSet id="pay_end_task_syscode_ds" lookupCode="CON.PAY_END_TASK_NAME"/>
            <a:dataSet id="condition_task_syscode_ds" lookupCode="CSH.PAY_CONDITION_NODE"/>
            <!--审批事项信息-->
            <a:dataSet id="current_task_detail_ds">
                <a:fields>
                    <a:field name="process_instance_name"/>
                    <a:field name="process_instance_id"/>
                    <a:field name="start_user_id"/>
                    <a:field name="start_user_name"/>
                    <a:field name="start_time"/>
                    <a:field name="priority"/>
                </a:fields>
            </a:dataSet>
            <!--审批历史-->
            <a:dataSet id="task_approve_history_ds">
                <a:fields>
                    <a:field name="end_time"/><!--审批时间-->
                    <a:field name="name"/><!--审批环节-->
                    <a:field name="assignee"/><!--审批人-->
                    <a:field name="action"/><!--审批动作-->
                    <a:field name="action_desc"/>
                    <a:field name="comment" readOnly="true"/><!--审批意见-->
                    <a:field name="start_time"/>
                    <a:field name="assignee_id"/>
                    <a:field name="execution_id"/>
                    <a:field name="process_definition_id"/>
                    <a:field name="start_time"/>
                    <a:field name="tenant_id"/>
                    <a:field name="variables"/>
                </a:fields>
            </a:dataSet>
            <!--审批意见-->
            <a:dataSet id="approval_comments_ds" autoCreate="true">
                <a:fields>
                    <a:field name="general_com"/>
                    <a:field name="general_com_cn" options="general_approval_comments_ds" displayField="code_value_name" valueField="code_value" returnField="general_com"/>
                    <a:field name="comment" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="beforeload" handler="approval_comments_ds_beforeload"/>
                </a:events>
            </a:dataSet>
            <!--抄送列表-->
            <a:dataSet id="carbon_copy_employee_ds" selectable="true" pageSize="5">
                <a:fields>
                   <!-- <a:field name="employee_code" autoComplete="true" lovGridHeight="300" lovHeight="450"
                                   lovLabelWidth="100" lovService="/fnd/employee/query~com.hand.hls.sys.dto.LovFndEmployee" lovWidth="600"
                                   title="员工选择" fetchRemote="false">
                        <a:mapping>
                            <a:map from="name" to="employee_name"/>
                            <a:map from="employee_code" to="employee_code"/>
                            <a:map from="employee_id" to="employee_id"/>
                        </a:mapping>
                    </a:field>-->
                    <a:field name="employee_name" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovLabelWidth="100" lovService="/fnd/employee/query~com.hand.hls.sys.dto.LovFndEmployee" lovWidth="600"
                             title="员工选择" fetchRemote="false">
                        <a:mapping>
                            <a:map from="name" to="employee_name"/>
                            <a:map from="employee_code" to="employee_code"/>
                            <a:map from="employee_id" to="employee_id"/>
                            <a:map from="unit_name" to="unit_name"/>
                        </a:mapping>
                    </a:field>

                </a:fields>
            </a:dataSet>
            <!--风险审查指派人--><!--positionName=风险管理部审查岗-->
            <a:dataSet id="risk_appoint_user_ds" pageSize="6">
                <a:fields>
                    <a:field name="allocation_id"/>
                    <a:field name="name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov" lovWidth="550"
                             title="项目审查人员" prompt="项目审查人员">
                        <a:mapping>
                            <a:map from="allocation_id" to="allocation_id"/>
                            <a:map from="name" to="name"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="company_short_name"/>
                    <a:field name="unit_name"/>
                    <a:field name="position_name"/>
                </a:fields>
            </a:dataSet>
            <!--上会流程选择有权人-->
            <a:dataSet id="powerful_person_choose_ds">
                <a:fields>
                    <a:field name="powerful_employee" defaultValue="481"/>
                    <a:field name="powerful_person_n"/>
                    <a:field name="powerful_person"/>
                    <a:field name="powerful_person_n" displayField="code_value_name"
                             options="powerful_person_choose_syscode_ds"
                             returnField="powerful_person" valueField="code_value"/>
                    <a:field name="powerful_employee_n" lovGridHeight="300" lovHeight="450" autoComplete="true" readOnly="false" defaultValue="吕松"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             lovWidth="500"
                             title="委员选择">
                        <a:mapping>
                            <a:map from="allocation_id" to="powerful_employee"/>
                            <a:map from="name" to="powerful_employee_n"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
<!--                <a:events>-->
<!--                    <a:event name="update" handler="onUpdate_powerful_employee_combobox"/>-->
<!--                </a:events>-->
            </a:dataSet>
            <!--存续期流程选择有权人-->
            <a:dataSet id="duration_person_choose_ds" autoCreate="true">
                <a:fields>
                    <a:field name="duration_employee"/>
                    <a:field name="duration_employee_two"/>
                    <a:field name="duration_person"/>
                    <a:field name="duration_person_n" displayField="code_value_name"
                             options="duration_person_choose_syscode_ds"
                             returnField="duration_person" valueField="code_value"/>
                    <a:field name="duration_employee_n" lovGridHeight="300" lovHeight="450" autoComplete="true" readOnly="true"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             lovWidth="500"
                             title="总裁选择">
                        <a:mapping>
                            <a:map from="allocation_id" to="duration_employee"/>
                            <a:map from="name" to="duration_employee_n"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="duration_employee_two_n" lovGridHeight="300" lovHeight="450" autoComplete="true" readOnly="true"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             lovWidth="500"
                             title="总裁选择">
                        <a:mapping>
                            <a:map from="allocation_id" to="duration_employee_two"/>
                            <a:map from="name" to="duration_employee_two_n"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="duration_task_ds_update_event"/>
                </a:events>
                <!--                <a:events>-->
                <!--                    <a:event name="update" handler="onUpdate_powerful_employee_combobox"/>-->
                <!--                </a:events>-->
            </a:dataSet>
<!--            合同制作选择结束节点-->
            <a:dataSet id="con_end_task_ds" autoCreate="true">
                <a:fields>
                    <a:field name="con_end_task_n"/>
                    <a:field name="con_end_task"/>
                    <a:field name="con_end_task_n" displayField="code_value_name" options="con_end_task_syscode_ds"
                             returnField="con_end_task" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="payment_end_task_ds">
                <a:fields>
                    <a:field name="con_end_task_n"/>
                    <a:field name="con_end_task"/>
                    <a:field name="con_end_task_n" displayField="code_value_name" options="pay_end_task_syscode_ds"
                             returnField="con_end_task" valueField="code_value"/>
                </a:fields>
            </a:dataSet>
<!--            付款前提条件-->
            <a:dataSet id="condition_task_ds">
                <a:fields>
                    <a:field name="end_task_node_id_n"/>
                    <a:field name="end_task_node_id"/>
                    <a:field name="condition_employee"/>
                    <a:field name="end_task_node_id_n" displayField="code_value_name" options="condition_task_syscode_ds"
                             returnField="end_task_node_id" valueField="code_value"/>
                    <a:field name="condition_employee_n" lovGridHeight="300" lovHeight="450" autoComplete="true" readOnly="false"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             lovWidth="500"
                             title="副总裁选择">
                        <a:mapping>
                            <a:map from="allocation_id" to="condition_employee"/>
                            <a:map from="name" to="condition_employee_n"/>
                            <a:map from="company_short_name" to="company_short_name"/>
                            <a:map from="unit_name" to="unit_name"/>
                            <a:map from="position_name" to="position_name"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="condition_task_ds_update_event"/>
                </a:events>
            </a:dataSet>
            <!--价格审查指派人--><!--positionName=营销管理部业务管理岗-->
           <!-- <a:dataSet id="price_appoint_user_ds" pageSize="6">
                <a:fields>
                    <a:field name="allocation_id"/>
                    <a:field name="name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/fnd/employee/queryEmployeesForLovForAppoint?~com.hand.hap.activiti.dto.AllocationEmployeeLov" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="商业伙伴">
                        <a:mapping>
