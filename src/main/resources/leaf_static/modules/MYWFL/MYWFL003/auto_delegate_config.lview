<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Marshal.Yuan
    $Date: 2018-10-25
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function wfl_auto_delegate_add_save() {
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            let record = $('wfl_auto_delegate_ds').getCurrentRecord();
            Leaf.request({
                url: '${/request/@context_path}/sys/preferences/autoDelegate/save',
                para: [record.data],
                success: function (data) {
                    $L.showInfoMessage("提示", "提交成功!",null);
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                }
            });
        }

        function wfl_auto_delegate_delete(){
            Leaf.Masker.mask(Ext.getBody(), '正在结束转交...');
            Leaf.request({
                url: '${/request/@context_path}/sys/preferences/autoDelegate/delete',
                success: function (data) {
                    $L.showInfoMessage("提示", "结束转交成功!",null);
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                }
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="wfl_auto_delegate_promot_ds" autoCreate="true">
                <a:fields>
                    <a:field name="deliver_start_time_promot" defaultValue="选择自动转交的开始日期，不设置则不会开启自动转交功能"/>
                    <a:field name="deliver_end_time_promot" defaultValue="选择自动转交截止日期，不设置表示从开始日期开始的所有任务都自动转交"/>
                    <a:field name="deliver_assign_promot" defaultValue="选择转交人，任务在指定时间范围内会自动转交给当前对象"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="wfl_auto_delegate_ds"
                       queryUrl="${/request/@context_path}/sys/preferences/autoDelegate/query"
                       submitUrl="${/request/@context_path}/sys/preferences/autoDelegate/save"
                       autoQuery="true">
                <a:fields>
                    <a:field name="autoDelegateName" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovLabelWidth="100" lovWidth="600"
                             lovService="/fnd/employee/queryEmployeesForLov~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             title="选择转交人">
                        <a:mapping>
                            <a:map from="name" to="autoDelegateName"/>
                            <a:map from="allocation_id" to="autoDelegate"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody style="margin:0 auto;">
            <a:screenTopToolbar>
                <a:gridButton click="wfl_auto_delegate_add_save" text="HAP.SAVE"/>
                <!--<a:gridButton click="wfl_auto_delegate_delete" text="结束转交"/>-->
            </a:screenTopToolbar>
            <a:form>
                <a:box column="1" labelWidth="160">
                    <a:dateTimePicker name="deliverStartDate" prompt="转交开始日期" bindTarget="wfl_auto_delegate_ds"
                                      width="265"/>
                    <a:label name="deliver_start_time_promot" bindTarget="wfl_auto_delegate_promot_ds" width="400"/>
                </a:box>
                <a:box column="1" labelWidth="160">
                    <a:dateTimePicker name="deliverEndDate" prompt="转交截止日期" bindTarget="wfl_auto_delegate_ds"
                                      width="265"/>
                    <a:label name="deliver_end_time_promot" bindTarget="wfl_auto_delegate_promot_ds" width="400"/>
                </a:box>
                <a:box column="1" labelWidth="160">
                    <a:lov name="autoDelegateName" prompt="选择转交人" bindTarget="wfl_auto_delegate_ds" width="265"/>
                    <a:label name="deliver_assign_promot" bindTarget="wfl_auto_delegate_promot_ds" width="400"/>
                </a:box>

            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
