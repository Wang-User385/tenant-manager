<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function assign_delegate_user_query() {
            $('assign_delegate_user_ds').query();
        }

        function assign_delegate_user_reset() {
            $('assign_delegate_user_query_ds').reset();
            $('assign_delegate_user_ds').query();
        }

        function assign_delegate_user_confirm() {
            debugger;

            $L.Masker.mask(Ext.getBody(),"指派中，请稍等...");

            var pid = '${/parameter/@id}';
            var taskId = '${/parameter/@taskId}';
            var action = '${/parameter/@action}';
            var comment = '${/parameter/@comment}';
            var allocationId = $('assign_delegate_user_ds').getSelected()[0].get('allocation_id');
            $('assign_delegate_user_info_ds').create({"assign": allocationId, "action": action, taskId: taskId, comment: comment});
            $('assign_delegate_user_info_ds').setSubmitUrl('${/request/@context_path}/wfl/leaf/runtime/execute/' + pid + '?assign=' + allocationId);
            $('assign_delegate_user_info_ds').submit();
        }

        <!--events-->
        function refresh_parent_page(ds) {
            $L.Masker.unmask(Ext.getBody());
            Leaf.SideBar.show({
                msg: '${l:HLS.SUBMIT_SUCCESS}',
                duration: 2000
            });
            // Leaf.showMessage("提示", "操作成功!",function () {
                //转交成功关闭待办页面
                $('${/parameter/@winId}').close();
                $("${/parameter/@pWinId}").close();
            // });
            // if ($('wfl_process_monitor_ds')) {
            //     $('wfl_process_monitor_ds').query();
            // }

        }

        function onQuery_assign_delegate_user_ds(){
            debugger;
            if('${/session/@unitId}' == 114){
                $('assign_delegate_user_ds').queryurl = $('assign_delegate_user_ds').queryurl + '&unit_name=航空事业部';
            }else{
                if($('assign_delegate_user_query_ds').getCurrentRecord().get('unit_name')){
                    $('assign_delegate_user_ds').queryurl = $('assign_delegate_user_ds').queryurl + '&unit_name=' + $('assign_delegate_user_query_ds').getCurrentRecord().get('unit_name');
                }else{
                    $('assign_delegate_user_ds').queryurl = $('assign_delegate_user_ds').queryurl + '&unit_name=风险管理部';
                }

            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="assign_delegate_user_info_ds">
                <a:events>
                    <a:event name="submitSuccess" handler="refresh_parent_page"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="assign_delegate_user_query_ds">
            </a:dataSet>
            <a:dataSet id="assign_delegate_user_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/employee/queryEmployeesForLovForAppoint?position_name=风险管理部审查岗"
                       queryDataSet="assign_delegate_user_query_ds" selectable="true" selectionModel="single"
                       pageSize="6">
                <a:events>
                    <a:event name="query" handler="onQuery_assign_delegate_user_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="assign_delegate_user_query" text="HAP.QUERY"/>
                <a:gridButton click="assign_delegate_user_confirm" text="确定"/>
            </a:screenTopToolbar>
            <a:form column="2" labelwidth="100" title="查询条件">
                <a:textField name="position_name" bindTarget="assign_delegate_user_query_ds" prompt="岗位" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="assign_delegate_user_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="name" bindTarget="assign_delegate_user_query_ds" prompt="员工姓名" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="assign_delegate_user_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="assign_delegate_user_ds_grid" bindTarget="assign_delegate_user_ds"
                    width="760" height="350"
                    navBar="true">
                <a:columns>
<!--                    <a:column name="company_short_name" width="200" prompt="公司"-->
<!--                              align="center"/>-->
<!--                    <a:column name="unit_name" width="130" prompt="部门"
                              align="center"/>-->
                    <a:column name="position_name" width="170" prompt="岗位"
                              align="center"/>
                    <a:column name="name" width="170" prompt="员工姓名"
                              align="center"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
