<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="SW001_PLEDGE_LEASE"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>

        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            qpara['created_by'] = '${/session/@user_id}';
        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');

            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';

            param['winid'] = 'sw001f1_create_winid';
           // hls_doc_get_layout_code(param, 'SW001_PLEDGE_LEASE', ds_id, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
            hls_doc_get_layout_code(param, 'SW001_PLEDGE_LEASE', null, 'SW001');
        };
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var records = $(ds_id).getSelected();
            if(records.length == 0){
                Leaf.showMessage('提示','请选择一条记录！');
                return;
            }
            var param = [];
            for (var i = 0; i < records.length; i++) {
                param.push(records[i].data);
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            Leaf.request({
                url: '${/request/@context_path}/hls/pam/lease/invalid',
                para:  param,
                success: function (datas) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '操作成功',
                        duration: 2000
                    });
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
                    $(ds_id).query();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            });
        };
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var records = $(ds_id).getSelected();
            if(records.length != 1){
                Leaf.showMessage('提示','请选择一条记录！');
                return;
            }
            var lease_item_id = records[0].get('lease_item_id');
            var param = {};
            var type = 'MODIFY';
            param['url_title'] = '抵质押物登记';
            param['function_code'] = 'SW001F2';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['lease_item_id'] = lease_item_id;
            param['ds_id'] = ds_id;
            var link_id = 'SW001_PLEDGE_LEASE';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        };
        function sw001_detail_open(record_id, ds_id , contract_status) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.lease_item_id;
            var type = 'QUERY';
            if(contract_status == 'APPROVING' || contract_status == 'APPROVED'){
                type = 'QUERY';
                param['maintain_type'] = 'READONLY';
            }
debugger;
            if(param.document_created_by== '${/session/@user_id}' || '${/session/@user_id}' == 10001){
                type = 'MODIFY';
                param['maintain_type'] = 'READONLY';
            }
            param['url_title'] = '抵质押物详细';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['ds_id'] = ds_id;
            var link_id = 'SW001_PLEDGE_LEASE';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        }

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'sw001_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'lease_item_code') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + record.get('contract_status') + '\');">' + value + '</a>';
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>