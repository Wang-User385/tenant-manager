        <script><![CDATA[
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq){

        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {

            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            countTotal(pledge_ds_id,ds)

        };


        //
        //动产抵押导入
        window['${/parameter/@layout_code}_G_MOVABLES_LEASE_LIST_USER_BUTTON1_layout_dynamic_tab_click'] = function (){



            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            if(pledge_ds_id==''){
                return;
            }
            var  hlsLease_records = $(pledge_ds_id).getAll();
            var leaseItemId = hlsLease_records[0].data.lease_item_id;
            var patternDet = "MOVABLE_PROPERTY_PLEDGE";
            if (typeof (leaseItemId) === 'undefined' || 'undefined' === leaseItemId) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var win = new Leaf.Window({
                id: 'item_receipt_import_win_id',
                params: {
                    winid: 'item_receipt_import_win_id',
                    lease_item_id :leaseItemId,
                    patternDet:patternDet
                },
                url: '${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_list_import.lview',
                title: '新增导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(pledge_ds_id).query();
            });
        };


        //不动产抵押导入
        window['${/parameter/@layout_code}_G_NO_MOVABLES_LEASE_LIST_USER_BUTTON1_layout_dynamic_tab_click'] = function (){

            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            if(pledge_ds_id==''){
                return;
            }
            var  hlsLease_records = $(pledge_ds_id).getAll();
            var leaseItemId = hlsLease_records[0].data.lease_item_id;
            var patternDet = "NO_MOVABLE_PROPERTY_PLEDGE";
            if (typeof (leaseItemId) === 'undefined' || 'undefined' === leaseItemId) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var win = new Leaf.Window({
                id: 'item_receipt_import_win_id',
                params: {
                    winid: 'item_receipt_import_win_id',
                    lease_item_id :leaseItemId,
                    patternDet:patternDet
                },
                url: '${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_no_import.lview',
                title: '新增导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(pledge_ds_id).query();
            });
        };
        //
        window['${/parameter/@layout_code}_G_PLEDGE_LIST_USER_BUTTON1_layout_dynamic_tab_click'] = function (){

            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            if(pledge_ds_id==''){
                return;
            }
            var  hlsLease_records = $(pledge_ds_id).getAll();
            var leaseItemId = hlsLease_records[0].data.lease_item_id;
            var patternDet = "DZ_PROPERTY_PLEDGE";
            if (typeof (leaseItemId) === 'undefined' || 'undefined' === leaseItemId) {
                Leaf.showMessage('提示', '请先保存!', null);
