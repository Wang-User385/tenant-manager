<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_lease_item');
            $(ds_id).getCurrentRecord().set('full_name','${/parameter/@full_name}');
            $(ds_id).getCurrentRecord().set('lease_item_type_n','${/parameter/@lease_item_type_n}');
            $(ds_id).getCurrentRecord().set('lease_item_id','${/parameter/@lease_item_id}');
        };


        // 导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_lease_item');
            if($(ds_id).validate()) {

                var lease_item_id = '${/parameter/@lease_item_id}';
                var result_id = '${/parameter/@result_id}';
                var excel_id = '${/parameter/@excel_id}';

                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
                var dsRecord = $(ds_id).getCurrentRecord();
                var fin_statement_templet_hd_id = dsRecord.data.fin_statement_templet_hd_id;

                if(result_id&&excel_id){
                    new Leaf.Window({
                        id: 'bp100_excel_detail_win_id',
                        params: {
                            result_id:result_id,
                            excel_id:excel_id,
                            source_document_category: 'MORTGAGE_PLEDGE_REPORT',
                            winid: 'bp100_excel_detail_win_id'
                        },
                        url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                        title: '抵质押物报表明细',
                        fullScreen: true
                    });
                }else{
                    new Leaf.Window({
                        id: 'sw001_excel_import_win_id',
                        params: {
                            source_document_id: lease_item_id,
                            source_document_category: 'MORTGAGE_PLEDGE_REPORT',
                            excel_id: fin_statement_templet_hd_id,
                            winid: 'sw001_excel_import_win_id'
                        },
                        url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                        title: '抵质押物明细导入',
                        fullScreen: true
                    });
                }
            }

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
