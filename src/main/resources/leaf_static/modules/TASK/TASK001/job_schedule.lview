<?xml version="1.0" encoding="UTF-8"?>
<!--

    $Date: 2018-10-15
    $Revision: 1.0
    $Purpose: 任务周期定义job_schedule
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function job_schedule_screen_query() {
            $('job_schedule_ds').query();
        }

        function job_schedule_screen_reset() {
            $('job_schedule_query_ds').reset();
            $('job_schedule_ds').query();
        }


        function job_schedule_screen_add() {
            $('job_schedule_ds_grid').showEditorByRecord($('job_schedule_ds').create());
        }


        function job_schedule_screen_save() {
            var ds = $('job_schedule_ds');
            if (ds.validate()) {
                ds.setSubmitUrl("${/request/@context_path}/leaf/job/schedule/submit");
                ds.submit();
            }
        }

        <!--提交成功-->
        function onSubmitSuccess_job_schedule_ds(ds,res){
            $('job_schedule_ds').query();
        }

        <!--grid renderer-->
        function job_schedule_ds_renderer(value, record, name){
            if (name === 'operate' && !!record.get('schedule_name') && !record.isNew) {
                return '<a href="javascript:open_win_sch_edit(\'' + record.get('schedule_name') + '\');">修改</a>';
            }
            return '';
        }

        <!--打开窗口：编辑计划任务-->
        function open_win_sch_edit(schedule_name){
            new Leaf.Window({
                id : "job_schedule_detail",
                url : "${/request/@context_path}/modules/TASK/TASK001/job_schedule_edit.lview",
                title : '计划任务周期修改',
                params:{
                    schedule_name : schedule_name
                },
                fullScreen : false,
                draggable : true,
                closeable : true,
                side:'right',
                width : 850,
                height : 450
            });
        }

        //grid editFunction
        function job_schedule_ds_grid_ef(record, name){
            if (record.isNew) {
                return 'job_schedule_ds_grid_tf';
            }
            return '';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="job_schedule_query_ds">
                <a:fields>
                    <a:field name="short_desc"/>
                    <a:field name="schedule_name"/>
                    <a:field name="full_desc"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="job_schedule_ds" autoQuery="true" autoPageSize="true"
                       queryUrl ="${/request/@context_path}/leaf/job/schedule/query"
                       deleteUrl="${/request/@context_path}/leaf/job/schedule/remove"
                       queryDataSet="job_schedule_query_ds" selectable="true">
                <a:fields>
                    <a:field name="short_desc" required="true"/>
                    <a:field name="schedule_name" required="true"/>
                    <a:field name="full_desc" />
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_job_schedule_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="job_schedule_screen_add" text="HAP.NEW"/>
                <a:gridButton bind="job_schedule_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="job_schedule_screen_save" text="HAP.SAVE"/>
                <a:gridButton click="job_schedule_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="job_schedule_screen_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="3" title="查询条件" labelwidth="100">
                <a:textField name="short_desc" bindTarget="job_schedule_query_ds" prompt="计划代码" emptyText="计划代码" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="job_schedule_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="schedule_name" bindTarget="job_schedule_query_ds" prompt="计划名称" emptyText="计划名称" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="job_schedule_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="full_desc" bindTarget="job_schedule_query_ds" prompt="详细说明" emptyText="详细说明" width="140">
                    <a:events>
                        <a:event name="enterdown" handler="job_schedule_screen_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="job_schedule_ds_grid"  bindTarget="job_schedule_ds" marginHeight="105" marginWidth="66" navBar="true">
                <a:columns>
                    <a:column width="310" name="short_desc" editorFunction="job_schedule_ds_grid_ef" prompt="计划代码"/>
                    <a:column width="310" name="schedule_name" editorFunction="job_schedule_ds_grid_ef" prompt="计划名称"/>
                    <a:column width="310" name="full_desc" editorFunction="job_schedule_ds_grid_ef" prompt="详细说明"/>
                    <a:column width="310" name="operate" renderer="job_schedule_ds_renderer" prompt="操作" align="center"/>
                </a:columns>
                <a:editors>
                    <a:textField id="job_schedule_ds_grid_tf"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
