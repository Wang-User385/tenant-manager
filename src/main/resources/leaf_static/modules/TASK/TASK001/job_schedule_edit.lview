<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2018-10-16
    $Revision: 1.0
    $Purpose: 任务周期修改
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/common/code?schFreqData=JOB.SCHEDULE_FREQUENCY" type="text/javascript"/>
        <script><![CDATA[
        <!--中英文映射JSON存入Map-->
        var schFreqECMap = {};
        var schFreqCEMap = {};
        var schFreqJson;
        if(!!schFreqData){
            schFreqJson = schFreqData;
            schFreqJson.forEach(function(i){
                schFreqECMap[i.value] = i.meaning;
                schFreqCEMap[i.meaning] = i.value;
            });
        }else{
            $L.showErrorMessage("错误","/common/code?schFreqJson=JOB.SCHEDULE_FREQUENCY加载失败",null,200,100);
            schFreqJson = [{
                "meaning": "月",
                "value": "MONTH"
            }, {
                "meaning": "周",
                "value": "WEEK"
            }, {
                "meaning": "日",
                "value": "DAY"
            }, {
                "meaning": "时",
                "value": "HOUR"
            }, {
                "meaning": "分",
                "value": "MINUTE"
            }];
        }

        $L.onReady(function(){
            //将中英文存入对应的ds
            schFreqJson.forEach(function(i){
                $("job_schedule_frequency_ds").create({"para_freq":i.value,"para_freq_cn":i.meaning});
            });

            //设置ds请求路径
            var ds = $("job_schedule_edit_ds");
            ds.setQueryUrl("${/request/@context_path}/leaf/job/schedule/query?schedule_name=" + "${/parameter/@schedule_name}");
            ds.query();

            $("form_para_freq_combo").addListener("change",onChange_para_freq_cn);
        });

        <!-- ds load事件函数-->
        function onLoad_job_schedule_edit_ds(ds){
            var records = ds.data;
            records.forEach(function(record){
                record.set("para_freq_cn",schFreqECMap[record.get("para_freq")]);
                record.set("start_date",new Date(record.get("start_date")));
                record.set("end_date",new Date(record.get("end_date")));
            });
            setInputStateByFreq(records[0].get("para_freq"));
        }

        // para_freq值change事件函数
        function onChange_para_freq_cn(combo,value,old_value){
            setInputStateByFreq(schFreqCEMap[value]);
        }

        // 根据para_freq值更改输入框状态，使能验证函数
        function setInputStateByFreq(freq){
            // 输入框id数组
            var inputIdArr = [
                "form_para_bymonthday_input",
                "form_para_byday_input",
                "form_para_byhour_input",
                "form_para_byminute_input"
            ];

            // 输入框启用flag数组
            var inputStateArr = [0,0,0,0];

            switch (freq) {
                case 'MONTH':
                    inputStateArr = [1,0,1,1];
                    break;
                case 'WEEK':
                    inputStateArr = [0,1,1,1];
                    break;
                case 'DAY':
                    inputStateArr = [0,0,1,1];
                    break;
                case 'HOUR':
                    inputStateArr = [0,0,0,1];
                    break;
            }
            setInputState(inputIdArr,inputStateArr);
        }

        // 根据输入框id数组和flag数组设置输入框状态
        function setInputState(inputIdArr,inputStateArr){
            inputIdArr.forEach(function(id,i){
                var input = $(id);
                if(inputStateArr[i]){
                    input.initReadOnly(false);
                    input.readOnly = false;
                    input.readonly = false;
                    input.initConfig.readonly = false;
                    input.initEditable(true);
                    input.editable = true;
                    input.initConfig.editable = true;
                    input.binder.ds.fields[input.binder.name].pro.validator="form_para_input_valid";
                }else{
                    input.initReadOnly(true);
                    input.readOnly = true;
                    input.readonly = true;
                    input.initConfig.readonly = true;
                    input.initEditable(false);
                    input.editable = false;
                    input.initConfig.editable = false;
                    input.setValue("");
                }
            });
        }

        <!--提交成功-->
        function onSubmitSuccess_job_schedule_edit_ds(){
            $('job_schedule_edit_ds').query();
        }


        function job_schedule_edit_screen_save() {
            var ds = $('job_schedule_edit_ds');
            var records = ds.data;
            for(var i=0;i<records.length;i++){
                if(records[i].get("start_date")>=records[i].get("end_date")){
                    $L.showErrorMessage("错误","开始时间要早于结束时间",null,200,100);
                    return
                }
            }
            if (ds.validate()) {
                ds.setSubmitUrl("${/request/@context_path}/leaf/job/schedule/submit");
                ds.submit();
            }
        }

        //输入验证函数
        function form_para_input_valid(record,name,value){
            var re,info;
            //为空设置默认值
            if(!value || value.replace(/^\s+$/g,"").length === 0){
                record.set(name,record.fields[name].snap.defaultvalue)
            }
            switch (name) {
                case "para_bymonthday":
                    re = new RegExp(/^([1-9]|[12]\d|3[01])(,([1-9]|[12]\d|3[01])){0,30}$/);
                    info = "月日期字段请输入1-31之间数字，多个值以逗号隔开";
                    break;
                case "para_byday":
                    re = new RegExp(/^([1-7])(,[1-7]){0,6}$/);
                    info = "周日期字段请输入1-7之间数字，多个值以逗号隔开";
                    break;
                case "para_byhour":
                    re = new RegExp(/^(\d|1\d|2[0-3])$/);
                    info = "小时字段只能输入0-23之间的整数";
                    break;
                case "para_byminute":
                    re = new RegExp(/^(\d|[1-5]\d)$/);
                    info = "分钟字段只能输入0-59之间的整数";
                    break;
            }
            return value ? (re.test(value) ? true : info) : true
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="job_schedule_frequency_ds">
                <a:fields>
                    <a:field name="para_freq"/>
                    <a:field name="para_freq_cn"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="job_schedule_edit_ds" pageSize="10" selectable="true">
                <a:fields>
                    <a:field name="short_desc" required="true"/>
                    <a:field name="schedule_name" required="true"/>
                    <a:field name="start_date" />
                    <a:field name="end_date" />
                    <a:field name="para_interval" required="true"/>
                    <a:field name="para_freq"/>
                    <a:field name="para_freq_cn" required="true"
                             options="job_schedule_frequency_ds" displayField="para_freq_cn" valueField="para_freq" returnField="para_freq"/>
                    <a:field name="para_bymonthday" defaultValue="1"/>
                    <a:field name="para_byday" defaultValue="1"/>
                    <a:field name="para_byhour" defaultValue="0"/>
                    <a:field name="para_byminute" defaultValue="0"/>
                    <a:field name="full_desc" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_job_schedule_edit_ds"/>
                    <a:event name="load" handler="onLoad_job_schedule_edit_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form column="2" labelwidth="100" id="job_schedule_edit_form">
                <a:textField name="short_desc" bindTarget="job_schedule_edit_ds" prompt="计划代码" width="250"/>

                <a:textField name="schedule_name" bindTarget="job_schedule_edit_ds" prompt="计划名称"
                             width="250" readOnly="true" editable="false"/>

                <a:dateTimePicker name="start_date" bindTarget="job_schedule_edit_ds"
                                  renderer="job_schedule_edit_form_renderer" prompt="起始日期" width="250"/>

                <a:dateTimePicker name="end_date" bindTarget="job_schedule_edit_ds"
                              renderer="job_schedule_edit_form_renderer" prompt="结束日期" width="250"/>

                <a:numberField name="para_interval" bindTarget="job_schedule_edit_ds" prompt="每" width="250"
                               allowDecimals="false" allowNegative="false" allowFormat="false"/>

                <a:comboBox id="form_para_freq_combo" name="para_freq_cn" bindTarget="job_schedule_edit_ds" prompt="频率" width="250"/>

                <a:textField id="form_para_bymonthday_input" name="para_bymonthday" bindTarget="job_schedule_edit_ds" prompt="该月第几天"
                             width="250" emptyText="请使用逗号隔开多个值" transformCharacter="true"/>

                <a:textField id="form_para_byday_input" name="para_byday" bindTarget="job_schedule_edit_ds"
                             prompt="周几" width="250" emptyText="请输入1-7之间数字，多个值以逗号隔开" transformCharacter="true"/>

                <a:textField id="form_para_byhour_input" name="para_byhour" bindTarget="job_schedule_edit_ds"
                             prompt="起始小时" width="250"/>

                <a:textField id="form_para_byminute_input" name="para_byminute" bindTarget="job_schedule_edit_ds"
                             prompt="起始分钟" width="250"/>

                <a:textField name="full_desc" bindTarget="job_schedule_edit_ds" prompt="详细说明" width="250"/>

            </a:form>
            <a:button click="job_schedule_edit_screen_save" text="HAP.SAVE" />
        </a:screenBody>
    </a:view>
</a:screen>
