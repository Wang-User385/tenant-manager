                    record.getField('listed_subject').setReadOnly(false);
                    record.getField('listed_subject').setRequired(true);
                    record.getField('listed_subject_org_code').setReadOnly(false);
                    record.getField('listed_subject_org_code').setRequired(true);
                } else if(record.get('listed_company_flag')=='N'){
                    record.set('listed_subject', null);
                    record.set('listed_subject_org_code', null);
                    record.getField('listed_subject').setReadOnly(true);
                    record.getField('listed_subject').setRequired(false);
                    record.getField('listed_subject_org_code').setReadOnly(true);
                    record.getField('listed_subject_org_code').setRequired(false);
                    record.getField('market_location').setReadOnly(true);
                    record.getField('market_location').setRequired(false);
                    record.getField('market_location_n').setReadOnly(true);
                    record.getField('market_location_n').setRequired(false);

                    record.getField('listed_subject').setReadOnly(true);
                    record.getField('listed_subject').setRequired(false);
                    record.getField('listed_subject_org_code').setReadOnly(true);
                    record.getField('listed_subject_org_code').setRequired(false);

                    record.set('market_location', null);
                    record.set('market_location_n', null);
                    record.set('listed_subject', null);
                    record.set('listed_subject_org_code', null);
                }*/
                //如果实际控制人类型为自然人NP则实际控制人证件类型和证件号码必填，如果为组织机构ORG则实际控制人组织机构代码必填， hongqun.dai 20181017
                /*var bp_name_sp_class = record.get('bp_name_sp_class');
                if (bp_name_sp_class == 'NP') {
                    record.getField('actual_controller_id').setReadOnly(false);
                    record.getField('actual_controller_id').setRequired(true);
                    record.getField('actual_controller_id_type').setReadOnly(false);
                    record.getField('actual_controller_id_type').setRequired(true);
                    record.getField('actual_controller_id_type_n').setReadOnly(false);
                    record.getField('actual_controller_id_type_n').setRequired(true);
                    record.getField('actual_controller_org_code').setReadOnly(true);
                    record.getField('actual_controller_org_code').setRequired(false);
                } else if (bp_name_sp_class == 'ORG') {
                    record.getField('actual_controller_id').setReadOnly(true);
                    record.getField('actual_controller_id').setRequired(false);
                    record.getField('actual_controller_id_type').setReadOnly(true);
                    record.getField('actual_controller_id_type').setRequired(false);
                    record.getField('actual_controller_id_type_n').setReadOnly(true);
                    record.getField('actual_controller_id_type_n').setRequired(false);
                    record.getField('actual_controller_org_code').setReadOnly(false);
                    record.getField('actual_controller_org_code').setRequired(true);
                } else if (bp_name_sp_class == 'PI') {
                    record.getField('actual_controller_id').setReadOnly(true);
                    record.getField('actual_controller_id').setRequired(false);
                    record.getField('actual_controller_id_type').setReadOnly(true);
                    record.getField('actual_controller_id_type').setRequired(false);
                    record.getField('actual_controller_id_type_n').setReadOnly(true);
                    record.getField('actual_controller_id_type_n').setRequired(false);
                    record.getField('actual_controller_org_code').setReadOnly(true);
                    record.getField('actual_controller_org_code').setRequired(false);
                }*/
            };

            /*if ($('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_LICENSE_TERMS_IF_LONG')) {
                $('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_LICENSE_TERMS_IF_LONG').addListener("change", onchange_license_terms);
            }*/
            /* if ($('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_LISTED_COMPANY_FLAG')) {
                 $('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_LISTED_COMPANY_FLAG').addListener("change", onchange_listed_company_flag);
             }*/

            $("${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds")

            var interestCalcMonthDs = $('${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds');
            interestCalcMonthDs.setQueryParameter('column_name', 'certtype');
            interestCalcMonthDs.setQueryParameter('tab_code', 'G_SHAREHOLDER');
            interestCalcMonthDs.setQueryParameter('layout_code', 'PRJ306F1');
            interestCalcMonthDs.query();

        });

        // 营业执照是否为长期change事件
        // 是--营业执照到期日readOnly true
        // 否--营业执照到期日readOnly false
        /*function onchange_license_terms(cb, value, oldValue) {
            if (value === '是') {
                readonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'license_terms', 'F_BASIC');
                unrequire_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'license_terms');
            } else if (value === '否') {
                unreadonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'license_terms', 'F_BASIC');
                require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'license_terms');
            }
        }*/

        // 是否上市公司
        // 是--上市主体 上市主体组织机构代码 上市地点可编辑
        // 否--上市主体 上市主体组织机构代码 上市地点不可编辑
        function onchange_listed_company_flag(cb, value, oldValue) {
            if ('Y' == value) {
                unreadonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'listed_subject', 'F_BASIC');
                unreadonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'listed_subject_org_code', 'F_BASIC');
                unreadonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'market_location', 'F_BASIC');
                require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'listed_subject');
                require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'listed_subject_org_code');
                require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'market_location');
            } else if ('N' == value) {
                readonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'listed_subject', 'F_BASIC');
                readonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'listed_subject_org_code', 'F_BASIC');
                readonly_dataset_field('${/parameter/@layout_code}', 'hls_bp_master', 'market_location', 'F_BASIC');
                unrequire_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'listed_subject');
                unrequire_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'listed_subject_org_code');
                unrequire_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'market_location');
            }
        }

        function prj_check_bp_id(record) {
            var bp_id;
            if (record) {
                bp_id = record.get('bp_id');
            }
            if (!bp_id) {
                Leaf.showMessage('${l:PROMPT}', '${l:界面存在数据更新,请先保存!}');
                bp_id = '';
            }
            return bp_id;
        }


        var is_regno_valid = true;
        var bp_name_valid = true;
        var zipcode_flag = true;
        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //登记注册号码校验
            var orgbase_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgbase');
            var hbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');

            /*if(orgbase_ds!=null && orgbase_ds!="") {
                var regno = $(orgbase_ds).getCurrentRecord().get('regno');
                var regnotype  = $(orgbase_ds).getCurrentRecord().get('regnotype');
                if (regno.length != 15 && regno.length != 18) {
                    if((regnotype == '01' || regnotype == '07') && '${/parameter/@bp_class}' == 'ORG'){
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码为15位或18位！");
                        return false;
                    }
                }
            }*/

            var hbm_record = $(hbm_ds_id).getCurrentRecord();
            var regno = hbm_record.get('regno');
            if (hbm_ds_id == ds.id && regno && regno != '') {
                var regnotype = hbm_record.get('regnotype');
                if (regno.length != 15 && regno.length != 18) {
                    if ((regnotype == '01' || regnotype == '07') && '${/parameter/@bp_class}' == 'ORG') {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码为15位或18位！");
                        return false;
                    }
                }
            }

            if (!is_regno_valid) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码重复！");
                return false;
            }

            if (!bp_name_valid) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "商业伙伴名称重复！");
                return false;
            }

            if (!zipcode_flag) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "地址信息邮编应为6位！");
                return false;
            }

            var check_flag = true;
            //身份证校验
            if (record.get('bp_class') == 'NP' && record.get('id_type') == 'ID_CARD') {
                var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                if (reg.test(record.get('id_card_no')) === false) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "证件号码格式错误!", null);
                    return false;
                }
            }

            if (hbm_record.get('bp_type') === 'VENDER') {
                var relation_records = $(relation_ds_id).getAll();
                var relation_validate = 0;
                var relation_manufaction_id = null;
                for (var i = 0; i < relation_records.length; i++) {
                    if (relation_records[i].get('relation_type') === 'MANUFACTURER') {
                        if (relation_manufaction_id == null) {
                            relation_manufaction_id = relation_records[i].get('related_bp_id');
                            relation_validate++;
                        } else {
                            if (relation_manufaction_id != relation_records[i].get('related_bp_id')) {
                                relation_validate++;
                            }
                        }
                    }
                }

                if (relation_validate > 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "一个主机厂仅能维护一个归属厂商信息!", null);
                    return false;
                }
            }

            var bank_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            var bank_records = $(bank_ds).getAll();
            if (bank_records.length > 0) {
                var primary_bank_num = 0;
                for (var i = 0; i < bank_records.length; i++) {
                    if (bank_records[i].get('primary_flag') == 'Y') {
                        primary_bank_num++;
                    }
                }

                if (primary_bank_num != 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "必须且只能存在一条主银行账户!", null);
                    return false;
                }
            }


            return check_flag;
        };

        //财务报表模板导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var record = $(ds_id).getCurrentRecord();
            var bp_id = prj_check_bp_id(record);
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code'];
            bp_id = prj_check_bp_id(record);
            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_import_winid',
                url: '${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_financial_import.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    winid: 'hls_bp_master_financial_import_winid'
                },
                title: '财务报表导入',
                fullScreen: false,
                width: 500,
                height: 480,
                draggable: true
            });
        };

        //财务报表模板查看
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var record = $(ds_id).getCurrentRecord();
            var bp_id = prj_check_bp_id(record);
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code']
            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 830,
                height: 535,
                side: "right",
                draggable: true
            });
        };


        //设置权限字符串
        function set_authority_rule_string() {
            Leaf.request({
                url: "${/request/@context_path}/hls/bp/master/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        }

        // 更新事件
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var ds_bp_account = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            var ds_bp_address = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var ds_bp = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            if (ds_bp_account == ds.id && value) {
                if (name == 'city_id') {
                    record.set('district_id', '');
                    record.set('district_id_n', '');
                }
            } else if (ds_bp_address == ds.id && value) {
                if (name == 'country_id' && value != '46') {
                    record.getField('province_id').setReadOnly(true);
                    record.getField('province_id').setRequired(false);
                    record.getField('city_id').setReadOnly(true);
                    record.getField('city_id').setRequired(false);
                    record.getField('district_id').setReadOnly(true);
                    record.getField('district_id').setRequired(false);
                    record.getField('province_id_n').setReadOnly(true);
                    record.getField('province_id_n').setRequired(false);
                    record.getField('city_id_n').setReadOnly(true);
                    record.getField('city_id_n').setRequired(false);
                    record.getField('district_id_n').setReadOnly(true);
                    record.getField('district_id_n').setRequired(false);
                } else if (name == 'country_id' && value == '46') {
                    record.getField('province_id').setReadOnly(false);
                    record.getField('province_id').setRequired(true);
                    record.getField('city_id').setReadOnly(false);
                    record.getField('city_id').setRequired(true);
                    record.getField('district_id').setReadOnly(false);
                    /*record.getField('district_id').setRequired(true);*/
                    record.getField('province_id_n').setReadOnly(false);
                    record.getField('province_id_n').setRequired(true);
