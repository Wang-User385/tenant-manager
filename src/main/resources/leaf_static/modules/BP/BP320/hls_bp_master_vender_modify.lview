            if ($("${/parameter/@layout_code}_G_ADD_hls_bp_master_address_layout_grid_id")) {
                $("${/parameter/@layout_code}_G_ADD_hls_bp_master_address_layout_grid_id").on("cellclick", function (grid, row, name, record) {
                    if ('${/parameter/@function_usage}' != 'QUERY') {
                        if (name = 'country_id_n') {
                            if (record.get('country_id') != '46') {
                                record.getField("province_id_n").setReadOnly(true);
                                record.getField("city_id_n").setReadOnly(true);
                                record.getField("district_id_n").setReadOnly(true);
                            } else if (record.get('country_id') == '46') {
                                record.getField("province_id_n").setReadOnly(false);
                                record.getField("city_id_n").setReadOnly(false);
                                record.getField("district_id_n").setReadOnly(false);
                                record.getField("province_id_n").setRequired(true);
                                record.getField("city_id_n").setRequired(true);
                                /*record.getField("district_id_n").setRequired(true);*/
                            }
                        }
                    }
                });
            }
            var function_usage = '${/parameter/@function_usage}';
            if (function_usage == 'QUERY') {
                //$jq('#${/parameter/@layout_code}_save').hide();
                var bp_class = '${/parameter/@bp_class}';
                if (bp_class == 'ORG') {
                    $jq('#${/parameter/@layout_code}_user_button1').hide();
