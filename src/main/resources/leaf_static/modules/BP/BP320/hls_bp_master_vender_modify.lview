            }

            //新增和加载时调用(form)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function () {
                var bp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                var record = $(bp_ds).getCurrentRecord();
                var code_value = record.get('license_terms_if_long');
                var bp_class = record.get('bp_class');

                if (record.get('bp_category') == 'VENDER') {
                    record.getField('extra_nam').setRequired(true);
                }


                // 若function_usage为QUERY，直接返回
                /*var function_usage = '${/parameter/@function_usage}';
                if (function_usage == 'QUERY') {
                    return;
                }*/

                /* if (bp_class == 'ORG') {
                     if (code_value == 'Y') {
                         record.set('license_terms', null);
                         record.getField('license_terms').setReadOnly(true);
                         record.getField('license_terms').setRequired(false);
                     } else {
                         record.getField('license_terms').setReadOnly(false);
                         record.getField('license_terms').setRequired(true);
                     }
                 } else if (bp_class == 'NP') {
                     if (record.get('marital_status') == 'MARRIED') {
                         record.getField('bp_name_sp').setRequired(true);
                         record.getField('id_type_sp_n').setRequired(true);
                         record.getField('id_card_no_sp').setRequired(true);
                         record.getField('gender_sp_n').setRequired(true);
                     }

                 }*/
                //如果营业执照为长期，则营业执照到期日LICENSE_TERMS设空并只读 hongqun.dai 20180928
                if (record.getField('license_terms_if_long') && '${/parameter/@function_usage}' != 'QUERY') {
                    if (record.get('license_terms_if_long') == 'Y') {
                        record.set('license_terms', '');
                        record.getField('license_terms').setReadOnly(true);
                        record.getField('license_terms').setRequired(false);
                    } else if (record.get('license_terms_if_long') == 'N') {
                        record.getField('license_terms').setReadOnly(false);
                        record.getField('license_terms').setRequired(true);
                    } else {
                        record.getField('license_terms').setReadOnly(false);
                        record.getField('license_terms').setRequired(false);
                    }
                }
                //如果为上市地点、上市公司，则上市主体和上市主体组织机构代码必填，否则非必填  hongqun.dai 20181001
                /*if (record.get('listed_company_flag')=='Y') {
                    record.getField('listed_subject').setReadOnly(false);
                    record.getField('listed_subject').setRequired(true);
                    record.getField('listed_subject_org_code').setReadOnly(false);
                    record.getField('listed_subject_org_code').setRequired(true);
                    record.getField('market_location').setReadOnly(false);
                    record.getField('market_location').setRequired(true);
                    record.getField('market_location_n').setReadOnly(false);
