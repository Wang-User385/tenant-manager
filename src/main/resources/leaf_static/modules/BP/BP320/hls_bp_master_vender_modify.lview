            if (ds_bp == ds.id && value) {
                var orgbase_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgbase');

                if (name === 'regno') {
                    $(orgbase_ds).getCurrentRecord().set('regno', value);
                    var bp_id = -1;
                    var reg_number = null;
                    var parent_ds = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds');
                    if (parent_ds.getCurrentRecord().get('bp_class') == "NP") {
                        is_regno_valid = true;
