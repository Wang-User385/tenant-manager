                        record.set('spouse_phone', '');
                        record.getField('province_sp').setReadOnly(true);
                        record.getField('province_sp_n').setReadOnly(true);
                        record.getField('academic_background_sp').setReadOnly(true);
                        record.getField('academic_background_sp_n').setReadOnly(true);
                        record.getField('address_sp').setReadOnly(true);
                        record.getField('bp_name_sp').setReadOnly(true);
                        record.getField('city_sp').setReadOnly(true);
                        record.getField('country_sp').setReadOnly(true);
                        record.getField('city_sp_n').setReadOnly(true);
                        record.getField('country_sp_n').setReadOnly(true);
                        record.getField('date_of_birth_sp').setReadOnly(true);
                        record.getField('district_sp').setReadOnly(true);
                        record.getField('district_sp_n').setReadOnly(true);
                        record.getField('gender_sp').setReadOnly(true);
                        record.getField('gender_sp_n').setReadOnly(true);
                        record.getField('id_card_no_sp').setReadOnly(true);
                        record.getField('id_type_sp').setReadOnly(true);
                        record.getField('id_type_sp_n').setReadOnly(true);
                        record.getField('spouse_phone').setReadOnly(true);
                    }
                    else {
                        record.getField('province_sp').setReadOnly(false);
                        record.getField('province_sp_n').setReadOnly(false);
                        record.getField('academic_background_sp').setReadOnly(false);
                        record.getField('academic_background_sp_n').setReadOnly(false);
                        record.getField('address_sp').setReadOnly(false);
                        record.getField('bp_name_sp').setReadOnly(false);
                        record.getField('city_sp').setReadOnly(false);
                        record.getField('country_sp').setReadOnly(false);
                        record.getField('city_sp_n').setReadOnly(false);
                        record.getField('country_sp_n').setReadOnly(false);
                        record.getField('date_of_birth_sp').setReadOnly(false);
                        record.getField('district_sp').setReadOnly(false);
                        record.getField('district_sp_n').setReadOnly(false);
                        record.getField('gender_sp').setReadOnly(false);
                        record.getField('gender_sp_n').setReadOnly(false);
                        record.getField('id_card_no_sp').setReadOnly(false);
                        record.getField('id_type_sp').setReadOnly(false);
                        record.getField('id_type_sp_n').setReadOnly(false);
                        record.getField('spouse_phone').setReadOnly(false);
                    }
                } else if (name == 'license_terms_if_long') {
                    if (value == 'Y') {
                        record.set('license_terms', null);
                        record.getField('license_terms').setReadOnly(true);
                        record.getField('license_terms').setRequired(false);
                    } else {
                        record.getField('license_terms').setReadOnly(false);
                        record.getField('license_terms').setRequired(true);
                    }
                }
            }
            //股东
            var ds_bp_sh = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_shareholder');
            if (ds_bp_sh == ds.id && value) {
                if (name == 'stockholdertype') {
                    record.set('certtype', '');
                    record.set('certtype_n', '');
                }
                var stockholdertype = record.get('stockholdertype');
                var certtype_ds = $("${/parameter/@layout_code}_G_SHAREHOLDER_certtype_combobox_ds");
                certtype_ds.originData = certtype_ds.originData || certtype_ds.data;
                if (stockholdertype == '1') {
                    certtype_ds.filterData = certtype_ds.originData.filter(function (record) {
                        return record.data.value_code == "10" || record.data.value_code == "11"
                    });
                    record.getField("orgcode").setReadOnly(true);
                    record.getField("orgcreditcode").setReadOnly(true);
                } else {
                    certtype_ds.filterData = certtype_ds.originData.filter(function (record) {
                        return record.data.value_code != "10" && record.data.value_code != "11"
                    });
                    record.getField("orgcode").setReadOnly(false);
                    record.getField("orgcreditcode").setReadOnly(false);
                }
                certtype_ds.addListener('beforeload', function () {
                    this.originData = this.originData || this.data;
                    this.data = this.filterData || this.data;
                });
            }


        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var bp_master_role = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            if (bp_master_role == ds.id) {
                record.set('bp_category', ' ');
            }

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            if (ds_id == ds.id) {
                $(ds_id).getCurrentRecord().set('country_id_n', '中国');
                $(ds_id).getCurrentRecord().set('country_id', '46');
            }

            var ds_id_bank = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            if (ds_id_bank == ds.id) {
                $(ds_id_bank).getCurrentRecord().set('country_id_n', '中国');
                $(ds_id_bank).getCurrentRecord().set('country_id', '46');
                $(ds_id_bank).getCurrentRecord().set('currency', 'CNY');
                $(ds_id_bank).getCurrentRecord().set('currency_n', '人民币');
            }

            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_bp_master_relation');
            if (relation_ds_id == ds.id) {
                var relation_records = $(relation_ds_id).getAll();
                for (var i = 0; i < relation_records.length; i++) {
                    var status = relation_records[i].get('admit_status');
                    if (status == 'NEW') {
                        relation_records[i].getField('relation_type_n').setReadOnly(false);
                        relation_records[i].getField('related_bp_id_n').setReadOnly(false);
                        relation_records[i].getField('term_of_agreement_from').setReadOnly(false);
                        relation_records[i].getField('term_of_agreement_to').setReadOnly(false);
                        relation_records[i].getField('description').setReadOnly(false);
                    }
                }
            }
        };

        //身份证合法性校验
        window['${/parameter/@layout_code}_checkIdNo'] = function (str) {
            num = str.toUpperCase();
            //身份证号码为15位或者18位，15位时全为数字，18位前17位为数字，最后一位是校验位，可能为数字或字符X。
            if (!(/(^\d{15}$)|(^\d{17}([0-9]|X)$)/.test(num))) {
                Leaf.SideBar.show({
                    type: 'error',
                    msg: '请输入正确的证件号码',
                    duration: 2000
                });
                return false;
            }
            var len, re;
            len = num.length;
            if (len == 15) {
                re = new RegExp(/^(\d{6})(\d{2})(\d{2})(\d{2})(\d{3})$/);
                var arrSplit = num.match(re);
                //检查生日日期是否正确
                var dtmBirth = new Date('19' + arrSplit[2] + '/' + arrSplit[3] + '/' + arrSplit[4]);
                var bGoodDay;
                bGoodDay = (dtmBirth.getYear() == Number(arrSplit[2]))
                    && ((dtmBirth.getMonth() + 1) == Number(arrSplit[3]))
                    && (dtmBirth.getDate() == Number(arrSplit[4]));
                if (!bGoodDay) {
                    Leaf.SideBar.show({
                        type: 'error',
                        msg: '请输入正确的证件号码',
                        duration: 2000
                    });
                    return false;
                } else {
                    //将15位身份证转成18位
                    //校验位按照ISO 7064:1983.MOD 11-2的规定生成，X可以认为是数字10。
                    var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
                    var arrCh = new Array('1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2');
                    var nTemp = 0, i;
                    num = num.substr(0, 6) + '19' + num.substr(6, num.length - 6);
                    for (i = 0; i < 17; i++) {
                        nTemp += num.substr(i, 1) * arrInt[i];
                    }
                    num += arrCh[nTemp % 11];
                    return num;
                }
            }
            if (len == 18) {
                re = new RegExp(/^(\d{6})(\d{4})(\d{2})(\d{2})(\d{3})([0-9]|X)$/);
                var arrSplit = num.match(re);
                //检查生日日期是否正确
                var dtmBirth = new Date(arrSplit[2] + "/" + arrSplit[3] + "/" + arrSplit[4]);
                var bGoodDay;
                bGoodDay = (dtmBirth.getFullYear() == Number(arrSplit[2]))
                    && ((dtmBirth.getMonth() + 1) == Number(arrSplit[3]))
                    && (dtmBirth.getDate() == Number(arrSplit[4]));
                if (!bGoodDay) {
                    Leaf.SideBar.show({
                        type: 'error',
                        msg: '请输入正确的证件号码',
                        duration: 2000
                    });
                    return false;
                } else {
                    //检验18位身份证的校验码是否正确。
                    //校验位按照ISO 7064:1983.MOD 11-2的规定生成，X可以认为是数字10。
                    var valnum;
                    var arrInt = new Array(7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2);
                    var arrCh = new Array('1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2');
                    var nTemp = 0, i;
                    for (i = 0; i < 17; i++) {
                        nTemp += num.substr(i, 1) * arrInt[i];
                    }
                    valnum = arrCh[nTemp % 11];
                    if (valnum != num.substr(17, 1)) {
                        Leaf.SideBar.show({
                            type: 'error',
                            msg: '请输入正确的证件号码',
                            duration: 2000
                        });
                        return false;
                    }
                    return num;
                }
            }
        }

        //提交审批按钮
        var vender_validate = 0;
        var dealer_validate = 0;
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');

            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_approve_status = record.get('bp_approve_status');
            var bp_code = record.get('bp_code');
            var bp_type = record.get('bp_type');
            if ($(ds_id).isModified()) {
                Leaf.showMessage('${HLS.PROMPT}', '${l:EXIT_BEFORE_SAVE}');
                return;
            }

            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');
            var role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var add_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var relation_records = $(relation_ds_id).getAll();
            var role_records = $(role_ds_id).getAll();
            var add_records = $(add_ds_id).getAll();
            var relation_selected_records = $(relation_ds_id).getSelected();
            var admitStatus;
            var relationType;
            var relatedBpIdN;
            var bpRelationId;
            var termOfAgreementFrom;
            var termOfAgreementTo;
            if (relation_selected_records.length === 0) {
                Leaf.showMessage('${HLS.PROMPT}','请选择一条伙伴关系信息！');
                return;
            } else if (relation_selected_records.length === 1) {
                admitStatus = relation_selected_records[0].get('admit_status');
                relationType = relation_selected_records[0].get('relation_type');
                relatedBpIdN = relation_selected_records[0].get('related_bp_id_n');
                bpRelationId = relation_selected_records[0].get('bp_relation_id');
                termOfAgreementFrom = relation_selected_records[0].get('term_of_agreement_from');
                termOfAgreementTo = relation_selected_records[0].get('term_of_agreement_to');
                if (admitStatus !== 'NEW' && admitStatus !== 'REJECTED' && admitStatus !== 'CANCEL') {
                    Leaf.showMessage('${HLS.PROMPT}','仅可选择一条准入状态为‘新建’/‘审批拒绝’/‘撤回’的伙伴关系记录！');
                    return;
                }
            } else {
                Leaf.showMessage('${HLS.PROMPT}','仅可选择一条准入状态为‘新建’/‘审批拒绝’/‘撤回’的伙伴关系记录！');
                return;
            }

            /*if (relation_records.length < 1) {
                Leaf.showMessage('${HLS.PROMPT}', '请至少维护一条伙伴关系！');
                return;
            }*/
            //校验主机厂必须维护关联厂商，经销商必须维护关联主机厂
            if (record.get('bp_category') == 'VENDER') {
                for (var i = 0; i < relation_records.length; i++) {
                    if (relation_records[i].get('relation_type') == 'MANUFACTURER') {
                        vender_validate++;
                    }
                }
                if (vender_validate === 0) {
                    Leaf.showMessage('${HLS.PROMPT}', '请维护关联厂商！');
                    return;
                }
            }

            if (record.get('bp_category') == 'DEALER') {
                for (var i = 0; i < relation_records.length; i++) {
                    if (relation_records[i].get('relation_type') == 'VENDER') {
                        dealer_validate++;
                    }
                }
                if (dealer_validate === 0) {
                    Leaf.showMessage('${HLS.PROMPT}', '请维护关联主机厂！');
                    return;
                }
            }

            if (add_records.length < 1) {
                Leaf.showMessage('${HLS.PROMPT}', '请至少维护一条地址信息！');
                return;
            }

            // if (bp_approve_status === 'APPROVING' || bp_approve_status === 'APPROVED') {
            //     Leaf.showMessage('${HLS.PROMPT}', '编码为:' + bp_code + '的商业伙伴已审批,不能重复审批');
            //     return;
            // }

            bp_type = 'DISTRIBUTOR';
            for (var i = 0; i < role_records.length; i++) {
                if (role_records[i].get('bp_type') == 'VENDER')  {
                    bp_type = 'VENDER';
                    break;
                } else if (role_records[i].get('bp_type') == 'DEALER') {
                    bp_type = 'DEALER';
                    break;
                }
            }

            if (bp_type === 'VENDER' || bp_type === 'DEALER') {
                if (termOfAgreementFrom == null) {
                    Leaf.showMessage('${HLS.PROMPT}', '请维护协议有效期从！');
                    return;
                }
                if (termOfAgreementTo == null) {
                    Leaf.showMessage('${HLS.PROMPT}', '请维护协议有效期到！');
                    return;
                }
            }

            if (bp_type === 'DISTRIBUTOR') {
                var param = {};
                param['url_title'] = '指派复核人';
                param['function_code'] = 'PRJ306T1';
                param['winid'] = 'bp_master_assign_winid';
                param['screen_width'] = 410;
                param['screen_height'] = 600;
                param['user_id'] = '${/session/@user_id}';
                param['bp_id'] = bp_id;
                param['approve_type'] = 'BP_NORMAL';
                param['bp_relation_id'] = bpRelationId;
                param['admit_status'] = admitStatus;
                hls_doc_get_layout_code(param, 'bp320_bp_master_assign_id', ds_id, 'PRJ320F1', null, null, 'prj320f1_exit');
            } else {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                    Leaf.request({
                        url: '${/request/@context_path}/hls/bp/master/wfl/submit',
                        para: {
                            bpId: '${/parameter/@bp_id}',
                            bpRelationId:bpRelationId,
                            relationType:relationType,
                            relatedBpIdN:relatedBpIdN,
                            admitStatus:admitStatus
                        },
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '提交成功', function () {
                                $('${/parameter/@winid}').close();
                            });
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }, function cancel() {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }, 200, 100);

            }

        };

        function prj320f1_exit() {
            $('${/parameter/@winid}').close();
        }

        //附件
        var win;
        window['${/parameter/@layout_code}_attach_link'] = function (record_id, name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            if (record.get('bp_attachment_id')) {
                debugger;
                var url;
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';
                }
                win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('bp_attachment_id'),
                        table_name: 'bp_master_attachment',
                        winid: '${/parameter/@layout_code}_open_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
                win.on('close', function () {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'bp_master_attachment');
                    $(ds_id).query();
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }

        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

            if (name === 'attach_link') {
                var link_function = '${/parameter/@layout_code}_attach_link';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + config_record.get('prompt') + '</a>';
            } else if (name === 'report_link') {
                return '<a href="javascript:bp_vender_report_link_win(\'' + record.id + '\',\'' + name + '\');">决策报告查看</a>';
            } else if (name === 'relation_attach_link') {
                return '<a href="javascript:bp_vender_attach_link_win(\'' + record.id + '\',\'' + name + '\');">附件上传/下载</a>';
            }
        }

        function bp_vender_report_link_win(record_id,name) {
            checkAuth(record_id,name);
        }

        function checkAuth(record_id,name) {
            //查询当前用户决策报告查看权限
            Leaf.request({
                url: $('admit_report_auth_query_link_id').getUrl(),
                scope: this,
                para: {userId: '${/session/@user_id}'},
                success: function (res) {
                    if (res.success && res.result.totalCount > 0) {
                        if(res.result.record[0].report_auth_bp_admit_flag !== 'Y') {
                            $L.showMessage("提示", "您当前无权限查看决策报告!", null);
                            return;
                        }
                        queryReportlink(record_id,name);
                    } else {
                        $L.showMessage("提示", "您当前无权限查看决策报告!", null);
                    }
                },
                failure: function () {
                    $L.showMessage("提示", "您当前无权限查看决策报告!", null);
                },
                error: function () {
                    $L.showMessage("提示", "您当前无权限查看决策报告!", null);
                },
                scope: this
            });
        }

        var queryCount = 0;
        function queryReportlink(record_id,name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            var hbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var hbm_record = $(hbm_ds_id).getCurrentRecord();
            var bp_id = hbm_record.get('bp_id');
            var bp_code = hbm_record.get('bp_code');
            var token = record.get('report_token');
            if(record.get('report_status') == 'SUCCESS') {
                queryCount = 0;
                Leaf.request({
                    url: $('credit_service_get_token_link').getUrl(),
                    scope: this,
                    para: {
                        bpCode: bp_code,
                        reportLink:record.get('report_link'),
                        queryStage: 'bpAdmit'
                    },
                    success: function (res) {
                        window.open(res.error.message);
                    },
                    failure: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    scope: this,
                    sync:false
                });
            } else if (record.get('report_status') == 'QUERYING') {
                //调用决策流报告生成
                Leaf.request({
                    url: $('credit_service_query_link').getUrl(),
                    scope: this,
                    para: {
                        bpCode: bp_code,
                        token: token,
                        wflFlag:'Y',
                        interfaceCode: 'bp_admit_query'
                    },
                    success: function (res) {
                        queryCount = queryCount + 1;
                        if(queryCount >= 3) {
                            queryCount = 0;
                        } else {
                            queryReportlink(record_id,name);
                        }
                    },
                    failure: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    scope: this,
                    sync:false
                });
            } else if (record.get('report_status') == 'FAILURE') {
                Leaf.showMessage("提示", "报告获取失败，请联系系统管理员！", null);
            } else {
                Leaf.showMessage("提示", "该伙伴关系下暂无报告!", null);
            }
        }

        function bp_vender_attach_link_win(record_id,name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            var status = record.get('admit_status');
            if (record.get('bp_relation_id')) {
                var url;
                if ('${/parameter/@wfl_flag}' == 'Y') {
                    if ('${/parameter/@function_usage}' == 'QUERY') {
                        url = '${/request/@context_path}/downloadFile.lview';
                    } else {
                        url = '${/request/@context_path}/uploadFile.lview';
                    }
                } else {
                    if (status == 'APPROVING' || status == 'APPROVED' || status == 'FAILURE') {
                        url = '${/request/@context_path}/downloadFile.lview';
                    } else {
                        url = '${/request/@context_path}/uploadFile.lview';
                    }
                }
                win = new Leaf.Window({
                    id: '${/parameter/@layout_code}_open_vender_attachment_winid',
                    url: url,
                    params: {
                        header_id: record.get('bp_relation_id'),
                        table_name: 'hls_bp_master_relation',
                        winid: '${/parameter/@layout_code}_open_bp_attachment_winid',
                        function_usage: '${/parameter/@function_usage}'
                    },
                    title: '文件上传',
                    width: 800,
                    height: 575
                });
            } else {
                $L.showInfoMessage("提示", "请先保存!", null);
            }
        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'bp_master_attachment');
            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_bp_master_relation');
            if (role_ds_id == ds.id) {
                var records = $(role_ds_id).getAll();
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('primary_flag') == 'Y') {
                        records[i].getField('bp_category_n').setReadOnly(true);
                        records[i].getField('bp_type_n').setReadOnly(true);
                        records[i].getField('enabled_flag').setReadOnly(true);
                    }
                }
            }

            if (attachment_ds_id == ds.id) {
                var atta_records = $(attachment_ds_id).getAll();
                for (var i = 0; i < atta_records.length; i++) {
                    if (atta_records[i].get('bp_attachment_category') == 'SYS_DOCUMENT_LIST') {
                        atta_records[i].getField('document_name').setReadOnly(true);
                    }
                }
            }

            var holder_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_shareholder');
            var holder_records = $(holder_ds).getAll();
            if (holder_records.length > 0 && '${/parameter/@function_usage}' != 'QUERY') {
                for (var i = 0; i < holder_records.length; i++) {
                    if (holder_records[i].get('stockholdertype') == '1') {
                        holder_records[i].getField('orgcode').setReadOnly(true);
                    }
                }
            }

            if (relation_ds_id == ds.id) {
                var relation_records = $(relation_ds_id).getAll();
                for (var i = 0; i < relation_records.length; i++) {
                    var status = relation_records[i].get('admit_status');
                    if (status == 'APPROVING' || status == 'APPROVED' || status == 'FAILURE' || '${/parameter/@wfl_flag}' == 'Y') {
                        relation_records[i].getField('relation_type_n').setReadOnly(true);
                        relation_records[i].getField('related_bp_id_n').setReadOnly(true);
                        relation_records[i].getField('term_of_agreement_from').setReadOnly(true);
                        relation_records[i].getField('term_of_agreement_to').setReadOnly(true);
                        relation_records[i].getField('description').setReadOnly(true);
                    } else {
                        relation_records[i].getField('relation_type_n').setReadOnly(false);
                        relation_records[i].getField('related_bp_id_n').setReadOnly(false);
                        relation_records[i].getField('term_of_agreement_from').setReadOnly(false);
                        relation_records[i].getField('term_of_agreement_to').setReadOnly(false);
                        relation_records[i].getField('description').setReadOnly(false);
                    }
                }
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var hls_bp_master_address_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var hls_bp_master_contact_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_contact_info');
            var hls_bp_master_shareholder_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_shareholder');
            var hls_bp_master_role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var hls_bp_master_relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');
            var hls_bp_master_bank_account_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_bank_account');
            var zx_bp_orgaffiliated_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgaffiliated');
            var zx_bp_orgparentbody_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgparentbody');
            var zx_bp_orgfamily_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_orgfamily');
            var zx_bp_custlawsuit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_custlawsuit');
            var zx_bp_custevent_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'zx_bp_custevent');
            var bp_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'bp_master_attachment');

            if (!!$(hls_bp_master_address_ds_id)) {
                $(hls_bp_master_address_ds_id).query();
            }
            if (!!$(hls_bp_master_contact_info_ds_id)) {
                $(hls_bp_master_contact_info_ds_id).query();
            }
            if (!!$(hls_bp_master_shareholder_ds_id)) {
                $(hls_bp_master_shareholder_ds_id).query();
            }
            if (!!$(hls_bp_master_role_ds_id)) {
                $(hls_bp_master_role_ds_id).query();
            }
            if (!!$(hls_bp_master_relation_ds_id)) {
                $(hls_bp_master_relation_ds_id).query();
            }
            if (!!$(hls_bp_master_bank_account_ds_id)) {
                $(hls_bp_master_bank_account_ds_id).query();
            }
            if (!!$(zx_bp_orgparentbody_ds_id)) {
                $(zx_bp_orgparentbody_ds_id).query();
            }
            if (!!$(zx_bp_orgfamily_ds_id)) {
                $(zx_bp_orgfamily_ds_id).query();
            }
            if (!!$(zx_bp_custlawsuit_ds_id)) {
                $(zx_bp_custlawsuit_ds_id).query();
            }
            if (!!$(zx_bp_custevent_ds_id)) {
                $(zx_bp_custevent_ds_id).query();
            }
            if (!!$(zx_bp_orgaffiliated_ds_id)) {
                $(zx_bp_orgaffiliated_ds_id).query();
            }
            if (ds.id == attachment_ds_id) {
                $(attachment_ds_id).query();
            }

        };

        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function(ds, record, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_bp_master_relation');
            var records = $(ds_id).getSelected();
            for (var i = 0; i < records.length; i++) {
                var admit_status = records[i].get('admit_status')
                if (admit_status != 'NEW') {
                    Leaf.showMessage('${HLS.PROMPT}', '仅可勾选准入状态为‘新建’的准入信息！');
                    return false;
                }
            }
            return true;
        };

