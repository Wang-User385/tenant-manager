<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp320_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP320/hls_bp_master_vender_modify.lview"/>
        <a:link id="bp320_bp_master_assign_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_assign_approver.lview"/>
        <script><![CDATA[
        var page = null ;
        var pageSize  = null;
        var index = null;

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var win = new Leaf.Window({
                id: 'bp320_bp_create_win_id',
                url: "${/request/@context_path}/modules/BP/BP320/hls_bp_master_vender_create_en.lview",
                params: {
                    winid: 'bp320_bp_create_win_id'
                },
                title: '主机厂/经销商创建',
                fullScreen: true
            });
            win.on('close', function () {
                $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master')).query();
            });
        };

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_code' && value) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_bp_modify_win(ds_id, record_id) {
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '主机厂/经销商维护';
            if (record.get('bp_category') === 'VENDER' || record.get('bp_category') === 'DEALER') {
            param['function_code'] = 'BP320F1';
            // param['function_usage'] = 'CREATE';
            if (record.get('bp_approve_status') === 'APPROVING' || record.get('bp_approve_status') === 'APPROVED') {
                param['function_usage'] = 'QUERY';
                param['maintain_type'] = 'READONLY';
            } else {
                param['function_usage'] = 'MODIFY';
            }
            } else {
                param['function_code'] = 'BP320F1';
                param['function_usage'] = 'QUERY';
                param['maintain_type'] = 'READONLY';
            }
            param['winid'] = 'bp_master_modify_winid';
            hls_doc_get_layout_code(param, 'bp320_bp_master_modify_id', ds_id, 'BP320');
        }


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            if (ds_id == ds.id) {
                $(ds_id).setQueryParameter('user_id', '${/session/@user_id}');
            }
            if (ds === $(ds_id)){
                //详情页返回 需要定位到之前的行
                if(pageSize != null && page!= null && index != null) {
                    $(ds_id).pagesize = pageSize;
                    $(ds_id).goPage(page);
                    $(ds_id).locate(index);
                    page = null;
                    pageSize = null;
                    index = null ;
                }
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
