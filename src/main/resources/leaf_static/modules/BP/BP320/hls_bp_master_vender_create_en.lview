<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <a:link id="bp320_bp_master_create_id"
                url="${/request/@context_path}/modules/BP/BP320/hls_bp_master_vender_create.lview"/>
        <script><![CDATA[

        function prj320_bp_exit() {
            $('${/parameter/@winid}').close();
        }

        function bp320_bp_create() {
            var ds = $('hls_bp_create_ds');
            if (ds.validate()) {
                var param = ds.getCurrentRecord().data;
                param['url_title'] = '主机厂/经销商创建';
                param['function_code'] = 'BP320F1';
                param['function_usage'] = 'CREATE';
                param['winid'] = 'bp_master_create_winid';
                hls_doc_get_layout_code(param, 'bp320_bp_master_create_id', 'hls_bp_create_ds', 'BP320',null,null,'prj320_bp_exit');
            }
        }
        function on_commit_bp_type_n_lov(cmp,lovRecord,dsRecord){
            //以下几种商业伙伴类别，对应的商业伙伴分类只能是法人
            var orgBpType = [
                "CREDIT_ORGANIZATION",
                "HLS_BP_CREDIT",
                "MANUFACTURER",
                "OTHER_AGENCY",
                "VENDER"
            ];

            var bp_category = lovRecord.get("bp_category");
            var bp_class_ds = $("hls_bp_create_bp_class_ds");
            if(orgBpType.indexOf(bp_category)>=0){
                bp_class_ds.originData = bp_class_ds.originData || bp_class_ds.data;
                bp_class_ds.data = bp_class_ds.data.filter(function(record){
                    return record.get("code_value") == "ORG"
                });
                bp_class_ds.fireEvent("load");
            }else{
                bp_class_ds.data = bp_class_ds.originData || bp_class_ds.data;
                bp_class_ds.fireEvent("load");
            }
        }

        function vender_category_info_query(lov){
            var bp_category = 'VENDER';
            lov.controller = "/hls/bp/master/type/query?bpCategory="+ bp_category;
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="hls_bp_create_bp_class_ds" lookupCode="HLS211_BP_CLASS"/>
            <a:dataSet id="hls_bp_create_ds" autoCreate="true">
                <a:fields>
                    <a:field name="bp_category_n" autoComplete="true" lovGridHeight="360" lovHeight="510"
                             lovLabelWidth="100" lovService="/hls/bp/queryBpMasterLov?~com.hand.hls.bp.dto.BpCategoryInfoLov"
                             lovWidth="600"
                             title="选择类型" required="true">
                        <a:mapping>
                            <a:map from="category_desc" to="bp_category_n"/>
                            <a:map from="bp_category" to="bp_category"/>
                            <a:map from="type_desc" to="bp_type_n"/>
                            <a:map from="bp_type" to="bp_type"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="bp_class_n" options="hls_bp_create_bp_class_ds" displayField="code_value_name"
                             valueField="code_value" returnField="bp_class" required="true"/>
                    <a:field name="bp_name" required="true"/>
                    <a:field name="bp_type_n" readOnly="true"/>
                    <a:field name="bp_class_n" readOnly="true" defaultValue="企业法人"/>
                    <a:field name="bp_class" readOnly="true" defaultValue="ORG"/>
                </a:fields>

            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="prj320_bp_exit" text="退出"/>
                <a:gridButton click="bp320_bp_create" text="创建"/>
            </a:screenTopToolbar>
            <a:form>
                <a:box column="1" labelWidth="140">
                    <a:textField name="bp_name" bindTarget="hls_bp_create_ds" prompt="商业伙伴名称"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:lov name="bp_category_n" bindTarget="hls_bp_create_ds" prompt="类别"
                           width="165">
                        <a:events>
                            <a:event name="commit" handler="on_commit_bp_type_n_lov"/>
                            <a:event name="beforetriggerclick" handler="vender_category_info_query"/>
                        </a:events>
                    </a:lov>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:textField name="bp_type_n" bindTarget="hls_bp_create_ds" prompt="类型"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:comboBox name="bp_class_n" bindTarget="hls_bp_create_ds" prompt="商业伙伴分类"
                                width="165">
                    </a:comboBox>
                </a:box>
            </a:form>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
