<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2019-1-24
    $Revision: 1.0
    $Purpose: 商业伙伴财报查看
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="financing_report_import_link_id"
                url="${/request/@context_path}/modules/BP/BP100/financial_report_import_entrance.lview"/>
        <script><![CDATA[


        <!--打开窗口：报表分期明细-->
        function winOpen_access_component(header_id,fiscal_year) {
             new Leaf.Window({
                    id: 'sys_resource_access_component_winId',
                    url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_period_info.lview',
                    params: {
                        header_id: header_id,
                        fiscal_year:fiscal_year,
                        bp_id : '${/parameter/@bp_id}',
                        winId: "sys_resource_access_component_winId"
                    },
                    title: '报表明细',
                    width:830,
                    height:535,
                    side:"right",
                    draggable: true
                });
        }

        <!--打开窗口：报表明细-->
        function winOpen_access_detail_component(result_id,excel_id,created_by) {
            if(result_id == null || result_id == ''){
                $L.showInfoMessage("提示","参数获取失败!");
                return;
            }
            var readonly = 'Y';
            if(created_by == ${/session/@user_id}){
                readonly = 'N';
            }
            var win = new Leaf.Window({
                id: 'bp100_excel_detail_win_id',
                params: {
                    result_id:result_id,
                    excel_id:excel_id,
                    source_document_category: 'HLS_BP_MASTER',
                    winid: 'bp100_excel_detail_win_id',
                    readOnly: readonly
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '财务报表明细',
                fullScreen: true
            });
            win.on('close',function(){
                $('hls_bp_master_financial_info_ds').query();
            });


        }

        <!--打开窗口：指标明细-->
        function winOpen_indicator_anaysis(header_id,report_year_one , report_year_two , report_year_three , report_year_four) {
            // debugger;
            if(report_year_one == null || report_year_one == 'undefined'  || report_year_one == '' ){
                report_year_one = '';
            }
            if(report_year_two == null || report_year_two == 'undefined' || report_year_two == '' ){
                report_year_two = '';
            }
            if(report_year_three == null || report_year_three == 'undefined' || report_year_three == ''){
                report_year_three = '';
            }
            if(report_year_four == null || report_year_four == 'undefined' || report_year_four == '' ){
                report_year_four = '';
            }
            new Leaf.Window({
                id: 'sys_resource_access_component_detail_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_indicator_info.lview',
                params: {
                    header_id: header_id,
                    report_year_one : report_year_one,
                    report_year_two : report_year_two,
                    report_year_three : report_year_three,
                    report_year_four : report_year_four,
                    winId: "sys_resource_access_component_detail_winId"
                },
                title: '报表明细',
                width:950,
                height:535,
                side:"right",
                draggable: true
            });

        }
        //附件上传
        function winOpen_file_upload(header_id){
            var win = new Leaf.Window({
                id: 'financial_open_attachment_winid',
                url: '${/request/@context_path}/uploadFile.lview',
                params: {
                    header_id: header_id,
                    table_name: 'HLS_BP_FINANCIAL_HEADER',
                    winid: 'financial_open_attachment_winid'
                },
                title: '附件',
                width: 1120,
                height: 575
            });

            win.on('close', function () {
            });
        }


        function render_hls_bp_master_financial_ds_grid(value, record, name) {
            debugger;
            if (!record.isNew) {
               if (name == 'access_component') {
                    return '<a href="javascript:winOpen_access_component(\'' + record.get('header_id') + '\',\'' + record.get('fiscal_year') + '\');">报表分期明细</a>';
                }else if( name == 'access_component_detail' ){
                   return '<a href="javascript:winOpen_access_detail_component(\'' + (record.get('result_id')||'') + '\',\'' + record.get('excel_id') + '\',\'' + record.get('created_by') +'\');">报表明细</a>';
               }else if(name == 'indicator_anaysis'){
                   return '<a href="javascript:winOpen_indicator_anaysis(\'' + record.get('header_id') + '\',\'' + record.get('report_year_one') + '\',\'' + record.get('report_year_two') + '\',\'' + record.get('report_year_three') + '\',\'' + record.get('report_year_four') + '\');">指标分析</a>';

               }else if(name == 'file_upload'){
                   return '<a href="javascript:winOpen_file_upload(\'' + record.get('header_id') +  '\');">附件</a>';
               }

                return '';
            }
            return '';
        }

        //财报导入
        function bp_financial_import(){
            var bp_id = '${/parameter/@bp_id}';
            var bp_code = '${/parameter/@bp_master_code}';
            var bp_name = '${/parameter/@bp_master_name}';
            var param = {};
            param['url_title'] = '财务报表导入';
            param['function_code'] = 'FRI001';
            param['winid'] = 'financing_import_detail_winid';
            param['bp_master_code'] = bp_code;
            param['bp_master_name'] = bp_name;
            param['bp_id'] = bp_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'financing_report_import_link_id';
            hls_doc_get_layout_code(param, link_id, null, null);


        }

        //财报删除
        function bp_financial_report_delete(){

            if( $('hls_bp_master_financial_info_ds').getSelected().length  != 1){
                $L.showInfoMessage("提示","请选择一个财报信息进行删除");
            }else{
                new Leaf.showConfirm('${l:HLS.PROMPT}', '确认刪除财报吗?', function okFun() {
                    Leaf.Masker.mask(Ext.getBody(), '删除中，请稍候！');
                    var header_id = $('hls_bp_master_financial_info_ds').getSelected()[0].data.header_id;
                    Leaf.request({
                        type: 'POST',
                        url: "${/request/@context_path}/bp/financial/report/delete?bpId=${/parameter/@bp_id}" +"&headerId=" + header_id,
                        async: true, //设为同步
                        contentType: "application/json; charset=utf-8",
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showMessage('提示', res.message,function(){
                                $('hls_bp_master_financial_info_ds').query();
                            });
                            //$('hls_bp_master_financial_info_ds').query();
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            //$('hls_bp_master_financial_info_ds').query();
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            //$('hls_bp_master_financial_info_ds').query();
                        }

                    });
                }, function cancel() {

                }, 200, 100);

            }

        }

        //财报校验
        function bp_financial_report_verificate(){
            if($('hls_bp_master_financial_info_ds').getSelected().length  != 1){
                $L.showInfoMessage("提示","请选择一个财报信息进行校验");
            }else{
                Leaf.Masker.mask(Ext.getBody(), '校验中，请稍候！');
                var headerId = $('hls_bp_master_financial_info_ds').getSelected()[0].data.header_id;
                Leaf.request({
                    type: 'POST',
                    url: "${/request/@context_path}/bp/financial/report/verificate?bpId=${/parameter/@bp_id}" +"&headerId=" + headerId,
                    async: true, //设为同步
                    contentType: "application/json; charset=utf-8",
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('提示', res.message);
                        $('hls_bp_master_financial_info_ds').query();
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        $('hls_bp_master_financial_info_ds').query();
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        $('hls_bp_master_financial_info_ds').query();
                    }

                });


            }


        }

        //财报导出
        function bp_financial_export(){
            if($('hls_bp_master_financial_info_ds').getSelected().length  != 1){
                $L.showInfoMessage("提示","请选择一个财报信息进行导出");
            }else {
                Leaf.Masker.mask(Ext.getBody(), '导出中，请稍候！');
                var fin_statement_templet_hd_id = $('hls_bp_master_financial_info_ds').getSelected()[0].data.fin_statement_templet_hd_id;
              /*  Leaf.request({
                    type: 'GET',
                    url: "${/request/@context_path}/bp/financial/report/export?bpId=${/parameter/@bp_id}" + "&templetHdId=" + fin_statement_templet_hd_id,
                    async: true, //设为同步
                    contentType: "application/json; charset=utf-8",
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('提示', res.message);
                        $('hls_bp_master_financial_info_ds').query();
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('提示', res.message);
                        // $('hls_bp_master_financial_info_ds').query();
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('提示', res.message);
                        // $('hls_bp_master_financial_info_ds').query();
                    }

                });*/


                location.href = '${/request/@context_path}/bp/financial/report/export?bpId=${/parameter/@bp_id}' + '&templetHdId=' + fin_statement_templet_hd_id;

                Leaf.Masker.unmask(Ext.getBody());
            }

        }

        function hls_bp_master_financial_info_ds_query(ds,para){
            para['bp_id'] = '${/parameter/@bp_id}';
        }

        Leaf.onReady(function(){
            if('${/parameter/@function_usage}' == 'QUERY'){
                $jq("#report_delete_id").hide();
                $jq("#report_verificat_id").hide();
            }
        });
        ]]></script>
        <a:dataSets>
            <a:dataSet id="bp_master_info_ds">
                <a:datas>
                    <a:record bp_master_code="${/parameter/@bp_master_code}"
                              bp_master_name="${/parameter/@bp_master_name}"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="hls_bp_master_financial_info_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls/bp/financial/header/query">

                <a:fields>
                    <a:field name="check_status" checkedValue="Y" defaultValue="N" uncheckedValue="N" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="hls_bp_master_financial_info_ds_query"/>
                </a:events>

            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <!--<a:gridButton click="bp_financial_import" text="财报导入"/>-->
                <a:gridButton id="report_delete_id" click="bp_financial_report_delete" text="财报删除"/>
<!--                <a:gridButton id="report_verificat_id"  click="bp_financial_report_verificate" text="财报校验"/>-->
                <!--<a:gridButton click="bp_financial_export" text="财报导出"/>-->

            </a:screenTopToolbar>

            <a:form column="2" title="商业伙伴信息" labelwidth="100">
                <a:textField name="bp_master_code" bindTarget="bp_master_info_ds" prompt="商业伙伴编号" readOnly="true"
                             width="165"/>
                <a:textField name="bp_master_name" bindTarget="bp_master_info_ds" prompt="商业伙伴名称" readOnly="true"
                             width="165"/>
            </a:form>
            <a:grid id="hls_bp_master_financial_info_ds_grid" bindTarget="hls_bp_master_financial_info_ds" width="950"
                    height="440" navBar="true" >
                <a:columns>
                    <a:column width="250" name="fin_statement_name" prompt="财务报表名称" align="center"/>
                    <a:column width="140" name="export_date" prompt="导入日期" renderer="Leaf.formatDate" align="center"/>
                    <a:column width="150" name="fin_statement_templet_hd_id" prompt="财务报表模板id" align="center" hidden="true" />
                    <a:column width="250" name="excel_name" prompt="财务报表模板名称" align="center"/>
<!--                    <a:column width="190" name="fiscal_year" prompt="财务报表年月" align="center"/>-->
                    <a:column width="90" name="access_component_detail" renderer="render_hls_bp_master_financial_ds_grid" prompt="报表明细"
                              align="center"/>
                    <a:column width="120" name="access_component" renderer="render_hls_bp_master_financial_ds_grid" prompt="报表分期明细"
                              align="center"/>
                    <a:column width="90" name="indicator_anaysis" renderer="render_hls_bp_master_financial_ds_grid" prompt="指标分析"
                              align="center"/>
                    <a:column width="60" name="check_status"  prompt="校验结果"    align="center"   />
                    <a:column width="60" name="file_upload"  prompt="附件"    align="center" renderer="render_hls_bp_master_financial_ds_grid"   />
                </a:columns>

              <!--  <a:editors>
                    <a:checkBox id="fnd_cashflow_item_ds_grid_cb"/>
                </a:editors>
-->
            </a:grid>

        </a:screenBody>
    </a:view>
</a:screen>
