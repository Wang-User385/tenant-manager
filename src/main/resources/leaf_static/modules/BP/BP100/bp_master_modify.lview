        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var bp_master_role = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var anti_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_anti_laundering');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_credit_rate');
            var base_record = $(base_ds_id).getCurrentRecord();
            if (bp_master_role == ds.id) {
                record.getField('bp_type_n').setReadOnly(false);
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var records = $(ds.id).getAll();
            if (ds_id == ds.id) {
                if (records.length == 1) {
                    record.set('address_type', 'REGISTERED_ADDRESS');
                    record.set('address_type_n', '住所地（注册地址）');
                }
                $(ds_id).getCurrentRecord().set('country_n', '中国');
                $(ds_id).getCurrentRecord().set('country', '46');
            }
            if (anti_ds_id == ds.id) {
                record.set('register_type',base_record.get('registration_num_type'));
                record.set('register_type_n',base_record.get('registration_num_type_n'));
                record.set('register_num',base_record.get('register_cert_num'));
                record.set('relative_ent_name',base_record.get('bp_name'));
                record.set('relation_ship','1');
                record.set('relation_ship_n','客户自身');
            }
            if(ds.id == credit_ds_id){
                record.set('customer_name',base_record.get('bp_name'));
            }
        };



        function getStringLength(str) {

            ///<summary>获得字符串实际长度，中文2，英文1</summary>
            ///<param name="str">要获得长度的字符串</param>
            var realLength = 0, len = str.length, charCode = -1;
            for (var i = 0; i < len; i++) {
                charCode = str.charCodeAt(i);
                if (charCode >= 0 && charCode <= 128) realLength += 1;
                else realLength += 3;
            }
            return realLength;
        }

        function before_submit(){

//            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var check_flag = true;
            // var ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            // var spouse_ds_id = '${/parameter/@layout_code}_F_SPOUSE_hls_bp_master_ds';
            var basicRec = $(ds_id).getCurrentRecord();
            var id_card_no = basicRec.get('id_card_no');
            var id_type = basicRec.get('id_type');
            var ageRec = basicRec.get('age');
            var swift = basicRec.get('swift');
            var overseas_customer_name = basicRec.get('overseas_customer_name');
            var business_scope = basicRec.get('business_scope');

            if ('${/parameter/@bp_class}' == 'ORG') {
                //登记注册号码校验
                var registration_num_type = basicRec.get('registration_num_type');
                var register_cert_num = basicRec.get('register_cert_num');
                if (registration_num_type == '07') {
                    if (!CheckSocialCreditCode(register_cert_num)) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        //if (ds_id == ds.id) {
                            Leaf.showMessage('提示', '统一社会信用代码有误，请重新输入！');
                       // }

                        return false;
                    }
                }
                if (!is_regno_valid) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    //if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码重复！");
                    //}
                    return false;
                }
                //地址信息校验
                var addr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
                var addRec = $(addr_ds_id).getAll();
                var flag = 0;
                for (var u = 0; u < addRec.length; u++) {
                    var address_type = addRec[u].get('address_type');
                    if (address_type == 'REGISTERED_ADDRESS') {
                        flag++;
                    }
                }
                if (flag > 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                   // if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "同一个客户只能维护一个注册地址！");
                   // }
                    return false;
                }


                if(swift){

                    var  length =getStringLength(swift);
                    if(length>11){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "SWIFT BIC所填内容超过最大字符长度11，当前最大所输字符长度："+length);
                        return false;
                    }
                }


                if(overseas_customer_name){


                    var check_name_flag=  checkS(overseas_customer_name);
                    if(check_name_flag=='Y'){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "境外客户中文名称所填内容不能只为数字和字母");
                        return false;
                    }

                    var  length =getStringLength(overseas_customer_name);
                    if(length>100){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "境外客户中文名称所填内容超过最大字符长度100，当前最大所输字符长度："+length);
                        return false;
                    }
                }

                if(business_scope){
                    var  length =getStringLength(business_scope);
                    if(length>3000){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "经营范围所填内容超过最大字符长度3000，当前最大所输字符长度："+length);
                        return false;
                    }
                }




            }

            if ('${/parameter/@bp_class}' == 'NP') {
                //身份证校验
                if (id_type == 'ID_CARD') {
                    var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                    if (reg.test(id_card_no) === false) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                       // if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "证件号码格式错误!", null);
                      //  }
                        return false;
                    }
                }
                if (!is_idno_valid) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                   // if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "身份证号重复！");
                   // }
                    return false;
                }
                //手机号校验
                var phone = basicRec.get('phone');
                // var spouseRec = $(spouse_ds_id).getCurrentRecord();
                var family_phone = basicRec.get('family_phone');
                var phoneCheck = /^[1][3,4,5,7,8,9][0-9]{9}$/;
                if (phoneCheck.test(phone) === false) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    //if (ds_id == ds.id) {
                        Leaf.showMessage("提示", "基本信息中手机号格式错误!", null);
                    //}
                    return false;
                }
                if (family_phone != null) {
                    if (phoneCheck.test(family_phone) === false) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                       // if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "配偶信息中配偶电话格式错误!", null);
                        //}
                        return false;
                    }
                }
            }

            var role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var roleRecord = $(role_ds_id).getAll();
            for (var i = 0; i < roleRecord.length; i++) {
                if (roleRecord[i].get('primary_flag') != 'Y') {
                    roleRecord[i].set('bp_category', roleRecord[i].get('bp_type'));
                }
            }
            return check_flag;
        }

        //保存前
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            debugger;
            var check_flag = true;
            // var ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            // var spouse_ds_id = '${/parameter/@layout_code}_F_SPOUSE_hls_bp_master_ds';
            var basicRec = $(ds_id).getCurrentRecord();

            var bp_id = basicRec.get('bp_id');
            var id_card_no = basicRec.get('id_card_no');
            var id_type = basicRec.get('id_type');
            var ageRec = basicRec.get('age');
            var swift = basicRec.get('swift');
            var overseas_customer_name = basicRec.get('overseas_customer_name');
            var business_scope = basicRec.get('business_scope');
            var employee_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_employee');
            var incept_ds_id=get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_incept_rule');
            var agree_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_agreement');
            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');
            var agree_num = 0;
            // if ('${/parameter/@bp_type}' == 'MANUFACTURER') {
            //     var agree_records = $(agree_ds).getAll();
            //     for (var i = 0; i < agree_records.length; i++) {
            //         if (agree_records[i].get('enabled_flag') === 'Y') {
            //             agree_num++;
            //         }
            //     }
            //     if (agree_num === 0) {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         Leaf.showMessage('${l:PROMPT_MESSAGE}', "厂商框架协议必须维护一条启用信息！");
            //         return false;
            //     } else if (agree_num > 1) {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         Leaf.showMessage('${l:PROMPT_MESSAGE}', "厂商框架协议只能维护一条启用信息！");
            //         return false;
            //     }
            // }

            var incept_num=0;
            if ('${/parameter/@bp_type}' == 'MANUFACTURER') {
                var incept_ds_records = $(incept_ds_id).getAll();
                for (var i = 0; i < incept_ds_records.length; i++) {
                    if (incept_ds_records[i].get('enabled_flag') === 'Y') {
                        incept_num++;
                    }
                }
                if (incept_num === 0) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "起租规则必须维护一条启用信息！");
                    return false;
                } else if (incept_num > 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "起租规则只能维护一条启用信息！");
                    return false;
                }
            }

            var employee_num=0;
            if ('${/parameter/@bp_type}' == 'MANUFACTURER') {
            var employee_ds_records=$(employee_ds_id).getAll();
            for (var i = 0; i < employee_ds_records.length; i++) {
                if (employee_ds_records[i].get('primary_flag') == 'Y'&&employee_ds_records[i].get('enabled_flag') === 'Y') {
                    employee_num++;
                }
            }
            if (employee_num === 0) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "合作方必须维护一条主办项目经理！");
                return false;
            }else if (employee_num > 1) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "合作方只能维护一条主办项目经理！");
                return false;
            }}
            // var relation_num=0;
            // var relation_ds_records = $(relation_ds_id).getAll();
            // if ('${/parameter/@bp_type}' == 'MANAGEMENT_COMPANY') {
            //     for (var i = 0; i < relation_ds_records.length; i++) {
            //         if (relation_ds_records[i].get('relation_type') == 'MANUFACTURER'&&relation_ds_records[i].get('enabled_flag') === 'Y') {
            //             relation_num++;
            //         }
            //     }
            //     if (relation_num === 0) {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         Leaf.showMessage('${l:PROMPT_MESSAGE}', "伙伴关系必须维护一启用的条合作方信息！");
            //         return false;
            //     }
            // }
            var role_ds_id=get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var role_num=0;
            var role_relation_num=0;
            var role_ds_records = $(role_ds_id).getAll();
            for (var i = 0; i < role_ds_records.length; i++) {
                if (role_ds_records[i].get('bp_type') == 'VENDER'&&role_ds_records[i].get('enabled_flag') === 'Y') {
                    role_num++;
                }
            }
            if (role_num > 0) {
                for (var i = 0; i < relation_ds_records.length; i++) {
                    if (relation_ds_records[i].get('relation_type') == 'MANUFACTURER') {
                        role_relation_num++;
                    }
                }
                if (role_relation_num === 0) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${HLS.PROMPT}', '请在伙伴关系中维护所属合作方！');
                    return false;
                }
            }

            if ('${/parameter/@bp_class}' == 'ORG') {
                //登记注册号码校验
                var registration_num_type = basicRec.get('registration_num_type');
                var register_cert_num = basicRec.get('register_cert_num');
                if (registration_num_type == '07') {
                    if (!CheckSocialCreditCode(register_cert_num)) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage('提示', '统一社会信用代码有误，请重新输入！');
                        }
                        return false;
                    }
                }
                if (!is_regno_valid) {
                    if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码重复！");
                    }
                    return false;
                }
                //地址信息校验
                var addr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
                var addRec = $(addr_ds_id).getAll();
                var flag = 0;
                for (var u = 0; u < addRec.length; u++) {
                    var address_type = addRec[u].get('address_type');
                    if (address_type == 'REGISTERED_ADDRESS') {
                        flag++;
                    }
                }
                if (flag > 1) {
                    if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "同一个客户只能维护一个注册地址！");
                    }
                    return false;
                }


                if(swift){
                    var  length =getStringLength(swift);
                    if(length>11){
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "SWIFT BIC所填内容超过最大字符长度11，当前最大所输字符长度："+length);
                        return false;
                    }
                }


                if(overseas_customer_name){


                    var check_name_flag=  checkS(value);
                    if(check_name_flag=='Y'){
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "境外客户中文名称所填内容不能只为数字和字母");
                        return false;
                    }

                    var  length =getStringLength(overseas_customer_name);
                    if(length>100){
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "境外客户中文名称所填内容超过最大字符长度100，当前最大所输字符长度："+length);
                        return false;
                    }
                }

                if(business_scope){
                    var  length =getStringLength(business_scope);
                    if(length>3000){
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "经营范围所填内容超过最大字符长度3000，当前最大所输字符长度："+length);
                        return false;
                    }
                }




            }

            if ('${/parameter/@bp_class}' == 'NP') {
                //身份证校验
                if (id_type == 'ID_CARD') {
                    var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                    if (reg.test(id_card_no) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "证件号码格式错误!", null);
                        }
                        return false;
                    }
                }
                jQuery.ajax({
                    type: 'GET',
                    url: "${/request/@context_path}/hls/bp/master/validIdCardNo?bpId=" + bp_id + "&idCardNo=" + id_card_no,
                    async: false,
                    success: function (args) {
                        debugger
                        if (args.success) {
                            is_idno_valid = true;
                        } else {
                            is_idno_valid = false;
                        }
                    }
                });
                if (!is_idno_valid) {
                    if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "证件号码重复！");
                    }
                    return false;
                }
                //手机号校验
                var phone = basicRec.get('phone');
                // var spouseRec = $(spouse_ds_id).getCurrentRecord();
                var family_phone = basicRec.get('family_phone');
                var phoneCheck = /^[1][3,4,5,7,8,9][0-9]{9}$/;
                if (phone != null) {
                    if (phoneCheck.test(phone) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "基本信息中手机号格式错误!", null);
                        }
                        return false;
                    }
                }
                if (family_phone != null) {
                    if (phoneCheck.test(family_phone) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "配偶信息中配偶电话格式错误!", null);
                        }
                        return false;
                    }
                }
            }

            var role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var roleRecord = $(role_ds_id).getAll();
            for (var i = 0; i < roleRecord.length; i++) {
                if (roleRecord[i].get('primary_flag') != 'Y') {
                    roleRecord[i].set('bp_category', roleRecord[i].get('bp_type'));
                }
            }
            //关联人信息身份证校验
            var spouse_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_spouse');
            if (spouse_ds_id != null && spouse_ds_id != '' && $(spouse_ds_id).data.length != 0) {
                var spouseRecord = $(spouse_ds_id).getAll();
                for (var i = 0; i < spouseRecord.length; i++) {
                    if (spouseRecord[i].get('org_type') == 'ID_CARD') {
                        var org_num = spouseRecord[i].get('org_num');
                        var reg = /^[1-9]\d{5}(18|19|20|(3\d))\d{2}((0[1-9])|(1[0-2]))(([0-2][1-9])|10|20|30|31)\d{3}[0-9Xx]$/;
                        if (reg.test(org_num) === false) {
                            Leaf.showMessage("提示", "证件号码格式错误!", null);
                            return false;
                        }
                    }
                }
            }

            //提交前对商业伙伴角色校验
            var incept_rule_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_incept_rule');
            if (incept_rule_ds_id != null && incept_rule_ds_id != "") {
                var incept_rule_records = $(incept_rule_ds_id).getAll();
                if (incept_rule_records.length < 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "请至少维护一条起租规则信息！");
                    return false;
                }

                var incept_rule_type_tmp = incept_rule_records[0].get('incept_rule_type');
                for (var i = 0; i < incept_rule_records.length; i++) {
                    var incept_rule_record = incept_rule_records[i];
                    var incept_rule_type = incept_rule_record.get('incept_rule_type');
                    var fixed_day = incept_rule_record.get('fixed_day');
                    if (incept_rule_type == 'FIXED_DAY' && $L.isEmpty(fixed_day)) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "起租规则为固定日时，固定日必填！");
                        return false;
                    }
                    if (incept_rule_type_tmp != incept_rule_type) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "只允许存在一种起租规则！");
                        return false;
                    }
                }
            }
            return check_flag;
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            debugger
            if (name == 'attachment_detail' && record.get('bp_attachment_id')) {
                var link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('bp_attachment_id') + '\');">附件</a>';
            }
            if(name == 'agree_attach_link'){
                var link_function = 'upload_file1';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('agreement_id') + '\');">附件</a>';
            }
            if (name == 'internal_rating_detail') {
                var rating_link_function = 'internal_rating_detail_upload';
                return '<a href="javascript:window[\'' + rating_link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">附件</a>';
            }
            if(name == 'credit_notice' ){
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('financing_sub_id') + '\')">授信审批通知书</a>';
            }

            return value;
        };


        function open_notice_detail_win(ds_id, record_id ,financing_sub_id ){
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '授信审批通知书';
            param['function_code'] = 'BP100F1CREDIT';
            param['winid'] = 'bp_credit_notice_id';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            hls_doc_get_layout_code(param, 'bp_credit_credit_notice_link', ds_id, 'BP100F1');
        }



          function checkS(str) {
              // 判断字符串是否为数字和字母组合
              var zg = /^[0-9a-zA-Z]*$/;
              if (!zg.test(str)) {
                  return 'N';
              } else {
                  return 'Y';
              }
          }


        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            debugger
            var gbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'F_BASIC');
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            if ('${/parameter/@function_usage}' != 'QUERY') {
                if (gbm_ds_id == ds.id) {
                    if (record.get('ref_v01') == 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else if (record.get('ref_v01') == 'N') {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                }
            }
            if (base_ds_id == ds.id) {
                debugger
                if('${/parameter/@bp_type}' == 'MANUFACTURER'&&'${/parameter/@function_code}' == 'BP100F4'){
                    if (record.get('marital_status') =='MARRIED') {
                        record.getField('bp_name_sp').setRequired(true);
                        record.getField('id_type_sp').setRequired(true);
                        record.getField('id_type_sp_n').setRequired(true);
                        record.getField('id_card_no_sp').setRequired(true);
                        record.getField('gender_sp').setRequired(true);
                        record.getField('gender_sp_n').setRequired(true);
                    } else {
                        record.getField('bp_name_sp').setRequired(false);
                        record.getField('id_type_sp').setRequired(false);
                        record.getField('id_type_sp_n').setRequired(false);
                        record.getField('id_card_no_sp').setRequired(false);
                        record.getField('gender_sp').setRequired(false);
                        record.getField('gender_sp_n').setRequired(false);
                    }
                }
            }
        };
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            debugger;
            var gbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'F_BASIC');
            if ('${/parameter/@function_usage}' != 'QUERY') {
                if (gbm_ds_id == ds.id) {
                    if (record.get('ref_v01') == 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else if (record.get('ref_v01') == 'N') {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                    if (record.get('loan_card_num_flag') === 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                }
            }

            if(name=='relation_type'&&value!=''){
                if('MANUFACTURER'==value||'VENDER'==value){
                    record.set('bp_class','ORG');
                }else{
                    record.set('bp_class','NP');
                }
            }

            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var base_ds_id_record=$(base_ds_id).getCurrentRecord();
            var ds_bp_address = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            if (ds_bp_address == ds.id && value) {
                if (name == 'country' && value != '46') {
                    record.set('province', null);
                    record.set('city', null);
                    record.set('district', null);
                    record.set('province_n', null);
                    record.set('city_n', null);
                    record.set('district_n', null);
                }
            }
            if('${/parameter/@bp_type}' == 'MANUFACTURER'&&'${/parameter/@function_code}' == 'BP100F4'){
                if(base_ds_id_record.get('marital_status') =='MARRIED'){
                    record.getField('bp_name_sp').setRequired(true);
                    record.getField('id_type_sp').setRequired(true);
                    record.getField('id_type_sp_n').setRequired(true);
                    record.getField('id_card_no_sp').setRequired(true);
                    record.getField('gender_sp').setRequired(true);
                    record.getField('gender_sp_n').setRequired(true);
                }else{
                    record.getField('bp_name_sp').setRequired(false);
                    record.getField('id_type_sp').setRequired(false);
                    record.getField('id_type_sp_n').setRequired(false);
                    record.getField('id_card_no_sp').setRequired(false);
                    record.getField('gender_sp').setRequired(false);
                    record.getField('gender_sp_n').setRequired(false);
                }
            }

            if (base_ds_id == ds.id && value) {

                if(name == 'actual_class' ){
                    record.set('actual_type',null);
                    record.set('actual_type_n',null);
                }
                if(name=='register_cert_num'){
                    record.set('social_credit_code',record.get('register_cert_num'));

                }

                var actualClass = record.get('actual_class');

                if (name == 'group_customers' && value == 'N') {
                    record.set('group_membership', '');

                }
                if (name == 'ref_v01' && value == 'N') {
                    record.set('loan_card_num', '');
                }

                //自然人
                if ('${/parameter/@bp_class}' == 'NP') {
                    //身份证号带出日期，年龄
                    if (name == 'id_card_no') {
                        var id_type = record.get('id_type');
                        if (id_type == 'ID_CARD') {
                            GetAge(value);
                            record.set('date_of_birth', setBirthDate);
                            record.set('age', setAge);
                        }
                    }
                    if (name == 'id_type' && value == 'ID_CARD') {
                        var id_card_no = record.get('id_card_no');
                        if (id_card_no) {
                            GetAge(id_card_no);
                            record.set('date_of_birth', setBirthDate);
                            record.set('age', setAge);
                        }
                    }
                }
            }
        };


        // 取出每条记录的data组成数组传到后台
        function records_handle(record) {
            var new_record = [];
            record.forEach(function (e) {
                new_record.push(e.data);
            });
            return new_record
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
