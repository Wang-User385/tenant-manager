<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.bp.service.HlsCusBpMasterService.queryCreatedName"
                       rootPath="user_name_query"/>
    </a:init-procedure>
    <a:view>
        <a:link id="hls214N_cdd_uploadFile_id" url="${/request/@context_path}/uploadFile.lview"/>
        <a:link id="hls214N_cdd_downloadFile_id" url="${/request/@context_path}/downloadFile.lview"/>
        <script><![CDATA[

        //天眼查
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            debugger;
            var hls_bp_master_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var record = $(hls_bp_master_ds_id).getCurrentRecord();
            //var bp_name = record.data.bp_name;
            var param = {};
            var register_cert_num = record.data.register_cert_num;
            var bp_id  = record.data.bp_id;
            param['bp_id'] = record.data.bp_id;
            param['bp_name'] = record.data.bp_name;
            //param['sky_type'] = "insert";
            param['bp_code'] = record.data.bp_code;
            param['register_cert_num'] = record.data.register_cert_num;
            var skyStatus = record.data.sky_status;
            if(bp_id){
                if(skyStatus=='Y'){
                    Leaf.showInfoMessage("提示", "已经天眼查询过了，请勿重复查询!", null);
                    return ;
                }else{
                    Leaf.Masker.mask(Ext.getBody(), '正在查询，请稍等...');
                    Leaf.request({
                        url: "${/request/@context_path}/hls/bp/master/queryBySky",
                        para:param ,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            debugger;
                            console.log(res);
                            console.log(res.result.record[0].bp_id);
                            Leaf.Masker.unmask(Ext.getBody());
                            if (res.success) {
                                Leaf.showInfoMessage("提示", "查询成功!", function () {
                                    $(hls_bp_master_ds_id).setQueryParameter('bp_id', bp_id);
                                    $(hls_bp_master_ds_id).query();
                                });
                            }
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        scope: this
                    });
                }
            }else{
                Leaf.showErrorMessage('提示', '请先保存再进行天眼查！', null, 200, 100);
            }

        }
        //BP_SCALE_TEMPLATE 附件下载
        window['${/parameter/@layout_code}_user_button7_layout_dynamic_click'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/sys/template/query",
                para: {template_code : 'BP_SCALE_TEMPLATE' },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    console.log(res);
                    var attachment_id = res.result.record[0].attachment_id;
                    if(attachment_id == 'undefined'  || attachment_id == '' || attachment_id == null){
                        Leaf.showInfoMessage('未找到模板!');
                        return ;
                    }else{
                        var down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                        location.href = down_url;
                    }
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var root_ds = $('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            window['${/parameter/@layout_code}_ignore_required_before_save']();
            if (root_ds.validate()) {
                var winid = '${/parameter/@winid}';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@layout_code}');

                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE() {
                    root_ds.un('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if (!flag) {
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION() {
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds, root_record, res);
                    if (typeof (nextStep) == 'function') {
                        nextStep(ds);
                    }
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                root_ds.on('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);

                root_ds.submit();

            } else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        }


        function combin(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    // a[i] = b[i]
                    record.set(i, data[i]);
                }
            }
        }

        function internal_rating_detail_upload(record_id, ds_id) {
            // debugger;
            var record = $(ds_id).findById(record_id),
                credit_rate_id = record.get('credit_rate_id');
            if (!credit_rate_id) {
                Leaf.showErrorMessage('提示', '请先保存再上传附件！', null, 200, 100);
                return;
            }
            // console.log(record.get('issue_info_id'));
            new Leaf.Window({
                id: 'open_attachment_win_id',
                url: '${/request/@context_path}/uploadFile.lview',
                params: {
                    header_id: credit_rate_id,
                    table_name: 'HLS_BP_CREDIT_RATE',
                    winid: 'open_attachment_win_id'
                },
                title: '附件上传',
                width: 500,
                height: 300
            });
        }

        function bp_name_valite(bp_name) {
            var bp_id = -1;
            Leaf.request({
                url: "${/request/@context_path}/hls/bp/master/org/bpName/valid?bpId=" + bp_id + "&bpName=" + bp_name + "&selectFlag=N",
                success: function (res) {
                    // console.log(res);
                    // alert("测试1" + res.error.message);
                    // alert("测试1"+res.success);
                    is_name_valid = res.error.message;

                },
                sync: true,
                scope: this
            });
        }

        function set_authority_rule_string() {
            Leaf.request({
                url: "${/request/@context_path}/hls/bp/master/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        }

        var setAge;

        var setBirthDate;

        function GetAge(identityCard) {

            var len = (identityCard + "").length;
            if (len == 0) {
                return 0;
            } else {
                if ((len != 15) && (len != 18))//身份证号码只能为15位或18位其它不合法
                {
                    return 0;
                }
            }
            var strBirthday = "";
            if (len == 18)//处理18位的身份证号码从号码中得到生日和性别代码
            {
                strBirthday = identityCard.substr(6, 4) + "/" + identityCard.substr(10, 2) + "/" + identityCard.substr(12, 2);
            }
            if (len == 15) {
                strBirthday = "19" + identityCard.substr(6, 2) + "/" + identityCard.substr(8, 2) + "/" + identityCard.substr(10, 2);
            }
            //时间字符串里，必须是"/"
            var birthDate = new Date(strBirthday);
            setBirthDate = birthDate;

            var nowDateTime = new Date();
            var age = nowDateTime.getFullYear() - birthDate.getFullYear();
            //再考虑月、天的因素;.getMonth()获取的是从0开始的，这里进行比较，不需要加1
            if (nowDateTime.getMonth() < birthDate.getMonth() || (nowDateTime.getMonth() == birthDate.getMonth() && nowDateTime.getDate() < birthDate.getDate())) {
                age--;
            }
            setAge = age;
        }

        window['upload_file'] = function (record_id, bp_attachment_id, table) {
            var tableName = 'HLS_BP_ATTACHMENT';
            if (table) {
                tableName = table;
            }
            var ds_id = "${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds";
            var base_record = $(ds_id).getCurrentRecord();
            var bp_id = base_record.get('bp_id');
            if (bp_id == null) {
                $L.showInfoMessage("提示", "请先保存客户信息再上传附件!");
                return;
            }
            if (bp_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'bp100_open_attachment_winid',
                url: url,
                params: {
                    'header_id': bp_attachment_id,
                    'table_name': tableName,
                    winid: 'bp100_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var document_list_ds_id = "${/parameter/@layout_code}_G_ATTACHMENT_hls_bp_attachment_ds";
                $(document_list_ds_id).query();
            });
        };

        window['upload_file1'] = function (record_id, agreement_id, table) {
            debugger
            var tableName = 'HLS_BP_MASTER_AGREEMENT';
            if (table) {
                tableName = table;
            }
            var ds_id = "${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds";
            var base_record = $(ds_id).getCurrentRecord();
            var bp_id = base_record.get('bp_id');
            if (bp_id == null) {
                $L.showInfoMessage("提示", "请先保存客户信息再上传附件!");
                return;
            }
            if (agreement_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'bp100_open_attachment_winid',
                url: url,
                params: {
                    'header_id': agreement_id,
                    'table_name': tableName,
                    winid: 'bp100_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var attachment_list_ds_id="${/parameter/@layout_code}_G_AGREEMENT_hls_bp_master_agreement_ds"
                $(attachment_list_ds_id).query();
            });
        };

        var is_regno_valid = true;
        var is_idno_valid = true;

        Leaf.onReady(function () {
            debugger;
            var hls_bp_master_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var hls_bp_master_record = $(hls_bp_master_ds_id).getCurrentRecord();

            if(hls_bp_master_record.get('registered_address')!=undefined&&hls_bp_master_record.get('contact_information_enterprise')!=undefined){
                hls_bp_master_record.set('invoice_bp_address_phone_num',hls_bp_master_record.get('registered_address')+';'+hls_bp_master_record.get('contact_information_enterprise'));
            }
            hls_bp_master_record.set('invoice_title',hls_bp_master_record.get('bp_name'));


            var base_ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var address_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');


            var base_record = $(base_ds_id).getCurrentRecord();
            base_record.set('registration_num_type', '07');
            base_record.set('registration_num_type_n', '统一社会信用代码');
            base_record.set('customer_type', 'DOMESTIC_CUSTOMERS');
            base_record.set('customer_type_n', '境内客户');

            if (ds_id && '${/parameter/@default_value_dsid}') {
                var head_record = $('${/parameter/@default_value_dsid}').getCurrentRecord();
                var bp_master_role_ds = $(ds_id);
                var record = new Leaf.Record({
                    'primary_flag': 'Y',
                    'bp_category': head_record.get('bp_type'),
                    'bp_category_n': head_record.get('bp_type_n'),
                    'bp_type': head_record.get('bp_type'),
                    'bp_type_n': head_record.get('bp_type_n'),
                    'enabled_flag': 'Y'
                });
                bp_master_role_ds.add(record);
                var current_record = bp_master_role_ds.getAt(0);
                current_record.getField('bp_type_n').setReadOnly(true);
                current_record.getField('enabled_flag').setReadOnly(true);
            }

            if ("Y" == '${/parameter/@ecif_flag}') {
                var rgstrtn_cty_and_dstc_cd_c = '${/parameter/@rgstrtn_cty_and_dstc_cd_c}';
                var rgstrtn_cty_and_dstc_cd_n = '${/parameter/@rgstrtn_cty_and_dstc_cd_n}';

                var bp_master_address_ds = $(address_ds_id);
                var record = new Leaf.Record({
                    'address_type': 'REGISTERED_ADDRESS',
                    'address_type_n': '住所地（注册地址）',
                    'country': rgstrtn_cty_and_dstc_cd_c,
                    'country_n': rgstrtn_cty_and_dstc_cd_n,
                    'enabled_flag': 'Y'
                });
                bp_master_address_ds.add(record);
            } else {
                var bp_master_address_ds = $(address_ds_id);
                var record = new Leaf.Record({
                    'address_type': 'REGISTERED_ADDRESS',
                    'address_type_n': '住所地（注册地址）',
                    'country': '46',
                    'country_n': '中国',
                    'enabled_flag': 'Y'
                });
                if(hls_bp_master_ds_id=='BP100F1_F_BASIC_hls_bp_master_ds'){
                    bp_master_address_ds.add(record);
                    var hls_bp_master_relation_ds=$(relation_ds_id);
                    if('DEALER'=='${/parameter/@bp_type}'||'VENDER'=='${/parameter/@bp_type}'||'MANAGEMENT_COMPANY'=='${/parameter/@bp_type}'){
                        var record1 = new Leaf.Record({
                            'enabled_flag': 'Y'
                        })
                        hls_bp_master_relation_ds.add(record1);
                    }
                }
            }

            //

            //校验组织机构代码
            if ('${/parameter/@bp_class}' == 'ORG') {
                if ($('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_REGISTER_CERT_NUM')) {
                    $('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_REGISTER_CERT_NUM').addListener('change', function (component, value, oldValue) {
                        var bp_id = -1;
                        var reg_number = null;

                        var parent_ds = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds');
                        if (parent_ds.getCurrentRecord().get('bp_class') == "NP") {
                            is_regno_valid = true;
                            return;
                        }
                        reg_number = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds').getCurrentRecord().get('register_cert_num');
                        if (!reg_number) {
                            is_regno_valid = true;
                            return;
                        }
                        if (parent_ds.getCurrentRecord().get('bp_id')) {
                            bp_id = parent_ds.getCurrentRecord().get('bp_id');
                        }
                        jQuery.ajax({
                            type: 'GET',
                            url: "${/request/@context_path}/hls/bp/master/validRegNumber?bpId=" + bp_id + "&regNumber=" + reg_number,
                            async: false,
                            success: function (args) {
                                // alert(args);
                                if (args.success) {
                                    is_regno_valid = true;
                                } else {
                                    is_regno_valid = true;
                                }
                            }
                        });
                    });
                }
            }

            //校验身份证重复性
            if ('${/parameter/@bp_class}' == 'NP') {
                if ($('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_ID_CARD_NO')) {
                    $('${/parameter/@layout_code}_F_BASIC_HLS_BP_MASTER_ID_CARD_NO').addListener('change', function (component, value, oldValue) {
                        var bp_id = -1;
                        var id_card_no = null;

                        var parent_ds = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds');
                        if (parent_ds.getCurrentRecord().get('bp_class') == "ORG") {
                            is_idno_valid = true;
                            return;
                        }
                        if (parent_ds.getCurrentRecord().get('id_type') != "ID_CARD") {
                            is_idno_valid = true;
                            return;
                        }
                        id_card_no = $('${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds').getCurrentRecord().get('id_card_no');
                        if (!id_card_no) {
                            is_idno_valid = true;
                            return;
                        }
                        if (parent_ds.getCurrentRecord().get('bp_id')) {
                            bp_id = parent_ds.getCurrentRecord().get('bp_id');
                        }
                        jQuery.ajax({
                            type: 'GET',
                            url: "${/request/@context_path}/hls/bp/master/validIdCardNo?bpId=" + bp_id + "&idCardNo=" + id_card_no,
                            async: false,
                            success: function (args) {
                                // alert(args);
                                if (!args.success) {
                                    is_idno_valid = true;
                                } else {
                                    is_idno_valid = true;
                                }
                            }
                        });
                    });
                }
            }

            if ('${/parameter/@bp_class}' == 'ORG') {
                var actualTypeDs = $('${/parameter/@layout_code}_F_ACTUAL_actual_type_combobox_ds');
                actualTypeDs.setQueryParameter('column_name', 'actual_type');
                actualTypeDs.setQueryParameter('tab_code', 'F_ACTUAL');
                actualTypeDs.setQueryParameter('layout_code', 'BP100F1');
                actualTypeDs.query();
            }
            //控制主角色不能删除
            $('${/parameter/@layout_code}_G_ROLE_hls_bp_master_role_ds').on('beforeremove', function (ds, records) {
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get('primary_flag') == 'Y') {
                        Leaf.showMessage("提示", "主角色无法删除!", null);
                        return false;
                    }
                }
            });
        });
        var isFlag=false;
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_beforecreate'] = function (ds, record, config_records, bp_seq) {
            var parentRecord = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master')).getAt(0);
            if (parentRecord.get('bp_id')) {
                isFlag=true;
                return true;
            } else {
                Leaf.showMessage("提示", "请先保存商业伙伴基本信息!", null);
                return false;
            }
        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            debugger;
            // var base_ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var base_ds_id_record=$(base_ds_id).getCurrentRecord();
            // var spouse_ds_id = '${/parameter/@layout_code}_F_SPOUSE_hls_bp_master_ds';
            // var company_ds_id = '${/parameter/@layout_code}_F_COMPANY_hls_bp_master_ds';
            var billing_ds_id = '${/parameter/@layout_code}_F_BILLING_hls_bp_master_ds';
            var ds_bp_address = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');

            var gbm_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master', 'F_BASIC');
            if ('${/parameter/@function_usage}' != 'QUERY') {
                if (gbm_ds_id == ds.id) {
                    if (record.get('ref_v01') == 'Y') {
                        record.getField('loan_card_num').setReadOnly(false);
                        record.getField('loan_card_num').setRequired(true);
                    } else if (record.get('ref_v01') == 'N') {
                        record.getField('loan_card_num').setReadOnly(true);
                        record.getField('loan_card_num').setRequired(false);
                    }
                }
            }
            if(base_ds_id==ds.id){

            if(base_ds_id_record.get('marital_status') =='MARRIED'){
                record.getField('bp_name_sp').setRequired(true);
                record.getField('id_type_sp').setRequired(true);
                record.getField('id_type_sp_n').setRequired(true);
                record.getField('id_card_no_sp').setRequired(true);
                record.getField('gender_sp').setRequired(true);
                record.getField('gender_sp_n').setRequired(true);
            }else{
                record.getField('bp_name_sp').setRequired(false);
                record.getField('id_type_sp').setRequired(false);
                record.getField('id_type_sp_n').setRequired(false);
                record.getField('id_card_no_sp').setRequired(false);
                record.getField('gender_sp').setRequired(false);
                record.getField('gender_sp_n').setRequired(false);
            }}

            if (base_ds_id == ds.id && value) {
                if (name == 'actual_class') {
                    //debugger;
                    var actualClass = record.get('actual_class');
                    var actual_ds = $("${/parameter/@layout_code}_F_ACTUAL_actual_type_combobox_ds");
                    actual_ds.originData = actual_ds.originData || actual_ds.data;
                    if (actualClass == 'NATIONAL_PERSON') {
                        actual_ds.filterData = actual_ds.originData.filter(function (record) {
                            return record.data.value_code == "Z09" || record.data.value_code == "Z10" || record.data.value_code == "Z11" || record.data.value_code == "Z12"
                        });
                    } else {
                        actual_ds.filterData = actual_ds.originData.filter(function (record) {
                            return record.data.value_code != "Z09" && record.data.value_code != "Z10" && record.data.value_code != "Z11" && record.data.value_code != "Z12"
                        });
                    }
                    actual_ds.addListener('beforeload', function () {
                        this.originData = this.originData || this.data;
                        this.data = this.filterData || this.data;
                    });
                }

                if (name == 'register_cert_num') {
                    // var baseRecord = $(base_ds_id).getCurrentRecord();
                    if (record.get('registration_num_type') == '07') {
                        var billingRec = $(billing_ds_id).getCurrentRecord();
                        billingRec.set('social_credit_code', value);
                    }
                }

                if (name == 'registration_num_type') {
                    if (value == '07') {
                        var register_cert_num = $(base_ds_id).getCurrentRecord().get('register_cert_num');
                        // $(billing_ds_id).getCurrentRecord().set('social_credit_code', register_cert_num);
                    }
                }
                if ('${/parameter/@bp_class}' == 'NP') {
                    //身份证号带出日期，年龄
                    if (name == 'id_card_no') {
                        var id_type = record.get('id_type');
                        if (id_type == 'ID_CARD') {
                            var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                            if (reg.test(value) === false) {
                                // Leaf.showMessage("提示", "证件号码格式错误!", null);
                                return false;
                            }
                            GetAge(value);
                            record.set('date_of_birth', setBirthDate);
                            record.set('age', setAge);
                        }
                    }
                    if (name == 'id_type' && value == 'ID_CARD') {
                        var id_card_no = record.get('id_card_no');
                        if (id_card_no) {
                            var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                            if (reg.test(id_card_no) === false) {
                                return false;
                            }
                            GetAge(id_card_no);
                            record.set('date_of_birth', setBirthDate);
                            record.set('age', setAge);
                        }
                    }
                }
            }

            //天眼查成功后 拼接 地址与电话   发票抬头（公司名称） 纳税人识别号 SOCIAL_CREDIT_CODE
            var basicRec = $(base_ds_id).getCurrentRecord();
            basicRec.set('invoice_title',basicRec.get('bp_name'));
            if(basicRec.get('registered_address')!=undefined&&basicRec.get('contact_information_enterprise')!=undefined) {
                basicRec.set('invoice_bp_address_phone_num',basicRec.get('registered_address')+';'+basicRec.get('contact_information_enterprise'));
            }

        };

