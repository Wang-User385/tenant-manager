                record.set('customer_name',base_record.get('bp_name'));
            }
            debugger
            if(relation_ds_id==ds.id){
                if(base_ds_id=='BP100F4_F_BASIC_hls_bp_master_ds'){
                    if('DEALER'=='${/parameter/@bp_type}'||'VENDER'=='${/parameter/@bp_type}'||'MANAGEMENT_COMPANY'=='${/parameter/@bp_type}'){
                        record.set('enabled_flag','Y');
                    }
                }
            }
        };

