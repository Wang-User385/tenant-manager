                } else if ('${/parameter/@bp_class}' == 'NP') {
                    $(ds_id).getCurrentRecord().set('nationality_n', '中国');
                    $(ds_id).getCurrentRecord().set('nationality', '46');
                }

            } else if (bill_ds_id == ds.id) {
