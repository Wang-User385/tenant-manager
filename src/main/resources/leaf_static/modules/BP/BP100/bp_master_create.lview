            //         Leaf.showMessage('${l:PROMPT_MESSAGE}', "厂商框架协议只能维护一条启用信息！");
            //         return false;
            //     }
            // }

            var relation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_relation');
            var relation_num=0;
            var relation_ds_records = $(relation_ds_id).getAll();
            if ('${/parameter/@bp_type}' == 'MANAGEMENT_COMPANY') {
                for (var i = 0; i < relation_ds_records.length; i++) {
                    if (relation_ds_records[i].get('relation_type') == 'MANUFACTURER'&&relation_ds_records[i].get('enabled_flag') === 'Y') {
                        relation_num++;
                    }
                }
                if (relation_num === 0) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "伙伴关系必须维护一条启用的归属合作方信息！");
