        var is_name_valid = 'true';

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            debugger
            // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var check_flag = true;
            // var ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            // var spouse_ds_id = '${/parameter/@layout_code}_F_SPOUSE_hls_bp_master_ds';
            var basicRec = $(ds_id).getCurrentRecord();
            var id_card_no = basicRec.get('id_card_no');
            var id_type = basicRec.get('id_type');
            var bp_name = basicRec.get('bp_name');
            var ageRec = basicRec.get('age');
            if ('${/parameter/@bp_class}' == 'ORG') {
                //客户名称重复性
                if (!basicRec.get('bp_id')) {
                    bp_name_valite(bp_name);
                    // alert("测试2" + is_name_valid);
                    if (is_name_valid == 'false') {
                        if (ds_id == ds.id) {
                            Leaf.showMessage('${l:PROMPT_MESSAGE}', "法人客户名称重复！");
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }

                //登记注册号码校验
                var registration_num_type = basicRec.get('registration_num_type');
                var register_cert_num = basicRec.get('register_cert_num');
                if (registration_num_type == '07') {
                    if (!CheckSocialCreditCode(register_cert_num)) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage('提示', '统一社会信用代码有误，请重新输入！');
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                    checkCreditCode();
                    if (!is_regno_valid) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage('${l:PROMPT_MESSAGE}', "登记注册号码重复！");
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }

                //地址信息校验
                var addr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_address');
                var addRec = $(addr_ds_id).getAll();
                var flag = 0;
                for (var u = 0; u < addRec.length; u++) {
                    var address_type = addRec[u].get('address_type');
                    if (address_type == 'REGISTERED_ADDRESS') {
                        flag++;
                    }
                }
                if (flag > 1) {
                    if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "同一个客户只能维护一个注册地址！");
                    }
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
            }

            if ('${/parameter/@bp_class}' == 'NP') {
                //身份证校验
                if (id_type == 'ID_CARD') {
                    var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
                    if (reg.test(id_card_no) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "证件号码格式错误!", null);
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }
                //创建时首次保存不会校验身份证号
                checkIdCardNo();
                if (!is_idno_valid) {
                    if (ds_id == ds.id) {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "身份证号重复！");
                    }
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                }
                //手机号校验
                var phone = basicRec.get('phone');
                var family_phone = basicRec.get('family_phone');
                var phoneCheck = /^[1][3,4,5,7,8,9][0-9]{9}$/;
                if(phone != null){
                    if (phoneCheck.test(phone) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "基本信息中手机号格式错误!", null);
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }
                if (family_phone != null) {
                    if (phoneCheck.test(family_phone) === false) {
                        if (ds_id == ds.id) {
                            Leaf.showMessage("提示", "配偶信息中配偶电话格式错误!", null);
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }
            }


            var role_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_role');
            var roleRecord = $(role_ds_id).getAll();
            for (var i = 0; i < roleRecord.length; i++) {
                if (roleRecord[i].get('primary_flag') != 'Y') {
                    roleRecord[i].set('bp_category', roleRecord[i].get('bp_type'));
                }
            }

            set_authority_rule_string();

            if (record.get('bp_code')) {
                return true;
            }
            if (ds_id == ds.id) {
                var documentCategory = 'HLS_BP_MASTER';
                var documentType = 'BP';
                var businessType = 'BP';

                Leaf.request({
                    url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + documentCategory
                        + "&documentType=" + documentType + "&businessType=" + businessType,
                    success: function (res) {
                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                        $(ds_id).getCurrentRecord().set('bp_code', res.result.record[0]);
                        check_flag = true;
                    },
                    error: function (res) {
                        console.log(res);
                        record.set('bp_code', res.result.record[0]);
                        // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        console.log(res);
                        record.set('bp_code', res.result.record[0]);
                        // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }

            // debugger;
            var dataObj = $('${/parameter/@layout_code}_virtual_ds').getCurrentRecord().data;
            var base_ds_id = '${/parameter/@layout_code}_F_BASIC_hls_bp_master_ds';
            var records = $(base_ds_id).getCurrentRecord();
            records.set('company_id', '${/session/@companyId}');

            if (dataObj['${/parameter/@layout_code}_F_BILLING_hls_bp_master']) {
                var billing_ds_id = '${/parameter/@layout_code}_F_BILLING_hls_bp_master_ds';
                var hlsCusBpMasterBilling = $(billing_ds_id).getCurrentRecord().data;
                combin(records, hlsCusBpMasterBilling);
                delete dataObj['${/parameter/@layout_code}_F_BILLING_hls_bp_master'];
            }

            return check_flag;
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
