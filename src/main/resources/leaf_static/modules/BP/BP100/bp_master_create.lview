                    return false;
                } else if (incept_num > 1) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('${l:PROMPT_MESSAGE}', "起租规则只能维护一条启用信息！");
                    return false;
                }
            }
            var employee_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_employee');
            var employee_num=0;
