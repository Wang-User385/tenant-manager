<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ecif_change_detail_link_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_ecif_change.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_ecif_change_detail_function';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'version_detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '明细信息' + '</a>';
            }
        };


        function open_ecif_change_detail_function(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '客户变更信息';
            param['function_code'] = 'BP100F101';
            param['winid'] = 'ecif_change_detail_winid';

            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'ecif_change_detail_link_id', ds_id, 'BP100F101');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
