<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="V100_bp_visit_modify_id"
                url="${/request/@context_path}/modules/visit/V100/jc_bp_visit_interview.lview"/>
        <a:link id="finance_report_detail_link_id"
                url="${/request/@context_path}/modules/BP/BP100/financial_report_import_entrance.lview"/>
        <script><![CDATA[



        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_name' && value) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            // else if (name == 'visit_information' && value) {
            //     return '<a href="javascript:open_visit_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">拜访明细</a>';
            // }
            return value;
        };


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq){
            ds.setQueryParameter('created_by','${/session/@user_id}')
            if('${/parameter/@bp_name}'){
                switch (ds.id) {
                    case '${/parameter/@layout_code}_G_QUERY_RESULT_hls_bp_master_ds':
                        qpara['bp_name'] = '${/parameter/@bp_name}';
                        break;
                }

            }

        }


        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            debugger
            param['url_title'] = '客户信息维护';
            if (param['bp_class'] == 'ORG') {
                if(param['bp_type']=='VENDER' || param['bp_type']=='DEALER'){
                    param['function_code'] = 'PRJ320_LS_F1';
                }else{
                param['function_code'] = 'BP100F1';}
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';

            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
        }

        //财报导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_code = record.get('bp_code');
            var bp_name = record.get('bp_name');
            var param = {};
            param['url_title'] = '财务报表导入';
            param['function_code'] = 'FRI001';
            param['winid'] = 'financing_report_detail_winid';
            param['ds_id'] = ds_id;
            param['bp_master_code'] = bp_code;
            param['bp_master_name'] = bp_name;
            param['bp_id'] = bp_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'finance_report_detail_link_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'BP100F2');


            /*   new Leaf.Window({
                   id:'bp100_excel_import_win_id',
                   params:{
                       bp_master_code:bp_code,
                       bp_master_name:bp_name,
                       bp_id:bp_id,
                       winid:'bp100_excel_import_win_id'
                   },
                   url:'${/request/@context_path}/modules/BP/BP100/financial_report_import_file.lview',
                   title:'财务报表导入',
                   fullScreen: false,
                   width:500,
                   height:480,
                   draggable: true
               });
               */


        };


        // 财务报表模板查看
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
            var record = $(ds_id).getCurrentRecord();
            var bp_id = record.get('bp_id');
            var bp_name = record.data['bp_name'];
            var bp_code = record.data['bp_code'];
            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    winid: 'hls_bp_master_financial_info_winid'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 950,
                height: 535,
                side: "right",
                draggable: true
            });
        };

        //拜访明细 维护入口
        // function open_visit_modify_win(ds_id, record_id) {
        //     var record = $(ds_id).findById(record_id);
        //     var param = record.data;
        //     param['url_title'] = '拜访明细';
        //     param['function_code'] = 'BP100V1';
        //
        //     // param['function_usage'] = 'QUERY';
        //     param['winid'] = 'bp_visit_modify_winid';
        //
        //     hls_doc_get_layout_code(param, 'V100_bp_visit_modify_id', ds_id, 'BP100');
        // }

        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            ocrImport();
        }
        function ocrImport(){
            jQuery("#flieLoad").click();
            jQuery("#flieLoad").off('change').change(function () {
                Leaf.Masker.mask(Ext.getBody(), '识别中。。');
                for (var i = 0; i < jQuery("#flieLoad").get(0).files.length; i++) {
                    var file = jQuery("#flieLoad").get(0).files[i];
                    if (file == undefined) {
                        continue;
                    }

                    var fileType = file.name;
                    var index= fileType.lastIndexOf(".");
                    var fileType = fileType.substr(index+1);
                    var url = "";
                    if(fileType=='pdf'){
                        url = '${/request/@context_path}/pdf/ocr/import';
                    }else{
                        url = '${/request/@context_path}/table/ocr/import';
                    }

                    var fileName = encodeURI(file.name);
                    var formData = new FormData();
                    formData.append("fileToUpload", file);  //上传一个files对象
                    formData.append("filename", fileName);  //上传一个files对象
                    formData.append("_csrf", "${/session/@_csrf.token}");
                    jQuery.ajax({
                        url: url,
                        dataType: "json",
                        type: "post",
                        data: formData,
                        async: false,
                        processData: false,//不去处理发送的数据
                        contentType: false,//不去设置Content-Type请求头
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showErrorMessage('提示', res.message);
                            return;
                        },
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            if(res.success == false){
                                Leaf.showErrorMessage('提示', res.message);
                            }else{
                                window.location.href = "${/request/@context_path}/ocr/attachment/package/download?fileName=" + res;
                            }
                            return;
                        }

                    })
                }
                Leaf.Masker.unmask(Ext.getBody());
            })
        }
        ]]></script>
        <input type="file" name="image" id="flieLoad" multiple="" accept="image/jpeg,image/jpg,image/png,image/svg,application/pdf" style="display:none"/>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
