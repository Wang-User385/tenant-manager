<!--
    $Author: zhuxianfei
    $Date: 2018-07-12 下午2:20:47
    $Revision: 1.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript"><![CDATA[

        // $L.onReady(function(){debugger;
        //     alert('${/parameter/@bp_master_code}');
        // });

        function saveClick() {
            debugger;
            if ($('label_ds').validate()) {
                var record = $('label_ds').data[0];
                debugger;
                var bpRecord = $('bp_master_ds').data[0];
                var fin_statement_templet_hd_id = bpRecord.data["fin_statement_templet_hd_id"];
                if (document.getElementById('importFile').value) {
                    var fileName = document.getElementById('importFile').value;
                    var fileType = fileName.substr(fileName.lastIndexOf("."));
                    if (fileType != '.xls' && fileType != '.xlsx') {
                        alert('${l:SELECT_CORRECT_IMPORT_FILE}');
                    } else {
                       /* if (fin_statement_templet_hd_id) {
                            Leaf.Masker.mask(Ext.getBody(), '正在导入。。');
                            var form = document.getElementById('importForm');
                            var url = form.action;
                            form.action = url + "&fin_statement_templet_hd_id=" + fin_statement_templet_hd_id;
                            document.getElementById('importForm').submit();
                        } else {
                            alert('请选择财务报表模板!');
                        }
*/
                        doSubmit(fin_statement_templet_hd_id);

                    }
                } else {
                    alert('${l:SELECT_CORRECT_IMPORT_FILE}');
                }
            }/*else{
                    Leaf.showMessage("提示","请选择财报模板");
                }*/
        }


        function hls_bp_master_unmask() {
            Leaf.Masker.unmask(Ext.getBody());
        }

        var _input_window;

        function doSubmit(fin_statement_templet_hd_id) {
           /* _input_window = new $L.Window({
                title: '${l:HLS.IMPORT}',
                width: 1000,
                height: 400
            });*/
            // new Ext.Template('<iframe id ="_input_window" name="_input_window" border="0" frameborder="0" height="100%"  width="100%"  style="border:none;padding:0px;margin:0px;"></iframe>').insertFirst(_input_window.body.dom, {}, true);
            var form = document.getElementById('importForm');
            var url = '${/request/@context_path}/modules/BP/BP100/financial_report_inport_file.lview?_csrf=${/session/@_csrf.token}&bp_id=${/parameter/@bp_id}&winid=${/parameter/@winid}&batch_id=${/parameter/@batch_id}';
            url += "&fin_statement_templet_hd_id=" + fin_statement_templet_hd_id;
            form.action = url;
            form.submit();
            $('${/parameter/@winid}').close();
            Leaf.Masker.mask(Ext.getBody(), '导入中，请稍候！');
        }

        function downfile() {

            var url = '${/request/@context_path}/downloadFile.lview';
            new Leaf.Window({
                id: 'bp_excel_import_winid',
                url: url,
                params: {
                    'header_id': -1,
                    'table_name': 'HLS_BP_ATTACHMENT',
                    winid: 'bp_excel_import_winid',
                    function_usage: 'QUERY'
                },
                title: '财务报表导入',
                width: 850,
                height: 400
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="bp_master_ds">
                <a:datas>
                    <a:record bp_master_code="${/parameter/@bp_master_code}"
                              bp_master_name="${/parameter/@bp_master_name}"
                              fin_statement_templet_hd_id = "${/parameter/@fin_statement_templet_hd_id}"
                              fin_statement_templet_name = "${/parameter/@fin_statement_templet_name}"
                              fin_statement_templet_code = "${/parameter/@fin_statement_templet_code}"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="label_ds" autoCreate="true">
                <a:fields>
                    <a:field name="label2" defaultValue="1、  严格按照导入模板整理数据，检查必输事项是否缺少数据。"/>
                    <a:field name="label3" defaultValue="2、  关闭Excel文件后，方可进行产品主数据导入。"/>
                    <a:field name="label4" defaultValue="3、  本导入程序只支持Office Excel。"/>
                    <a:field name="label5" defaultValue="仔细阅读上述事项，并检查确认无误。"/>
                    <a:field name="label6" defaultValue="导入完毕后，请在系统内核实数据是否导入成功。"/>
                    <a:field name="fin_statement_templet_name" autoComplete="true" lovGridHeight="300" lovHeight="510"
                             lovLabelWidth="100"
                             lovService="/fnd/FinStatement/lov/query~com.hand.hls.fnd.dto.LovHlsFinStatementTmpltHdDto"
                             lovWidth="600"
                             title="财务报表模板选择">
                        <a:mapping>
                            <a:map from="fin_statement_templet_code" to="fin_statement_templet_code"></a:map>
                            <a:map from="fin_statement_templet_name" to="fin_statement_templet_name"></a:map>
                            <a:map from="fin_statement_templet_hd_id" to="fin_statement_templet_hd_id"></a:map>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:fieldSet style="margin-left:10px;margin-top:10px;" title="PRJ501.BP_MASTER_INFO" width="400"
                    labelWidth="100">
            <a:textField name="bp_master_code" bindTarget="bp_master_ds" prompt="HLS.BP_CODE" readOnly="true"
                         width="160"/>
            <a:textField name="bp_master_name" bindTarget="bp_master_ds" prompt="HLS.BP_NAME" readOnly="true"
                         width="160"/>
            <a:lov name="fin_statement_templet_name" bindTarget="bp_master_ds" prompt="财务报表模板" width="160" readOnly="true"/>
        </a:fieldSet>
        <a:fieldSet style="margin-left:10px;margin-top:10px;" title="导入注意事项" width="400">
            <a:label name="label2" bindTarget="label_ds" style="margin-left:10px;" width="380"/>
            <a:label name="label3" bindTarget="label_ds" style="margin-left:10px;" width="380"/>
            <a:label name="label4" bindTarget="label_ds" style="margin-left:10px;" width="380"/>
            <a:label name="label5" bindTarget="label_ds" style="color:#055A78;font-weight:bold;margin-left:10px;" width="380"/>
            <a:label name="label6" bindTarget="label_ds" style="color:#055A78;font-weight:bold;margin-left:10px;" width="380"/>
        </a:fieldSet>
        <a:fieldSet style="margin-left:10px;margin-top:10px;" title="导入文件" width="400">
            <form name="upload" id="importForm"
                  enctype="multipart/form-data" method="post">
                <label style="margin-left:10px;margin-top:10px;"><![CDATA[请选择文件:]]></label>
                <input name="CONTENT" id="importFile" style="margin-bottom:4px;width:160px;height:22px;" type="file"/>
                <input onclick="saveClick()" style="margin-left:50px;margin-top:10px;width:60px;" type="button"
                       value="导入"/>
            </form>
        </a:fieldSet>
        <a:fieldSet style="margin-left:10px;margin-top:10px;" title="财务报表模板下载" width="400">
            <form name="upload" id="importForm"
                  action="${/request/@context_path}/modules/BP/BP100/financial_report_inport_file.lview?bp_id='${/parameter/@bp_id}'&amp;session_id=${/session/@session_id}&amp;batch_id=${/parameter/@batch_id}&amp;_csrf=${/session/@_csrf.token}"
                  enctype="multipart/form-data" method="post">
                <label style="margin-left:10px;margin-top:10px;"/>
                <input onclick="downfile()" style="margin-left:10px;margin-top:10px;width:60px;" type="button"
                       value="模板下载"/>
            </form>
        </a:fieldSet>

    </a:view>
</a:screen>
