<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <script><![CDATA[


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_ecif_bp_master_change');
            var record = $(ds_id).getCurrentRecord();
            var oprtn_ind=record.get('oprtn_ind_q');
            if(oprtn_ind=="1"){
                record.getField('cst_no_q').setRequired(true);
                record.getField('unifd_socl_crdt_cd_q').setRequired(false);
                record.getField('bp_name_q').setRequired(false);
                record.getField('inst_ident_tp_q').setRequired(false);
                record.getField('ident_no_q').setRequired(false);

//                record.set('unifd_socl_crdt_cd_q',null);
//                record.set('bp_name_q',null);
//                record.set('inst_ident_tp_q',null);
//                record.set('ident_no_q',null);

            }
            else if(oprtn_ind=="2"){
                record.getField('cst_no_q').setRequired(false);
                record.getField('unifd_socl_crdt_cd_q').setRequired(false);
                record.getField('bp_name_q').setRequired(true);
                record.getField('inst_ident_tp_q').setRequired(true);
                record.getField('ident_no_q').setRequired(true);


//                record.set('cst_no_q',null);
//                record.set('unifd_socl_crdt_cd_q',null);
            }
            else if(oprtn_ind=="3"){
                record.getField('cst_no_q').setRequired(false);
                record.getField('unifd_socl_crdt_cd_q').setRequired(true);
                record.getField('bp_name_q').setRequired(false);
                record.getField('inst_ident_tp_q').setRequired(false);
                record.getField('ident_no_q').setRequired(false);

//                record.set('cst_no_q',null);
//                record.set('bp_name_q',null);
//                record.set('inst_ident_tp_q',null);
//                record.set('ident_no_q',null);
            }
        };


        //单一客户查询
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_ecif_bp_master_change');
            var return_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_bp_master_request_records');
            var record = $(ds_id).getCurrentRecord();
            var oprtn_ind=record.get('oprtn_ind_q');
            var cst_no=record.get('cst_no_q');
            var unifd_socl_crdt_cd=record.get('unifd_socl_crdt_cd_q');
            var bp_name=record.get('bp_name_q');
            var ident_no=record.get('ident_no_q');
            var inst_ident_tp=record.get('inst_ident_tp_q');

            if(Ext.isEmpty(oprtn_ind)){
                Leaf.showMessage('提示',"查询方式必填！");
                return;
            }

            if(oprtn_ind=="1"){
                if(Ext.isEmpty(cst_no)){
                   Leaf.showMessage('提示',"ECIF客户编号必填！");
                   return;
                }
            }
            else if(oprtn_ind=="2"){
                if(Ext.isEmpty(bp_name)){
                    Leaf.showMessage('提示',"客户名称必填！");
                    return;
                }
                if(Ext.isEmpty(inst_ident_tp)){
                    Leaf.showMessage('提示',"证件类型必填！");
                    return;
                }
                if(Ext.isEmpty(ident_no)){
                    Leaf.showMessage('提示',"证件号码必填！");
                    return;
                }
            }
            else if(oprtn_ind=="3"){
                if(Ext.isEmpty(unifd_socl_crdt_cd)){
                    Leaf.showMessage('提示',"统一社会信用代码必填！");
                    return;
                }
            }


            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/hls/ws/ecif/single/query",
                para: {
                    oprtnInd:oprtn_ind,
                    cstNo:cst_no,
                    unifdSoclCrdtCd:unifd_socl_crdt_cd,
                    cstNmS:bp_name,
                    identNo:ident_no,
                    instIdentTp:inst_ident_tp
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var code=res.result.record[0].code;
                    var msg=res.result.record[0].msg;
                    var bp_record_id=res.result.record[0].bp_record_id;
                    msg = msg.replace(/\s+/g,"");

                    Leaf.showMessage('提示',msg);
                    if(!Ext.isEmpty(bp_record_id)){
                        $(return_ds_id).setQueryParameter('bp_record_id', bp_record_id);
                        $(return_ds_id).query();
                    }
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };


        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            //根据证件类型+证件号码 去唯一匹配系统中已存在的客户 如果存在直接覆盖
            //如果不存在跳转到创建页面再进行客户的创建
            var return_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_bp_master_request_records');
            var record = $(return_ds_id).getCurrentRecord();
            var bp_id=record.get('bp_id');
            var bp_record_id=record.get('bp_record_id');
            var param = {};
            param = record.data;
            param['winid']='bp100_bp_create_ecif_win_id';
            param['parent_winid']='bp100_bp_create_ecif_win_id';
            param['ecif_flag']='Y';
            if(bp_id){
                Leaf.request({
                    url: "${/request/@context_path}/hls/ws/ecif/signal/update",
                    para: {
                        bp_id:bp_id,
                        bp_record_id:bp_record_id
                    },
                    success: function (res) {
                        Leaf.showMessage('提示','客户信息更新成功！');
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });

            }
            else{
                var win = new Leaf.Window({
                    id: 'bp100_bp_create_ecif_win_id',
                    url: "${/request/@context_path}/modules/BP/BP100/bp_master_select.lview",
                    params: param,
                    title: '客户信息创建',
                    fullScreen: true
                });
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
