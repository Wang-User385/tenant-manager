<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>
        <link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet"
              type="text/css"/>
        <script><![CDATA[
        function render_sys_resource_ds_grid(value, record, name) {
            debugger;
            if (!record.isNew) {
                if (name == 'anaysis_detail') {
                    return '<a href="javascript:winOpen_access_component_period(\'' + record.get('fin_statement_hd_id') + '\',\'' + record.get('report_year') + '\');">报表明细</a>';
                }

                return '';
            }
            return '';
        }

        <!--打开窗口：报表分期明细-->
        function winOpen_access_component_period(id,report_year) {
            new Leaf.Window({
                id: 'sys_resource_access_component_period_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info_detail.lview',
                params: {
                    fin_statement_hd_id: id,
                    report_year:report_year,
                    winId: "sys_resource_access_component_preiod_winId"
                },
                title: '报表明细',
                width:830,
                height:535,
                side:"right",
                draggable: true
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="fiscal_year_ds">
                <a:datas>
                    <a:record fiscal_year="${/parameter/@fiscal_year}"/>
                </a:datas>
            </a:dataSet>


            <a:dataSet id="balance_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/hd/querybp?headerId=${/parameter/@header_id}">

            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:tabPanel width="800" height="600">
                <a:tabs>
                    <a:tab prompt="客户财报基本信息" width="185" selected="true"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="balance_sheet_grid" bindTarget="balance_sheet_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>
                                    <!--<a:column name="if_financial_company" width="70" align="center" prompt="是否为金融类企业"/>-->
                                    <a:column name="if_audit" width="70" align="center"  prompt="是否审计"/>
                                    <a:column name="audit_institution" width="120" align="center"  prompt="审计机构全名"/>
                                    <a:column name="audit_results" width="110" align="center" prompt="审计结果" />
<!--                                    <a:column name="if_approved_branch" width="200" align="center"  prompt="审计机构是否为分行认可"/>-->
                                    <a:column name="report_year" width="120" align="center"  prompt="报告年月"/>
                                    <a:column width="120" name="anaysis_detail" renderer="render_sys_resource_ds_grid" prompt="详情" align="center"/>
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>

                </a:tabs>
            </a:tabPanel>

        </a:screenBody>
    </a:view>
</a:screen>
