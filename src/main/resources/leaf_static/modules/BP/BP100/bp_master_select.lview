<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <a:link id="bp100_bp_master_create_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_create.lview"/>
        <script><![CDATA[

        var is_name_valid = true;

        Leaf.onReady(function () {
            if ('${/parameter/@ecif_flag}' == 'Y') {
                var ds_id = "hls_bp_create_ds";
                var record = $(ds_id).getCurrentRecord();
                record.set('bp_name', '${/parameter/@cst_nm_s}');

                record.set('bp_class_n', '法人');
                record.set('bp_class', 'ORG');
                record.getField('bp_name').setReadOnly(true);
                record.getField('bp_class').setReadOnly(true);
                record.getField('bp_class_n').setReadOnly(true);
            }
        });


        function hls_bp_create_ds_update(ds, record, name, value, oldValue) {
            debugger;
            if(name=='bp_type'&&value=='MANUFACTURER'){
                record.set('bp_class_n', '法人');
                record.set('bp_class', 'ORG');
            }
            if(name=='bp_type'&&value=='MANAGEMENTCOMPANY'){
                record.set('bp_class_n', '法人');
                record.set('bp_class', 'ORG');
            }
            if (name == 'bp_name') {
                var bp_id = -1;
                // debugger;
                var parent_ds = $('hls_bp_create_ds');
                if (!value) {
                    is_name_valid = true;
                    return;
                }
                jQuery.ajax({
                    type: 'GET',
                    url: "${/request/@context_path}/hls/bp/master/org/bpName/valid?bpId=" + bp_id + "&bpName=" + value + "&selectFlag=Y",
                    async: false,
                    success: function (args) {
                        // alert(args.success);
                        console.log(args);
                        if (!args.success) {
                            is_name_valid = false;
                        } else {
                            is_name_valid = true;
                        }
                    }
                });
            }
        }


        function bp100_bp_exit() {
            $('${/parameter/@parent_winid}').close();
            var ds_id = 'BP100_G_QUERY_RESULT_hls_bp_master_ds';
            $(ds_id).query();
        }

        function bp100_bp_create() {
            debugger;
            var ds = $('hls_bp_create_ds');
            if (ds.validate()) {
                var record = ds.getCurrentRecord();
                var bp_class = record.get('bp_class');
                var param = {};
                param['function_usage'] = 'CREATE';
                param['bp_type'] = record.get('bp_type');
                param['bp_type_n'] = record.get('bp_type_n');
                param['bp_class_n'] = record.get('bp_class_n');
                param['bp_class'] = bp_class;
                param['bp_name'] = record.get('bp_name');
                param['winid'] = 'bp_master_create_winid';
                param['parent_winid'] = '${/parameter/@parent_winid}';
                param['default_value_dsid'] = ds.id;
                param['url_title'] = '客户信息创建';

                if (!is_name_valid) {
                    if (bp_class && bp_class == 'ORG') {
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', "法人客户名称重复！");
                        return false;
                    }
                }

                if ('${/parameter/@ecif_flag}' == 'Y') {
                    //debugger;
                    //法人代表
                    param['lgl_rprs_nm'] = '${/parameter/@lgl_rprs_nm}';
                    //信用客户标志
                    param['crdt_cst_flg_c'] = '${/parameter/@crdt_cst_flg_c}';
                    param['crdt_cst_flg_n'] = '${/parameter/@crdt_cst_flg_n}';
                    //证件号码
                    param['ident_no'] = '${/parameter/@ident_no}';
                    //经营范围
                    param['corprtn_scop1'] = '${/parameter/@corprtn_scop1}';
                    //客户类型
                    param['cst_tp_c'] = '${/parameter/@cst_tp_c}';
                    param['cst_tp_n'] = '${/parameter/@cst_tp_n}';
                    //主要经营活动所在国家/地区
                    param['maincorprtnactvctyordstccd_c'] = '${/parameter/@maincorprtnactvctyordstccd_c}';
                    param['maincorprtnactvctyordstccd_n'] = '${/parameter/@maincorprtnactvctyordstccd_n}';
                    //国家和地区代码
                    param['rgstrtn_cty_and_dstc_cd_c'] = '${/parameter/@rgstrtn_cty_and_dstc_cd_c}';
                    param['rgstrtn_cty_and_dstc_cd_n'] = '${/parameter/@rgstrtn_cty_and_dstc_cd_n}';
                    //swiftno
                    param['swiftno'] = '${/parameter/@swiftno}';
                    //ecif客户编号
                    param['cst_no'] = '${/parameter/@cst_no}';
                    //证件类型
                    param['inst_ident_tp_c'] = '${/parameter/@inst_ident_tp_c}';
                    param['inst_ident_tp_n'] = '${/parameter/@inst_ident_tp_n}';
                    //境外中文名称
                    param['ovrs_cst_chin_nm'] = '${/parameter/@ovrs_cst_chin_nm}';
                    //机构客户类型
                    param['org_cust_type_c'] = '${/parameter/@org_cust_type_c}';
                    param['org_cust_type_n'] = '${/parameter/@org_cust_type_n}';
                    //行业
                    param['cst_lo_natl_std_idy_c'] = '${/parameter/@cst_lo_natl_std_idy_c}';
                    param['cst_lo_natl_std_idy_n'] = '${/parameter/@cst_lo_natl_std_idy_n}';
                    //企业隶属关系
                    param['entp_atch_rltnp_c'] = '${/parameter/@entp_atch_rltnp_c}';
                    param['entp_atch_rltnp_n'] = '${/parameter/@entp_atch_rltnp_n}';
                    //经济类型
                    param['ecnm_tp_c'] = '${/parameter/@ecnm_tp_c}';
                    param['ecnm_tp_n'] = '${/parameter/@ecnm_tp_n}';
                    //统一社会信用代码
                    param['unifd_socl_crdt_cd'] = '${/parameter/@unifd_socl_crdt_cd}';

                    param['ecif_flag'] = '${/parameter/@ecif_flag}';
                }

                if(param['bp_type']=='MANUFACTURER'){
                    param['function_code'] = 'BP100F4'
                }else{
                    if (param['bp_class'] == 'ORG') {
                        param['function_code'] = 'BP100F1';
                    } else {
                        param['function_code'] = 'BP100F2';
                    }
                }
                hls_doc_get_layout_code(param, 'bp100_bp_master_create_id', 'hls_bp_create_ds', 'BP100',param['parent_winid'], 'Y');
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="hls_bp_create_bp_class_ds" lookupCode="HLS211_BP_CLASS"/>
<!--            <a:dataSet id="hls_bp_create_bp_type_ds" lookupCode="BP.BP_MASTER_ROLE"/>-->
            <a:dataSet id="hls_bp_create_bp_type_ds">
                <a:datas>
                    <a:record name="承租人" code="TENANT"/>
                    <a:record name="联合承租人(次)" code="TENANT_SEC"/>
                    <a:record name="保证人" code="WARRANTOR"/>
                    <a:record name="抵质押人" code="MORTGAGOR_PLEGDOR"/>
                    <a:record name="供应商" code="VENDER"/>
                    <a:record name="资产转让方" code="ASSET_TRANSFEROR"/>
                    <a:record name="资产受让方" code="TRANSFEREE_ASSETS"/>
                    <a:record name="合作方" code="MANUFACTURER"/>
                    <a:record name="管理公司" code="MANAGEMENT_COMPANY"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="hls_bp_create_ds" autoCreate="true">
                <a:fields>
                    <a:field name="bp_type_n" options="hls_bp_create_bp_type_ds" displayField="name"
                             valueField="code" returnField="bp_type" required="true"/>
                    <a:field name="bp_type" required="true"/>
                    <a:field name="bp_class_n" options="hls_bp_create_bp_class_ds" displayField="code_value_name"
                             valueField="code_value" returnField="bp_class" required="true"/>
                    <a:field name="bp_name" required="true"/>
                </a:fields>
                <a:events>
                    <a:event name="update" handler="hls_bp_create_ds_update"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="bp100_bp_exit" text="退出"/>
                <a:gridButton click="bp100_bp_create" text="创建"/>
            </a:screenTopToolbar>
            <a:form title="商业伙伴创建" id="bp_select_form">
                <a:box column="1" labelWidth="140">
                    <a:textField name="bp_name" bindTarget="hls_bp_create_ds" prompt="商业伙伴名称"
                                 width="165">
                    </a:textField>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:comboBox name="bp_type_n" bindTarget="hls_bp_create_ds" prompt="商业伙伴类型"
                                width="165">
                    </a:comboBox>
                </a:box>
                <a:box column="1" labelWidth="140">
                    <a:comboBox name="bp_class_n" bindTarget="hls_bp_create_ds" prompt="商业伙伴分类"
                                width="165">
                    </a:comboBox>
                </a:box>
            </a:form>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
