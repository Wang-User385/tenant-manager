<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'sys_user');
            $(ds_id).setQueryParameter('user_id', '${/parameter/@user_id}');
            // if ('${/parameter/@approve_type}' === 'BP_CHANGE') {
            //     $(ds_id).setQueryParameter('query_type', 'DEPT');
            // }else{
            //     $(ds_id).setQueryParameter('query_type', 'USER');
            // }
        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'sys_user');
            var allocation_id = $(ds_id).getSelected()[0].get('allocation_id');

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                if ('${/parameter/@approve_type}' === 'BP_CHANGE') {
                    debugger
                    Leaf.request({
                        url: '${/request/@context_path}/hls/bp/master/change/approve',
                        para: {
                            changeReqId: '${/parameter/@change_req_id}',
                            allocationId: allocation_id,
                            workflowType: '${/parameter/@workflow_type}'
                        },
                        success: function (res) {
                            debugger
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '提交成功', function () {
                                $('${/parameter/@winid}').close();
                                $('${/parameter/@pre_winid}').close();
                            });
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                } else {
                    debugger
                    Leaf.request({
                        url: '${/request/@context_path}/hls/bp/master/wfl/submit',
                        para: {
                            bpId: '${/parameter/@bp_id}',
                            allocationId: allocation_id,
                            bpRelationId: '${/parameter/@bp_relation_id}',
                            admitStatus: '${/parameter/@admit_status}'
                        },
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '提交成功', function () {
                                $('${/parameter/@winid}').close();
                            });
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }
            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100);


        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
