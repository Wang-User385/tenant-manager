<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <style>
            .text_warning{
                background: #ff0004;
                color:red;
            }

            /*.text_warning{*/
                /*color:red;*/
            /*}*/
        </style>
        <script><![CDATA[


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var function_usage='${/parameter/@function_usage}';
            var ws_ecif_bp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_ecif_bp_master_change');
            debugger;
                if(ds.id == ws_ecif_bp_ds ){
                    var bp_record = $(ws_ecif_bp_ds).getCurrentRecord();
                    var cst_no=bp_record.get('cst_no');
                    var before_cst_no=bp_record.get('before_cst_no');

                    var cst_nm_s=bp_record.get('cst_nm_s');
                    var before_cst_nm_s=bp_record.get('before_cst_nm_s');

                    var ident_no=bp_record.get('ident_no');
                    var before_ident_no=bp_record.get('before_ident_no');

                    var inst_ident_tp=bp_record.get('inst_ident_tp');
                    var before_inst_ident_tp=bp_record.get('before_inst_ident_tp');

                    var unifd_socl_crdt_cd=bp_record.get('unifd_socl_crdt_cd');
                    var before_unifd_socl_crdt_cd=bp_record.get('before_unifd_socl_crdt_cd');

                    var cst_tp=bp_record.get('cst_tp');
                    var before_cst_tp=bp_record.get('before_cst_tp');

                    var ovrs_cst_chin_nm=bp_record.get('ovrs_cst_chin_nm');
                    var before_ovrs_cst_chin_nm=bp_record.get('before_ovrs_cst_chin_nm');

                    var rgstrtn_cty_and_dstc_cd=bp_record.get('rgstrtn_cty_and_dstc_cd');
                    var before_rgstrtn_cty_and_dstc_cd=bp_record.get('before_rgstrtn_cty_and_dstc_cd');

                    var maincorprtnactvctyordstccd=bp_record.get('maincorprtnactvctyordstccd');
                    var b_maincorprtnactvctyordstccd=bp_record.get('b_maincorprtnactvctyordstccd');

                    var cst_lo_natl_std_idy=bp_record.get('cst_lo_natl_std_idy');
                    var before_cst_lo_natl_std_idy=bp_record.get('before_cst_lo_natl_std_idy');

                    var swiftno=bp_record.get('swiftno');
                    var before_swiftno=bp_record.get('before_swiftno');

                    var entp_atch_rltnp=bp_record.get('entp_atch_rltnp');
                    var before_entp_atch_rltnp=bp_record.get('before_entp_atch_rltnp');

                    var ecnm_tp=bp_record.get('ecnm_tp');
                    var before_ecnm_tp=bp_record.get('before_ecnm_tp');

                    var lgl_rprs_nm=bp_record.get('lgl_rprs_nm');
                    var before_lgl_rprs_nm=bp_record.get('before_lgl_rprs_nm');

                    var corprtn_scop1=bp_record.get('corprtn_scop1');
                    var before_corprtn_scop1=bp_record.get('before_corprtn_scop1');

                    var crdt_cst_flg=bp_record.get('crdt_cst_flg');
                    var before_crdt_cst_flg=bp_record.get('before_crdt_cst_flg');

                    var before_ecif_change_id=bp_record.get('before_ecif_change_id');
                    var oprtn_ind=bp_record.get('oprtn_ind');

                    var color="orange";
if(function_usage=='QUERY'){


                    if(before_ecif_change_id){//之前存在版本

                        if(oprtn_ind){//存在说明数据是从本系统备份的版本
                            if(ovrs_cst_chin_nm!=before_ovrs_cst_chin_nm){
                                jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_OVRS_CST_CHIN_NM input")[0].style.setProperty("background",color,"important");
                            }
                            if(cst_lo_natl_std_idy!=before_cst_lo_natl_std_idy){
                                jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_LO_NATL_STD_IDY input")[0].style.setProperty("background",color,"important");
                            }
                            if(swiftno!=before_swiftno){
                                jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_SWIFTNO input")[0].style.setProperty("background",color,"important");
                            }
                        }

                        if(cst_no!=before_cst_no){
                            //jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_NO").addClass("text_warning");
                            //jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_NO").css("background","red");
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_NO input")[0].style.setProperty("background",color,"important");
                        }
                        if(cst_nm_s!=before_cst_nm_s){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_NM_S input")[0].style.setProperty("background",color,"important");
                        }
                        if(ident_no!=before_ident_no){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_IDENT_NO input")[0].style.setProperty("background",color,"important");
                        }
                        if(inst_ident_tp!=before_inst_ident_tp){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_INST_IDENT_TP input")[0].style.setProperty("background",color,"important");
                        }
                        if(unifd_socl_crdt_cd!=before_unifd_socl_crdt_cd){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_UNIFD_SOCL_CRDT_CD input")[0].style.setProperty("background",color,"important");
                        }
                        if(cst_tp!=before_cst_tp){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CST_TP input")[0].style.setProperty("background",color,"important");
                        }

                        if(rgstrtn_cty_and_dstc_cd!=before_rgstrtn_cty_and_dstc_cd){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_RGSTRTN_CTY_AND_DSTC_CD input")[0].style.setProperty("background",color,"important");
                        }
                        if(maincorprtnactvctyordstccd!=b_maincorprtnactvctyordstccd){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_MAINCORPRTNACTVCTYORDSTCCD input")[0].style.setProperty("background",color,"important");
                        }

                        if(entp_atch_rltnp!=before_entp_atch_rltnp){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_ENTP_ATCH_RLTNP input")[0].style.setProperty("background",color,"important");
                        }
                        if(ecnm_tp!=before_ecnm_tp){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_ECNM_TP input")[0].style.setProperty("background",color,"important");
                        }
                        if(lgl_rprs_nm!=before_lgl_rprs_nm){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_LGL_RPRS_NM input")[0].style.setProperty("background",color,"important");
                        }
                        if(corprtn_scop1!=before_corprtn_scop1){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CORPRTN_SCOP1 input")[0].style.setProperty("background",color,"important");
                        }
                        if(crdt_cst_flg!=before_crdt_cst_flg){
                            jQuery("#ECIF_CHANGE_DETAIL_T_CHANGE_INFO_WS_ECIF_BP_MASTER_CHANGE_CRDT_CST_FLG input")[0].style.setProperty("background",color,"important");
                        }
                    }
}
                }

        };


        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
           var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_ecif_bp_master_change');

            if (!($(ds_id).validate())){
                return;
            }
            var array = $(ds_id).getAll().map((v)=>v.data);

            $L.Masker.mask(document.body, "提交中..");
          //  $(file_id).submit();
            Leaf.request({
                url: "${/request/@context_path}/hls/ecif/bp/master/change/submit/wfl",
                para: array,
                success: function (res) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                        $('${/parameter/@winid}').close();
                    });
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "提交失败!", null);
                },
                scope: this
            });

        };


        //取消
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ws_ecif_bp_master_change');
            var record = $(ds_id).getCurrentRecord();
            var ecif_change_id = record.get('ecif_change_id');
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/hls/ecif/bp/master/change/cancel',
                para:{
                    ecifChangeId:ecif_change_id
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "取消成功!", function () {
                        $('${/parameter/@winid}').close();
                    });
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
