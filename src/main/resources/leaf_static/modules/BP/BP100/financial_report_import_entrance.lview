<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_bp_master');
            $(ds_id).getCurrentRecord().set('bp_master_code','${/parameter/@bp_master_code}');
            $(ds_id).getCurrentRecord().set('bp_master_name','${/parameter/@bp_master_name}');
            $(ds_id).getCurrentRecord().set('bp_id','${/parameter/@bp_id}');

        };


        // 导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'],'hls_bp_master');
            if($(ds_id).validate()) {
                var bp_master_code = '${/parameter/@bp_master_code}';
                var bp_master_name = '${/parameter/@bp_master_name}';
                var bp_id = '${/parameter/@bp_id}';

                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master');
                var dsRecord = $(ds_id).getCurrentRecord();
                var fin_statement_templet_hd_id = dsRecord.data.fin_statement_templet_hd_id;
                var fin_statement_name = dsRecord.data.fin_statement_name;

                new Leaf.Window({
                    id: 'bp100_excel_import_win_id',
                    params: {
                        source_document_id: bp_id,
                        source_document_category: 'HLS_BP_MASTER',
                        excel_id: fin_statement_templet_hd_id,
                        fin_statement_name: fin_statement_name,
                        winid: 'bp100_excel_import_win_id'
                    },
                    url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                    title: '财务报表导入',
                    fullScreen: true
                });
            }

        };



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
