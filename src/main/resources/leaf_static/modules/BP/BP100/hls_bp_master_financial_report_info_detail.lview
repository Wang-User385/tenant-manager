<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>
        <link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet"
              type="text/css"/>
        <script><![CDATA[
            $L.onReady(function(){
                // console.log(${/session/});
            });






        ]]></script>
        <a:dataSets>
            <a:dataSet id="fiscal_year_ds">
                <a:datas>
                    <a:record fiscal_year="${/parameter/@fiscal_year}"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="bpmaster_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/query?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=客户财报基本信息">
            </a:dataSet>

            <a:dataSet id="balance_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/query/double?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=资产负债表">
            </a:dataSet>
            <a:dataSet id="profit_statement_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/query/double?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=利润表">

            </a:dataSet>
            <a:dataSet id="cash_flow_statement_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/query/double?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=现金流量表">

            </a:dataSet>
            <a:dataSet id="financial_index_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/query/double?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=补充资料表">

            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:tabPanel width="800" height="600">
                <a:tabs>

                    <a:tab prompt="客户财报基本信息" width="150" selected="true"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="bpmaster_sheet_grid" bindTarget="bpmaster_sheet_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>
                                    <a:column name="attributes_1" width="150" align="center" prompt="项目"/>
                                    <a:column name="attributes_2" width="150" align="center" />
                                    <a:column name="attributes_3" width="150" align="center" />
                                    <a:column name="attributes_4" width="150" align="center" />
                                    <a:column name="attributes_5" width="150" align="center" />
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>

                    <a:tab prompt="资产负债表" width="150" selected="true"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="balance_sheet_grid" bindTarget="balance_sheet_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>
<!--                                    <a:column name="fin_statement_item_name" width="250" prompt="项目" align="center"/>-->
<!--                                    <a:column name="line_seq_number" width="250" prompt="行次" align="center"/>-->
                                    <a:column name="attributes_1" width="150" align="center" prompt="项目"/>
                                    <a:column name="attributes_2" width="150" align="center" />
                                    <a:column name="attributes_3" width="150" align="center" />
                                    <a:column name="attributes_4" width="150" align="center" />
                                    <a:column name="attributes_5" width="150" align="center" />
<!--                                    <a:column name="attributes_6" width="150" align="center" />-->
<!--                                    <a:column name="amount" width="200" prompt="${/parameter/@fiscal_year}" align="center"/>-->
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                    <a:tab prompt="利润表" width="150"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="profit_statement_grid" bindTarget="profit_statement_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>
                                    <a:column name="attributes_1" width="150" align="center" prompt="项目"/>
                                    <a:column name="attributes_2" width="150" align="center" />
                                    <a:column name="attributes_3" width="150" align="center" />
                                    <a:column name="attributes_4" width="150" align="center" />
                                    <a:column name="attributes_5" width="150" align="center" />
<!--                                    <a:column name="attributes_6" width="150" align="center" />-->
<!--                                    <a:column name="fin_statement_item_name" width="250" prompt="项目" align="center"/>-->
<!--                                    <a:column name="line_seq_number" width="250" prompt="行次" align="center"/>-->
<!--                                    <a:column name="amount" width="200" prompt="${/parameter/@fiscal_year}"-->
<!--                                              align="center"/>-->
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                    <a:tab prompt="现金流量表" width="150"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="cash_flow_statement_grid" bindTarget="cash_flow_statement_ds" width="750"
                                    height="500"
                                    navBar="true">
                                <a:columns>
                                    <a:column name="attributes_1" width="150" align="center" prompt="项目"/>
                                    <a:column name="attributes_2" width="150" align="center" />
                                    <a:column name="attributes_3" width="150" align="center" />
                                    <a:column name="attributes_4" width="150" align="center" />
                                    <a:column name="attributes_5" width="150" align="center" />
<!--                                    <a:column name="attributes_6" width="150" align="center" />-->
                                   <!-- <a:column name="fin_statement_item_name" width="250" prompt="项目" align="center"/>
                                    <a:column name="line_seq_number" width="250" prompt="行次" align="center"/>
                                    <a:column name="amount" width="200" prompt="${/parameter/@fiscal_year}"
                                              align="center"/>-->
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                    <a:tab prompt="补充资料表" width="150"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="financial_index_grid" bindTarget="financial_index_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>
                                    <a:column name="attributes_1" width="150" align="center" prompt="项目"/>
                                    <a:column name="attributes_2" width="150" align="center" />
                                    <a:column name="attributes_3" width="150" align="center" />
                                    <a:column name="attributes_4" width="150" align="center" />
                                    <a:column name="attributes_5" width="150" align="center" />
<!--                                    <a:column name="attributes_6" width="150" align="center" />-->

                                    <!--<a:column name="fin_statement_item_name" width="250" prompt="项目" align="center"/>
                                    <a:column name="line_seq_number" width="250" prompt="行次" align="center"/>
                                    <a:column name="amount" width="200" prompt="${/parameter/@fiscal_year}"
                                              align="center"/>-->
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>

        </a:screenBody>
    </a:view>
</a:screen>
