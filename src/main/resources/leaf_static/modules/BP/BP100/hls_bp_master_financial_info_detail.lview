<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>
        <link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet"
              type="text/css"/>
        <script><![CDATA[
            $L.onReady(function(){
            });






        ]]></script>
        <a:dataSets>
            <a:dataSet id="period_fiscal_year_ds">
                <a:datas>
<!--                    <a:record fiscal_year="${/parameter/@fiscal_year}"/>-->
                    <a:record report_year="${/parameter/@report_year}"/>
                </a:datas>
            </a:dataSet>


            <a:dataSet id="period_balance_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/ln/query?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=资产负债表">

            </a:dataSet>
            <a:dataSet id="period_profit_statement_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/ln/query?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=利润表">

            </a:dataSet>
            <a:dataSet id="period_cash_flow_statement_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/ln/query?finStatementHdId=${/parameter/@fin_statement_hd_id}&amp;lineType=现金流量表">

            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:tabPanel width="800" height="600">
                <a:tabs>
                    <a:tab prompt="资产负债表" width="185" selected="true"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="period_balance_sheet_grid" bindTarget="period_balance_sheet_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>

                                    <a:column name="line_seq_number" width="50" prompt="行次" align="left"/>
                                    <a:column name="fin_statement_item_name" width="370" prompt="项目" align="left"/>
                                    <a:column name="amount" width="200" prompt="${/parameter/@report_year}"
                                              align="right" />
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                    <a:tab prompt="利润表" width="185"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="period_profit_statement_grid" bindTarget="period_profit_statement_ds" width="750" height="500"
                                    navBar="true">
                                <a:columns>

                                    <a:column name="line_seq_number" width="50" prompt="行次" align="left"/>
                                    <a:column name="fin_statement_item_name" width="370" prompt="项目" align="left"/>
                                    <a:column name="amount" width="200" prompt="${/parameter/@report_year}"
                                              align="right" />
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                    <a:tab prompt="现金流量表" width="185"
                           bodyClassName="cls" bodyStyle="s">
                        <a:form labelwidth="110" labelWidth="100">
                            <a:grid id="period_cash_flow_statement_grid" bindTarget="period_cash_flow_statement_ds" width="750"
                                    height="500"
                                    navBar="true">
                                <a:columns>

                                    <a:column name="line_seq_number" width="50" prompt="行次" align="left"/>
                                    <a:column name="fin_statement_item_name" width="370" prompt="项目" align="left"/>
                                    <a:column name="amount" width="200" prompt="${/parameter/@report_year}"
                                              align="right" />
                                </a:columns>
                            </a:grid>
                        </a:form>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>

        </a:screenBody>
    </a:view>
</a:screen>
