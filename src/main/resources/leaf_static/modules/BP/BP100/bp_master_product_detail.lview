<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <!--        <a:link id="bp100_bp_master_modify_id"-->
        <!--                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>-->

        <script><![CDATA[



        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var condition_id = '${/parameter/@condition_id}';
            var bp_id = '${/parameter/@bp_id}';
            if (!condition_id && bp_id){
                Leaf.request({
                    url: '${/request/@context_path}/hls/get/conditionId?bpId=' + bp_id,
                    success: function (res) {
                        condition_id = res.result.record[0];
                    },
                    sync: true
                });
            }
            $(ds.id).setQueryParameter('condition_id',parseInt(condition_id));
        };


        //保存成功调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            debugger;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_bp_master_business_condition');
            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_bank');
            var ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_hydropower');
            var ds_id3 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_order');
            var ds_id4 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_receive_pay');
            var ds_id5 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_sale');
            var ds_id6 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_business_condition_tax');
            var record_con = $(ds_id).getCurrentRecord();
            var record_order = $(ds_id3).getCurrentRecord();
            if (record_con){
                var condition_id = parseInt(record_con.get('condition_id'));
                var order_id = record_order.get('order_id');
                var bp_id = '${/parameter/@bp_id}';
                if (record_order && condition_id && order_id){
                    Leaf.request({
                        url: '${/request/@context_path}/hls/update?conditionId='+condition_id +'&orderId=' + order_id,
                        success: function (res) {

                        },
                        sync: true
                    });
                }
                if (condition_id){
                    Leaf.request({
                        url: '${/request/@context_path}/hls/update/condition?conditionId='+condition_id +'&bpId=' + bp_id,
                        success: function (res) {

                        },
                        sync: true
                    });
                }
            }
            // var record_con1 = $(ds_id).getCurrentRecord();
            // var  condition_con_id = parseInt(record_con1.get('condition_id'));
            // $(ds_id).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id1).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id2).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id3).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id4).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id5).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id6).setQueryParameter("condition_id", condition_con_id);
            // $(ds_id).query();
            // $(ds_id1).query();
            // $(ds_id2).query();
            // $(ds_id3).query();
            // $(ds_id4).query();
            // $(ds_id5).query();
            // $(ds_id6).query();
        };

        //保存逻辑覆写
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            //忽略保存校验方法
            var root_ds=$('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            var before_flag= before_submit();
            if(before_flag){
                var winid = '${/parameter/@winid}';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@layout_code}');
                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE(){

                    root_ds.un('beforesubmit',ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if(!flag){
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION(){
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds,root_record,res);
                    if (typeof(nextStep) == 'function') {
                        nextStep(ds);
                    }
                }
                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED(){
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }
                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR(){
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }
                root_ds.on('beforesubmit',ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);

                root_ds.doNewSubmit(null,root_ds.getJsonData());
            }
            else{
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
