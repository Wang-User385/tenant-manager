        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            debugger;
            $jq('#${/parameter/@layout_code}_T_ORDER_FRIST_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_T_BANK_FIRST_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_T_SALE_FIRST_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_T_RP_FIRST_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_T_HY_FIRST_component_id').hide();//隐藏客户信息组件
            $jq('#${/parameter/@layout_code}_T_TAX_FIRST_component_id').hide();//隐藏客户信息组件

        };



        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            debugger;
            var condition_id = '${/parameter/@condition_id}';
            var bp_id = '${/parameter/@bp_id}';
            if (!condition_id && bp_id){
                Leaf.request({
                    url: '${/request/@context_path}/hls/get/conditionId?bpId=' + bp_id,
                    success: function (res) {
                        condition_id = res.result.record[0];
                    },
                    sync: true
                });
            }
            qpara['condition_id'] = parseInt(condition_id);
            qpara['bp_id'] = parseInt(bp_id);
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var condition_id = '${/parameter/@condition_id}';
            var bp_id = '${/parameter/@bp_id}';
            if (!condition_id && bp_id){
                Leaf.request({
                    url: '${/request/@context_path}/hls/get/conditionId?bpId=' + bp_id,
                    success: function (res) {
                        condition_id = res.result.record[0];
                    },
                    sync: true
                });
            }
            qpara['condition_id'] = parseInt(condition_id);
            // qpara['bp_id'] = parseInt(bp_id);
        };


