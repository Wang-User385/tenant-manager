<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>
        <link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet"
              type="text/css"/>
        <script><![CDATA[
        function render_sys_resource_ds_grid(value, record, name) {
            if (!record.isNew) {
                if (name == 'anaysis_detail') {
                    return '<a href="javascript:winOpen_access_component(\'' + record.get('fin_statement_hd_id') + '\',\'' + record.get('fiscal_year') + '\');">报表明细</a>';
                }

                return '';
            }
            return '';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="fiscal_year_ds">
                <a:datas>
                    <a:record fiscal_year="${/parameter/@fiscal_year}"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="development_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/indicator?headerId=${/parameter/@header_id}&amp;lineType=财务指标&amp;attribute_1=成长能力指标分析">
            </a:dataSet>

            <a:dataSet id="cash_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/indicator?headerId=${/parameter/@header_id}&amp;lineType=财务指标&amp;attribute_1=营运能力指标分析">
            </a:dataSet>

            <a:dataSet id="balance_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/indicator?headerId=${/parameter/@header_id}&amp;lineType=财务指标&amp;attribute_1=盈利能力指标分析">
            </a:dataSet>

            <a:dataSet id="debt_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/indicator?headerId=${/parameter/@header_id}&amp;lineType=财务指标&amp;attribute_1=偿债能力指标分析">
            </a:dataSet>

            <a:dataSet id="all_sheet_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hlsCus/fnd/line/indicator?headerId=${/parameter/@header_id}&amp;lineType=财务指标&amp;attribute_1=all">
            </a:dataSet>

        </a:dataSets>
