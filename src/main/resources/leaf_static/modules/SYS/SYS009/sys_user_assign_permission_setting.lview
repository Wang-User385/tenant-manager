        <style>
            html,body{
                background: #fff;
            }
            .block-icon{
                width: 60px;
                height: 60px;
            }
            .side-block{
                position:relative;
                height:212.5px;
                border-radius:5px;
                cursor:pointer;
                width: 270px;
                margin-bottom: 20px;
            }
            .side-block span{
                display: block;
                position: absolute;
                bottom:0;
                left:0;
                width: 270px;
                height:46px;
                line-height:46px;
                text-align:center;
                color:#fff;
                font-family: "Microsoft YaHei";
                font-size: 14px;
                cursor:pointer;
                border-radius: 5px;
            }
            .side-block img{
                position: absolute;
                left:50%;
                margin-left:-30px;
                top:50%;
                margin-top:-30px;

            }
        </style>
        <script><![CDATA[

        /***
         * 合同权限设置
         */
        function contract_permission_setting() {
           var win = new Leaf.Window({
                id: 'contract_permission_setting',
                url: $('pageLink_contract_permission_setting').getUrl(),
                params: {
                    winId: "contract_permission_setting",
                    allocation_id: "${/parameter/@allocation_id}",
                },
                title: '合同权限设置',
                width: 700,
                height: 500,
                side: "right"
            });
        }

