<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: congweijing
    $Date: 2021-08-11
    用户定义-账户分配-权限设置-档案借阅
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function bp_permission_setting_ds_query() {
            $('bp_permission_setting_ds').query();
        }

        function bp_permission_setting_ds_grid_editFun(record, name) {
            //    if (record.isNew) {
            if (name == 'company_full_name') {
                return 'bp_permission_setting_ds_grid_lov';
            }
            //   }
            return '';
        }

        function onSubmitSuccess_bp_permission_setting_ds() {
            bp_permission_setting_ds_query();
        }

        function beforeClick_org_unit_rule_lov(lov) {
            var companyCode = $('bp_permission_setting_ds').getCurrentRecord().data.company_rule;
            lov.controller = "/leaf/fnd/org/unit/queryForLovByCompanyCode?companyCode=" + companyCode;
        }

        function beforeClick_org_position_rule_lov(lov) {
            var unitCode = $('bp_permission_setting_ds').getCurrentRecord().data.org_unit_rule;
            lov.controller = "/hls/fnd/org/position/queryForLovByUnitCode?unitCode=" + unitCode;
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="division_type_ds" autoQuery="true" queryUrl="${/request/@context_path}/fnd/division/query"/>
            <a:dataSet id="project_business_type_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/fnd/businessType/selectBusinessTypeByDocumentCategory?documentCategory=CHANCE"/>
            <a:dataSet id="contract_type_query_ds">
                <a:fields>
                    <a:field name="document_category" defaultValue="JC_ARCHIVE_BORROW"/>
                    <a:field name="enabled_flag" defaultValue="Y"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="bp_permission_setting_query_ds">
                <a:fields>
                    <a:field name="allocation_id" defaultValue="${/parameter/@allocation_id}"/>
                    <a:field name="document_category" defaultValue="JC_ARCHIVE_BORROW"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="bp_permission_setting_ds" autoPageSize="true" autoQuery="true"
                       queryDataSet="bp_permission_setting_query_ds"
                       queryUrl="${/request/@context_path}/fnd/authority/query"
                       submitUrl="${/request/@context_path}/fnd/authority/submit"
                       deleteUrl="${/request/@context_path}/fnd/authority/delete" selectable="true">
                <a:fields>
                    <a:field name="allocation_id" defaultValue="${/parameter/@allocation_id}"/>
                    <a:field name="document_category" defaultValue="JC_ARCHIVE_BORROW"/>
                    <a:field name="company_id"/>
                    <a:field name="company_full_name" lovWidth="500" lovHeight="450" lovLabelWidth="100"
                             lovService="/leaf/fnd/company/queryAllForLov~com.hand.hls.fnd.dto.LovFndCompany"
                             title="选择公司" required="true">
                        <a:mapping>
                            <a:map from="company_id" to="company_id"/>
                            <a:map from="company_full_name" to="company_full_name"/>
                            <a:map from="company_code" to="company_rule"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="unit_id"/>
                    <a:field name="org_unit_rule"/>
                    <a:field name="unit_name" lovWidth="500" lovHeight="450" lovLabelWidth="100"
                             lovService="/leaf/fnd/org/unit/queryForLovByCompanyCode~com.hand.hls.sys.dto.LovFndOrgUnit"
                             title="选择部门">
                        <a:mapping>
                            <a:map from="unit_id" to="unit_id"/>
                            <a:map from="unit_code" to="org_unit_rule"/>
                            <a:map from="unit_name" to="unit_name"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="position_rule"/>
                    <a:field name="position_name" lovWidth="500" lovHeight="450" lovLabelWidth="100"
                             lovService="/hls/fnd/org/position/queryForLovByUnitCode~com.hand.hls.sys.dto.LovHLSOrgPosition"
                             title="选择岗位">
                        <a:mapping>
                            <a:map from="position_name" to="position_name"/>
                            <a:map from="position_code" to="position_rule"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="employee_rule" lovWidth="500" lovHeight="450" lovLabelWidth="100"
                             lovService="/fnd/employee/query~com.hand.hls.sys.dto.LovFndEmployee"
                             title="选择员工">
                        <a:mapping>
                            <a:map from="employee_code" to="emploee_code"/>
                            <a:map from="employee_code" to="employee_rule"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="biz_type_name" options="project_business_type_ds" displayField="description"
                             valueField="business_type" returnField="biz_type_rule"/>
                    <a:field name="division_name" options="division_type_ds" displayField="description"
                             valueField="division_rule" returnField="division_rule"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_bp_permission_setting_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton bind="bp_permission_setting_ds_grid" text="HAP.NEW" type="add"/>
                <a:gridButton bind="bp_permission_setting_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton bind="bp_permission_setting_ds_grid" text="HAP.SAVE" type="save"/>
                <a:gridButton click="bp_permission_setting_ds_query" text="HAP.QUERY"/>
            </a:screenTopToolbar>

            <a:grid id="bp_permission_setting_ds_grid" bindTarget="bp_permission_setting_ds"
                    width="680" marginHeight="150" navBar="true">
                <a:columns>
                    <a:column name="company_full_name" width="200" prompt="公司名称"
                              editorFunction="bp_permission_setting_ds_grid_editFun"/>
                    <a:column name="unit_name" width="120" prompt="部门" editor="org_unit_rule_lov"/>
                    <a:column name="biz_type_name" width="100" prompt="商机类型"
                              editor="bp_permission_setting_ds_grid_cmb"/>
                    <a:column name="division_name" width="100" prompt="产品线" editor="bp_permission_setting_ds_grid_cmb"/>
                    <a:column name="employee_rule" width="120" prompt="员工编码"
                              editor="bp_permission_setting_ds_grid_lov"/>
                </a:columns>
                <a:editors>
                    <a:lov id="bp_permission_setting_ds_grid_lov"/>
                    <a:lov id="org_unit_rule_lov">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="beforeClick_org_unit_rule_lov"/>
                        </a:events>
                    </a:lov>
                    <a:lov id="org_position_rule_lov">
                        <a:events>
                            <a:event name="beforetriggerclick" handler="beforeClick_org_position_rule_lov"/>
                        </a:events>
                    </a:lov>
                    <a:comboBox id="bp_permission_setting_ds_grid_cmb"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
