<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: liangxian.chen
    $Date: 2023年3月1日
    $Revision: 1.0
    $Purpose: 内网网段定义
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function intranet_segment_define_add() {
            $('intranet_segment_define_ds').create();
        }
        function intranet_segment_define_query() {
            $('intranet_segment_define_ds').query();
        }
        function intranet_segment_define_reset() {
            $('intranet_segment_define_ds').reset();
            $('intranet_segment_define_ds').query();
        }


        function intranet_segment_define_delete_confirm(){
            if($('intranet_segment_define_ds').getSelected().length === 0){
                Leaf.showErrorMessage( '提示', '请选择记录！',null, 200, 100 );
                return ;
            }
            Leaf.showConfirm('提示', '确定删除？', intranet_segment_define_delete, null, 200, 100 );
        }

        function intranet_segment_define_delete(){
        debugger
            var ds = $('intranet_segment_define_ds');
            var records = ds.getSelected();
            records.forEach(function (current, index, arr) {
                current.set('__status','delete');
            });
            ds.setSubmitUrl('${/request/@context_path}/sys/intranet/segment/define/remove');
            ds.submitSelected();
            ds.query();
        }

        function intranet_segment_define_save() {
            debugger
            var ds = $('intranet_segment_define_ds');
            var records = ds.getAll();
            if (records.length > 0 && ds.validate()) {
                for (var i = 0; i < records.length; i++) {
                    var ips = records[i].data.intranet_from;
                    var ipe = records[i].data.intranet_to;
                    var re =  /^(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])$/;
                    if(!re.test(ips) || !re.test(ipe)){
                        Leaf.showErrorMessage( '提示', 'IP不合法！',null, 200, 100 );
                        return ;
                    }
                    if(!records[i].isNew){
                        records[i].set('__status','update');
                    }
                }

                ds.setSubmitUrl('${/request/@context_path}/sys/intranet/segment/define/submit');
                ds.submit();
            }
        }


        function ip_valid(record,name,value){
            if ("intranet_from" === value || "intranet_to" === value){
                if(record !== null && record !== undefined){
                    var re =  /^(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])\.(\d{1,2}|1\d\d|2[0-4]\d|25[0-5])$/;
                    if(!re.test(record)){
                        Leaf.showErrorMessage( '提示', 'IP不合法！',null, 200, 100 );
                        return record;
                    }
                    return record;
                }
                return record;
            }

            return record;
        }



        ]]></script>
        <a:dataSets>
            <a:dataSet id="intranet_segment_define_ds" autoQuery="true" autoPageSize="true"
                       queryUrl="${/request/@context_path}/sys/intranet/segment/define/query"
                       submitUrl="${/request/@context_path}/sys/intranet/segment/define/submit"
                       deleteUrl="${/request/@context_path}/sys/intranet/segment/define/remove" selectable="true">
                <a:fields>
                    <a:field name="intranet_define_id"/>
                    <a:field name="intranet_from" required="true"/>
                    <a:field name="intranet_to" required="true"/>
                    <a:field name="enable_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="description"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton bind="intranet_segment_define_grid_id" click="intranet_segment_define_add" text="HAP.NEW"/>
                <a:gridButton bind="intranet_segment_define_grid_id" click="intranet_segment_define_save" text="HAP.SAVE" />
                <a:gridButton bind="intranet_segment_define_grid_id" click="intranet_segment_define_delete_confirm" text="HAP.DELETE"/>
                <a:gridButton bind="intranet_segment_define_grid_id" click="intranet_segment_define_query" text="HAP.QUERY"/>
                <a:gridButton bind="intranet_segment_define_grid_id" click="intranet_segment_define_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>


            <a:grid id="intranet_segment_define_grid_id" bindTarget="intranet_segment_define_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>
                    <a:column name="intranet_from" width="200" align="center" prompt="内网网段从"  editor="intranet_segment_define_grid_textfield"/>
                    <a:column name="intranet_to" width="200" align="center" prompt="内网网段至"  editor="intranet_segment_define_grid_textfield"/>
                    <a:column name="enable_flag" width="100" align="center" prompt="是否启用" editor="intranet_segment_define_grid_check"/>
                    <a:column name="description" width="300" align="center" prompt="备注" editor="intranet_segment_define_grid_textfield"/>
                </a:columns>
                <a:editors>
                    <a:textField id="intranet_segment_define_grid_textfield"/>
                    <a:checkBox id="intranet_segment_define_grid_check"/>
                    <a:numberField id="intranet_segment_define_grid_numberField"/>
                    <a:datePicker id="intranet_segment_define_grid_datePicker"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>