<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        <!--init-->
        $L.onReady(function () {
            var status = [{text: "已结束", value: 1}, {text: "运行中", value: 2}, {text: "挂起中", value: 3}];
            console.log(status);
            status.forEach(function (item) {
                $('wfl_process_monitor_status_ds').create({"text": item.text, "value": item.value});
            });
            console.log($('wfl_process_monitor_status_ds'));
        });

        <!--operations-->
        function wfl_process_monitor_query() {
            $('wfl_process_monitor_ds').query();
        }

        function active_process(id) {
            var ds = $('wfl_process_monitor_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/wfl/runtime/prc/active/' + id);
                ds.submit();
            }
        }

        function suspend_process(id) {
            var ds = $('wfl_process_monitor_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/wfl/runtime/prc/suspend/' + id);
                ds.submit();
            }
        }

        function end_proc(id) {
            var ds = $('wfl_process_monitor_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/wfl/runtime/prc/end/' + id);
                ds.submit();
            }
        }

        function wfl_process_monitor_delete_confirm() {
            if ($('wfl_process_monitor_ds').getSelected().length == 0) {
                Leaf.showErrorMessage('提示', '请选择记录！', null, 200, 100);
                return;
            }
            Leaf.showConfirm('提示', '确定删除？', wfl_process_monitor_delete, null, 200, 100);
        }

        function wfl_process_monitor_delete() {
            var ds = $('wfl_process_monitor_ds');
            if (ds.validate()) {
                ds.setSubmitUrl('${/request/@context_path}/leaf/wfl/approve/strategy/remove');
                ds.submitSelected();
            }
        }

        function wfl_process_monitor_quit() {
            location.href = $('pageLink_welcome').getUrl();
        }

        function wfl_process_monitor_reset() {
            $('wfl_process_monitor_query_ds').reset();
            $('wfl_process_monitor_ds').query();
        }

        function onSubmitSuccess_wfl_process_monitor_ds(ds) {
            wfl_process_monitor_query();
        }

        <!--renders-->
        function process_status_render(value, record, name) {
            if (null != record.get('end_time')) {
                return "<span style='color:#5d6d7c;'>已结束</span>"
            } else {
                if (record.get('suspended')) {
                    return "<span style='color:goldenrod;'>挂起中</span>"
                } else {
                    return "<span style='color:green;'>运行中</span>"
                }
            }
        }

        function process_instance_info_detail_render(value, record, name) {
            var current_tasks = record.get('current_tasks');
            var taskId;
            if (current_tasks != undefined) {
                taskId = current_tasks[0].task_id;
            }
            return '<a href="javascript:winOpen_process_instance_info_detail(\'' + record.get('id') + '\',\'' + taskId + '\',\'' + record.get('process_name') + '\');">查看</a>';
        }

        function operations_render(value, record, name) {
            var current_tasks = record.get('current_tasks');
            var taskId;
            if (current_tasks != undefined) {
                taskId = current_tasks[0].task_id;
            }
            if (record.get('end_time') != null && record.get('end_time') != "") {
                return "";
            } else {
                /*var html = '<a href="javascript:delegate_task(\'' + record.get('id') + '\',\'' + taskId + '\');">转交</a>&nbsp;&nbsp;&nbsp;&nbsp;'
                    + '<a href="javascript:end_proc(\'' + record.get('id') + '\');">终止流程</a>';*/
                var html = '<a href="javascript:delegate_task(\'' + record.get('id') + '\',\'' + taskId + '\');">转交</a>&nbsp;&nbsp;&nbsp;&nbsp;'
                    + '<a href="javascript:reject_task(\'' + record.get('id') + '\');">流程拒绝</a>&nbsp;&nbsp;&nbsp;&nbsp;'
                    + '<a href="javascript:jump_task(\'' + record.get('id') + '\');">跳转</a>';
                if (record.get('suspended')) {
                    return '<a href="javascript:active_process(\'' + record.get('id') + '\');">启动</a>&nbsp;&nbsp;&nbsp;&nbsp;'
                        + html;
                } else {
                    return '<a href="javascript:suspend_process(\'' + record.get('id') + '\');">挂起</a>&nbsp;&nbsp;&nbsp;&nbsp;'
                        + html;
                }
            }
        }

        var jumpWindow = null;

        //跳转
        function jump_task(id){
            jumpWindow = new Leaf.Window({
                id: 'win_process_instance_info_node',
                url: '${/request/@context_path}/modules/WFL/WFL003/process_node_jump.lview?id='+id,
                title: "节点跳转",
                side: 'right',
                width: "910"
            });
        }

        //流程拒绝
        function reject_task(id){
            $L.showConfirm("提交","请确定是否一键拒绝该流程!",function(){
                jQuery.ajax({
                    url: '${/request/@context_path}/wfl/runtime/prc/end/'+id,
                    type: "POST",
                    contentType: "application/json",
                    success: function (datas) {
                        if(datas.success){
                            $L.showInfoMessage("提示","流程已拒绝通过!");
                            wfl_process_monitor_query();
                        }else{
                            $L.showInfoMessage("提示",datas.message||"请联系管理员!");
                        }
                    }
                })
            })
        }

        //流程跳转
        function jump(id,jumpTarget,name){
            $L.showConfirm("提交","请确定是否跳转该流程!",function(){
                jumpWindow.close();
                Leaf.Masker.mask(Ext.getBody(), '正在操作。。');
                jQuery.ajax({
                    url: '${/request/@context_path}/wfl/runtime/prc/jump/'+id + "?jumpTarget="+jumpTarget+"&jumpTargetName="+name,
                    type: "POST",
                    contentType: "application/json",
                    success: function (datas) {
                        if(datas.success){
                            Leaf.Masker.unmask(Ext.getBody());
                            $L.showInfoMessage("提示","流程跳转成功!");
                            wfl_process_monitor_query();
                        }else{
                            Leaf.Masker.unmask(Ext.getBody());
                            $L.showInfoMessage("提示",datas.message||"请联系管理员!");
                            wfl_process_monitor_query();
                        }
                    },
                    failure:function () {
                        Leaf.Masker.unmask(Ext.getBody());
                        $L.showInfoMessage("提示",datas.message||"请联系管理员!");
                        wfl_process_monitor_query();
                    }
                })
            })
        }

        //一键通过
        function one_button_pass(id){
            $L.showConfirm("提交","请确定是否一键通过该流程!",function(){
                Leaf.Masker.mask(Ext.getBody(), '正在操作。。');
                jQuery.ajax({
                    url: '${/request/@context_path}/wfl/runtime/prc/pass/'+id,
                    type: "POST",
                    contentType: "application/json",
                    success: function (datas) {
                        Leaf.Masker.unmask(Ext.getBody());
                        if(datas.success){
                            $L.showInfoMessage("提示","流程已直接通过!");
                            wfl_process_monitor_query();
                        }else{
                            $L.showInfoMessage("提示",datas.message||"请联系管理员!");
                        }
                    },
                    failure:function () {
                        Leaf.Masker.unmask(Ext.getBody());
                        $L.showInfoMessage("提示",datas.message||"请联系管理员!");
                        wfl_process_monitor_query();
                    }
                })
            })
        }

        <!--new Window-->
        function winOpen_process_instance_info_detail(id, taskId, processName) {
            new Leaf.Window({
                id: 'win_process_instance_info_detail',
                url: '${/request/@context_path}/modules/WFL/WFL003/process_instance_detail.lview',
                params: {
                    id: id,
                    taskId: taskId
                },
                title: processName,
                side: 'right',
                fullScreen: true
            });
        }

        function delegate_task(id, taskId) {
            new Leaf.Window({
                id: 'win_delegate_task',
                url: '${/request/@context_path}/modules/WFL/WFL003/process_delegate_task.lview',
                params: {
                    id: id,
                    taskId: taskId,
                    winId: 'win_delegate_task'
                },
                title: '转交',
                width: 800,
                height: 535
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="wfl_process_monitor_status_ds"/>
            <a:dataSet id="wfl_process_monitor_query_ds">
                <a:fields>
                    <a:field name="process_instance_status" options="wfl_process_monitor_status_ds" displayField="text"
                             valueField="text" returnField="process_instance_status"/>
                    <a:field name="started_by_name" autoComplete="true" lovGridHeight="300" lovHeight="450"
                             lovLabelWidth="100" lovWidth="600"
                             lovService="/fnd/employee/queryEmployeesForLov~com.hand.hap.activiti.dto.AllocationEmployeeLov"
                             title="选择发起人">
                        <a:mapping>
                            <a:map from="name" to="started_by_name"/>
                            <a:map from="allocation_id" to="started_by"/>
                        </a:mapping>
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="wfl_process_monitor_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/wfl/leaf/query/process-instances/monitor"
                       queryDataSet="wfl_process_monitor_query_ds" selectable="true" selectionModel="single">
                <a:events>
                    <a:event name="submitsuccess" handler="onSubmitSuccess_wfl_process_monitor_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="wfl_process_monitor_query" text="HAP.QUERY"/>
                <a:gridButton click="wfl_process_monitor_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="3" labelwidth="130" title="查询条件" style="width:100%">
                <a:textField name="process_instance_id" bindTarget="wfl_process_monitor_query_ds" prompt="流程ID"
                             width="200">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="process_definition_name_like" bindTarget="wfl_process_monitor_query_ds" prompt="流程名称"
                             width="200">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="documentName" bindTarget="wfl_process_monitor_query_ds" prompt="单据名称"
                             width="200">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:textField>
                <a:lov name="started_by_name" bindTarget="wfl_process_monitor_query_ds" prompt="申请人" width="200">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:lov>
                <a:datePicker name="started_after" bindTarget="wfl_process_monitor_query_ds" prompt="创建日期从" width="200"
                              editable="false">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:datePicker>
                <a:datePicker name="started_before" bindTarget="wfl_process_monitor_query_ds" prompt="创建日期到" width="200"
                              editable="false">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:datePicker>
                <a:comboBox name="process_instance_status" bindTarget="wfl_process_monitor_query_ds" prompt="流程状态"
                            width="200" editable="false">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:comboBox>
                <a:datePicker name="finished_after" bindTarget="wfl_process_monitor_query_ds" prompt="结束日期从" width="200"
                              editable="false">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:datePicker>
                <a:datePicker name="finished_before" bindTarget="wfl_process_monitor_query_ds" prompt="结束日期到"
                              width="200" editable="false">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:datePicker>
                <a:textField name="started_by" bindTarget="wfl_process_monitor_query_ds" width="200" hidden="true">
                    <a:events>
                        <a:event name="enterdown" handler="wfl_process_monitor_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="wfl_process_monitor_ds_grid" bindTarget="wfl_process_monitor_ds" marginHeight="200"
                    marginWidth="30"
                    navBar="true">
                <a:columns>
                    <a:column name="id" width="80" prompt="流程ID"/>
                    <a:column width="90" prompt="流程状态" renderer="process_status_render" align="center"/>
                    <a:column width="90" prompt="详细信息" renderer="process_instance_info_detail_render" align="center"/>
                    <a:column width="250" prompt="操作" renderer="operations_render" align="center"/>
                    <a:column name="process_name" width="140" prompt="流程名称"/>
                    <a:column name="document_name" width="280" prompt="单据名称"/>
                    <a:column name="start_user_name" width="120" prompt="申请人"/>
                    <a:column name="task_name" width="140" prompt="当前节点"/>
                    <a:column name="current_approver" width="120" prompt="当前处理人"/>
                    <a:column name="start_time" width="150" prompt="创建时间"/>
                    <a:column name="end_time" width="150" prompt="结束时间"/>
                </a:columns>
                <a:editors>
                    <a:textField id="wfl_process_monitor_ds_grid_tf"/>
                    <a:textField id="wfl_process_monitor_ds_grid_tf_upper" maxLength="30" typeCase="upper"/>
                    <a:checkBox id="wfl_process_monitor_ds_grid_check"/>
                    <a:datePicker id="wfl_process_monitor_ds_grid_dp" editable="false"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
