<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/leafresources/js/wfl/wfl.js"></script>
        <script src="${/request/@context_path}/lib/bootstrap-3.3.7/js/bootstrap.min.js"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.js"></script>
        <a:link id="wfl_project_query_id" url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="wfl_project_change_id" url="${/request/@context_path}/modules/PRJ/PRJ_CHANGE/PRJ100/prj_project_change_modify.lview"/>
        <a:link id="wfl_chance_detail_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ001/prj_chance_modify_detail.lview"/>
        <a:link id="process_wfl_bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <link href="${/request/@context_path}/lib/assets/global/plugins/jquery-ui/jquery-ui.min.css" rel="stylesheet"
              type="text/css"/>
        <script><![CDATA[
        //其实并不是currentTask,只是为了子页面使用方便，而没有改名
        var currentTaskInfo = {};
        var sonUrl = null;

        $L.onReady(function () {

            // 隐藏审批历史导出按钮
            jQuery("#process_instance_history_grid_tb .grid-excel").hide();

            var processInstanceId = parseInt('${/parameter/@id}');
            var taskId = '${/parameter/@taskId}' == 'undefined' ? '-1' : '${/parameter/@taskId}';

            $('current_process_instance_detail_ds').setQueryUrl('${/request/@context_path}/wfl/leaf/instance/' + processInstanceId);
            $('current_process_instance_detail_ds').query();

            jQuery.ajax({
                url: '${/request/@context_path}/wfl/formKey/' + processInstanceId + '/' + taskId,
                type: 'GET',
                contentType: 'application/json',
                success: function (res) {
                    sonUrl = "${/request/@context_path}/" + res.message;
                }
            })

        });

        function process_instance_detail_quit() {
            history.go(0);
        }

        function actionRender(value, record, name) {
            if(!!value) {
                if (value == 'APPROVED') {
                    value = "<span class='action_ok'>同意</span>";
                } else if (value == 'REJECTED') {
                    value = "<span class='action_dangerous'>拒绝</span>";
                } else if (value == 'ADD_SIGN') {
                    value = "<span class='action_dangerous'>加签</span>";
                } else if (value == 'DELEGATE') {
                    value = "<div class='action_dangerous'>转交</div>";
                } else if (value == 'JUMP') {
                    value = "<span class='action_dangerous'>跳转</span>";
                } else if (value == 'RECALL') {
                    value = "<span class='action_dangerous'>撤回</span>";
                } else if (value == 'SAVE') {
                    value = "<span class='action_dangerous'>保留</span>";
                } else if (value == 'CHANGE') {
                    value = "<span class='action_dangerous'>变更</span>";
                } else if (value == "CARBON_COPY") {
                    value = "<span class='action_dangerous'>抄送</span>";
                } else if (value == 'APPOINT') {
                    value = "<span class='action_dangerous'>确认指派</span>";
                } else if (value == 'WITHDRAW') {
                    value = "<span class='action_dangerous'>项目撤回</span>";
                } else if (value == 'APPROVED_RETURN') {
                    value = "<span class='action_dangerous'>项目退回</span>";
                } else if (value == 'APPROVED_LAST') {
                    value = "<span class='action_dangerous'>回到退回节点</span>";
                } else if (value == 'addAssign') {
                    value = "<span class='action_dangerous'>指派</span>";
                } else if (value == 'REVIEW') {
                    value = "<span class='action_dangerous'>提交业审委审议</span>";
                } else if (value == 'POWERFUL_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'END_TASK_APPROVED') {
                    value = "<span class='action_dangerous'>同意</span>";
                } else if (value == 'SUSPEND') {
                    value = "<span class='action_dangerous'>暂缓</span>";
                }else if(value == 'REVIEW_APPROVED'){
                    value = "<span class='action_dangerous'>提交复审</span>";
                }else if(value == 'RETURN_RESEND'){
                    value = "<span class='action_dangerous'>退回项目经理重发</span>";
                }else if(value == 'AUTO_DELEGATE'){
                    value = "<span class='action_dangerous'>自动转交</span>";
                }else if(value == 'PEER_REJECTED'){
                    value = "<span class='action_dangerous'>点对点退回</span>";
                }else if(value == 'PASS'){
                    value = "<span class='action_dangerous'>一键通过</span>";
                }else if(value == 'APPROVED_M'){
                    value = "<span class='action_dangerous'>同意</span>";
                }else if(value == 'APPROVED_QUA'){
                    value = "<span class='action_dangerous'>有条件同意</span>";
                }else if(value == 'REJECTED_M'){
                    value = "<span class='action_dangerous'>不同意</span>";
                }else if(value == 'SUSPEND_M'){
                    value = "<span class='action_dangerous'>再议</span>";
                }else if(value == 'SUSPEND'){
                    value = "<span class='action_dangerous'>再议</span>";
                }else if (value == 'CONDITION'){
                    value = "<span class='action_dangerous'>有条件通过</span>";
                }else if (value == 'REFUSE'){
                    value = "<span class='action_dangerous'>不通过</span>";
                }else if (value == 'APPROVE'){
                    value = "<span class='action_dangerous'>通过</span>";
                }else{
                    value = value || ''
                }
                return value;
            }
            return "";
        }

        <!--events-->
        function load_history_ds(ds) {
            //只是为了子页面调用
            currentTaskInfo.execution_variables = ds.data[0].data.variable_instances;
            //设置只读
            if(sonUrl.indexOf("?")){
                sonUrl += "&function_usage=QUERY&maintain_type=READONLY";
            }else{
                sonUrl += "?function_usage=QUERY&maintain_type=READONLY";
            }
            document.getElementById('includeFrame').src = sonUrl;
            var approveHistory = ds.data[0].data.historic_task_list;

            approveHistory.forEach(function (item) {
                $('process_instance_approve_history_ds').create({
                    "assignee": item.assignee,
                    "assignee_name": item.assignee_name,
                    "end_time": item.end_time,
                    "execution_id": item.execution_id,
                    "id": item.id,
                    "name": item.name,
                    "process_definition_id": item.process_definition_id,
                    "start_time": item.start_time,
                    "tenant_id": item.tenant_id,
                    "action": item.action,
                    "comment": item.comment
                });
            });
        }

        function onIncludeFrameLoad() {
            var ifm = document.getElementById("includeFrame");
            var subWeb = document.frames ? document.frames["includeFrame"].document : ifm.contentDocument;
            if (ifm != null && subWeb != null) {
                ifm.height = subWeb.body.scrollHeight + 20;
                ifm.width = subWeb.body.scrollWidth;
                if (parent.autoResizeIframe) {
                    parent.autoResizeIframe(_currentFunctionCode)
                }

            }
        }

        //项目跳转全屏
        function parent_hls_project_detail(param,prj_ds_id){
            if(param['function_code'] == 'PRJ110F1'){
                //变更
                param['hidden_button_code'] = ['user_button2', 'user_button3','user_button6'];
                hls_doc_get_layout_code(param, 'wfl_project_change_id', 'wfl_task_detail_query', param['function_code']);
            }else{
                hls_doc_get_layout_code(param, 'wfl_project_query_id', 'wfl_task_detail_query', param['function_code']);
            }

        }

        //立项跳转全屏
        function parent_hls_chance_detail(param,prj_ds_id){
            hls_doc_get_layout_code(param, 'wfl_chance_detail_id', 'wfl_task_detail_query', 'PRJ001');
        }

        //立项客户超链接
        function parent_bp_chance_detail(param,prj_ds_id){
            hls_doc_get_layout_code(param, 'process_wfl_bp100_bp_master_modify_id', 'wfl_task_detail_query', 'BP100');
        }


        ]]></script>
        <a:dataSets>
            <a:dataSet id="current_process_instance_detail_ds">
                <a:events>
                    <a:event name="load" handler="load_history_ds"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="process_instance_approve_history_ds">
                <a:fields>
                <a:field name="comment" readOnly="true"/><!--审批意见-->
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form title="审批事项" width="1100">
                <a:box column="2" labelWidth="133">
                    <a:label name="process_name" prompt="流程" bindTarget="current_process_instance_detail_ds" width="165"
                             readOnly="true"/>
                    <a:label name="start_time" prompt="申请时间" bindTarget="current_process_instance_detail_ds" width="165"
                             readOnly="true"/>
                </a:box>
                <a:box column="2" labelWidth="133">
                    <a:label name="start_user_name" prompt="申请人" bindTarget="current_process_instance_detail_ds"
                             width="165" readOnly="true"/>
                </a:box>

            </a:form>

            <a:form title="审批表单">
                <iframe onLoad="onIncludeFrameLoad()" width="1320" height="100" scrolling="yes" id="includeFrame"
                        style="border:0"/>
                <script><![CDATA[
                var screenWidth = $L.getViewportWidth()-40;
                var ifm = document.getElementById("includeFrame");
                ifm.width = screenWidth;
                ]]></script>
            </a:form>

            <a:tabPanel width="1320" height="450">
                <a:tabs>
                    <a:tab prompt="审批历史" width="130" selected="true"
                           bodyClassName="cls" bodyStyle="s">
<!--                        <a:form labelwidth="110">--><!--滚动条问题-->
                            <a:grid id="process_instance_history_grid" bindTarget="process_instance_approve_history_ds"
                                    width="1500" marginHeight="120"
                                    navBar="false">
                                <a:columns>
                                    <a:column name="end_time" width="230" prompt="处理时间" align="center"/>
                                    <a:column name="name" width="230" prompt="处理环节" align="center"/>
                                    <a:column name="assignee_name" width="210" prompt="处理人" align="center"/>
                                    <a:column name="action" width="210" prompt="处理动作" align="center"
                                              renderer="actionRender"/>
                                    <a:column name="comment" width="310" editor="process_instance_history_grid_textArea2" prompt="处理意见" align="center" showTitle="true" />
                                </a:columns>
                                <a:editors>
                                    <a:textArea id="process_instance_history_grid_textArea2"/>
                                </a:editors>
                            </a:grid>
<!--                        </a:form>-->
                    </a:tab>
                    <a:tab prompt="流程图" width="130"
                           bodyClassName="cls" bodyStyle="s">
                        <div class="tab-pane fade" id="processImg">
                            <embed id="svg" type="image/svg+xml"
                                   src="${/request/@context_path}/wfl/runtime/process-instances/${/parameter/@id}/diagram"/>
                        </div>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>

        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
