<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: jainfeng.fang
    $Date: 2020年03月04日
    $Revision: 1.0
    $Purpose: 保险管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="im100_insurance_detail_link"
                url="${/request/@context_path}/modules/IM/IM100H/im_insurance_management_detail.lview"/>
        <a:link id="im100_insurance_add_detail_link"
                url="${/request/@context_path}/modules/IM/IM100H/im_insurance_management_add_detail.lview"/>
        <script><![CDATA[
        function im_insurance_management_query() {
            $('im_insurance_management_result_ds').query();
        }

        function im_insurance_management_reset() {
            $('im_insurance_management_query_ds').reset();
            $('im_insurance_management_result_ds').query();
        }

        // 保险明细
        function detail_renderer(value, record, name) {
            if (name == 'detail') {
                return '<a href="javascript:im100h_open_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">明细</a>'
            }
            if (name == 'add_detail') {
                return '<a href="javascript:im100h_open_add_detail(\'' + record.ds.id + '\',\'' + record.id + '\')">明细</a>'
            }
        }

        function im_insurance_management_add() {
            var ds_id = $('im_insurance_management_result_ds');
            var records = ds_id.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '至少选择一个合同进行补录！');
                return false;
            }
            if (records.length > 1) {
                Leaf.showMessage('提示', '同一时间只能选择一个合同进行补录！');
                return false;
            }
            var param = records[0].data;
            param['url_title'] = '保险信息补录';
            param['function_code'] = 'IM100F3';
            param['function_usage'] = 'MODIFY';
            param['winid'] = 'im100f3_insurance_add_winid';
            hls_doc_get_layout_code(param, 'im100_insurance_add_detail_link', null, 'IM100H', null, null);

        }

        function im100h_open_detail(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '保险明细';
            param['function_code'] = 'IM100F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'im100f1_insurance_detail_winid';
            hls_doc_get_layout_code(param, 'im100_insurance_detail_link', null, 'IM100H', null, null);
        }

        function im100h_open_add_detail(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '保险明细';
            param['function_code'] = 'IM100F2';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'im100f2_insurance_add_detail_winid';
            hls_doc_get_layout_code(param, 'im100_insurance_add_detail_link', null, 'IM100H', null, null);
        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="im_insurance_management_query_ds" autoCreate="true">
            </a:dataSet>
            <a:dataSet id="im_insurance_management_result_ds" selectable="true" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/insure/con/contract/list/query"
                       queryDataSet="im_insurance_management_query_ds">
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton text="HLS.QUERY" click="im_insurance_management_query"/>
                <a:gridButton text="HLS.RESET" click="im_insurance_management_reset"/>
                <a:gridButton text="补充保险信息" click="im_insurance_management_add"/>
            </a:screenTopToolbar>
            <a:form column="4" title="查询条件" marginWidth="50" labelWidth="120">
                <a:textField name="contract_number" emptyText="合同编号" bindTarget="im_insurance_management_query_ds"
                             prompt="合同编号" width="160"/>
                <a:textField name="contract_name" emptyText="合同名称" bindTarget="im_insurance_management_query_ds"
                             prompt="合同名称" width="160"/>
                <a:textField name="bp_name" emptyText="客户名称" bindTarget="im_insurance_management_query_ds"
                             prompt="客户名称" width="160"/>
                <a:textField name="unit_name" emptyText="部门" bindTarget="im_insurance_management_query_ds"
                             prompt="部门" width="160"/>
            </a:form>
            <a:grid id="im_insurance_management_grid_id"
                    bindTarget="im_insurance_management_result_ds"
                    navBar="true" height="350" marginWidth="50">
                <a:columns>
                    <a:column name="contract_number" prompt="合同编号" width="150" align="center"/>
                    <a:column name="contract_name" prompt="合同名称" width="200" align="center"/>
                    <a:column name="bp_name" prompt="客户名称" width="200" align="center"/>
                    <a:column name="host_unit_name" prompt="部门" width="120" align="center"/>
                    <a:column name="host_project_manager_n" prompt="主办项目经理" width="120" align="center"/>
                    <a:column name="contract_status_desc" prompt="合同状态" width="120" align="center"/>
                    <a:column name="insure_category" prompt="投保险种" width="120"/>
                    <a:column name="detail" prompt="明细" align="center" width="80" renderer="detail_renderer"/>
                    <a:column name="add_detail" prompt="补充保险信息记录" align="center" width="120"
                              renderer="detail_renderer"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
