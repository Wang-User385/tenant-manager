<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="repayment_batch_ln_rep_select_link"
                url="${/request/@context_path}/modules/FIN/FIN006/lon_con_repayment_batch_ln_rep_select.lview"/>
        <a:link id="repayment_batch_ln_fin_select_link"
                url="${/request/@context_path}/modules/FIN/FIN006/lon_con_repayment_batch_ln_fin_select.lview"/>
        <a:link id="fin006f1_tikuan_lon_detail_id" url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON340A/lon_contract_withdraw_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_fin006_lon_contract_id"
                url="${/request/@context_path}/modules/LON/LON_CONTRACT/LON001/lon_contract_apply.lview"/>
        <script><![CDATA[
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var lon_con_repayment_batch_ln_id_a = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_repayment_batch_ln','G_REPAYMENT_INFO');
            var lon_con_repayment_batch_ln_id_b = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_repayment_batch_ln','G_PAY_INFO');
            if (ds.id === lon_con_repayment_batch_ln_id_a && ('${/parameter/@function_usage}' !== 'QUERY') && record) {
                //如果现金流类型为利息则可以编辑还款金额，点确认会刷新原现金流表
                if( record.get("cf_item") !== 302){
                    record.getField('planned_due_amount').setReadOnly(true);
                }
            }

            if(record && (ds.id === lon_con_repayment_batch_ln_id_b || ds.id === lon_con_repayment_batch_ln_id_a)){
                if(!record.get("out_bank_account_id")){
                    record.set("out_bank_account_id",record.get("with_bank_account_id"));
                    record.set("out_bank_account_id_n",record.get("with_bank_account_name"));
                    record.set("out_bank_account_name",record.get("with_bank_account_name"));
                    record.set("out_bank_account_num",record.get("with_bank_account_num"));
                }
                if(!record.get("repayment_date")){
                    record.set("repayment_date",record.get("planned_calc_date"));
                }
            }
        }


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {

            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_con_repayment_batch_ds';
            var base_record = $(base_ds_id).getCurrentRecord();

            if(ds.id == '${/parameter/@layout_code}_G_TRANSFER_lon_con_bank_acc_transfer_ds'){
                record.set('batch_id',base_record.get('batch_id'));
                record.set('out_payment_id','${/parameter/@lon_company_id}');
                record.set('out_payment_id_n','${/parameter/@lon_company_id_n}');
                record.set('in_payment_id','${/parameter/@credit_bp_id}');
                record.set('in_payment_id_n','${/parameter/@credit_bp_name}');
                record.set('payment_amount',base_record.get('repayment_amount_total'));;

            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            if(ds.id == '${/parameter/@layout_code}_G_REPAYMENT_INFO_lon_con_repayment_batch_ln_ds'){
                qpara['interest_flag'] = 'Y';
            }
            if(ds.id == '${/parameter/@layout_code}_G_PAY_INFO_lon_con_repayment_batch_ln_ds'){
                qpara['interest_flag'] = 'Y';
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };

        //移除事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_remove'] = function(ds, record, bp_seq) {

            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_con_repayment_batch_ds';
            var base_record = $(base_ds_id).getCurrentRecord();
            if(ds.id == '${/parameter/@layout_code}_G_REPAYMENT_INFO_lon_con_repayment_batch_ln_ds'){
                var repayment_amount_total = base_record.get('repayment_amount_total');
                if(repayment_amount_total != null && repayment_amount_total != '' && record.get('planned_due_amount') != null && record.get('planned_due_amount') != ''){
                    repayment_amount_total = minus(repayment_amount_total,record.get('planned_due_amount'));
                }
                base_record.set('repayment_amount_total', repayment_amount_total);
            }

            if(ds.id == '${/parameter/@layout_code}_G_PAY_INFO_lon_con_repayment_batch_ln_ds'){
                var repayment_amount_total = base_record.get('repayment_amount_total');
                if(repayment_amount_total != null && repayment_amount_total != '' && record.get('planned_due_amount') != null && record.get('planned_due_amount') != ''){
                    repayment_amount_total = minus(repayment_amount_total,record.get('planned_due_amount'));
                }
                base_record.set('repayment_amount_total', repayment_amount_total);
            }
        };


        //确认
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var root_ds = $('${/parameter/@layout_code}_virtual_ds');

            root_ds.submit();
            root_ds.on('submitsuccess', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_repayment_batch');
                var record = $(ds_id).getCurrentRecord();
                var data = [];
                data.push({batch_id:record.get("batch_id")});
                Leaf.showOkCancelWindow('提示','您确定执行此操作吗？',function(){
                    Leaf.request({
                        url: '${/request/@context_path}/lon/con/repayment/batch/confirm',
                        para: data,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示','操作成功！');
                            $('${/parameter/@winid}').close();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        sync: true,
                        scope: this
                    });
                }, function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }, 200, 200);

            });

        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //alert(name);
            var link_function = 'fin006f1_lon_contract_withdraw_detail';
            if(name == 'withdraw_number'&&value){
                link_function = 'fin006f1_lon_contract_withdraw_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
            if(name == 'contract_number'&&value){
                link_function = 'fin006f1_lon_contract_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">' + value + '</a>';
            }
            if(name == 'upload_download' && record.get('invoice_id')){
                link_function = 'fin006f1_lon_contract_invoice_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.id + '\');">上传/下载</a>';
            }
        };

        function fin006f1_lon_contract_withdraw_detail(ds_id,record_id){
            var record = $(ds_id).findById(record_id);
            var editFlag = 'Y';
            var changeFlag='N';
            if(record.get('withdraw_id') != null){
                var param = {};
                param['withdrawId'] = record.get('withdraw_id');
                param['function_code'] = 'FIN003S3';
                param['function_usage'] = 'QUERY';
                param['editFlag'] = editFlag;
                param['changeFlag'] = changeFlag;
                param['url_title'] = '融资提款详细信息';
                hls_doc_get_layout_code(param, 'fin006f1_tikuan_lon_detail_id', ds_id, 'FIN003S1');
            }
        }

        function fin006f1_lon_contract_detail(ds_id,record_id){
            var record2 = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '融资合同明细';
            var contract_status = record2.get('settle_status_desc');
            param['function_code'] = 'FIN003F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['contract_id'] = record2.get('contract_id');
            param['document_id'] = record2.get('contract_id');
            param['company_id'] = '${/session/@companyId}';
            // param['layout_debugger_flag'] = 'Y';

            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_fin006_lon_contract_id', ds_id, 'FIN006');
        }

        function fin006f1_lon_contract_invoice_detail(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var invoice_id = record.get('invoice_id');
            var url;
            if ('${/parameter/@function_usage}' == 'MODIFY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'fin006_open_attachment_winid',
                url: url,
                params: {
                    'header_id': invoice_id,
                    'table_name': 'LON_CONTRACT_INVOICE',

                    winid: 'fin006_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            // win.on('close', function () {
            //     var document_list_ds_id = "${/parameter/@layout_code}_G_LON_INVOICE_lon_contract_invoice_ds";
            //     $(document_list_ds_id).query();
            // });
        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_con_repayment_batch_ds';
            $(base_ds_id).query();
        };

        function beforeSubmit(countiune) {

            var base_ds_id = '${/parameter/@layout_code}_F_BASE_INFO_lon_con_repayment_batch_ds';
            var base_record = $(base_ds_id).getCurrentRecord();
            if('${/parameter/@check_confirm_flag}' == 'Y'){
                if(base_record.get('confirm_status') != 'Y'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "资金调拨单未确认,不能进行支付！");
                    return ;
                }
            }
            var batch_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_con_repayment_batch');
            $(batch_ds_id).on("submitsuccess", function (ds, record, name, newValue, oldValue) {
                countiune();
                return true;
            });
            $(batch_ds_id).submit();
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>