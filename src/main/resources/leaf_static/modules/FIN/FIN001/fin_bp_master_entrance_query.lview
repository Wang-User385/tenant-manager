<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="FIN001_BP_CREATE_ID"
                url="${/request/@context_path}/modules/FIN/FIN001/fin_bp_master_create.lview"/>
        <script><![CDATA[
        //创建融资机构
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var param = {};
            param['url_title'] = '融资机构创建';
            param['function_code'] = 'FIN001F1';
            param['function_usage'] = 'CREATE';
            param['bp_category'] = 'HLS_BP_CREDIT';
            param['document_category'] = 'HLS_BP_CREDIT';
            param['document_type'] = 'HLS_BP_CREDIT';
            param['business_type'] = 'HLS_BP_CREDIT';
            param['winid'] = 'fin001_bp_create_winid';
            hls_doc_get_layout_code(param, 'FIN001_BP_CREATE_ID', null, 'FIN001F1', null, null, '${/parameter/@layout_code}_autoQuery');
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'bp_code') {
                return '<a href="javascript:open_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            // var param = record.data;
            param['url_title'] = '融资机构查询';

            if (!(record.get("bp_id") == undefined)) {
                param['function_code'] = 'FIN001F1MTQUERY';
                param['function_usage'] = 'QUERY';
                param['bp_id'] = record.get("bp_id");
            }
            param['winid'] = 'fin_bp_modify_winid';
            hls_doc_get_layout_code(param, 'FIN001_BP_CREATE_ID', null, 'FIN001F1MTQUERY', null, null, '${/parameter/@layout_code}_autoQuery');
        }

        window['${/parameter/@layout_code}_autoQuery'] = function () {
            var ds_id = 'FIN001_G_CREDITBP_RESULT_hls_bp_master_ds';
            $(ds_id).query();
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>