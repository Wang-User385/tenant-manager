<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
     <!--   <a:link id="lon_credit_line_detail_link_id"
                url="${/request/@context_path}/modules/FIN/FIN002/lon_credit_line.lview"/>-->
        <script><![CDATA[
      /*  //创建
        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_credit_contract');
