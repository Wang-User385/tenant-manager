            hls_doc_get_layout_code(param, 'lon_credit_line_detail_link_id', ds_id, 'FIN002');
        };*/

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if (ds.bindname === "FIN002_G_LON_CREDIT_LINE_lon_credit_contract") {
                ds.setQueryParameter('data_class', 'NORMAL');
            }
        }

        /*超链接渲染*/
       /* window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = '${/parameter/@layout_code}_lon_credit_line_detail';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'credit_con_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + record.get('credit_con_number') + '</a>';
            }
        };*/
    /*    window['${/parameter/@layout_code}_lon_credit_line_detail'] = function (record_id, name) {
            var record = window['${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_credit_contract');
            var credit_contract_id = record.get("credit_contract_id");
            var param = {};
            param['url_title'] = '融资授信明细';
            param['function_code'] = 'FIN002F1';
            param['function_usage'] = 'MODIFY';
            param['credit_contract_id']=credit_contract_id;
            param['winid'] = 'lon_credit_line_modify_winId';
            hls_doc_get_layout_code(param, 'lon_credit_line_detail_link_id', null, 'FIN002',null,null,'${/parameter/@layout_code}_autoQuery');
        }
*/
        //保存前调用校验融资机构和获取融资机构编码
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            //debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_credit_contract');
            //var datas = $(ds_id).getJsonData();
            var datas = $(ds_id).getCurrentRecord();
            var check_flag = true;
            if(datas.get('credit_line_amt')<0||datas.get('credit_unexposure_amt')<0){
                Leaf.showMessage('提示','总额度必须为正数！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return false;
            }

            //只有新增才触发这个校验,修改不触发
            if(Ext.isEmpty(record.get("credit_contract_id"))){
                Leaf.request({
                    url: '${/request/@context_path}/hlsLon/credit/contract/queryByCreditBpId',
                    para: {
                        credit_bp_id:datas.get('credit_bp_id')
                    },
                    success: function (res) {
                        //debugger;
                        var records = res.result.record;
                        // 融资机构重复授信校验
                        if (records.length > 0&&(datas.get('credit_bp_id')==records[0].credit_bp_id)) {
                            check_flag = false;
                            Leaf.showMessage('${l:HLS.PROMPT}','该融资机构已授信！');
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            return false;
                        }
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }

            if (!check_flag) {
                return false;
            }


            var document_category = 'LON_CREDIT_CONTRACT';
            var document_type = 'LON_CREDIT';

            var re_data = record.ds.data;
            if (re_data.length > 0) {
                for(var i = 0; i < re_data.length; i++){
                    var curr = re_data[i];
                    if (curr.data.date_from > curr.data.date_to) {
                        Leaf.showMessage('提示','授信有效期从不能大于授信有效期到！');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }
            }

            var business_type = 'LON_CREDIT_CONTRACT';
            if (record.get('credit_con_number')) {
                return true;

            }

            if (record.get('credit_line_amt') < record.get('credit_exposure_amt')) {
                Leaf.showMessage('提示！', '总额度需大于已用额度！');
                return false;
            }


                Leaf.request({
                url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_credit_contract');
                    $(ds_id).getCurrentRecord().set('credit_con_number', res.result.record[0]);
                    check_flag = true;
                },
                error: function (res) {
                    //record.set('credit_con_number', res.result.record[0]);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                },
                failure: function (res) {
                    //record.set('credit_con_number', res.result.record[0]);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    check_flag = false;
                },
                sync: true,
                scope: this
            });
            return check_flag;
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var head_record = ds.getCurrentRecord();

            head_record.set('data_class','NORMAL');
            head_record.set('company_id','${/session/@company_id}');
            head_record.set('document_type','LON_CREDIT');
            head_record.set('document_category','LON_CREDIT_CONTRACT');
            head_record.set('business_type','LON_CREDIT_CONTRACT');


            head_record.set('created_by','${/session/@user_id}');
            head_record.set('creation_name','${/session/@employeeName}');

        };
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lon_credit_contract');
            if(ds.id === ds_id){
                if (name == 'credit_line_amt') {
                    if(!record.get('credit_exposure_amt')){
                        record.set('credit_exposure_amt',0.00)

                    }
                    record.set('credit_unexposure_amt',record.get('credit_line_amt')-record.get('credit_exposure_amt'))
                }
            }
        };
        function fin002_open_attach(credit_contract_id, table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'fin002_open_attachment_winid',
                url: url,
                params: {
                    header_id: credit_contract_id,
                    table_name: table_name,
                    winid: 'fin002_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });

        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {


            if (name == 'file') {
                if (record.get('credit_contract_id')) {
                    var table_name = 'lon_credit_contract';
                    return '<a href="javascript:fin002_open_attach(\'' + record.get('credit_contract_id') + '\',\'' + table_name + '\')">附件</a>';

                }
            }

            return value;
        };
          ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>