<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: gq
    $Date: 2021-05-10
    $Description: 租金催收
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
            //邮件发送
            window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
               debugger;
                var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                var arr_records = $(att_ds_id).getSelected();
                if(arr_records.length == 0){
                    Leaf.showMessage('提示','请选择一条记录！');
                }else{
                    var params = [];
                    for(var i=0;i<arr_records.length;i++){
                        arr_records[i].set('bp_id','${/parameter/@tenant_id}');
                        params.push(arr_records[i].data);
                    }
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '是否确认发送?', function okFun() {
                        Leaf.request({
                            type: 'POST',
                            url: '${/request/@context_path}/con/rent/email/send',
                            para: params,
                            contentType: 'application/json; charset=UTF-8',
                            async: false,
                            success: function (res) {
                                if(res.success){
                                    Leaf.SideBar.show({
                                        msg: '确认成功',
                                        duration: 1000
                                    });
                                }else{
                                    Leaf.showMessage('提示',datas.message);
                                }
                            },
                            failure: function (data) {
                                Leaf.showMessage('提示',datas.message);
                            },
                            error: function (data) {
                                Leaf.showMessage('提示',datas.message);
                            },
                        });
                    })
                }
            }

            //超链接渲染
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
                debugger;
                var link_function = 'upload_file';
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
                var project_attachment_id = record.get('project_attachment_id');
                if (name == 'download') {
                    return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">下载</a>';
                }
                if (name == 'upload') {
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">附件</a>';
                }
                if (name == 'attachment_data_t' && project_attachment_id) {
                    link_function = 'prj_attachement_upload';
                    var file_number = record.get('file_number');
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">' + '附件上传(' + file_number + ')' + '</a>';
                }
                if (name == 'file_name'){
                    if(record.get('file_name') != null && record.get('attachment_id_list') != null) {
                        var html = '';
                        var fileNameList = record.get('file_name').split(',');
                        var attachmentIdList = record.get('attachment_id_list').split(',');
                        for(var  i = 0; i < fileNameList.length; i++){
                            if(html != ''){
                                html += ',';
                            }
                            if(atmTypeRef(fileNameList[i])){
                                html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                            }else if(checkPdf(fileNameList[i])){
                                var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                                html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                            }else{
                                html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                            }

                        }
                        return html;
                    }
                }
            }

        function atmTypeRef(name){
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }
        function checkPdf(name){
            return /\.(pdf)$/i.test(name)
        }

            window['prj_attachement_upload'] = function (record_id, ds_id) {
                var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                var url;
                url = '${/request/@context_path}/downloadFile.lview';
                var table_name;

                table_name = 'HLS_PRJ_PROJECT_DOCX4';
                var win = new Leaf.Window({
                    id: 'cn100F3_open_attachment_winid',
                    url: url,
                    params: {
                        'header_id': ds_id,
                        'table_name': table_name,
                        winid: 'cn100F3_open_attachment_winid'
                    },
                    title: '文件下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(document_list_ds_id).query();
                });
            };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
