<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        $L.onReady(function (){
            $('archive_detail_ds').setQueryParameter('contract_id',"${/parameter/@contract_id}")
            $('archive_detail_ds').setQueryParameter('status',"detail")
            $('archive_detail_ds').query()
        });


        ]]></script>
        <a:dataSets>
            <a:dataSet id="archive_detail_query_ds">
                <a:fields>
                    <a:field name="contract_id"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="archive_detail_ds" queryDataSet="archive_detail_query_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/contract/archive/attachment/selectAll?wflRuleControlFlag=Y" selectable="true">
                <a:fields>
                    <a:field name="contract_id"/>
                    <a:field name="record_id"/>
                    <a:field name="file_name_id"/>
                    <a:field name="contract_archive_id"/>
                    <a:field name="file_category_n"/>
                    <a:field name="file_name"/>
                    <a:field name="attachment_name"/>
                    <a:field name="attachment"/>
                    <a:field name="copies"/>
                    <a:field name="upload_date" datatype="date"/>
                    <a:field name="remarks"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:grid id="archive_detail_ds_grid" bindTarget="archive_detail_ds" marginHeight="270"
                    marginWidth="100"
                    navBar="true">
                <a:columns>
                    <a:column name="record_id" hidden="true"/>
                    <a:column name="contract_id" hidden="true"/>
                    <a:column name="file_name_id" prompt="文件名称Id" hidden="true"/>
                    <a:column name="contract_archive_id" prompt="档案归档Id" hidden="true"/>
                    <a:column name="file_category_n" prompt="文件分类" width="180" align="left"/>
                    <a:column name="file_category" prompt="文件分类" hidden="true"/>
                    <a:column name="file_name" prompt="文件名称" width="180" align="left" />
                    <a:column name="attachment_name" prompt="附件名称" width="180" align="left" />
                    <a:column name="copies" prompt="附件份数" width="180" align="left" />
                    <a:column name="upload_date" prompt="文件日期" width="180" align="left" renderer="Leaf.formatDate"/>
                    <a:column name="remarks" prompt="备注" width="180" align="left" />
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>

</a:screen>