<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        function archive_upload_query() {
            $('archive_upload_ds').query()
        }

        function archive_upload_save() {
            debugger
            var records = $('archive_upload_ds').getAll();
            var data = [];
            for (var i = 0; i < records.length; i++) {
                records[i].set('contract_id', "${/parameter/@contract_id}");
                records[i].set('contract_archive_id', "${/parameter/@contract_archive_id}");
                data.push(records[i].data);
            }
            Leaf.request({
                url: "${/request/@context_path}/contract/archive/attachment/save",
                para: data,
                success: function (res) {
                    Leaf.showMessage('提示', '提交成功!')
                    archive_upload_query();
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                }
            });
        }

        function archive_upload_delete() {
            debugger
            var records = $('archive_upload_ds').selected
            for (let i = 0; i < records.length; i++) {
                if (!records[i].isNew) {
                    Leaf.showMessage('提示', '请选择未保存的新增记录!')
                    return
                }
            }
            $('archive_upload_ds_grid').clear()
        }

        function onQuery_archive_upload_ds() {
            // $('archive_upload_ds').setQueryParameter('archive_type',"${/parameter/@archive_type}")
            $('archive_upload_ds').setQueryParameter('contract_id', "${/parameter/@contract_id}")
            $('archive_upload_ds').setQueryParameter('status', "upload")
            $('archive_upload_query_ds').getCurrentRecord().set('contract_name', "${/parameter/@contract_name}");
            $('archive_upload_query_ds').getCurrentRecord().set('contract_number', "${/parameter/@contract_number}");
            $('archive_upload_query_ds').getCurrentRecord().set('legal_contract_number', "${/parameter/@legal_contract_number}");
            $('archive_upload_query_ds').getCurrentRecord().set('bp_name', "${/parameter/@bp_name}");
            $('archive_upload_query_ds').getCurrentRecord().set('host_project_manager_n', "${/parameter/@host_project_manager_n}");
        }

        function render_archive_upload_ds(value, record, name) {
            if (!record.isNew) {
                if (name === 'attachment') {
                    return '<a href="javascript:winOpen_attachment(\'' + record.get('file_category') + '\',\'' + record.get('file_name_id') + '\');">上传</a>';
                }
                return '';
            }
            return '';
        }


        function winOpen_attachment(file_category, file_name_id) {
            var table_name;
            if (file_category === "HLS_CREDIT_LINE_CHANCE") {
                table_name = 'HLS_CREDIT_LINE_CHANCE';
            }
            if (file_category === "PRJ_BP_CZ" || file_category === "PRJ_BP_DB" || file_category === "PRJ_LEASE" || file_category === "CON_CONTRACT_ATT") {
                table_name = 'PRJ_PROJECT_ATTACHMENT'
            }
            if (file_category === "PRJ_PROJECT_JD") {
                table_name = 'PRJ_PROJECT_JD'
            }
            if (file_category === "prj_project_attachment" ) {
                table_name = 'prj_project_attachment'
            }
            if (file_category === "ONLINE_SIGN_CONTRACT" ) {
                table_name = 'ONLINE_SIGN_CONTRACT'
            }
            if (file_category === "CON_PAYMENT" || file_category === "RETAIL_PAYMENT") {
                table_name = 'csh_payment_attachment'
            }
            if (file_category === "OTHER") {
                table_name = 'con_contract_archive_multi'
            }
            if (file_category === "RISK_ATT") {
                table_name = 'plm_risk_warning'
            }
            if (file_category === "PRJ_CHECK_ATT") {
                table_name = 'prj_check'
            }
            var win = new Leaf.Window({
                id: 'open_attachment_winid',
                url: '${/request/@context_path}/downloadFile.lview',
                params: {
                    header_id: file_name_id,
                    table_name: table_name,
                    winid: 'open_attachment_winid',
                    function_usage: "UPLOAD"
                },
                title: '附件上传',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('archive_upload_ds').query();
            });
        }

        function archive_upload_editor(record, name) {
            if (name === 'file_category_n') {
                if (record.isNew) {
                    return 'archive_type_ds_grid_combo';
                }
                return '';
            }
            return '';
        }


        Leaf.onReady(function () {
            var status = '${/parameter/@status}';
            if (status == 'CONFIRM') {
                document.getElementById('archive_upload_delete_id').style.display = "none";
            }

            var document_type = '${/parameter/@document_type}';
            if (document_type == 'PRJL' || document_type == 'PRJLB') {

                $('archive_type_upload_select_ds').create({"code_value": "RETAIL_PAYMENT", "code_value_name": "零售放款资料"});
                $('archive_type_upload_select_ds').create({"code_value": "prj_project_attachment", "code_value_name": "零售合同资料"});
                $('archive_type_upload_select_ds').create({"code_value": "ONLINE_SIGN_CONTRACT", "code_value_name": "零售合同资料"});
            } else{
                $('archive_type_upload_select_ds').create({"code_value": "CON_PAYMENT", "code_value_name": "放款资料"});
                $('archive_type_upload_select_ds').create({"code_value": "CON_CONTRACT_ATT", "code_value_name": "合同资料"});
            }
        });

        ]]></script>
        <a:dataSets>
            <a:dataSet id="archive_type_upload_select_ds">
                <a:datas>
                    <a:record code_value="HLS_CREDIT_LINE_CHANCE" code_value_name="立项资料"/>
                    <a:record code_value="PRJ_BP_CZ" code_value_name="尽调资料（承租人）"/>
                    <a:record code_value="PRJ_BP_DB" code_value_name="尽调资料（担保人）"/>
                    <a:record code_value="PRJ_LEASE" code_value_name="尽调资料（租赁物）"/>
                    <a:record code_value="PRJ_PROJECT_JD" code_value_name="审批意见资料"/>
                    <!--<a:record code_value="CON_CONTRACT_ATT" code_value_name="合同资料"/>-->
                    <!--<a:record code_value="CON_PAYMENT" code_value_name="放款资料"/>-->
                    <a:record code_value="RISK_ATT" code_value_name="租后资料（风险预警）"/>
                    <a:record code_value="PRJ_CHECK_ATT" code_value_name="租后资料（租后检查）"/>
                    <a:record code_value="OTHER" code_value_name="其他"/>
                </a:datas>
            </a:dataSet>
            <a:dataSet id="archive_upload_query_ds">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="legal_contract_number"/>
                    <a:field name="contract_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="host_project_manager_n"/>
                    <a:field name="contract_id"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="archive_upload_ds" queryDataSet="archive_upload_query_ds" autoQuery="true"
                       submitUrl="${/request/@context_path}/contract/archive/attachment/save"
                       queryUrl="${/request/@context_path}/contract/archive/attachment/selectAll" selectable="true">
                <a:fields>
                    <a:field name="contract_id"/>
                    <a:field name="record_id"/>
                    <a:field name="file_name_id"/>
                    <a:field name="contract_archive_id"/>
                    <a:field name="file_category_n" required="true" options="archive_type_upload_select_ds"
                             displayField="code_value_name" valueField="code_value"
                             returnField="file_category"/>
                    <a:field name="file_name"/>
                    <a:field name="attachment_name"/>
                    <a:field name="attachment"/>
                    <a:field name="copies"/>
                    <a:field name="upload_date" datatype="date"/>
                    <a:field name="remarks"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_archive_upload_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTitle/>
            <a:form column="4" labelWidth="50" title="合同信息">
                <a:textField name="legal_contract_number" width="120" readOnly="true" prompt="法务合同编号"
                             bindTarget="archive_upload_query_ds"/>
                <a:textField name="contract_name" width="120" readOnly="true" prompt="合同名称"
                             bindTarget="archive_upload_query_ds"/>
                <a:textField name="bp_name" width="120" readOnly="true" prompt="客户名称"
                             bindTarget="archive_upload_query_ds"/>
                <a:textField name="host_project_manager_n" width="120" readOnly="true" prompt="业务经理"
                             bindTarget="archive_upload_query_ds"/>
            </a:form>
            <a:screenTopToolbar>
                <a:gridButton bind="archive_upload_ds_grid" type="add" text="新增"/>
                <a:gridButton id="archive_upload_delete_id" click="archive_upload_delete" text="删除"/>
                <a:gridButton click="archive_upload_save" text="保存"/>
            </a:screenTopToolbar>
            <a:grid id="archive_upload_ds_grid" bindTarget="archive_upload_ds" marginHeight="270"
                    marginWidth="20" width="1000"
                    navBar="true">
                <a:columns>
                    <a:column name="record_id" hidden="true"/>
                    <a:column name="contract_id" hidden="true"/>
                    <a:column name="file_name_id" prompt="文件名称Id" hidden="true"/>
                    <a:column name="contract_archive_id" prompt="档案归档Id" hidden="true"/>
                    <a:column name="file_category_n" prompt="文件分类" width="180" align="left"
                              editorFunction="archive_upload_editor"/>
                    <a:column name="file_category" prompt="文件分类" hidden="true"/>
                    <a:column name="file_name" prompt="文件名称" editor="archive_upload_ds_grid_tf" width="180"
                              align="left"/>
                    <a:column name="attachment_name" prompt="附件名称" width="180" align="left"/>
                    <a:column name="attachment" prompt="附件" width="180" align="left"
                              renderer="render_archive_upload_ds"/>
                    <a:column name="copies" prompt="附件份数" width="130" align="left"/>
                    <a:column name="upload_date" prompt="上传日期" width="130" align="left" renderer="Leaf.formatDate"/>
                    <a:column name="remarks" prompt="备注" editor="archive_upload_ds_grid_tf" width="180" align="left"/>
                </a:columns>
                <a:editors>
                    <a:comboBox id="archive_type_ds_grid_combo"/>
                    <a:textField id="archive_upload_ds_grid_tf"/>
                </a:editors>
            </a:grid>

        </a:screenBody>
    </a:view>

</a:screen>
