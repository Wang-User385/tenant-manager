<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
            function onQuery_archive_download_ds() {
                $('archive_download_ds').setQueryParameter('contract_id',"${/parameter/@contract_id}")
                $('archive_download_ds').setQueryParameter('status',"download")
                $('archive_download_query_ds').getCurrentRecord().set('contract_number',"${/parameter/@contract_number}");
                $('archive_download_query_ds').getCurrentRecord().set('legal_contract_number',"${/parameter/@legal_contract_number}");
                $('archive_download_query_ds').getCurrentRecord().set('contract_name',"${/parameter/@contract_name}");
                $('archive_download_query_ds').getCurrentRecord().set('bp_name',"${/parameter/@bp_name}");
                $('archive_download_query_ds').getCurrentRecord().set('host_project_manager_n',"${/parameter/@host_project_manager_n}");
            }

            function archive_download_query() {
                $('archive_download_ds').query()
            }
            
            function archive_download_download() {
                debugger
                var param=$('archive_download_ds').getSelected().map((v)=>v.data);
                if (param.length === 0) {
                    Leaf.showMessage('提示','请至少选择一行!')
                    return
                }
                for (let i = 0; i < param.length; i++) {
                    if (param[i].copies === "0") {
                        Leaf.showMessage('提示','请选择附件份数不为零的!')
                        return
                    }
                }
                Leaf.request({
                    url: "${/request/@context_path}/contract/archive/attachment/selectAttachIds",
                    para: param,
                    success: function (res) {
                        debugger
                        var attachmentIds = '';
                        for (let i = 0; i < res.result.totalCount; i++) {
                            attachmentIds += res.result.record[i] + ',';
                        }
                        var down_url;
                        down_url = "${/request/@context_path}/contract/archive/attachment/downloadFile?attachment_id=" + attachmentIds;
                        location.href = down_url;

                        /*
                        //非打包下载
                        var attachmentList = []
                        for (let i = 0; i < res.result.totalCount; i++) {
                            attachmentList.push(res.result.record[i]);
                        }

                        for (let i = 0; i < attachmentList.length; i++) {
                            var a = document.createElement('a');
                            a.href = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachmentList[i];
                            a.download = 'filename';
                            a.click();
                        }*/
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    }
                });
            }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="archive_download_query_ds">
                <a:fields>
                    <a:field name="contract_number"/>
                    <a:field name="legal_contract_number"/>
                    <a:field name="contract_name"/>
                    <a:field name="bp_name"/>
                    <a:field name="host_project_manager_n"/>
                    <a:field name="contract_id"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="archive_download_ds" queryDataSet="archive_download_query_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/contract/archive/attachment/selectAll" selectable="true">
                <a:fields>
                    <a:field name="contract_id"/>
                    <a:field name="record_id"/>
                    <a:field name="file_name_id"/>
                    <a:field name="contract_archive_id"/>
                    <a:field name="file_category_n"/>
                    <a:field name="file_name"/>
                    <a:field name="attachment_name"/>
                    <a:field name="attachment"/>
                    <a:field name="copies"/>
                    <a:field name="upload_date" datatype="date"/>
                    <a:field name="remarks"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="onQuery_archive_download_ds"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="archive_download_download" text="下载"/>
            </a:screenTopToolbar>
            <a:form column="4" labelWidth="50" title="合同信息" >
                <a:textField name="legal_contract_number" width="120" readOnly="true" prompt="法务合同编号" bindTarget="archive_download_query_ds"/>>
                <a:textField name="contract_name" width="120" readOnly="true" prompt="合同名称" bindTarget="archive_download_query_ds"/>
                <a:textField name="bp_name" width="120" readOnly="true" prompt="客户名称" bindTarget="archive_download_query_ds"/>
                <a:textField name="host_project_manager_n" width="120" readOnly="true" prompt="业务经理" bindTarget="archive_download_query_ds"/>
            </a:form>
            <a:grid id="archive_download_ds_grid" bindTarget="archive_download_ds" marginHeight="270"
                    marginWidth="100"
                    navBar="true">
                <a:columns>
                    <a:column name="record_id" hidden="true"/>
                    <a:column name="contract_id" hidden="true"/>
                    <a:column name="file_name_id" prompt="文件名称Id" hidden="true"/>
                    <a:column name="contract_archive_id" prompt="档案归档Id" hidden="true"/>
                    <a:column name="file_category_n" prompt="文件分类" width="180" align="left"/>
                    <a:column name="file_category" prompt="文件分类" hidden="true"/>
                    <a:column name="file_name" prompt="文件名称" width="180" align="left" />
                    <a:column name="attachment_name" prompt="附件名称" width="180" align="left" />
                    <a:column name="copies" prompt="附件份数" width="180" align="left" />
                    <a:column name="upload_date" prompt="文件日期" width="180" align="left" renderer="Leaf.formatDate"/>
                    <a:column name="remarks" prompt="备注" width="180" align="left" />
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>

</a:screen>