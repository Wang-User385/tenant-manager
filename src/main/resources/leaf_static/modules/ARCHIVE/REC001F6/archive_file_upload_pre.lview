<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="REC001F6_ARCHIVE_FILE_UPLOAD_LINK"
                url="${/request/@context_path}/modules/ARCHIVE/REC001F6/archive_file_upload.lview"/>
        <script><![CDATA[
        function confirmClick() {
            var data = $('archive_type_select_ds').getJsonData()[0];
            new Leaf.Window({
                id: 'archive_file_upload',
                url: '${/request/@context_path}/modules/ARCHIVE/REC001F6/archive_file_upload.lview',
                // width:1275,
                // height:570,
                fullScreen: true,
                params: {
                    contract_id: "${/parameter/@contract_id}",
                    archive_type: data.archive_type,
                    contract_archive_id: "${/parameter/@contract_archive_id}",
                    contract_name:"${/parameter/@contract_name}",
                    bp_name:"${/parameter/@bp_name}",
                    host_project_manager_n:"${/parameter/@host_project_manager_n}",
                    winId: 'archive_file_upload_id'
                },
                draggable: false,
                closeable: true
            });
            $('${/parameter/@winid}').close();
        }

        function quitClick() {
            $('${/parameter/@winid}').close();
        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="archive_type_select_ds" autoCreate="true">
                <a:fields>
                    <a:field name="archive_type" defaultValue="HLS_CREDIT_LINE_CHANCE"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody>
            <a:form>
                <a:box column="1">
                    <a:radio bindTarget="archive_type_select_ds" name="archive_type" width="135" radioSeparator="">
                        <a:items>
                            <a:item label="立项资料" value="HLS_CREDIT_LINE_CHANCE"/>
                            <a:item label="尽调资料（承租人）" value="PRJ_BP_CZ"/>
                            <a:item label="尽调资料（担保人）" value="PRJ_BP_DB"/>
                            <a:item label="尽调资料（租赁物）" value="PRJ_LEASE"/>
                            <a:item label="审批意见资料" value="PRJ_PROJECT_JD"/>
                            <a:item label="合同资料" value="CON_CONTRACT_ATT"/>
                            <a:item label="放款资料" value="CON_PAYMENT"/>
                            <a:item label="其他" value="OTHER"/>
                            <a:item label="放款资料" value="RETAIL_PAYMENT"/>
                            <a:item label="合同资料" value="prj_project_attachment"/>
                            <a:item label="合同资料" value="ONLINE_SIGN_CONTRACT"/>
                        </a:items>
                    </a:radio>
                </a:box>
                <a:box column="2">
                    <input onclick="confirmClick()" style="margin-left:5px;margin-top:10px;width:60px;height:23px;" type="button" value="确认"/>
                    <input onclick="quitClick()" style="margin-left:5px;margin-top:10px;width:60px;height:23px" type="button" value="取消"/>
                </a:box>
            </a:form>
        </a:screenBody>
    </a:view>

</a:screen>
