<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <script><![CDATA[
        $L.onReady(function (){

        });

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            //档案编号渲染
            // if (name === 'contract_archive_number') {
            //     return '<a href="javascript:open_detail(\'' + record.id + '\',\'' + record.ds.id + '\')">'+record.data.contract_archive_number+'</a>';
            // }
            //文档明细渲染
            if (name === 'document_details') {
                return '<a href="javascript:open_detail(\'' + record.id + '\',\'' + record.ds.id + '\')">查看文档</a>';
            }
            return value;
        };

        //查看详情
        function open_detail(record_id,ds_id) {
            debugger
            // var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_archive');
            // var ds = $(ds_id);
            // var records = ds.getSelected();

            var record = $(ds_id).findById(record_id).data;

            new Leaf.Window({
                id: 'archive_file_detail',
                url: '${/request/@context_path}/modules/ARCHIVE/REC001F6/archive_file_detail.lview',
                fullScreen: true,
                params: {
                    contract_id: record.contract_id,
                    winId: 'archive_file_detail'
                },
                draggable: false,
                closeable: true
            });
        }

        //上传
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_archive');
            var ds = $(ds_id);
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '请至少选中一行!');
                return;
            }

            new Leaf.Window({
                id : "archive_file_upload",
                url : "${/request/@context_path}/modules/ARCHIVE/REC001F6/archive_file_upload.lview",
                title : '',
                params:{
                    contract_id : records[0].get('contract_id'),
                    contract_archive_id: records[0].get('contract_archive_id'),
                    contract_name:records[0].get('contract_name'),
                    contract_number:records[0].get('contract_number'),
                    legal_contract_number:records[0].get('legal_contract_number'),
                    status:records[0].get('status'),
                    bp_name:records[0].get('bp_name'),
                    host_project_manager_n:records[0].get('host_project_manager_n'),
                    document_type : records[0].get('document_type'),
                    winid : "archive_file_upload"
                },
                fullScreen : true,
                draggable : true,
                closeable : true,
            });
        }


        //下载
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_archive');
            var ds = $(ds_id);
            var records = ds.getSelected();
            if (records.length == 0) {
                Leaf.showMessage('提示', '请至少选中一行!');
                return;
            }

            new Leaf.Window({
                id: 'archive_file_download',
                url: '${/request/@context_path}/modules/ARCHIVE/REC001F6/archive_file_download.lview',
                fullScreen: true,
                params: {
                    contract_id: records[0].get('contract_id'),
                    contract_number:records[0].get('contract_number'),
                    legal_contract_number:records[0].get('legal_contract_number'),
                    contract_name:records[0].get('contract_name'),
                    bp_name:records[0].get('bp_name'),
                    host_project_manager_n:records[0].get('host_project_manager_n'),
                    winId: 'archive_file_download_id'
                },
                draggable: false,
                closeable: true
            });
        }

        //确认归档
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var archive_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_archive');
            if ($(archive_ds).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            var archive_records = $(archive_ds).getSelected();
            var records = [];
            if (archive_records.length < 1) {
                $L.showMessage('提示', '请先勾选档案！');
                return;
            }
            for (var i = 0; i < archive_records.length; i++) {
                records.push(archive_records[i].data);
            }

            Leaf.showConfirm('提示', '确定进行归档?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/contract/archive/confirm",
                    para: records,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "归档成功!");
                        $(archive_ds).query();
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            }, null, 200, 200);
        }

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_archive'):
                    qpara['created_by'] = '${/session/@user_id}';
                    break;
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>


</a:screen>