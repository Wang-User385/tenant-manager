<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="REC001F401_archive_create_detail_a_id"
                url="${/request/@context_path}/modules/ARCHIVE/REC001F3/archive_borrow_create_detail.lview"/>
        <a:link id="REC001F401_archive_create_detail_b_id"
                url="${/request/@context_path}/modules/ARCHIVE/REC001F3/archive_borrow_detail.lview"/>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if(ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_borrow')){
                qpara.return_query_flag = "Y";
            }
        };
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var archive_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_borrow');
            if(ds.id === archive_ds_id && record){
                //只有已借出的记录可以填写备注
                if(record.data.borrow_return_status !=='APPROVED' ){
                    record.getField('description').setReadOnly(true);
                }
            }
        };
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'detailFunction';
            if (name == 'borrow_document') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.data.borrow_id + '\',\'' + record.data.borrow_return_status  + '\');">' + '明细' + '</a>';
            }
        };


        function detailFunction(borrow_id,borrow_return_status) {
            if (borrow_return_status == 'APPROVED') {
                var param = {};
                param['borrow_id'] = borrow_id;
                param['borrow_return_status'] = borrow_return_status;
                param['function_code'] = 'REC001F402';
                param['function_usage'] = 'QUERY';
                param['url_title'] = '档案借阅详情';
                hls_doc_get_layout_code(param, 'REC001F401_archive_create_detail_b_id', null, 'REC001');
            }else if(borrow_return_status == 'APPROVING'||borrow_return_status == 'RETURNED') {
                var param = {};
                param['borrow_id'] = borrow_id;
                param['borrow_return_status'] = borrow_return_status;
                param['function_code'] = 'REC001F401';
                param['function_usage'] = 'QUERY';
                param['url_title'] = '档案借阅详情';
                hls_doc_get_layout_code(param, 'REC001F401_archive_create_detail_a_id', null, 'REC001');
            }else{
                var param = {};
                param['borrow_id'] = borrow_id;
                param['borrow_return_status'] = borrow_return_status;
                param['function_code'] = 'REC001F401';
                param['function_usage'] = 'MODIFY';
                param['url_title'] = '档案借阅详情';
                hls_doc_get_layout_code(param, 'REC001F401_archive_create_detail_a_id', null, 'REC001');
            }
        };


        //归档
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_borrow');
            record = $(basic_ds_id).getCurrentRecord();
            if (record.get("borrow_return_status") !== 'APPROVED') {
                $L.showMessage('提示', '只能对已借出的档案进行归还！');
                return false;
            }
            Leaf.showConfirm('提示', '确定归还?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/archive/borrow/return",
                    para: record.data,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showSuccessMessage('提示', '归还成功', function () {
                            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_borrow');
                            $(basic_ds_id).query();
                        });
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            },null,200,200);
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>