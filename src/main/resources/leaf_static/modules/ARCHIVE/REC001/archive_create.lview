<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        var para = {
            project_id:'${/parameter/@project_id}',
            uuid:'${/parameter/@uuid}',
            archive_type:'${/parameter/@archive_type}',
            project_editable:'${/parameter/@project_editable}'
        }
        //加载时调用
        $L.onReady(function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            $(ds_id).query();
        });
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if(para.project_editable == 'N'){
                var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                if(ds.id === basic_ds_id){
                    record.getField('project_number').setRequired(false);
                    record.getField('project_number').setReadOnly(true);
                    record.getField('project_number_n').setRequired(false);
                    record.getField('project_number_n').setReadOnly(true);
                }
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            if(ds.id == ds_id){
                if(para.project_id ){
                    qpara.project_id = para.project_id;
                }
                if(para.uuid ){
                    qpara.uuid = para.uuid;
                }
                if(para.archive_type){
                    qpara.archive_type = para.archive_type;
                }
            }
        };

        //新增前调用
        window['${@layout_code}_on_layout_dynamic_grid_beforecreate'] = function(ds, line_record , config_records,bp_seq){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            if(ds.id == ds_id){
                if(!para.uuid){
                    $L.showMessage('提示', '请先归集！');
                    return false;
                }
            }
            return true;
        };

        //归集
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            if(para.uuid){
                $L.showMessage('提示', '已经归集过，请进行档案整理！');
                return false;
            }
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if(!$(basic_ds_id).getCurrentRecord().get("project_number")){
                $L.showMessage('提示', '请先选择项目编号！');
                return false;
            }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            if ($(basic_ds_id).validate()) {
                Leaf.showConfirm('提示', '确定进行归集?', function () {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: "${/request/@context_path}/archive/pooling",
                        para: {project_id: $(basic_ds_id).getCurrentRecord().get("project_id")},
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "归集成功!");
                            para.uuid = res.result.record[0].uuid;
                            para.project_id = res.result.record[0].project_id;
                            $(ds_id).query();
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        sync: true,
                        scope: this
                    });
                },null,200,200);

            }

        }
        //档案整理
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            if(!para.uuid){
                $L.showMessage('提示', '请先归集再进行档案整理！');
                return false;
            }
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if ($(basic_ds_id).validate()) {
                Leaf.showConfirm('提示', '确定进行档案整理?', function () {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    var attachmentList = [];
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
                    if ($(ds_id).getAll().length != 0) {
                        var ds_id_records = $(ds_id).getAll();
                        for (var i = 0; i < ds_id_records.length; i++) {
                            attachmentList[i] = ds_id_records[i].data;
                        }
                    }
                    Leaf.request({
                        url: '${/request/@context_path}/archive/attachment/arrangement',
                        para: attachmentList,

                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            top.refreshFrame();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                },null,200,200);

            }

        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // if (name === 'attach_link' && record.get('source_id')) {
            if (name === 'attach_link' ) {
                return '<a href="javascript:window[\'' + 'attachment_action' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">上传/下载</a>';
            }
            return value;
        };
        function attachment_action(record_id, ds_id) {
            var record = $(ds_id).findById(record_id),
                    source_id = record.get('source_id'),url,function_usage;
            if(record.get('source_type') == 'JC_ARCHIVE_ATTACHMENT'){
                source_id = record.get('archive_attachment_id');
            }
            if (!source_id) {
                Leaf.showErrorMessage('提示', '请先保存再上传附件！', null, 200, 100);
                return;
            }
            if ('${/parameter/@function_usage}' == 'QUERY'||record.get('source_type')!='JC_ARCHIVE_ATTACHMENT') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage = 'MODIFY';
            }
            var win = new Leaf.Window({
                id: 'open_attachment_win_id',
                url: url,
                params: {
                    header_id: source_id,
                    table_name: record.get('source_type'),
                    winid: 'open_attachment_win_id',
                    function_usage: function_usage
                },
                title: '附件上传',
                width: 900,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
                $(ds_id).query();
            });

        }
        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            if(attachment_ds_id == ds.id){
                record.set('uuid',para.uuid)
                record.set('source_type', 'JC_ARCHIVE_ATTACHMENT');
                if(para.project_id){
                    record.set('project_id', para.project_id);
                }else{
                    record.set('project_id', $(basic_ds_id).getCurrentRecord().get("project_id"));
                }
            }
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
            if(ds.id === attachment_ds_id && record){
                if(record.data.source_type !=='JC_ARCHIVE_ATTACHMENT'){
                    record.getField('document_name').setRequired(false);
                    record.getField('document_name').setReadOnly(true);
                }
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>