<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="REC001F1_ARCHIVE_CREATE_ID"
                url="${/request/@context_path}/modules/ARCHIVE/REC001/archive_create.lview"/>
        <a:link id="REC001F2_ARCHIVE_FILE_DETAIL_ID"
                url="${/request/@context_path}/modules/ARCHIVE/REC001/archive_file_detail.lview"/>
        <script><![CDATA[
        var process_instance_id = '${/parameter/@process_instance_id}';

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            if(ds.id == ds_id){
                qpara.process_instance_id = process_instance_id;
            }
        };
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var archive_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            if(ds.id === archive_ds_id && record){
                //要件类和权证类是提交审批后就不让改了,管理类与综合类归档后不让改
                if(((record.data.archive_type =='ELEMENT_CLASS' || record.data.archive_type =='WARRANT_CLASS')&&(record.data.handover_status == 'APPROVING' || record.data.handover_status == 'APPROVED'))
                ||((record.data.archive_type =='MANAGEMENT_CLASS' || record.data.archive_type =='GENERAL_CLASS')&&(record.data.archived_flag == 'Y'))){
                    record.getField('archive_number').setRequired(false);
                    record.getField('archive_number').setReadOnly(true);
                    record.getField('archive_name').setRequired(false);
                    record.getField('archive_name').setReadOnly(true);
                    record.getField('handover_date').setRequired(false);
                    record.getField('handover_date').setReadOnly(true);
                    record.getField('archived_date').setRequired(false);
                    record.getField('archived_date').setReadOnly(true);
                    record.getField('description').setRequired(false);
                    record.getField('description').setReadOnly(true);
                }
            }
        };
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'archive_detail'&& !record.isNew) {
                return '<a href="javascript:open_detail(\'' + record.id + '\',\'' + record.ds.id + '\')">查看文档</a>';
            }
            return value;
        };
        //查看详情
        function open_detail(record_id,ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '档案归档';
            param['function_code'] = 'REC001F2';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['screen_width'] = '1000';
            param['screen_height'] = '450';

            param['winid'] = 'REC001F1_archive_create_winid';
            param['project_id'] = record.get('project_id');
            param['uuid'] = record.get('uuid');
            param['archive_type'] = record.get('archive_type');
            hls_doc_get_layout_code(param, 'REC001F2_ARCHIVE_FILE_DETAIL_ID', '', 'REC001');
        }

        //新建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var param = {};
            param['url_title'] = '档案归档创建';
            param['function_code'] = 'REC001F1';
            param['winid'] = 'REC001F1_archive_create_winid';
            hls_doc_get_layout_code(param, 'REC001F1_ARCHIVE_CREATE_ID', '', 'REC001');
        }
        //移交申请
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var archive_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            if ($(archive_ds).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            var archive_records = $(archive_ds).getSelected();
            var records=[];
            if (archive_records.length < 1) {
                $L.showMessage('提示', '请先勾选档案！');
                return;
            }
            for(var i=0;i<archive_records.length;i++){
                var project_id = archive_records[0].get('project_id');

                if(archive_records[i].get('project_id') != project_id){
                    $L.showMessage('提示', '所选档案不属于同一合同！');
                    return false;
                }
                if(archive_records[i].get('archive_type') != 'ELEMENT_CLASS' && archive_records[i].get('archive_type') != 'WARRANT_CLASS'){
                    $L.showMessage('提示', '只能选择要件类与权证类的档案！');
                    return false;
                }
                if(archive_records[i].get('handover_status') == 'APPROVING' || archive_records[i].get('handover_status') == 'APPROVED'){
                    $L.showMessage('提示', '已经审批的档案不能再次提交！');
                    return false;
                }

                records.push(archive_records[i].data);
            }

            Leaf.showConfirm('提示', '确定提交移交申请?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/archive/approval/submit",
                    para: records,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "提交成功!");
                        $(archive_ds).query();
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            },null,200,200);

        }
        //风管部确认归档
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var archive_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            if ($(archive_ds).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            var archive_records = $(archive_ds).getSelected();
            var records=[];
            if (archive_records.length < 1) {
                $L.showMessage('提示', '请先勾选档案！');
                return;
            }
            for(var i=0;i<archive_records.length;i++){
                if('${/session/@SPRING_SECURITY_CONTEXT}'.indexOf("B0085") == -1 ){
                    $L.showMessage('提示', '风管部放款审核岗可点击此按钮！');
                    return false;
                }else{
                    if(archive_records[i].get('archive_type') != 'MANAGEMENT_CLASS' && archive_records[i].get('archive_type') != 'GENERAL_CLASS'){
                        $L.showMessage('提示', '风管部档案管理员只能选择管理类与综合类的档案！');
                        return false;
                    }
                }
                records.push(archive_records[i].data);
            }

            Leaf.showConfirm('提示', '确定进行归档?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/archive/confirm",
                    para: records,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "归档成功!");
                        $(archive_ds).query();
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            },null,200,200);
        }
        //综管部确认归档
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            var archive_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            if ($(archive_ds).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            var archive_records = $(archive_ds).getSelected();
            var records=[];
            if (archive_records.length < 1) {
                $L.showMessage('提示', '请先勾选档案！');
                return;
            }
            for(var i=0;i<archive_records.length;i++){
                if('${/session/@SPRING_SECURITY_CONTEXT}'.indexOf("B0850") == -1 ){
                    $L.showMessage('提示', '综管部档案管理员可点击此按钮！');
                    return false;
                }else{
                    if(archive_records[i].get('archive_type') != 'ELEMENT_CLASS' && archive_records[i].get('archive_type') != 'WARRANT_CLASS'){
                        $L.showMessage('提示', '综管部档案管理员只能选择要件类与权证类的档案！');
                        return false;
                    }
                    if(archive_records[i].get('handover_status') !== 'APPROVED'){
                        $L.showMessage('提示', '您选择的档案还没有审批通过！');
                        return false;
                    }
                }
                records.push(archive_records[i].data);
            }

            Leaf.showConfirm('提示', '确定进行归档?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/archive/confirm",
                    para: records,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "归档成功!");
                        $(archive_ds).query();
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });
            },null,200,200);

        }
        //查看归档明细
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var archive_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive');
            var archive_records = $(archive_ds).getSelected();
            var records=[];
            if (archive_records.length != 1) {
                $L.showMessage('提示', '请先勾选"一笔"档案信息！');
                return;
            }

            var record = archive_records[0];
            var param = {};
            param['url_title'] = '档案归档';
            param['function_code'] = 'REC001F1';
            param['maintain_type'] = 'MODIFY';
            param['function_usage'] = 'MODIFY';
            param['winid'] = 'REC001F1_archive_create_winid';
            param['project_id'] = record.get('project_id');
            param['uuid'] = record.get('uuid');
            param['project_editable'] = 'N';
            hls_doc_get_layout_code(param, 'REC001F1_ARCHIVE_CREATE_ID', '', 'REC001');

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>