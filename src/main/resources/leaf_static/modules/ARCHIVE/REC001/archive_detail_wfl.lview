<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="REC001_ARCHIVE_CREATE_ID"
                url="${/request/@context_path}/modules/ARCHIVE/REC001/archive_home.lview"/>
        <script><![CDATA[
        var process_instance_id = parent.currentTaskInfo.process_instance_id;
        if(!process_instance_id){
            process_instance_id = parent.currentTaskInfo.execution_variables[0].process_instance_id;
        }

        var pageChooser = new PageChooser({
            url: $('REC001_ARCHIVE_CREATE_ID').getUrl(),
            function_code: 'REC001',
            context_path: '${/request/@context_path}',
            opt: {
                businessKey: '${/parameter/@businessKey}',
                process_instance_id:process_instance_id,
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

