<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="REC001F401_archive_create_detail_a1_id"
                url="${/request/@context_path}/modules/ARCHIVE/REC001F3/archive_borrow_create_detail.lview"/>
        <script><![CDATA[
        var pageChooser = new PageChooser({
            url: $('REC001F401_archive_create_detail_a1_id').getUrl(),
            function_code: 'REC001F401',
            context_path: '${/request/@context_path}',
            opt: {
                borrow_id: '${/parameter/@businessKey}',
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

