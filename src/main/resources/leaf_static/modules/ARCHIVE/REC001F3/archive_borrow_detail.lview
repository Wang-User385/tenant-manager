<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_borrow');
            var record = $(basic_ds_id).getCurrentRecord();
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment','F_ELEMENT'):
                    if(record.get('element_class_flag') == 'Y'){
                        qpara['archive_type'] = 'ELEMENT_CLASS';
                    }else{
                        qpara['archive_type'] = 'EMPTY_CLASS';
                    }
                    break;
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment','F_MANAGE'):
                    if(record.get('management_class_flag') == 'Y'){
                        qpara['archive_type'] = 'MANAGEMENT_CLASS';
                    }else{
                        qpara['archive_type'] = 'EMPTY_CLASS';
                    }
                    break;
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment','F_GENERAL'):
                    if(record.get('general_class_flag') == 'Y'){
                        qpara['archive_type'] = 'GENERAL_CLASS';
                    }else{
                        qpara['archive_type'] = 'EMPTY_CLASS';
                    }
                    break;
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment','F_WARRANT'):
                    if(record.get('warrant_class_flag') == 'Y'){
                        qpara['archive_type'] = 'WARRANT_CLASS';
                    }else{
                        qpara['archive_type'] = 'EMPTY_CLASS';
                    }
                    break;
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'attach_link' ) {
                return '<a href="javascript:window[\'' + 'attachment_action' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">上传/下载</a>';
            }
            return value;
        };
        function attachment_action(record_id, ds_id) {
            var record = $(ds_id).findById(record_id),
                    source_id = record.get('source_id'),url,function_usage;
            if(record.get('source_type') == 'JC_ARCHIVE_ATTACHMENT'){
                source_id = record.get('archive_attachment_id');
            }
            if (!source_id) {
                Leaf.showErrorMessage('提示', '请先保存再上传附件！', null, 200, 100);
                return;
            }
            if ('${/parameter/@function_usage}' == 'QUERY'||record.get('source_type')!='JC_ARCHIVE_ATTACHMENT') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage = 'MODIFY';
            }
            var win = new Leaf.Window({
                id: 'open_attachment_win_id',
                url: url,
                params: {
                    header_id: source_id,
                    table_name: record.get('source_type'),
                    winid: 'open_attachment_win_id',
                    function_usage: function_usage
                },
                title: '附件上传',
                width: 900,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_archive_attachment');
                $(ds_id).query();
            });

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>