<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="REC001F401_archive_create_detail_id"
                url="${/request/@context_path}/modules/ARCHIVE/REC001F3/archive_borrow_create_detail.lview"/>

        <script><![CDATA[

        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            record.set("employee_id_n","${/session/@employeeName}");
            record.set("unit_id_n","${/session/@unitName}");
            record.set("employee_id","${/session/@employeeId}");
            record.set("unit_id","${/session/@unitId}");
        };
        //确认
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(project_ds_id).getCurrentRecord().data;

            if(project_record.project_id == null || project_record.project_id == ''){
                Leaf.showMessage('提示','项目编号不能为空！');
            }else{
                var param = project_record;
                param['url_title'] = '档案借阅申请';
                param['function_code'] = 'REC001F401';
                param['function_usage'] = 'CREATE';
                param['winid'] = 'REC001F401_archive_create_detail_win_id';

                hls_doc_get_layout_code(param, 'REC001F401_archive_create_detail_id', null, 'REC001');
            }

        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>