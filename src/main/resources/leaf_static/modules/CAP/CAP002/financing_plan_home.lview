<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="cap_financing_plan_create_id"
                url="${/request/@context_path}/modules/CAP/CAP002/financing_plan_detail.lview"/>
        <script><![CDATA[

        function plan_detail_open(record_id,ds_id){
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var confirm_status = record.get('confirm_status');
            param['url_title'] = '融资计划明细';
            param['function_code'] = 'CAP002F1';
            param['winid'] = 'plan_detail_open_id';
            if(confirm_status && confirm_status == 'FULL'){
                param['function_usage'] = 'QUERY';
            }else{
                param['function_usage'] = 'MODIFY';
            }
            hls_doc_get_layout_code(param, 'cap_financing_plan_create_id', ds_id, 'CAP002F1');
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = {};
            var param = {};
            param['url_title'] = '融资计划创建';
            param['function_code'] = 'CAP002F1';
            param['winid'] = 'cap_financing_plan_create_winid';
            hls_doc_get_layout_code(param, 'cap_financing_plan_create_id', ds_id, 'CAP002F1');
        };

        window['${/parameter/@layout_code}_G_CAP_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var ds_id = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_capital_invest_plan_hd'));
            var records = $(ds_id).getSelected();
            if(records.length >= 1) {
                var flag = true;
                for (var i = 0; i < records.length; i++) {
                    var execute_status = records[i].get('execute_status');
                    if (execute_status == 'DELAY') {
                        Leaf.showMessage("提示", "已延期，请重新选择!", null);
                        flag = false;
                        return;
                    }
                }
                if (!flag) {
                    return;
                }
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //debugger;
            var link_function = 'plan_detail_open';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'plan_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
