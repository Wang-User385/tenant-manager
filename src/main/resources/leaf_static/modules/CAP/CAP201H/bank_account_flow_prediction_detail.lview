<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {debugger;
            var ds_id_2 = '${/parameter/@layout_code}_F_BASIC_INFO_cap_account_monthly_balance_ds';
            var ds_id_1 = '${/parameter/@layout_code}_F_BASIC_INFO__ds';
            if(ds_id_2 == ds.id && ds.id){
                record.set('bank_name','${/parameter/@bank_name}');
                record.set('predicted_amount','${/parameter/@predicted_amount}');
                record.set('company_name','${/parameter/@company_name}');
                record.set('currency_name','${/parameter/@currency_name}');
                record.set('start_period','${/parameter/@start_period}');
                record.set('end_period','${/parameter/@end_period}');
            }else if(ds.id == ds_id_1){
                record.set('bank_name','${/parameter/@bank_name}');
                record.set('predicted_amount','${/parameter/@predicted_amount}');
                record.set('company_name','${/parameter/@company_name}');
                record.set('currency_name','${/parameter/@currency_name}');
                record.set('start_period','${/parameter/@start_period}');
                record.set('end_period','${/parameter/@end_period}');
            }

        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {debugger;
            if(ds.id && 'CAP201F1_G_QUERY_RESULT_PREDICT_cap_account_monthly_balance_ds' == ds.id){
                ds.setQueryParameter('bank_account_id', '${/parameter/@bank_account_id}');
                ds.setQueryParameter('currency', '${/parameter/@currency}');
                ds.setQueryParameter('company_id', '${/parameter/@company_id}');
                ds.setQueryParameter('bank_id', '${/parameter/@bank_id}');
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
