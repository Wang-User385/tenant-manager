<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="CAP100_FUNDING_PLAN_DETAIL"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_funding_plan_detail.lview"/>
        <a:link id="CAP100_FUNDING_PLAN_CREATE"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_funding_plan_create.lview"/>

        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');

            if (ds.id === ds_id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
        }
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var param = {};
            param['url_title'] = '资金投放计划创建';
            param['function_code'] = 'CAP100F1';
            param['function_usage'] = 'CREATE';

            param['project_id'] = '${/parameter/@project_id}';

            param['winid'] = 'HLS200_MARKETING_REPORT_create_winid';
            hls_doc_get_layout_code(param, 'CAP100_FUNDING_PLAN_CREATE', ds_id, 'CAP100', null, null);
        };
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var selectData = $(ds_id).getSelected();
            if(selectData.length ==0){
                Leaf.showMessage('提示','请选择单据');
            }
            var saveData = [];
            for (var i = 0; i < selectData.length; i++) {
                var param={};
                param['funding_plan_id'] = selectData[i].get('funding_plan_id');
                saveData.push(param);
            }
            if(!Ext.isEmpty(saveData)) {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: "${/request/@context_path}/hls/funding/plan/remove",
                    para: saveData,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('提示','删除成功！');
                        $(ds_id).query();
                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return flag;
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return flag;
                    },
                    sync: true,
                    scope: this
                });
            }
        };
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var records = $(ds_id).getSelected();
            if(records.length !=1){
                Leaf.showErrorMessage('提示','请选择一条单据');
            }
            if(records[0].get('status') != 'NEW'&&records[0].get('status') != 'REJECTED'){
                Leaf.showErrorMessage('提示','请选择新建或审批拒绝的单据');
            }else{
            var param = records[0].data;
            param['url_title'] = '资金投放计划明细';
            param['function_code'] = 'CAP100F2';
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            //param['funding_plan_id'] = records[0].get('funding_plan_id');
                 //param['layout_debugger_flag'] = 'Y';

                param['winid'] = 'cap100_funding_plan_modify_winid';
            hls_doc_get_layout_code(param, 'CAP100_FUNDING_PLAN_DETAIL', ds_id, 'HLS200');
            }
        }


        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'funding_plan_number' && value) {
                return '<a href="javascript:open_funding_plan_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_funding_plan_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'CAP100F2';
            param['url_title'] = '资金投放计划明细';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'CAP100_FUNDING_PLAN_DETAIL_winid';

            hls_doc_get_layout_code(param, 'CAP100_FUNDING_PLAN_DETAIL', ds_id, 'HLS200');

            // param['function_usage'] = 'CREATE';
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>