<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:link id="CAP100_FUNDING_PLAN_DETAIL"
            url="${/request/@context_path}/modules/CAP/CAP100/hls_funding_plan_detail.lview"/>
    <a:view>
        <script><![CDATA[
        Leaf.onReady(function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var dsRecord = $(ds_id).getCurrentRecord();
            dsRecord.set('project_id','${/parameter/@project_id}');

        });
        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var data = $(ds_id).data[0].data;

            if(!$(ds_id).validate()){
                return;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            Leaf.request({
                url: "${/request/@context_path}/hls/funding/plan/create",
                para: data,
                success: function (res) {
                    var param = {};
                    param['url_title'] = '资金投放计划明细';
                    param['function_code'] = 'CAP100F2';
                    param['winid'] = 'CAP100F2_funding_plan_winid';
                    param['parent_winid'] = '${/parameter/@winid}';
                    param['function_usage'] = 'CREATE';
                    param['funding_plan_id'] = res.result.record[0].funding_plan_id;
                    param['contract_id'] = res.result.record[0].contract_id;
                    param['project_id'] = res.result.record[0].project_id;
                    hls_doc_get_layout_code(param, 'CAP100_FUNDING_PLAN_DETAIL', ds_id, 'CAP100', param['parent_winid'], 'Y');
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });
        };


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    