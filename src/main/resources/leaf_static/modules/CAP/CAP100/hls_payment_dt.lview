<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        Leaf.onReady(function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var dsRecord = $(ds_id).getCurrentRecord();
            if(dsRecord != null){
            dsRecord.set('remaining_payable_amount','${/parameter/@remaining_payable_amount}');
            }else{
                $(ds_id).create();
                $(ds_id).getCurrentRecord().set('remaining_payable_amount','${/parameter/@remaining_payable_amount}');
            }


        });

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var dt_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_dt','G_DEDUCTION');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            if(ds.id === dt_ds_id){
                if (name == 'deduct_amount') {
                    $(ds_id).getCurrentRecord().set('remaining_payable_amount','${/parameter/@remaining_payable_amount}' - value)
                }
            }

        };
        // 删除前校验
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq){
            var dt_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_dt','G_DEDUCTION');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            if(ds.id === dt_ds_id){
                var remaining_payable_amount = parseFloat('${/parameter/@remaining_payable_amount}');
                $(ds_id).getCurrentRecord().set('remaining_payable_amount', remaining_payable_amount+ record[0].get('deduct_amount'));
            }
            var saveData = [];
            for (var i = 0; i < record.length; i++) {
                saveData.push(record[i].data);
            }
            Leaf.request({
                url: '${/request/@context_path}/csh/payment/req/dt/delete/cashflow',
                para: saveData ,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return true;
                },
                failure: function () {
                    return false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    return false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            })

            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return true;
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var dt_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_dt','G_DEDUCTION');
            $(dt_ds_id).setQueryParameter('funding_plan_ln_id','${/parameter/@funding_plan_ln_id}');
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';


        }
            //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_dt','G_DEDUCTION');
            if(ds.id === ds_id){
                record.set('funding_plan_ln_id','${/parameter/@funding_plan_ln_id}');
                record.set('source_doc_id','${/parameter/@contract_id}');
            }
        }

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_dt','G_DEDUCTION');
            var records = $(ds_id).getAll();
            var saveData = [];
            for (var i = 0; i < records.length; i++) {
                saveData.push(records[i].data);
            }
            Leaf.request({
                url: '${/request/@context_path}/csh/payment/req/dt/save/cashflow',
                para: saveData ,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return true;
                },
                failure: function () {
                    return false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    return false;
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            })

            return true;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>