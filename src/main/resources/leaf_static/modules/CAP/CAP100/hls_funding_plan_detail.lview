<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="CAP100_MARKETING_REPORT"
                url="${/request/@context_path}/modules/HLS/HLS200/hls_marketing_report_detail.lview"/>
        <a:link id="HLS_FUNDING_PLAN_LN"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_funding_plan_ln.lview"/>
        <a:link id="hls_payment_dt"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_payment_dt.lview"/>
        <script><![CDATA[



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var green_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_green');
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');


            if(ds.id == green_ds_id&&ds_id){
                var record = $(ds_id).getCurrentRecord();
                var green_record = $(green_ds_id).getCurrentRecord();
                if(green_record&&record){
                    var lease_price_use;
                    lease_price_use = record.get('lease_price_use');
                    if($(green_ds_id).getCurrentRecord().get('lease_price_use') == null){
                        $(green_ds_id).getCurrentRecord().set('lease_price_use',lease_price_use);
                    }
                }
            }

        }
            //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            if (ds.id == ln_ds_id) {
                record.set('contract_id', '${/parameter/@contract_id}');
            }
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if (ds.id == att_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('project_attachment_category', 'CON_CONTRACT_ATT');
            }
        }
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        }
            //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            if (ds.id == ln_ds_id) {
                ds.setQueryParameter('funding_plan_id', $(ds_id).getCurrentRecord().get('funding_plan_id'));
            }
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if (ds.id == att_ds_id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');

            }
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            if (ds.id == quotation_ds_id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');

            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');

            var param = {};
            param['url_title'] = '营销报备详情';
            param['function_code'] = 'HLS200F3';
            param['marketing_report_id'] = $(ds_id).getCurrentRecord().get('marketing_report_id');
            param['function_usage'] = 'QUERY';

            param['winid'] = 'CAP100_MARKETING_REPORT_winid';
            hls_doc_get_layout_code(param, 'CAP100_MARKETING_REPORT', ds_id, 'CAP100', null, null);

        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if (ds.id == att_ds_id) {
                var att_records = $(att_ds_id).getAll();
                for (var i = 0; i < att_records.length; i++) {
                    if(att_records[i].data['project_attachment_category'] == 'CON_CONTRACT_ATT'){
                        att_records[i].getField('document_name').setReadOnly(true);
                        att_records[i].getField('upload').setReadOnly(true);
                        att_records[i].getField('description').setReadOnly(true);

                    }
                }
            }
        };


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_marketing_channel');
            if (ds.id === ds_id) {
                if (name === 'marketing_channel') {
                    if (record.get('marketing_channel') == 'BRANCH_RECOMMENDATION' || record.get('marketing_channel') == 'INTEGRATED_MARKETING') {
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setRequired(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setRequired(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setReadOnly(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setReadOnly(false);
                        $(ds_id).getCurrentRecord().getField('source_marketing_channel').setRequired(false);
                    } else {
                        $(ds_id).getCurrentRecord().set('xy_branch_bank', '');
                        $(ds_id).getCurrentRecord().set('xy_branch_bank_n', '');
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setRequired(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setRequired(false);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank').setReadOnly(true);
                        $(ds_id).getCurrentRecord().getField('xy_branch_bank_n').setReadOnly(true);
                        $(ds_id).getCurrentRecord().getField('source_marketing_channel').setRequired(true);
                    }
                }
            }
            if (ds.id === ds_id) {
                if (name === 'host_department_proportion') {
                    record.set('assist_department_proportion', 1 - record.get('host_department_proportion'));
                }
            }


        };
        //保存
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function (nextStep) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // var project_id = '${/parameter/@project_id}';

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var channel_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_marketing_channel');
            var branch_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_branch_referrer');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            var planRecord = $(ds_id).getCurrentRecord().data;

            var funding_plan_id = $(ds_id).getCurrentRecord().get('funding_plan_id');


            if($(ln_ds_id).getAll().length != 0) {
                var ln_records = $(ln_ds_id).getAll();
                var hlsCusFundingPlanLnList = [];
                planRecord['hls_cus_funding_plan_ln_list'] = [];
                for (var i = 0; i < ln_records.length; i++) {
                    hlsCusFundingPlanLnList[i] = {};
                    ln_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusFundingPlanLnList[i],ln_records[i].data);
                    planRecord['hls_cus_funding_plan_ln_list'].push(hlsCusFundingPlanLnList[i]);

                }
            }
            if($(channel_ds_id).getAll().length != 0) {
                var channel_records = $(channel_ds_id).getAll();
                var hlsCusCapMarketingChannelList = [];
                planRecord['hls_cus_cap_marketing_channel_list']=[];
                for (var i = 0; i < channel_records.length; i++) {
                    hlsCusCapMarketingChannelList[i] = {};
                    channel_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusCapMarketingChannelList[i],channel_records[i].data);
                    planRecord['hls_cus_cap_marketing_channel_list'].push(hlsCusCapMarketingChannelList[i]);

                }
            }
            if($(branch_ds_id).getAll().length != 0) {
                var branch_records = $(branch_ds_id).getAll();
                var fundingBranchReferrerList = [];
                planRecord['funding_branch_referrer_list']=[];
                for (var i = 0; i < branch_records.length; i++) {
                    fundingBranchReferrerList[i] = {};
                    branch_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(fundingBranchReferrerList[i],branch_records[i].data);
                    planRecord['funding_branch_referrer_list'].push(fundingBranchReferrerList[i]);

                }
            }
            if($(att_ds_id).getAll().length != 0) {
                var att_records = $(att_ds_id).getAll();
                var prjProjectAttachments = [];
                planRecord['prj_project_attachments']=[];
                for (var i = 0; i < att_records.length; i++) {
                    prjProjectAttachments[i] = {};
                    //att_records[i].data['project_id'] = '${/parameter/@project_id}';
                    att_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(prjProjectAttachments[i],att_records[i].data);
                    planRecord['prj_project_attachments'].push(prjProjectAttachments[i]);
                }
            }
            planRecord[ln_ds_id.replace('_ds','')]=undefined;
            planRecord[channel_ds_id.replace('_ds','')]=undefined;
            planRecord[cashflow_ds_id.replace('_ds','')]=undefined;
            planRecord[branch_ds_id.replace('_ds','')]=undefined;
            planRecord[att_ds_id.replace('_ds','')]=undefined;

            if(!$(ds_id).validate()||!$(channel_ds_id).validate()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }else{

                Leaf.request({
                    url: '${/request/@context_path}/hls/funding/plan/save',
                    para:  planRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
                        $(ds_id).query();
                        var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
                        $(ln_ds_id).query();
                        //debugger
                        var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                        $(att_ds_id).query();

                        Leaf.showMessage('提示', '保存成功');
                        if (typeof (nextStep) == 'function') {
                            nextStep();
                        }
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        }

        function assignValue(record,data){
            for(var i in data){
                if(data[i] != null){
                    record[i] = data[i] ;
                }
            }
        }
        // 删除前校验
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            var flag = true;
            var att_delete_flag = 'Y';

            if(ds.id == ln_ds_id) {
                var selectData = $(ln_ds_id).getSelected();
                if (selectData.length == 0) {
                    Leaf.showMessage('提示', '请选择单据');
                }
                var saveData = [];
                for (var i = 0; i < selectData.length; i++) {
                    if (selectData[i].get('funding_plan_ln_id') == undefined) {
                        return true;
                    }
                    var param = {};
                    param['funding_plan_id'] = selectData[i].get('funding_plan_id');
                    param['funding_plan_ln_id'] = selectData[i].get('funding_plan_ln_id');
                    saveData.push(param);
                }

                if (!Ext.isEmpty(saveData)) {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: "${/request/@context_path}/hls/funding/plan/ln/remove",
                        para: saveData,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            flag = true;
                            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
                            $(ds_id).query();
                            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
                            $(ln_ds_id).query();
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            flag = false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            flag = false;
                        },
                        sync: true,
                        scope: this
                    });
                }
            }

            if(ds.id == att_ds_id){
                var selectData = $(att_ds_id).getSelected();
                if (selectData.length == 0) {
                    Leaf.showMessage('提示', '请选择单据');
                    return ;
                }
                for(var i = 0 ; i < selectData.length  ; i++ ){
                    if (selectData[i].get('project_attachment_category') == 'CON_CONTRACT_ATT') {
                        att_delete_flag = 'N';
                        break;
                    }
                }
                if(att_delete_flag == 'N'){
                    Leaf.showWarningMessage('提示','合同管理的附件资料不支持删除!');
                    return false;
                }else{
                    return true;
                }

            }
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

            return flag;
        }



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file_funding';

            if (name == 'upload' && record.get('project_attachment_id')) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id')  + '\',\'' + record.get('project_attachment_category')  + '\', \'PRJ_PROJECT_ATTACHMENT\');">附件</a>';
            }
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }
            if(name == 'quotation_detail'){
                link_function = 'quotation_detail';
                return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 220px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 105px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '新建报价' + '</a>';
            }
            if (name == 'payment_deduction') {
                return '<a href="javascript:open_payment_dt_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '抵扣明细' + '</a>';
            }
            return value;
        };
        window['upload_file_funding'] = function (record_id, project_attachment_id, project_attachment_category ,  table) {
            var url;

            var function_usage = '${/parameter/@function_usage}';

            if ('${/parameter/@function_usage}' === 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if(project_attachment_category == 'CON_CONTRACT_ATT'){
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }
            if('${/parameter/@attachment_query_flag}' == 'Y'){
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }

            // var tableName = 'PRJ_PROJECT_ATTACHMENT';
            // if (table) {
            //     tableName = table;
            //     if ('${/parameter/@function_usage}' !== 'QUERY') {
            //         url = '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/uploadText.lview';
            //     }
            // }
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == null) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_G_ATTACHMENT_INFO_prj_project_attachment_ds').query();
            });
        }
        window['quotation_detail'] = function (record_id, ds_id) {
            var quotation_record = $(ds_id).findById(record_id);
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var project_id = prj_record.get('project_id');
            var project_name = prj_record.get('project_name');
            if (project_id == 0 || quotation_id == undefined) {
                Leaf.showMessage('提示', '报价未计算成功，无法查看');
            } else {
                var param = {};
                param['quotationId'] = quotation_id;
                param['priceList'] = price_list;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                hls_doc_get_layout_code(param, '${/parameter/@layout_code}_calc_price_quotation_common_link_id', null, '${/parameter/@layout_code}');
            }

        };

        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // var project_id = '${/parameter/@project_id}';

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var channel_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_marketing_channel');
            var branch_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_branch_referrer');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            var planRecord = $(ds_id).getCurrentRecord().data;

            var funding_plan_id = $(ds_id).getCurrentRecord().get('funding_plan_id');


            if($(ln_ds_id).getAll().length != 0) {
                var ln_records = $(ln_ds_id).getAll();
                var hlsCusFundingPlanLnList = [];
                planRecord['hls_cus_funding_plan_ln_list'] = [];
                for (var i = 0; i < ln_records.length; i++) {
                    hlsCusFundingPlanLnList[i] = {};
                    ln_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusFundingPlanLnList[i],ln_records[i].data);
                    planRecord['hls_cus_funding_plan_ln_list'].push(hlsCusFundingPlanLnList[i]);

                }
            }
            if($(channel_ds_id).getAll().length != 0) {
                var channel_records = $(channel_ds_id).getAll();
                var hlsCusCapMarketingChannelList = [];
                planRecord['hls_cus_cap_marketing_channel_list']=[];
                for (var i = 0; i < channel_records.length; i++) {
                    hlsCusCapMarketingChannelList[i] = {};
                    channel_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusCapMarketingChannelList[i],channel_records[i].data);
                    planRecord['hls_cus_cap_marketing_channel_list'].push(hlsCusCapMarketingChannelList[i]);

                }
            }
            if($(branch_ds_id).getAll().length != 0) {
                var branch_records = $(branch_ds_id).getAll();
                var fundingBranchReferrerList = [];
                planRecord['funding_branch_referrer_list']=[];
                for (var i = 0; i < branch_records.length; i++) {
                    fundingBranchReferrerList[i] = {};
                    branch_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(fundingBranchReferrerList[i],branch_records[i].data);
                    planRecord['funding_branch_referrer_list'].push(fundingBranchReferrerList[i]);

                }
            }

            if($(att_ds_id).getAll().length != 0) {
                var att_records = $(att_ds_id).getAll();
                var prjProjectAttachments = [];
                planRecord['prj_project_attachments']=[];
                for (var i = 0; i < att_records.length; i++) {
                    prjProjectAttachments[i] = {};
                    //att_records[i].data['project_id'] = '${/parameter/@project_id}';
                    att_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(prjProjectAttachments[i],att_records[i].data);
                    planRecord['prj_project_attachments'].push(prjProjectAttachments[i]);
                }
            }

            planRecord[ln_ds_id.replace('_ds','')]=undefined;
            planRecord[channel_ds_id.replace('_ds','')]=undefined;
            planRecord[att_ds_id.replace('_ds','')]=undefined;
            planRecord[cashflow_ds_id.replace('_ds','')]=undefined;
            planRecord[branch_ds_id.replace('_ds','')]=undefined;
            var green_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_green');

            planRecord[green_ds_id.replace('_ds','')]=undefined;

            if(!$(ds_id).validate()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showWarningMessage('提示','请将必填的信息输入完整');

            }else{

                Leaf.request({
                    url: '${/request/@context_path}/hls/funding/plan/save',
                    para:  planRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        submit_function();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
            //window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'](submit_function);
        }

        function submit_function(){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var branch_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_branch_referrer');
            var branch_records = $(branch_ds_id).getAll();
            var proportion = 0;
            for (var i = 0; i < branch_records.length; i++) {
                if(branch_records[i].get('proportion')){
                    proportion += branch_records[i].get('proportion');
                }
            }
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var ln_records = $(ln_ds_id).getAll();
            var ln_flag = true;
            // for (var i = 0; i < ln_records.length; i++) {
            //     if(ln_records[i].get('payment_method')== undefined
            //         ||ln_records[i].get('payment_method_n')== undefined
            //         ||ln_records[i].get('bank_account_name')== undefined
            //         ||ln_records[i].get('bank_account_num')== undefined){
            //         ln_flag = false;
            //     }
            // }
            if (proportion != 0 && proportion != 1) {
                $L.showErrorMessage("提示", "分成比例不对!");
            }
            // else if(!ln_flag){
            //     $L.showErrorMessage("提示", "请于支付表制作功能完善放款计划信息!");
            // }
            else{

                if ($(ds_id).validate()) {
                    var record = $(ds_id).data[0].data;
                    var funding_plan_id = record.funding_plan_id;
                    if (funding_plan_id != null) {
                        new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                            Leaf.request({
                                url: '${/request/@context_path}/hls/funding/plan/approve/submit',
                                para: {
                                    funding_plan_id: funding_plan_id,
                                },
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    if (res.success) {
                                        Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '申请提交成功', function () {
                                            if ('${/parameter/@winid}') {
                                                $("${/parameter/@winid}").close();
                                            } else {
                                                location.href = '${/request/@context_path}/user_role_home_page.lview';
                                                parent.shMenu('show');
                                            }
                                        });

                                    } else {
                                        Leaf.showErrorMessage('提示', res.message);
                                    }
                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        }, function cancel() {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }, 200, 100);
                    } else {
                        $L.showInfoMessage("提示", "请先保存!", null);
                    }
                }
            }
        }

        window['${/parameter/@layout_code}_G_PLAN_ADD_PLAN_layout_dynamic_tab_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_payment_plan');
            var param = {};
            param['url_title'] = '资金投放计划';
            param['function_code'] = 'CAP100F4';
            param['winid'] = 'CAP100_HLS_FUNDING_PLAN_LN_winid';
            param['screen_width'] = '1100';
            param['screen_height'] = '430';
            param['funding_plan_id'] = $(ds_id).getCurrentRecord().get('funding_plan_id');
            //param['side'] = 'right';
            hls_doc_get_layout_code(param, 'HLS_FUNDING_PLAN_LN', cashflow_ds_id, 'CAP100F1');
        }
        function open_payment_dt_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'DT001';
            param['url_title'] = '抵扣明细';
            if (record.get('cf_item') == '0'&&'${/parameter/@function_usage}' != 'QUERY'&&'${/parameter/@function_flag}' == '') {
                param['function_usage'] = 'MODIFY';
            } else {
                param['function_usage'] = 'QUERY';
            }

            param['winid'] = 'hls_payment_dt_winid';

            hls_doc_get_layout_code(param, 'hls_payment_dt', ds_id, 'HLS200F2', null, null, '${/parameter/@layout_code}_dt_save_layout_dynamic_click');

             // param['function_usage'] = 'CREATE';
        }
        //保存
        window['${/parameter/@layout_code}_dt_save_layout_dynamic_click'] = function () {
            if('${/parameter/@function_usage}' != 'QUERY'){
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // var project_id = '${/parameter/@project_id}';

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var channel_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_marketing_channel');
            var branch_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_branch_referrer');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            var planRecord = $(ds_id).getCurrentRecord().data;

            var funding_plan_id = $(ds_id).getCurrentRecord().get('funding_plan_id');


            if($(ln_ds_id).getAll().length != 0) {
                var ln_records = $(ln_ds_id).getAll();
                var hlsCusFundingPlanLnList = [];
                planRecord['hls_cus_funding_plan_ln_list'] = [];
                for (var i = 0; i < ln_records.length; i++) {
                    hlsCusFundingPlanLnList[i] = {};
                    ln_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusFundingPlanLnList[i],ln_records[i].data);
                    planRecord['hls_cus_funding_plan_ln_list'].push(hlsCusFundingPlanLnList[i]);

                }
            }
            if(channel_ds_id){
            if($(channel_ds_id).getAll().length != 0) {
                var channel_records = $(channel_ds_id).getAll();
                var hlsCusCapMarketingChannelList = [];
                planRecord['hls_cus_cap_marketing_channel_list']=[];
                for (var i = 0; i < channel_records.length; i++) {
                    hlsCusCapMarketingChannelList[i] = {};
                    channel_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(hlsCusCapMarketingChannelList[i],channel_records[i].data);
                    planRecord['hls_cus_cap_marketing_channel_list'].push(hlsCusCapMarketingChannelList[i]);

                }
            }
                planRecord[channel_ds_id.replace('_ds','')]=undefined;
            }
            if(branch_ds_id){
            if($(branch_ds_id).getAll().length != 0) {
                var branch_records = $(branch_ds_id).getAll();
                var fundingBranchReferrerList = [];
                planRecord['funding_branch_referrer_list']=[];
                for (var i = 0; i < branch_records.length; i++) {
                    fundingBranchReferrerList[i] = {};
                    branch_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(fundingBranchReferrerList[i],branch_records[i].data);
                    planRecord['funding_branch_referrer_list'].push(fundingBranchReferrerList[i]);

                }
            }
                planRecord[branch_ds_id.replace('_ds','')]=undefined;
            }
            if($(att_ds_id).getAll().length != 0) {
                var att_records = $(att_ds_id).getAll();
                var prjProjectAttachments = [];
                planRecord['prj_project_attachments']=[];
                for (var i = 0; i < att_records.length; i++) {
                    prjProjectAttachments[i] = {};
                    //att_records[i].data['project_id'] = '${/parameter/@project_id}';
                    att_records[i].data['funding_plan_id'] = funding_plan_id;
                    assignValue(prjProjectAttachments[i],att_records[i].data);
                    planRecord['prj_project_attachments'].push(prjProjectAttachments[i]);
                }
            }
            var green_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_green');

            planRecord[ln_ds_id.replace('_ds','')]=undefined;

            planRecord[cashflow_ds_id.replace('_ds','')]=undefined;

            planRecord[att_ds_id.replace('_ds','')]=undefined;
            planRecord[ds_id.replace('_ds','')]=undefined;
            planRecord[green_ds_id.replace('_ds','')]=undefined;

            if(!$(ds_id).validate()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }else{

                Leaf.request({
                    url: '${/request/@context_path}/hls/funding/plan/save',
                    para:  planRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
                        $(ds_id).query();
                        var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
                        $(ln_ds_id).query();
                        //debugger
                        var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                        $(att_ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
            }
        }
        function beforeSubmit(countiune) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan');
            var green_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_green');

            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_plan_ln');
            var cap_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'cap_marketing_channel');
            var referrerds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_funding_branch_referrer');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            var record = $(ds_id).getCurrentRecord();
            var flag = true;
            if(ds_id){
                if($(ds_id).validate()) {
                    var payRecord = record.data;
                    payRecord[ln_ds_id.replace('_ds','')]=undefined;
                    payRecord[cap_ds_id.replace('_ds','')]=undefined;
                    payRecord[referrerds_id.replace('_ds','')]=undefined;
                    payRecord[cashflow_ds_id.replace('_ds','')]=undefined;
                    payRecord[green_ds_id.replace('_ds','')]=undefined;
                    payRecord[att_ds_id.replace('_ds','')]=undefined;
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: "${/request/@context_path}/hls/funding/plan/approve/check",
                        para: record.data,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $(ds_id).submit();
                            flag = true;
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            flag = false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            flag = false;
                        },
                        sync : true,
                        scope: this
                    });

                }
            }
            if(green_ds_id&&flag){
                if($(green_ds_id).validate()) {

                    $(green_ds_id).submit();
                    countiune();
                    return true;
                }
            }else if(flag){
                countiune();
                return true;
            }
            return false;
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>