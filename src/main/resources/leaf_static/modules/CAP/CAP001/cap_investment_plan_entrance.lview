<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="cap_investment_plan_create_id"
                url="${/request/@context_path}/modules/CAP/CAP001/cap_investment_plan_detail.lview"/>
        <script><![CDATA[
            window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
                var ds_id = {};
                var param = {};
                param['url_title'] = '资金投放计划创建';
                param['function_code'] = 'CAP001F1';
                param['winid'] = 'cap_investment_plan_create_winid';
                hls_doc_get_layout_code(param, 'cap_investment_plan_create_id', ds_id, 'CAP001F1');
            };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'plan_number') {
                return '<a href="javascript:open_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            return value;
        };

        function open_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '资金投放计划维护';
            param['function_code'] = 'CAP001F1';
            param['winid'] = 'cap_investment_plan_win_render_id';
            if (param['approve_status'] !== 'NEW' && param['approve_status'] !== "CANCEL" && param['approve_status'] !== 'REJECT') {
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
            }
            hls_doc_get_layout_code(param, 'cap_investment_plan_create_id', null, 'CAP001F1', null, null, null);
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
