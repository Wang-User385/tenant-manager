<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="cap200s1_detail_id"
                url="${/request/@context_path}/modules/CAP/CAP200H/capital_balance_detial.lview"/>
        <a:link id="cap200s2_detail_id"
                url="${/request/@context_path}/modules/CAP/CAP200H/capital_balance_history.lview"/>
        <script><![CDATA[

        function cap200s1_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '收支明细及余额调整明细';
            param['function_code'] = 'CAP200S1';
            param['winid'] = 'cap200s1_detail_open_id';
            // param['bank_account_id'] = record.get('bank_account_id');
            // param['balance_date'] = record.get('balance_date');
            // param['last_balance_date'] = record.get('last_balance_date');
            hls_doc_get_layout_code(param, 'cap200s1_detail_id', null, 'CAP200F1', null, null, null);
        }

        function cap200s2_detail_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '历史结算明细';
            param['function_code'] = 'CAP200S2';
            param['winid'] = 'cap200s2_detail_open_id';
            // param['bank_account_id'] = record.get('bank_account_id');
            hls_doc_get_layout_code(param, 'cap200s2_detail_id', null, 'CAP200F1', null, null, null);
        }

        var params = {};
        function saveInit() {debugger;
            var records = $('CAP200F1_F_RESULT_cap_account_monthly_balance_ds').getSelected();
            //余额处理
            if(records.length == 0){
                Leaf.showMessage('提示', '请至少选择一条数据！');
                return false;
            }else{
                var hlsCusCapAccountMonthlyBalance ={
                    userName:'${/session/@user_name}',
                    userId:'${/session/@user_id}',
                    companyId:'${/parameter/@company_id}',
                    currency:'${/parameter/@currency}',
                    bankId:'${/parameter/@bank_id}',
                    readOnly:'${/parameter/@read_only}',
                    balanceDate:'${/parameter/@balance_date}'
                };
                var datas = [];
                for (var i = 0; i < records.length; i++) {
                    var record = records[i];
                    var accountBalance = record.data['account_balance'];
                    record.data['other_amount'] = accountBalance - record.data['available_amount'] - record.data['restricted_amount'] - record.data['investment_amount'];
                    if(record.data['balance_status'] == 'FULL'){
                        Leaf.showMessage('提示', '存在已结算的数据，请重新选择');
                        return false;
                    }
                    datas.push(record.data);
                }
            }
            params = {
                hlsCusCapAccountMonthlyBalance:hlsCusCapAccountMonthlyBalance,
                hlsCusCapAccountMonthlyBalanceList:datas
            };
            return true;
        }

        //保存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            if(!saveInit()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }
            Leaf.request({
                url: "${/request/@context_path}/cap/account/monthly/balance/save",
                para: params,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 1000
                    });
                    params = {};
                    if (res.success === true) {
                    } else {
                        Leaf.showMessage('提示', res.message);
                    }

                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            })
        };

        //结算
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {debugger;
            new Leaf.showConfirm('${l:HLS.PROMPT}', '是否确认结算?', function okFun() {
                saveInit();
                Leaf.request({
                    url: "${/request/@context_path}/cap/account/monthly/balance/confirm",
                    async: false,
                    para: params,
                    success: function (res) {
                        params = {};
                        if (res.success != undefined && !res.success) {
                            Leaf.showMessage('提示',res.message.split(':')[1]);
                            return false;
                        }
                        $('CAP200F1_F_RESULT_cap_account_monthly_balance_ds').query();
                    },
                    error: function (res) {
                        Leaf.showMessage('提示',res.message);
                    },
                })
            });
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var balance_record = $('CAP200F1_F_BASIC_INFO_cap_account_monthly_balance_ds').getCurrentRecord();
            balance_record.set('bank_name','${/parameter/@bank_name}');
            balance_record.set('company_name','${/parameter/@company_name}');
            balance_record.set('balance_date',new Date());
            balance_record.set('currency','${/parameter/@currency}');
            balance_record.set('account_balance','${/parameter/@account_balance}');
            balance_record.set('available_amount','${/parameter/@available_amount}');
            balance_record.set('unrestricted_investment_amount','${/parameter/@inv_unlimited_amount}');
            balance_record.set('restricted_investment_amount','${/parameter/@inv_limited_amount}');
            balance_record.set('restricted_amount','${/parameter/@restricted_amount}');
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = '';
            if (name === 'detail_month') {
                link_function = 'cap200s1_detail_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">收支明细</a>';
            }
            if (name === 'history_detail') {
                link_function = 'cap200s2_detail_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">历史结算明细</a>';
            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('bank_id', '${/parameter/@bank_id}');
            var ds_id = '${/parameter/@layout_code}_F_BASIC_INFO_cap_account_monthly_balance_ds';
            var dsRecord = $(ds_id).getCurrentRecord();
            var balance_date = dsRecord.get('balance_date');
            if(balance_date == null) {
                ds.setQueryParameter('balance_date', new Date());
            }else{
                ds.setQueryParameter('balance_date', balance_date);
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
