<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var balance_record = $('CAP200S1_F_BASIC_INFO_cap_account_monthly_balance_ds').getCurrentRecord();
            balance_record.set('bank_name','${/parameter/@bank_name}');
            balance_record.set('bank_branch_name','${/parameter/@bank_branch_name}');
            balance_record.set('bank_account_name','${/parameter/@bank_account_name}');
            balance_record.set('bank_account_num','${/parameter/@bank_account_num}');
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if(ds.id && 'CAP200S1_F_BLANCE_DETAIL_cap_account_monthly_balance_ds' == ds.id){
                ds.setQueryParameter('bank_account_id', '${/parameter/@bank_account_id}');
                ds.setQueryParameter('balance_date', '${/parameter/@balance_date}');
                ds.setQueryParameter('last_balance_date', '${/parameter/@last_balance_date}');
            }else{
                ds.setQueryParameter('bank_account_id', '${/parameter/@bank_account_id}');
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
