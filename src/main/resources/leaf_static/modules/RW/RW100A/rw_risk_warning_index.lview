<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: jainfeng.fang
    $Date: 2020年03月10日
    $Revision: 1.0
    $Purpose: 风险预警
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>

        <script><![CDATA[
        function rw_risk_warning_query() {
            $('rw_risk_warning_result_ds').query();
        }

        function rw_risk_warning_reset() {
            $('rw_risk_warning_query_ds').reset();
            $('rw_risk_warning_result_ds').query();
        }

        // 明细
        function detail_renderer(value, record) {
            return '<a href="javascript:rw100a_open_detail(\'' + record.get('risk_warning_id') + '\')">明细</a>';

        }

        function rw100a_open_detail(risk_warning_id) {
            var url = '${/request/@context_path}/modules/RW/RW100A/rw_risk_warning_new.lview';
            var win = new Leaf.Window({
                id: 'rw100a_open_detail_winid',
                url: url,
                params: {
                    risk_warning_id: risk_warning_id,
                    winid: 'rw100a_open_detail_winid'
                },
                title: '风险预警明细',
                fullScreen: true
            });
            win.on('close', function () {
                rw_risk_warning_query();
            });
        }

        function rw_risk_warning_create() {
            var createUrl = '${/request/@context_path}/modules/RW/RW100A/rw_risk_warning_create.lview';
            var win = new Leaf.Window({
                id: 'rw100a_open_create_winid',
                params: {
                    winid: 'rw100a_open_create_winid'
                },
                url: createUrl,
                title: '风险预警新建',
                fullScreen: true
            });
            win.on('close', function () {
                rw_risk_warning_query();
            });
        }

        ]]></script>

        <a:dataSets>
            <!--状态-->
            <a:dataSet id="rw_status_ds" lookupCode="LON.CONTRACT_WITHDRAW_STATUS"/>
            <a:dataSet id="yes_no_ds" lookupCode="SYS.YES_NO"/>
            <!--预警级别-->
            <a:dataSet id="warning_level_ds" lookupCode="RW.RISK_WARNING_LEVEL"/>

            <a:dataSet id="rw_risk_warning_query_ds" autoCreate="true">
                <a:fields>
                    <a:field name="risk_level_desc" options="warning_level_ds" displayField="code_value_name"
                             returnField="risk_level_status" valueField="code_value" prompt="预警级别"/>
                    <a:field name="risk_info_source"/>
                    <a:field name="bp_code"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="rw_risk_warning_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/plm/risk/warning/homeThird/query"
                       queryDataSet="rw_risk_warning_query_ds"
                       selectable="true">
                <a:fields>

                    <a:field name="risk_level_desc" options="warning_level_ds" displayField="code_value_name"
                             returnField="risk_level" valueField="code_value" prompt="预警级别"/>

                    <a:field name="status_desc" readOnly="true" options="rw_status_ds"
                             displayField="code_value_name" returnField="status" valueField="code_value"
                             prompt="状态"/>
                    <a:field name="is_release_warning_desc" readOnly="true" options="yes_no_ds"
                             displayField="code_value_name" returnField="is_release_warning" valueField="code_value"
                             prompt="解除预警"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton text="HLS.QUERY" click="rw_risk_warning_query"/>
                <a:gridButton text="HLS.RESET" click="rw_risk_warning_reset"/>
                <a:gridButton text="新建" click="rw_risk_warning_create"/>
            </a:screenTopToolbar>
            <a:form column="5" labelWidth="100">
                <a:comboBox name="risk_level_desc" bindTarget="rw_risk_warning_query_ds"
                            prompt="预警级别" width="160"/>
                <a:textField name="risk_info_source" emptyText="请输入风险信息来源" bindTarget="rw_risk_warning_query_ds"
                             prompt="风险来源信息" width="160"/>
                <a:textField name="bp_name" emptyText="请输入客户信息" bindTarget="rw_risk_warning_query_ds"
                             prompt="客户信息" width="160"/>

            </a:form>
            <a:grid id="im_insurance_management_grid_id"
                    bindTarget="rw_risk_warning_result_ds"
                    navBar="true" marginHeight="100" marginWidth="100">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="bp_code" prompt="客户编码" width="120"/>
                    <a:column name="bp_name" prompt="客户名称" width="200"/>
                    <a:column name="bp_type_description" prompt="客户类型" width="120"/>
                    <a:column name="risk_info_source" prompt="风险信息来源" width="300"/>
                    <!--<a:column name="warning_start_date_s" prompt="预警开始日期" width="120"/>
                    <a:column name="warning_end_date_s" prompt="预警结束日期" width="120"/>-->
                    <a:column name="risk_level_desc" prompt="预警级别" width="120"/>
                    <a:column name="status_desc" prompt="审批状态" width="80" align="center"/>
                    <a:column name="is_release_warning_desc" prompt="解除预警" align="center" width="80"/>
                    <a:column name="detail" prompt="详情" width="80" align="center" renderer="detail_renderer"/>
                </a:columns>

            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>

