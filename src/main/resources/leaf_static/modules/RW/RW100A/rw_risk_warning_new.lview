<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: jainfeng.fang
    $Date: 2020年03月10日
    $Revision: 1.0
    $Purpose: 风险预警
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">

    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <script><![CDATA[
        var status = 'NEW';
        var changeFlag = 'N';
        var dataClass = 'NORMAL';
        /*        //流程标志
                var issueFlag=false;
                //保存按钮显示标志
                var buttonFlag=false;
                //业务主办反馈风险预警信息
                var businessFlag=false;*/

        var businessKey = '${/parameter/@businessKey}';
        var taskKey = '${/parameter/@task_key}';//task01:业务主办反馈风险信息  task02:资产管理岗

        //var param = parent.currentTaskInfo.execution_variables;

        var riskWarningId = '${/parameter/@risk_warning_id}';


        function rw100a_open_attach(im_attachment_id, table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'im100h_open_attachment_winid',
                url: url,
                params: {
                    header_id: im_attachment_id,
                    table_name: 'PLM_ATTACHMENT',
                    winid: 'im100h_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('rw_detail_file_data_ds').query();
            });
        }

        function attachment_file_render(value, record) {
            var table_name = 'PLM_ATTACHMENT';
            if (record.get('plm_attachment_id') == null || record.get('plm_attachment_id') == undefined || record.get('plm_attachment_id') == '') {
                return '/';
            } else {
                return '<a href="javascript:rw100a_open_attach(\'' + record.get('plm_attachment_id') + '\',\'' + table_name + '\')">附件</a>';
            }
        }

        function attachment_feedback_render(value, record) {
            var table_name = 'PLM_RISK_FEEDBACK';
            if (record.get('feedback_id') == null || record.get('feedback_id') == undefined || record.get('feedback_id') == '') {
                return '/';
            } else {
                return '<a href="javascript:rw100a_open_attach(\'' + record.get('feedback_id') + '\',\'' + table_name + '\')">附件</a>';
            }

        }

        function rw100a_base_ds_query(ds, para) {
            para['risk_warning_id'] = '${/parameter/@risk_warning_id}' || riskWarningId;
            para['change_iq'] = 'NORMAL';
        }

        function rw_detail_file_data_query(ds, para) {
            para['plm_id'] = '${/parameter/@risk_warning_id}' || riskWarningId;
            para['plm_attachment_category'] = 'PLM_RW_ATTACHMENT';
            para['change_iq'] = 'NORMAL';
        }

        function rw_detail_feedback_query(ds, para) {
            para['risk_warning_id'] = '${/parameter/@risk_warning_id}' || riskWarningId;
        }

        function show_input_status(name, value, record) {
            if (value == 'Y') {
                record.getField(name).setReadOnly(false);
            } else {
                record.getField(name).setReadOnly(true);
                record.set(name, '');
            }
        }

        function risk_warning_info_update(dataSet, record, name, value, oldvalue) {
            //勾选checkbox对应的输入框修改只读状态
            if (name == 'breach_contract_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'financial_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'guarantee_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'management_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'associated_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'litigation_risk') {
                show_input_status(name + '_info', value, record);
            } else if (name == 'other_risk') {
                show_input_status(name + '_info', value, record);
            }
        }

        //客户信息更新事件
        function rw100a_detail_client_update(dataSet, record, name, value, oldvalue) {
            if (name == 'bp_id') {
                $('rw_detail_contract_ds').setQueryParameter('bp_id', value);
                $('rw_detail_contract_ds').query();
                $('rw_detail_file_data_ds').setQueryParameter('plm_id', value);
                $('rw_detail_file_data_ds').query();
            }
        }

        function rw100a_detail_client_load(dataSet) {
            if (dataSet.getCurrentRecord() != null) {
                var bp_id = dataSet.getCurrentRecord().get('bp_id');
                if (null != bp_id && undefined != bp_id && '' != bp_id) {
                    $('rw_detail_contract_ds').setQueryParameter('bp_id', bp_id);
                    $('rw_detail_contract_ds').query();
                    $('rw_detail_file_data_ds').setQueryParameter('plm_id', bp_id);
                    $('rw_detail_file_data_ds').query();
                }
                var record_status = dataSet.getCurrentRecord().get('status');
                if (status != null && status != undefined && status != '') {
                    status = record_status;
                }
                if (dataSet.getCurrentRecord().get('data_class') == 'NORMAL' && status == 'PENDING' && businessKey == 0) {
                    changeFlag = 'Y';
                }
            }

            if ($('rw_detail_client_result_ds').getCurrentRecord() != null) {
                var data_class = $('rw_detail_client_result_ds').getCurrentRecord().get('data_class');
                //调整变更则显示预警级别调整前后输入框
                if (data_class == 'CHANGE_REQ') {
                    $('risk_level_before_com_id').show();
                    $('risk_level_after_com_id').show();
                    $('risk_level_com_id').hide();
                }

            }

        }

        function risk_warning_info_load(dataSet) {
            var record = dataSet.getCurrentRecord();
            var breach_contract_risk_info = record.get('breach_contract_risk_info');
            var financial_risk_info = record.get('financial_risk_info');
            var guarantee_risk_info = record.get('guarantee_risk_info');
            var management_risk_info = record.get('management_risk_info');
            var associated_risk_info = record.get('associated_risk_info');
            var litigation_risk_info = record.get('litigation_risk_info');
            var other_risk_info = record.get('other_risk_info');
            if (breach_contract_risk_info != '' && breach_contract_risk_info != undefined && breach_contract_risk_info != null) {
                show_input_status('breach_contract_risk_info', 'Y', record);
                record.set('breach_contract_risk', 'Y');
            }
            if (financial_risk_info != '' && financial_risk_info != undefined && financial_risk_info != null) {
                show_input_status('financial_risk_info', 'Y', record);
                record.set('financial_risk', 'Y');
            }
            if (guarantee_risk_info != '' && guarantee_risk_info != undefined && guarantee_risk_info != null) {
                show_input_status('guarantee_risk_info', 'Y', record);
                record.set('guarantee_risk', 'Y');
            }
            if (management_risk_info != '' && management_risk_info != undefined && management_risk_info != null) {
                show_input_status('management_risk_info', 'Y', record);
                record.set('management_risk', 'Y');
            }
            if (associated_risk_info != '' && associated_risk_info != undefined && associated_risk_info != null) {
                show_input_status('associated_risk_info', 'Y', record);
                record.set('associated_risk', 'Y');
            }
            if (litigation_risk_info != '' && litigation_risk_info != undefined && litigation_risk_info != null) {
                show_input_status('litigation_risk_info', 'Y', record);
                record.set('litigation_risk', 'Y');
            }
            if (other_risk_info != '' && other_risk_info != undefined && other_risk_info != null) {
                show_input_status('other_risk_info', 'Y', record);
                record.set('other_risk', 'Y');
            }
        }

        function save() {
            var ds = $('rw_detail_client_result_ds');
            var ds2 = $('rw_detail_risk_warning_info_ds');
            if (ds.validate() && ds2.validate()) {
                var rw_detail_risk_warning_info = $('rw_detail_risk_warning_info_ds').getJsonData()[0];
                $('rw_detail_client_result_ds').getCurrentRecord().set('riskWarningInfo', rw_detail_risk_warning_info);
                var json = $('rw_detail_client_result_ds').getJsonData()[0];
                Leaf.Masker.mask(Ext.getBody(), '正在保存。。');
                Leaf.request({
                    url: '${/request/@context_path}/plm/risk/warning/submit',
                    para: json,
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        $('rw_detail_client_result_ds').query();
                        Leaf.showMessage('提示', '成功');
                    },
                    failure: function () {
                    },
                    error: function () {
                    },
                    scope: this
                });
            }
        }

        function submit() {
            var ds = $('rw_detail_client_result_ds');
            var ds2 = $('rw_detail_risk_warning_info_ds');
            if (ds.validate() && ds2.validate()) {
                var rw_detail_risk_warning_info = $('rw_detail_risk_warning_info_ds').getJsonData()[0];
                $('rw_detail_client_result_ds').getCurrentRecord().set('riskWarningInfo', rw_detail_risk_warning_info);
                var json = $('rw_detail_client_result_ds').getJsonData()[0];
                Leaf.Masker.mask(Ext.getBody(), '正在提交。。');
                Leaf.request({
                    url: '${/request/@context_path}/plm/risk/warning/submit/wfl',
                    para: json,
                    success: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                        Leaf.showMessage('提示', '成功');
                        $('${/parameter/@winid}').close();

                    },
                    failure: function () {
                    },
                    error: function () {
                    },
                    scope: this
                });
            }
        }

        //打开风险预警调整页面
        function open_change() {
            var createChangeUrl = '${/request/@context_path}/modules/RW/RW100A/rw_risk_warning_change_create.lview';
            var bpName = $('rw_detail_client_result_ds').getCurrentRecord().get('bp_name');
            var bpCode = $('rw_detail_client_result_ds').getCurrentRecord().get('bp_code');

            win = new Leaf.Window({
                id: 'rw100a_open_change_create_winid',
                url: createChangeUrl,
                params: {
                    risk_warning_id: '${/parameter/@risk_warning_id}' || riskWarningId,
                    bp_name: bpName,
                    bp_code: bpCode
                },
                title: '风险预警调整/解除',
                fullScreen: true
            });
            win.on('close', function () {

            });

        }

        function change_cancel() {
            var json = $('rw_detail_client_result_ds').getJsonData()[0];
            Leaf.request({
                url: '${/request/@context_path}/plm/risk/warning/cancelChange',
                para: json,
                success: function (res) {
                    Leaf.showMessage('提示', '成功');

                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
        }


        function contract_number_renderer(value, record, name) {
            if (name = 'contract_number') {
                var contract_id = record.get('contract_id');
                var link_function = 'open_contract_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + contract_id + '\');">' + value + '</a>';
            }

        }

        function open_contract_detail_win(record_id, ds_id, contract_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细查询';
            param['function_code'] = 'CONT301F1';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['query_only'] = 'Y';
            param['hidden_button_code'] = ['exit', 'save', 'user_button1', 'user_button2'];
            param['winid'] = 'con_contract_detail_winid';
            param['contract_id'] = contract_id;
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');

        }


        ]]></script>

        <a:dataSets>
            <!-- 客户信息dataset-->

            <a:dataSet id="yes_no_ds_wfl" lookupCode="SYS.YES_NO"/>
            <!--预警级别-->
            <a:dataSet id="warning_level_ds_wfl" lookupCode="RW.RISK_WARNING_LEVEL"/>
            <a:dataSet id="rw_detail_client_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/plm/risk/warning/query"
                       selectable="true">
                <a:fields>
                    <a:field name="bp_name" autoComplete="true" lovGridHeight="350" lovHeight="500"
                             lovLabelWidth="90"
                             lovService="/hls/bp/credit/line/info/all/queryBpLov~com.hand.hls.layout.dto.LovBpMasterDto"
                             lovWidth="850" required="true" requiredMessage="客户名称不能为空" title="风险预警客户信息" prompt="客户名称">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                            <a:map from="bp_class" to="bp_class"/>
                            <a:map from="bp_type" to="bp_type"/>
                            <a:map from="bp_type_desc" to="bp_type_description"/>
                            <a:map from="associated_division" to="associated_division"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="risk_warning_id" defaultValue="${/parameter/@risk_warning_id}"/>
                    <a:field name="bp_id"/>
                    <a:field name="bp_code"/>
                    <a:field name="bp_class"/>
                    <a:field name="bp_type"/>
                    <a:field name="bp_type_description"/>
                    <a:field name="associated_division"/>
                    <a:field name="is_presence_warning_desc" options="yes_no_ds_wfl" displayField="code_value_name"
                             returnField="is_presence_warning" valueField="code_value" prompt="是否存在风险" readOnly="true"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="rw100a_base_ds_query"/>
                    <a:event name="update" handler="rw100a_detail_client_update"/>
                    <a:event name="load" handler="rw100a_detail_client_load"/>
                </a:events>
            </a:dataSet>
            <a:dataSet id="rw_detail_risk_warning_info_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/plm/risk/warning/info/query"
                       selectable="true">
                <a:fields>
                    <a:field name="risk_warning_id" defaultValue="${/parameter/@risk_warning_id}"/>
                    <a:field name="breach_contract_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="financial_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="guarantee_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="management_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="associated_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="litigation_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="other_risk" defaultValue="N" checkedValue="Y" unCheckedValue="N"/>
                    <a:field name="breach_contract_risk_info" readOnly="true"/>
                    <a:field name="financial_risk_info" readOnly="true"/>
                    <a:field name="guarantee_risk_info" readOnly="true"/>
                    <a:field name="management_risk_info" readOnly="true"/>
                    <a:field name="associated_risk_info" readOnly="true"/>
                    <a:field name="litigation_risk_info" readOnly="true"/>
                    <a:field name="other_risk_info" readOnly="true"/>
                    <a:field name="risk_level_desc" options="warning_level_ds_wfl" displayField="code_value_name"
                             returnField="risk_level" valueField="code_value" prompt="预警级别" required="true"/>
                    <a:field name="risk_level_before_desc" options="warning_level_ds_wfl" displayField="code_value_name"
                             returnField="risk_level_before" valueField="code_value" prompt="调整前预警级别"/>
                    <a:field name="risk_level_after_desc" options="warning_level_ds_wfl" displayField="code_value_name"
                             returnField="risk_level_after" valueField="code_value" prompt="调整后预警级别"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="rw100a_base_ds_query"/>
                    <a:event name="update" handler="risk_warning_info_update"/>
                    <a:event name="load" handler="risk_warning_info_load"/>
                </a:events>
            </a:dataSet>
            <!-- 合同信息dataset-->
            <a:dataSet id="rw_detail_contract_ds" autoPageSize="true"
                       queryUrl="${/request/@context_path}/plm/rw/risk/warning/contracts/query"
                       selectable="true">
                <a:fields>
                    <a:field name="bpName"/>
                    <a:field name="rate_valid_from" datatype="date"/>
                </a:fields>
            </a:dataSet>
            <!-- 附件信息dataset-->
            <a:dataSet id="rw_detail_file_data_ds" autoPageSize="true"
                       queryUrl="${/request/@context_path}/plm/attachment/document/name/query/info"
                       submitUrl="${/request/@context_path}/plm/attachment/submit"
                       deleteUrl="${/request/@context_path}/plm/attachment/remove"
                       selectable="true">
                <a:fields>
                    <a:field name="plm_attachment_id"/>
                    <a:field name="plm_id" defaultValue="${/parameter/@risk_warning_id}"/>
                    <a:field name="plm_attachment_category" defaultValue="PLM_RW_ATTACHMENT"/>
                    <a:field name="plm_source_type" defaultValue="PLM_RW_ATTACHMENT"/>
                    <a:field name="source_type" defaultValue="PLM_RW_ATTACHMENT"/>
                    <a:field name="plm_type" defaultValue="RW"/>
                    <a:field name="change_iq" defaultValue="NORMAL"/>

                </a:fields>
                <a:events>
                    <a:event name="query" handler="rw_detail_file_data_query"/>
                </a:events>
            </a:dataSet>
            <!-- 反馈信息dataset-->
            <a:dataSet id="rw_detail_feedback_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/plm/risk/feedback/attachment/query/info"
                       submitUrl="${/request/@context_path}/plm/risk/feedback/attachment/submit"
                       selectable="true">
                <a:fields>
                    <a:field name="risk_warning_id" defaultValue="${/parameter/@risk_warning_id}"/>
                    <a:field name="feedback_date" datatype="date"/>
                    <a:field name="risk_level_desc" options="warning_level_ds_wfl" displayField="code_value_name"
                             returnField="risk_level" valueField="code_value" prompt="当前预警级别"/>
                    <a:field name="plm_attachment_category" defaultValue="PLM_RW_ATTACHMENT_BACK"/>
                    <a:field name="plm_source_type" defaultValue="PLM_RW_ATTACHMENT_BACK"/>
                    <a:field name="source_type" defaultValue="PLM_RW_ATTACHMENT_BACK"/>
                    <a:field name="plm_type" defaultValue="RW"/>
                    <a:field name="change_iq" defaultValue="NORMAL"/>
                </a:fields>
                <a:events>
                    <a:event name="query" handler="rw_detail_feedback_query"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton text="HLS.SAVE" click="save" id="saveButtonId"/>
                <a:gridButton text="HLS.SUBMIT_TO_APPROVE" click="submit" id="submitButtonId"/>
                <a:gridButton text="调整/解除" click="open_change" id="changeButtonId" disabled="false" hidden="true"/>
                <a:gridButton text="取消调整/解除" click="change_cancel" id="changeCancelId" disabled="false" hidden="true"/>

            </a:screenTopToolbar>
            <a:form column="4" labelWidth="100" title="客户信息">
                <a:lov name="bp_name" bindTarget="rw_detail_client_result_ds"
                       prompt="客户名称" width="160"/>
                <a:textField name="bp_code" bindTarget="rw_detail_client_result_ds"
                             prompt="客户编码" width="160" readOnly="true"/>
                <a:textField name="bp_type_description" bindTarget="rw_detail_client_result_ds"
                             prompt="客户类型" width="160" readOnly="true"/>
            </a:form>
            <a:form column="7" labelWidth="150" title="风险信息来源">
                <a:checkBox name="breach_contract_risk" prompt="违约风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="financial_risk" prompt="财务风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="guarantee_risk" prompt="担保风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="management_risk" prompt="经营管理风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="associated_risk" prompt="关联风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="litigation_risk" prompt="涉诉风险信息" bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:checkBox name="other_risk" prompt="其他预警信息" bindTarget="rw_detail_risk_warning_info_ds"/>
            </a:form>
            <a:grid id="rw_detail_contract_grid_id"
                    bindTarget="rw_detail_contract_ds"
                    navBar="true" height="500" marginWidth="100" title="合同信息">
                <a:columns>
                    <a:column name="contract_number" prompt="合同查询编号" width="130" renderer="contract_number_renderer"/>
                    <a:column name="approval_number" prompt="合同业务编码" width="130" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="contract_name" prompt="合同名称" width="200" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="bp_name" prompt="客户名称" width="200" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="business_type" prompt="业务类型" width="80" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="rate_valid_from" prompt="项目投放时间" renderer="Leaf.formatDate" width="120"
                              editor="rw_detail_contract_grid_tx"/>
                    <a:column name="lease_term" prompt="期限(月)" width="120" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="remain_amount" prompt="当前剩余本金" width="120" align="right" renderer="Leaf.formatMoney"
                              editor="rw_detail_contract_grid_tx"/>
                    <a:column name="finance_amount" prompt="项目投放金额" width="120" align="right"
                              renderer="Leaf.formatMoney" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="host_name" prompt="主办项目经理" width="120" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="co_organizer" prompt="协办项目经理" width="120" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="unit_name" prompt="所属部门" width="120" editor="rw_detail_contract_grid_tx"/>
                    <a:column name="guarantor_name" prompt="担保人(如有)" width="120" editor="rw_detail_contract_grid_tx"/>
                    <!-- <a:column name="detail" prompt="详情" width="120" align="center" renderer="detail_renderer"/>-->
                </a:columns>
                <a:editors>
                    <a:textField id="rw_detail_contract_grid_tx" readOnly="true"/>
                </a:editors>
            </a:grid>
            <a:form title="风险预警信息" labelWidth="150">
                <a:textArea name="breach_contract_risk_info" width="800" prompt="违约风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="financial_risk_info" width="800" prompt="财务风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="guarantee_risk_info" width="800" prompt="担保风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="management_risk_info" width="800" prompt="经营管理风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="associated_risk_info" width="800" prompt="关联风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="litigation_risk_info" width="800" prompt="涉诉风险信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:textArea name="other_risk_info" width="800" prompt="其他预警信息"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
            </a:form>
            <a:form title="级别认定" labelWidth="150">
                <a:comboBox name="is_presence_warning_desc" prompt="是否存在风险" bindTarget="rw_detail_client_result_ds"/>
                <a:comboBox id="risk_level_com_id" name="risk_level_desc" prompt="预警级别"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:comboBox id="risk_level_before_com_id" hidden="true" name="risk_level_before_desc" prompt="调整前预警级别"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
                <a:comboBox id="risk_level_after_com_id" hidden="true" name="risk_level_after_desc" prompt="调整后预警级别"
                            bindTarget="rw_detail_risk_warning_info_ds"/>
            </a:form>
            <a:grid id="rw_upload_files_grid_id"
                    bindTarget="rw_detail_file_data_ds"
                    navBar="true" height="500" marginWidth="100" title="附件">
                <a:toolBar>
                    <a:button type="add"/>
                    <a:button type="delete"/>
                    <a:button type="save"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="document_name" prompt="附件类别" width="120" editor="rw_detail_file_data_grid_tx"/>
                    <a:column name="attach" prompt="附件" width="120" align="center" renderer="attachment_file_render"/>
                    <a:column name="file_name" prompt="附件名一览" width="500"/>
                    <a:column name="description" prompt="备注" width="120" editor="rw_detail_file_data_grid_tx"/>
                </a:columns>
                <a:editors>
                    <a:textField id="rw_detail_file_data_grid_tx"/>
                </a:editors>
            </a:grid>
            <a:grid id="rw_detail_feedback_grid_id"
                    bindTarget="rw_detail_feedback_ds"
                    navBar="true" height="500" marginWidth="100" title="反馈信息列">
                <a:toolBar>
                    <a:button type="add" id="rw_detail_feedback_add_button" hidden="true"/>
                    <a:button type="delete" id="rw_detail_feedback_delete_button" hidden="true"/>
                    <a:button type="save" id="rw_detail_feedback_save_button" hidden="true"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="feedback_date" prompt="反馈日期" width="120" renderer="Leaf.formatDate"
                              editor="rw_detail_feedback_grid_date"/>
                    <a:column name="risk_level_desc" prompt="当前预警级别" width="120" editor="rw_detail_feedback_grid_com"/>
                    <a:column name="risk_info" prompt="反馈类型" width="120" editor="rw_detail_feedback_grid_tx"/>
                    <a:column name="feedback_info" prompt="反馈内容" width="120" editor="rw_detail_feedback_grid_tx"/>
                    <a:column name="attach" prompt="附件" width="120" align="center"
                              renderer="attachment_feedback_render"/>
                </a:columns>
                <a:editors>
                    <a:textField id="rw_detail_feedback_grid_tx"/>
                    <a:datePicker id="rw_detail_feedback_grid_date"/>
                    <a:comboBox id="rw_detail_feedback_grid_com"/>
                </a:editors>
            </a:grid>
        </a:screenBody>
        <script><![CDATA[




                ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
