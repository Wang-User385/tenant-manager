<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_lease_detail_id01"
                url="${/request/@context_path}/modules/HN/LEASE/prj_lease_detail.lview"/>

        <script><![CDATA[

        Leaf.onReady(function() {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var prj_check_record = $(ds_id).getAt(0);
            //debugger
            prj_check_record.set('lease_inspect_number', '${/parameter/@lease_inspect_number}');
            prj_check_record.set('user_id', '${/session/@employeeId}');
            prj_check_record.set('user_id_n', '${/session/@employeeName}');
            prj_check_record.set('approve_status', 'NEW');
            prj_check_record.set('approve_status_n', '新建');
            prj_check_record.set('lease_inspect_date', new Date())

        });

        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/hls/marketing/report/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        }

        //
        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function (){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            if($(ds_id).validate()){
                debugger;
                var contract_number = $(ds_id).getCurrentRecord().get('contract_number');
                var project_id = $(ds_id).getCurrentRecord().get('project_id');
                var param= $(ds_id).getAt(0).data;
                param['lease_inspect_number'] = '${/parameter/@lease_inspect_number}' ;
                param['user_id'] = '${/session/@employeeId}';
                param['approve_status'] =  'NEW';
                param['contract_number'] =  contract_number;
                param['project_id'] = project_id;
                param['lease_inspect_date'] = $(ds_id).getCurrentRecord().get('lease_inspect_date');

                Leaf.request({
                    url: "${/request/@context_path}/prj/lease/inspect/create",
                    para: {param: param},
                    success: function (res) {
                        console.log(res);
                        var prjLeaseId = res.result.record[0].prj_lease_id;
                        if (prjLeaseId == 'undefined' || prjLeaseId == '' || prjLeaseId == null) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showInfoMessage('创建失败!');
                            return;
                        } else {
                            Leaf.Masker.unmask(Ext.getBody());
                            // param['function_code'] = 'ADC001F2';
                            // //param['function_code'] = 'ADC001';
                            // param['url_title'] = '资产处置明细页面';
                            // param['function_usage'] = 'CREATE';
                            // param['assets_disposal_id'] =  assets_disposal_id ;
                            // var link_id = 'a_disposal_detail_id';
                            // hls_doc_get_layout_code(param, link_id, ds_id, 'ADC001F2');
                            //
                            // /*Leaf.showInfoMessage("提示", "创建成功!", function () {
                            //     $('${/parameter/@winid}').close();
                            //     var winId = '${/parameter/@winid}';
                            //     if (!!winId) {
                            //         $(winId).close();
                            //     }
                            //
                            //     $('${/parameter/@ds_id}').query();
                            // });*/
                            var ds_record = $(ds_id).getCurrentRecord();
                            var lease_inspect_number = ds_record.get('lease_inspect_number');
                            var authority_rule_string = ds_record.get('authority_rule_string');
                            var param = {};
                            //debugger
                            var prj_check_record = $(ds_id).getAt(0);

                            var param = prj_check_record.data;
                            param['url_title'] = '租赁物巡查明细页面';
                            param['function_code'] = 'PRJ_LEASE_DETAIL';
                            param['lease_inspect_number'] = lease_inspect_number;
                            param['prj_lease_id'] = prjLeaseId;
                            param['function_usage'] = 'CREATE';

                            param['winid'] = 'prj_lease_detail_winid033';
                            hls_doc_get_layout_code(param, 'prj_lease_detail_id01', ds_id, 'PRJ_LEASE_DETAIL');

                        }
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });

            }


        }






        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function(ds, record) {
            var check_flag = true;
            return check_flag;
        };

        // //保存submitsuccess调用
        // window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
        //     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
        //     var ds_record = $(ds_id).getCurrentRecord();
        //     var lease_inspect_number = ds_record.get('lease_inspect_number');
        //     var authority_rule_string = ds_record.get('authority_rule_string');
        //     var param = {};
        //     //debugger
        //     var prj_check_record = $(ds_id).getAt(0);
        //
        //     var param = prj_check_record.data;
        //     param['url_title'] = '租赁物巡查明细页面';
        //     param['function_code'] = 'PRJ_LEASE_DETAIL';
        //     param['lease_inspect_number'] = lease_inspect_number;
        //     param['function_usage'] = 'CREATE';
        //     //param['user_name'] = userName;
        //    // param['function_usage'] = 'CREATE';
        //
        //     param['winid'] = 'prj_lease_detail_winid01';
        //     hls_doc_get_layout_code(param, 'prj_lease_detail_id01', ds_id, 'PRJ_LEASE_DETAIL');
        // };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>