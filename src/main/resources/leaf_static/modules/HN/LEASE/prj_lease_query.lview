<!--
    $Author: xiaorong
    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_lease_entrance_id"
                url="${/request/@context_path}/modules/HN/LEASE/prj_lease_entrance.lview"/>
        <a:link id="prj_lease_detail_id"
                        url="${/request/@context_path}/modules/HN/LEASE/prj_lease_detail.lview"/>
        <a:link id="csh301_transaction_receipt_allocation_confirm_link"
                        url="${/request/@context_path}/prj/lease/inspect/submit"/>
        <script><![CDATA[

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect'):
                    //管理页面查询自己的单据
                    if('${/parameter/@function_code}' == 'PRJ_LEASE_QUERY'){
                        qpara['created_by'] = '${/session/@user_id}';
                    }
                    break;
            }
        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var record=$(ds_id).getAll()
            var param = {};
            if(record.length==0){
                param['lease_inspect_number']=produceInspectNumber(null)
            }else{
                var lease_inspect_number=record[0].data.lease_inspect_number
                param['lease_inspect_number']=produceInspectNumber(lease_inspect_number)
            }

            param['url_title'] = '租赁物巡查创建入口';
            param['function_code'] = 'PRJ_LEASE_ENTRANCE2';
            param['function_usage'] = 'CREATE';
            //param['user_name'] = userName;
            param['function_usage'] = 'CREATE';
            param['screen_width'] = '600';

            param['side'] = 'right';
            param['winid'] = 'prj_check_entrance_create_winid';
            hls_doc_get_layout_code(param, 'prj_lease_entrance_id', ds_id, 'PRJ_LEASE_ENTRANCE2');

        };
        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var record=$(ds_id).getSelected()
            if(record.length==0){
                Leaf.showMessage('提示','请选择一条数据进行审批！');
                return
            }
             var data={}
            data.prj_lease_id=record[0].data.prj_lease_id
            Leaf.request({
                type: 'POST',
                url: "${/request/@context_path}/prj/lease/inspect/submit",
                contentType: "application/json; charset=utf-8",
                para: data,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '操作成功',
                        duration: 2000
                    });
                    $(ds_id).query();
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                //sync: true,
                scope: this
            });
         };

        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {
            var approval_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var record = $(approval_ds_id).getCurrentRecord();
            if (ds.id === approval_ds_id) {
                if(record.get('approve_status') == 'APPROVING' || record.get('approve_status') == 'APPROVED'){
                    Leaf.showMessage('提示', '审批中或审批通过的费用不允许删除');
                    return false;
                }
            }
        }


        //生成权限字符串
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/prj/lease/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };

        function produceInspectNumber(lease_inspect_number){

            var date = new Date();
            var year=date.getFullYear(); //获取完整的年份(4位)
            var month=date.getMonth()+1; //获取当前月份(0-11,0代表1月)
            month=month>9?month:'0'+month
            var day=date.getDate(); //获取当前日(1-31)
            day =day>9?day:'0'+day
            if(lease_inspect_number!=null){
              var tmp= lease_inspect_number.substring(lease_inspect_number.length-4)
              var tmp1= Number(tmp)+1
              if(tmp1<10){
                tmp1='000'+tmp1
              }else if(tmp1<100){
                tmp1='00'+tmp1
              }else if(tmp1<1000){
                tmp1='0'+tmp1
              }
              lease_inspect_number='XC'+'-'+year+month+day+'-'+tmp1
            }else{
                lease_inspect_number='XC'+'-'+year+month+day+'-0001'
            }
            return lease_inspect_number
        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {

            if (name == 'detail') {
                return '<a href="javascript:open_lease_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '巡查明细' + '</a>';
            }
            return value;
        };

        function open_lease_detail_win(ds_id, record_id) {

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['prj_lease_id']=record.data.prj_lease_id
            param['url_title'] = '租赁物巡查明细页面';
            param['function_code'] = 'PRJ_LEASE_DETAIL';
           //param['function_usage'] = 'CREATE';
            //param['user_name'] = userName;
            //param['function_usage'] = 'CREATE';
            if('${/parameter/@function_code}' == 'PRJ_LEASE_QUERY_F1'){
                param['function_usage'] = 'QUERY';
            }else if(record.get('approve_status') == 'NEW'||record.get('approve_status') == 'REJECTED'){
                param['function_usage'] = 'MODIFY';
            }else{
                param['function_usage'] = 'QUERY';
            }
            // param['layout_debugger_flag'] = 'Y';
            param['winid'] = 'prj_lease_detail_winid';
            hls_doc_get_layout_code(param, 'prj_lease_detail_id', ds_id,'PRJ_CHECK');

        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>