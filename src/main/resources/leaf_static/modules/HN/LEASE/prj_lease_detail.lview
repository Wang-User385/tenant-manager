-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="lease_query_detaill_id_11"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="lease001_open_attachment_winid" url="${/request/@context_path}/uploadFile.lview"/>
        <script><![CDATA[
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        };
        window['attachment'] = function (record_id, ds_id) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var record = $(ds_id).findById(record_id);
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var approve_status = prj_record.get('approve_status');
            var lease_info_id = record.get('lease_info_id');
            if (insure_id == undefined || insure_id == 0) {
                $L.showInfoMessage("提示", "请先保存当前页面信息，再上传附件!");
                return;
            }
            var url;
            var function_usage = '${/parameter/@function_usage}';
            if ('${/parameter/@function_usage}' == 'QUERY') {

            } else {
                if (approve_status === 'APPROVING' || approve_status === 'APPROVED') {
                    url = '${/request/@context_path}/downloadFile.lview';
                } else {
                    url = '${/request/@context_path}/uploadFile.lview';
                }

            }
            var table_name;
            table_name = 'PRJ_LEASE_INFO';
            var win = new Leaf.Window({
                id: 'im200_open_attachment_winid',
                url: url,
                params: {
                    'header_id': lease_info_id,
                    'table_name': table_name,
                    winid: 'lease001_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                // $(prj_ds_id).query();
            });
        };


        window['approval_upload_file'] = function (record_id, lease_info_id) {
            if (typeof (lease_info_id) === 'undefined' || 'undefined' === lease_info_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj_lease_inspectwfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': lease_info_id,
                    'table_name': 'prj_lease_inspect',
                    winid: 'prj_lease_inspect_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'assets_disposal_attch');
                $(ds_id).query();
            });
        };

        window['rule_upload_file'] = function (record_id, rule_id) {
            if (typeof (rule_id) === 'undefined' || 'undefined' === rule_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj_lease_rule_open_attachment_winid',
                url: url,
                params: {
                    'header_id': rule_id,
                    'table_name': 'prj_lease_make_rule',
                    winid: 'prj_lease_rule_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_make_rule');
                $(ds_id).query();
            });
        };

        function lease001_detail_open(ds_id, record_id) {
            debugger;
            var param = $(ds_id).findById(record_id).data;
            var lease_item_id = param.lease_item_id;
            param['url_title'] = '详细信息';
            var link_id;
            param['function_code'] = 'LEASE001F1';
            param['lease_item_id'] = lease_item_id;
            link_id = 'lease_query_detaill_id_11';
            param['winid'] = 'lease_item_detail_winid1';
            param['ds_id'] = ds_id;
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            debugger
            if (name === 'attachment' && record.get('lease_info_id')) {

                return '<a href="javascript:approval_upload_file(\'' + record.id + '\',\'' + record.get('lease_info_id') + '\')">附件上传</a>';
                // return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传'  +'</a>';
            }
            if (name === 'rule_file' && record.get('rule_id') && !record.isNew) {
                return '<a href="javascript:rule_upload_file(\'' + record.id + '\',\'' + record.get('rule_id') + '\')">附件上传</a>';
            }

            if (name == 'asset_name' && value && !record.isNew) {
                return '<a href="javascript:lease001_detail_open(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }

        };


        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/hls/marketing/report/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                    $(ds_id).getCurrentRecord().set('approve_status', 'NEW');
                },
                sync: true,
                scope: this
            });
        }

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_lease_inspect');
            var ds_record = $(ds_id).getCurrentRecord();
            var authority_rule_string = ds_record.get('authority_rule_string');
            if (authority_rule_string == null && check_flag) {
                window['${/parameter/@layout_code}_set_authority_rule_string']();
            }
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>