<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <style>
            #PRJ_CHECK_DETAIL_G_ATTACHMENT_jczl_common_attachment_layout_grid_id_wrap {
                padding-top: 50px;
            }
        </style>
        <a:link id="prj_contract_detail_id"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_ten_enstimate.lview"/>
        <a:link id="prj_bp_risk_warn_id"
                url="${/request/@context_path}/modules/RISK/RISK100/risk_warning.lview"/>
        <a:link id="con_prj_lease_detail_1_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="prj_finance_detail_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_finance_home.lview"/>
        <script><![CDATA[
        var check_id = '${/parameter/@check_id}';
        var query_flag = 'Y';
        //新增时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');

            //风险情况
            var risk_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_THIS_CHECK');
            //项目批复
            var reply_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_REPLY_SITUATION');
            if (risk_ds_id == ds.id) {
                record.set('hd_id', $(basic_ds_id).getCurrentRecord().get("risk_hd_id"));
                record.set('check_type', 'RISK');
            }
            if (reply_ds_id == ds.id) {
                record.set('hd_id', $(basic_ds_id).getCurrentRecord().get("risk_hd_id"));
                record.set('check_type', 'REPLY');
            }
            //融资申请人
            var tenant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASE');
            var tenant_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            var tenant_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            var tenant_received_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_RECEIVED');
            if (tenant_basic_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_BASIC');
            }
            if (tenant_credit_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_CREDIT');
            }
            if (tenant_finance_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_FINANCE');
            }
            if (tenant_received_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_RECEIVED');
            }

            //担保人
            var gurantor_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASI_GU');
            var gurantor_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var gurantor_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var gurantor_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            if (gurantor_basic_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_BASIC');
            }
            if (gurantor_credit_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_CREDIT');
            }
            if (gurantor_finance_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_FINANCE');
            }

            //合作方
            var manufacturer_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASI_MA');
            var manufacturer_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_MA');
            var manufacturer_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_MA');
            var manufacturer_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_MA');
            if (manufacturer_basic_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_BASIC');
            }
            if (manufacturer_credit_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_CREDIT');
            }
            if (manufacturer_finance_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_FINANCE');
            }
        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            //debugger;
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'T_FROM');
            var check_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_THIS');
            var conclusion_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_MUNU10_FORM');
            var base_record = $(base_ds_id).getCurrentRecord();

            if (ds.id == base_ds_id) {
                if (name == 'check_type_locale' && value == 'Y') {
                    base_record.set('check_type_unlocale', 'N');
                    base_record.set('check_type_other', 'N');
                }
                if (name == 'check_type_unlocale' && value == 'Y') {
                    base_record.set('check_type_locale', 'N');
                    base_record.set('check_type_other', 'N');
                }
                if (name == 'check_type_other' && value == 'Y') {
                    base_record.set('check_type_unlocale', 'N');
                    base_record.set('check_type_locale', 'N');
                }
            }

            if (name == 'five_classification_result_n' && value) {
                base_record.set('product_conclusion_n',value)
            }
            if (name == 'five_classification_result' && value) {
                base_record.set('product_conclusion',value)
            }

            var items_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_THIS_CHECK');
            var items_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_REPLY_SITUATION');
            var items_ds_id3 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            var items_ds_id4 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            var items_ds_id5 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            var items_ds_id6 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_RECEIVED');
            var items_ds_id7 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var items_ds_id8 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var items_ds_id9 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            var items_ds_id10 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_LEASE');
            var items_ds_id11 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_PLEDGE');
            var items_ds_id12 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_MA');
            var items_ds_id13 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_MA');
            var items_ds_id14 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_MA');

            if (ds.id == items_ds_id1 || ds.id == items_ds_id2 || ds.id == items_ds_id3 || ds.id == items_ds_id4 || ds.id == items_ds_id5
                || ds.id == items_ds_id6 || ds.id == items_ds_id7 || ds.id == items_ds_id8 || ds.id == items_ds_id9 || ds.id == items_ds_id10
                || ds.id == items_ds_id11 || ds.id == items_ds_id12 || ds.id == items_ds_id13 || ds.id == items_ds_id14) {
                if (name == 'check_y' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('check_n', 'N');
                    $(ds.id).getCurrentRecord().getField('description').setRequired(false);
                }
                if (name == 'check_n' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('check_y', 'N');
                    $(ds.id).getCurrentRecord().getField('description').setRequired(true);
                }
            }

            var hd_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_FINANCE_REPORT');
            var hd_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_FINANCE_REPORT_GU');
            var hd_ds_id3 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_FINANCE_REPORT_MA');

            if (ds.id == hd_ds_id1 || ds.id == hd_ds_id2 || ds.id == hd_ds_id3) {
                if (name == 'audit_y' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('audit_n', 'N');
                }
                if (name == 'audit_n' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('audit_y', 'N');
                }
                if (name == 'compare_audit_y' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('compare_audit_n', 'N');
                }
                if (name == 'compare_audit_n' && value == 'Y') {
                    $(ds.id).getCurrentRecord().set('compare_audit_y', 'N');
                }
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'T_FROM');
            var last_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_LAST_CHECK');
            var this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_THIS');
            var tab1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'T_TAB1_FORM');
            var munu7_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_MENU7_FORM');
            var munu8_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_MUNU8_FORM');
            var munu9_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_MUNU9_FORM');
            var munu10_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_MUNU10_FORM');

            if (ds.id == basic_ds_id || ds.id == last_ds_id || ds.id == this_ds_id || ds.id == tab1_ds_id || ds.id == munu7_ds_id
                || ds.id == munu8_ds_id || ds.id == munu9_ds_id || ds.id == munu10_ds_id) {
                qpara['check_id'] = check_id;
            }

            var tenant_base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_BASE');
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_FINANCE_REPORT');
            if (ds.id == tenant_base_ds_id || ds.id == tenant_finance_ds_id) {
                qpara['check_category'] = 'TENANT';
            }

            var gu_base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_BASI_GU');
            var gu_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_FINANCE_REPORT_GU');
            var gu_refinance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_REFINANCE_GU');
            var gu_other_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_OTHER_GU');
            if (ds.id == gu_base_ds_id || ds.id == gu_finance_ds_id || ds.id == gu_refinance_ds_id || ds.id == gu_other_ds_id) {
                qpara['check_category'] = 'GUARANTOR';
            }

            var ma_base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_BASI_MA');
            var ma_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_FINANCE_REPORT_MA');
            var ma_refinance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_REFINANCE_MA');
            var ma_other_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_OTHER_MA');
            if (ds.id == ma_base_ds_id || ds.id == ma_finance_ds_id || ds.id == ma_refinance_ds_id || ds.id == ma_other_ds_id) {
                qpara['check_category'] = 'MANUFACTURER';
            }

            var lease_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_DESC_LEASE');
            if (ds.id == lease_ds_id) {
                qpara['check_category'] = 'SUBJECT';
            }
            var auth_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_asset_class_head');
            if (ds.id == auth_ds_id) {
                qpara['bp_id'] = '${/parameter/@bp_id}';
            }
            debugger


        };
        //查询时调用(grid,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            //风险预警
            var risk_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_THIS_CHECK');
            //项目批复
            var reply_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_REPLY_SITUATION');

            //客户基本情况
            var tenant_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            //客户主体信用情况
            var tenant_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            //客户财务
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            //客户回款
            var tenant_cash_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_RECEIVED');
            //担保人
            var gurantor_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var gurantor_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var gurantor_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            //合作方
            var manufacturer_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_MA');
            var manufacturer_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_MA');
            var manufacturer_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_MA');
            if (ds.id == risk_ds_id) {
                qpara['check_type'] = 'RISK';
                qpara['check_id'] = check_id;
            }
            if (ds.id == reply_ds_id) {
                qpara['check_type'] = 'REPLY';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_basic_ds_id) {
                qpara['check_type'] = 'TENANT_BASIC';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_credit_ds_id) {
                qpara['check_type'] = 'TENANT_CREDIT';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_finance_ds_id) {
                qpara['check_type'] = 'TENANT_FINANCE';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_cash_ds_id) {
                qpara['check_type'] = 'TENANT_RECEIVED';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_basic_ds_id) {
                qpara['check_type'] = 'GUARANTOR_BASIC';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_credit_ds_id) {
                qpara['check_type'] = 'GUARANTOR_CREDIT';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_finance_ds_id) {
                qpara['check_type'] = 'GUARANTOR_FINANCE';
                qpara['check_id'] = check_id;
            }
            if (ds.id == manufacturer_basic_ds_id) {
                qpara['check_type'] = 'MANUFACTURER_BASIC';
                qpara['check_id'] = check_id;
            }
            if (ds.id == manufacturer_credit_ds_id) {
                qpara['check_type'] = 'MANUFACTURER_CREDIT';
                qpara['check_id'] = check_id;
            }
            if (ds.id == manufacturer_finance_ds_id) {
                qpara['check_type'] = 'MANUFACTURER_FINANCE';
                qpara['check_id'] = check_id;
            }
            //标的
            var subject_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_LEASE');
            if (ds.id == subject_ds_id) {
                qpara['check_type'] = 'SUBJECT';
                qpara['check_id'] = check_id;
            }
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_PLEDGE');
            if (ds.id == pledge_ds_id) {
                qpara['check_type'] = 'PLEDGE';
                qpara['check_id'] = check_id;
            }

        };

        //投后检查报告打印
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //debugger;

            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');


                var record = $(ds_id).getCurrentRecord();
                var template_code = 'RENT_CHECK';
                if (record.get('contract_id') && record.get('contract_id') != null && record.get('contract_id') != '') {
                    Leaf.Masker.mask(Ext.getBody(), '正在生成投后检查报告打印...');
                    Leaf.request({
                        url: "${/request/@context_path}/prj/virprj/create/content",
                        para: {
                            project_id: record.get('contract_id'),
                            check_id: record.get('check_id'),
                            template_code: template_code,
                            instance_id: record.get('process_instance_id')
                        },
                        success: function (res) {
                            debugger;
                            console.log(res);
                            var source_pk_value1 = res.result.record[0].source_pk_value1;
                            if (source_pk_value1 == 'undefined' || source_pk_value1 == '' || source_pk_value1 == null) {
                                Leaf.Masker.unmask(Ext.getBody());
                                Leaf.showInfoMessage('未找到投后检查报告模板!');
                                return;
                            } else {
                                Leaf.Masker.unmask(Ext.getBody());
                                //Leaf.showInfoMessage('合同文本生成成功!');
                                var down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + res.result.record[0].attachment_id;
                                location.href = down_url;
                            }
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        scope: this
                    });
                }
            });
        }

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                var data = {};
                data.check_id = '${/parameter/@check_id}';
                data.check_number = '${/parameter/@check_number}'
                var status='${/parameter/@approve_suggest}'
                if (status == 'NEW' || status == 'REJECTED' || status == 'APPROVED_RETURN') {
                    Leaf.request({
                        type: 'POST',
                        url: "${/request/@context_path}/prj/check/ls/submit",
                        contentType: "application/json; charset=utf-8",
                        para: data,
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示', '提交成功');
                            $('${/parameter/@winid}').close();
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        //sync: true,
                        scope: this
                    });
                    // window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    // Leaf.showMessage('提示', '没毛病');
                } else {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '该单据不可提交，请检查单据状态！');
                }

            })


        };


        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            //debugger;
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            var last_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'F_LAST_CHECK');
            if (ds.id === base_ds_id) {
                var record = $(base_ds_id).getCurrentRecord();
                var last_check_id = record.get('last_check_id');
                if (last_check_id == undefined || last_check_id == null || last_check_id == '') {
                    record.getField('last_focus_matter').setReadOnly(true);
                    record.getField('last_correct_situation').setReadOnly(true);
                }
            }
        };

        var docList = new Array();

        function f() {
            for (let i = 0, len = docList.length; i < len; i++) {
                if (document.getElementById(docList[i]) != null) {
                    var base_span = document.getElementById(docList[i]).lastChild;
                    document.getElementById(docList[i]).innerHTML = '<div class="cell-editor-div"></div><span style="color: red">*</span>' + base_span.outerHTML;
                }
            }
        }
        setInterval(f, 1);

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var tenant_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            var tenant_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            var gurantor_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var gurantor_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var gurantor_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            var manufacturer_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_MA');
            var manufacturer_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_MA');
            var manufacturer_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_MA');
            var lease_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_LEASE');
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_PLEDGE');

            if ((ds.id === tenant_basic_ds_id || ds.id === tenant_credit_ds_id || ds.id === tenant_finance_ds_id || ds.id === gurantor_basic_ds_id
                || ds.id === gurantor_credit_ds_id || ds.id === gurantor_finance_ds_id || ds.id === manufacturer_basic_ds_id
                    || ds.id === manufacturer_credit_ds_id || ds.id === manufacturer_finance_ds_id || ds.id === lease_ds_id || ds.id === pledge_ds_id)
                && record !='' && record !=null && record != undefined) {
                var requiredFlag = record.get('required_flag');
                if (requiredFlag != undefined && requiredFlag != null && requiredFlag != '' && requiredFlag == 'Y') {
                    var doc = ds.bindname + "_layout_grid_id_items_" + record.id;
                    docList.add(doc);
                }
            }
        };

