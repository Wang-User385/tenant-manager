        //超链接
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            debugger
            var link_function;
            if (name == 'attachment_detail' && record.get('risk_attachment_id')) {
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('risk_attachment_id') + '\',\'' + record.ds.id + '\');">附件</a>';
            }
            if (name == 'file_name' && value) {
                debugger;
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }
            return value;
        };


        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            debugger;

            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');

            //风险情况
            var risk_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_THIS_CHECK');
            //项目批复
            var reply_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_REPLY_SITUATION');
            if (risk_ds_id == ds.id) {
                record.set('hd_id', $(basic_ds_id).getCurrentRecord().get("risk_hd_id"));
                record.set('check_type', 'RISK');
            }
            if (reply_ds_id == ds.id) {
                record.set('hd_id', $(basic_ds_id).getCurrentRecord().get("risk_hd_id"));
                record.set('check_type', 'REPLY');
            }
            //融资申请人
            var tenant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASE');
            var tenant_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            var tenant_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            var tenant_received_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_RECEIVED');
            if (tenant_basic_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_BASIC');
            }
            if (tenant_credit_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_CREDIT');
            }
            if (tenant_finance_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_FINANCE');
            }
            if (tenant_received_ds_id == ds.id) {
                record.set('hd_id', $(tenant_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'TENANT_RECEIVED');
            }

            //担保人
            var gurantor_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASI_GU');
            var gurantor_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var gurantor_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var gurantor_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            if (gurantor_basic_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_BASIC');
            }
            if (gurantor_credit_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_CREDIT');
            }
            if (gurantor_finance_ds_id == ds.id) {
                record.set('hd_id', $(gurantor_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'GUARANTOR_FINANCE');
            }

            //合作方
            var manufacturer_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_BASI_MA');
            var manufacturer_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_MA');
            var manufacturer_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_MA');
            var manufacturer_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_MA');
            if (manufacturer_basic_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_BASIC');
            }
            if (manufacturer_credit_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_CREDIT');
            }
            if (manufacturer_finance_ds_id == ds.id) {
                record.set('hd_id', $(manufacturer_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'MANUFACTURER_FINANCE');
            }

            //标的情况
            var lease_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_DESC_LEASE');
            var subject_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_LEASE');
            if (subject_ds_id == ds.id) {
                record.set('hd_id', $(lease_ds_id).getCurrentRecord().get("hd_id"));
                record.set('check_type', 'SUBJECT');
            }


            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_attachment');
            if (ds.id == ds_id) {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
                var base_record = $(ds_id).getCurrentRecord();
                var check_id = base_record.get('check_id');
                record.set('risk_warning_id', check_id);
            }
        };

        window['upload_file'] = function (record_id, risk_attachment_id, ds_id, table) {
            debugger
            var record = $(ds_id).findById(record_id);
            var tableName;
            tableName = 'prj_check';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            var base_record = $(ds_id).getCurrentRecord();
            var check_id = base_record.get('check_id');
            if (check_id == null) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            if (risk_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY' || '${/parameter/@end_flag}' == 'Y') {
                url = '${/request/@context_path}/modules/HLS/HLS200/downloadFileCopy.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'risk100_open_attachment_winid',
                url: url,
                params: {
                    'header_id': risk_attachment_id,
                    'table_name': tableName,
                    winid: 'risk100_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                debugger;
                var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_risk_attachment');
                $(document_list_ds_id).query();
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>