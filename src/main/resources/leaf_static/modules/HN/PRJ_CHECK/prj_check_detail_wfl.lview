<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <style>
            #PRJ_CHECK_DETAIL_G_ATTACHMENT_jczl_common_attachment_layout_grid_id_wrap {
                padding-top: 50px;
            }
        </style>
        <a:link id="prj_contract_detail_id"
                url="${/request/@context_path}/modules/AST/AST_FIVE/AST005/rsc_ten_enstimate.lview"/>
        <a:link id="prj_bp_risk_warn_id"
                url="${/request/@context_path}/modules/RISK/RISK100/risk_warning.lview"/>
        <a:link id="con_prj_lease_detail_1_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="prj_finance_detail_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_finance_home.lview"/>
        <a:link id="bp100_bp_master_modify_id11"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <a:link id="paid_rental_id11"
                url="${/request/@context_path}/modules/RPT/rpt_contract_payied_rental_report.lview"/>
        <script><![CDATA[
        var check_id = '${/parameter/@check_id}';
        var query_flag = 'Y';

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check', 'T_FROM');
            var this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd', 'F_THIS');
            //财报
            //var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_hd','F_FINANCE_REPORT');
            if (ds.id == this_ds_id) {
                qpara['check_category'] = 'RISK';
            }
        };
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            //风险预警
            var risk_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_THIS_CHECK');
            //项目批复
            var reply_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'F_REPLY_SITUATION');

            //客户基本情况
            var tenant_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC');
            //客户主体信用情况
            var tenant_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT');
            //客户财务
            var tenant_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE');
            //客户回款
            var tenant_cash_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_RECEIVED');
            //担保人
            var gurantor_basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_BASIC_GU');
            var gurantor_credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_CREDIT_GU');
            var gurantor_finance_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_FINANCE_GU');
            if (ds.id == risk_ds_id) {
                qpara['check_type'] = 'RISK';
                qpara['check_id'] = check_id;
            }
            if (ds.id == reply_ds_id) {
                qpara['check_type'] = 'REPLY';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_basic_ds_id) {
                qpara['check_type'] = 'TENANT_BASIC';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_credit_ds_id) {
                qpara['check_type'] = 'TENANT_CREDIT';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_finance_ds_id) {
                qpara['check_type'] = 'TENANT_FINANCE';
                qpara['check_id'] = check_id;
            }
            if (ds.id == tenant_cash_ds_id) {
                qpara['check_type'] = 'TENANT_RECEIVED';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_basic_ds_id) {
                qpara['check_type'] = 'GUARANTOR_BASIC';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_credit_ds_id) {
                qpara['check_type'] = 'GUARANTOR_CREDIT';
                qpara['check_id'] = check_id;
            }
            if (ds.id == gurantor_finance_ds_id) {
                qpara['check_type'] = 'GUARANTOR_FINANCE';
                qpara['check_id'] = check_id;
            }
            //标的
            var subject_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_LEASE');
            if (ds.id == subject_ds_id) {
                qpara['check_type'] = 'SUBJECT';
                qpara['check_id'] = check_id;
            }
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check_items_ln', 'G_PLEDGE');
            if (ds.id == pledge_ds_id) {
                qpara['check_type'] = 'PLEDGE';
                qpara['check_id'] = check_id;
            }

        };

        //投后检查报告打印
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_THIS');
            var record = $(ds_id).getCurrentRecord();
            var template_code = 'RENT_CHECK';
            if (record.get('contract_id') && record.get('contract_id') != null && record.get('contract_id') != '') {
                Leaf.Masker.mask(Ext.getBody(), '正在生成投后检查报告打印...');
                Leaf.request({
                    url: "${/request/@context_path}/prj/virprj/create/content",
                    para: {
                        project_id: record.get('contract_id'),
                        check_id: record.get('check_id'),
                        template_code: template_code,
                        instance_id : '${/parameter/@instance_id}'
                    },
                    success: function (res) {
                        debugger;
                        console.log(res);
                        var source_pk_value1 = res.result.record[0].source_pk_value1;
                        if (source_pk_value1 == 'undefined' || source_pk_value1 == '' || source_pk_value1 == null) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showInfoMessage('未找到投后检查报告模板!');
                            return;
                        } else {
                            Leaf.Masker.unmask(Ext.getBody());
                            //Leaf.showInfoMessage('合同文本生成成功!');
                            var down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + res.result.record[0].attachment_id;
                            location.href = down_url;
                        }
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }
        }

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            // prj_check_record 同步
            var f_munu10_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_MUNU10_FORM');
            var f_this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_THIS');
            if (ds.id == f_this_ds_id){
                var f_munu10_form_ds_id_record = $(f_munu10_form_ds_id).getCurrentRecord();
                if (name == 'five_classification_result'){
                    record.set('product_conclusion',record.get('five_classification_result'));
                    record.set('product_conclusion_n',record.get('five_classification_result_n'));
                    f_munu10_form_ds_id_record.set('product_conclusion',record.get('five_classification_result'));
                    f_munu10_form_ds_id_record.set('product_conclusion_n',record.get('five_classification_result_n'));
                    f_munu10_form_ds_id_record.set('five_classification_result',record.get('five_classification_result'));
                    f_munu10_form_ds_id_record.set('five_classification_result_n',record.get('five_classification_result_n'));
                }
                if (name == 'check_date'){
                    f_munu10_form_ds_id_record.set('check_date',record.get('check_date'));
                }
            }
            if (ds.id == f_munu10_form_ds_id){
                var f_this_ds_id_record = $(f_this_ds_id).getCurrentRecord();
                if (name == 'analyse_conclusion' || name == 'product_conclusion' || name == 'next_check_matter' ){
                    f_this_ds_id_record.set('analyse_conclusion',record.get('analyse_conclusion'));
                    f_this_ds_id_record.set('product_conclusion',record.get('product_conclusion'));
                    f_this_ds_id_record.set('next_check_matter',record.get('next_check_matter'));
                }
            }

        };

        //保存
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            // var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            var f_this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_THIS');
            var f_munu10_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_MUNU10_FORM');
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            $(f_this_ds_id).submit();
            $(f_munu10_form_ds_id).submit();
            // Leaf.request({
            //     url: '${/request/@context_path}/prj/check/wfl/save',
            //     para: record,
            //     success: function (res) {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //         Leaf.showMessage('提示', '保存成功');
            //
            //     },
            //     failure: function () {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     },
            //     error: function () {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     },
            //     scope: this
            // });
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        }

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if('${/parameter/@wfl_show_save_flag}' == 'Y'){
                var f_this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_THIS');
                var f_munu10_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_MUNU10_FORM');
                if (ds.id == f_this_ds_id){
                    if ('${/parameter/@isRiskControlSecretaryFlag}' == 'Y'){
                        record.getField('check_date').setRequired(true);
                        record.getField('check_date').setReadOnly(false);
                    }
                    record.getField('five_classification_result').setRequired(true);
                    record.getField('five_classification_result').setReadOnly(false);
                    record.getField('five_classification_result_n').setRequired(true);
                    record.getField('five_classification_result_n').setReadOnly(false);

                }
                if (ds.id == f_munu10_form_ds_id){
                    // record.getField('product_conclusion').setRequired(true);
                    // record.getField('product_conclusion').setReadOnly(false);
                    if ('${/parameter/@isRiskControlSecretaryFlag}' == 'Y'){
                        record.getField('analyse_conclusion').setRequired(true);
                        record.getField('analyse_conclusion').setReadOnly(false);
                        record.getField('invest_conclusion').setRequired(true);
                        record.getField('invest_conclusion').setReadOnly(false);
                        record.getField('next_check_matter').setRequired(true);
                        record.getField('next_check_matter').setReadOnly(false);
                    }
                }
            }
        };

        //页面加载 按钮显示隐藏逻辑
        Leaf.onReady(function () {debugger;
            if ('${/parameter/@wfl_flag}' == 'Y') {
                if('${/parameter/@wfl_show_save_flag}' == 'N'){
                    document.getElementById('PRJ_CHECK_DETAIL_WFL_save').style.display = "none";
                }
                // if('${/parameter/@wfl_show_save_flag}' == 'Y'){
                //     var f_this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
                //     var f_munu10_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_MUNU10_FORM');
                //     console.log(window['${/parameter/@layout_code}_layoutDataSetList']);
                //     var record = $(f_this_ds_id).getCurrentRecord();
                //     if ('${/parameter/@isRiskControlSecretaryFlag}' == 'Y'){
                //         if(record!=undefined&&record!=null){
                //             record.getField('CHECK_DATE').setRequired(true);
                //             record.getField('CHECK_DATE').setReadOnly(false);
                //             record.getField('FIVE_CLASSIFICATION_RESULT').setRequired(true);
                //             record.getField('FIVE_CLASSIFICATION_RESULT').setReadOnly(false);
                //             record.getField('ANALYSE_CONCLUSION').setRequired(true);
                //             record.getField('ANALYSE_CONCLUSION').setReadOnly(false);
                //             record.getField('INVEST_CONCLUSION').setRequired(true);
                //             record.getField('INVEST_CONCLUSION').setReadOnly(false);
                //             record.getField('NEXT_CHECK_MATTER').setRequired(true);
                //             record.getField('NEXT_CHECK_MATTER').setReadOnly(false);
                //         }
                //     }
                //     record = $(f_munu10_form_ds_id).getCurrentRecord();
                //     if(record.get('product_conclusion')!=undefined&&record.get('product_conclusion')!=undefined){
                //         console.log(record);
                //         record.getField('product_conclusion').setRequired(true);
                //         record.getField('product_conclusion').setReadOnly(false);
                //     }
                // }
            }
        });

        function open_bp_modify_win11(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid11';
            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id11', ds_id, 'BP100');
        }

        function open_paid_rental_win11(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '应收账款';
            param['function_usage'] = 'QUERY';
            param['function_code'] = 'PAYIED_RENTAL_CHART';
            param['winid'] = 'paid_rental_winid11';
            param['hide_query_flag'] = 'Y';
            hls_doc_get_layout_code(param, 'paid_rental_id11', ds_id, 'PAYIED_RENTAL_CHART');
        }

        //超链接
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win11(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if (name == 'paid_detail') {
                return '<a href="javascript:open_paid_rental_win11(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '应收账款明细' + '</a>';
            }
            return value;
        };



        ///工作流页面执行前校验
        function beforeSubmit(countiune) {
            var f_this_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            // var f_munu10_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check','F_MUNU10_FORM');
            if($(f_this_ds_id).validate()) {
                $(f_this_ds_id).submit();
                countiune();
                return true;
            }else{
                return false;
            }
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>