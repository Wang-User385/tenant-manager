    $Date: 2019-4-16 上午11:48:56
    $Revision: 2.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="prj_check_create_detail_id" url="${/request/@context_path}/modules/HN/PRJ_CHECK/prj_check_detail.lview"/>
        <script><![CDATA[
        Leaf.onReady(function() {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            var prj_check_record = $(ds_id).getAt(0);
            // prj_check_record.set('employee_id_n', '${/session/@employeeName}');
            // prj_check_record.set('employee_id', '${/session/@employeeId}');
            // prj_check_record.set('unit_id_n', '${/session/@unitName}');
            // prj_check_record.set('unit_id', '${/session/@unitId}');
            //prj_check_record.set('check_date', new Date());
            prj_check_record.set('approve_suggest', 'NEW');
            prj_check_record.set('approve_suggest_n', '新建')

        });

        //生成权限字符串
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function () {
            Leaf.request({
                url: "${/request/@context_path}/prj/check/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };

        //保存前调用获取编码 并提前获取 marketing_report_id
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
             debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_check');
            var root_ds = $('${/parameter/@layout_code}_virtual_ds');
            var prj_check_record = $(ds_id).getAt(0);
            var check_number = prj_check_record.get('check_number');
            if(!prj_check_record.get('contract_id_n')){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('提示', '请选择合同编号');
                return false
            }

            prj_check_record.set('employee_id_n', prj_check_record.get("employee_id_n"));
            prj_check_record.set('employee_id', prj_check_record.get("employee_id"));
            prj_check_record.set('unit_id_n', prj_check_record.get("unit_id_n"));
            prj_check_record.set('unit_id', prj_check_record.get("unit_id"));
            var contract_id = $(ds_id).getCurrentRecord().get('contract_id');
            var contract_number = $(ds_id).getCurrentRecord().get('contract_id_n');
            var bp_id = $(ds_id).getCurrentRecord().get('bp_id');
            var plan_id = $(ds_id).getCurrentRecord().get('plan_id');
            var param= $(ds_id).getAt(0).data;
            param['contract_id'] =  contract_id ;
            param['check_number'] =  check_number ;
            param['contract_number'] =  contract_number ;
            param['bp_id'] =  bp_id ;
            param['plan_id'] =  plan_id ;
            param['employee_id'] = prj_check_record.get("employee_id");
            param['unit_id'] =  prj_check_record.get("unit_id");
            param['check_date'] = new Date();
            param['approve_suggest'] = 'NEW';



            if(check_number === null || typeof (check_number) === 'undefined' ){
                check_flag =false;
                var data={};
                data.contract_number=prj_check_record.get('contract_id_n');
                data.plan_id=prj_check_record.get('plan_id');
                Leaf.request({
                    type: 'POST',
                    url: "${/request/@context_path}/prj/check/query",
                    contentType: "application/json; charset=utf-8",
                    para: data,
                    success: function (res) {
                        window['${/parameter/@layout_code}_set_authority_rule_string']();
                        Leaf.request({
                            url: '${/request/@context_path}/prj/check/create',
                            para: {
                                param: param,
                            },
                            success: function (res) {
                                //window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                if (res.success) {
                                    Leaf.showSuccessMessage('${HLS.SUBMIT_SUCCESS}', '创建成功', function () {
                                        var param = res.result.record[0];
                                        param['url_title'] = '租后检查明细页面';
                                        param['function_code'] = 'PRJ_CHECK_DETAIL';
                                        param['function_usage'] = 'MODIFY';
                                        param['winid'] = 'prj_check_create_detail_winid';
                                        param['check_id'] = res.result.record[0].check_id;
                                        param['entrance_winid'] = '${/parameter/@winid}';
                                        hls_doc_get_layout_code(param, 'prj_check_create_detail_id', ds_id, 'PRJ_CHECK','${/parameter/@winid}', 'Y');
                                    });
                                } else {
                                    Leaf.showErrorMessage('提示', res.message);
                                }
                                check_flag = true;
                            },
                            failure: function () {
                                check_flag = false;
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                check_flag = false;
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                        check_flag = true;
                    },
                    error: function (res) {
                        check_flag =false;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        check_flag =false;
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
            //window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            return check_flag;
        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            $('${/parameter/@winid}').close();
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>