<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[
        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_information_disclosure');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jczl_common_attachment');
            if(attachment_ds_id == ds.id){
                record.set('source_category', 'ct_abs_information_disclosure');
                record.set('source_id', $(basic_ds_id).getCurrentRecord().get("disclosure_id"));
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jczl_common_attachment');
            if(ds.id == attachment_ds_id){
                var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_information_disclosure');
                qpara['source_category'] = 'ct_abs_information_disclosure';
                qpara['source_id'] = $(basic_ds_id).getCurrentRecord().get("disclosure_id");
            }
        };
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'attach_link'&& !record.isNew) {
                return '<a href="javascript:open_attach(\'' + record.get('attachment_id') + '\')">上传/下载</a>';
            }
            return value;
        };
        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'ABS003F8_OPEN_ATTACHMENT_WINID',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'jczl_common_attachment',
                    winid: 'ABS003F8_OPEN_ATTACHMENT_WINID',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jczl_common_attachment');
                $(ds_id).query();
            });
        }

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_information_disclosure');
            if ($(ds_id).validate()) {
                if ($(ds_id).isModified()) {
                    $L.showMessage('提示', '请先保存！');
                    return false;
                } else {
                    Leaf.showConfirm('提示', '确定提交审批?', function () {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: "${/request/@context_path}/submit/information/disclosure/wfl",
                            para: {disclosure_id: $(ds_id).getCurrentRecord().get("disclosure_id")},
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                    $('${/parameter/@winid}').close();
                                });
                            },
                            error: function (res) {
                                $L.showInfoMessage("提示", "提交失败!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function (res) {
                                $L.showInfoMessage("提示", "提交失败!");
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            sync: true,
                            scope: this
                        });
                    },null,200,200)
                }
            }

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>