<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ABS004F1_detail_id"
                    url="${/request/@context_path}/modules/ABS/ABS004/ct_abs_information_disclosure_detail.lview"/>
        <script><![CDATA[
        //按钮1 新增
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            Leaf.showConfirm('提示', '确定新增信息披露?', function () {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/ct/abs/information/disclosure/create',
                    para: {},
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        var disclosure_id = res.result.record[0].disclosure_id;
                        if (disclosure_id != null) {
                            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_information_disclosure');
                            var param = {};
                            param['disclosure_id'] = disclosure_id;
                            param['url_title'] = '信息披露详情';
                            param['function_code'] = 'ABS004F1';
                            param['winid'] = 'ABS004F1_detail_win_id';
                            param['function_usage'] = 'CREATE';
                            hls_doc_get_layout_code(param, 'ABS004F1_detail_id', ds_id, 'ABS004');
                        } else {
                            Leaf.showMessage('提示', '未获取到正确的信息披露ID！');
                        }

                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            },null,200,200);
        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + "详情" + '</a>';
            }
        };

        //付款申请详情
        function open_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '信息披露详情';
            param['function_code'] = 'ABS004F1';
            param['winid'] = 'ABS004F1_detail_win_id';

            if (param['approval_status'] === 'APPROVING' || param['approval_status'] === 'APPROVED') {
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['function_code'] = 'ABS004F1';
            }
            hls_doc_get_layout_code(param, 'ABS004F1_detail_id', ds_id, 'ABS004');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>