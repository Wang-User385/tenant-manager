<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="ABS004F1_detail_wfl_id"
                url="${/request/@context_path}/modules/ABS/ABS004/ct_abs_information_disclosure_detail.lview"/>
        <script><![CDATA[
        var pageChooser = new PageChooser({
            url: $('ABS004F1_detail_wfl_id').getUrl(),
            function_code: 'ABS004F1',
            context_path: '${/request/@context_path}',
            opt: {
                disclosure_id: '${/parameter/@businessKey}',
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

