<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="ABS003F1_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS110B/abs_product_add.lview"/>
        <a:link id="ABS003F2_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS100A/abs_product_detail.lview"/>


        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            debugger;

            var param = {};
            param['url_title'] = 'ABS产品创建';
            param['function_code'] = 'ABS003F1';
            param['winid'] = 'ABS003F1_detail_win_id';
            hls_doc_get_layout_code(param, 'ABS003F1_detail_id', null, 'ABS003');


        };


        //超链接跳转
        function detailFunction(productId,businessType) {
            //debugger;
            // var param = {};
            /*param['product_id'] = productId;
            param['business_type'] = businessType;
            param['function_code'] = 'ABS003F1';
            param['function_usage'] = 'QUERY';
            param['url_title'] = '发债产品明细';
            hls_doc_get_layout_code(param, 'ABS003F1_detail_id', null, 'ABS003F2');*/

            var param = {};
            param['product_id'] = productId;
            param['business_type'] = businessType;
            param['url_title'] = '发债产品明细';
            param['function_code'] = 'ABS003F2';
            param['function_usage'] = 'MODIFY';
            param['winid'] = 'ABS003F2_detail_win_id';

            hls_doc_get_layout_code(param, 'ABS003F2_detail_id', null, 'ABS003');
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'detailFunction';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.data.product_id + '\',\'' + record.data.business_type + '\');">' + config_record.get('prompt') + '</a>';
            }


        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
