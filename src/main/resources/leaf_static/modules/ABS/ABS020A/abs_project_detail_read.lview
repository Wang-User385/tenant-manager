        //加载时调用
         window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
             debugger;
             console.log(11);
             var projectId = '${/parameter/@project_id}';
             var projectStatus = '${/parameter/@project_status}';


             Leaf.request({
                 url: '${/request/@context_path}/ct/abs/project/detail/query',

                 para:{
                     project_id:projectId,
                     project_status:projectStatus,
                     wfl_rule_control_flag:'Y'
                 },

                 success: function (datas) {
                     debugger;
                     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                 },

                 failure: function () {
                     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                 },
                 error: function () {
                     window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                 },
                 scope: this
             });

         };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
