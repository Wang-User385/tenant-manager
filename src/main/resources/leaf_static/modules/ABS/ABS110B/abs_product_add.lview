<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="ABS003F2_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS100A/abs_product_detail.lview"/>


        <script><![CDATA[

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            debugger;

            var project_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_project' ,'F_PROJECT');
            var product_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product' ,'F_PRODUCT');
            var projectRecord = $(project_id).getCurrentRecord();
            var productRecord = $(product_id).getCurrentRecord();

            var hlsCusAbsProduct ={};

            hlsCusAbsProduct['project_id']=projectRecord.get('project_id');
            hlsCusAbsProduct['product_name']=productRecord.get('product_name');
            hlsCusAbsProduct['product_short_name']=productRecord.get('product_short_name');
            hlsCusAbsProduct['data_class']='NORMAL';
            hlsCusAbsProduct['document_category']='ABS_PRODUCT';
            hlsCusAbsProduct['document_type']='ABS_PRODUCT';
            hlsCusAbsProduct['product_status']='NEW';



            Leaf.request({
                url: '${/request/@context_path}/ct/abs/product/update',
                para: {hlsCusAbsProduct : hlsCusAbsProduct},

                success: function (datas) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '创建成功');

                    var param = {};
                    param['url_title'] = 'ABS产品创建';
                    param['function_code'] = 'ABS003F2';
                    param['function_usage'] = 'CREATE';
                    param['winid'] = 'ABS003F2_detail_win_id';

                    param['product_id']=datas.result.record[0].product_id;

                    hls_doc_get_layout_code(param, 'ABS003F2_detail_id', null, 'ABS003F1');

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });




        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
