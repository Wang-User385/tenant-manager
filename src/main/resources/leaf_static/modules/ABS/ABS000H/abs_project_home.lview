<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="ABS001F1_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS040A/abs_assets_pack_detail.lview"/>
        <script><![CDATA[

        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {

        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_assets_pack');
            var param = {};
            param['url_title'] = 'ABS资产打包明细';
            param['function_code'] = 'ABS001F1';
            param['winid'] = 'ABS001F1_detail_win_id';
            param['function_usage'] = 'CREATE';
            hls_doc_get_layout_code(param, 'ABS001F1_detail_id', ds_id, 'ABS001');
        };



        function detailFunction(packId) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_assets_pack');
            var param = {};
            param['winid'] = 'abs_assets_package_winid';
            param['pack_id'] = packId;
            param['function_code'] = 'ABS001F1';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '资产打包详细信息';
            hls_doc_get_layout_code(param, 'ABS001F1_detail_id', ds_id, 'ABS001');
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //debugger;
            var link_function = 'detailFunction';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.data.pack_id  + '\');">' + config_record.get('prompt') + '</a>';
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
