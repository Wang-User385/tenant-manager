<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="ABS002F1_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS020B/abs_project_add.lview"/>

        <a:link id="ABS002F2_create_prj_detail_id"
                url="${/request/@context_path}/modules/ABS/ABS020A/abs_project_detail.lview"/>

        <script><![CDATA[

        //加载时调用
        // window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
        //     debugger;
        //     // var creation_date =Leaf.formatDate(new Date());
        // };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

            debugger;

            var ct_abs_project_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_project');

            var param = {};
            param['url_title'] = 'ABS募集立项明细';
            param['function_code'] = 'ABS002F1';
            param['winid'] = 'ABS002F1_detail_win_id';
            param['screen_width']='900';
            param['side']='right';
            param['parent_ds_id'] = ct_abs_project_id;
            hls_doc_get_layout_code(param, 'ABS002F1_detail_id', null, 'ABS002');


        };



        //超链接跳转
        function detailFunction(projectId,projectStatus) {
            debugger;
            var ct_abs_project_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_project');

            var param = {};
            var function_usage='MODIFY';
            var function_code = 'ABS002F2';
            if(projectStatus === 'APPROVING' || projectStatus ==='APPROVED'){
                // function_usage='QUERY';
                function_code = 'ABS002F3';
            }

            param['project_id'] = projectId;
            param['project_status'] = projectStatus;
            param['function_code'] = function_code;
            param['function_usage'] = function_usage;
            param['url_title'] = '募集立项详细信息';
            param['parent_ds_id'] = ct_abs_project_id;
            hls_doc_get_layout_code(param, 'ABS002F2_create_prj_detail_id', null, function_code);
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'detailFunction';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.data.project_id + '\',\'' + record.data.project_status + '\');">' + config_record.get('prompt') + '</a>';
            }


        };



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
