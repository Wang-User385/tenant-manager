<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="ABS003F8_ABS_CASH_FEEDBACK_DETAIL_link" url="${/request/@context_path}/modules/ABS/ABS003/abs_cash_feedback_detail.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if(ds.id == get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_cash_detail')){
                qpara.product_id = "${/parameter/@product_id}";
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'detail') {
                return '<a href="javascript:open_cash_feedback_detail(\'' + record.get('cash_detail_id') + '\',\'' +record.ds.id+ '\',\'' +record.id+'\')">' + config_record.get('prompt') +'</a>';
            }
            return value;
        };

        function open_cash_feedback_detail(id,ds_id, record_id) {
            var param = {};
            var record = $(ds_id).findById(record_id);
            param = record.data;
            param['url_title'] = '兑付明细';
            param['function_code'] = 'ABS003F8';
            param['winid'] = 'ABS_CASH_FEEDBACK_DETAIL_WINID';
            if(record.data.remittance_status == 'CONFIRM'){
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
            }
            hls_doc_get_layout_code(param, 'ABS003F8_ABS_CASH_FEEDBACK_DETAIL_link', ds_id, 'ABS003F7');
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
