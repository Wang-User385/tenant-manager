<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_common_release_repurchase_window_id"
                url="${/request/@context_path}/modules/ABS/ABS023B/abs_assets_package_cashflow_info.lview"/>
        <a:link id="ABS003F3_SUBSCRIBE_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_subscribel.lview"/>
        <a:link id="ABS003F7_CASH_FEEDBACK_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_cash_feedback.lview"/>
        <script src="${/request/@context_path}/javascripts/calculate.js" type="text/javascript"/>
        <a:link id="ABS003F7_USEOFFUNDS_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_useoffunds.lview"/>
        <a:link id="ABS003F13_PROPERTY_DETAIL_link"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_detail_property.lview"/>
        <a:link id="ABS003F14_CASH_DETAIL_link"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_detail_cash.lview"/>
        <a:link id="ABS003F15_COLLECTION_DETAIL_link"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_detail_collection.lview"/>
        <a:link id="ABS003F9_BUY_BACK_LINK_ID" url="${/request/@context_path}/modules/ABS/ABS003/abs_buy_back.lview"/>
        <a:link id="ABS003F4_COLLECTION_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_collection.lview"/>
        <a:link id="ABS003F12_COLLECTION_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_remittance.lview"/>
        <a:link id="ABS001F3_ABS_CSH_FLOW_DETAIL_LINK_ID"
                url="${/request/@context_path}/modules/ABS/ABS001/abs_cash_flow_detail.lview"/>
        <script><![CDATA[
        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var ct_abs_product_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            if(ds.id == ct_abs_product_id && record && ('${/parameter/@function_usage}' !== 'QUERY')){

                if($(ct_abs_product_id).getCurrentRecord().get('if_relate_pack') == 'Y'){
                    record.getField('pack_id').setRequired(true);
                    record.getField('pack_id_n').setRequired(true);
                    record.getField('pack_id').setReadOnly(false);
                    record.getField('pack_id_n').setReadOnly(false);
                }else{
                    record.set('pack_id',null);
                    record.set('pack_id_n',null);
                    record.set('base_date_from',null);
                    record.set('base_date_to',null);
                    record.set('asset_contract_count',null);
                    record.set('asset_rent_count',null);
                    record.set('collected_due_amount',null);
                    record.set('collected_principal',null);
                    record.set('collected_interest',null);
                    record.set('collected_other_amount',null);
                    record.getField('pack_id').setRequired(false);
                    record.getField('pack_id_n').setRequired(false);
                    record.getField('pack_id').setReadOnly(true);
                    record.getField('pack_id_n').setReadOnly(true);
                }
                //交易信息默认值
                record.set("product_currency_code",'CNY');
                record.set("product_currency_code_n",'人民币');
            }
        }

        //加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var fee_ds_id = '${/parameter/@layout_code}_G_FEE_ct_abs_pro_fee_info_ds';
            if (ds.id === fee_ds_id && record && ('${/parameter/@function_usage}' !== 'QUERY')) {
                //当费用名称选择增值税，则附加税为必填项，选项有12%、10%和6%；当费用名称选择非增值税，则为只读
                if ( record.get('fee_name') == 'VAT') {
                    record.getField('add_tax_rate').setReadOnly(false);
                    record.getField('add_tax_rate').setRequired(true);
                    record.getField('add_tax_rate_n').setReadOnly(false);
                    record.getField('add_tax_rate_n').setRequired(true);
                }else{
                    record.getField('add_tax_rate').setReadOnly(true);
                    record.getField('add_tax_rate').setRequired(false);
                    record.getField('add_tax_rate_n').setReadOnly(true);
                    record.getField('add_tax_rate_n').setRequired(false);
                }
            }
        }
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var ct_abs_product_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            if (ds.id === ct_abs_product_id && ('${/parameter/@function_usage}' !== 'QUERY')) {
                //若“是否关联资产包”为“是”，则必填资产包
                if(record.get('if_relate_pack') == 'Y'){
                    record.getField('pack_id').setRequired(true);
                    record.getField('pack_id_n').setRequired(true);
                    record.getField('pack_id').setReadOnly(false);
                    record.getField('pack_id_n').setReadOnly(false);
                }else{
                    record.set('pack_id',null);
                    record.set('pack_id_n',null);
                    record.set('base_date_from',null);
                    record.set('base_date_to',null);
                    record.set('asset_contract_count',null);
                    record.set('asset_rent_count',null);
                    record.set('collected_due_amount',null);
                    record.set('collected_principal',null);
                    record.set('collected_interest',null);
                    record.set('collected_other_amount',null);
                    record.getField('pack_id').setRequired(false);
                    record.getField('pack_id_n').setRequired(false);
                    record.getField('pack_id').setReadOnly(true);
                    record.getField('pack_id_n').setReadOnly(true);
                }
            }
            var fee_ds_id = '${/parameter/@layout_code}_G_FEE_ct_abs_pro_fee_info_ds';
            if (ds.id === fee_ds_id && ('${/parameter/@function_usage}' !== 'QUERY')) {
                //当费用名称选择增值税，则附加税为必填项，选项有12%、10%和6%；当费用名称选择非增值税，则为只读
                if ( record.get('fee_name') == 'VAT') {
                    record.getField('add_tax_rate').setReadOnly(false);
                    record.getField('add_tax_rate').setRequired(true);
                    record.getField('add_tax_rate_n').setReadOnly(false);
                    record.getField('add_tax_rate_n').setRequired(true);
                }else{
                    record.getField('add_tax_rate').setReadOnly(true);
                    record.getField('add_tax_rate').setRequired(false);
                    record.getField('add_tax_rate_n').setReadOnly(true);
                    record.getField('add_tax_rate_n').setRequired(false);
                }
            }

        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, record, config_records, bp_seq) {
            var product_id = '${/parameter/@product_id}';
            //账户信息
            if (ds.id === '${/parameter/@layout_code}_G_ACCOUNT_ct_abs_bank_account_ds') {
                ds.setQueryParameter('source_key', product_id);
                ds.setQueryParameter('source_type', 'ABS_PRODUCT');
            }
            //中介机构
            if (ds.id === '${/parameter/@layout_code}_G_MID_ct_abs_product_organization_ds' || ds.id === '${/parameter/@layout_code}_G_ATTACHMENT_ct_abs_product_attachment') {
                ds.setQueryParameter('product_id', product_id);
            }
            //资金信息
            if (ds.id === '${/parameter/@layout_code}_G_FEE_ct_abs_pro_fee_info_ds') {
                ds.setQueryParameter('source_key', product_id);
                ds.setQueryParameter('source_type', '${/parameter/@document_type}');
            }
            //资产明细
            if (ds.id === '${/parameter/@layout_code}_G_PACK_ct_abs_assets_package_ds') {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
                ds.setQueryParameter('pack_id', $(ds_id).getAt(0).get('pack_id'));

            }
            //兑付计划
            if (ds.id === '${/parameter/@layout_code}_G_CASH_ct_abs_product_cash_detail_ds') {
                ds.setQueryParameter('product_id', product_id);
            }
            //分层结构
            if (ds.id === '${/parameter/@layout_code}_G_STRUCTURE_ct_abs_product_structure_ds') {
                $("${/parameter/@layout_code}_G_STRUCTURE_ct_abs_product_structure_ds").fetchall = true;

            }
        };

        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var product_id = '${/parameter/@product_id}';
            var document_type = '${/parameter/@document_type}';
            //账户信息  //费用信息
            if (ds.id === '${/parameter/@layout_code}_G_ACCOUNT_ct_abs_bank_account_ds' || ds.id === '${/parameter/@layout_code}_G_FEE_ct_abs_pro_fee_info_ds') {
                record.set('source_key', product_id);
                record.set('source_type', document_type);
            }
            //中介机构信息
            if (ds.id === '${/parameter/@layout_code}_G_MID_ct_abs_product_organization_ds') {
                record.set('product_id', product_id);
            }
            //分层结构
            if (ds.id === '${/parameter/@layout_code}_G_STRUCTURE_ct_abs_product_structure_ds') {
                var ct_abs_product_record = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product')).getAt(0);
                record.set('predict_due_date', new Date());
                //在填完交易信息后 再去添加分层信息时 更新期限月
                if (ct_abs_product_record.get('due_date_begin') != undefined) {
                    compute_term_month();
                }
            }
            //附件
            if (ds.id === '${/parameter/@layout_code}_G_ATTACHMENT_ct_abs_product_attachment_ds') {
                record.set('product_id', product_id);
                record.set('product_attachment_category', 'ABS_PRODUCT');
            }
        };

        //超链接
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'cashflow_detail') {
                var link_function = '${/parameter/@layout_code}_open_duration_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + "明细" + '</a>';
            }
            if (name === 'att_link' && !record.isNew) {
                return '<a href="javascript:open_attach(\'' + record.get('product_attachment_id') + '\')">上传</a>';
            }
            return value;
        };
        //现金流详情
        window['${/parameter/@layout_code}_open_duration_detail_win'] = function (record_id, ds_id) {
            var record = $(ds_id).findById(record_id).data;
            var param = {};
            param['url_title'] = '现金流详情';
            param['function_code'] = 'ABS001S2';
            param['contract_id'] = record.contract_id;
            param['winid'] = '${/parameter/@layout_code}_common_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_release_repurchase_window_id', ds_id, '${/parameter/@function_code}');
        }


        $L.onReady(function () {
            //资产包变更后 下面资产包grid的数据相应变化
            var ct_abs_product_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');

            var ct_abs_product_structure_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_structure');
            //金额发生变化触发重新计算
            $(ct_abs_product_structure_ds_id).on('update', function (ds, record, name, newValue, oldValue) {
                if (name === 'publish_amount') {
                    compute_structure_percent(ds.getAll());
                }
            });
            //删除记录触发重新计算
            $(ct_abs_product_structure_ds_id).on('remove', function (ds, record, index) {
                compute_structure_percent(ds.getAll());
            });

            $(ct_abs_product_ds_id).on('update', function (ds, record, name, newValue, oldValue) {
                if (name === 'due_date_begin') {
                    if (record.get('plan_date_end') != undefined) {
                        console.log(record.get('plan_date_end'));
                        console.log(record.get('due_date_begin'));
                        var months = left_months(record.get('plan_date_end'), record.get('due_date_begin'));
                        console.log(months);
                        record.set('product_term', months);
                    }
                }
                if (name === 'plan_date_end') {
                    if (record.get('due_date_begin') != undefined) {
                        var months = left_months(record.get('plan_date_end'), record.get('due_date_begin'));
                        record.set('product_term', months);
                    }
                }
            });

            //隐藏显示框
            // jQuery('#ABS003F2_F_BASIC_CT_ABS_PRODUCT_INNER').hide();
            // jQuery('#ABS003F2_F_BASIC_CT_ABS_PRODUCT_OUTTER').hide();
            //
            //新建状态时 隐藏右侧部分按钮
            if ('${/parameter/@hidden_right_button}') {
                var lis = jQuery('.hls-selectBar li').toArray();
                lis.forEach(function (current, index, arr) {
                    // if (current.innerText != '认购明细') {
                    //     current.hidden = true;
                    // }
                    current.hidden = true;
                });
            }

        });


        //计算分层 期限月
        function compute_term_month() {
            var ct_abs_product_structure_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_structure');
            var predict_due_date = $(ct_abs_product_structure_ds_id).getAt(0).get('predict_due_date');
            var record = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product')).getAt(0);
            var due_date_begin = record.get('due_date_begin');
            var term_month = left_months(predict_due_date, due_date_begin);
            $(ct_abs_product_structure_ds_id).getAll().forEach(function (current, index, arr) {
                current.set('term_month', term_month);
            });
        }

        //日期相差月数计算date1-date2  均为日期类型
        function left_months(date1, date2) {

            var date1Time = Date.parse(date1);
            var date2Time = Date.parse(date2);
            // diffDays = (date1Time - date2Time) / 3600 / 1000 / 24;
            var diffDays = div(div(div(minus(date1Time, date2Time), 3600), 1000), 24);
            // months_result = diffDays / 365 * 12;
            //var months_result = div(diffDays, (mul(365, 12)));
            var months_result = mul(div(diffDays,365),12);
            return Math.ceil(months_result);
        }

        //计算分层百分比函数
        function compute_structure_percent(records) {
            var totalMoney = 0;
            records.forEach(function (current, index, arr) {
                totalMoney += current.get('publish_amount');
            });
            //除去最后一个数据的其他数据的百分比累加  用于做尾差处理
            var sumPercent = 0;
            records.forEach(function (current, index, arr) {
                var percent = 0;
                if (index != records.length) {
                    //percent = current.get("publish_amount") / totalMoney;
                    percent = div(current.get('publish_amount'), totalMoney);
                    //sumPercent += percent;
                    sumPercent = plus(sumPercent, percent);
                } else {
                    //尾差处理
                    //percent = 1 - sumPercent;
                    percent = minus(1, sumPercent);
                }
                current.set('structure_precent', percent);
            });
            var ct_abs_product_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            $(ct_abs_product_ds_id).getAt(0).set('issue_amount', totalMoney);
        }

        //兑付计划导入
        window['${/parameter/@layout_code}_G_CASH_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            var cash_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_cash_detail');
            var base_record = $(base_ds_id).getCurrentRecord();
            var product_id = base_record.get('product_id');
            if(product_id == '' || product_id == 'undefined' || product_id == null){
                Leaf.showInfoMessage("提示" , "请先保存再进行导入操作！");
                return;
            }
            var win = new Leaf.Window({
                id: 'ct_abs_product_cash_import_win_id',
                params: {
                    winid: 'ct_abs_product_cash_import_win_id'
                },
                url: '${/request/@context_path}/modules/ABS/ABS003/ct_abs_product_cash_import.lview?product_id='+product_id,
                title: '兑付计划导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(cash_ds_id).query();
            });
        }

        //打开附件窗口
        function open_attach(product_attachment_id) {
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            win = new Leaf.Window({
                id: 'fin001f1_open_attachment_winid',
                url:url,
                params: {
                    header_id: product_attachment_id,
                    table_name: 'ct_abs_product_attachment',
                    winid: 'fin001f1_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_attachment');
                $(ds_id).query();
            });
        }


        window['${/parameter/@layout_code}_exit_layout_dynamic_click'] = function () {
        };
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                Leaf.showConfirm('提示', '确认提交？', function () {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/ct/abs/product/submit',
                        para: {
                            productId: '${/parameter/@product_id}'
                        },
                        success: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示', '提交审批成功！', function () {
                                $('${/parameter/@winid}').close();
                            });
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                });

            });
        };



        //认购明细
        window['${/parameter/@layout_code}_subscribe_layout_dynamic_click'] = function () {
            var cap_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            var cap_Record = $(cap_ds_id).getCurrentRecord();
            var param = {};
            param['product_id'] = cap_Record.get('product_id');
            param['subscribe_main_name'] = cap_Record.get('subscribe_main_name');
            param['subscribe_account_name'] = cap_Record.get('subscribe_account_name');
            param['subscribe_account_num'] = cap_Record.get('subscribe_account_num');
            param['subscribe_branch_name'] = cap_Record.get('subscribe_branch_name');
            param['issue_amount'] = cap_Record.get('issue_amount');
            param['url_title'] = '自持认购';
            param['function_code'] = 'ABS003F3';
            param['winid'] = 'ABS003F3_subscribe_win';
            hls_doc_get_layout_code(param, 'ABS003F3_SUBSCRIBE_LINK_ID', '', 'ABS003F2');
        };

        //兑付反馈
        window['${/parameter/@layout_code}_cash_feedback_layout_dynamic_click'] = function () {
            var cap_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product');
            var cap_Record = $(cap_ds_id).getCurrentRecord();
            var param = {};
            param['product_id'] = cap_Record.get('product_id');
            param['url_title'] = '兑付反馈';
            param['function_code'] = 'ABS003F7';
            param['winid'] = 'ABS003F7_CASH_FEEDBACK_WIN';
            hls_doc_get_layout_code(param, 'ABS003F7_CASH_FEEDBACK_LINK_ID', cap_ds_id, 'ABS003F2');
        };



        //保存前调用
        /*window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var fee_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_pro_fee_info');
            var fee_Record = $(fee_ds_id).getAll();
            fee_Record.forEach(function (current, index, arr) {
                if (current.get('fee_name') != 'VAT') {
                    // current.getField('add_tax_rate').setReadOnly(true);
                    current.getField('add_tax_rate_n').setReadOnly(true);
                } else {
                    // current.getField('add_tax_rate').setReadOnly(false);
                    current.getField('add_tax_rate_n').setReadOnly(false);
                }
                if (current.get('calculate_flag') === 'N') {
                    current.getField('fee_rate').setReadOnly(true);
                    current.getField('times').setRequired(true);
                    current.getField('plan_pay_date').setRequired(true);
                    current.getField('currency_code').setRequired(true);
                    current.getField('fee_amount').setRequired(true);
                    current.getField('exchange_rate').setRequired(true);
                    current.getField('cny_fee_amount').setRequired(true);
                }else{
                    current.getField('fee_rate').setRequired(true);
                    current.getField('times').setReadOnly(true);
                    current.getField('plan_pay_date').setReadOnly(true);
                    current.getField('currency_code').setReadOnly(true);
                    current.getField('fee_amount').setReadOnly(true);
                    current.getField('exchange_rate').setReadOnly(true);
                    current.getField('cny_fee_amount').setReadOnly(true);
                }
            });
        };
        window['${/parameter/@layout_code}_compute_layout_dynamic_click'] = function () {
            Leaf.showConfirm('提示', '确认计算？', function () {
                Leaf.request({
                    url: '${/request/@context_path}/ct/abs/product/calculate',
                    para: {
                        productId: '${/parameter/@product_id}'
                    },
                    success: function () {
                        Leaf.showMessage('提示', '计算成功！', function () {
                            var collection_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_collection');
                            var cash_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_cash_detail');
                            $(collection_ds_id).query();
                            $(cash_ds_id).query();
                        });
                    }
                })
            });
        };

