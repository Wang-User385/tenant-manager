<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="abs003f3_confirm" url="${/request/@context_path}/ct/abs/product/subscribe/confirm"/>
        <script><![CDATA[

        $L.onReady(function () {
            var caps_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_subscribe');
            $(caps_ds_id).on('update', function (ds, record, name, newValue, oldValue) {
                if (name === 'abs_bank_account_id') {
                    record.set('payment_target', (record.get('abs_bank_account_id')));
                }
                if (name === 'subscribe_amount') {
                    record.set('sub_percent', (div(record.get('subscribe_amount'), record.get('issue_amount'))));
                }
                if (name === 'subscribe_type') {
                    if(record.get('subscribe_type') === 'SELF_HOLDING_SUBSCRIPTION'){
                        record.set("subscribe_main_name",'${/parameter/@subscribe_main_name}');
                        record.set("subscribe_account_name",'${/parameter/@subscribe_account_name}');
                        record.set("subscribe_account_num",'${/parameter/@subscribe_account_num}');
                        record.set("subscribe_branch_name",'${/parameter/@subscribe_branch_name}');
                        record.getField('subscribe_date').setRequired(true);
                        record.getField('subscribe_level').setRequired(true);
                        record.getField('subscribe_level_n').setRequired(true);
                        record.getField('subscribe_account_name').setRequired(true);
                        record.getField('subscribe_account_num').setRequired(true);
                        record.getField('subscribe_branch_name').setRequired(true);
                    }else{
                        record.set("subscribe_main_name",'');
                        record.set("subscribe_account_name",'');
                        record.set("subscribe_account_num",'');
                        record.set("subscribe_branch_name",'');
                        record.getField('subscribe_date').setRequired(false);
                        record.getField('subscribe_level').setRequired(false);
                        record.getField('subscribe_level_n').setRequired(false);
                        record.getField('subscribe_account_name').setRequired(false);
                        record.getField('subscribe_account_num').setRequired(false);
                        record.getField('subscribe_branch_name').setRequired(false);
                    }
                }
                if (name === 'rele_credit_flag') {
                    if(record.get('rele_credit_flag') === 'Y'){
                        record.getField('credit_type').setRequired(true);
                        record.getField('credit_type_n').setRequired(true);
                    }else{
                        record.getField('credit_type').setRequired(false);
                        record.getField('credit_type_n').setRequired(false);
                    }
                }
            });
        });
        // 加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var caps_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_subscribe');
            if (ds.id === caps_ds_id && record && ('${/parameter/@function_usage}' !== 'QUERY')) {
                if(record.get('subscribe_type') === 'SELF_HOLDING_SUBSCRIPTION'){
                    record.getField('subscribe_date').setRequired(true);
                    record.getField('subscribe_level').setRequired(true);
                    record.getField('subscribe_level_n').setRequired(true);
                    record.getField('subscribe_account_name').setRequired(true);
                    record.getField('subscribe_account_num').setRequired(true);
                    record.getField('subscribe_branch_name').setRequired(true);
                }else{
                    record.getField('subscribe_date').setRequired(false);
                    record.getField('subscribe_level').setRequired(false);
                    record.getField('subscribe_level_n').setRequired(false);
                    record.getField('subscribe_account_name').setRequired(false);
                    record.getField('subscribe_account_num').setRequired(false);
                    record.getField('subscribe_branch_name').setRequired(false);
                }
                if(record.get('rele_credit_flag') === 'Y'){
                    record.getField('credit_type').setRequired(true);
                    record.getField('credit_type_n').setRequired(true);
                }else{
                    record.getField('credit_type').setRequired(false);
                    record.getField('credit_type_n').setRequired(false);
                }
            }
        }

        //新增时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            if ('ABS003F3_G_SUBSCRIBE_ct_abs_product_subscribe' === ds.bindname) {
                record.set('product_id', '${/parameter/@product_id}');
                record.set('issue_amount', '${/parameter/@issue_amount}');
                record.set('subscribe_status', 'NEW');
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if (ds.bindname === 'ABS003F3_G_SUBSCRIBE_ct_abs_product_subscribe') {
                qpara.product_id = '${/parameter/@product_id}';
            }
        };

        //确认按钮
        window['${/parameter/@layout_code}_G_SUBSCRIBE_confirm_layout_dynamic_tab_click'] = function () {
            var subscribe_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'ct_abs_product_subscribe');
            var confirm_records = $(subscribe_ds_id).getSelected();
            var send_data = [];
            confirm_records.forEach(function (current, index, arr) {
                send_data.push(current.data);
            });
            Leaf.showConfirm("${l:HLS.PROMPT}", "确认？", function () {
                Leaf.request({
                    url: $('abs003f3_confirm').getUrl(),
                    para: send_data,
                    scope: this,
                    success: function (res) {
                        Leaf.showMessage('${l:HLS.PROMPT}', '已确认');
                    }
                });
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>