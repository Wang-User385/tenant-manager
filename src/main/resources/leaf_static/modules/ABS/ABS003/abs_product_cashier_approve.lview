<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="abs_product_detail_link"
                url="${/request/@context_path}/modules/ABS/ABS003/abs_product_detail.lview"/>
        <script><![CDATA[
        var pageChooser = new PageChooser({
            url: $('abs_product_detail_link').getUrl(),
            function_code: 'ABS003F22',
            context_path: '${/request/@context_path}',
            opt: {
                product_id: '${/parameter/@businessKey}',
                //maintain_type: 'READONLY',
                //function_usage: 'QUERY',
                document_type: 'ABS_PRODUCT',
                function_code: 'ABS003F22'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>
    
    