<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="hls_bill_request_wfl_link"
                url="${/request/@context_path}/modules/GENER/GENER001/hls_general_issue.lview"/>
        <script><![CDATA[
        debugger;

        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;

        // console.log(param);

        var general = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "generalId";
        });
        var generalId = general[0].value;

      debugger;

        var    function_code= 'GENER001_WFL';
        var    function_usage='QUERY';


        var pageChooser = new PageChooser({
            url: $('hls_bill_request_wfl_link').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                businessKey : businessKey,
                general_id: generalId,
                maintain_type: 'READONLY',
                function_code: function_code,
                function_usage: function_usage

            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
