<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>



        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_general_issue');

            if(ds.id && '${/parameter/@layout_code}_G_GRID_hls_general_issue_ds' == ds.id){
                ds.setQueryParameter('general_id', '${/parameter/@general_id}');
                //管理页面查询自己的单据
                if('${/parameter/@function_code}' == 'GENER001'){
                    qpara['authority'] = '${/session/@user_id}';
                }
            }

        };
        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (record,document_type, business_type, employee_code) {
            Leaf.request({
                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    record.set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var head_record = ds.getCurrentRecord();

            head_record.set('status','NEW');
            head_record.set('status_n','新建');
            head_record.set('created_by','${/session/@user_id}');
            head_record.set('unit_id','${/session/@unitId}');

            head_record.set('unit_id_n', '${/session/@unitName}');

            head_record.set('apply_date',new Date());
            head_record.set('created_by_n','${/session/@employeeName}');
            //设置权限字符串
            window['${/parameter/@layout_code}_set_authority_rule_string'](head_record,"HLS_GENERAL_ISSUE", "HLS_GENERAL_ISSUE", '${/session/@employeeCode}');

        };

        function fin002_open_attach(general_id, status) {
            debugger;
            var  url;
            if(status=='APPROVED' || status =='APPROVING'||'${/parameter/@function_code}' == 'GENER001_F1'){
                url = '${/request/@context_path}/downloadFile.lview';

            }else{
                url = '${/request/@context_path}/uploadFile.lview';

            }
            win = new Leaf.Window({
                id: 'fin002_open_attachment_winid',
                url: url,
                params: {
                    header_id: general_id,
                    table_name: 'hls_general_issue',
                    winid: 'fin002_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });

        }

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            debugger;
            if (name == 'uploan') {
                if (record.get('general_id')) {
                    var table_name = 'hls_general_issue';
                    return '<a href="javascript:fin002_open_attach(\'' + record.get('general_id') + '\',\'' + record.get('status') + '\')">附件</a>';

                }
            }

            return value;
        };


        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_general_issue');
            var record = $(ds_id).getSelected();

            if (record[0].get('status') == 'NEW' || record[0].get('status') == 'REJECTED' ) {
                if ($(ds_id).validate()) {

                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                        Leaf.request({
                            url: '${/request/@context_path}/hls/general/issue/wfl',
                            para: {
                                general_id: record[0].get('general_id')
                            },
                            success: function (res) {
                                $(ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    })
                }

            }else{
                $L.showInfoMessage("提示", "审批中和审批通过的单据不允许再次提交!");
                return;
            }

        };
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_general_issue');

            if(ds.id == ln_ds_id&&record){

                if(record.get('status') =='APPROVED' || record.get('status') =='APPROVING'||'${/parameter/@function_code}' == 'GENER001_F1'){
                    record.getField('description').setReadOnly(true);
                    record.getField('next_approve_person').setReadOnly(true);
                    record.getField('next_approve_person_n').setReadOnly(true);

                }else{
                    record.getField('description').setReadOnly(false);
                    record.getField('next_approve_person').setReadOnly(false);
                    record.getField('next_approve_person_n').setReadOnly(false);
                }
            }

        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
