<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>

    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function inv_grid_down_load(value,record,name){
            return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id='+record.get('attachment_id')+'">下载</a>';
        }
        function inv_grid_down_delete(value,record,name){
            return '<a href="javascript:delete_attachment(\'' + record.get('inv_attachment_id') + '\')">删除</a>';

        }
        function delete_attachment(invAttachmentId){
            var url = '${/request/@context_path}/inv/finance/attachment/remove';
            Leaf.request({
                url: url,
                para : {
                    __status: 'delete',
                    inv_attachment_id: invAttachmentId,
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '删除成功');
                    $('inv_purchase_attachment_ds').query();

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        function import_attachment() {
            var financePurchaseId = '${/parameter/@financePurchaseId}';
            if(financePurchaseId == null){
                $L.showInfoMessage("提示","申购id为空，请您联系管理员处理!");
                return;
            }
            var url = '${/request/@context_path}/uploadFile.lview';

            var win = new Leaf.Window({
                id: 'inv200_open_attachment_winid',
                url: url,
                params: {
                    'header_id': financePurchaseId,
                    'table_name': 'INV_PURCHASE_ATT',
                    winid: 'inv200_open_attachment_winid'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                submit_attachment();
                $('inv_purchase_attachment_ds').query();
            });
        };
        function submit_attachment() {
            var financePurchaseId = '${/parameter/@financePurchaseId}';
            var ds_id = 'inv_purchase_attachment_ds';
            Leaf.request({
                url: "${/request/@context_path}/inv/finance/attachment/submit",
                para : {
                    __status: 'add',
                    purchaseId: financePurchaseId,
                    invAttachmentCategory: "INV_PURCHASE_ATT",
                    sourceId: $(ds_id).getCurrentRecord().get('file_id'),
                    documentName: $(ds_id).getCurrentRecord().get('file_name'),
                    makeUp:"RECORD",
                    status:"APPROVED"
                },
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage('提示', '保存成功');
                    $('inv_purchase_attachment_ds').query();

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        };
        ]]></script>
        <a:dataSets>
            <a:dataSet id="inv_purchase_attachment_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/inv/finance/attachment/query/info"
                       selectable="true">
                <a:fields>
                    <a:field name="file_name" required="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody id="testScreenBody">
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="import_attachment" text="附件上传"/>
            </a:screenTopToolbar>
            <a:grid id="inv_purchase_attachment_grid" bindTarget="inv_purchase_attachment_ds" marginHeight="190" marginWidth="570"
                    navBar="true">
                <a:columns>
                    <a:column name="file_name" width="130" prompt="附件名称" align="center"/>
                    <a:column name="upload_date" width="160" prompt="上传日期" align="center"/>
                    <a:column name="upload_person" width="160" prompt="上传人" align="center"/>
                    <a:column name="download" width="100" prompt="下载" renderer="inv_grid_down_load" align="center" />
                    <a:column name="description" width="200" prompt="备注" align="center"/>
                    <a:column name="delete" width="100" prompt="删除" renderer="inv_grid_down_delete" align="center"/>
                </a:columns>

            </a:grid>
            <script><![CDATA[
	  	]]></script>
        </a:screenBody>
    </a:view>
</a:screen>
