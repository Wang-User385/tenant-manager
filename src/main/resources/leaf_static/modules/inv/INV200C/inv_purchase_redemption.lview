<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application"
          trace="true" dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            var finance_purchase_id = '${/parameter/@finance_purchase_id}';
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'inv_finance_redeem');

            if(finance_purchase_id != null){
                if(ds.id == ds_id ){
                    ds.setQueryParameter('purchase_id', finance_purchase_id);
                }
            }
        };
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'inv_finance_redeem');
            var redeem_parm = $(ds_id).getJsonData()[0];
            Leaf.Masker.mask(Ext.getBody(), '正在保存。。');
            Leaf.request({
                url: '${/request/@context_path}/inv/finance/redeem/submit',
                method: "POST",
                dataType: "json",
                async: false,
                contentType: "application/json",
                para: redeem_parm,
                success: function (json) {
                    Leaf.Masker.unmask(Ext.getBody());
                    debugger;
                    if (json.success) {
                        Leaf.showInfoMessage("提示", "保存成功", function (event) {
                            var finance_redeem_id = json.result.record[0].finance_redeem_id;
                             $("inv200c_redeem_result_ds").setQueryParameter('finance_redeem_id', finance_redeem_id);
                             $("inv200c_redeem_result_ds").query();
                        })
                    } else {
                        Leaf.showErrorMessage(json.message);
                        return false;
                    }
                },
                error: function (e) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (e) {
                    Leaf.Masker.unmask(Ext.getBody());
                }
            });
        }
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'inv_finance_redeem');
            var redeem_parm = $(ds_id).getJsonData()[0];
            Leaf.Masker.mask(Ext.getBody(), '正在提交。。');
            Leaf.request({
                url: '${/request/@context_path}/inv/finance/redeem/submit/wfl',
                method: "POST",
                dataType: "json",
                async: false,
                contentType: "application/json",
                para: redeem_parm,
                success: function (json) {
                    Leaf.Masker.unmask(Ext.getBody());
                    debugger;
                    if (json.success) {
                        Leaf.showInfoMessage("提示", "提交成功", function (event) {
                            $("inv200c_redeem_result_ds").query();
                        })
                    } else {
                        Leaf.showErrorMessage(json.message);
                        return false;
                    }
                },
                error: function (e) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (e) {
                    Leaf.Masker.unmask(Ext.getBody());
                }
            });
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
