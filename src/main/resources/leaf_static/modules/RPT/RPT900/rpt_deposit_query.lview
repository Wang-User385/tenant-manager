<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-06-24
    $Revision: 1.0
    $Purpose: 保证金查询
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_deposit_detail';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'contract_id') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + value + '\');">' + '详情' + '</a>';
            }
        };


        function open_deposit_detail(contract_id) {
            var win = new Leaf.Window({
                id: 'rpt900_open_deposit_winid',
                url: '${/request/@context_path}/modules/RPT/RPT900/rpt_deposit_detail.lview',
                params: {
                    contract_id: contract_id,
                    winid: 'rpt900_open_deposit_winid'
                },
                title: '执行情况',
                fullScreen:true
            });
        }


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
