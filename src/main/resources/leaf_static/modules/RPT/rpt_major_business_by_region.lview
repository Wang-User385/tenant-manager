<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: why
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>

        <script><![CDATA[
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl=ds.queryurl+'&wflRuleControlFlag=Y';
        }

        function f() {
            $jq('[dataindex="sublease"][atype="grid-cell"]').css('background-color','#FFE7BA');
            $jq('[dataindex="lease"][atype="grid-cell"]').css('background-color','#FFE7BA');
            $jq('[dataindex="lease_back"][atype="grid-cell"]').css('background-color','#FFE7BA');
            $jq('[dataindex="general_operating_lease"][atype="grid-cell"]').css('background-color','#FFE7BA');
        }

        setInterval(f,50);
        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>