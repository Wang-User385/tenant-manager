<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="rpt810_report_detail_id"
                url="${/request/@context_path}/modules/RPT/RPT810/rpt_off_balance_detail.lview"/>
        <a:link id="rptm001_calc_price_quotation_common_link_id" url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900H1/quotation_calc_common_history.lview"/>

        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            if(ds.id == '${/parameter/@layout_code}_G_RESULT_prj_quotation_ds'){
                qpara['project_id'] = '${/parameter/@project_id}';
                ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_calc_detail';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'quotation_id') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '详情' + '</a>';
            }
        };


        function open_calc_detail(record_id,ds_id) {

            var record = $(ds_id).findById(record_id);
            var price_list = record.get('price_list');
            var quotation_id = record.get('quotation_id');

            var param = {};
            param['quotationId'] = quotation_id;
            param['quotation_id'] = quotation_id;
            param['priceList'] = price_list;
            param['function_code'] = "HLS900H1";
            param['layout_code'] = "HLS900H1";
            param['url_title'] = '报价计算';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';


            /*var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId='+quotation_id + '&priceList='+price_list  + '&readOnly=Y';
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel测算',
                fullScreen: true
            });*/

            hls_doc_get_layout_code(param, 'rptm001_calc_price_quotation_common_link_id', '${/parameter/@layout_code}_G_RESULT_prj_quotation_ds', "RPT710F1");
        }

        //价格审批通知书
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = '${/parameter/@layout_code}_G_RESULT_prj_quotation_ds';
            var quotation_records = $(ds_id).getSelected();
            if(quotation_records.length != 1){
                Leaf.showMessage('提示','请选择一条记录！');
                return false;
            }

            price_approval_table(quotation_records[0].get('project_id'),quotation_records[0].get('quotation_id'));
        };

        function price_approval_table(project_id, quotation_id) {
            var down_url;
            var templateCode = '';
            templateCode = 'PRICE_APPROVAL_TABLE_H';
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/project/approval/notice/create?projectId=" + project_id
                    + '&templateCode=' + templateCode + '&quotationId=' + quotation_id,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    debugger;
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
