<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <!--<a:link id="prj_project_get_layout_code_link_id" model="cont.CON500.con_contract_get_layout_code" modelaction="update"/>-->
        <!--<a:link id="prj_project_bp_parameter_link" url="${/request/@context_path}/modules/prj/PRJ501/prj_project_bp_parameter.lview"/>-->
        <!--<a:link id="prj_project_close_link_id" model="prj.PRJ501.prj_project_close" modelaction="update"/>-->
        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/RPT/RPT710/prj_project_detail_query.lview"/>
        <a:link id="prj316_project_create_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F1/prj_project_create.lview"/>

        <a:link id="fnd213_calculate_open_id"
                url="${/request/@context_path}/modules/FND/FND_BUS/FND213/hls_fin_calculate.lview"/>

        <a:link id="project_change_info_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANGE/PRJ100/prj_project_change_info.lview"/>

        <a:link id="project_notice_detail_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_static.lview"/>

        <a:link id="project_notice_detail_veto_linkid"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ330/prj_project_meeting_notice_veto.lview"/>

        <a:link id="project_credit_credit_notice_link"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition_query.lview"/>

        <a:link id="project_supplement_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T3/prj_project_modify_supplement.lview"/>


        <a:link id="project_query_supplement_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T2/prj_project_modify_query_supple.lview"/>

        <a:link id="prj316_project_history_entrance_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316H1/prj_project_history_entrance.lview"/>

        <a:link id="rpt710_project_price_review_id"  url="${/request/@context_path}/modules/RPT/RPT710/rpt_project_query_price_review.lview"/>
        <a:link id="prj316_project_modify_credit_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_credit.lview"/>

        <script><![CDATA[

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            if (name == 'prj_notice_id' && value ) {
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id') + '\',\'' + record.get('prj_notice_id')  + '\')">' + value + '</a>';
            }
            if (name == 'price_review') {
                return '<a href="javascript:open_price_review_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('project_id')  + '\')">' + '价格审批' + '</a>';
            }
            return value;
        };

        function open_notice_detail_win(ds_id, record_id ,project_id , prj_notice_id){
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '授信审批通知书';
            param['function_code'] = 'PRJ316T1QUERY';
            param['winid'] = 'project_credit_notice_id';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            //param['screen_width'] = '600';
            //param['side'] = 'right';
            hls_doc_get_layout_code(param, 'project_credit_credit_notice_link', ds_id, 'PRJ316');


        }

        function open_price_review_win(ds_id, record_id ,project_id){
            //debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '价格审批记录';
            param['function_code'] = 'RPT710F1';
            param['winid'] = 'project_credit_notice_id';
            //param['function_usage'] = 'QUERY';
            //param['maintain_type'] = 'READONLY';

            hls_doc_get_layout_code(param, 'rpt710_project_price_review_id', ds_id, 'PRJ316');
        }

        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316F2Q';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            var credit_flag = record.get('credit_flag');
            if(credit_flag == 'Y'){
                function_code = 'PRJ316F2_CREDIT';
                param['function_code'] = 'PRJ316F2_CREDIT';
                hls_doc_get_layout_code(param, 'prj316_project_modify_credit_id', ds_id, function_code);
            }else{
                hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);
            }
        }


        //报价测试
        window['${/parameter/@layout_code}_excel_test_layout_dynamic_click'] = function () {
            /*var price_list = 'HLS_EQUAL_PRINCIPAL';
            var quotationId = 1;
            prj316_open_price(price_list,quotationId);*/


            new Leaf.Window({
                id: 'fnd213_calculate_open_winid',
                url: $('fnd213_calculate_open_id').getUrl(),
                params: {
                    winid: 'fnd213_calculate_open_winid'
                },
                title: '项目报价',
                height: 400,
                width: 1050
            });


        }

        function prj316_open_price(price_list, quotationId) {
            new Leaf.Window({
                id: 'prj316_open_price_winid',
                url: '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?priceList=' + price_list + '&quotationId=' + quotationId,
                // params: {
                //     price_list: price_list,
                //     winid: 'hls_fin_cal_detail_winid'
                // },
                title: '项目报价',
                fullScreen: true
            });
        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
