        //客户信息维护
        function bp_modify(param_temp) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var param = {
                bp_id: param_temp.bp_id,
                bp_class: param_temp.bp_class
            };
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['function_usage'] = 'MODIFY';
            param['enabled_flag'] = 'Y';
            param['url_title'] = '客户信息维护';
            hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', prj_ds_id, 'BP100F1');
        }

        //主承租人变化
        function tenant_id_change(bp_record) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            prj_record.set('tenant_id', bp_record.bp_id);
            prj_record.set('tenant_id_n', bp_record.bp_id_n);
            prj_record.set('bp_name', bp_record.bp_id);
            prj_record.set('bp_name_n', bp_record.bp_id_n);
        }

        //共同承租人变化
        function tenant_sec_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var tenant_sec_id = '';
            var tenant_sec_id_n = '';
            for (var i = 1; i <= tenant_sec_count; i++) {
                var tenant_sec_ds_id = 'prj_create_tenant_rec_' + i + '_ds';
                var tenant_sec_record = $jq("#prj_project_tenant_sec_iframe")[0].contentWindow.$(tenant_sec_ds_id).getCurrentRecord();
                if (tenant_sec_record != null) {
                    if (tenant_sec_id == '') {
                        if (tenant_sec_record.get('bp_id')) {
                            tenant_sec_id = tenant_sec_id + tenant_sec_record.get('bp_id');
                            tenant_sec_id_n = tenant_sec_id_n + tenant_sec_record.get('bp_id_n');
                        }
                    } else {
                        if (tenant_sec_record.get('bp_id')) {
                            tenant_sec_id = tenant_sec_id + ',' + tenant_sec_record.get('bp_id');
                            tenant_sec_id_n = tenant_sec_id_n + ',' + tenant_sec_record.get('bp_id_n');
                        }
                    }
                }

            }
            prj_record.set('tenant_sec_id', tenant_sec_id);
            prj_record.set('tenant_sec_id_n', tenant_sec_id_n);
        }

        //法人担保人变化
        function guarantor_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var guarantor_id = '';
            var guarantor_id_n = '';
            for (var i = 1; i <= warrantor_count; i++) {
                var guarantor_ds_id = 'prj_create_guarantor_' + i + '_ds';
                var guarantor_record = $jq("#prj_project_guarantor_iframe")[0].contentWindow.$(guarantor_ds_id).getCurrentRecord();
                if (guarantor_record != null) {
                    if (guarantor_id == '') {
                        if (guarantor_record.get('bp_id')) {
                            guarantor_id = guarantor_id + guarantor_record.get('bp_id');
                            guarantor_id_n = guarantor_id_n + guarantor_record.get('bp_id_n');
                        }
                    } else {
                        if (guarantor_record.get('bp_id')) {
                            guarantor_id = guarantor_id + ',' + guarantor_record.get('bp_id');
                            guarantor_id_n = guarantor_id_n + ',' + guarantor_record.get('bp_id_n');
                        }
                    }
                }

            }
            prj_record.set('guarantor_id', guarantor_id);
            prj_record.set('guarantor_id_n', guarantor_id_n);
        }

        //自然人担保人变化
        function guarantor_np_id_change() {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var guarantor_np_id = '';
            var guarantor_np_id_n = '';
            for (var i = 1; i <= warrantor_count_np; i++) {
                var guarantor_np_ds_id = 'prj_create_guarantor_np_' + i + '_ds';
                var guarantor_np_record = $jq("#prj_project_guarantor_iframe")[0].contentWindow.$(guarantor_np_ds_id).getCurrentRecord();
                if (guarantor_np_record != null) {
                    if (guarantor_np_id == '') {
                        if (guarantor_np_record.get('bp_id')) {
                            guarantor_np_id = guarantor_np_id + guarantor_np_record.get('bp_id');
                            guarantor_np_id_n = guarantor_np_id_n + guarantor_np_record.get('bp_id_n');
                        }
                    } else {
                        if (guarantor_np_record.get('bp_id')) {
                            guarantor_np_id = guarantor_np_id + ',' + guarantor_np_record.get('bp_id');
                            guarantor_np_id_n = guarantor_np_id_n + ',' + guarantor_np_record.get('bp_id_n');
                        }
                    }
                }

            }
            prj_record.set('guarantor_np_id', guarantor_np_id);
            prj_record.set('guarantor_np_id_n', guarantor_np_id_n);
        }

        Leaf.onReady(function () {
            tenant_sec_count = '${/parameter/@tenant_sec_count}';
            tenant_sec_max = '${/parameter/@tenant_sec_max}';
            warrantor_count = '${/parameter/@warrantor_count}';
            warrantor_max = '${/parameter/@warrantor_max}';
            warrantor_count_np = '${/parameter/@warrantor_count_np}';
            warrantor_max_np = '${/parameter/@warrantor_max_np}';
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC_INFO');

            if ('${/parameter/@create_flag}' != '') {
                create_flag = '${/parameter/@create_flag}';
            }

            if (warrantor_count == 0 && warrantor_count_np == 0) {
                $jq("#prj_project_guarantor_iframe").hide();
            }

            if ('${/parameter/@return_flag}' == 'Y') {
                $('PROJECT_MODIFY_FINANCE_LEASE_user_button2').hide();
                $('PROJECT_MODIFY_FINANCE_LEASE_user_button6').hide();
            }


        });

        <!--打开窗口：指标明细-->
        function parent_winOpen_indicator_anaysis(header_id,report_year_one , report_year_two , report_year_three , report_year_four) {
            // debugger;
            if(report_year_one == null || report_year_one == 'undefined'  || report_year_one == '' ){
                report_year_one = '';
            }
            if(report_year_two == null || report_year_two == 'undefined' || report_year_two == '' ){
                report_year_two = '';
            }
            if(report_year_three == null || report_year_three == 'undefined' || report_year_three == ''){
                report_year_three = '';
            }
            if(report_year_four == null || report_year_four == 'undefined' || report_year_four == '' ){
                report_year_four = '';
            }
            new Leaf.Window({
                id: 'sys_resource_access_component_detail_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_indicator_info.lview',
                params: {
                    header_id: header_id,
                    report_year_one : report_year_one,
                    report_year_two : report_year_two,
                    report_year_three : report_year_three,
                    report_year_four : report_year_four,
                    winId: "sys_resource_access_component_detail_winId"
                },
                title: '报表明细',
                width:830,
                height:535,
                side:"right",
                draggable: true
            });

        }

        <!--打开窗口：报表明细-->
        function parent_winOpen_access_detail_component(result_id, excel_id) {
            if (result_id == null || result_id == '') {
                $L.showInfoMessage("提示", "参数获取失败!");
                return;
            }
            new Leaf.Window({
                id: 'bp100_excel_detail_win_id',
                params: {
                    result_id: result_id,
                    excel_id: excel_id,
                    source_document_category: 'HLS_BP_MASTER',
                    winid: 'bp100_excel_detail_win_id'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '财务报表明细',
                fullScreen: true
            });

        }

        <!--打开窗口：报表分期明细-->
        function parent_winOpen_access_component(header_id, fiscal_year) {
            new Leaf.Window({
                id: 'sys_resource_access_component_winId',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_period_info.lview',
                params: {
                    header_id: header_id,
                    fiscal_year: fiscal_year,
                    bp_id: '${/parameter/@bp_id}',
                    winId: "sys_resource_access_component_winId"
                },
                title: '报表明细',
                width: 830,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //报价计算入口
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            if(!$('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').validate()){
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list+'&readOnly=Y';
            //带入数据后打开excel
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel测算',
                fullScreen: true
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
                $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
            });

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
