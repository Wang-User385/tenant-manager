        //移除事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_remove'] = function (ds, record, bp_seq) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var param = record.data;
            Leaf.request({
                url: '${/request/@context_path}/ct/prj/quotation/delete',
                para: param,
                success: function (datas) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.SideBar.show({
                        msg: '操作成功',
                        duration: 2000
                    });
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            });
        };
        //如果修改或者新增客户信息时，承租人ID存到project表，不懂看复制的那块
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var hls_credit_line_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line');
            var hls_fin_statement_hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_fin_statement_hd');
            var prj_project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            // debugger;
            var projectId = $(prj_project_ds).getCurrentRecord().get('project_id');

            var prj_project_bp_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp','F_CUSTOMER_INFO');
            var prj_project_bp_record = $(prj_project_bp_ds).getAll();


            if(ds.id == prj_project_bp_ds){
                for(var i=0;i<prj_project_bp_record.length;i++){
                    if(prj_project_bp_record[i].data.bp_type=='TENANT'){
                        prj_project_bp_record[i].data.tenant_id = prj_project_bp_record[i].data.bp_id;
                        break;
                    }
                }
            }

            if (ds.id == hls_credit_line_ds) {
                if (name == 'bp_id') {
                    if (value) {
                        $(hls_fin_statement_hd_ds).getCurrentRecord().getField("rpt_date_n").setReadOnly(false);
                        $(hls_fin_statement_hd_ds).getCurrentRecord().set("bp_id", value);
                    } else {
                        $(hls_fin_statement_hd_ds).getCurrentRecord().getField("rpt_date_n").setReadOnly(true);
                    }
                }
                if (name == 'credit_line_id') {
                    $(prj_project_ds).getCurrentRecord().set('credit_line_id', value);
                }
            } else if (ds.id === hls_fin_statement_hd_ds) {
                if (name == 'fin_statement_hd_id') {
                    $(prj_project_ds).getCurrentRecord().set('fin_statement_hd_id', value);
                }
            } else if (ds.id === prj_project_ds) {
                //debugger;
                // if (name === 'is_spv') {
                //     if (value) {
                //         if (value === 'Y') {
                //             $(prj_project_ds).getCurrentRecord().getField('spv_company_n').setReadOnly(false);
                //         } else {
                //             $(prj_project_ds).getCurrentRecord().getField('spv_company_n').setReadOnly(true);
                //             $(prj_project_ds).getCurrentRecord().set('spv_company', null);
                //         }
                //     }
                // }
                // if (name === 'tenant_sec_count') {
                //     // debugger;
                //     $L.Masker.mask(Ext.getBody(), "加载中...");
                //     var tenant_id = record.get('tenant_id');
                //     var tenant_sec_id = '';
                //     if (record.get('tenant_sec_id') != undefined) {
                //         var tenant_sec_id = record.get('tenant_sec_id');
                //     }
                //
                //     var project_id = record.get('project_id');
                //     var marketing_report_id = record.get('marketing_report_id');
                //     var tenant_sec_count = record.get('tenant_sec_count');
                //     var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant.lview?tenant_id=' + tenant_id + '&tenant_sec_id=' + tenant_sec_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&tenant_sec_count=' + tenant_sec_count;
                //     $jq("#prj_project_tenant_sec_iframe").attr('src', url);
                //
                //     if (value == 0) {
                //         record.set('tenant_sec_id', '');
                //         record.set('tenant_sec_id_n', '');
                //     }
                //
                //
                // }
                // if (name === 'warrantor_count') {
                //     //debugger;
                //     $L.Masker.mask(Ext.getBody(), "加载中...");
                //     if (value > 0) {
                //         $jq("#prj_project_guarantor_iframe").show();
                //         $jq('#hls_fin_calc_templet').height(500);
                //     }
                //     var guarantor_id = '';
                //     if (record.get('guarantor_id') != undefined) {
                //         var guarantor_id = record.get('guarantor_id');
                //     }
                //     var guarantor_np_id = '';
                //     if (record.get('guarantor_np_id') != undefined) {
                //         var guarantor_np_id = record.get('guarantor_np_id');
                //     }
                //
                //     var project_id = record.get('project_id');
                //     var marketing_report_id = record.get('marketing_report_id');
                //     var warrantor_count = record.get('warrantor_count');
                //     var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor.lview?guarantor_id=' + guarantor_id + '&guarantor_np_id=' + guarantor_np_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&warrantor_count=' + warrantor_count + '&warrantor_count_np=' + warrantor_count_np;
                //     $jq("#prj_project_guarantor_iframe").attr('src', url);
                //
                //     if (value == 0) {
                //         record.set('guarantor_id', '');
                //         record.set('guarantor_id_n', '');
                //         if (record.get('warrantor_count_np') == 0) {
                //             $jq("#prj_project_guarantor_iframe").hide();
                //             $jq('#hls_fin_calc_templet').height(0);
                //         }
                //
                //     }
                // }
                // if (name === 'warrantor_count_np') {
                //     //debugger;
                //     $L.Masker.mask(Ext.getBody(), "加载中...");
                //     if (value > 0) {
                //         $jq("#prj_project_guarantor_iframe").show();
                //         $jq('#hls_fin_calc_templet').height(500);
                //     }
                //     var guarantor_id = '';
                //     if (record.get('guarantor_id') != undefined) {
                //         var guarantor_id = record.get('guarantor_id');
                //     }
                //     var guarantor_np_id = '';
                //     if (record.get('guarantor_np_id') != undefined) {
                //         var guarantor_np_id = record.get('guarantor_np_id');
                //     }
                //
                //     var project_id = record.get('project_id');
                //     var marketing_report_id = record.get('marketing_report_id');
                //     var warrantor_count = record.get('warrantor_count');
                //     var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor.lview?guarantor_id=' + guarantor_id + '&guarantor_np_id=' + guarantor_np_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&warrantor_count=' + warrantor_count + '&warrantor_count_np=' + warrantor_count_np;
                //     $jq("#prj_project_guarantor_iframe").attr('src', url);
                //
                //     if (value == 0) {
                //         record.set('guarantor_np_id', '');
                //         record.set('guarantor_np_id_n', '');
                //         if (record.get('warrantor_count') == 0) {
                //             $jq("#prj_project_guarantor_iframe").hide();
                //             $jq('#hls_fin_calc_templet').height(0);
                //         }
                //
                //     }
                // }
                if (name === 'tenant_sec_id') {
                    //debugger;
                    var tenant_sec_id = value;
                    var tenant_sec_ids = tenant_sec_id.split(',');
                    var same_flag = 'N';
                    for (var i = 0; i < tenant_sec_ids.length - 1; i++) {
                        var temp = tenant_sec_ids[i];
                        for (var j = i + 1; j < tenant_sec_ids.length; j++) {
                            if (temp == tenant_sec_ids[j]) {
                                same_flag = 'Y';
                                break;
                            }
                        }
                        if (same_flag == 'Y') {
                            break;
                        }
                    }
                    if (same_flag == 'Y') {
                        Leaf.showMessage('提示', '该共同承租人已录入！');
                    }
                }

                if (name === 'guarantor_id') {
                    //debugger;
                    var guarantor_id = value;
                    var guarantor_ids = guarantor_id.split(',');
                    var same_flag = 'N';
                    for (var i = 0; i < guarantor_ids.length - 1; i++) {
                        var temp = guarantor_ids[i];
                        for (var j = i + 1; j < guarantor_ids.length; j++) {
                            if (temp == guarantor_ids[j]) {
                                same_flag = 'Y';
                                break;
                            }
                        }
                        if (same_flag == 'Y') {
                            break;
                        }
                    }
                    if (same_flag == 'Y') {
                        Leaf.showMessage('提示', '该法人担保人已录入！');
                    }
                }

                if (name === 'guarantor_np_id') {
                    //debugger;
                    var guarantor_np_id = value;
                    var guarantor_np_ids = guarantor_np_id.split(',');
                    var same_flag = 'N';
                    for (var i = 0; i < guarantor_np_ids.length - 1; i++) {
                        var temp = guarantor_np_ids[i];
                        for (var j = i + 1; j < guarantor_np_ids.length; j++) {
                            if (temp == guarantor_np_ids[j]) {
                                same_flag = 'Y';
                                break;
                            }
                        }
                        if (same_flag == 'Y') {
                            break;
                        }
                    }
                    if (same_flag == 'Y') {
                        Leaf.showMessage('提示', '该自然人担保人已录入！');
                    }
                }
                if (name == 'business_type') {
                    if (value == 'GENERAL_CREDIT_APPROVAL' || value == 'VENDOR_CREDIT_APPROVAL' || value == 'UNION_CREDIT_APPROVAL') {
                        record.getField('finance_amount').setReadOnly(false);
                        record.getField('finance_amount').setRequired(true);
                    } else {
                        record.getField('finance_amount').setRequired(false);
                        record.getField('finance_amount').setReadOnly(true);
                    }
                }
                if(name == 'first_special_industry'){
                    if(value == 'Y'){
                        record.set('second_special_industry','N');
                        record.set('other_industry','N');
                        record.set('industry_category','FIRST_SPECIAL_INDUSTRY');
                    }
                }
                if(name == 'second_special_industry'){
                    if(value == 'Y'){
                        record.set('first_special_industry','N');
                        record.set('other_industry','N');
                        record.set('industry_category','SECOND_SPECIAL_INDUSTRY');
                    }
                }
                if(name == 'other_industry'){
                    if(value == 'Y'){
                        record.set('second_special_industry','N');
                        record.set('first_special_industry','N');
                        record.set('industry_category','OTHER_INDUSTRY');
                    }
                }
            } else if (ds.id === prj_quotation_ds) {
                var quotation_record = $(prj_quotation_ds).getCurrentRecord();
                if (value) {
                    switch (name) {
                        case 'down_payment_ratio':
                            quotation_record.set('down_payment', mul(quotation_record.get('lease_item_amount'), value));
                            break;
                        case 'adv_service_fee_ratio':
                            quotation_record.set('adv_service_fee', mul(quotation_record.get('lease_item_amount'), value));
                            break;
                        case 'deposit_ratio':
                            quotation_record.set('deposit', mul(quotation_record.get('lease_item_amount'), value));
                            break;
                        case 'down_payment':
                            quotation_record.set('down_payment_ratio', div(value, quotation_record.get('lease_item_amount')));
                            quotation_record.set('project_principal', minus(quotation_record.get('lease_item_amount'), value));
                            var deposit = quotation_record.get('deposit') || 0;
                            quotation_record.set('risk_exposure', minus(minus(quotation_record.get('lease_item_amount'), value), deposit));

                            break;
                        case 'adv_service_fee':
                            quotation_record.set('adv_service_fee_ratio', div(value, quotation_record.get('lease_item_amount')));
                            break;
                        case 'deposit':
                            quotation_record.set('deposit_ratio', div(value, quotation_record.get('lease_item_amount')));
                            var down_payment = quotation_record.get('down_payment') || 0;
                            quotation_record.set('risk_exposure', minus(minus(quotation_record.get('lease_item_amount'), down_payment), value));

                            break;
                        case 'lease_times':
                            if (quotation_record.get('renting_frequency') != null) {
                                var frequency = window['${/parameter/@layout_code}_get_lease_trem_num'](quotation_record.get('renting_frequency'));
                                var lease_term = Math.ceil(mul(value, frequency));
                                quotation_record.set('lease_term', lease_term);
                            }
                            break;
                        case 'renting_frequency':
                            if (quotation_record.get('lease_times') != null) {
                                var frequency = window['${/parameter/@layout_code}_get_lease_trem_num'](value);
                                var lease_term = Math.ceil(mul(quotation_record.get('lease_times'), frequency));
                                quotation_record.set('lease_term', lease_term);
                            }
                            break;
                        case 'int_rate_type':
                            if (value === 'FIXED') {
                                quotation_record.set('base_rate', null);
                                quotation_record.set('base_rate_n', '');
                                quotation_record.set('floating_way_rate', null);
                                quotation_record.set('floating_way', null);
                                quotation_record.set('floating_way_n', '');


                                quotation_record.getField('floating_way_n').setReadOnly(true);
                                quotation_record.getField('floating_way_n').setRequired(false);
                                quotation_record.getField('floating_way').setRequired(false);

                                quotation_record.getField('floating_way_rate').setReadOnly(true);
                                quotation_record.getField('floating_way_rate').setRequired(false);

                                quotation_record.getField('int_rate').setReadOnly(false);
                                quotation_record.getField('int_rate').setRequired(true);
                            } else {

                                quotation_record.set('int_rate', null);

                                quotation_record.getField('floating_way_n').setReadOnly(false);
                                quotation_record.getField('floating_way_n').setRequired(true);
                                quotation_record.getField('floating_way').setRequired(true);

                                quotation_record.getField('floating_way_rate').setReadOnly(false);
                                quotation_record.getField('floating_way_rate').setRequired(true);

                                quotation_record.getField('int_rate').setReadOnly(true);
                                quotation_record.getField('int_rate').setRequired(false);
                            }
                            break;
                        case 'floating_way_rate':
                            window['${/parameter/@layout_code}_calc_int_rate']();
                            break;
                    }
                }
            }
        };

        window['${/parameter/@layout_code}_calc_int_rate'] = function () {
            var prj_quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(prj_quotation_ds).getCurrentRecord();
            var floating_way = quotation_record.get(floating_way);
            var base_rate = quotation_record.get('base_rate');
            if (floating_way == 'MUTIPLY') {
                quotation_record.set("int_rate", base_rate * (plus(1, quotation_record.get('floating_way_rate'))));
            } else {
                quotation_record.set("int_rate", plus(base_rate, quotation_record.get('floating_way_rate')));
            }
        };

        window['${/parameter/@layout_code}_get_lease_trem_num'] = function (type) {
            var frequency;
            if (type == 'MONTH') {
                frequency = 1;
            } else if (type == 'QUARTER') {
                frequency = 3;
            } else if (type == 'HALF_A_YEAR') {
                frequency = 6;
            } else if (type == 'YEAR') {
                frequency = 12;
            } else if (type == 'DOUBLE_MONTH') {
                frequency = 2;
            }
            return frequency;
        };


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {

            var prj_quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var hls_credit_line_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_line');
            var hls_fin_statement_hd_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_fin_statement_hd');

            if (ds.id === '${/parameter/@layout_code}_F_BASIC_INFO_prj_project_ds') {
                if (create_flag == 'Y') {
                    var prj_record = $('${/parameter/@layout_code}_F_BASIC_INFO_prj_project_ds').getCurrentRecord();
                    prj_record.set('project_id', 0);
                    prj_record.set('project_name', '${/parameter/@project_name}');
                    prj_record.set('tenant_id', '${/parameter/@tenant_id}');
                    prj_record.set('tenant_id_n', '${/parameter/@tenant_id_n}');
                    prj_record.set('tenant_sec_id', '${/parameter/@tenant_sec_id}');
                    prj_record.set('guarantor_id', '${/parameter/@guarantor_id}');
                    prj_record.set('guarantor_np_id', '${/parameter/@guarantor_np_id}');
                    prj_record.set('host_project_manager', '${/parameter/@host_project_manager}');
                    prj_record.set('host_project_manager_n', '${/parameter/@host_project_manager_n}');
                    prj_record.set('host_unit_name', '${/parameter/@host_unit_name}');
                    prj_record.set('assist_project_manager', '${/parameter/@assist_project_manager}');
                    prj_record.set('assist_project_manager_n', '${/parameter/@assist_project_manager_n}');
                    prj_record.set('assist_unit_name', '${/parameter/@assist_unit_name}');
                    prj_record.set('marketing_report_id', '${/parameter/@marketing_report_id}');
                    prj_record.set('tenant_count', '${/parameter/@tenant_count}');
                    prj_record.set('tenant_sec_count', '${/parameter/@tenant_sec_count}');
                    prj_record.set('warrantor_count', '${/parameter/@warrantor_count}');
                    prj_record.set('warrantor_count_np', '${/parameter/@warrantor_count_np}');
                    prj_record.set('document_category', 'PRJ_PROJECT');
                    prj_record.set('document_type', 'PRJ_PROJECT');
                    prj_record.set('data_class', 'NORMAL');
                    prj_record.set('project_status', 'NEW');
                    prj_record.set('data_type', 'NORMAL');
                    /*prj_record.set('company_id','${/session/@companyId}');
                    prj_record.set('company_id_n','${/session/@companyName}');*/
                    prj_record.set('company_spv', '${/session/@companyId}');
                    prj_record.set('company_spv_n', '${/session/@companyName}');
                    prj_record.set('unit_id', '${/parameter/@unit_id}');
                    prj_record.set('host_unit_id', '${/parameter/@host_unit_id}');
                    prj_record.set('assist_unit_id', '${/parameter/@assist_unit_id}');
                    prj_record.set('marketing_channel', '${/parameter/@marketing_channel}');
                    prj_record.set('marketing_channel_n', '${/parameter/@marketing_channel_n}');
                    prj_record.set('xy_branch_bank', '${/parameter/@xy_branch_bank}');
                    prj_record.set('xy_branch_bank_n', '${/parameter/@xy_branch_bank_n}');
                    prj_record.set('finance_amount', '${/parameter/@finance_amount}');
                    prj_record.set('business_type', '${/parameter/@apply_leasing_products}');
                    prj_record.set('business_type_n', '${/parameter/@apply_leasing_products_n}');
                    prj_record.set('currency', '${/parameter/@currency}');
                    prj_record.set('currency_n', '${/parameter/@currency_n}');
                    prj_record.set('employee_id', '${/parameter/@employee_id}');


                }
                var prj_record = ds.getCurrentRecord();
                if (prj_record != null) {
                    //debugger;
                    if(prj_record.get('business_type')){
                        if (prj_record.get('business_type') == 'GENERAL_CREDIT_APPROVAL' || prj_record.get('business_type') == 'VENDOR_CREDIT_APPROVAL' || prj_record.get('business_type') == 'UNION_CREDIT_APPROVAL') {
                            if('${/parameter/@function_usage}' == 'QUERY'){

                            }else{
                                record.getField('finance_amount').setReadOnly(false);
                                record.getField('finance_amount').setRequired(true);
                            }
                        } else {
                            record.getField('finance_amount').setRequired(false);
                            record.getField('finance_amount').setReadOnly(true);
                        }
                    }

                    if (prj_record.modified != null) {
                        // debugger;
                        if (prj_record.modified.project_id != undefined && prj_record.modified.project_id != 0) {
                            var tenant_id = prj_record.modified.tenant_id;
                            var tenant_sec_id = prj_record.modified.tenant_sec_id;
                            var project_id = prj_record.modified.project_id;
                            var marketing_report_id = prj_record.modified.marketing_report_id;
                            var tenant_sec_count = prj_record.modified.tenant_sec_count;
                            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant.lview?tenant_id=' + tenant_id + '&tenant_sec_id=' + tenant_sec_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&tenant_sec_count=' + tenant_sec_count;
                            //$L.Masker.mask(Ext.getBody(), "加载中...");
                            $jq("#prj_project_tenant_sec_iframe").attr('src', url);

                            if (tenant_sec_count == 0) {
                                record.set('tenant_sec_id', '');
                                record.set('tenant_sec_id_n', '');
                            }

                            var guarantor_id = prj_record.modified.guarantor_id;
                            var guarantor_np_id = prj_record.modified.guarantor_np_id;
                            var marketing_report_id = prj_record.modified.marketing_report_id;
                            var warrantor_count = prj_record.modified.warrantor_count;
                            var warrantor_count_np = prj_record.modified.warrantor_count_np;
                            if (warrantor_count > 0 || warrantor_count_np > 0) {
                                $jq("#prj_project_guarantor_iframe").show();
                                $jq('#hls_fin_calc_templet').height(500);
                            }
                            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor.lview?guarantor_id=' + guarantor_id + '&guarantor_np_id=' + guarantor_np_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&warrantor_count=' + warrantor_count + '&warrantor_count_np=' + warrantor_count_np;
                            $jq("#prj_project_guarantor_iframe").attr('src', url);

                            if (warrantor_count == 0 && warrantor_count_np == 0) {
                                $jq("#prj_project_guarantor_iframe").hide();
                                $jq('#hls_fin_calc_templet').height(0);

                            }
                        }
                    } else {
                        // debugger;
                        if (prj_record.data.project_id != undefined && prj_record.data.project_id != 0) {
                            var tenant_id = prj_record.data.tenant_id;
                            var tenant_sec_id = prj_record.data.tenant_sec_id;
                            var project_id = prj_record.data.project_id;
                            var marketing_report_id = prj_record.data.marketing_report_id;
                            var tenant_sec_count = prj_record.data.tenant_sec_count;
                            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant.lview?tenant_id=' + tenant_id + '&tenant_sec_id=' + tenant_sec_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&tenant_sec_count=' + tenant_sec_count;
                            if ('${/parameter/@function_usage}' === 'QUERY') {
                                url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_tenant_query.lview?tenant_id=' + tenant_id + '&tenant_sec_id=' + tenant_sec_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&tenant_sec_count=' + tenant_sec_count;
                            }
                            //$L.Masker.mask(Ext.getBody(), "加载中...");
                            $jq("#prj_project_tenant_sec_iframe").attr('src', url);

                            if (tenant_sec_count == 0) {
                                record.set('tenant_sec_id', '');
                                record.set('tenant_sec_id_n', '');
                            }

                            var guarantor_id = prj_record.data.guarantor_id;
                            var guarantor_np_id = prj_record.data.guarantor_np_id;
                            var marketing_report_id = prj_record.data.marketing_report_id;
                            var warrantor_count = prj_record.data.warrantor_count;
                            var warrantor_count_np = prj_record.data.warrantor_count_np;
                            if (warrantor_count > 0 || warrantor_count_np > 0) {
                                $jq("#prj_project_guarantor_iframe").show();
                                $jq('#hls_fin_calc_templet').height(500);
                            }
                            var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor.lview?guarantor_id=' + guarantor_id + '&guarantor_np_id=' + guarantor_np_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&warrantor_count=' + warrantor_count + '&warrantor_count_np=' + warrantor_count_np;
                            if ('${/parameter/@function_usage}' === 'QUERY') {
                                url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_guarantor_query.lview?guarantor_id=' + guarantor_id + '&guarantor_np_id=' + guarantor_np_id + '&project_id=' + project_id + '&marketing_report_id=' + marketing_report_id + '&warrantor_count=' + warrantor_count + '&warrantor_count_np=' + warrantor_count_np;
                            }
                            $jq("#prj_project_guarantor_iframe").attr('src', url);

                            if (warrantor_count == 0 && warrantor_count_np == 0) {
                                $jq("#prj_project_guarantor_iframe").hide();
                                $jq('#hls_fin_calc_templet').height(0);
                            }
                        }
                    }

                }
                if(prj_record.get('industry_category') == 'FIRST_SPECIAL_INDUSTRY'){
                    prj_record.set('first_special_industry','Y');
                    prj_record.set('second_special_industry','N');
                    prj_record.set('other_industry','N');
                }
                if(prj_record.get('industry_category') == 'SECOND_SPECIAL_INDUSTRY'){
                    prj_record.set('first_special_industry','N');
                    prj_record.set('second_special_industry','Y');
                    prj_record.set('other_industry','N');
                }
                if(prj_record.get('industry_category') == 'OTHER_INDUSTRY'){
                    prj_record.set('first_special_industry','N');
                    prj_record.set('second_special_industry','N');
                    prj_record.set('other_industry','Y');
                }
            }


            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_QUOTATION');
            var credit_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan','F_CREDIT_PROGRAM');
            //根据是否授信动态展示报价方案与授信方案
            var credit_flag = '${/parameter/@credit_flag}';
            if(credit_flag == 'Y'){
                //隐藏报价方案组件
                $jq('#${/parameter/@layout_code}_T_FINANCE_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_FINANCE_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_FINANCE_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_FINANCE_component_id']").next().hide();
            }else{
                //隐藏授信方案组件
                $jq('#${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id').hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").prev().hide();
                $jq("div[name='${/parameter/@layout_code}_T_CREDIT_PROGRAM_component_id']").next().hide();
            }
            if(credit_flag == 'Y' && ds.id == quote_ds_id){
                //取消报价方案必填校验
                debugger
                record.getField('lease_item_amount').setRequired(false);
                record.getField('renting_method').setRequired(false);
                record.getField('renting_method_n').setRequired(false);
                record.getField('irr').setRequired(false);
                record.getField('int_rate').setRequired(false);
                record.getField('lease_term').setRequired(false);
                record.getField('lease_term_m').setRequired(false);
                record.getField('residual_value').setRequired(false);
                record.getField('deposit').setRequired(false);
            }
            if(credit_flag == 'N' && ds.id == credit_ds_id) {
                //取消授信方案必填校验
                record.getField('credit_amt').setRequired(false);
                record.getField('quota_type').setRequired(false);
                record.getField('quota_type_n').setRequired(false);
                record.getField('conglomerate_flag').setRequired(false);
                record.getField('conglomerate_flag_n').setRequired(false);
                record.getField('belong_conglomerate').setRequired(false);
                record.getField('date_from').setRequired(false);
                record.getField('date_to').setRequired(false);
                record.getField('credit_desc').setRequired(false);
            }



        };

        window['${/parameter/@layout_code}_set_authority_rule_string'] = function (document_type, business_type, employee_code) {
            Leaf.request({
                url: "${/request/@context_path}/prj/project/generateAuthorityString?documentType=" + document_type + "&businessType=" + business_type + "&employeeCode=" + employee_code,
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            switch (ds.id) {
                // case '${/parameter/@layout_code}_F_BASIC_INFO_prj_project_id_ds':
                case '${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    if(project_id){
                        qpara['document_id'] = project_id;
                        qpara['source_document_id'] = project_id;
                    }
                    qpara['source_document_category'] = 'PRJ_PROJECT';
                    qpara['data_class'] = 'PRJ_PROJECT_INVEST';
                    break;
                case '${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds':
                    var report_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                    var prj_record = $(report_ds_id).getCurrentRecord();
                    var project_id = prj_record.get('project_id');
                    if(project_id){
                        qpara['document_id'] = project_id;
                        qpara['source_document_id'] = project_id;
                    }
                    qpara['source_document_category'] = 'PRJ_PROJECT';
                    qpara['data_class'] = 'PRJ_PROJECT_INVEST';
                    break;
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var prj_record = $(prj_ds_id).getCurrentRecord();
            var chance_id = prj_record.get('chance_id');
            var project_id = prj_record.get('project_id');
            switch (ds.id) {
                case '${/parameter/@layout_code}_G_COUNTERPATRY_INFO_prj_project_bp_ds':
                    qpara['bp_patry_type'] = 'true';
                    break;
                case '${/parameter/@layout_code}_G_GUARANTEE_INFO_prj_project_bp_ds':
                    qpara['bp_role_type'] = 'WARRANTOR';
                    break;
                case '${/parameter/@layout_code}_G_LIST_OF_COLLATERAL_prj_project_bp_ds':
                    //qpara['bp_role_type'] = 'MORTGAGOR';
                    qpara['bp_role_type_flag'] = 'Y';
                    qpara['project_id'] = prj_record.get('project_id');
                    //qpara['project_id'] = '${/parameter/@project_id}';
                    break;
                case '${/parameter/@layout_code}_G_PLEDGE_LIST_prj_project_bp_ds':
                    qpara['bp_role_type'] = 'PLEDGOR';
                    break;
                case '${/parameter/@layout_code}_G_LEASE_ITEM_EQUIPMENT_prj_project_lease_item_ds':
                    qpara['project_id'] = prj_record.get('project_id');
                    //qpara['project_id'] = '${/parameter/@project_id}';
                    break;
                case '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds':
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_SALES';
                    break;
                case '${/parameter/@layout_code}_G_BP_ATTACHMEMT_prj_project_attachment_ds':
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_BP';
                    break;
                case '${/parameter/@layout_code}_G_LEASE_ATTACHMENT_prj_project_attachment_ds':
                    var project_id = prj_record.get('project_id');
                    qpara['project_id'] = project_id;
                    qpara['project_attachment_category'] = 'PRJ_LEASE';
                    break;
                case '${/parameter/@layout_code}_E_LEASE_ITEM_EQUIPMENT_prj_project_lease_item_ds':
                    qpara['project_id'] = prj_record.get('project_id');
                    qpara['project_type']='project';
                    break;
                case '${/parameter/@layout_code}_G_WFL_HIS_prj_project_ds':
                    ds.setQueryParameter('businessKey', chance_id);
                    ds.setQueryParameter('workFlowType', 'FCT_PROJECTCREATE_WFL');
                    break;
                case '${/parameter/@layout_code}_G_WFL_HIS_2_prj_project_ds':
                    ds.setQueryParameter('businessKey', project_id);
                    ds.setQueryParameter('workFlowType', 'PROJECT_REVIEW_WFL');
                    break;
            }
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            //debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            if (ds.id === '${/parameter/@layout_code}_G_PRE_LEASE_INTEREST_con_contract_before_rent_h_ds') {
                record.set('company_id', '${/session/@companyId}');
            }
            if (ds.id === '${/parameter/@layout_code}_G_SEND_REVIEW_REPORT_prj_project_attachment_ds') {
                record.set('project_attachment_category', 'PRJ_SEND_REVIEW_REPORT');
            }
        };

        $L.ComboBox.prototype.collapse = function () {
            Ext.get(document.documentElement).un("mousedown", this.triggerBlur, this);
            if (this.popup) {
                this.popup.moveTo(-1000, -1000);
                this.popup.removeClass('animated zoomInDownPopup');
                this.popup.addClass('animated zoomOut');
            }
            this.fireEvent("collapse", this);
        }

        //租赁物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_EQUIPMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var param = {};
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_detail_new_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'lease_info_detaill_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        //抵质押物创建
        window['${/parameter/@layout_code}_G_LIST_OF_COLLATERAL_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';

            param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
