<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="project_credit_credit_notice_link"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition_query.lview"/>
        <a:link id="rpt710_project_price_review_id"  url="${/request/@context_path}/modules/RPT/RPT710/rpt_project_query_price_review.lview"/>

        <script><![CDATA[
        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1WFL2';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';
            //
            // if (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN') {
            //     param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            //     param['maintain_type'] = 'READONLY';
            //     param['function_usage'] = 'QUERY';
            // }
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['report_flag'] = 'Y';
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
        }
        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: '${/request/@context_path}/ct/prj/project/prjHomePageProjectInfoGrid',
                para: {
                    project_id:record.get('ref_project_id')
                },
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var param = {}, function_code = 'PRJ316F2';
                    param['project_id'] = record.get('ref_project_id');
                    param['tenant_id'] = res.result.record[0].tenant_id;
                    param['tenant_sec_id'] = res.result.record[0].tenant_sec_id;
                    param['marketing_report_id'] = res.result.record[0].marketing_report_id;
                    param['tenant_sec_count'] = res.result.record[0].tenant_sec_count;
                    param['warrantor_count'] = res.result.record[0].warrantor_count;
                    param['warrantor_count_np'] = res.result.record[0].warrantor_count_np;
                    param['project_status'] = res.result.record[0].project_status;
                    param['business_type'] = res.result.record[0].business_type;
                    param['url_title'] = '项目明细';
                    param['winid'] = 'project_modify_winid';
                    param['function_code'] = function_code;
                    param['maintain_type'] = 'READONLY';
                    param['function_usage'] = 'QUERY';

                    hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);

                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        type: 'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                scope: this
            });

        }
        function open_notice_detail_win(ds_id, record_id ,project_id , prj_notice_id){
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '授信审批通知书';
            param['function_code'] = 'PRJ316T1QUERY';
            param['winid'] = 'project_credit_notice_id';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            param['project_id'] = project_id;
            //param['screen_width'] = '600';
            //param['side'] = 'right';
            hls_doc_get_layout_code(param, 'project_credit_credit_notice_link', ds_id, 'PRJ316');


        }
        function open_price_review_win(ds_id, record_id ,project_id){
            //debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '价格审批记录';
            param['function_code'] = 'RPT710F1';
            param['winid'] = 'project_credit_notice_id';
            //param['function_usage'] = 'QUERY';
            //param['maintain_type'] = 'READONLY';
            param['project_id'] = project_id;
            hls_doc_get_layout_code(param, 'rpt710_project_price_review_id', ds_id, 'PRJ316');
        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            if (name == 'prj_notice_id_n'&& value ) {
                return '<a href="javascript:open_notice_detail_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('ref_project_id') + '\',\'' + record.get('prj_notice_id')  + '\')">' + value + '</a>';
            }
            if (name == 'price_review') {
                return '<a href="javascript:open_price_review_win(\'' + record.ds.id + '\',\'' + record.id  + '\',\'' + record.get('ref_project_id')  + '\')">' + '价格审批' + '</a>';
            }
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>