<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: zxt
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[
        Leaf.onReady(function () {
            //debugger;
            var ds = $('rental_income_rate_query_ds');
            var record = ds.getCurrentRecord();
            var firstDate = new Date();
            firstDate.setDate(1);
            record.set('due_date_from',firstDate);
            var lastDate = new Date();
            lastDate.setMonth(firstDate.getMonth() + 1);
            lastDate.setDate(1);
            record.set('due_date_to',new Date(lastDate.getTime()-1000*60*60*24));
            rental_income_rate_query();

        });
        function rental_income_rate_query() {
            $('rental_income_rate_totail_ds').query();
        }


        function rental_income_rate_reset() {
            $('rental_income_rate_query_ds').reset();
            $('rental_income_rate_totail_ds').query();
        }

        function rental_income_rate_totail_grid_editor(value,record, name){
            debugger;
            if (name == 'received_rate') {
                if (!isNaN(value)) {
                    return parseFloat(value * 100).toFixed(4) + '%';
                } else {
                    return '';
                }
            }
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="rental_income_rate_query_ds">
                <a:fields>
                    <a:field name="currency_name" options="currency_ds"
                             displayField="currency_name" valueField="currency_code" required="true" defaultValue="人民币" returnField="currency_code"/>
                    <a:field name="due_date_from" required="true"/>
                    <a:field name="due_date_to" required="true"/>
                    <a:field name="cashflow_item_desc" options="fnd_cf_item_options_ds" displayField="description"
                             valueField="cf_item" returnField="cashflow_item"/>
                    <a:field name="int_rate" readOnly="true" defaultValue="1"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="rental_income_rate_totail_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/rpt/rental/income/rate/queryTotal"
                       queryDataSet="rental_income_rate_query_ds" selectable="true">
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="rental_income_rate_query" text="HAP.QUERY"/>
                <a:gridButton click="rental_income_rate_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form title="查询条件" style="width:100%">
                <a:box column="3" labelWidth="150">
                    <a:datePicker name="due_date_from" bindTarget="rental_income_rate_query_ds"  prompt="查询区间从"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rental_income_rate_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:datePicker name="due_date_to" bindTarget="rental_income_rate_query_ds"  prompt="查询区间到"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rental_income_rate_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:comboBox name="currency_name" bindTarget="rental_income_rate_query_ds"  prompt="币种"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rental_income_rate_query"/>
                        </a:events>
                    </a:comboBox>
                </a:box>
                <a:box column="4" labelWidth="150">
                    <a:numberField name="int_rate" bindTarget="rental_income_rate_query_ds"  prompt="汇率"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                </a:box>
            </a:form>
            <a:grid id="rental_income_rate_totail_grid_id" bindTarget="rental_income_rate_totail_ds" marginHeight="140"
                    marginWidth="50" navBar="true">
                <a:columns>
                    <a:column name="business_unit" width="260" prompt="业务部门" align="center"/>
                    <a:column name="due_amount" width="260" prompt="应收金额" align="center" renderer="Leaf.formatMoney"/>
                    <a:column name="received_amount" width="260" prompt="已收金额" align="center" renderer="Leaf.formatMoney"/>
                    <a:column name="received_rate" width="260" prompt="租金回收率" align="center" renderer="rental_income_rate_totail_grid_editor"/>
                    <a:column name="overdue_amount" width="260" prompt="逾期金额" align="center" renderer="Leaf.formatMoney"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>