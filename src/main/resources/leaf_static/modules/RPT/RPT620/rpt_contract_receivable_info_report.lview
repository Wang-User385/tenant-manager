<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/javascripts/dynamicStopAutoQuery.js" type="text/javascript"/>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <script><![CDATA[

        window['${/parameter/@layout_code}' + '_' + 'G_CON' + '_' + 'con_contract' + '_dsStopQuery'] = true;
        window['${/parameter/@layout_code}' + '_' + 'F_SUMMARY' + '_' + 'con_contract_cashflow' + '_dsStopQuery'] = true;

        $L.onReady(function () {
            window['${/parameter/@layout_code}' + '_' + 'F_SUMMARY' + '_' + 'con_contract_cashflow' + '_dsStopQuery'] = false;
            window['${/parameter/@layout_code}' + '_' + 'G_CON' + '_' + 'con_contract' + '_dsStopQuery'] = false;

            require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'],'con_query','due_date_from');
            require_dataset_field(window['${/parameter/@layout_code}_layoutDataSetList'],'con_query','due_date_to');
        })
        stopDymanicAutoQuery('${/parameter/@layout_code}', 'G_CON', 'con_contract');
        stopDymanicAutoQuery('${/parameter/@layout_code}', 'F_SUMMARY', 'con_contract_cashflow');

        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';
                param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
            param['report_flag'] = 'Y';
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            $(ds_id).query();
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>