        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            if (ds.id == '${/parameter/@layou   t_code}_G_CASHFLOW_con_contract_cashflow_ds') {
                qpara['rental_flag'] = 'Y';
            }
            //租前息
            if (ds.id == '${/parameter/@layout_code}_G_PRE_LEASE_INTEREST_gld_contract_finance_income_ds') {
                qpara['cf_item'] = 10;
                qpara['contract_id'] = '${/parameter/@contract_id}';
            }
            //保证金
            if (ds.id == '${/parameter/@layout_code}_G_DEPOSIT_FEE_gld_contract_finance_income_ds') {
                qpara['cf_item'] = 501;
                qpara['contract_id'] = '${/parameter/@contract_id}';
            }
            //手续费
            if (ds.id == '${/parameter/@layout_code}_G_HANDLING_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 3;
            }
            //咨询费
            if (ds.id == '${/parameter/@layout_code}_G_CONSULT_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 66;
            }
            //资产管理费
            if (ds.id == '${/parameter/@layout_code}_G_ASSET_MANAGE_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 41;
            }
            //利息摊销
            if (ds.id == '${/parameter/@layout_code}_G_INTEREST_AMORTIZATION_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 1;
            }
            //XIRR历史
            if (ds.id == '${/parameter/@layout_code}_G_XIRR_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
            }
            //保证金
            if (ds.id == '${/parameter/@layout_code}_F_DEPOSIT_FEE_gld_contract_finance_income_ds') {
                qpara['cf_item'] = 501;
                qpara['contract_id'] = '${/parameter/@contract_id}';
            }
            //手续费
            if (ds.id == '${/parameter/@layout_code}_F_HANDLING_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 3;
            }
            //咨询费
            if (ds.id == '${/parameter/@layout_code}_F_CONSULT_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 66;
            }
            //资产管理费
            if (ds.id == '${/parameter/@layout_code}_F_ASSET_MANAGE_FEE_gld_contract_finance_income_ds') {
                qpara['contract_id'] = '${/parameter/@contract_id}';
                qpara['cf_item'] = 41;
            }
        };

        //查询时调用(form)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            if (ds.id == '${/parameter/@layout_code}_F_CONTRACT_con_contract_ds') {
                qpara['point_in_time'] = '${/parameter/@point_in_time}';
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'allocation_renderer';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'received_amount') {
                var record = $(record.ds.id).findById(record.id);
                var cashflow_id = record.get('contract_cashflow_id');
                var gld_cashflow_id = record.get('gld_cashflow_id');
                if(cashflow_id == null || cashflow_id == ''){
                    cashflow_id = gld_cashflow_id;
                }
                return '<a  href="#' + Math.random() + '" onclick="open_write_off_detail_window(' + cashflow_id + ')">' + Leaf.formatMoney(value) + '</a>';
            }
        };

        function open_write_off_detail_window(cashflow_id) {
            var param = {};
            param['url_title'] = '核销明细';
            param['function_code'] = 'RPT500F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'rpt_report_detail_id_winId';
            param['cashflow_id'] = cashflow_id;
            hls_doc_get_layout_code(param, 'rpt_report_detail_id', null, 'RPT500');

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>