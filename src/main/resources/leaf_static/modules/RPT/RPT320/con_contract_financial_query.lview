<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="rpt320f1_con_financial_detail_link_id"
                url="${/request/@context_path}/modules/RPT/RPT320/con_contract_financial_query_detail.lview"/>
        <a:link id="rpt320_calc_price_quotation_common_link_id"
                url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900/quotation_calc_common.lview"/>
        <script><![CDATA[

        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同财务查询报表明细';
            param['function_code'] = 'RPT320F1';
            param['winid'] = 'con_financial_detail_winid';
            param['contract_id'] = $(ds_id).findById(record_id).get('contract_id');
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            // param['layout_debugger_flag'] = 'Y';
            var query_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var query_record = $(query_ds_id).getCurrentRecord();
            param['point_in_time'] = query_record.get('point_in_time');
            hls_doc_get_layout_code(param, 'rpt320f1_con_financial_detail_link_id', ds_id, 'RPT320');
        }

       ///新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var formRecord = $(ds_id).getAt(0);
            record.set('point_in_time',new Date());
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'payment_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'quotation_id') {
                link_function = 'rent_payment_make_quotation';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">报价详情</a>';
            }
        };

        //报价链接
        window['rent_payment_make_quotation'] = function (record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var quotationId = record.get('quotation_id');

            if (quotationId != null) {

                //打开报价窗口
                var param = {};
                param['quotationId'] = quotationId;
                param['quotation_id'] = quotationId;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';

                hls_doc_get_layout_code(param, 'rpt320_calc_price_quotation_common_link_id', '${/parameter/@layout_code}_G_CON_con_contract_ds', "HLS900");


            } else {
                Leaf.showMessage("提示", "报价未计算成功，无法查看!", null);
                return false;
            }
        };


        Leaf.onReady(function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var record = $(ds_id).getAt(0);
            record.set('point_in_time',new Date());

        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>