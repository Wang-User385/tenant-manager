<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-4-28
    $Revision: 1.0
    $Purpose: 上报总行版本管理
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>

        <script><![CDATA[

function rpt600_exit(){
    $('${/parameter/@winid}').close();
}


        ]]></script>
        <a:dataSets>
            <a:dataSet id="rpt_contract_overdue_detail_ds" autoPageSize="true" autoQuery="true" selectable="true"
                       queryUrl="${/request/@context_path}/hls/con/overdue/query?contractId=${/parameter/@contract_id}&amp;queryDateS=${/parameter/@query_date}">

            </a:dataSet>
        </a:dataSets>
        <a:screenTopToolbar>
            <a:screenTitle/>
            <a:gridButton click="rpt600_exit" text="退出"/>

        </a:screenTopToolbar>
        <a:screenBody>
            <a:grid id="rpt_contract_overdue_detail_grid" title="逾期租金" bindTarget="rpt_contract_overdue_detail_ds" width="1200"
                    height="440" navBar="true">
                <a:columns>
                    <a:column width="100" name="times" prompt="期数" align="center"/>
                    <a:column width="120" name="cf_item_n" prompt="现金流项目" align="center" />
                    <a:column width="100" name="query_date_s"  prompt="计划日期"
                              align="center"/>
                    <a:column width="120" name="due_amount" prompt="应收金额" renderer="Leaf.formatMoney"
                              align="right"/>
                    <a:column width="120" name="principal"  prompt="应收本金" renderer="Leaf.formatMoney"
                              align="right"/>
                    <a:column width="120" name="interest"  prompt="应收利息" renderer="Leaf.formatMoney"
                              align="right"/>
                    <a:column width="120" name="received_amount"  prompt="已收金额" renderer="Leaf.formatMoney"
                              align="right"/>
                    <a:column width="120" name="un_received_amount"  prompt="未收金额" renderer="Leaf.formatMoney"
                              align="right"/>
                </a:columns>
            </a:grid>
        </a:screenBody>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
