<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script src="${/request/@context_path}/javascripts/dynamicStopAutoQuery.js" type="text/javascript"/>
        <script><![CDATA[

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //不做权限控制
            ds.queryurl=ds.queryurl+'&wflRuleControlFlag=Y';
        }

        function open_contract_detail_win(record_id, ds_id) {
            var record = $(ds_id).getCurrentRecord();
            var contract_id = record.get('contract_id');
            var query_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_query');
            var query_record = $(query_ds_id).getCurrentRecord();
            var query_date=query_record.get('query_date');
            new Leaf.Window({
                id: 'rpt_contract_overdue_info_winid',
                url: '${/request/@context_path}/modules/RPT/RPT600/rpt_contract_overdue_info_detail.lview',
                params: {
                    contract_id: contract_id,
                    query_date:query_date,
                    winid: 'rpt_contract_overdue_info_winid'
                },
                title: '逾期情况明细',
                fullScreen: true,
                draggable: true
            });
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };



        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>