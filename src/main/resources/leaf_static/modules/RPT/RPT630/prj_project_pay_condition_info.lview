<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" xmlns:p="uncertain.proc" xmlns:c="leaf.application.action"
          xmlns:s="leaf.plugin.script" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>

        <style>

        </style>
        <script><![CDATA[



        ]]>
        </script>

        <a:dataSets>

<!--            付款前提条件-->
            <a:dataSet id="prj_meeting_approve_condition_ds" autoPageSize="true"  autoCreate="true" selectable="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls/prj/approve/paymentcondition?projectId=${/parameter/@project_id}"
                       submitUrl="${/request/@context_path}/prj/project/credit/condition/submit"
                       deleteUrl="${/request/@context_path}/prj/project/credit/condition/remove">

                <a:fields>
                    <a:field name="project_id" defaultValue='${/parameter/@project_id}'/>
                    <a:field name="condition"  readOnly="true"/>
                    <a:field name="exemption_cause"  readOnly="true"/>
                    <a:field name="if_immunity" checkedValue="Y" defaultValue="Y" uncheckedValue="N"  readOnly="true"/>
                    <a:field name="if_practicable" checkedValue="Y" defaultValue="Y" uncheckedValue="N"  readOnly="true"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>

        <a:screenBody style="background-color:#fff">

            <a:form title="付款前提条件"  width="1300"  navBar="true" >

                <a:grid id="payment_conditon_id"  marginHeight="200" marginWidth="120" bindTarget="prj_meeting_approve_condition_ds" >
                    <a:columns>
                        <a:column name="row_seq" prompt="序号" width="100" align="center"/>
                        <a:column name="condition" prompt="付款前提条件" width="800"   readOnly="true"/>
                        <a:column name="exemption_cause" prompt="豁免原因" width="200" align="left"/>
                        <a:column name="if_practicable" prompt="已落实" width="100" align="center"/>
                        <a:column name="if_immunity" prompt="已豁免" width="100" align="center"/>
                    </a:columns>
                </a:grid>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
