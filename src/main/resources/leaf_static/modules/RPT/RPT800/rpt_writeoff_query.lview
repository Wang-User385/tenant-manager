<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-06-24
    $Revision: 1.0
    $Purpose: 核销明细查询
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="transaction_manual_allocation_detail_link"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH301/csh_transaction_receipt_allocation_detail.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            //debugger;
            var link_function = 'open_allocation_window';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'transaction_num') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.get('allocation_id_str')  + '\');">' + value + '</a>';
            }
        };

        function open_allocation_window(allocation_id_str) {
            var win = new Leaf.Window({
                id: 'transaction_allocation_winId',
                url: $('transaction_manual_allocation_detail_link').getUrl(),
                params: {
                    allocation_id_str: allocation_id_str,
                    winId: 'transaction_allocation_winId'
                },
                title: '匹配结果查询',
                fullScreen: true,
                draggable: true
            });

        }



        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
