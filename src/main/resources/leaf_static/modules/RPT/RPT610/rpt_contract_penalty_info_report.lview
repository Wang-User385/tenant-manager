<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="rpt610_report_detail_id" url="${/request/@context_path}/modules/RPT/RPT610/rpt_contract_penalty_detail.lview"/>
        <a:link id="csh901f1_report_detail_id" url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH901/csh_penalty_interest_reduce_detail_query.lview"/>
        <script><![CDATA[
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var contract_id = record.get('contract_id');
            var change_req_id = record.get('change_req_id');
            if (name == 'received_amount') {
                return '<a  href="#' + Math.random() + '" onclick="open_write_off_detail_window(' + contract_id + ')">' + Leaf.formatMoney(value) + '</a>';
            }
            if (name == 'reduce_amount') {
                return '<a  href="#' + Math.random() + '" onclick="open_reduce_amount_detail_window(' + change_req_id + ')">' + Leaf.formatMoney(value) + '</a>';
            }

        };
        function open_write_off_detail_window(contract_id) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');

            var param = {};
            param['url_title'] = '罚息核销明细';
            param['function_code'] = 'RPT610F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'rpt_610_detail_id_winId';
            param['contract_id'] = contract_id;
            hls_doc_get_layout_code(param, 'rpt610_report_detail_id', ds_id, 'RPT610');

        }

        function open_reduce_amount_detail_window(change_req_id) {debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');

            var param = {};
            param['url_title'] = '减免利息明细';
            param['function_code'] = 'CSH901F2';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'csh901f1_detail_id_winid';
            param['change_req_id'] = change_req_id;
            hls_doc_get_layout_code(param, 'csh901f1_report_detail_id', ds_id, 'RPT610');

        }

        Leaf.onReady(function(){
            debugger;
            var f_con_ds_id = '${/parameter/@layout_code}_F_CON__ds';
            //$(ds_id).create();
            var f_con_record = $(f_con_ds_id).getCurrentRecord();
            // f_con_record.set('due_date_from',new Date());
            f_con_record.set('due_date_to',new Date());
            var g_con_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            $(g_con_ds_id).query();
        })

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>