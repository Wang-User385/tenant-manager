<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-6-8
    $Revision: 1.0
    $Purpose: 尽调报告报表
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="prj_project_wfl_detail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify_wfl.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'project_detail';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '-&#45;&#45;' + name] = record;
            if (name == 'project_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'review_detail' && (record.get('allocation_risk_id') != null || record.get('allocation_risk_id') != '')) {
                link_function = 'review_detail';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '项目审查界面' + '</a>';
            }
        }

        window['project_detail'] = function (record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, function_code);
        };

        window['review_detail'] = function (record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316WFL_MANAGER';
            param['url_title'] = '审查明细';
            param['winid'] = 'prj316wfl_project_modify_winid';
            param['function_code'] = function_code;
            var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['review_detail_flag'] = 'Y';

            hls_doc_get_layout_code(param, 'prj_project_wfl_detail_link_id', ds_id, function_code);
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
