<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {

            var sheet_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'rpt_off_balance_sheet');

            if(ds.id == sheet_ds_id){
                qpara['contract_id'] = '${/parameter/@contract_id}';
            }

        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
