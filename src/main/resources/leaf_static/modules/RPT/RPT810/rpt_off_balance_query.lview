<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-06-24
    $Revision: 1.0
    $Purpose: 表外账查询
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="rpt810_report_detail_id"
                url="${/request/@context_path}/modules/RPT/RPT810/rpt_off_balance_detail.lview"/>
        <script><![CDATA[


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var report_link_function = 'open_off_balance_report';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'contract_id') {
                return '<a href="javascript:window[\'' + report_link_function + '\'](\'' + value + '\');">' + '每日报表' + '</a>';
            }
            var detail_link_function = 'open_off_balance_detail';
            if(name == 'detail_info'){
                return '<a href="javascript:window[\'' + detail_link_function + '\'](\'' + record.get('contract_id') + '\');">' + '明细' + '</a>';
            }
        };


        function open_off_balance_report(contract_id) {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/rpt/off/balance/sheet/create?contractId='+contract_id,
                success: function (res) {

                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
                    var param = {};
                    param['url_title'] = '表外账明细每日报表';
                    param['function_code'] = 'RPT810F1';
                    param['function_usage'] = 'QUERY';
                    param['contract_id'] = contract_id;
                    param['winid'] = 'rpt810_detail_id_winid';
                    hls_doc_get_layout_code(param, 'rpt810_report_detail_id', ds_id, 'RPT810');
                },
                error: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                faliure: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        }

        function open_off_balance_detail(contract_id){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var param = {};
            param['url_title'] = '表外账明细查询';
            param['function_code'] = 'RPT810F2';
            param['function_usage'] = 'QUERY';
            param['contract_id'] = contract_id;
            param['winid'] = 'rpt810_detail_id_winid';
            hls_doc_get_layout_code(param, 'rpt810_report_detail_id', ds_id, 'RPT810');
        }


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
