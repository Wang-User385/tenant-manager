<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="prj316_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316/prj_project_modify.lview"/>
        <a:link id="eft900_eft_fund_id"
                url="${/request/@context_path}/modules/EFT/EFT900/eft_fund_transfer.lview"/>
        <a:link id="rptm001_calc_price_quotation_common_link_id"
                url="${/request/@context_path}/modules/RPT/RPT510/rpt_contract_payment_report_detail.lview"/>

        <script><![CDATA[
        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1WFL2';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';
            //
            // if (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN') {
            //     param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            //     param['maintain_type'] = 'READONLY';
            //     param['function_usage'] = 'QUERY';
            // }
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['report_flag'] = 'Y';
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'RPT510');
        }
        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data, function_code = 'PRJ316F2';
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = record.get('project_status');
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            hls_doc_get_layout_code(param, 'prj316_project_modify_id', ds_id, 'RPT510');
        }
        //资金调拨单
        function open_eft_fund_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var function_code = 'EFT900RPT';
            param['url_title'] = '资金调拨单';
            param['winid'] = 'eft_fund_winid';
            param['function_code'] = function_code;
            // param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['contract_id'] = record.get('contract_id');
            hls_doc_get_layout_code(param, 'eft900_eft_fund_id', ds_id, 'RPT510');
        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
            if (name == 'eft_fund') {
                return '<a href="javascript:open_eft_fund_win(\'' + record.ds.id + '\',\'' + record.id + '\')">资金调拨单</a>';
            }
            if (name == 'payment_number') {
                link_function = 'rent_payment_make_quotation';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">' + value + '</a>';
            }
        };

        //报价链接
        window['rent_payment_make_quotation'] = function (record_id, name) {
            var record = window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
            var quotationId = record.get('quotation_id');
            //打开报价窗口
            var param = {};
            param['quotationId'] = quotationId;
            param['quotation_id'] = quotationId;
            param['contract_id'] = record.get('contract_id');
            param['function_code'] = "RPT510D01";
            param['layout_code'] = "RPT510D01";
            param['url_title'] = '支付表详情';
            param['quotation_flag'] = 'CONTRACT';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'rptm001_calc_price_quotation_common_link_id', '${/parameter/@layout_code}_G_RESULT_con_contract_ds', "RPT510D01");

        };
        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>