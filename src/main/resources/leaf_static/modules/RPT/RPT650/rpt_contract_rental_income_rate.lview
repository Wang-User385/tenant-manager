<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
        <a:model-query model="$com.hand.hls.sys.service.SysDefaultValueService.querySysDefaultValue"
                       rootPath="default_value"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[
        Leaf.onReady(function () {
            //debugger;
            var ds = $('rpt_rental_income_rate_query_ds');
            var record = ds.getCurrentRecord();
            var firstDate = new Date();
            firstDate.setDate(1);
            record.set('due_date_from',firstDate);
            var lastDate = new Date();
            lastDate.setMonth(firstDate.getMonth() + 1);
            lastDate.setDate(1);
            record.set('due_date_to',new Date(lastDate.getTime()-1000*60*60*24));
            rpt_rental_income_rate_query();

        });

        function rpt_rental_income_rate_query() {
            $('con_rental_income_rate_ds').query();
        }

        function rpt_rental_income_rate_reset() {
            $('rpt_rental_income_rate_query_ds').reset();
            $('con_rental_income_rate_ds').query();
        }

        function rpt_rental_income_rate_import() {
            new Leaf.Window({
                id: 'vat_receipt_winid',
                url: '${/request/@context_path}/modules/RPT/RPT650/rpt_rental_income_rate.lview',
                params: {
                    winid: 'rpt_rental_income_rate_winid'
                },
                title: '租金回收导入明细',
                fullScreen: true
            }).on('close', function () {
                rpt_rental_income_rate_query();
            });
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="currency_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/hls_currency/query" queryMethod="GET">
                <a:fields>
                    <a:field name="currency_code"/>
                    <a:field name="currency_name"/>
                    <a:field name="currencySymbol"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="fnd_cf_item_options_ds" queryUrl="${/request/@context_path}/fnd/HlsCfItem/query"
                       autoQuery="true" pageSize="999">
            </a:dataSet>
            <a:dataSet id="rpt_rental_income_rate_query_ds">
                <a:fields>
                    <a:field name="bp_name" autoComplete="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/hls/bp/queryBpMasterLov?~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="客户名称">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="business_unit" autoComplete="true" lovGridHeight="350"
                             lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/csh/unit/query/lov~com.hand.hls.layout.dto.LovCshUnitDto"
                             lovWidth="850"
                             title="部门" prompt="部门">
                        <a:mapping>
                            <a:map from="unit_id" to="unit_id"/>
                            <a:map from="unit_code" to="unit_code"/>
                            <a:map from="unit_name" to="business_unit"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="currency_name" options="currency_ds"
                             displayField="currency_name" valueField="currency_code" returnField="currency_code"/>
                    <a:field name="cashflow_item_desc" options="fnd_cf_item_options_ds" displayField="description"
                             valueField="cf_item" returnField="cf_item"/>
                    <a:field name="due_date_from" required="true"/>
                    <a:field name="due_date_to" required="true"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="con_rental_income_rate_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/rpt/rental/income/rate/queryDetail"
                       queryDataSet="rpt_rental_income_rate_query_ds" selectable="true">
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="rpt_rental_income_rate_query" text="HAP.QUERY"/>
                <a:gridButton click="rpt_rental_income_rate_reset" text="HAP.RESET"/>
              <!--  <a:gridButton click="rpt_rental_income_rate_export" text="HAP.EXPORT"/>-->
                <a:gridButton click="rpt_rental_income_rate_import" text="导入结果增删"/>
            </a:screenTopToolbar>
            <a:form title="报表区间" style="width:100%">
                <a:box column="4" labelWidth="150">
                <a:datePicker name="due_date_from" bindTarget="rpt_rental_income_rate_query_ds" prompt="报表查询区间从"
                              width="165">
                    <a:events>
                        <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                    </a:events>
                </a:datePicker>
                <a:datePicker name="due_date_to" bindTarget="rpt_rental_income_rate_query_ds" prompt="报表查询区间到"
                              width="165">
                <a:events>
                    <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                </a:events>
                </a:datePicker>
                </a:box>
            </a:form>
            <a:form title="查询条件" style="width:100%">
                <a:box column="4" labelWidth="150">
                    <a:lov name="bp_name" bindTarget="rpt_rental_income_rate_query_ds" prompt="客户名称" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:lov>
                    <a:comboBox name="currency_name" bindTarget="rpt_rental_income_rate_query_ds"  prompt="币种"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:comboBox>
                    <a:lov name="business_unit" bindTarget="rpt_rental_income_rate_query_ds" prompt="业务部门" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:lov>
                    <a:textField name="contract_number" bindTarget="rpt_rental_income_rate_query_ds" prompt="支付表编号" width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:textField>
                </a:box>
                <a:box column="4" labelWidth="150">
                    <a:numberField name="due_amount_from" bindTarget="rpt_rental_income_rate_query_ds"  prompt="应收金额从"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                    <a:numberField name="due_amount_to" bindTarget="rpt_rental_income_rate_query_ds"  prompt="应收金额到"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                    <a:numberField name="times" bindTarget="rpt_rental_income_rate_query_ds"  prompt="期数"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                    <a:comboBox name="cashflow_item_desc" bindTarget="rpt_rental_income_rate_query_ds" prompt="现金流项目"
                                width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:comboBox>
                </a:box>
                <a:box column="4" labelWidth="150">

                    <a:numberField name="outstanding_amount_from" bindTarget="rpt_rental_income_rate_query_ds"  prompt="未收金额从"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                    <a:numberField name="outstanding_amount_to" bindTarget="rpt_rental_income_rate_query_ds"  prompt="未收金额到"  width="165">
                        <a:events>
                            <a:event name="enterdown" handler="rpt_rental_income_rate_query"/>
                        </a:events>
                    </a:numberField>
                </a:box>
            </a:form>
            <a:grid id="con_rental_income_rate_ds_grid" bindTarget="con_rental_income_rate_ds" marginHeight="130" marginWidth="30"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="bp_name" width="200" prompt="客户名称" align="center"/>
                    <a:column name="contract_number" width="130" prompt="支付表编号" align="left"/>
                    <a:column name="times" width="130" prompt="期数" align="right" />
                    <a:column name="cashflow_item_desc" width="300" prompt="现金流项目" align="center"/>
                    <a:column name="due_amount" width="260" prompt="应收金额" align="center" renderer="Leaf.formatMoney"/>
                    <a:column name="received_amount" width="260" prompt="已收收金额" align="center" renderer="Leaf.formatMoney"/>
                    <a:column name="outstanding_amount" width="260" prompt="未收金额" align="center" renderer="Leaf.formatMoney"/>
                    <a:column name="due_date" width="260" prompt="应收日期" align="center" renderer="Leaf.formatDate"/>
                    <a:column name="last_received_date" width="260" prompt="最后支付日" align="center" renderer="Leaf.formatDate"/>
                    <a:column name="currency_name" width="300" prompt="币种" align="center"/>
                    <a:column name="business_unit" width="260" prompt="业务部门" align="center"/>
                    <a:column name="sources_flag_n" width="260" prompt="数据来源" align="center"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
