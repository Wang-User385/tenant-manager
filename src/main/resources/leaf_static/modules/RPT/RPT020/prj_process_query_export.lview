<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="PRJ419_project_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify.lview"/>
        <script><![CDATA[
        var page = null ;
        var pageSize  = null;
        var index = null;

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'project_number' && value) {
                return '<a href="javascript:open_project_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }else if(name == 'process_detail'){
                return '<a href="javascript:open_process_detail_win(\'' + record.get('project_id') + '\',\'' + record.ds.id + '\')">明细</a>';
            }
            return value;
        };

        //项目维护
        function open_project_modify_win(ds_id, record_id) {
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '项目明细';
            param['function_code'] = 'PRJ419F2';
            param['winid'] = 'project_modify_winid';
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'PRJ419_project_modify_id', ds_id, 'PRJ419');
        }
        //查询时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project')
            if (ds === $(ds_id)){
                //详情页返回 需要定位到之前的行
                if(pageSize != null && page!= null && index != null) {
                    $(ds_id).pagesize = pageSize;
                    $(ds_id).goPage(page);
                    $(ds_id).locate(index);
                    page = null;
                    pageSize = null;
                    index = null ;
                }
            }
        };

        function open_process_detail_win (project_id,ds_id){
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var win = new Leaf.Window({
                id: 'mywfl002_process_history_win_id',
                url: "${/request/@context_path}/modules/MYWFL/MYWFL002/process_history_document.lview",
                params: {
                    winid: 'mywfl002_process_history_document_win_id',
                    project_id: project_id
                },
                title: '历史流程',
                fullScreen: true
            });
            win.on('close', function () {
                $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project')).query();
            });
        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
