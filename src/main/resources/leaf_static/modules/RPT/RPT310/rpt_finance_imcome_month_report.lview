<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugenen.Song
    $Date: 2020-05-15
    $Description:收入确认分摊（月）
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>

        <script type="text/javascript"><![CDATA[
        function report_query() {
            $('report_result_ds').query();
        }

        function report_reset() {
            $('report_query_ds').reset();
        }

        Leaf.onReady(function () {
            //debugger;
            var ds = $('report_query_ds');
            var record = ds.getCurrentRecord();
            var firstDate = new Date();

            var year = firstDate.getFullYear();
            var month = firstDate.getMonth() + 1;
            if (month < 10) {
                month = "0" + month;
            }

            var currentPeriod = year + "-" + month ;
            record.set('period_name_from', currentPeriod);
            record.set('period_name_to', currentPeriod);

        });


        function sum_foot(data, name) {

            return colum_caculateTotal(data, name);

        }

        function colum_caculateTotal(data, name) {
            var total = 0;
            var length = data.length;
            var value = 0;
            for (var i = 0;i < length;i++) {
                if (Ext.isEmpty(data[i].get(name))) {
                    value = 0;
                } else {
                    value = data[i].get(name);
                }
                total = plus(total, value);
            }
            return '<font color=red>' + Leaf.formatMoney(total) + '</font>';
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="report_query_ds">
                <a:fields>
                    <a:field name="period_name" autoComplete="true"  lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间" prompt="期间">
                        <a:mapping>
                            <a:map from="period_name" to="period_name"/>
                        </a:mapping>
                    </a:field>

                    <a:field name="period_name_from" autoComplete="true" required="true"  lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间从" prompt="期间从">
                        <a:mapping>
                            <a:map from="period_name" to="period_name_from"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="period_name_to" autoComplete="true"  required="true"   lovGridHeight="450"
                             lovHeight="650"
                             lovLabelWidth="90"
                             lovService="/gld/period/name/lov~hls.layout.dto.LovPeriodDto"
                             lovWidth="850"
                             title="期间到" prompt="期间到">
                        <a:mapping>
                            <a:map from="period_name" to="period_name_to"/>
                        </a:mapping>
                    </a:field>


                </a:fields>

            </a:dataSet>

            <a:dataSet id="report_result_ds" autoQuery="false"
                       queryUrl="${/request/@context_path}/gld/finance/income/report"
                       queryDataSet="report_query_ds" selectable="true">
                <a:fields>
                    <a:field name="amortization_date" datatype="date"/>
                    <a:field name="post_flag10" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="post_flag1" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="post_flag3" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="post_flag65" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="post_flag501" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                    <a:field name="post_flag69" checkedValue="Y" defaultValue="Y" uncheckedValue="N"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="report_query" text="查询"/>
                <a:gridButton click="report_reset" text="重置"/>
            </a:screenTopToolbar>
            <a:form column="4" labelWidth="150" marginWidth="50">
<!--                <a:lov name="period_name" bindTarget="report_query_ds" prompt="期间"/>-->
                <a:lov name="period_name_from" bindTarget="report_query_ds" prompt="期间从"/>
                <a:lov name="period_name_to" bindTarget="report_query_ds" prompt="期间到"/>

                <a:textField name="contract_name" bindTarget="report_query_ds" prompt="合同名称"/>
                <a:textField name="contract_number" bindTarget="report_query_ds" prompt="合同编号"/>
                <a:textField name="payment_number" bindTarget="report_query_ds" prompt="支付表编号"/>
                <a:textField name="bp_name" bindTarget="report_query_ds" prompt="客户名称"/>
            </a:form>
            <a:grid bindTarget="report_result_ds" marginHeight="150"
                    marginWidth="50"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="contract_name" prompt="合同名称" width="200"/>
                    <a:column name="contract_number" prompt="合同编号" width="120"/>
                    <a:column name="payment_number" prompt="支付表编号" width="120"/>
                    <a:column name="bp_name" prompt="客户名称" width="180"/>
                    <a:column name="period_name" prompt="期间" align="center" width="80"/>
                    <a:column prompt="租前息收入">
                        <a:column name="net_cf_item10" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item10" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item10" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag10" prompt="是否确认" align="right" width="120"/>

                    </a:column>
                    <a:column prompt="利息收入">
                        <a:column name="net_cf_item1" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item1" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item1" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag1" prompt="是否确认" align="right" width="120"/>

                    </a:column>
                    <a:column prompt="手续费">
                        <a:column name="net_cf_item3" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item3" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item3" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag3" prompt="是否确认" align="right" width="120"/>

                    </a:column>
                    <a:column prompt="咨询费">
                        <a:column name="net_cf_item65" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item65" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item65" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag65" prompt="是否确认" align="right" width="120"/>

                    </a:column>

                    <a:column prompt="保证金利息">
                        <a:column name="net_cf_item501" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item501" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item501" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag501" prompt="是否确认" align="right" width="120"/>

                    </a:column>


                    <a:column prompt="其他费用">
                        <a:column name="net_cf_item69" prompt="不含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="vat_cf_item69" prompt="税金" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="due_cf_item69" prompt="含税金额" align="right" renderer="Leaf.formatMoney"
                                  width="120" footerRenderer="sum_foot"/>
                        <a:column name="post_flag69" prompt="是否确认" align="right" width="120"/>

                    </a:column>

                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>

