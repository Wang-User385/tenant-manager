<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:view>
        <a:link id="prj_rpt001_credit_deail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_CHANCE/PRJ003/prj_credit_chance_detail.lview"/>
        <a:link id="prj_rpt001_project_deail_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_QUOTA/PRJ314/prj_project_modify.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            if (name == 'credit_bp_name') {
                if(value != null && value !='undefined'&& value !=''){
                    return '<a href="javascript:open_credit_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
                }else{
                    return null;
                }
            }
            if (name == 'project_number') {
                return '<a href="javascript:open_project_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + value + '</a>';
            }
        };

        function open_credit_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var type = 'QUERY';
            param['url_title'] = '授信明细';
            param['function_code'] = 'PRJ003F1_CHANGE_BP';
            param['function_usage'] = type;
            param['winid'] = 'prj_rpt_credit_detail_winid';
            var link_id = 'prj_rpt001_credit_deail_link_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ_RPT001');
        }

        function open_project_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var type = 'QUERY';
            param['url_title'] = '额度占用明细';
            param['function_code'] = 'PRJ314F1';
            param['function_usage'] = type;
            param['winid'] = 'prj_rpt_project_detail_winid';
            var link_id = 'prj_rpt001_project_deail_link_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'PRJ_RPT001');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
