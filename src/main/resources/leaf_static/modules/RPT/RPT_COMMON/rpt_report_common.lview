<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: sys
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="rpt_common_template_link" url="${/request/@context_path}/rpt/report/template/query"/>
        <a:link id="con_contract_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="cont301f10_contract_change_info_link" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/cont301f10_contract_change_info.lview"/>
        <a:link id="con_contract_send_sap_link_id" url="${/request/@context_path}/con/contract/send/sap"/>
        <a:link id="auto_finance_contract_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/con_contract_detail.lview"/>
        <a:link id="history_asset_link_id" url="${/request/@context_path}/modules/AST/AST_MANAGE/AST020/hls_asset_class_contract_history_report.lview"/>
        <a:link id="prj_user_info_query_link_id" url="${/request/@context_path}/prj/user/info/query"/>
        <a:link id="report_auth_query_link_id" url="${/request/@context_path}/report/auth/query"/>
        <a:link id="credit_service_query_link" url="${/request/@context_path}/credit/service/query"/>
        <a:link id="credit_service_get_token_link" url="${/request/@context_path}/credit/service/get/token"/>
        <a:link id="ol_package_contract_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/ol_con_contract_detail.lview"/>
        <script><![CDATA[
        var page = null ;
        var pageSize  = null;
        var index = null;
        Leaf.onReady(function(){
            var data = {
                function_code:'${/parameter/@function_code}'
            };
            Leaf.request({
                url: $('rpt_common_template_link').getUrl(),
                para: data,
                success: function(res) {
                    if(res.success){
                        jQuery(".screenTitle").text(res.result.record[0].function_name);
                    }
                }});

            //查询当前用户决策报告查看权限
            // Leaf.request({
            //     url: $('report_auth_query_link_id').getUrl(),
            //     scope: this,
            //     para: {userId: '${/session/@user_id}'},
            //     success: function (res) {
            //         if (res.success && res.result.totalCount > 0) {
            //             if(res.result.record[0].report_auth_flag != 'Y'){
            //                 jQuery('#${/parameter/@layout_code}_user_button4').hide();
            //             }
            //         }else{
            //             jQuery('#${/parameter/@layout_code}_user_button4').hide();
            //         }
            //     },
            //     failure: function () {
            //         jQuery('#${/parameter/@layout_code}_user_button4').hide();
            //     },
            //     error: function () {
            //         jQuery('#${/parameter/@layout_code}_user_button4').hide();
            //     },
            //     scope: this
            // });
        });


        function open_contract_detail_win(record_id, ds_id) {
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var param = $(ds_id).findById(record_id).data;
            Leaf.Masker.mask(Ext.getBody(), '执行中。。')
            Leaf.request({
                url: "${/request/@context_path}/contract/queryContractId?contractNumber=" + param.contract_number,
                success: function (args) {
                    Leaf.Masker.unmask(Ext.getBody());
                    if (args.success) {
                        param['contract_id'] = args.result.record[0].contract_id;
                        param['lease_channel'] = args.result.record[0].lease_channel;
                        param['url_title'] = '合同明细维护';
                        param['function_code'] = 'CONT301F1';
                        param['function_usage'] = 'QUERY';
                        param['winid'] = 'con_contract_detail_winid';
                        var link_id = 'con_contract_detail_id';
                        if(param.lease_channel == '20'){
                            param['function_code'] = 'CONT301F10';
                            link_id = 'auto_finance_contract_detail_link_id';
                        } else if(param.lease_channel == '40'){
                            param['function_code'] = 'CONT320';
                            link_id = 'ol_package_contract_detail_link_id';
                        }
                        //查询当前用户信息
                        Leaf.request({
                            url: $('prj_user_info_query_link_id').getUrl(),
                            scope: this,
                            para: {userId: '${/session/@user_id}'},
                            success: function (res) {
                                if (res.success && res.result.totalCount > 0) {
                                    if(res.result.record[0].bp_category == 'DEALER' || res.result.record[0].bp_category == 'DISTRIBUTOR'){
                                        param['quote_hide_flag'] = 'Y';
                                        hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
                                    }else{
                                        hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
                                    }
                                }else{
                                    hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
                                }
                            },
                            failure: function () {
                                hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
                            },
                            error: function () {
                                hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
                            },
                            scope: this
                        });
                    }
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }


        function open_history_asset_win(record_id, ds_id){
            pageSize = $(ds_id).pagesize;
            page = $(ds_id).currentPage;
            index = $(ds_id).currentIndex;
            var param = $(ds_id).findById(record_id).data;
            Leaf.Masker.mask(Ext.getBody(), '执行中。。')
            Leaf.request({
                url: "${/request/@context_path}/contract/queryContractId?contractNumber=" + param.contract_number,
                success: function (args) {
                    Leaf.Masker.unmask(Ext.getBody());
                    if (args.success) {
                        param['contract_id'] = args.result.record[0].contract_id;
                        param['url_title'] = '资产分类历史记录';
                        param['function_code'] = 'RPT008F1';
                        param['function_usage'] = 'QUERY';
                        param['winid'] = 'history_asset_winId';
                        hls_doc_get_layout_code(param, 'history_asset_link_id', ds_id, 'RPT008');
                    }
                },
                failure: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        //查询时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            // var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var common_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'leaf_report');
            if (/*ds === $(ds_id)||*/ds === $(common_ds_id)){
                //详情页返回 需要定位到之前的行
                if(pageSize != null && page!= null && index != null) {
                    $(common_ds_id).pagesize = pageSize;
                    $(common_ds_id).goPage(page);
                    $(common_ds_id).locate(index);
                    page = null;
                    pageSize = null;
                    index = null ;
                }
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                var link_function = 'open_contract_detail_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }else  if(name == 'history_level'){
                var link_function = 'open_history_asset_win';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '历史分类' + '</a>';
            }
        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'leaf_report'),
                select_datas = $(ds_id).getSelected();
            if(select_datas.length === 0){
                Leaf.showMessage('提示！', '至少选择一行!');
                return;
            }
            var ids = [];
            for(var i = 0; i < select_datas.length; i++){
                if(select_datas[i].get('contract_status') !== 'INCEPT'){
                    Leaf.showMessage('提示！', '只有起租的合同才可以打印支付表!');
                    return;
                }
                ids.push(select_datas[i].get('contract_id'));
            }
            new Leaf.Window({
                id: 'con_contract_query_due_plan',
                url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_due_plan.lview',
                params: {
                    contract_ids_str: ids.join(','),
                    winid: 'con_contract_query_due_plan'
                },
                title: "请选择支付表格式",
                width: 330,
                height: 150
            });
            // window.location.href = '${/request/@context_path}/con/contract/payment/excel?contractIdsStr='+ids.join(',');
        };

        var queryCount = 0;
        //决策报告查看
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'leaf_report');
            var records = $(ds_id).getSelected();
            if(records.length == 0){
                Leaf.showMessage('提示！', '请选择一个合同进行查询!');
                return;
            }else if(records.length > 1){
                Leaf.showMessage('提示！', '报告仅支持单选进行查询!');
                return;
            }
            var record = records[0];
            var project_id = record.get('project_id');
            $(ds_id).query();
            if(record.get('report_status') == 'SUCCESS'){
                queryCount = 0;
                Leaf.request({
                    url: $('credit_service_get_token_link').getUrl(),
                    scope: this,
                    para: {
                        projectId: project_id,
                        reportLink:record.get('report_link')
                    },
                    success: function (res) {
                        window.open(res.error.message);
                    },
                    failure: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    scope: this,
                    sync:false
                });
            }else if(record.get('report_status') == 'QUERYING'){
                //调用决策流报告生成
                Leaf.request({
                    url: $('credit_service_query_link').getUrl(),
                    scope: this,
                    para: {
                        projectId: project_id,
                        wflFlag:'N'
                    },
                    success: function (res) {
                        queryCount = queryCount + 1;
                        if(queryCount >= 3){
                            queryCount = 0;
                        }else{
                            window['${/parameter/@layout_code}_user_button4_layout_dynamic_click']();
                        }
                    },
                    failure: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    error: function () {
                        Leaf.showMessage("提示", "报告查询失败，请联系系统管理员！", null);
                    },
                    scope: this,
                    sync:false
                });
            }else if(record.get('report_status') == 'FAILURE'){
                Leaf.showMessage("提示", "报告获取失败，请联系系统管理员！", null);
            }else{
                Leaf.showMessage("提示", "该合同下暂无报告!", null);
            }
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>