<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Date: 2020-07-29
    $Revision: 1.0
    $Purpose: 月日均报表
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" dynamiccreateenabled="true" customizationEnabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[


            //更新时调用
            window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
                if(ds.id == '${/parameter/@layout_code}_F_FORM__ds'){
                    if(name == 'month_day'){
                        $('${/parameter/@layout_code}_G_GRID_con_contract_ds').setQueryParameter('month_day',value);
                    }
                }
            };

            //查询时调用(grid,table,gridBox)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
                if(ds.id == '${/parameter/@layout_code}_G_GRID_con_contract_ds'){
                    if(qpara['month_day'] == 'undefined' || qpara['month_day'] == null || qpara['month_day'] == ''){
                        qpara['month_day'] = new Date();
                    }
                }
            };

            Leaf.onReady(function(){
                var form_ds_id = '${/parameter/@layout_code}_F_FORM__ds';
                var form_record = $(form_ds_id).getCurrentRecord();
                if(form_record == 'undefined' || form_record == null){
                    $(form_ds_id).create();
                    form_record = $(form_ds_id).getCurrentRecord();
                }
                if(form_record.get('month_day') == 'undefined' || form_record.get('month_day') == null){
                    form_record.set('month_day',new Date());
                }
            })




        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
