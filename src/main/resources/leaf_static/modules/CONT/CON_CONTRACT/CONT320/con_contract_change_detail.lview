        }

        window['deposit_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '保证金方案详情';
            param['function_code'] = 'HLS300F10';
            param['function_usage'] = 'MODIFY';
            param['execute_type'] = execute_type;
            param['winid'] = '${/parameter/@layout_code}_deposit_detail_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', ds_id, '${/parameter/@function_code}');
        }


        window['duration_calc_detail'] = function (record_id, ds_id) {
            if ('${/parameter/@function_usage}' != 'QUERY') {
                var hd_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
                var hd_record = $(hd_id).getCurrentRecord();
                if (hd_record.dirty) {
                    Leaf.showInfoMessage("提示", "请先保存");
                    return;
                }
            }

            var param = $(ds_id).findById(record_id).data;
            if (execute_type == 'ET') {
                param['url_title'] = '提前结清测算';
                param['function_code'] = 'HLS300F11';
            } else if (execute_type == 'PREPAYMENT') {
                param['url_title'] = '提前还款测算';
                param['function_code'] = 'HLS300F13';
            } else if (execute_type == 'FINANCIAL_TERMS') {
                param['url_title'] = '业务变更支付表测算';
                param['function_code'] = 'HLS400F7';
            }

            param['function_usage'] = 'MODIFY';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                param['function_usage'] = 'QUERY';
            }
            param['execute_type'] = execute_type;
            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_ET_INFO');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_PREPAYMENT_INFO');
            var change_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_COMPARE_INFO');
            param[et_ds_id.replace('_ds', '')] = undefined;
            param[prepayment_ds_id.replace('_ds', '')] = undefined;
            param[change_ds_id.replace('_ds', '')] = undefined;
            param['winid'] = '${/parameter/@layout_code}_duration_calc_detail_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', ds_id, '${/parameter/@function_code}');
        }


        //提交按钮
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            //提交前先保存
            window['${/parameter/@layout_code}_custom_save_layout_dynamic_click'](submit_function);
        }


        function submit_function() {
// debugger;
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CONTRACT_INFO');


            var et_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');


            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
            var lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
            var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
            var item_list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var item_list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');
            var contract_text_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_CONTRACT_TEXT');
            var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CHANGE_INFO');
            var bp_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_TRX');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
            var lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var file_end_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');
            var change_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_COMPARE_INFO');

            var record = $(duration_hd_ds_id).getCurrentRecord();
            var saveData = [];
            saveData.push(record.data);


            saveData[0][duration_hd_ds_id.replace('_ds', '')] = undefined;

            saveData[0][contract_ds_id.replace('_ds', '')] = undefined;
            saveData[0][et_info_ds_id.replace('_ds', '')] = undefined;
            saveData[0][prepayment_info_ds_id.replace('_ds', '')] = undefined;

            saveData[0][lease_item_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_list_ds_id.replace('_ds', '')] = undefined;

            saveData[0][lease_item_1_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_2_ds_id.replace('_ds', '')] = undefined;


            saveData[0][item_list_1_ds_id.replace('_ds', '')] = undefined;
            saveData[0][item_list_2_ds_id.replace('_ds', '')] = undefined;
            saveData[0][attachment_ds_id.replace('_ds', '')] = undefined;
            saveData[0][contract_text_ds_id.replace('_ds', '')] = undefined;

            saveData[0][change_info_ds_id.replace('_ds', '')] = undefined;
            saveData[0][bp_info_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_ds_id.replace('_ds', '')] = undefined;
            saveData[0][lease_item_list_ds_id.replace('_ds', '')] = undefined;
            saveData[0][file_end_ds_id.replace('_ds', '')] = undefined;
            saveData[0][change_ds_id.replace('_ds', '')] = undefined;

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/hls/duration/execute/submit",
                para: saveData,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                        $('${/parameter/@winid}').close();
                    });
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "提交失败!", null);
                },
                scope: this
            });

        }
        //退出按钮
        window['${/parameter/@layout_code}_user_button10_layout_dynamic_click'] = function () {
            debugger
            top.refreshFrame()//回到头页面并且刷新页面
        }

        //保存按钮
        window['${/parameter/@layout_code}_custom_save_layout_dynamic_click'] = function (nextStep) {
// debugger;
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var et_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');

            var et_compare_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_ET_INFO');
            var prepayment_compare_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_PREPAYMENT_INFO');


            var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
            var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');

            var item_list_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_1');
            var item_list_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST_2');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');
            var contract_text_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_CONTRACT_TEXT');

            var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CHANGE_INFO');
            var bp_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_TRX');

            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
            var lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');
            var file_end_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');
            var duration_compare_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_compare', 'F_COMPARE_INFO');

            var validate_check = true;
            //必填校验
            if (duration_hd_ds_id) {
                if (!$(duration_hd_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (item_list_1_ds_id) {
                if (!$(item_list_1_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (item_list_2_ds_id) {
                if (!$(item_list_2_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (attachment_ds_id) {
                if (!$(attachment_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (contract_text_ds_id) {
                if (!$(contract_text_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (change_info_ds_id) {
                if (!$(change_info_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (bp_info_ds_id) {
                if (!$(bp_info_ds_id).validate()) {
                    validate_check = false;
                }
            }
            if (validate_check) {
                //基本信息
                $(duration_hd_ds_id).getCurrentRecord().set('execute_type', execute_type);
                $(duration_hd_ds_id).getCurrentRecord().set('execute_req_flag', 'Y');
                var saveData = $(duration_hd_ds_id).getCurrentRecord().data;

                //保证金退还 && 保证金利息 && 债权
                saveData['hls_duration_ln_list'] = [];
                saveData['hls_duration_deposit_list'] = [];
                saveData['hls_duration_attachment_list'] = [];
                if (attachment_ds_id) {
                    var attachment_records = $(attachment_ds_id).getAll();
                    attachment_records.forEach(function (record) {
                        saveData['hls_duration_attachment_list'].push(record.data);
                    });
                }

                if (execute_type == 'ET') {
                    var et_info_records = $(et_info_ds_id).getAll();
                    et_info_records.forEach(function (record) {
                        record.set('source_type', 'ET');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }
                if (execute_type == 'PREPAYMENT') {
                    var prepayment_info_records = $(prepayment_info_ds_id).getAll();
                    prepayment_info_records.forEach(function (record) {
                        record.set('source_type', 'PREPAYMENT');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }

                if (execute_type == 'FINANCIAL_TERMS') {
                    var change_info_records = $(change_info_ds_id).getAll();
                    change_info_records.forEach(function (record) {
                        record.set('source_type', 'FINANCIAL_TERMS');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });

                    var bp_info_records = $(bp_info_ds_id).getAll();
                    bp_info_records.forEach(function (record) {
                        record.set('source_type', 'BP_INFO');
                        saveData['hls_duration_ln_list'].push(record.data);
                    });
                }

                if (execute_type == 'TERMINATE' || execute_type == 'ET' || execute_type == 'PREPAYMENT' || execute_type == 'FINANCIAL_TERMS') {

                    //解押 回购
                    // var item_list_1_records = $(item_list_1_ds_id).getAll();
                    // var item_list_2_records = $(item_list_2_ds_id).getAll();
                    //
                    // item_list_1_records.forEach(function (record) {
                    //     record.set('source_type', 'RELEASE');
                    //     saveData['hls_duration_ln_list'].push(record.data);
                    // });
                    // item_list_2_records.forEach(function (record) {
                    //     record.set('source_type', 'REPURCHASE');
                    //     saveData['hls_duration_ln_list'].push(record.data);
                    // });

                    //附件
                    var attachment_records = $(attachment_ds_id).getAll();
                    attachment_records.forEach(function (record) {
                        record.set('source_type', execute_type);
                        saveData['hls_duration_ln_list'].push(record.data);
                    });

                    for (var i = 0; i < saveData['hls_duration_ln_list'].length; i++) {
                        if (saveData['hls_duration_ln_list'][i]) {
                            // saveData['hls_duration_ln_list'][i][et_info_ds_id.replace('_ds', '')] = undefined;
                            // saveData['hls_duration_ln_list'][i][prepayment_info_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_ln_list'][i][change_info_ds_id.replace('_ds', '')] = undefined;
                            // saveData['hls_duration_ln_list'][i][et_compare_info_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_ln_list'][i][attachment_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_ln_list'][i][bp_info_ds_id.replace('_ds', '')] = undefined;
                            saveData['hls_duration_ln_list'][i][duration_compare_ds_id.replace('_ds', '')] = undefined;
                            // saveData['hls_duration_ln_list'][i][item_list_1_ds_id.replace('_ds', '')] = undefined;
                            // saveData['hls_duration_ln_list'][i][item_list_2_ds_id.replace('_ds', '')] = undefined;
                        }
                    }
                    for (var i = 0; i < saveData['hls_duration_attachment_list'].length; i++) {
                        if (saveData['hls_duration_attachment_list'][i]) {
                            saveData['hls_duration_attachment_list'][i][attachment_ds_id.replace('_ds', '')] = undefined;
                        }
                    }
                }

                //把其他属性去掉，避免栈溢出
                saveData[duration_hd_ds_id.replace('_ds', '')] = undefined;
                //提前结清
                // saveData[et_info_ds_id.replace('_ds', '')] = undefined;
                // saveData[prepayment_info_ds_id.replace('_ds', '')] = undefined;
                saveData[lease_item_1_ds_id.replace('_ds', '')] = undefined;
                saveData[lease_item_2_ds_id.replace('_ds', '')] = undefined;

                // saveData[item_list_1_ds_id.replace('_ds', '')] = undefined;
                // saveData[item_list_2_ds_id.replace('_ds', '')] = undefined;
                saveData[attachment_ds_id.replace('_ds', '')] = undefined;
                // saveData[contract_text_ds_id.replace('_ds', '')] = undefined;

                saveData[change_info_ds_id.replace('_ds', '')] = undefined;
                saveData[bp_info_ds_id.replace('_ds', '')] = undefined;
                // saveData[lease_item_ds_id.replace('_ds', '')] = undefined;
                // saveData[lease_item_list_ds_id.replace('_ds', '')] = undefined;
                saveData[file_end_ds_id.replace('_ds', '')] = undefined;


                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/hls/duration/hd/save',
                    para: saveData,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        hd_id = res.result.record[0].hd_id;
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        if (typeof (nextStep) == 'function') {
                            nextStep();
                        } else {
                            all_query();
                        }
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        };

        function all_query() {
            //保存后 form 框需要 刷新将 后台保存的值 返回到前台
            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');

            if (duration_hd_ds_id) {
                $(duration_hd_ds_id).setQueryParameter('hd_id', hd_id);
                $(duration_hd_ds_id).query();
            }

        }

