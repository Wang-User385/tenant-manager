        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {


            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_ET_INFO');
            var prepayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_PREPAYMENT_INFO');
            var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_CHANGE_INFO');
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');
            var contract_text_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_CONTRACT_TEXT');

            var lease_item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_1');
            var lease_item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');

            var trx_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_TRX');


            if (ds.id == et_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('source_type', 'ET');
            }
            if (ds.id == prepayment_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('source_type', 'PREPAYMENT');
            }
            if (ds.id == change_info_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('source_type', 'FINANCIAL_TERMS');
            }
            if (ds.id == attachment_ds_id) {
                record.set('attachment_category', execute_type);

                if ('${/parameter/@wfl_flag}' == 'Y') {
                    record.getField('document_name').setReadOnly(false);
                    record.getField('document_name').setRequired(true);
                    record.getField('description').setReadOnly(false);
                }

            }
            if (ds.id == lease_item_1_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('source_type', 'PLEDGOR_MORTGAGORS');
            }
            if (ds.id == lease_item_2_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('source_type', 'LEASE_ITEMS');
            }
            if (ds.id == trx_ds_id) {
                record.set('source_type', 'BP_INFO');
            }
            //补充协议
            if (contract_text_ds_id == ds.id) {
                record.set('attachment_category', 'TEXT');
            }
            if (ds.id == '${/parameter/@layout_code}_G_FILE_END_fct_project_attachment_ds') {
                record.set('upload_person', '${/session/@user_id}');
                record.set('upload_date', new Date());
                record.set('project_id', '${/parameter/@project_id}');
            }

            var attach_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTACHMENT');
            if (ds.id === attach_ds_id1) {
                // debugger;
                record.set('project_id', '${/parameter/@project_id}');
                record.set('project_attachment_category', 'CHANGE_REQ_INFO');

            }
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_attachment', 'G_ATTACHMENT_INFO');
            if (ds.id == attachment_ds_id) {
                if ('${/parameter/@wfl_flag}' == 'Y') {
                    if (record) {
                        record.getField('document_name').setReadOnly(false);
                        record.getField('document_name').setRequired(false);
                        record.getField('description').setReadOnly(false);
                    }
                }
            }
        };


        $L.onReady(function () {
            //解押&&回购 信息
            var item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
            if (item_ds_id) {
                $(item_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_ds_id).query();
            }
            //正常结清&&提前结清&&提前还款 信息
            var item_1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
            if (item_1_ds_id) {
                $(item_1_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_1_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_1_ds_id).query();
            }

            var item_2_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM_2');
            if (item_2_ds_id) {
                $(item_2_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
                $(item_2_ds_id).setQueryParameter('hd_id', '${/parameter/@hd_id}');
                $(item_2_ds_id).query();
            }

        });

        //租赁物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_2_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_detail_new_winid';
            param['function_usage'] = 'CREATE';
            var link_id = 'lease_info_detail_id';
            hls_doc_get_layout_code(param, link_id, null, 'LEASE001');
        };

        //抵质押物创建
        window['${/parameter/@layout_code}_G_LEASE_ITEM_1_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';
            param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
            hls_doc_get_layout_code(param, 'sw001_pledges_lease', null, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
        };

        window['lease_item_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'lease_info_detail_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        window['pledge_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.lease_item_id;
            var type = 'MODIFY';
            param['url_title'] = '抵质押物详细';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'sw001_pledges_lease';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        };

        //报价计算入口
        window['${/parameter/@layout_code}_quotation_calc1_layout_dynamic_click'] = function () {
            if (!$('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').validate()) {
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = url + '&readOnly=Y';
                //带入数据后打开excel
                var win = new Leaf.Window({
                    id: 'hls900_open_price_winid',
                    url: url,
                    title: 'excel测算',
                    fullScreen: true
                });
                return;
            }
            debugger;
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                Leaf.request({
                    url: $('con301_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                    type: "GET",
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '计算成功',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        win.on('close', function () {
                            $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
                            $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
                            $('${/parameter/@layout_code}_G_CASHFLOW_BEFORE_prj_quotation_cashflow_ds').query();
                        });
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }, 'N');
        }
        //提交审批
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                $L.Masker.mask(document.body, "提交中..");
                Leaf.request({
                    url: "${/request/@context_path}/con/contract/change/submit/wfl",
                    para: {
                        project_id : '${/parameter/@project_id}',
                        change_req_id : '${/parameter/@change_req_id}'
                    },
                    success: function (res) {
                        $L.Masker.unmask(document.body);
                        $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                            $('${/parameter/@winid}').close();
                            if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                        });
                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "提交失败!", null);
                    },
                    scope: this
                });
            });
        };

        //取消变更
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/con/contract/change/cancel",
                para: {
                    hd_id: '${/parameter/@hd_id}',
                    change_req_id : '${/parameter/@change_req_id}'
                },
                success: function (res) {
                    Leaf.showMessage("提示", "取消变更成功", null);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $('${/parameter/@ds_id}').query();
                    $('${/parameter/@winid}').close();
                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true,
                scope: this
            });
        };

        //还款计划变更报价计算
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            debugger;
            // 判断还款方案,等额本息与等额本金调用后台计算, 不规则打开报价excel手动填写还款计划
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            //GECALCULATOR_PMT_YH 等额租金, GECALCULATOR_LP_YH 等额本金, GECALCULATOR_CASUAL_YH 不规则租金
            if(price_list == 'GECALCULATOR_CASUAL_YH'){

                var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
                if ('${/parameter/@function_usage}' == 'QUERY') {
                    url = url + '&readOnly=Y';
                    //带入数据后打开excel
                    var win = new Leaf.Window({
                        id: 'hls900_open_price_winid',
                        url: url,
                        title: 'excel测算',
                        fullScreen: true
                    });
                    return;
                }
                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                    Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                    Leaf.request({
                        url: $('con301_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                        type: "GET",
                        success: function (res) {
                            Leaf.SideBar.show({
                                msg: '计算成功',
                                duration: 2000
                            });
                            Leaf.Masker.unmask(Ext.getBody());
                            //带入数据后打开excel
                            var win = new Leaf.Window({
                                id: 'hls900_open_price_winid',
                                url: url,
                                title: 'excel测算',
                                fullScreen: true
                            });
                            win.on('close', function () {
                                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
                                var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');

                                var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'change_req_info', 'F_CHANGE_INFO');
                                var change_info_record = $(change_info_ds_id).getCurrentRecord();
                                var change_req_id = change_info_record.get("change_req_id");

                                var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'G_QUOTATION');
                                var quotation_record = $(quotation_ds_id).getCurrentRecord();
                                var quotation_id = quotation_record.get("quotation_id");

                                $(ds_id).query();
                                $(cashflow_ds_id).query();
                                $('${/parameter/@layout_code}_G_CASHFLOW_BEFORE_prj_quotation_cashflow_ds').query();

                                //生成比对信息 project_id, change_req_id
                                Leaf.request({
                                    url: "${/request/@context_path}/con/contract/compareinfoGenerate",
                                    para: {
                                        project_id : '${/parameter/@project_id}',
                                        change_req_id : change_req_id,
                                        quotation_id : quotation_id
                                    },
                                    success: function (res) {
                                        $L.Masker.unmask(document.body);
                                        //$L.showInfoMessage("提示", "计算完成", function () {
                                            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_COMPARE_INFO');
                                            $(ds_id1).query();
                                            var ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
                                            $(ds_id2).query();
                                        //});
                                    },
                                    error: function () {
                                    },
                                    scope: this
                                });

                            });
                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        scope: this
                    });
                }, 'N');
            }else{
                // 先执行保存操作,保存成功后提交数据
                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                    $L.Masker.mask(document.body, "计算中..");
                    Leaf.request({
                        url: "${/request/@context_path}/con/contract/repayment/calculate",
                        para: {
                            project_id : '${/parameter/@project_id}'
                        },
                        success: function (res) {
                            $L.Masker.unmask(document.body);
                            $L.showInfoMessage("提示", "计算完成", function () {
                                /*$('${/parameter/@winid}').close();
                                if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();*/
                                var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
                                var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');
                                $(et_ds_id).query();
                                $(cashflow_ds_id).query();
                                $('${/parameter/@layout_code}_G_CASHFLOW_BEFORE_prj_quotation_cashflow_ds').query();
                                $('${/parameter/@layout_code}_F_COMPARE_INFO_con_change_repayment_info_ds').query();
                            });
                        },
                        error: function () {
                            $L.Masker.unmask(document.body);
                            Leaf.showMessage("提示", "计算失败!", null);
                        },
                        scope: this
                    });
                });
            }
        }

        //还款计划变更报价计算,直接打开excel
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            // 判断还款方案,等额本息与等额本金调用后台计算, 不规则打开报价excel手动填写还款计划
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = url + '&readOnly=Y';
                //带入数据后打开excel
                var win = new Leaf.Window({
                    id: 'hls900_open_price_winid',
                    url: url,
                    title: 'excel测算',
                    fullScreen: true
                });
                return;
            }
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                Leaf.request({
                    url: $('con301_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                    type: "GET",
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '计算成功',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        win.on('close', function () {
                            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
                            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');

                            var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'change_req_info', 'F_CHANGE_INFO');
                            var change_info_record = $(change_info_ds_id).getCurrentRecord();
                            var change_req_id = change_info_record.get("change_req_id");

                            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'G_QUOTATION');
                            var quotation_record = $(quotation_ds_id).getCurrentRecord();
                            var quotation_id = quotation_record.get("quotation_id");

                            $(ds_id).query();
                            $(cashflow_ds_id).query();
                            $('${/parameter/@layout_code}_G_CASHFLOW_BEFORE_prj_quotation_cashflow_ds').query();

                            //生成比对信息 project_id, change_req_id
                            Leaf.request({
                                url: "${/request/@context_path}/con/contract/compareinfoGenerate",
                                para: {
                                    project_id : '${/parameter/@project_id}',
                                    change_req_id : change_req_id,
                                    quotation_id : quotation_id
                                },
                                success: function (res) {
                                    $L.Masker.unmask(document.body);
                                    //$L.showInfoMessage("提示", "计算完成", function () {
                                        var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_COMPARE_INFO');
                                        $(ds_id1).query();
                                        var ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
                                        $(ds_id2).query();
                                    //});
                                },
                                error: function () {
                                },
                                scope: this
                            });

                        });
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }, 'N');
        }


        //提起结清报价计算
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {

            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                $L.Masker.mask(document.body, "计算中..");
                Leaf.request({
                    url: "${/request/@context_path}/con/contract/et/calculate",
                    scope: this,
                    para: {
                        project_id : '${/parameter/@project_id}'
                    },
                    success: function (res) {
                        $L.Masker.unmask(document.body);
                        $L.showInfoMessage("提示", "计算完成", function () {
                            //$('${/parameter/@winid}').close();
                            //if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_et_info', 'F_ET_INFO');
                            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');
                            $(et_ds_id).query();
                            $(cashflow_ds_id).query();
                        });
                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "计算失败!", null);
                    }
                });
            });
        }


        //提前结清说明书生成
        window['${/parameter/@layout_code}_user_button9_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC');
            var record = $(ds_id).getCurrentRecord();
            Leaf.Masker.mask(Ext.getBody(), '正在生成...');
            var printData = [];
            var str = {project_id:record.get('project_id'), templet_id:81};
            printData.push(str);
            Leaf.request({
                url: "${/request/@context_path}/prj/project/create/etBooks",
                para: printData,
                success: function (res) {
                    debugger;
                    var down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + res.result.record[0].attachment_id;
                    location.href = down_url;
                    Leaf.Masker.unmask(Ext.getBody());
                },
                error: function () {
                    Leaf.Masker.unmask($('rsc_five_class_code_window').wrap);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
