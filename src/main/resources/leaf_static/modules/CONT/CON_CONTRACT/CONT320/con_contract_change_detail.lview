        //解押 抵质押明细 保存 && 回购 租赁物明细 保存
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var duration_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd', 'F_BASE_INFO');
            var lease_item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_item', 'G_LEASE_ITEM');
            var list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln', 'G_LEASE_ITEM_LIST');

            var check_flag = true;
            var hd_record = $(duration_hd_ds_id).getCurrentRecord();
            var hd_id = hd_record.get('hd_id');
            if (!hd_id) {
                Leaf.showMessage('提示！', '请先点击上方保存按钮！');
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                check_flag = false;
                return check_flag;

            }

            var lease_item_record = $(lease_item_ds_id).getCurrentRecord();
            var records = $(list_ds_id).getAll();
            //保存前校验
            if (execute_type == 'RELEASE') {
                records.forEach(function (record) {
                    var release_amount = record.get('release_amount') || 0;
                    var mortgage_pledge_amount = record.get('mortgage_pledge_amount') || 0;

                    if (minus(release_amount, mortgage_pledge_amount) > 0) {
                        Leaf.showMessage('提示！', '解押后抵质押金额:' + release_amount + '大于抵质押金额:' + mortgage_pledge_amount);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                });
            } else if (execute_type == 'REPURCHASE') {
                records.forEach(function (record) {
                    var release_amount = record.get('release_amount') || 0;
                    var net_asset_value_now = record.get('net_asset_value_now') || 0;

                    if (minus(release_amount, net_asset_value_now) > 0) {
                        Leaf.showMessage('提示！', '回购后账面净值:' + release_amount + '大于账面净值(当前):' + net_asset_value_now);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        check_flag = false;
                    }
                });
            }

            if (check_flag) {
                //第一步删除数据
                Leaf.request({
                    url: "${/request/@context_path}/hls/duration/ln/delete",
                    para: {
                        hd_id: hd_id,
                        lease_item_id: lease_item_record.get('lease_item_id'),
                        source_type: execute_type
                    },
                    success: function (res) {
                        var saveData = [];
                        for (var i = 0; i < records.length; i++) {
                            records[i].set('__status', 'insert');
                            records[i].set('hd_id', hd_id);
                            records[i].set('source_type', execute_type);
                            saveData.push(records[i].data);
                        }
                        //第二步 保存数据
                        Leaf.request({
                            url: '${/request/@context_path}/hls/duration/ln/submit',
                            para: saveData,
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '${l:HLS.SUBMIT_SUCCESS}',
                                    duration: 2000
                                });
                                //第三步 查询抵质押信息 grid && 查询租赁物信息
                                $(lease_item_ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    },
                    sync: true,
                    scope: this
                });
            }
        };


        //正常结清&&提前结清&&提前还款 解押 抵质押明细 保存
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_1_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

