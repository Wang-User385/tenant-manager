        <a:link id="lease_info_detaill1_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="SW001_PLEDGE_LEASE"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <script><![CDATA[


        var execute_type = '${/parameter/@execute_type}';
        var contract_id = '${/parameter/@contract_id}';

        var hd_id = '${/parameter/@hd_id}';

        var bp_info_change_flag = 'N';
        var release_change_flag = 'N';
        var repurchase_change_flag = 'N';
        var agreement_change_flag = 'N';
        var financial_terms_change_flag = 'N';


        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            //提前结清违约金字段
            var et_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_et_info', 'F_ET_INFO');
            if (ds.id == et_ds_id) {
                var record = $(et_ds_id).getCurrentRecord();
                var lease_start_date = record.get('lease_start_date');
                var et_date = record.get('et_date');
                debugger;
                if(et_date == null || estimateRegistrationTime(lease_start_date, et_date) || lease_start_date > et_date){
                    //record.getField('liquidated_damages').setRequired(false);
                    //record.getField('liquidated_damages').setReadOnly(true);
                    //record.set('liquidated_damages', null);
                }else{
                    //record.getField('liquidated_damages').setRequired(true);
                    //record.getField('liquidated_damages').setReadOnly(false);
                }
            }


            /*var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation', 'G_QUOTATION');
            var repayment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_change_repayment_info', 'F_REPAYMENT_INFO');
            if(repayment_ds_id && quotation_ds_id && ds.id == repayment_ds_id){
                debugger;
                var quotation_record = $(quotation_ds_id).getCurrentRecord();
                var price_list = quotation_record.get("price_list");
                if(price_list == 'GECALCULATOR_CASUAL_YH' && '${/parameter/@function_usage}' != 'QUERY'){
                    //变更起始期数
                    record.getField('change_start_times').setRequired(true);
                    record.getField('change_start_times').setReadOnly(false);
                    //变更后剩余期数
                    record.getField('after_remain_times').setRequired(true);
                    record.getField('after_remain_times').setReadOnly(false);
                    //还款变更方案
                    /!*record.getField('repayment_change_type').setRequired(true);
                    record.getField('repayment_change_type').setReadOnly(false);*!/
                    record.getField('repayment_change_type_n').setRequired(true);
                    record.getField('repayment_change_type_n').setReadOnly(false);
                }
            }*/
        };

        //判断两个日期间隔是否大于一年
        function estimateRegistrationTime(beginDate,endDate) {
            var begin = new Date(beginDate).getTime();
            var end = new Date(endDate).getTime();
            var day = (end - begin)/(24*60*60*1000);
            if (day > 365) {
                return true;
            }else{
                return false;
            }
        }

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            //租赁物信息
            if(ds.id=='${/parameter/@layout_code}_E_LEASE_ITEM_EQUIPMENT_prj_project_lease_item_ds'){
                qpara['project_id']= '${/parameter/@project_id}';
                qpara['project_type']= 'contract';
            }
            //租赁物变更前
            if(ds.id=='${/parameter/@layout_code}_G_LEASE_ITEM_BEFORE_prj_project_lease_item_ds'){
                qpara['project_id']= '${/parameter/@project_id}';
                qpara['project_type']= 'contract';
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            var change_type_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'change_req_info', 'F_CHANGE_TYPE');
            var change_info_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'change_req_info', 'F_CHANGE_INFO');
            if (change_type_ds_id == ds.id || change_info_ds_id == ds.id) {
                //qpara['change_req_id'] = x;
            }
        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'lease_item_code') {
                // debugger;
                var link_function;
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }



            if (name === 'upload_text' && record.get('project_attachment_id')) {
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\', \'CHANGE_REQ_INFO\');">附件</a>';
            }

            return value;
        };

        window['upload_file'] = function (record_id, project_attachment_id, table) {
            var url;
            var function_usage = '${/parameter/@function_usage}';

            if ('${/parameter/@function_usage}' === 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == null) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            if (project_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }

            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
                $('${/parameter/@layout_code}_G_ATTACHMENT_prj_project_attachment_ds').query();
                $(att_ds_id).query();
            });
        }

        window['lease_item_detail'] = function (record_id, ds_id) {
            // debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'lease_info_detaill1_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        window['pledge_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.lease_item_id;
            var type = 'MODIFY';
            param['url_title'] = '抵质押物详细';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'SW001_PLEDGE_LEASE';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        };



        window['lease001_detail_open'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['function_usage'] = 'QUERY';
            param['winid'] = '${/parameter/@layout_code}_lease_item_detail_winid';
            param['ds_id'] = ds_id;
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_lease_info_detail_id', ds_id, '${/parameter/@function_code}');
        }



        window['cashflow_detail'] = function (record_id, contract_id) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln');
            var param = {};
            param['url_title'] = '存续期履约情况';
            param['function_code'] = 'HLS300CASH';
            param['function_usage'] = 'MODIFY';
            param['contract_id'] = contract_id;
            param['winid'] = '${/parameter/@layout_code}_common_winid';
            /*param['screen_width'] = '1600';
            param['screen_height'] = '700';*/
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_common_window_id', ds_id, '${/parameter/@function_code}');
        }

        window['approval_notice'] = function (record_id, project_id) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_ln');
            var param = {};
            param['url_title'] = '项目审批通知书';
            param['function_code'] = 'PRJ316T1';
            param['function_usage'] = 'MODIFY';
            param['winid'] = '${/parameter/@layout_code}_project_credit_notice_winid';
