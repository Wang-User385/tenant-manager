<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_contract_change_create_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/con_contract_change_create.lview"/>
        <a:link id="cont320_con_contract_change_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/con_contract_change_detail.lview"/>

        <script><![CDATA[

        //变更创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var param = {};
            param['url_title'] = '存续期审批单类型选择';
            param['function_code'] = 'HLS300F1';
            param['function_usage'] = 'CREATE';
            param['screen_width'] = '450';
            param['screen_height'] = '350';
            param['winid'] = '${/parameter/@layout_code}_contract_change_create_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_contract_change_create_id', ds_id, 'CONT320');
        }

        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = '${/parameter/@layout_code}_open_detail';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'approve_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.get('project_id') + '\',\'' + record.get('change_req_id') + '\',\'' + record.get('change_type') + '\',\'' + record.get('status') + '\',\''  + record.ds.id + '\');">'+value+'</a>';
            }
        };

        window['${/parameter/@layout_code}_open_detail'] = function (record_id, change_req_id, change_type, status, ds_id) {
            //根据状态打开变更页面
            var param = {}, function_code;
            function_code = 'CONT320F2';
            param['url_title'] = '项目变更明细';
            if(change_type == 'BUSINESS_CHANGE_BEFORE'){
                function_code = 'CONT320F2';
            }
            if(change_type == 'REPAYMENT_SCHEDULE'){
                function_code = 'CONT320F3';
            }
            if(change_type == 'BUSINESS_CHANGE_AFTER'){
                function_code = 'CONT320F4';
            }
            if(change_type == 'ET'){
                function_code = 'CONT320F5';
            }

            debugger;
            if(status == 'NEW'){
                param['function_usage'] = 'CREATE';
            }else{
                param['function_usage'] = 'QUERY';
            }
            param['winid'] = 'prj320_contract_change_create_winid';
            param['function_code'] = function_code;
            param['project_id'] = record_id;
            param['change_req_id'] = change_req_id;
            param['ds_id'] = ds_id;
            hls_doc_get_layout_code(param, 'cont320_con_contract_change_detail_link_id', ds_id, function_code,'${/parameter/@winid}','Y');
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

