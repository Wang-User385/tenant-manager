<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: Eugene Song
    $Date: 2020年5月27日
    $Revision: 1.0
    $Purpose: 存续期审批-入口界面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="${/parameter/@layout_code}_modify_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>
        <script src="${/request/@context_path}/common/code?sysCodeData=HLS.DURATION_TYPE_NEW"
                type="text/javascript"></script>
        <a:link id="cont320_con_change_create_link_id" url="${/request/@context_path}/hls/duration/hd/durationcreate"/>
        <a:link id="cont321_con_contract_change_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/con_contract_change_detail.lview"/>
        <script><![CDATA[

        var function_code;
        var duration_type;
        var durationTypeECMap = {};
        sysCodeData.forEach(function (i) {
            durationTypeECMap[i.meaning] = i.value;
        });


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            var record = $(ds_id).getAt(0);
            var param = {};
            if ($(ds_id).validate()) {
                param['url_title'] = '合同变更审批事项工作联系单';
                param['function_code'] = get_function_code(record.get('duration_type'));
                param['duration_type'] = record.get('duration_type');
                param['change_type'] = record.get('duration_type');
                param['project_id'] = record.get('project_id');
                param['ref_project_id'] = record.get('ref_project_id');
                param['project_name'] = record.get('project_name');
                param['contract_number'] = record.get('prj_con_number');
                param['project_number'] = record.get('project_number');
                param['prj_bp_name'] = record.get('prj_bp_name');
                param['prj_con_status_n'] = record.get('prj_con_status_n');
                param['prj_unit_name'] = record.get('prj_unit_name');
                param['prj_employee_name'] = record.get('prj_employee_name');
                param['prj_finance_amount'] = record.get('prj_finance_amount');
                param['prj_outstanding_principal'] = record.get('prj_outstanding_principal');
                param['prj_overdue_max_days'] = record.get('prj_overdue_max_days');
                param['five_classification_result'] = record.get('five_classification_result');
                param['five_classification_result_n'] = record.get('five_classification_result_n');
                param['overdue_status_n'] = record.get('overdue_status_n');
                param['host_project_manager_n'] = record.get('host_project_manager_n');
                param['host_unit_name'] = record.get('host_unit_name');

                param['function_usage'] = 'CREATE';
                param['winid'] = '${/parameter/@layout_code}_project_modify_winid';
                param['entrance_winid'] = '${/parameter/@winid}';
                //param['layout_debugger_flag'] = 'Y';
                // hls_doc_get_layout_code(param, '${/parameter/@layout_code}_modify_id', ds_id, 'HLS300F1');
                //hls_doc_get_layout_code(param, '${/parameter/@layout_code}_modify_id', ds_id, 'HLS300F1','${/parameter/@winid}','Y');
                var change_type = record.get('duration_type');
                function_code = 'CONT320F2';
                if(change_type == 'BUSINESS_CHANGE_BEFORE'){
                    function_code = 'CONT320F2';
                }
                if(change_type == 'REPAYMENT_SCHEDULE'){
                    function_code = 'CONT320F3';
                }
                if(change_type == 'BUSINESS_CHANGE_AFTER'){
                    function_code = 'CONT320F4';
                }
                if(change_type == 'ET'){
                    function_code = 'CONT320F5';
                }

                //直接调用后台生成申请头数据,然后进入变更详情页面
                Leaf.request({
                    url: $('cont320_con_change_create_link_id').getUrl(),
                    para: param,
                    success: function (res) {
                        $L.Masker.unmask(Ext.getBody());
                        $L.showInfoMessage("提示","创建成功!",function () {
                            var record = res.result.record[0];
                            var param = record;

                            param['url_title'] = '项目变更明细';
                            param['winid'] = 'prj320_contract_change_create_winid';
                            param['function_code'] = function_code;
                            param['source_project_id'] = '${/parameter/@source_project_id}';
                            debugger;
                            hls_doc_get_layout_code(param, 'cont321_con_contract_change_detail_link_id', null, function_code,'${/parameter/@winid}','Y');
                        });
                    },
                    failure: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        $L.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });

            }
        };

        function get_function_code(duration_type) {
            if (duration_type == 'BUSINESS_CHANGE_BEFORE') {
                return 'CONT320F2';
            } else if (duration_type == 'REPAYMENT_SCHEDULE') {
                return 'CONT320F3';
            } else if (duration_type == 'BUSINESS_CHANGE_AFTER') {
                return 'CONT320F4';
            } else if (duration_type == 'ET') {
                return 'CONT320F5';
            }
        }
        Leaf.onReady(function () {

        });

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            //控制变更类型
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_duration_hd');
            if (ds.id === ds_id && record.get('contract_status')) {
                if(record.get('contract_status') == 'INCEPT'){
                    //起租后合同不可发起 合同现金流变更
                    if(record.get('duration_type') == 'BUSINESS_CHANGE_BEFORE'){
                        $L.showMessage("提示","起租后合同不可发起合同现金流变更!");
                        record.set('duration_type', null);
                        record.set('duration_type_n', null);
                    }
                }else{
                    /*record.getField('duration_type').setReadOnly(true);
                    record.getField('duration_type_n').setReadOnly(true);
                    record.set('duration_type', 'BUSINESS_CHANGE_BEFORE');
                    record.set('duration_type_n', '业务变更(租前)');*/
                    //起租前合同不可发起 提前结清 还款计划变更
                    if(record.get('duration_type') == 'ET' || record.get('duration_type') == 'REPAYMENT_SCHEDULE'){
                        $L.showMessage("提示","起租前合同不可发起提前结清与还款计划变更!");
                        record.set('duration_type', null);
                        record.set('duration_type_n', null);
                    }
                }
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>


