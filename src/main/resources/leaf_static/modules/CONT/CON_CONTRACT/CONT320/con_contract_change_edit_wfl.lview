    Author: lrd
    Date: 2020/02/24 14:13
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>

        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="con_contract_change_detail_wfl_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/con_contract_change_detail_wfl.lview"/>

        <a:link id="con_contract_change_detail_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT320/con_contract_change_detail.lview"/>
        <script><![CDATA[

        debugger;

        var changeType = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "changeType";
        });
        changeType = changeType[0].value;
        var projectId = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "projectId";
        });
        projectId = projectId[0].value;
        var changeReqId = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "changeReqId";
        });
        changeReqId = changeReqId[0].value;
        var function_code;
        if (changeType == 'BUSINESS_CHANGE_BEFORE') {
            function_code = 'CONT320F2';
        }
        if (changeType == 'REPAYMENT_SCHEDULE') {
            function_code = 'CONT320F3';
        }
        if (changeType == 'BUSINESS_CHANGE_AFTER') {
            function_code = 'CONT320F4';
        }
        if (changeType == 'ET') {
            function_code = 'CONT320F5';
        }

        var pageChooser = new PageChooser({
            url: $('con_contract_change_detail_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id:      projectId,
                change_req_id : changeReqId,
                function_usage: 'MODIFY',
                function_code:  function_code,
                hidden_button_code: ['USER_BUTTON1', 'EXIT', 'USER_BUTTON2'],
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>