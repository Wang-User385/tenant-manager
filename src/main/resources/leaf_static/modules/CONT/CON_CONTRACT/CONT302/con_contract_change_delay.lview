<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: Zeng Yuxuan
    $Date: 2021年6月17日
    $Revision: 1.0
    $Purpose: 付息延期
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="cont301f10_contract_change_info_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/cont301f10_contract_change_info.lview"/>
        <a:link id="contract_change_info_query_link" url="${/request/@context_path}/contract/change/info/query"/>
        <!--<a:link id="report_auth_query_link_id" url="${/request/@context_path}/report/auth/after/query"/>-->
        <a:link id="credit_service_query_link" url="${/request/@context_path}/credit/service/query"/>
        <a:link id="credit_service_get_token_link" url="${/request/@context_path}/credit/service/get/token"/>
        <a:link id="change_last_delay_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_delay_history_detail.lview"/>
        <a:link id="change_delay_history_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_delay_history.lview"/>
        <script><![CDATA[

        var contract_id = '${/parameter/@contract_id}';
        var change_req_id = '${/parameter/@change_req_id}';
        var quotation_id = '${/parameter/@quotation_id}';

        /*Leaf.onReady(function(){

            //查询当前用户决策报告查看权限
            Leaf.request({
                url: $('report_auth_query_link_id').getUrl(),
                scope: this,
                para: {userId: '${/session/@user_id}'},
                success: function (res) {
                    if (res.success && res.result.totalCount > 0) {
                        if(res.result.record[0].report_auth_after_flag != 'Y'){
                            jQuery('#${/parameter/@layout_code}_user_button3').hide();
                        }
                    }else{
                        jQuery('#${/parameter/@layout_code}_user_button3').hide();
                    }
                },
                failure: function () {
                    jQuery('#${/parameter/@layout_code}_user_button3').hide();
                },
                error: function () {
                    jQuery('#${/parameter/@layout_code}_user_button3').hide();
                },
                scope: this
            });
        });*/

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';

            if (ds.bindname == "${/parameter/@layout_code}_G_CASHFLOW_PRE_con_contract_cashflow") {

                if ('${/parameter/@status}' == 'APPROVED') {
                    ds.setQueryParameter('__preVersion', "Y");
                    ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_history_flag', 'Y'), 'document_id', documentId);
                } else {
                    ds.setQueryParameter('contract_id', contract_id);
                }

            } else {
                if (ds.queryurl.indexOf('history_flag') === -1) {
                    ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_history_flag', 'Y'), 'document_id', documentId);
                }
            }


            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow'):
                    ds.setQueryParameter('generated_source_doc_id', quotation_id);
                    break;
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req'):
                    ds.setQueryParameter('change_req_id', change_req_id);
                    break;
            }


        };
        //计算
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
                var con_contract_result_ds = $(ds_id);
                var record = con_contract_result_ds.getAt(0);

                var con_contract_req_ds = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req'));
                var data = {};
                data.config = [{
                    field: 'ccr_fee',
                    force: 'Y',
                    value: record.get('ccr_fee')
                }, {
                    field: 'ccr_delay_times',
                    force: 'Y',
                    value: record.get('ccr_outstanding_times')
                }, {
                    field: 'ccr_start_times',
                    force: 'Y',
                    value: record.get('ccr_start_times')
                }, {
                    field: 'lease_times',
                    force: 'Y',
                    value: record.get('lease_times')
                }];
                data.price_list = con_contract_req_ds.data[0].data.ccr_price_list;

                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/con/contract/change/req/recalculate?documentId=' + change_req_id + '&quotationId=' + quotation_id,
                    para: data,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')).query();
                        $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')).query();
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }.bind(this));
        };

        //查看附件
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'cont302_open_attachment_winid',
                url: url,
                params: {
                    'header_id': change_req_id,
                    'table_name': 'con_contract_change_req',
                    'function_usage' : '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')) {
                ds.data.forEach(function (value) {
                    if (value.get('generated_source_doc_id') != quotation_id) {
                        ds.removeLocal(value, true);
                    }

                    if (value.get('received_amount') === 0) {
                        value.set('received_amount', '', true)
                    }
                })
            }
        };

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getAll();
            if ('${/parameter/@try_flag}' === 'true') {
                Leaf.showErrorMessage('提示', '试算不能提交');
                return;
            }

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
                var con_contract_result_ds = $(ds_id);
                var record = con_contract_result_ds.getAt(0);

                var con_contract_req_ds = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req'));
                var data = {};
                data.config = [{
                    field: 'ccr_fee',
                    force: 'Y',
                    value: record.get('ccr_fee')
                }, {
                    field: 'ccr_delay_times',
                    force: 'Y',
                    value: record.get('ccr_outstanding_times')
                }, {
                    field: 'ccr_start_times',
                    force: 'Y',
                    value: record.get('ccr_start_times')
                },{
                    field: 'lease_times',
                    force: 'Y',
                    value: record.get('lease_times')
                }];
                data.price_list = con_contract_req_ds.data[0].data.ccr_price_list;

                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/con/contract/change/req/recalculate?documentId=' + change_req_id + '&quotationId=' + quotation_id,
                    para: data,
                    success: function (res) {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                        Leaf.request({
                            url: '${/request/@context_path}/con/contract/change/req/approve',
                            para: {change_req_id: '${/parameter/@change_req_id}'},
                            success: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                $('${/parameter/@winid}').close();
                                if (res.success) {
                                    Leaf.showMessage('提示', '提交审批成功!');
                                }
                            },
                            error: function () {
                                $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')).query();
                                $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            }
                        });
                    },
                    failure: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }.bind(this));
        };


        //取消申请
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/req/cancel',
                para: {change_req_id: '${/parameter/@change_req_id}'},
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    if (res.success) {
                        $('${/parameter/@winid}').close();
                        Leaf.showMessage('提示', '申请取消!');
                    }
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            })
        };

        //变更历史查看
        window['${/parameter/@layout_code}_user_button5_layout_dynamic_click'] = function () {
            var param = {};
            param['contract_id'] = contract_id;
            param['change_type'] = 'DELAY';
            param['change_status'] = 'APPROVED';
            param['url_title'] = '付息延期历史查看';
            param['function_code'] = 'CONT302F10S1';
            param['winid'] = 'contract_delay_history_winid';
            param['function_usage']='QUERY';
            hls_doc_get_layout_code(param, 'change_delay_history_link_id', null, 'CONT301F10S1');
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }
        };

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            var submitUrl = $('${/parameter/@layout_code}_virtual_ds').submiturl;
            if (submitUrl.indexOf('history_flag') === -1) {
                submitUrl = splitparameter(
                    splitparameter(
                        splitparameter(submitUrl, 'document_id', documentId),
                        'document_history_flag', 'Y'),
                    'document_category', documentCategory);
            }
            $('${/parameter/@layout_code}_virtual_ds').submiturl = submitUrl;
            return check_flag;
        };

        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                }
                else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        }

        function beforeSubmit(countiune) {
            //如果是租后管理岗审批
            var nodeId = '${/parameter/@node_id}';
            if(nodeId == 'sid-ATHgcktf-I31p-43yZ-8wbS-rQniIRvft4J0' || nodeId == 'sid-oZjqAwUr-S7FA-4s1u-85SB-65kISORLWmvH'){
                //查询当前付款对象信息
                Leaf.request({
                    url: $('contract_change_info_query_link').getUrl(),
                    scope: this,
                    para: {changeReqId: '${/parameter/@change_req_id}'},
                    success: function (res) {
                        if (res.success && res.result.totalCount > 0) {
                            if(res.result.record[0].change_term == 60){
                                new Leaf.showConfirm('${l:HLS.PROMPT}', '合同变更后总期限等于<font color="red">60个月</font>，请确认后点击“确定”！', function okFun() {
                                    countiune();
                                }, function cancel() {
                                    return;
                                }, 200, 100);
                            }else{
                                countiune();
                            }
                        }else{
                            countiune();
                        }
                    },
                    failure: function () {
                        countiune();
                    },
                    error: function () {
                        countiune();
                    },
                    scope: this
                });
            }else{
                countiune();
            }
        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

    </a:view>
</a:screen>

