        }

        function hideGird() {
            //商用车租赁物信息grid_id
            let vehicle_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_layout_grid_id_wrap'
            //工程机械租赁物信息grid_id
            let machine_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_layout_grid_id_wrap'
            //光伏设备租赁物信息-变更前
            let photovoltaic_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_layout_grid_id_wrap'
            //商用车租赁物信息grid_id
            let vehicle_grid_id1 = '#' + '${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_layout_grid_id_wrap'
            //工程机械租赁物信息grid_id
            let machine_grid_id1 = '#' + '${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_layout_grid_id_wrap'
            //光伏设备租赁物信息-变更后
            let photovoltaic_grid_id1 = '#' + '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_layout_grid_id_wrap'
            //租赁物信息_光伏设备_变更前
            let lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_layout_grid_id'
            //租赁物信息_光伏设备_变更后
            let lease_item_ds_id1 = '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_layout_grid_id'
            //隐藏左侧导航栏
            if (leaseChannel === '20') {
                //隐藏工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_grid_id1).hide();
                //隐藏光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_grid_id1).hide();
            } else if (currentDivision === 'COMMERCIAL_VEHICLE') { //商用车
                //隐藏工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_grid_id1).hide();
                //隐藏光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_grid_id1).hide();
            } else if (currentDivision === 'ENGINEERING_MACHINERY') { //工程机械
                //隐藏商用车
                jQuery(vehicle_grid_id).hide();
                jQuery(vehicle_grid_id1).hide();
                //隐藏光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_grid_id1).hide();
            } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') { //光伏
                //隐藏工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_grid_id1).hide();
                //隐藏商用车
                jQuery(vehicle_grid_id).hide();
                jQuery(vehicle_grid_id1).hide();
            } else {
                //隐藏商用车
                jQuery(vehicle_grid_id).hide();
                jQuery(vehicle_grid_id1).hide();
                //隐藏光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_grid_id1).hide();
            }
        }

        ]]></script>
