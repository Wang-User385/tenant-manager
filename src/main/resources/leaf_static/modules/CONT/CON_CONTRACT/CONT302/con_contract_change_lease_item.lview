<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript" src="${/request/@context_path}/resources/js/calculateNull.js"></script>
        <a:link id="cont301f10_contract_change_info_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/cont301f10_contract_change_info.lview"/>
        <a:link id="sig001_open_insurance_information_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F5/lease_item_insurance.lview"/>
        <a:link id="prj316f2_prj_lease_item_check_id" url="${/request/@context_path}/prj/project/lease/item/check"/>
        <!--<a:link id="prj316f2_prj_get_divison_id" url="${/request/@context_path}/prj/project/get/division"/>
        <a:link id="prj316f2_prj_get_lease_channel" url="${/request/@context_path}/prj/project/get/leaseChannel"/>
        <a:link id="prj316f2_prj_get_manufacturer_code" url="${/request/@context_path}/prj/project/get/manufacturerCode"/>-->
        <a:link id="lease_item_compare_price_query_link"
                url="${/request/@context_path}/lease/item/compare/price/query"/>
        <!--<a:link id="report_auth_query_link_id" url="${/request/@context_path}/report/auth/after/query"/-->>
        <a:link id="credit_service_query_link" url="${/request/@context_path}/credit/service/query"/>
        <a:link id="credit_service_get_token_link" url="${/request/@context_path}/credit/service/get/token"/>
        <script><![CDATA[

        var contract_id = '${/parameter/@contract_id}';
        var change_req_id = '${/parameter/@change_req_id}';
        var status = '${/parameter/@status}' || 'APPROVING';
        let currentDivision = '${/parameter/@division}'
        var manufacturerCode = '${/parameter/@manufacturer_code}'
        var leaseChannel = '${/parameter/@lease_channel}'
        var license_length_flag = true;
        var special_char_valid = true;

        $L.onReady(function () {
            //getDivision();
            //getLeaseChannel();
            //getManufacturerCode();
            hideGird();
            //getIsQuery();
        });

        function getDivision() {
            currentDivision = '${/parameter/@division}'
            let contractNumber;
            if (!currentDivision) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('prj316f2_prj_get_divison_id').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber, contractId: '${/parameter/@contract_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            currentDivision = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        function getLeaseChannel() {
            leaseChannel = '${/parameter/@lease_channel}'
            let contractNumber;
            if (!leaseChannel) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('prj316f2_prj_get_lease_channel').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber, contractId: '${/parameter/@contract_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            leaseChannel = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        function getManufacturerCode() {
            manufacturerCode = '${/parameter/@manufacturer_code}'
            let contractNumber;
            if (!manufacturerCode) {
                contractNumber = '${/parameter/@contract_number}';
                if (!contractNumber) {
                    contractNumber = '${/parameter/@project_number}';
                }
                Leaf.request({
                    url: $('prj316f2_prj_get_manufacturer_code').getUrl(),
                    scope: this,
                    para: {contractNumber: contractNumber, contractId: '${/parameter/@contract_id}'},
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            manufacturerCode = res.result.record[0]
                        }
                    },
                    sync: true
                });
            }
        }

        function getIsQuery() {
            //查询当前用户决策报告查看权限
            Leaf.request({
                url: $('report_auth_query_link_id').getUrl(),
                scope: this,
                para: {userId: '${/session/@user_id}'},
                success: function (res) {
                    if (res.success && res.result.totalCount > 0) {
                        if (res.result.record[0].report_auth_after_flag != 'Y') {
                            debugger
                            jQuery('#${/parameter/@layout_code}_user_button5').hide();
                        }
                    } else {
                        debugger
                        jQuery('#${/parameter/@layout_code}_user_button5').hide();
                    }
                },
                failure: function () {
                    jQuery('#${/parameter/@layout_code}_user_button5').hide();
                },
                error: function () {
                    jQuery('#${/parameter/@layout_code}_user_button5').hide();
                },
                scope: this
            });
        }

        //变更历史查看
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {

            var param = {};
            param['contract_id'] = contract_id;
            param['change_req_id'] = change_req_id;
            param['url_title'] = '合同变更信息查看';
            param['function_code'] = 'CONT301F10';
            param['winid'] = 'cont301f10_contract_change_info_winid';
            param['screen_width'] = '910';
            param['side'] = 'right';
            hls_doc_get_layout_code(param, 'cont301f10_contract_change_info_link', null, 'CONT301F10');
        };

        //附件预览
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            if (typeof (window.previewAtt) === 'function') {
                previewAtt(contract_id);
            } else if (typeof (window.parent.previewAtt) === 'function') {
                window.parent.previewAtt(contract_id)
            } else if (typeof (window.parent.parent.previewAtt) === 'function') {
                window.parent.parent.previewAtt(contract_id)
            } else if (typeof (window.parent.parent.parent.previewAtt) === 'function') {
                window.parent.parent.parent.previewAtt(contract_id)
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';

            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }

        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'attachment_detail') {
                var document_name = record.get("document_name");
                return '<a href="javascript:window[\'' + 'attachment_action' + '\'](\'' + record.id + '\',\'' + document_name + '\',\'' + record.ds.id + '\');">上传/下载</a>';
            } else if (name == 'insurance_information' && !record.isNew) {
                return '<a style="color: red;" href="javascript:open_insurance_information(\'' + record.ds.id + '\',\'' + record.id + '\')">保险信息</a>';
            }
        };
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {
            disableDs()
            var attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if (ds.id == attach_ds_id) {
                var records = $(attach_ds_id).getSelected();
                for (var i = 0; i < records.length; i++) {
                    if (records[i].get("document_name") == '审查文件') {
                        $L.showInfoMessage("提示", "该附件为审查流程文件，不允许进行删除!", null);
                        return false;
                    }
                }
            }
        };

        function attachment_action(record_id, document_name, ds_id) {
            var record = $(ds_id).findById(record_id),
                contract_attachment_id = record.get('contract_attachment_id');
            if (contract_attachment_id == undefined || contract_attachment_id == null) {
                Leaf.showErrorMessage('提示', '请先保存再上传附件！', null, 200, 100);
                return;
            }
            var status = '${/parameter/@status}';
            var url;
            var function_usage;
            var node_id = '${/parameter/@node_id}';
            if (status == 'NEW' || status == 'REJECTED' || status == 'CANCEL') {
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage = 'MODIFY';
            } else {
                url = '${/request/@context_path}/downloadFile.lview'
                function_usage = 'QUERY';
            }
            if (document_name == '审查文件') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }

            //资管部负责人,投租后管理岗节点可以上传下载附件“审查文件”
            if (document_name == '审查文件' && (node_id == 'sid-f7oqX9VE-uz7x-4OeY-8l5y-BKt9MxVw8vYe' || node_id == 'sid-R47gFopC-exQN-4fz4-8533-BQWCEi1MeJEU'
            )) {
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage = '${/parameter/@function_usage}';
            }

            new Leaf.Window({
                id: 'open_attachment_win_id',
                url: url,
                params: {
                    header_id: record.get('contract_attachment_id'),
                    table_name: 'CON_CONTRACT_ATTACHMENT',
                    winid: 'open_attachment_win_id',
                    function_usage: function_usage
                },
                title: '附件上传',
                width: 900,
                height: 475
            });
        }

        function open_insurance_information(ds_id, record_id) {
            var machine1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_MACHINE1');
            var vehicle1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_VEHICLE1');
            var photovoltaic1_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_PHOTOVOLTAIC1');

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var function_usage = 'QUERY';
            var maintain_type = 'READONLY';
            if (status === 'REJECTED' || status === 'NEW') {
                function_usage = 'MODIFY';
                maintain_type = 'MODIFY';
            }
            if (ds_id == machine1_ds_id || ds_id == vehicle1_ds_id || ds_id == photovoltaic1_ds_id) {
                param['change_flag'] = 'Y';
            } else {
                param['change_flag'] = 'N';
            }
            param['status'] = status;
            param['url_title'] = '保险信息维护';
            param['function_code'] = 'CONT301F5_INSURANCE';
            param['winid'] = 'sig001_open_insurance_information_winid';
            param['screen_width'] = '1100';
            param['screen_height'] = '500';
            param['function_usage'] = function_usage;
            param['maintain_type'] = maintain_type;
            param['document_id'] = change_req_id;
            param['document_category'] = '${/parameter/@document_category}';
            param['document_history_flag'] = 'Y';
            param['parent_table'] = 'con_contract_lease_item';
            param['parent_base_table_pk'] = param.contract_lease_item_id;
            param['con_lease_item_id'] = param.contract_lease_item_id;
            hls_doc_get_layout_code(param, 'sig001_open_insurance_information_link_id', ds_id, 'CONT302F3');
        }

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';

            var con_contract_attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if (ds.id == con_contract_attachment_ds_id) {
                ds.setQueryParameter('contract_id', contract_id);
                ds.setQueryParameter('source_id', change_req_id);
                ds.setQueryParameter('contract_attachment_category', 'CON_CONTRACT_LEASE_ITEM_CHANGE');
            }

            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }
            if (ds.submiturl) {
                var submitUrl = ds.submiturl;
                if (submitUrl.indexOf('document_history_flag') === -1) {
                    var obj = urlSearch(submitUrl);
                    obj.document_id = documentId;
                    obj.document_history_flag = 'Y';
                    obj.document_category = documentCategory;
                    submitUrl = submitUrl.split('?')[0];
                    for (var k in obj) {
                        submitUrl = splitparameter(submitUrl, k, obj[k]);
                    }
                }
                ds.submiturl = submitUrl;
            }

        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            if ('${/parameter/@try_flag}' === 'true') {
                Leaf.showErrorMessage('提示', '试算不能提交');
                return;
            }
            var obj = window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'];
            if (!obj.approve) {
                obj.approve = function () {
                    window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                    Leaf.request({
                        url: '${/request/@context_path}/con/contract/change/req/approve',
                        para: {change_req_id: '${/parameter/@change_req_id}'},
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $('${/parameter/@winid}').close();
                            if (res.success) {
                                Leaf.showMessage('提示', '提交审批成功!');
                            }
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }
                    });
                }
            }

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](obj.approve);

        };

        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/req/cancel',
                para: {change_req_id: '${/parameter/@change_req_id}'},
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    if (res.success) {
                        $('${/parameter/@winid}').close();
                        Leaf.showMessage('提示', '申请取消!');
                    }
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            })
        };

        function setRead(ds, record) {
            let lease_item_ds_id
            if (currentDivision === 'COMMERCIAL_VEHICLE') {//商用车
                lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_VEHICLE_prj_project_lease_item_ds'
            } else if (currentDivision === 'ENGINEERING_MACHINERY') {//工程机械
                lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds'
            } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') {//光伏
                lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_ds'
            } else {
                lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_MACHINE_prj_project_lease_item_ds'
            }
            var wfl_flag = '${/parameter/@wfl_flag}';

            if (ds.id === lease_item_ds_id) {
                var lease_item_record = record;
                //根据业务线调整字段输入模式
                if (currentDivision === "COMMERCIAL_VEHICLE" && wfl_flag !== 'Y' && lease_item_record) {
                    if (lease_item_record.get("trailer_flag") !== "TRAILER") {
                        lease_item_record.getField("engine_number").setReadOnly(false);
                        lease_item_record.getField("engine_number").setRequired(true);
                        lease_item_record.getField("frame_number").setReadOnly(false);
                        lease_item_record.getField("frame_number").setRequired(true);
                        lease_item_record.getField("province_code").setReadOnly(false);
                        lease_item_record.getField("province_code").setRequired(true);
                        lease_item_record.getField("city_code").setReadOnly(false);
                        lease_item_record.getField("city_code").setRequired(true);
                    } else {
                        lease_item_record.getField("engine_number").setReadOnly(false);
                        lease_item_record.getField("engine_number").setRequired(false);
                        lease_item_record.getField("frame_number").setReadOnly(false);
                        lease_item_record.getField("frame_number").setRequired(false);
                        lease_item_record.getField("province_code").setReadOnly(false);
                        lease_item_record.getField("province_code").setRequired(false);
                        lease_item_record.getField("city_code").setReadOnly(false);
                        lease_item_record.getField("city_code").setRequired(false);
                    }
                }
            }
        }

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            disableDs();
            setRead(ds, record);
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var attach_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if (ds.id == attach_id && $(ds.id).data.length > 0) {
                if (record.get("document_name") == '审查文件') {
                    record.getField("document_name").setReadOnly(true);
                }
            }
            var v_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_VEHICLE1');
            var m_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_MACHINE1');
            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var manufacturer_id = $(contract_ds_id).getCurrentRecord().get('manufacturer_id');
            if (ds.id == v_ds_id) {
                record.set('manufacturer_id', manufacturer_id);
            } else if (ds.id == m_ds_id) {
                if (record != "") {
                    record.set('manufacturer_id', manufacturer_id);
                    Leaf.request({
                        url: $('lease_item_compare_price_query_link').getUrl(),
                        scope: this,
                        para: {classifyId: record.get('classify_id')},
                        success: function (res) {
                            if (res.success && res.result.totalCount > 0) {
                                var compare_price = res.result.record[0].compare_price;
                                record.set('compare_price', compare_price);
                            }
                        },
                        failure: function () {
                        },
                        error: function () {
                        },
                        scope: this
                    });
                }
            }
        };
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            disableDs();
            setRead(ds, record);
            var con_contract_attachment = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if (con_contract_attachment === ds.id) {
                record.set('contract_id', contract_id);
                record.set('source_id', change_req_id);
                record.set('contract_attachment_category', 'CON_CONTRACT_LEASE_ITEM_CHANGE');
            }

            var contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var manufacturer_id = $(contract_ds_id).getCurrentRecord().get('manufacturer_id');
            var v_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_VEHICLE1');
            var m_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_lease_item', 'G_LEASING_MACHINE1');
            if (v_ds_id === ds.id || m_ds_id === ds.id) {
                record.set('manufacturer_id', manufacturer_id);
            }

        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            disableDs();
            var regEn = /[`~!@#$%^&*()\-_+=<>?:"{}\,.\\/;'[\]]/im;//匹配所有英文特殊字符
            var regCn = /[·！#￥（——）……：；“”‘、，|《。》？、【】[\]]/im;//匹配所有中文特殊字符
            var regBlank = /[\s]/im;//匹配空白符（换页符、换行符、回车符、制表符、垂直制表符）
            let lease_item_dsid;
            //商用车租赁物信息grid_id
            const vehicle_grid_id1 = '${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds'
            //工程机械租赁物信息grid_id
            const machine_grid_id1 = '${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds'
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                lease_item_dsid = vehicle_grid_id1
            } else {
                lease_item_dsid = machine_grid_id1
            }
            if (ds.id == machine_grid_id1) {
                if (name == 'classify_id' && value) {
                    Leaf.request({
                        url: $('lease_item_compare_price_query_link').getUrl(),
                        scope: this,
                        para: {classifyId: value},
                        success: function (res) {
                            if (res.success && res.result.totalCount > 0) {
                                var compare_price = res.result.record[0].compare_price;
                                record.set('compare_price', compare_price);
                            }
                        },
                        failure: function () {
                        },
                        error: function () {
                        },
                        scope: this
                    });
                }
            }
            if (ds.id === lease_item_dsid && name === 'price') {
                var totalAmount = 0;
                for (var i = 0; i < ds.data.length; i++) {
                    totalAmount += ds.data[i].get('price');
                }
                var form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
                $(form_ds_id).getCurrentRecord().set('sum_lease_item_amount', totalAmount);
            }
            if (ds.id === lease_item_dsid) {
                if (name === 'brand_c' || name === 'series_c' || name === 'model_c' || name === 'engine_number') {
                    if (regBlank.test(value)) {
                        special_char_valid = false;
                        Leaf.showMessage("提示", "字段含有非法字符（包括空格），请检查!", null);
                        return;
                    } else {
                        special_char_valid = true;
                    }
                } else if (name === 'frame_number' && value) {
                    if (regBlank.test(value)) {
                        special_char_valid = false;
                        Leaf.showMessage("提示", "字段含有非法字符（包括空格），请检查!", null);
                        return;
                    } else {
                        special_char_valid = true;
                    }
                    if (value.length !== 17) {
                        license_length_flag = false;
                        Leaf.showMessage("提示", "车架号长度应为17位!", null);
                    } else {
                        license_length_flag = true;
                    }
                } else if (name === 'trailer_flag') {
                    const wfl_flag = '${/parameter/@wfl_flag}';
                    if (currentDivision === "COMMERCIAL_VEHICLE" && wfl_flag !== 'Y' && record) {
                        if (value !== "TRAILER") {
                            record.getField("engine_number").setReadOnly(false);
                            record.getField("engine_number").setRequired(true);
                            record.getField("frame_number").setReadOnly(false);
                            record.getField("frame_number").setRequired(true);
                            record.getField("province_code").setReadOnly(false);
                            record.getField("province_code").setRequired(true);
                            record.getField("city_code").setReadOnly(false);
                            record.getField("city_code").setRequired(true);
                        } else {
                            record.getField("engine_number").setReadOnly(false);
                            record.getField("engine_number").setRequired(false);
                            record.getField("frame_number").setReadOnly(false);
                            record.getField("frame_number").setRequired(false);
                            record.getField("province_code").setReadOnly(false);
                            record.getField("province_code").setRequired(false);
                            record.getField("city_code").setReadOnly(false);
                            record.getField("city_code").setRequired(false);
                        }
                    }
                }
            }


        };

        function validata(contract_id) {
            var flag = false;
            let lease_item_dsid;
            //商用车租赁物信息grid_id
            const vehicle_grid_id1 = '${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds'
            //工程机械租赁物信息grid_id
            const machine_grid_id1 = '${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds'
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                lease_item_dsid = vehicle_grid_id1
            } else {
                lease_item_dsid = machine_grid_id1
            }
            max_amount = 0;
            for (var i = 0; i < $(lease_item_dsid).getAll().length; i++) {
                var price = $(lease_item_dsid).getAll()[i].get('price');
                if (minus(price, max_amount) > 0) {
                    max_amount = price;
                }
            }
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/lease/item/validata?contractId=' + contract_id + '&maxAmount=' + max_amount,
                sync: true,
                success: function (res) {
                    flag = res.result.record[0];
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            });
            return flag;
        }


        var save_flag = false;

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            debugger
            var attach_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            var records = $(attach_id).getAll();
            for (var i = 0; i < records.length; i++) {
                var documentName = records[i].get("document_name");
                if (documentName == '审查文件') {
                    break;
                }
            }
            if (documentName !== '审查文件') {
                $(attach_id).create({
                    contract_id: contract_id,
                    source_id: change_req_id,
                    document_name: '审查文件',
                    contract_attachment_category: 'CON_CONTRACT_LEASE_ITEM_CHANGE'
                });
            }


            if (!license_length_flag) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "车架号长度应为17位！");
                return false;
            }

            if (!special_char_valid) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showMessage('${l:PROMPT_MESSAGE}', "字段含有非法字符（包括空格），请检查！");
                return false;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            let contractNumber;
            if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract')) {
                contractNumber = ds.getCurrentRecord().get('contract_number')
                if (minus(ds.getCurrentRecord().get('lease_item_amount'), ds.getCurrentRecord().get('sum_lease_item_amount')) > 0) {
                    Leaf.showErrorMessage("错误", "现设备额不能小于原设备额");
                    save_flag = false;
                } else {
                    save_flag = true
                }
                /*if (validata(contract_id)) {
                    ds.getCurrentRecord().set('insurance_flag', 'Y');
                    ds.getCurrentRecord().set('insurance_flag_n', '是');
                } else {
                    ds.getCurrentRecord().set('insurance_flag', 'N');
                    ds.getCurrentRecord().set('insurance_flag_n', '否');
                }*/
                ds.getCurrentRecord().dirty = true;
                console.log(ds);
            }

            let lease_item_ds_id;
            //商用车租赁物信息grid_id
            const vehicle_grid_id1 = '${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds'
            //工程机械租赁物信息grid_id
            const machine_grid_id1 = '${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds'
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                lease_item_ds_id = vehicle_grid_id1
            } else {
                lease_item_ds_id = machine_grid_id1
            }
            let itemNumberArr = []
            if ($(lease_item_ds_id).data.length === 0) {
                Leaf.showMessage('${l:PROMPT_MESSAGE}', '请先维护租赁物')
                save_flag = false;
            }
            if (contractNumber) {
                for (let i = 0; i < $(lease_item_ds_id).data.length; i++) {
                    let itemNumber;
                    let checkFlag = '';
                    if (currentDivision === 'COMMERCIAL_VEHICLE') {
                        itemNumber = $(lease_item_ds_id).data[i].get('frame_number')
                        if (itemNumber && itemNumber.length > 0 && itemNumber.length !== 17) {
                            Leaf.showMessage('${l:PROMPT_MESSAGE}', '车架号长度应为17位!')
                            save_flag = false;
                            break;
                        }
                        checkFlag = checkItemNumber(itemNumber, 'COMMERCIAL_VEHICLE', contractNumber, 'null')
                    } else {
                        itemNumber = $(lease_item_ds_id).data[i].get('serial_number')
                        let classifyId = $(lease_item_ds_id).data[i].get('classify_id')
                        checkFlag = checkItemNumber(itemNumber, currentDivision, contractNumber, classifyId)
                        itemNumber = itemNumber + '-.-' + classifyId;
                    }
                    if (itemNumber) {
                        if (itemNumberArr.indexOf(itemNumber) === -1) {
                            itemNumberArr.push(itemNumber)
                        } else {
                            checkFlag = contractNumber
                        }
                    }
                    if (checkFlag && currentDivision !== 'PHOTOVOLTAIC_DEVICES') {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        if (itemNumber.indexOf('-.-') > 0) {
                            itemNumber = itemNumber.substr(0, itemNumber.indexOf('-.-'));
                        }
                        Leaf.showMessage('${l:PROMPT_MESSAGE}', '与' + checkFlag + '合同车架号/(规格型号+整机编号)重复<br>重复号码：' + itemNumber + '。', null, 600, 800);
                        save_flag = false;
                        break;
                    }

                    if (currentDivision === 'COMMERCIAL_VEHICLE') {
                        const fullName = $(lease_item_ds_id).data[i].get('full_name')
                        const netPrice = $(lease_item_ds_id).data[i].get('net_price')
                        const purchaseTax = $(lease_item_ds_id).data[i].get('purchase_tax')
                        const insurancePremium = $(lease_item_ds_id).data[i].get('insurance_premium')
                        const accessoryFee = $(lease_item_ds_id).data[i].get('accessory_fee')
                        const price = $(lease_item_ds_id).data[i].get('price')
                        //校验netPrice + purchaseTax + insurancePremium + accessoryFee = price
                        let checkNum = Number(calSubtract((calAdd(calAdd(calAdd(netPrice, purchaseTax), insurancePremium), accessoryFee)), price))
                        if (0 !== checkNum) {
                            save_flag = false;
                            Leaf.showMessage('${l:PROMPT_MESSAGE}', '租赁物' + fullName + '总价需等于净价、购置税、保险费、配件费之和。')
                            break;
                        }
                    }
                }
            }


            check_flag = save_flag;

            if (!check_flag) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }

            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            var submitUrl = $('${/parameter/@layout_code}_virtual_ds').submiturl;
            if (submitUrl.indexOf('document_history_flag') === -1) {
                submitUrl = splitparameter(
                    splitparameter(
                        splitparameter(submitUrl, 'document_id', documentId),
                        'document_history_flag', 'Y'),
                    'document_category', documentCategory);
            }
            $('${/parameter/@layout_code}_virtual_ds').submiturl = submitUrl;
            return check_flag;
        };


        function checkItemNumber(itemNumber, division, contractNumber, classifyId) {
            let result = null;
            if (itemNumber && itemNumber.length > 0) {
                Leaf.request({
                    url: $('prj316f2_prj_lease_item_check_id').getUrl(),
                    scope: this,
                    para: {
                        itemNumber: itemNumber,
                        division: division,
                        contractNumber: contractNumber,
                        classifyId: classifyId
                    },
                    success: function (res) {
                        if (res && res.result.record && res.result.record.length > 0 && res.result.record[0]) {
                            result = res.result.record[0]
                        }
                    }, failure: function () {
                        result = "未查询合同"
                    },
                    error: function () {
                        result = "未查询合同"
                    },
                    sync: true
                });
            }
            return result;
        }


        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            disableDs();
            $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract')).query();
            $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment')).query();
            let lease_item_dsid;
            //商用车租赁物信息grid_id
            const vehicle_grid_id1 = '${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds'
            //工程机械租赁物信息grid_id
            const machine_grid_id1 = '${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds'
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                lease_item_dsid = vehicle_grid_id1
            } else {
                lease_item_dsid = machine_grid_id1
            }
            $(lease_item_dsid).query();
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        };

        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                } else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        }

        function urlSearch(url) {
            var obj = {};
            var name, value;
            var str = url; //取得整个地址栏
            var num = str.indexOf("?");
            str = str.substr(num + 1); //取得所有参数   stringvar.substr(start [, length ]

            var arr = str.split("&"); //各个参数放到数组里
            for (var i = 0; i < arr.length; i++) {
                num = arr[i].indexOf("=");
                if (num > 0) {
                    name = arr[i].substring(0, num);
                    value = arr[i].substr(num + 1);
                    obj[name] = value;
                }
            }
            return obj;
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'] = function (nextStep) {
            disableDs();
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var root_ds = $('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_ignore_required_before_save']();
            if (root_ds.validate()) {
                var winid = 'con_contract_tenant_np_window_id';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@bp_seq}${/parameter/@layout_code}');

                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE() {
                    root_ds.un('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data.length > 0 && root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if (!flag) {
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION() {
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds, root_record, res);
                    if (typeof (nextStep) == 'function') {
                        nextStep(ds);
                    }
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR() {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }

                root_ds.on('beforesubmit', ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);

                root_ds.submit();
            } else {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        };


        function disableDs() {
            try {
                if (leaseChannel === '20') {
                    //删除工程机械ds
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').removeAll
                    //删除光伏设备ds
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').removeAll
                } else if (currentDivision === 'COMMERCIAL_VEHICLE') {//商用车
                    //删除工程机械ds
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').removeAll
                    //删除光伏设备ds
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').removeAll
                } else if (currentDivision === 'ENGINEERING_MACHINERY') {//工程机械
                    //删除商用车ds
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds').removeAll
                    //删除光伏设备ds
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC1_con_contract_lease_item_ds').removeAll
                } else if (currentDivision === 'PHOTOVOLTAIC_DEVICES') {//光伏
                    //删除工程机械ds
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_MACHINE1_con_contract_lease_item_ds').removeAll
                    //删除商用车ds
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds').removeAll
                } else {
                    //删除商用车ds
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').fields = {}
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_ds').removeAll
                    $('${/parameter/@layout_code}_G_LEASING_VEHICLE1_con_contract_lease_item_ds').fields = {}
