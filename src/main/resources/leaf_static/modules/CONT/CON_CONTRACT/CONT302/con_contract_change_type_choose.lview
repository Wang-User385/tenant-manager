<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="${/parameter/@layout_code}_change_reschedule_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_reschedule.lview"/>
        <a:link id="${/parameter/@layout_code}_change_extension_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_extension.lview"/>
        <a:link id="${/parameter/@layout_code}_change_lease_item_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_lease_item.lview"/>
        <a:link id="${/parameter/@layout_code}_change_tenant_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_tenant.lview"/>
        <a:link id="${/parameter/@layout_code}_change_prepayment_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_prepayment.lview"/>
        <a:link id="${/parameter/@layout_code}_change_delay_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_delay.lview"/>
        <a:link id="${/parameter/@layout_code}_change_repo_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT302/con_contract_change_repo.lview"/>
        <script><![CDATA[
        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                }
                else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        }

        window['${/parameter/@layout_code}_change_type'] = {
            /*PRE: {
                function_code: 'CONT302F1',
                url_title: '合同变更-租前变更'
            },*/
            LEASE_ITEM: {
                function_code: 'CONT302F3',
                url_title: '合同变更-租赁物变更'
            },
            TENANT: {
                function_code: 'CONT302F4',
                url_title: '合同变更-承租人变更'
            },
            RESCHEDULE: {
                function_code: 'CONT302F5',
                url_title: '合同变更-支付期平移'
            },
            EXTENSION: {
                function_code: 'CONT302F6',
                url_title: '合同变更-缩期展期'
            },
            PREPAYMENT: {
                function_code: 'CONT302F7',
                url_title: '合同变更-提前结清'
            },
            /*PENALTY_EXEMPT: {
                function_code: 'CONT302F8',
                url_title: '合同变更-罚息变更'
            },*/
            REPO: {
                function_code: 'CONT302F9',
                url_title: '合同变更-回购'
            },
            DELAY: {
                function_code: 'CONT302F10',
                url_title: '合同变更-付息延期'
            }
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            //创建时查新数据
            if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')
                && '${/parameter/@function_usage}' !== 'QUERY') {
                qpara.contract_id = -1;
            } else if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')) {
                qpara.change_req_id = '${/parameter/@change_req_id}';
            }

        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_EXIT_LAYOUT_DYNAMIC_CLICK'] = function () {
            if ('${/parameter/@winid}') {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
                var param = $(ds_id).data[0].data;
                if (!param.change_req_id) {
                    $('${/parameter/@winid}').close();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return;
                }
                Leaf.request({
                    url: '${/request/@context_path}/con/contract/change/req/cancel',
                    para: {change_req_id: param.change_req_id},
                    success: function (res) {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        if (res.success) {
                            $('${/parameter/@winid}').close();
                        } else {
                            Leaf.showErrorMessage('提示', '取消申请失败！' + res.message);
                        }
                    }
                });
            }
        };

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            var param = $(ds_id).data[0].data;

            if (!$(ds_id).validate()) {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }
            //状态校验
            var con_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var con_record = $(con_ds_id).getCurrentRecord();
            var record = $(ds_id).getCurrentRecord();
            var contract_status = con_record.get("contract_status");
            var change_type = record.get("change_type");
            var annual_pay_times = con_record.get('annual_pay_times');
            if(contract_status !== 'INCEPT'){
                Leaf.showErrorMessage('提示', '只有起租状态的合同才能做变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }/*else if(change_type == 'EXTENSION' && '${/parameter/@creation_date_n}' <= '2022-12-01'){
                Leaf.showErrorMessage('提示', '历史数据不能进行缩期展期变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }else if(change_type == 'DELAY'&&annual_pay_times != 12){
                Leaf.showErrorMessage('提示', '非月付合同不能进行付息延期变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }*/

            $(ds_id).setSubmitUrl('${/request/@context_path}/con/contract/change/request/submit');
            $(ds_id).on("submitsuccess", window['${/parameter/@layout_code}_next_step'](param));
            $(ds_id).submit();

        };

        window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            if (!$(ds_id).validate()) {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }
            //控制权限：合同状态为新建和签约可以进行租前变更，其他变更只有合同状态为起租才可以进行变更
            var con_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var con_record = $(con_ds_id).getCurrentRecord();
            var record = $(ds_id).getCurrentRecord();
            var contract_status = con_record.get("contract_status");
            var annual_pay_times = con_record.get('annual_pay_times');
            var change_type = record.get("change_type");
            if(contract_status !== 'INCEPT'){
                Leaf.showErrorMessage('提示', '只有起租状态的合同才能做变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }/*else if(change_type == 'EXTENSION' && '${/parameter/@creation_date_n}' <= '2022-12-01'){
                Leaf.showErrorMessage('提示', '历史数据不能进行缩期展期变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }else if(change_type == 'DELAY'&&annual_pay_times != 12){
                Leaf.showErrorMessage('提示', '非月付合同不能进行付息延期变更！');
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }*/

            $(ds_id).setSubmitUrl('${/request/@context_path}/con/contract/change/request/submit');
            $(ds_id).on('submitsuccess', window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']);
            $(ds_id).submit();
        };


        window['${/parameter/@layout_code}_next_step'] = function (param) {
            return function () {
                $jq.extend(param, window['${/parameter/@layout_code}_change_type'][param.change_type]);
                param['winid'] = 'con_contract_' + param.change_type.toLowerCase() + '_window_id';
                var link_id = '${/parameter/@layout_code}_change_' + param.change_type.toLowerCase() + '_link_id';
                param['manufacturer_code'] = param.manufacturer_code;
                hls_doc_get_layout_code(
                    param,
                    link_id,
                    get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'),
                    'CONT302',
                    'con_contract_choose_win_id',
                    'Y'
                )
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')) {
                switch ('${/parameter/@contract_status}') {
                    case 'NEW':
                    case 'SIGN':
                        ds.data[0].set('change_type', 'PRE');
                        ds.data[0].set('change_type_n', '租前变更');
                        readonly_dataset_field('${/parameter/@layout_code}', 'con_contract_change_req', 'quotation_id', 'F_CHANGE');
                        readonly_dataset_field('${/parameter/@layout_code}', 'con_contract_change_req', 'change_type', 'F_CHANGE');
                        break;
                    default:
                }
                ds.data[0].set('contract_id', '${/parameter/@contract_id}');
            }
        };

        Leaf.onReady(function () {
            if ('${/parameter/@function_usage}' === 'QUERY'){
               var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
               $(ds_id).on('load', function () {
                   window.setTimeout(window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'], 0)
               })
            }

        })

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    