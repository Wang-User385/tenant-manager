<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: congweijing
    Date: 2021/05/20 10:30
    Revision: 1.0
    Purpose: 合同结束工作流页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="cont_contract_terminate_detail_wfl_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT307/con_contract_terminate_detail.lview"/>
        <script><![CDATA[

        var businessKey = '${/parameter/@businessKey}';
        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';

        //项目经理与档案管理员都应该可编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-ng7mxgTy-bPdW-45In-8T0w-9WFtRQe18Dgc" || parent.currentTaskInfo.task_definition_key == "sid-6IRFFY2a-PPYb-4Pqh-8lWv-etuKxdwIsG8E" ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
        }
        var pageChooser = new PageChooser({
            url: $('cont_contract_terminate_detail_wfl_link').getUrl() + '?function_code=CONT307F1',
            function_code: 'CONT307F1',
            context_path: '${/request/@context_path}',
            opt: {
                businessKey : '${/parameter/@businessKey}',
                project_id: '${/parameter/@businessKey}',
                maintain_type : maintain_type,
                function_usage : function_usage
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>