<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: huangtianyang
    Date: 2019/02/19 16:37
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="con_contract_detail_f10_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/con_contract_detail.lview"/>
        <a:link id="con_confirm_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT310/con_bussiness_comfirm_detail.lview"/>
        <script><![CDATA[

        var contract_ds_id;

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            if (ds_id == ds.id) {
                qpara['created_by'] = '${/session/@user_id}';
            }
        };

        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['contract_id'] = param.contract_id;
            param['winid'] = 'con_contract_detail_winid';
            var link_id = 'con_contract_detail_id';
            if(param.lease_channel == '20'){
                param['function_code'] = 'CONT301F10';
                link_id = 'con_contract_detail_f10_id';
            }
            hls_doc_get_layout_code(param, link_id, ds_id, 'CONT301');
        }

        function open_confirm_detail_win(ds_id,manufacturer_id_n,vender_id_n,manufacturer_id) {
            var param = {};
            param['url_title'] = '业务确认函明细维护';
            param['function_code'] = 'CONT310F1';
            param['manufacturer_name'] = manufacturer_id_n;
            param['manufacturer_id'] = manufacturer_id;
            param['vender_name'] = vender_id_n;
            param['winid'] = 'con_confirm_detail_winid';
            var link_id = 'con_confirm_detail_id';
            debugger
            hls_doc_get_layout_code(param, link_id, ds_id, 'CONT310F1');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        //重置并查询
        window['${/parameter/@layout_code}_RESET_LAYOUT_DYNAMIC_CLICK'] = function() {
            for(var i=0;i<window['${/parameter/@layout_code}_layoutDataSetList'].length;i++){
                if(!$(window['${/parameter/@layout_code}_layoutDataSetList'][i]).queryurl){
                    $(window['${/parameter/@layout_code}_layoutDataSetList'][i]).reset();
                }
            }
            for(var i=0;i<window['${/parameter/@layout_code}_layoutDataSetList'].length;i++){
                if($(window['${/parameter/@layout_code}_layoutDataSetList'][i]).queryurl&&$(window['${/parameter/@layout_code}_layoutDataSetList'][i]).submiturl){
                    $(window['${/parameter/@layout_code}_layoutDataSetList'][i]).query();
                }
            }
        };


        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            contract_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var select_datas = $(contract_ds_id).getSelected();
            debugger
            if(select_datas.length === 0){
                Leaf.showMessage('提示！', '至少选择一行!');
                return;
            }
            var ids = [];
            for(var i = 0; i < select_datas.length; i++){
                if(!(select_datas[i].get('contract_status') === 'INCEPT' || select_datas[i].get('contract_status') === 'PENDING' || select_datas[i].get('contract_status') === 'TERMINATE')){
                    Leaf.showMessage('提示！', '只有起租、暂挂和结束的合同才可以打印业务确认函!');
                    return;
                }
                if(select_datas[i].get('manufacturer_id') != select_datas[0].get('manufacturer_id')){
                    Leaf.showMessage('提示！', '同一厂商/合作方下的合同才可以打印业务确认函!');
                    return;
                }
                // if(select_datas[i].get('factory_id') != select_datas[0].get('factory_id')){
                //     Leaf.showMessage('提示！', '同一主机厂/合作方下的合同才可以打印业务确认函!');
                //     return;
                // }
                // if(select_datas[i].get('lease_channel') != select_datas[0].get('lease_channel')){
                //     Leaf.showMessage('提示！', '同一商业模式的合同才可以打印业务确认函!');
                //     return;
                // }
                ids.push(select_datas[i].get('contract_id'));
            }

            // Leaf.request({
            //     url: '${/request/@context_path}/con/business/confirm/create',
            //     para: {
            //         contractIds: ids,
            //         manufacturer_id: select_datas[0].get('manufacturer_id'),
            //         factory_id: select_datas[0].get('factory_id')
            //     },
            //     success: function (res) {
            //         var batch_id=res.result.record[0];
            //         open_confirm_detail_win(batch_id,ds_id, select_datas[0].get('manufacturer_id'),select_datas[0].get('factory_id'));
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     },
            //     failure: function () {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     },
            //     error: function () {
            //         window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            //     },
            //     scope: this,
            //     sync: true
            // });
            open_confirm_detail_win(contract_ds_id, select_datas[0].get('manufacturer_id_n'),select_datas[0].get('factory_id_n'),select_datas[0].get('manufacturer_id'));
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

