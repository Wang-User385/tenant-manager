<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: Eugene Song
    $Date: 2019年4月18日
    $Revision: 1.0
    $Purpose: 合同调息
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        function cont303_floating_query() {
            $('con_floating_rate_req_maintain_result_ds').query();
        }

        function cont303_floating_reset() {
            $('con_floating_rate_req_maintain_query_ds').reset();
            $('con_floating_rate_req_maintain_result_ds').query();
        }

        function flt_req_number_renderer(value, record, name) {
            var status = record.get("status");

            if (status == 'CANCEL' || status == 'APPROVED' || status == 'APPROVING') {
                return '<a href="javascript:winOpen_flt_req_query(\'' + record.get('flt_req_id') + '\');">' + value + '</a>';
            } else {
                return '<a href="javascript:winOpen_flt_req_modify(\'' + record.get('flt_req_id') + '\');">' + value + '</a>';
            }


        }

        function winOpen_flt_req_query(flt_req_id) {
            var win = new Leaf.Window({
                id: 'cont303_floating_quotation_calc_winid',
                url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT303/con_floating_rate_quotation_calc_query.lview',
                params: {
                    winid: 'cont303_floating_quotation_calc_winid',
                    flt_req_id: flt_req_id
                },
                title: '调息计算',
                fullScreen: true

            });
            win.on('close', function () {
                cont303_floating_query();
            });
        }

        function winOpen_flt_req_modify(flt_req_id) {
            var win = new Leaf.Window({
                id: 'cont303_floating_quotation_calc_winid',
                url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT303/con_floating_rate_quotation_calc.lview',
                params: {
                    winid: 'cont303_floating_quotation_calc_winid',
                    flt_req_id: flt_req_id,
                    status: status
                },
                title: '调息计算',
                fullScreen: true

            });
            win.on('close', function () {
                cont303_floating_query();
            });
        }

        function cont303_floating_next() {
            var win = new Leaf.Window({
                id: 'cont303_floating_create_winid',
                url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT303/con_floating_rate_req_create.lview',
                params: {
                    winid: 'cont303_floating_create_winid'
                },
                title: '调息创建',
                width: 400,
                height: 250
            });
            win.on('close', function () {
                cont303_floating_query();
            });
        }

        function cont303_floating_test() {
            Leaf.request({
                url: "${/request/@context_path}/con/floating/ln/cal/rateChange?fltReqId=" + 13,
                success: function (res) {
                },
                error: function (res) {
                },
                failure: function (res) {
                },
                scope: this
            });
        }


        function amount_renderer(value, record, name) {
            if (value > 0) {
                return '<div  style="color: #ff0000">' + Leaf.formatMoney(value) + '</div >';
            } else if (value < 0) {
                return '<div  style="color:#ade47c;">' + Leaf.formatMoney(value) + '</div >';
            } else {
                return Leaf.formatMoney(value);
            }

        }

        ]]></script>


        <a:dataSets>
            <a:dataSet id="hls_wfl_status_ds" lookupCode="HLS_WFL_STATUS"/>
            <a:dataSet id="con_floating_rate_req_maintain_query_ds">
                <a:fields>
                    <a:field name="status_n" displayField="code_value_name" options="hls_wfl_status_ds"
                             returnField="status" valueField="code_value"/>
                    <a:field name="status"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="con_floating_rate_req_maintain_result_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/con/floating/query"
                       queryDataSet="con_floating_rate_req_maintain_query_ds" selectable="true">
                <a:fields>
                    <a:field name="flt_req_date" datatype="date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="cont303_floating_query" text="HLS.QUERY"/>
                <a:gridButton click="cont303_floating_reset" text="HLS.RESET"/>
                <a:gridButton click="cont303_floating_next" text="HLS.CREATE"/>
            </a:screenTopToolbar>
            <a:form column="3" title="查询条件" labelwidth="110" style="width:100%;height:35px">
                <a:hBox labelWidth="100">
                    <a:textField name="flt_req_number"
                                 bindTarget="con_floating_rate_req_maintain_query_ds"
                                 prompt="批量调息编号">
                        <a:events>
                            <a:event name="enterdown" handler="cont303_floating_query"/>
                        </a:events>
                    </a:textField>
                    <a:datePicker name="flt_req_date"
                                  bindTarget="con_floating_rate_req_maintain_query_ds"
                                  prompt="申请日期">
                        <a:events>
                            <a:event name="enterdown" handler="cont303_floating_query"/>
                        </a:events>
                    </a:datePicker>
                    <a:comboBox name="status_n"
                                bindTarget="con_floating_rate_req_maintain_query_ds"
                                prompt="状态">
                        <a:events>
                            <a:event name="enterdown" handler="cont303_floating_query"/>
                        </a:events>
                    </a:comboBox>
                </a:hBox>
            </a:form>

            <a:grid id="con_floating_rate_req_maintain_grid_ds"
                    bindTarget="con_floating_rate_req_maintain_result_ds" marginHeight="130" marginWidth="20"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="flt_req_number" prompt="批量调息编号" width="150"
                              renderer="flt_req_number_renderer"/>
                    <a:column name="flt_req_date" align="center" prompt="申请日期" width="100"
                              renderer="Leaf.formatDate"/>
                   <!-- <a:column name="total_interest_adj_amount" prompt="利息调整总额" renderer="amount_renderer" align="right"
                              width="120"/>-->
                    <a:column name="status_n" prompt="状态" width="100"/>
                    <a:column name="description" prompt="调息说明" width="400"/>
                </a:columns>
            </a:grid>
        </a:screenBody>
    </a:view>
</a:screen>
    
    