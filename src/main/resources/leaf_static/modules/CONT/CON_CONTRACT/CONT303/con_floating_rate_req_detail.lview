<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: Eugene Song
    $Date: 2019年4月19日
    $Revision: 1.0
    $Purpose: 调息明细
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function cont303_floating_detail_return() {
            $('${/parameter/@winid}').close();
        }

        ]]></script>

        <a:dataSets>
            <a:dataSet id="con_floating_rate_req_detail_query_ds">
                <a:fields>
                    <a:field name="flt_req_ln_id" defaultValue="${/parameter/@flt_req_ln_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="con_floating_rate_req_detail_form_ds" autoQuery="true"
                       queryUrl="${/request/@context_path}/con/floating/ln/query"
                       queryDataSet="con_floating_rate_req_detail_query_ds">
                <a:fields>
                    <a:field name="contract_number" readOnly="true"/>
                    <a:field name="contract_name" readOnly="true"/>
                    <a:field name="business_type_n" readOnly="true"/>
                    <a:field name="description" readOnly="true"/>
                    <a:field name="bp_name" readOnly="true"/>
                    <a:field name="floating_range_method_n" readOnly="true"/>
                    <a:field name="old_base_rate" readOnly="true"/>
                    <a:field name="new_base_rate" readOnly="true"/>
                    <a:field name="unit_name" readOnly="true"/>
                    <a:field name="contract_number_con" readOnly="true"/>
                    <a:field name="lpr_link_date" readOnly="true" datatype="date"/>
                    <a:field name="next_adjustment_date" readOnly="true" datatype="date"/>
                    <a:field name="lpr_base_date_n" readOnly="true"/>
                    <a:field name="lpr_fixed_date" readOnly="true" datatype="date"/>
                    <a:field name="lpr_adjustment_term" readOnly="true"/>
                    <a:field name="lpr_adjustment_period_n" readOnly="true"/>
                </a:fields>
            </a:dataSet>

            <a:dataSet id="con_floating_rate_req_detail_grid_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/con/floating/query/calcdetail"
                       queryDataSet="con_floating_rate_req_detail_query_ds" selectable="true">
                <a:fields>
                    <a:field name="due_date" datatype="date"/>
                </a:fields>
            </a:dataSet>

        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="cont303_floating_detail_return" text="返回"/>
            </a:screenTopToolbar>
            <a:form  title="基本信息">
                <a:hBox labelWidth="200">
                    <a:textField name="bp_name"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="客户名称" width="220"/>
                    <a:textField name="contract_number_con"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="合同编号" width="220"/>
                </a:hBox>

                <a:hBox labelWidth="200">
                    <a:textField name="unit_name"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="部门" width="220"/>
                    <a:textField name="contract_number"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="支付表编号" width="220"/>
                </a:hBox>

                <a:hBox labelWidth="200">
<!--                    <a:datePicker name="lpr_link_date"-->
<!--                                 bindTarget="con_floating_rate_req_detail_form_ds"-->
<!--                                 prompt="lpr挂钩日期" width="220"/>-->
                    <a:datePicker name="next_adjustment_date"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="调息日" width="220"/>
                    <a:textField name="lpr_adjustment_period_n"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="调息期次" width="220"/>
                </a:hBox>

<!--                <a:hBox labelWidth="200">-->
<!--                    <a:textField name="lpr_base_date_n"-->
<!--                                 bindTarget="con_floating_rate_req_detail_form_ds"-->
<!--                                 prompt="调息基准日期" width="220"/>-->
<!--                    <a:datePicker name="lpr_fixed_date"-->
<!--                                 bindTarget="con_floating_rate_req_detail_form_ds"-->
<!--                                 prompt="调息指定日期" width="220"/>-->
<!--                </a:hBox>-->

<!--                <a:hBox labelWidth="200">-->
<!--                    <a:textField name="lpr_adjustment_term"-->
<!--                                 bindTarget="con_floating_rate_req_detail_form_ds"-->
<!--                                 prompt="调息期限（月）" width="220"/>-->
<!--                    <a:textField name="lpr_adjustment_period_n"-->
<!--                                 bindTarget="con_floating_rate_req_detail_form_ds"-->
<!--                                 prompt="调息期次" width="220"/>-->
<!--                </a:hBox>-->

                <a:hBox labelWidth="200">
                    <a:textField name="old_base_rate"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="原基准利率" width="220"/>
                    <a:textField name="new_base_rate"
                                 bindTarget="con_floating_rate_req_detail_form_ds"
                                 prompt="新基准利率" width="220"/>
                </a:hBox>

            </a:form>

            <a:grid bindTarget="con_floating_rate_req_detail_form_ds" width="900" height="300" title="调息前利率要素"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="int_rate_type_n" prompt="利率类型" width="100" align="center"/>
                    <a:column name="float_type" prompt="利率浮动类型" width="100" align="center"/>
                    <a:column name="base_rate_type_n" prompt="基准利率标准" width="100" align="center"/>
                    <a:column name="base_rate" prompt="基准利率值" width="100" align="center" renderer="percentFormat"/>
                    <a:column name="floating_way_rate" prompt="浮动值（BP）" width="100" align="center"/>
                    <a:column name="int_rate" prompt="年利率(%)" width="100" align="center" renderer="percentFormat"/>
                </a:columns>

            </a:grid>

            <a:grid bindTarget="con_floating_rate_req_detail_form_ds" width="900" height="300" title="调息后利率要素"
                    navBar="true">
                <a:toolBar>
                    <a:button type="excel"/>
                </a:toolBar>
                <a:columns>
                    <a:column name="int_rate_type_n" prompt="利率类型" width="100" align="center"/>
                    <a:column name="float_type" prompt="利率浮动类型" width="100" align="center"/>
                    <a:column name="base_rate_type_n" prompt="基准利率标准" width="100" align="center"/>
                    <a:column name="new_base_rate" prompt="基准利率值" width="100" align="center" renderer="percentFormat"/>
                    <a:column name="floating_way_rate" prompt="浮动值（BP）" width="100" align="center"/>
                    <a:column name="new_int_rate" prompt="年利率(%)" width="100" align="center" renderer="percentFormat"/>

                </a:columns>

            </a:grid>


            <a:form title="调息结果">

                <a:hBox labelWidth="200">
                    <a:numberField name="old_due_amount" readOnly="true" renderer="Leaf.formatMoney"
                                   bindTarget="con_floating_rate_req_detail_grid_ds"
                                   prompt="调息前租金"/>
                    <a:numberField name="new_due_amount" readOnly="true" renderer="Leaf.formatMoney"
                                 bindTarget="con_floating_rate_req_detail_grid_ds"
                                 prompt="调息后租金"/>
                </a:hBox>

                <a:hBox labelWidth="200">
                    <a:numberField name="old_principal" readOnly="true" renderer="Leaf.formatMoney"
                                   bindTarget="con_floating_rate_req_detail_grid_ds"
                                   prompt="调息前本金"/>
                    <a:numberField name="new_principal" readOnly="true" renderer="Leaf.formatMoney"
                                 bindTarget="con_floating_rate_req_detail_grid_ds"
                                 prompt="调息后本金"/>
                </a:hBox>

                <a:hBox labelWidth="200">
                    <a:numberField name="old_interest" readOnly="true" renderer="Leaf.formatMoney"
                                   bindTarget="con_floating_rate_req_detail_grid_ds"
                                   prompt="调息前利息"/>
                    <a:numberField name="new_interest" readOnly="true" renderer="Leaf.formatMoney"
                                 bindTarget="con_floating_rate_req_detail_grid_ds"
                                 prompt="调息后利息"/>
                </a:hBox>

                <a:hBox labelWidth="200">
                    <a:numberField name="old_outstanding_interest" readOnly="true" renderer="Leaf.formatMoney"
                                   bindTarget="con_floating_rate_req_detail_grid_ds"
                                   prompt="调息前剩余利息"/>
                    <a:numberField name="new_outstanding_interest" readOnly="true" renderer="Leaf.formatMoney"
                                 bindTarget="con_floating_rate_req_detail_grid_ds"
                                 prompt="调息后剩余利息"/>
                </a:hBox>

                <a:hBox labelWidth="200">
                    <a:numberField name="interest_adj_amount" readOnly="true" renderer="Leaf.formatMoney"
                                   bindTarget="con_floating_rate_req_detail_grid_ds"
                                   prompt="利息差值"/>
                </a:hBox>

            </a:form>


        </a:screenBody>

    </a:view>
</a:screen>