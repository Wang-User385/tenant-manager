<?xml version="1.0" encoding="UTF-8"?>

<!--
    $Author: Eugene Song
    $Date: 2019年4月22日
    $Revision: 1.0
    $Purpose: 调息历史
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function cont303_floating_history_return() {
            $('${/parameter/@winid}').close();
        }

        function detail_his_renderer(value, record, name) {
            debugger;
            console.log(record);
            return '<a href="javascript:winOpen_detail_his(\'' + record.get('flt_req_ln_id') + '\');">明细</a>';
        }

        function winOpen_detail_his(flt_req_ln_id) {
            debugger;
            console.log(flt_req_ln_id);
            var win = new Leaf.Window({
                id: 'cont303_floating_detail_winid',
                url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT303/con_floating_rate_req_detail.lview',
                params: {
                    winid: 'cont303_floating_detail_winid',
                    flt_req_ln_id: flt_req_ln_id
                },
                title: '调息明细',
                width: 1150,
                height: 600
            });
        }


        ]]></script>

        <a:dataSets>
            <a:dataSet id="con_floating_rate_req_history_query_ds">
                <a:fields>
                    <a:field name="flt_req_id" defaultValue="${/parameter/@flt_req_id}"/>
                    <a:field name="flt_req_ln_id" defaultValue="${/parameter/@flt_req_ln_id}"/>
                    <a:field name="quotation_id" defaultValue="${/parameter/@quotation_id}"/>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="con_floating_rate_req_history_ds" autoPageSize="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/con/floating/ln/history/query"
                       queryDataSet="con_floating_rate_req_history_query_ds" selectable="true">
                <a:fields>
                    <a:field name="flt_req_date" datatype="date"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:gridButton click="cont303_floating_history_return" text="返回"/>
            </a:screenTopToolbar>
            <a:grid bindTarget="con_floating_rate_req_history_ds" width="850" height="450"
                    navBar="true">
                <a:columns>
                    <a:column name="flt_req_number" prompt="批量调息编号" width="150"/>
                    <a:column name="flt_req_date" align="center" prompt="申请日期" width="100"
                              renderer="Leaf.formatDate"/>
                    <a:column name="status_n" prompt="审批状态" width="80"/>
<!--                    <a:column name="description" prompt="调息说明" width="300"/>-->
                    <a:column name="flt_req_ln_id" prompt="明细" align="center" renderer="detail_his_renderer" width="80"/>
                </a:columns>
            </a:grid>
        </a:screenBody>

    </a:view>
</a:screen>
    
    