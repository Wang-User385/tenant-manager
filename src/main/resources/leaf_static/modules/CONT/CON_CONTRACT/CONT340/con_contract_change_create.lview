<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: chenliangxian
    $Date:2023年3月21日
    $Revision: 1.0
    $Purpose: 合同变更-大单提前部分还本入口页面
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="${/parameter/@layout_code}_con_contract_type_choose_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT340/con_contract_change_type_choose.lview"/>
        <a:link id="${/parameter/@layout_code}_change_partial_prepayment_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT340/con_contract_change_partial_prepayment.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'change_req_number_render';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'change_req_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        window['${/parameter/@layout_code}_change_type'] = {
            PARTIAL_PREPAYMENT: {
                function_code: 'CONT340F2',
                url_title: '合同变更-大单提前部分还本'
            }
        };

        function change_req_number_render(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            if(record.get('status')=='APPROVED'||record.get('status')=='APPROVING'){
                param['function_usage']='QUERY';
            }
            $jq.extend(param, window['${/parameter/@layout_code}_change_type'][param.change_type]);
            param['winid'] = 'con_contract_' + param.change_type.toLowerCase() + '_window_id';
            var link_id = '${/parameter/@layout_code}_change_' + param.change_type.toLowerCase() + '_link_id';
            /*if (param.change_type.toUpperCase() === 'TENANT') {
                var contract_ds = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'));
                var bp_class = contract_ds.data[0].data.bp_class.toLowerCase();
                param['function_code'] = param.function_code + bp_class.toUpperCase();
                link_id = '${/parameter/@layout_code}_change_' + param.change_type.toLowerCase() + '_' + bp_class + '_link_id';
            }*/
            hls_doc_get_layout_code(
                param,
                link_id,
                get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'),
                '${/parameter/@layout_code}',
                null,
                null,
                'cont340_query'
            )
        }

        function cont340_query(){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            $(ds_id).query();
            var con_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            $(con_ds_id).query();
        }

        //创建申请
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var data = $(ds_id).getSelected()[0].data;
            changeReq(data.is_trycal === 'Y', data)();
        };

        //是否试算
        function changeReq(isTryCal, data) {
            return function () {
                var param = {};
                param.contract_id = data.contract_id;
                param['url_title'] = '大单提前部分还本';
                param['function_code'] = 'CONT340F1';
                param['winid'] = '340con_contract_choose_win_id';
                param.contract_status = data.contract_status;
                param.try_flag = isTryCal.toString();

                hls_doc_get_layout_code(param,
                    '${/parameter/@layout_code}_con_contract_type_choose_link_id',
                    get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'),
                    'CONT340',
                    null,
                    null,
                    'cont340_query');
            }
        }

        window['${/parameter/@layout_code}_save_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            $(ds_id).setSubmitUrl('${/request/@context_path}/con/contract/change/request/submit');
            $(ds_id).submit();
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    