-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript" src="${/request/@context_path}/resource/js/splitUrlParameter.js"></script>

        <a:link id="cont301f10_contract_change_pre_payment_link"
                url="${/request/@context_path}/contract/change/req/pre/payment/query"/>
        <a:link id="cont340_cashflow_import_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT340/con_contract_change_partial_prepayment_excel_import_file.lview"/>
        <script><![CDATA[

        var contract_id = '${/parameter/@contract_id}';
        var change_req_id = '${/parameter/@change_req_id}';
        var quotation_id = '${/parameter/@quotation_id}';

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name === 'attachment_detail') {
                return '<a href="javascript:window[\'' + 'attachment_action' + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">上传/下载</a>';
            }
            if (name == 'file_names' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
            }
        };

        function attachment_action(record_id, ds_id){
            debugger;
            var record = $(ds_id).findById(record_id),
                contract_attachment_id = record.get('contract_attachment_id');
            if(contract_attachment_id == undefined || contract_attachment_id == null){
                Leaf.showErrorMessage('提示', '请先保存再上传附件！', null, 200, 100);
                return ;
            }
            var status = '${/parameter/@status}';
            var url;
            var function_usage;
            if(status == 'NEW'||status == 'REJECTED' || status == 'CANCEL'){
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage = 'MODIFY';
            }else{
                url = '${/request/@context_path}/downloadFile.lview'
                function_usage = 'QUERY';
            }
            var win = new Leaf.Window({
                id: 'open_attachment_win_id',
                url: url,
                params: {
                    header_id: record.get('contract_attachment_id'),
                    table_name: 'CON_CONTRACT_ATTACHMENT',
                    winid: 'open_attachment_win_id',
                    function_usage: function_usage
                },
                title: '附件上传',
                width: 900,
                height: 475
            });
            win.on('close', function () {
                var arr_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
                $(arr_ds_id).query();
            });
        }


        //取消申请
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/req/partial/prepayment/cancel',
                para: {change_req_id: '${/parameter/@change_req_id}'},
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    if (res.success) {
                        $('${/parameter/@winid}').close();
                        Leaf.showMessage('提示', '申请取消!');
                    }
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            })
        };


        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            debugger
            if ('${/parameter/@try_flag}' === 'true') {
                Leaf.showErrorMessage('提示', '试算不能提交');
                return;
            }

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            var record = $(ds_id).getCurrentRecord();

            if(record.dirty){
                Leaf.showErrorMessage('提示', '有未保存数据，请保存之后再提交审批！');
                return;
            }
            //变更后XIRR 大于 变更前XIRR 才能提交审批
            var xirr = record.get('xirr');
            var changedXirr =record.get('change_xirr');
            if(changedXirr <= xirr){
                Leaf.showErrorMessage('提示', '变更后XIRR需大于变更前XIRR！');
                return;
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/req/partial/prepayment/approve',
                para: {change_req_id: '${/parameter/@change_req_id}'},
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $('${/parameter/@winid}').close();
                    if (res.success) {
                        Leaf.showMessage('提示', '提交审批成功!');
                    }
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }
            });
        };

        //计算按钮
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
                var con_contract_result_ds = $(ds_id);
                var record = con_contract_result_ds.getAt(0);

                var con_contract_req_ds = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req'));
                var change_record = con_contract_req_ds.getAt(0);
                var data = {};
                data.config = [{
                    field: 'change_start_date',
                    force: 'Y',
                    value: change_record.get('change_start_date')
                }, {
                    field: 'change_principal',
                    force: 'Y',
                    value: change_record.get('change_principal')
                }, {
                    field: 'lease_charge',
                    force: 'Y',
                    value: change_record.get('lease_charge')
                },{
                    field: 'ccr_start_times',
                    force: 'Y',
                    value: change_record.get('ccr_start_times')
                }, {
                    field: 'times',
                    force: 'Y',
                    value: change_record.get('times')
                }];
                data.price_list = con_contract_req_ds.data[0].data.price_list;

                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/con/contract/change/req/partial/prepayment/recalculate?documentId=' + change_req_id + '&quotationId=' + quotation_id,
                    para: data,
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')).query();
                        $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')).query();
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }.bind(this));
        };

        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';

            if (ds.queryurl.indexOf('history_flag') === -1) {
                ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';

            var con_contract_attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if(ds.id == con_contract_attachment_ds_id){
                ds.setQueryParameter('contract_id', contract_id);
                ds.setQueryParameter('source_id', change_req_id);
                ds.setQueryParameter('contract_attachment_category','CON_CONTRACT_PREPAYMENT_CHANGE');
            }

            if (ds.bindname == "${/parameter/@layout_code}_G_CASHFLOW_PRE_con_contract_cashflow") {

                if ('${/parameter/@status}' == 'APPROVED') {
                    ds.setQueryParameter('__preVersion', "Y");
                    ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
                } else {
                    ds.setQueryParameter('contract_id', contract_id);
                }

            } else {
                if (ds.queryurl.indexOf('history_flag') === -1) {
                    ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_id', documentId), 'document_history_flag', 'Y');
                }
            }

        };

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            var documentId = '${/parameter/@change_req_id}';
            var documentCategory = '${/parameter/@document_category}';
            var submitUrl = $('${/parameter/@layout_code}_virtual_ds').submiturl;
            if (submitUrl.indexOf('document_history_flag') === -1) {
                submitUrl = splitparameter(
                    splitparameter(
                        splitparameter(submitUrl, 'document_id', documentId),
                        'document_history_flag', 'Y'),
                    'document_category', documentCategory);
            }
            $('${/parameter/@layout_code}_virtual_ds').submiturl = submitUrl;
            return check_flag;
        };

        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                }
                else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            if (ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')) {
                ds.data.forEach(function (value) {
                    //value.get('generated_source_doc_id') != '${/parameter/@quotation_id}' && ds.removeLocal(value);
                })
            }
        };

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if(ds.id === get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')){
                //calcPreAmount();
            }
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var con_contract_attachment = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            if (con_contract_attachment === ds.id) {
                record.set('contract_id', contract_id);
                record.set('source_id', change_req_id);
                record.set('contract_attachment_category', 'CON_CONTRACT_PREPAYMENT_CHANGE');
            }
        };

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            /*var change_req_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            if(name == 'due_date'){
                var datas = {
                    due_date: record.get("due_date"),
                    change_req_id: record.get("change_req_id")
                };
                $L.Masker.mask(Ext.getBody(),"查询数据中");
                Leaf.request({
                    url: $("cont301f10_contract_change_pre_payment_link").getUrl(),
                    para: datas,
                    success: function (res) {
                        $L.Masker.unmask(Ext.getBody());
                        if(res && res.result && res.result.record){
                            var data =  res.result.record[0];
                            for(var v in data){
                                record.set(v,data[v]);
                            }
                        }
                    }
                })
            }
            if(name == 'deposit_deduct_flag'){
                calcPreAmount();
            }
            if(name == 'period_interest_change'){
                calcPreAmount();
            }
            if(name == 'penalty_interest'){
                calcPreAmount();
            }
            if (name === 'et_fee'){
                calcPreAmount();
            }*/
        };
        function calcPreAmount(){
            var change_req_ds = get_dsid_by_basetable(window['${/parameter/@bp_seq}${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            var record = $(change_req_ds).getCurrentRecord();
            var totalAmount = plus(record.get("overdue_amount"),record.get("outstanding_principal"));
            totalAmount = plus(totalAmount,record.get("period_interest_change"));
            totalAmount = plus(totalAmount,record.get("penalty_interest"));
            totalAmount = plus(totalAmount,record.get("nominal_price"));
            if (record.get("et_fee")){
                totalAmount = plus(totalAmount,record.get("et_fee"));
            }
            if(record.get("deposit_deduct_flag") == 'Y'){
                totalAmount = minus(totalAmount,record.get('deposit'));
            }

            record.set('pre_amount', totalAmount);
        }

        //计算
        function calcAfterSave(){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var con_contract_result_ds = $(ds_id);
            var record = con_contract_result_ds.getAt(0);

            var con_contract_req_ds = $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req'));
            var change_record = con_contract_req_ds.getAt(0);
            var data = {};
            data.config = [{
                field: 'change_start_date',
                force: 'Y',
                value: change_record.get('change_start_date')
            }, {
                field: 'change_principal',
                force: 'Y',
                value: change_record.get('change_principal')
            },{
                field: 'lease_charge',
                force: 'Y',
                value: change_record.get('lease_charge')
            }, {
                field: 'ccr_start_times',
                force: 'Y',
                value: change_record.get('ccr_start_times')
            }, {
                field: 'times',
                force: 'Y',
                value: change_record.get('times')
            }];
            data.price_list = con_contract_req_ds.data[0].data.price_list;

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: '${/request/@context_path}/con/contract/change/req/partial/prepayment/recalculate?documentId=' + change_req_id + '&quotationId=' + quotation_id,
                para: data,
                success: function (res) {
                    Leaf.SideBar.show({
                        msg: '${l:HLS.SUBMIT_SUCCESS}',
                        duration: 2000
                    });
                    $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow')).query();
                    $(get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req')).query();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });
        }

        //保存submitsuccess调用
        /*window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            calcAfterSave();

        };*/

        Leaf.onReady(function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment');
            var submiturl = $(ds_id).submiturl;
            submiturl = splitUrlParameter(submiturl, 'document_id', '${/parameter/@change_req_id}');
            submiturl = splitUrlParameter(submiturl, 'document_history_flag', 'Y');
            submiturl = splitUrlParameter(submiturl, 'document_category', '${/parameter/@document_category}');
            $(ds_id).submiturl = submiturl;
        });

        //debugger
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK']=function(nextStep){
            debugger;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var root_ds=$('${/parameter/@bp_seq}${/parameter/@layout_code}_virtual_ds');
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_ignore_required_before_save']();
            if (root_ds.validate()) {
                var winid = 'con_contract_tenant_window_id';
                var root_record = root_ds.getCurrentRecord();
                root_ds.setSubmitParameter('layout_code', '${/parameter/@bp_seq}${/parameter/@layout_code}');
                function ON_LAYOUT_DYNAMIC_BEFORE_SAVE(){
                    root_ds.un('beforesubmit',ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                    var flag = false;
                    for (var name in root_record.data) {
                        if (root_record.data[name].data.length > 0 && root_record.data[name].data[0].ds && root_record.data[name].data[0].ds instanceof $L.DataSet) {
                            var current_record = root_record.data[name].data[0].ds.getCurrentRecord();
                            flag = window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'](root_record.data[name].data[0].ds, current_record);
                        }
                    }
                    if(!flag){
                        UN_SUBMIT_REF_FUNCTION();
                    }
                    return flag;
                }

                function UN_SUBMIT_REF_FUNCTION(){
                    root_ds.un('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                    root_ds.un('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                    root_ds.un('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);
                }

                function ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS(ds, res) {
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'](ds,root_record,res);
                    if (typeof(nextStep) == 'function') {
                        nextStep(ds);
                    }
                }
                function ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED(){
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }
                function ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR(){
                    UN_SUBMIT_REF_FUNCTION();
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                }
                root_ds.on('beforesubmit',ON_LAYOUT_DYNAMIC_BEFORE_SAVE);
                root_ds.on('submitsuccess', ON_LAYOUT_DYNAMIC_INNER_SUBMITSUCCESS);
                root_ds.on('submitfailed', ON_LAYOUT_DYNAMIC_INNER_SUBMITFAILED);
                root_ds.on('submiterror', ON_LAYOUT_DYNAMIC_INNER_SUBMITERROR);

                root_ds.submit();
            }else{
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }
        };

        //不规则报价变更后现金流导入
        window['${/parameter/@layout_code}_user_button4_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_change_req');
            var record = $(ds_id).getCurrentRecord();
            var change_req_id = record.get('change_req_id');
            new Leaf.Window({
                id: 'cont340_cashflow_import_win_id',
                params: {
                    win_id: 'cont340_cashflow_import_win_id',
                    change_req_id: change_req_id
                },
                url: $('cont340_cashflow_import_link_id').getUrl(),
                title: '现金流导入',
                width: 430,
                height: 360
            });
        };
        // 附件导出
        window['${/parameter/@layout_code}_T_ATTACHMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'T_ATTACHMENT');
            var records = $(ds_id).getSelected();
            if (records.length == 0) {
                Leaf.showMessage("提示", "请选择需要导出的附件!", null);
                return;
            }

            var exportList = [];

            for (var i = 0; i < records.length; i++) {
                debugger;
                if(records[i].get('attachment_id') != null){
                    for(var item of records[i].get('attachment_id').split(",")) {
                        exportList.push(item);
                    }
                }
            }

            if(exportList.length == 0){
                Leaf.showMessage("提示", "无附件可导出!", null);
                return;
            }
            exportList.forEach(function(item, index) {
                setTimeout(()=>{
                    var a = document.createElement('a');
                    a.href = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + item;
                    a.download = 'filename';
                    a.click();
                },1000 * index)
            })
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

    </a:view>
</a:screen>

