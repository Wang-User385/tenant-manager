<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="CON_CONTRACT_CASHFLOW"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>

    <a:view>
        <a:link id="cont340_con_cashflow_import_link_id" url="${/request/@context_path}/con/contract/change/prepayment/cashflow/import"/>
        <script><![CDATA[
        parent.Leaf.request({
            url: $('cont340_con_cashflow_import_link_id').getUrl() + "?headerId=${/model/header/record/@header_id}",
            para: {
                headerId : '${/model/header/record/@header_id}',
                changeReqId: '${/parameter/@change_req_id}'
            },
            success: function (res) {
                parent.$L.Masker.unmask(parent.Ext.getBody());
                parent._file_upload_window.close();
                parent.$("CONT340F2_G_CASHFLOW_con_contract_cashflow_ds").query();
                parent.$("CONT340F2_F_CHANGE_con_contract_change_req_ds").query();
                parent.$L.showMessage("提示", "导入成功");
            },
            failure: function (datas) {
                parent.$L.Masker.unmask(parent.Ext.getBody());
                parent._file_upload_window.close();
            },
            error: function (datas) {
                parent.$L.Masker.unmask(parent.Ext.getBody());
                parent._file_upload_window.close();
            },
            scope: this
        });

        ]]></script>

        <a:screenBody>

        </a:screenBody>
    </a:view>
</a:screen>
