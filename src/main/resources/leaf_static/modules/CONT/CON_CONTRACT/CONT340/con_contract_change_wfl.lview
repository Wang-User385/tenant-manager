<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="${/parameter/@layout_code}_change_partial_prepayment_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT340/con_contract_change_partial_prepayment.lview"/>
        <script><![CDATA[
        debugger;
        var list = parent.currentTaskInfo.execution_variables;
        var param;
        var contract;
        var nodeId = parent.currentTaskInfo.task_definition_key;
        for (var i = 0; i < list.length; i++) {
            if (list[i].name === 'contractChangeReq') {
                param = JSON.parse(list[i].value);
            } else if (list[i].name === 'contract') {
                contract = JSON.parse(list[i].value);
            }
        }
        window['${/parameter/@layout_code}_change_type'] = {
            PARTIAL_PREPAYMENT: {
                function_code: 'CONT340F2',
                url_title: '合同变更-大单提前部分还本'
            }
        };

        $jq.extend(param, window['${/parameter/@layout_code}_change_type'][param.changeType]);
        winId = 'con_contract_' + param.changeType.toLowerCase() + '_window_id';
        var link_id = '${/parameter/@layout_code}_change_' + param.changeType.toLowerCase() + '_link_id';


        var maintain_type = 'READONLY';
        var function_usage = 'QUERY';
        var wflurl=$(link_id).getUrl();
        //退回经办人节点可以编辑
        if(parent.currentTaskInfo.task_definition_key == "sid-rHAU6o6D-6QbN-4laU-89LQ-cSSMgkK3aMmb"  ){
            maintain_type = 'UPDATE';
            function_usage = 'MODIFY';
        }

        var pageChooser = new PageChooser({
            url: wflurl,
            function_code: param.function_code,
            context_path: '${/request/@context_path}',
            opt: {
                function_code: param.function_code,
                change_req_id: param.changeReqId,
                quotation_id: param.quotationId,
                contract_id: param.contractId,
                document_category: 'CONTRACT_CHANGE',
                maintain_type: maintain_type,
                function_usage: function_usage
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

