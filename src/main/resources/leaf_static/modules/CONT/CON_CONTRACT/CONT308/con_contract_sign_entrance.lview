<!--
    Author: huangtianyang
    Date: 2019/02/19 16:37
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="con_contract_detail_id2"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="con_contract_detail_frame_id2"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_frame_detail.lview"/>
        <a:link id="cont301f10_contract_change_info_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301F10/cont301f10_contract_change_info.lview"/>

        <a:link id="CONT301F0_CONT_CREATE_ID" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_create.lview"/>
        <a:link id="CONT301F31_DELAY_RENT_LINK_ID" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_delay.lview"/>
        <a:link id="CONT301F4_con_contact_cancel_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_cancel.lview"/>

        <script><![CDATA[




        function open_contract_detail_win(record_id, ds_id) {
            var record = $(ds_id).findById(record_id).data;
            var param={};
            param['project_id'] = record.project_id;

            param['url_title'] = '合同明细';
/*
            param['function_code'] = 'CONT301F1';
*/
            param['winid'] = 'con_contract_detail_winid2';
            //param['layout_debugger_flag'] = 'Y';
            debugger;
         if(param['purchase_frame']=='Y'){
             if (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN'&& param['contract_status'] !== 'REJECTED') {
                 param['maintain_type'] = 'READONLY';
                 param['function_usage'] = 'QUERY';
                 param['function_code'] = 'CONT301F1K';


             }else{
                 param['maintain_type'] = 'MODIFY';
                 param['function_usage'] = 'MODIFY';
                 param['function_code'] = 'CONT301F1K';
             }
             hls_doc_get_layout_code(param, 'con_contract_detail_frame_id2', ds_id, 'CONT301');

         }else {
             debugger;
             if (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN' && param['contract_status'] !== 'REJECTED') {
                 param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];

                 param['maintain_type'] = 'READONLY';
                 param['function_usage'] = 'QUERY';
                 param['function_code'] = 'CONT301F1WFLNEW';
             }else{
                 param['maintain_type'] = 'MODIFY';
                 param['function_usage'] = 'MODIFY';
                 param['function_code'] = 'CONT301F1';
             }
             hls_doc_get_layout_code(param, 'con_contract_detail_id2', ds_id, 'CONT301');

         }
        }


        window['con_upload'] = function (record_id, ds_id) {
        //debugger;

            var prj_attach_record = $(ds_id).findById(record_id);
            var project_attachment_id = prj_attach_record.get('project_attachment_id');

            var url;
var  function_usage;
            if('${/parameter/@file_flag}' == 'Y'){
                url = '${/request/@context_path}/uploadFile.lview';
                function_usage ='MODIFY'

            } else {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage ='QUERY'
            }

            var table_name = 'FCT_PROJECT_ATTACHMENT_SIGN';

            var win = new Leaf.Window({
                id: 'cont305_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table_name,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });

        };
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }

           else if(name === 'file_name_sign'&& record.get('project_attachment_id')){
                link_function = 'con_upload';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">附件上传</a>';
            }
        };
        //重置并查询
        window['${/parameter/@layout_code}_RESET_LAYOUT_DYNAMIC_CLICK'] = function() {
            for(var i=0;i<window['${/parameter/@layout_code}_layoutDataSetList'].length;i++){
                if(!$(window['${/parameter/@layout_code}_layoutDataSetList'][i]).queryurl){
                    $(window['${/parameter/@layout_code}_layoutDataSetList'][i]).reset();
                }
            }
            for(var i=0;i<window['${/parameter/@layout_code}_layoutDataSetList'].length;i++){
                if($(window['${/parameter/@layout_code}_layoutDataSetList'][i]).queryurl&&$(window['${/parameter/@layout_code}_layoutDataSetList'][i]).submiturl){
                    $(window['${/parameter/@layout_code}_layoutDataSetList'][i]).query();
                }
            }
        };




        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'G_CON');
            var record = $(ds_id).getCurrentRecord();
            debugger;
            var ds_line_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            if (record.get('con_application_change_status') == 'NEW' || record.get('con_application_change_status') == 'APPROVED_RETURN' ||record.get('con_application_status') == 'REJECTED') {
                if ($(ds_line_id).validate()) {
                    var data = [];
                    var records_line = $(ds_line_id).getAll();
                    if (records_line.length) {
                        for (var i = 0; i < records_line.length; i++) {
                            if (records_line[i].dirty) {
                                data.push(records_line[i].data);
                            }
                        }
                        $(ds_line_id).submit();
                    }
                    // 添加确认提示
                    new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                        Leaf.request({
                            url: '${/request/@context_path}/hls/cus/prj/contract/sign/wfl',
                            para: {project_id: record.get('project_id')},
                            success: function (res) {
                                $(ds_id).query();
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                            },
                            failure: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            error: function () {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            scope: this
                        });
                    })
                }

            }else{
                $L.showInfoMessage("提示", "审批中和审批通过的单据不允许再次提交!");
                return;
            }

        };



        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
debugger;
            var prj_project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project','G_CON');
            if(ds.id == prj_project_ds_id){
                ds.setQueryParameter('contract_status','APPROVED');

            }


            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';

        };


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var prj_project_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project','G_CON');

            if (ds.id == prj_project_ds_id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }

            var prj_project_ds_id_1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment','G_FILE');
            if(ds.id == prj_project_ds_id_1){
                ds.setQueryParameter('source_type','HLS_DURATION_HD');

            }

        }
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {

            var att_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var  head=$(att_ds_id2).getCurrentRecord();
            if(ds.id == att_ds_id2&&record) {
            debugger;
                if (head.get('con_application_status') == 'APPROVED' || head.get('con_application_status') == 'APPROVING') {
                    var line = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
                    var record = $(line).getAll();
                    for (var i = 0; i < record.length; i++) {

                        record[i].getField('underwrite_description').setReadOnly(true);


                    }
                } else {
                    var line = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
                    var record = $(line).getAll();
                    for (var i = 0; i < record.length; i++) {

                        record[i].getField('underwrite_description').setReadOnly(false);


                    }
                }

            }
        };


        function beforeSubmit(countiune) {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            if($(ds_id).validate()) {
                $(ds_id).submit();
                countiune();
                return true;

            }else{
                return false;
            }

        };
        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    