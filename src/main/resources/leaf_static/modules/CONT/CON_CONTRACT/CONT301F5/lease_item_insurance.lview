<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            if (ds.id == '${/parameter/@layout_code}_D_GRID_con_lease_item_insurance_ds') {
                record.set("con_lease_item_id", '${/parameter/@con_lease_item_id}');
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var documentId = '${/parameter/@document_id}';
            var change_flag = '${/parameter/@change_flag}';
            if (change_flag == 'N') {
                if ('${/parameter/@status}' == 'APPROVED') {
                    ds.setQueryParameter('__preVersion', "Y");
                    ds.queryurl = splitparameter(splitparameter(ds.queryurl, 'document_history_flag', 'Y'), 'document_id', documentId);
                } else {
                    ds.setQueryParameter('con_lease_item_id', '${/parameter/@con_lease_item_id}');
                }
            }else {
                var obj = urlSearch(ds.submiturl);
                obj.document_id = '${/parameter/@document_id}';
                obj.document_history_flag = '${/parameter/@document_history_flag}';
                obj.document_category = '${/parameter/@document_category}';
                obj.parent_table = '${/parameter/@parent_table}';
                obj.parent_base_table_pk = '${/parameter/@parent_base_table_pk}';
                var submitUrl = ds.submiturl.split('?')[0];
                for (var k in obj) {
                    submitUrl = splitparameter(submitUrl, k, obj[k]);
                }
                ds.submiturl = submitUrl;

                if (ds.queryurl.indexOf('history_flag') === -1) {
                    ds.queryurl = splitparameter(
                        splitparameter(
                            ds.queryurl,
                            'document_id',
                            '${/parameter/@document_id}'
                        ),
                        'document_history_flag',
                        '${/parameter/@document_history_flag}'
                    )
                }
                if (ds.id == '${/parameter/@layout_code}_D_GRID_con_lease_item_insurance_ds') {
                    qpara['con_lease_item_id'] = '${/parameter/@con_lease_item_id}';
                }
            }
        };

        function splitparameter(aUrl, key, value) {
            // return aUrl.indexOf('?') > -1 ? aUrl + '&' + key + '=' + value : aUrl + '?' + key + '=' + value;
            // url1或url2里如果有$，再根据是否有参数做处理
            if (aUrl.indexOf('$') > -1) {
                if (aUrl.indexOf('=') > -1) {
                    return aUrl + '&' + key + '=' + value;
                } else {
                    return aUrl + key + '=' + value;
                }
            }
            if (aUrl.indexOf('?') > -1) {
                return aUrl + '&' + key + '=' + value;
            }
            if (aUrl.indexOf('$') === -1 && aUrl.indexOf('?') === -1) {
                return aUrl + '?' + key + '=' + value;
            }
        }

        function urlSearch(url) {
            var obj = {};
            var name, value;
            var str = url; //取得整个地址栏
            var num = str.indexOf("?");
            str = str.substr(num + 1); //取得所有参数   stringvar.substr(start [, length ]

            var arr = str.split("&"); //各个参数放到数组里
            for (var i = 0; i < arr.length; i++) {
                num = arr[i].indexOf("=");
                if (num > 0) {
                    name = arr[i].substring(0, num);
                    value = arr[i].substr(num + 1);
                    obj[name] = value;
                }
            }
            return obj;
        }

        ]]></script>
    </a:view>
</a:screen>
