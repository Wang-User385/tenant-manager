<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="contract_loan_detatil_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT616/loan_con_factoring_modify_detail.lview"/>
        <a:link id="con_factoring_loan_main_add"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT616/loan_con_factoring_add.lview"/>
        <a:link id="occ_amount_detatil_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT616/virtual_con_factoring_loan_list.lview"/>
        <a:link id="detail_amount_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT616/credit_plan_line_list.lview"/>
        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            var link_function = '';
            if (name == 'contract_number') {
                link_function = 'contract_loan_detatil_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            } else if (name == 'occ_amount') {
                link_function = 'occ_amount_detatil_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">占用详情</a>';
            } else if (name == 'detail_amount') {
                link_function = 'detail_amount_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">明细额度详情</a>';
            }
        };

        //合同审批明细页面
        function contract_loan_detatil_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['contract_id'] = record.get('contract_id');
            param['url_title'] = '保理申请明细页面';
            param['function_code'] = 'CON616F1';
            param['winid'] = 'contract_loan_detatil_winid';
            var maintain_type = 'UPDATE';
            var function_usage = 'MODIFY';
            if (record.get('contract_status') != 'NEW' && record.get('contract_status') != 'REJECTED') {
                maintain_type = 'READONLY';
                function_usage = 'QUERY';
            }
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            hls_doc_get_layout_code(param, 'contract_loan_detatil_link_id', ds_id, 'CONT616');
        }

        //占用详情明细页面
        function occ_amount_detatil_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['contract_id'] = record.get('contract_id');
            param['url_title'] = '占用详情明细页面';
            param['function_code'] = 'CON616_LOAN';
            param['winid'] = 'occ_amount_detatil_winid';
            var maintain_type = 'READONLY';
            var function_usage = 'QUERY';
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            hls_doc_get_layout_code(param, 'occ_amount_detatil_link_id', ds_id, 'CONT616');
        }

        //明细额度详情页面
        function detail_amount_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['contract_id'] = record.get('contract_id');
            param['url_title'] = '明细额度详情页面';
            param['function_code'] = 'CON616_CREDIT';
            param['winid'] = 'detail_amount_winid';
            var maintain_type = 'READONLY';
            var function_usage = 'QUERY';
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            hls_doc_get_layout_code(param, 'detail_amount_link_id', ds_id, 'CONT616');
        }

        //创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var param = {};
            param['maintain_type'] = 'UPDATE';
            param['function_usage'] = 'MODIFY';
            param['url_title'] = '放款申请创建';
            param['function_code'] = 'CON616F2';
            param['proposer_user_id'] = '${/session/@user_id}';
            param['winid'] = 'con_factoring_loan_add_winid';
            param['screen_width'] = 800;
            param['screen_height'] = 615;
            hls_doc_get_layout_code(param, 'con_factoring_loan_main_add', null, 'CONT616');
        };

        //删除
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            if (records.length === 0) {
                Leaf.showErrorMessage('提示', '请选择所需关闭的单据！');
                return;
            }
            var delete_data = [];
            for (let i = 0; i < records.length; i++) {
                var record = records[i];
                if (record.get('contract_status') != 'NEW') {
                    Leaf.showErrorMessage('提示', '非新建状态的单据，无法关闭!');
                    return;
                }
                delete_data.push(record.data);
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/hls/con/factoring/batch/delete",
                para: delete_data,
                success: function (res) {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(ds_id).query();
                    Leaf.showSuccessMessage('提示', '删除成功');
                },
                error: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                sync: true
            });
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>