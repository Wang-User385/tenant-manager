<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="credit_detail_amount_open_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT616/credit_plan_line_loan_list.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            var link_function = '';
            if (name == 'detail_amount') {
                link_function = 'credit_detail_amount_open';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">明细额度暂用详情</a>';
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_credit_plan_line', 'G_METHOD_DETAIL');
            if (ds.id == ds_id) {
                $(ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
            }
        }

        //明细额度暂用详情
        function credit_detail_amount_open(record_id, ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['project_id'] = record.get('project_id');
            param['contract_id'] = record.get('contract_id');
            param['url_title'] = '明细额度暂用详情';
            param['function_code'] = 'CON616_CREDIT_LOAN';
            param['winid'] = 'credit_detail_amount_open_winid';
            var maintain_type = 'READONLY';
            var function_usage = 'QUERY';
            param['maintain_type'] = maintain_type;
            param['function_usage'] = function_usage;
            hls_doc_get_layout_code(param, 'credit_detail_amount_open_link_id', ds_id, 'CON616_CREDIT');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>