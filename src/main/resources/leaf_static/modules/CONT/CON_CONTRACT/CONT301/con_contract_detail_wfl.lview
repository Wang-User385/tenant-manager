        //报价计算入口
        window['${/parameter/@layout_code}_quotation_calc_layout_dynamic_click'] = function () {
            if(!$('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').validate()){
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;

            Leaf.Masker.unmask(Ext.getBody());
            //带入数据后打开excel
            var win = new Leaf.Window({
                id: 'hls900_open_price_winid',
                url: url,
                title: 'excel测算',
                fullScreen: true
            });
            win.on('close', function () {
                $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
                $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
            });

        }

        //报价计算

        window['${/parameter/@layout_code}_quotation_close_query'] = function(){
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow');
            $(quotation_ds_id).query();
            $(cashflow_ds_id).query();
        }
        //授信审批通知书
        window['${/parameter/@layout_code}_prj_notice_id_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id).getCurrentRecord();
            var param = {};
            param['url_title'] = '授信审批通知书';
            param['function_code'] = 'PRJ316T1';
            param['winid'] = 'project_credit_notice_id';
            param['function_usage'] = 'QUERY';
            param['maintain_type'] = 'READONLY';
            param['project_id'] = record.get('ref_project_id');

            //param['screen_width'] = '600';
            //param['side'] = 'right';
            hls_doc_get_layout_code(param, 'project_credit_credit_notice_link2', ds_id, 'CONT301F1');

        }
        //价格审批通知书
        window['${/parameter/@layout_code}_price_review_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var record = $(ds_id).getCurrentRecord();
            var param = {};
            param['url_title'] = '价格审批记录';
            param['function_code'] = 'RPT710F1';
            param['winid'] = 'project_credit_notice_id';
            param['project_id'] = record.get('ref_project_id');
            //param['function_usage'] = 'QUERY';
            //param['maintain_type'] = 'READONLY';

            hls_doc_get_layout_code(param, 'rpt710_project_price_review_id2', ds_id, 'CONT301F1');

        }
        function beforeSubmit(countiune) {
            if('${/parameter/@finalized_flag}' == 'true'){
                var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment','G_FILE_END');

                var checkAttachFlag = 'Y';
                var attachmentRecord =  $(con_file_ds).getAll();
                for( var i = 0 ; i < attachmentRecord.length ; i ++ ){
                    if(attachmentRecord[i].get('file_name') == 'undefined' || attachmentRecord[i].get('file_name') == '' || attachmentRecord[i].get('file_name') == undefined){
                        checkAttachFlag = 'N';
                    }
                }

                if(checkAttachFlag == 'N'){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "请在<b>【合同文本】</b>处上传文件</b>!");
                    return ;
                }else{
                    $L.Masker.unmask(document.body);
                    countiune();
                }
            }else
            if('${/parameter/@finalized_flag}' == 'Y'){
                $L.Masker.mask(document.body);

                Leaf.request({
                    url: '${/request/@context_path}/ct/fct/project/attachment/contentFinalized',
                    para: {
                        project_id : '${/parameter/@project_id}'
                    },
                    success: function (datas) {
                        $L.Masker.unmask(document.body);
                        countiune();
                    },
                    failure: function () {
                        $L.Masker.unmask(document.body);

                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                    },
                    sync: true,
                    scope: this
                });
            }else {
                countiune();
            }
        };

        //合同审批单
        window['${/parameter/@layout_code}_user_button6_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');

            var record = $(ds_id).getCurrentRecord();
            var projectId = record.get('project_id');
            //模板类型代码
            var code = "CON_APPROVAL";
            var url = "${/request/@context_path}/prj/simple/doc/gen?code=" + code + "&projectId=" + projectId;
            //window.location.href = url;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        ]]></script>

