<!--
    Author: huangtianyang
    Date: 2019/02/26 11:06
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_payment_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_payment_detail.lview"/>
        <a:link id="con_contract_payment_create_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_payment_create.lview"/>
        <a:link id="cont301_quotation_history_entrance_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301H1/con_quotation_history_entrance.lview"/>
        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('project_id', '${/parameter/@project_id}');
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_payment_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'payment_req_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_payment_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var record = $(ds_id).findById(record_id);
            param['url_title'] = '租赁放款申请';
            param['function_code'] = 'CONT301F24';
            param['contract_id'] = record.get('contract_id');
            param['project_id'] = '${/parameter/@project_id}';
            param['payment_req_id'] = record.get('payment_req_id');
            if(record.get('payment_req_status') == 'APPROVED'||record.get('payment_req_status') == 'APPROVING'||record.get('payment_req_status') == 'ABANDON'){
                param['function_usage'] = 'QUERY';
            }
            param['funding_plan_id'] = record.get('funding_plan_id');
            param['winid'] = 'con_contract_payment_detail_winid';
            hls_doc_get_layout_code(param, 'con_contract_payment_detail_id', ds_id, 'CONT301F23');
        }

        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var param = {};
            param.project_id = '${/parameter/@project_id}';
            param['url_title'] = '租赁放款申请创建';
            param['payment_req_id'] = '';
            param['function_code'] = 'CONT301F23F1';
            param['winid'] = 'con_contract_payment_create_winid';
            hls_doc_get_layout_code(param, 'con_contract_payment_create_id', ds_id, 'CONT301F23');



        };

        //历史报价查看
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var records = $(ds_id).getSelected();


            if (records.length != 1) {
                $L.showInfoMessage("提示", "请选择一条记录查看版本!");
                return false;
            }
            var project_status = records[0].get('payment_req_status');
            if (project_status == 'NEW' || project_status == 'APPROVING') {
                $L.showInfoMessage("提示", "该付款申请为新建项目或正在审批中，未发生过报价变更!");
                return false;
            }

            var param = {}, function_code = 'CONT301H1';
            param['url_title'] = '项目明细';
            param['contract_id'] = records[0].data.contract_id;
            param['winid'] = 'quotation_history_entrance_winid';
            param['function_code'] = function_code;
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['screen_width']='900';
            param['side']='right';
            // console.log(param);
            hls_doc_get_layout_code(param, 'cont301_quotation_history_entrance_id', ds_id, function_code);
        };



        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    