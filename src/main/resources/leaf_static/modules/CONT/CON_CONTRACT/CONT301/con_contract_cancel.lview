<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>

        <script><![CDATA[

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            record.set('cancel_date', new Date())
            record.set('cancel_person_name', '${/session/@employeeName}')
        };

        window['${/parameter/@layout_code}_cancel_layout_dynamic_click'] = function () {
            $L.Masker.mask(document.body, "关闭中..");
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var projectRecord = $(project_ds).getAt(0);
            var param = {};
            param.cancel_date = projectRecord.get("cancel_date");
            param.cancel_person_name = projectRecord.get("cancel_person_name");
            param.cancel_reason = projectRecord.get("cancel_reason");
            param.project_id = projectRecord.get("project_id");
            Leaf.request({
                url: "${/request/@context_path}/prj/project/cancel/info/cancel",
                para: param,
                success: function (r) {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "关闭成功!", function(){
                        $('${/parameter/@winid}').close();
                    });
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "关闭出错!", null);
                },
                scope: this
            });
        };




        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    