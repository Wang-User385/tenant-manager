<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="rptm001_create_contract_plan_link_id" url="${/request/@context_path}/create/contract/plan/by/project"/>
        <a:link id="rptm001_exit_contract_check_id" url="${/request/@context_path}/contract/rentmake/exit/check"/>
        <a:link id="rptm001_delete_contract_plan_link_id" url="${/request/@context_path}/delete/contract/plan"/>
        <a:link id="rptm001_confirm_contract_plan_link_id" url="${/request/@context_path}/contract/plan/confirm"/>
        <a:link id="hls200_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>


        <script><![CDATA[

        //报价计算 ，跳转在线ecxel
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            if($(quotation_grid_ds_id).validate()  ) {
                if ($(quotation_grid_ds_id).isModified()) {
                    Leaf.showMessage("提示", "请先保存记录!");
                    return;
                } else {
                    if ($(quotation_grid_ds_id).getSelected().length == 0) {
                        Leaf.showMessage("提示", "请选择一条记录进行报价!");
                        return;
                    }

                    var quotationRecord = $(quotation_grid_ds_id).getCurrentRecord();
                    var quotation_id = quotationRecord.get('quotation_id');
                    var price_list = quotationRecord.get('price_list');
                    var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
                    if (quotationRecord.get("payment_status") == 'CONFIRM') {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        url = url + '&readOnly=Y';
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        return;
                    }

                    if (quotation_id != null) {

                        Leaf.request({
                            url: $('hls200_quotation_calc_submit_link_id').getUrl() + "?quotationId="+quotation_id,
                            type: "GET",
                            success: function (res) {
                                Leaf.SideBar.show({
                                    msg: '计算成功',
                                    duration: 2000
                                });
                                Leaf.Masker.unmask(Ext.getBody());
                                //带入数据后打开excel
                                var win = new Leaf.Window({
                                    id: 'hls900_open_price_winid',
                                    url: url,
                                    title: 'excel测算',
                                    fullScreen: true
                                });
                                win.on('close', function () {
                                    $(quotation_grid_ds_id).query();
                                });
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });

                    } else {
                        Leaf.showMessage("提示", "请先保存投放计划表!", null);
                        return false;
                    }
                }
            }

        }

        //投放计划确认
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            if($(quotation_grid_ds_id).validate()  ){
                if($(quotation_grid_ds_id).isModified()){
                    Leaf.showMessage("提示", "请先保存记录!");
                    return;
                }else{
                    var datas = $(quotation_grid_ds_id).getSelectedJson();

                    if (datas.length == 0) {
                        $L.showInfoMessage("提示", "请选择要确认的投放计划表!");
                        return;
                    }
                    $L.showConfirm("提示", "请核对该笔投放计划的预计放款日和放款金额，确认后将无法修改/删除，是否执行？", function () {
                        window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                        var checkFlag = true;
                        var arr = [];
                        for (var i = 0; i < datas.length; i++) {
                            arr.push({
                                quotation_id: datas[i].quotation_id,
                                source_document_id : datas[i].source_document_id,
                                project_id: '${/parameter/@project_id}'
                            });
                            if (datas[i].payment_status != 'NEW' && datas[i].payment_status != '' && datas[i].payment_status != null  && datas[i].payment_status  != undefined) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                checkFlag = false;
                                Leaf.showWarningMessage('提示', '只有新建状态的租金支付表才可以进行确认!');
                                return;
                            }
                        }
                        if(checkFlag){
                            Leaf.request({
                                url: $('rptm001_confirm_contract_plan_link_id').getUrl(),
                                para: arr,
                                success: function (res) {
                                    $L.showInfoMessage("提示", "已经确认!");
                                    $(quotation_grid_ds_id).query();
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        }
                    }, function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    });
                }

            }

        };

        window['${/parameter/@layout_code}_EXIT_LAYOUT_DYNAMIC_CLICK'] = function () {


        }

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {

        };
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW_INFO');
            var quotation_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_one','F_FINANCE_CON');
            if (ds.id == quotation_grid_ds_id && record) {
                if (record.get('payment_status') == 'CONFIRM') {
                    record.getField('loan_type').setReadOnly(true);
                    record.getField('loan_type_n').setReadOnly(true);
                    record.getField('price_list').setReadOnly(true);
                    record.getField('price_list_n').setReadOnly(true);
                    record.getField('lease_item_amount_org').setReadOnly(true);
                    record.getField('exchange_rate').setReadOnly(true);
                    record.getField('lease_item_amount').setReadOnly(true);
                    record.getField('base_rate_collect_n').setReadOnly(true);
                    record.getField('base_rate_collect').setReadOnly(true);
                    record.getField('payment_method_note').setReadOnly(true);
                    record.getField('currency').setReadOnly(true);
                    record.getField('currency_n').setReadOnly(true);

                }

            }
            if (ds.id == quotation_form_ds_id) {
                var quotation_id = $(quotation_grid_ds_id).getCurrentRecord().get("quotation_id");
                $(quotation_form_ds_id).setQueryParameter('quotation_id', quotation_id);
                $(quotation_form_ds_id).query();
            }

            if (ds.id == cashflow_ds_id) {
                var quotation_id = $(quotation_grid_ds_id).getCurrentRecord().get("quotation_id");
                $(quotation_form_ds_id).setQueryParameter('quotation_id', quotation_id);
                $(quotation_form_ds_id).query();
            }


        }
        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

        };

        //租金支付表新增
        window['${/parameter/@layout_code}_G_RENT_PAYMENT_USER_BUTTON3_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            var datas = [{source_document_id:'${/parameter/@project_id}'}];
            Leaf.request({
                url: $('rptm001_create_contract_plan_link_id').getUrl(),
                para: datas,
                success: function (res) {

                    $(quotation_grid_ds_id).query();
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(quotation_grid_ds_id).query();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(quotation_grid_ds_id).query();
                },
                scope: this
            });
        }

        //租金支付表保存
        window['${/parameter/@layout_code}_G_RENT_PAYMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            var datas = $(quotation_grid_ds_id).getJsonData();
            Leaf.request({
                url: $('rptm001_create_contract_plan_link_id').getUrl(),
                para: datas,
                success: function (res) {
                    $L.showInfoMessage("提示", "保存成功!");
                    $(quotation_grid_ds_id).query();
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(quotation_grid_ds_id).query();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $(quotation_grid_ds_id).query();
                },
                scope: this
            });
        }

        //租金支付表删除记录
        window['${/parameter/@layout_code}_G_RENT_PAYMENT_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            var datas = $(quotation_grid_ds_id).getSelectedJson();

            if (datas.length == 0) {
                $L.showInfoMessage("提示", "请选择要删除的记录!");
                return;
            }
            $L.showConfirm("提示", "确认删除当前选择拆分的支付表信息?", function () {

                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                var checkFlag = true;
                var arr = [];
                for (var i = 0; i < datas.length; i++) {
                    arr.push({
                        quotation_id: datas[i].quotation_id
                    });
                    if (datas[i].payment_status != 'NEW' && datas[i].payment_status != '' && datas[i].payment_status != null  && datas[i].payment_status  != undefined) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        checkFlag = false;
                        Leaf.showWarningMessage('提示', '只有新建状态的租金支付表才可以删除!');
                        return;
                    }
                }
                if(checkFlag){
                    Leaf.request({
                        url: $('rptm001_delete_contract_plan_link_id').getUrl(),
                        para: arr,
                        success: function (res) {
                            $L.showInfoMessage("提示", "删除成功!");
                            $(quotation_grid_ds_id).query();
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                }


            }, function () {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            });

        }

        //indexchange事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_indexchange'] = function (ds, record, bp_seq) {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            if (ds.id === quotation_grid_ds_id) {
                var quotation_id = record.get('quotation_id');
                var quotation_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_one','F_FINANCE_CON');
                $(quotation_form_ds_id).setQueryParameter('quotation_id', quotation_id);
                $(quotation_form_ds_id).query();
            }
        };

        //更新时调用
        window['${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            if(ds.id === quotation_grid_ds_id){
                if (name == 'lease_item_amount_org' || name == 'exchange_rate') {
                    record.set('lease_item_amount',record.get('lease_item_amount_org')*record.get('exchange_rate'))
                }
                debugger;
                if((name == 'loan_type'||name == 'loan_type_n') && !record.get('CONFIRM')){
                    if(value=='TARIFF'){
                        record.getField('currency').setReadOnly(false);
                        record.getField('currency_n').setReadOnly(false);
                        record.getField('currency').setRequired(true);
                        record.getField('currency_n').setRequired(true);
                    }else if(value=='ROUTINE'){
                        record.getField('currency').setReadOnly(true);
                    record.getField('currency_n').setReadOnly(true);
                        record.getField('currency').setRequired(false);
                        record.getField('currency_n').setRequired(false);
                    }

                }
            }

        }

        //查询时调用 form
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function(ds, qpara, bp_seq) {
            // ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            var quotation_form_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_one','F_FINANCE_CON');
            if(ds.id == quotation_form_ds_id){
                var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
                var record = $(quotation_grid_ds_id).getCurrentRecord();
                ds.setQueryParameter('quotation_id', record.get("quotation_id"));
            }
        }

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            // ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            var quotation_grid_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation','G_RENT_PAYMENT');
            if(ds.id == quotation_grid_ds_id){
                ds.setQueryParameter('quotation_id', null);
                ds.setQueryParameter('data_class', 'CONTRACT_PLAN');
                ds.setQueryParameter('source_document_id','${/parameter/@project_id}');
                ds.setQueryParameter('source_document_category', 'PRJ_PROJECT');
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
