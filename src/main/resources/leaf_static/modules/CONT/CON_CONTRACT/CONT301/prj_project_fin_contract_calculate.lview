<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:init-procedure/>
    <a:view>
        <div id="prj_project_fin_calc_templet" style="width:100%;height:100%;">
            <iframe id="prj_project_fin_calc_templet_iframe" border="0" frameborder="0" height="100%" scrolling="auto"
                    sytle="border:none;" width="100%"/>
        </div>
        <script><![CDATA[
            var fieldsStr = unescape('${/parameter/@fieldsInfo}');
            if(fieldsStr != null && fieldsStr != '') {
                var fields = JSON.parse(fieldsStr);
                fieldsStr = escape(JSON.stringify(fields));
            }
            if ('${/parameter/@document_history_flag}') {
                document.getElementById('prj_project_fin_calc_templet_iframe').src = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate_common_history.html?priceList=${/parameter/@priceList}&quotationId=${/parameter/@quotationId}&readOnly=${/parameter/@readOnly}&document_history_flag=Y&documentId=${/parameter/@document_id}&documentCategory=${/parameter/@document_category}';
            } else {
                document.getElementById('prj_project_fin_calc_templet_iframe').src = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate_common.html?priceList=${/parameter/@priceList}&quotationId=${/parameter/@quotationId}&readOnly=${/parameter/@readOnly}&changeReqFlag=Y&finance_amount=${/parameter/@financeAmount}&priceList=${/parameter/@priceList}&fieldsInfo='+fieldsStr;
            }
        ]]></script>
    </a:view>
</a:screen>
