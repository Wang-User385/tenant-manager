<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>

        <script><![CDATA[

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            if(ds.bindname === 'CONT301F26_G_END_con_contract_termination'){
                console.log(record.get('status'));
                if(!record.get('contract_id')){
                    record.set('status', 'NEW');
                    record.set('contract_id', '${/parameter/@contract_id}');
                }
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            //现金流
            if(ds.bindname === "CONT301F26_G_CASHFLOW_prj_quotation_cashflow"){
                ds.setQueryParameter('source_document_id', '${/parameter/@project_id}');
                ds.setQueryParameter('data_class', 'VIRTUAL_CON');
                ds.setQueryParameter('source_document_category', 'PRJ_PROJECT');
            }
            //还款计划查询条件，详情页面
            if(ds.bindname === "CONT301F26_G_REPAYMENT_PLAN_prj_quotation_cashflow"){
                ds.setQueryParameter('source_document_id', '${/parameter/@project_id}');
                ds.setQueryParameter('data_class', 'VIRTUAL_CON');
                ds.setQueryParameter('source_document_category', 'PRJ_PROJECT');
            }
            //商业伙伴
            if(ds.bindname === "CONT301F26_G_TRX_prj_project_bp"){
                ds.setQueryParameter('bp_categroy', 'CON_CONTRACT');
                ds.setQueryParameter('bp_role_type', 'CLIENT');
            }
        }

        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            $L.Masker.mask(document.body, "提交中..");
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var projectRecord = $(project_ds).getAt(0);

            var end_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_termination');
            var endRecord = $(end_ds).getAt(0);

            var param = {};
            param.contract_id = projectRecord.get("contract_id");
            param.termination_date = endRecord.get("termination_date");
            param.description = endRecord.get("description");
            Leaf.request({
                url: "${/request/@context_path}/hls/cus/con/contract/end/submit/wfl",
                para: param,
                success: function (r) {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "提交成功!", null);
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "提交出错!", null);
                },
                scope: this
            });
        };




        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    