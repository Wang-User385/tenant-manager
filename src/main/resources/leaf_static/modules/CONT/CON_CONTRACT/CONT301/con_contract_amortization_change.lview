<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="cont301f34s1_amortization_win_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_amortization_change_detail.lview"/>
        <script><![CDATA[

        //修改摊销设定
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            if (records.length !== 1) {
                $L.showMessage('提示', '请选择一条记录！');
                return false;
            } else {
                var param = records[0].data;
                param['url_title'] = '修改摊销设定';
                param['function_code'] = 'CONT301F34S1';
                param['winid'] = 'cont301f34s1_amortization_win_id';
                param['function_usage'] = 'MODIFY';
                param['contract_id'] = records[0].data.contract_id;
                hls_doc_get_layout_code(param, 'cont301f34s1_amortization_win_link', ds_id, 'CONT301F34');
            }
        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>

