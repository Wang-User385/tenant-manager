<?xml version="1.0" encoding="UTF-8"?>


<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_payment_detail_id2" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_payment_detail.lview"/>

        <script><![CDATA[

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            if('${/parameter/@project_id}' != null){
                $(ds_id).getCurrentRecord().set('project_id', '${/parameter/@project_id}');
            }
        };
        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var data = $(ds_id).getJsonData()[0];

            Leaf.request({
                url: '${/request/@context_path}/csh/payment/req/hd/create',
                para:  data,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
                    var param = {};
                    param.project_id = '${/parameter/@project_id}';
                    param['url_title'] = '租赁放款申请';
                    param['payment_req_id'] = res.result.record[0].payment_req_id;
                    param['function_code'] = 'CONT301F24';
                    param['parent_winid'] = '${/parameter/@winid}';
                    param['winid'] = 'con_contract_payment_detail_winid2';
                    hls_doc_get_layout_code(param, 'con_contract_payment_detail_id2', ds_id, 'CONT301F23',param['parent_winid'], 'Y');
                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });

        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    