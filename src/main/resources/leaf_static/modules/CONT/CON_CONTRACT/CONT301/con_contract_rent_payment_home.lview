<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: congweijing
    Date: 2021/04/22 16:37
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_rent_payment_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_payment_make.lview"/>

        <script><![CDATA[

        //放款计划制作
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            if ($(ds_id).getSelected().length == 0) {
                Leaf.showMessage("提示", "请选择一条记录!");
                return;
            }
            if ($(ds_id).getSelected().length > 1) {
                Leaf.showMessage("提示", "只能选择一条记录!");
                return;
            }

            var param = $(ds_id).getSelected()[0].data;
            param['url_title'] = '放款计划制作';
            param['function_code'] = 'RPTM001';
            param['winid'] = 'rent_payment_winid';
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_rent_payment_link_id', ds_id, 'CONT301');
        };


        //合同详情
        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['but_flag'] = 'N';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';

            if (param['contract_status'] !== 'NEW' && param['contract_status'] !== 'APPROVED_RETURN'&& param['contract_status'] !== 'REJECTED') {
                // param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['function_code'] = 'CONT301F1';
            }
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT301');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

