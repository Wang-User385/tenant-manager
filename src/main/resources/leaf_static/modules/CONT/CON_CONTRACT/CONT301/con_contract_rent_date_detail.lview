<?xml version="1.0" encoding="UTF-8"?>


<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>

        <script><![CDATA[
        Leaf.onReady(function(){

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_delay_history');
            $(ds_id).setQueryParameter('quotation_id', '${/parameter/@quotation_id}');
            $(ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');
            $(ds_id).setQueryParameter('contract_id', '${/parameter/@contract_id}');
            $(ds_id).query();

        })


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

