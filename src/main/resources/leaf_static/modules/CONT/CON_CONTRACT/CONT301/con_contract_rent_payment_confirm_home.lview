<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: congweijing
    Date: 2021/04/26 16:37
    Revision: 1.0
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="${/parameter/@layout_code}_rent_payment_confirm_detail_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_payment_confirm_detail.lview"/>
        <a:link id="CONT306_con_contract_rent_payment_confirm_create" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_payment_confirm_create.lview"/>

        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            qpara['created_by'] = '${/session/@user_id}';
        };

        //支付表确认新建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            var param = {};
            param['url_title'] = '支付表确认新建';
            param['function_code'] = 'CONT306F1';
            // param['function_usage'] = 'CREATE';
            param['winid'] = 'con_contract_rent_payment_confirm_create';
            param['screen_width'] = '600';
            param['screen_height'] = '350';

            hls_doc_get_layout_code(param, 'CONT306_con_contract_rent_payment_confirm_create', null, 'CONT306');
        }


        //支付表确认详情
        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '支付表确认详情';
            param['function_code'] = 'CONT306F2';
            param['winid'] = 'con_contract_detail_winid';
            //param['layout_debugger_flag'] = 'Y';

            if (param['status'] !== 'NEW' && param['status'] !== 'APPROVED_RETURN'&& param['status'] !== 'REJECTED'&& param['status'] !== 'CANCEL') {
                param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc'];
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['function_code'] = 'CONT306F2';
            }
            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_rent_payment_confirm_detail_link_id', ds_id, 'CONT301');
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if ((name == 'contract_number' || name == 'legal_contract_number') && value) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };


        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

