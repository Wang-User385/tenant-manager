<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="contract_lease_detail_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent.lview"/>

        <script><![CDATA[

        Leaf.onReady(function() {
            var dsId = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract','F_BASIC');
            $(dsId).create();

        });

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var dsId = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract','F_BASIC');
            if(ds.id === dsId){
                record.set('project_id' , '${/parameter/@project_id}');
            }

        };

        // 创建
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract','F_BASIC');
            var dsRecord = $(ds_id).getCurrentRecord();
            var param = {};
            param['url_title'] = '合同起租日调整';
            param['function_code'] = 'CONT301F25';
            // param['function_usage'] = 'MODIFY';
            // param['maintain_type'] = 'UPDATE';
            param['winid'] = 'con_contract_rent_winid';
            param['project_id'] =  '${/parameter/@project_id}';
            param['contract_id'] = dsRecord.get('contract_id');
            var link_id = 'contract_lease_detail_link';
            hls_doc_get_layout_code(param, link_id , ds_id, 'CONT301F3');

        }


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
