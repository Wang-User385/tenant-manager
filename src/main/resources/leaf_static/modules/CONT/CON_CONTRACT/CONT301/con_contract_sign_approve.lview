<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="con_contract_sign_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT305/con_contract_sign_entrance.lview"/>
        <script><![CDATA[
        debugger;
        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;
        var first_task_id = 'sid-1MnyEvhT-mG8o-4ZXR-8j1A-piRl273XunBZ';

        var current_activity_id = parent.currentTaskInfo.task_definition_key;
        var fileFlag = 'N';
        var function_code = 'CONT301F2WM1';
        var function_usage = 'QUERY';
        var maintain_type = 'READONLY';
        if (current_activity_id == first_task_id) {
            function_code = 'CONT301F2WM';
            function_usage = 'MODIFY';
            maintain_type = 'READONLY';
                fileFlag = 'Y'
        }
        var pageChooser = new PageChooser({
            url: $('con_contract_sign_link_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: businessKey,
                maintain_type: maintain_type,
                function_code:function_code,
                function_usage: function_usage,
                file_flag: fileFlag
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
    
    