        window['${/parameter/@layout_code}_G_REPAYMENT_PLAN_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            if ($('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').isModified()) {
                Leaf.showMessage("提示", "请先保存!", null);
                return;
            }
            $L.Masker.mask(document.body, "计算中..");
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            Leaf.request({
                url: "${/request/@context_path}/ct/prj/project/calc/xirr",
                para: {quotation_id: quotationRecord.get('quotation_id')},
                success: function (res) {
                    $(quotation_ds).query();
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "计算成功!", null);
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "计算出错!", null);
                },
                scope: this
            });

        }

