        function projectPrincipalChange(leaseItemAmount, downPayment, deposit) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            if (!leaseItemAmount) {
                leaseItemAmount = quotationRecord.get('lease_item_amount');
            }
            if (!downPayment) {
                downPayment = quotationRecord.get('down_payment');
            }
            if (!deposit) {
                deposit = quotationRecord.get('deposit');
            }

            quotationRecord.set("project_principal", leaseItemAmount - downPayment);
            quotationRecord.set("risk_exposure", leaseItemAmount - downPayment - deposit);
        }


        function rateChange(intRateType) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            /*if (intRateType === '固定利率' || intRateType === 'FIXED') {
                //如果是固定利率的话，那么浮动方式和幅度是不可编辑的
                quotationRecord.getField('floating_way').setRequired(false);
                quotationRecord.getField('floating_way').setReadOnly(true);
                quotationRecord.getField('floating_way_n').setRequired(false);
                quotationRecord.getField('floating_way_n').setReadOnly(true);
                quotationRecord.getField('floating_way_rate').setRequired(false);
                quotationRecord.getField('floating_way_rate').setReadOnly(true);
                quotationRecord.getField('int_rate').setRequired(true);
                quotationRecord.getField('int_rate').setReadOnly(false);
                quotationRecord.set("base_int_rate_type", null);
                quotationRecord.set("base_rate_type", null);
                quotationRecord.set("floating_way", null);
                quotationRecord.set("floating_way_n", null);
                quotationRecord.set("floating_way_rate", null);
                quotationRecord.set("floating_way_range", null);
            } else {
                //如果是浮动利率，那么浮动方式和幅度是必填的
                quotationRecord.getField('floating_way').setRequired(true);
                quotationRecord.getField('floating_way').setReadOnly(false);
                quotationRecord.getField('floating_way_n').setRequired(true);
                quotationRecord.getField('floating_way_n').setReadOnly(false);
                quotationRecord.getField('floating_way_rate').setRequired(true);
                quotationRecord.getField('floating_way_rate').setReadOnly(false);
                quotationRecord.getField('int_rate').setRequired(false);
                quotationRecord.getField('int_rate').setReadOnly(true);
                //如果是浮动率那么基准利率类型为基准利率【PBOC】
                quotationRecord.set("base_rate_type", "PBOC");
            }*/
            baseRateChange();
            floatingWayChange(quotationRecord.get('floating_way'), quotationRecord.get('floating_way_rate'));
        }

        function floatingWayChange(floatingWay, floatingWayRate) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            if (quotationRecord.get('int_rate_type') === 'FLOATING') {
                if (floatingWay === '按央行浮动比率' || floatingWay === 'MUTIPLY') {
                    quotationRecord.set("int_rate", quotationRecord.get('base_rate') * (accAdd(1, floatingWayRate)));
                } else {
                    quotationRecord.set("int_rate", accAdd(quotationRecord.get('base_rate'), floatingWayRate));
                }
            }
        }

        function getRentingFrequency(value) {
            switch (value) {
                case "月付" :
                    return "MONTH";
                case "季付" :
                    return "QUARTER";
                case "半年付" :
                    return "HALF_A_YEAR";
                case "年付" :
                    return "YEAR";
                case "双月付" :
                    return "DOUBLE_MONTH";
            }
        }

        function leaseTimesChange(rentingFrequency, leaseTimes) {
            var frequency = 0;
            if (rentingFrequency === 'MONTH') {
                frequency = 1;
            } else if (rentingFrequency === 'QUARTER') {
                frequency = 3;
            } else if (rentingFrequency === 'HALF_A_YEAR') {
                frequency = 6;
            } else if (rentingFrequency === 'YEAR') {
                frequency = 12;
            } else if (rentingFrequency === 'DOUBLE_MONTH') {
                frequency = 2;
            }
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var leaseTimeTemp = Math.ceil(accMul(leaseTimes, frequency));
            quotationRecord.set("lease_term", leaseTimeTemp);
            baseRateChange();
            leaseStartDateChange(quotationRecord.get('lease_start_date'));

        }

        function baseRateChange() {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var url = "${/request/@context_path}/fnd/baserateset/queryForFinanceContract";
            jQuery.ajax({
                type: 'POST',
                url: url,
                data: JSON.stringify({
                    baseRateType: 'PBOC',
                    loanTerm: quotationRecord.get('lease_term')
                }),
                headers: {"X-CSRF-TOKEN": document.getElementsByTagName('meta')["_csrf"].content},
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    baseRateSource = datas.rows;
                    if (baseRateSource.length > 0) {
                        quotationRecord.set("base_rate", baseRateSource[0].baseRate);
                        quotationRecord.set("base_rate_n", baseRateSource[0].description);
                        quotationRecord.set("description", baseRateSource[0].description);
                    } else {
                        quotationRecord.set("base_rate", "");
                        quotationRecord.set("base_rate_n", "");
                        quotationRecord.set("description", "");
                    }
                }
            });

        }

        function leaseStartDateChange(startDate) {
            var startDays = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0).getDate();
            var day = startDays - startDate.getDate();
            var endDate = new Date(startDate);
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var frequency = leaseTimesChangeForLeaseDate(quotationRecord.get('renting_frequency'));
            if (frequency === 0 || quotationRecord.get('first_rental_payment_date')) {
                return;
            }
            endDate.setDate(1);
            DateAdd("m", frequency, endDate);
            var endDays = new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0).getDate();
            if (new Date(startDate).getDate() === startDays) {
                endDate.setDate(endDays);
            } else if (new Date(startDate).getDate() > endDays) {
                endDate.setDate(endDays - day);
            } else {
                endDate.setDate(new Date(startDate).getDate());
            }
            quotationRecord.set("first_rental_payment_date", new Date(endDate));
        }

        function leaseTimesChangeForLeaseDate(rentingFrequency) {
            var frequency = 0;
            if (rentingFrequency === 'MONTH') {
                frequency = 1;
            } else if (rentingFrequency === 'QUARTER') {
                frequency = 3;
            } else if (rentingFrequency === 'HALF_A_YEAR') {
                frequency = 6;
            } else if (rentingFrequency === 'YEAR') {
                frequency = 12;
            } else if (rentingFrequency === 'DOUBLE_MONTH') {
                frequency = 2;
            }
            return frequency;
        }

