        function assignValue(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record[i] = data[i];
                }
            }
        }

        function loadInformation(project_id){
            time+=1;
            debugger
            Leaf.request({
                url: '${/request/@context_path}/prj/project/loadInformation',
                para: {
                    project_id: project_id
                },
                sync: true,
                success: function () {
                },
                failure: function () {
                },
                error: function () {
                },
                scope: this
            });
        }
        var time=0;
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp');
            var a=ds.qpara.project_id;
            if(time==0&&!(Ext.isEmpty(ds.qpara.project_id))){
                loadInformation(ds.qpara.project_id);
                $('${/parameter/@layout_code}_G_ATTACHMENT_prj_project_attachment_ds').query();
            }
            //默认值从后台查询sql设置 $jq('#CONT301F1_G_QUOTATION_PRJ_QUOTATION_INT_RATE_TYPE > div > div > input').val("固定利率");
            if (ds_id == ds.id && ds_id) {
                if (record) {
                    if (record.get('bp_type') === 'TENANT') {
                        record.getField('bp_id').setReadOnly(true);
                        record.getField('bp_id_n').setReadOnly(true);
                        /* record.getField('bank_account_id').setReadOnly(true);

                         record.getField('bank_account_id_n').setReadOnly(true);
                         record.getField('description').setReadOnly(true);*/


                    }

                }
            }
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            if (ds.id == con_file_ds) {
                if (record) {

                    if ('${/parameter/@wfl_flag}' == 'Y' && '${/parameter/@finalized_flag}' == 'N') {
                        record.getField('document_number').setReadOnly(false);
                    } else {
                        record.getField('document_number').setReadOnly(true);
                    }


                }
            }


        };

        //文本保存
        window['${/parameter/@layout_code}_G_FILE_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');

            var records = $(con_file_ds).getAll();
            var data = [];
            for (var i = 0; i < records.length; i++) {
                if (records[i].dirty) {
                    data.push(records[i].data);
                }
            }
            Leaf.request({
                url: '${/request/@context_path}/prj/con/check/contract/number',
                para: data,
                scope: this,
                success: function (res) {
                    $(con_file_ds).submit();
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                },
                failure: function () {
                },
                error: function () {
                }
            });
        };


        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {

            //校验
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            var mortgage_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_chance_mp', 'G_MORTGAGE_PLEDGOR');
            var trx_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'F_CUSTOMER_INFO');

            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                debugger
                $L.Masker.mask(document.body, "提交中..");
                var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var projectRecord = $(project_ds).getAt(0);
                var conFileRecord = $(con_file_ds).getAll();
                if (conFileRecord.length == 0) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "请先维护<b>【合同文本】</b>，再提交审批！");
                    return false;
                }

                var cashflow_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');
                var cashflowRecord = $(cashflow_ds).getAll();
                if (cashflowRecord.length == 0) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "报价未计算成功！");
                    return false;
                }
                var checkAttachFlag = 'Y';
                var attachmentRecord = $(con_file_ds).getAll();
                for (var i = 0; i < attachmentRecord.length; i++) {
                    if (attachmentRecord[i].get('file_name') == 'undefined' || attachmentRecord[i].get('file_name') == '' || attachmentRecord[i].get('file_name') == undefined) {
                        checkAttachFlag = 'N';
                    }
                }

                if (checkAttachFlag == 'N') {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "请在<b>【合同文本】</b>处上传文件</b>!");
                    return;
                }

                /*   if(projectRecord.get('contract_amount') > projectRecord.get('real_left_amount')){
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage('提示','合同金额不能大于项目审批剩余额度！');
                        return ;
                    }*/

                Leaf.request({
                    url: "${/request/@context_path}/ct/con/contract/submit/wfl",
                    para: {project_id: projectRecord.get('project_id')},
                    success: function (res) {
                        $L.Masker.unmask(document.body);
                        $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                            $('${/parameter/@winid}').close();
                            if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                        });
                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "提交失败!", null);
                    },
                    scope: this
                });
            });
        };

        //生成文本
        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            var param = {};
            param['url_title'] = '合同文本生成';
            param['function_code'] = 'CONT301F1VIR';
            param['project_id'] = '${/parameter/@project_id}';
            param['function_usage'] = 'MODIFY';
            param['winid'] = 'CONT301F1VIR_cont_content_winid';
            /*   param['screen_width'] = '1200';
               param['screen_height'] = '700';*/
            hls_doc_get_layout_code(param, 'cont301f1vir_cont_content_id', ds_id, 'CONT301F1');


        };

        //在线编辑
        function editOffice_reply(source_pk_value) {
            if (source_pk_value) {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                $L.showInfoMessage("提示", "请先生成项目批复书!");
            }
        }

        //生成文本
        window['${/parameter/@layout_code}_user_button7_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC_INFO');
            if ($(ds_id).validate()) {
                var record = $(ds_id).getCurrentRecord();
                var source_pk_value3 = record.get('source_pk_value3');
                // debugger;
                if (!source_pk_value3) {
                    if (record.get('project_id') && record.get('project_id') != null && record.get('project_id') != '') {
                        Leaf.Masker.mask(Ext.getBody(), '正在生成文本...');
                        Leaf.request({
                            url: "${/request/@context_path}/prj/project/create/content",
                            para: {project_id: record.get('project_id'), template_code: 'PRJ_REPORT_APPROVAL'},
                            success: function (res) {
                                // debugger;
                                console.log(res);
                                var source_pk_value3 = res.result.record[0].source_pk_value1;
                                if (source_pk_value3 == 'undefined' || source_pk_value3 == '' || source_pk_value3 == null) {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    Leaf.showInfoMessage('未找到模板!');
                                    return;
                                } else {
                                    Leaf.Masker.unmask(Ext.getBody());
                                    // Leaf.showInfoMessage('合同文本生成成功!');
                                    var ds_att = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTACHMENT');
                                    $(ds_att).query();
                                    editOffice_reply(source_pk_value3);
                                }
                            },
                            error: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            failure: function (res) {
                                Leaf.Masker.unmask(Ext.getBody());
                            },
                            scope: this
                        });
                    } else {
                        $L.showInfoMessage("提示", "项目不存在请联系管理员!");
                    }
                } else {
                    if (source_pk_value3) {
                        editOffice_reply(source_pk_value3);
                    } else {
                        $L.showInfoMessage("提示", "请先生成项目批复书!");
                    }
                }

            }


        };
        //
        window['${/parameter/@layout_code}_calc_layout_dynamic_click'] = function () {
            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                debugger
                $L.Masker.mask(document.body, "计算中..");
                var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                var quotationRecord = $(quotation_ds).getAt(0);
                Leaf.request({
                    url: "${/request/@context_path}/ct/prj/quotation/re/calc?quotationId=" + quotationRecord.get('quotation_id'),
                    success: function (res) {
                        $('CONT301F1_G_OTH_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_CASHFLOW_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').query();
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "计算成功!", null);
                    },
                    error: function () {
                        $('CONT301F1_G_OTH_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_CASHFLOW_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').query();
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "计算出错!", null);
                    },
                    scope: this
                });
            });
        };

        var contract_button_function = {
