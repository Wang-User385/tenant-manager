<?xml version="1.0" encoding="UTF-8"?>
<h:screen xmlns:h="http://www.hand-china.com/hap">
    <link rel="stylesheet" type="text/css" href="${base.contextPath}/resources/css/PRJ/prjDetail.css"/>
    <script src="${base.contextPath}/resources/hls/hlsMask/javascript/jquery.mloading.js"
            type="text/javascript"></script>
    <link href="${base.contextPath}/resources/hls/hlsMask/css/jquery.mloading.css" rel="stylesheet" type="text/css"/>
    <script src="${base.contextPath}/common/code?inceptFrenquencySource=CON.INCEPT_FRENQUENCY" type="text/javascript"></script>
    <script src="${base.contextPath}/common/code?yesOrNoSource=SYS.YES_NO" type="text/javascript"></script>
    <style>
        body{
            background-color: white;
        }
        #cashflow {
            height: 440px !important;
        }

        .hlsHBox-group .col-sm-1 {
            width: 9%;
        }

        .hlsHBox-group .col-sm-2 {
            width: 16%;
        }

        .hlsHBox-group .col-sm-5 {
            width: 41%;
        }

        .hlsHBox-group .col-sm-11 {
            width: 91%;
        }

        .toolBar {
            position: fixed;
            top: 10%;
            right: 0px;
        }

        .toolBar ul {
            list-style: none;
            margin: 0px;
            padding: 0px;
        }

        .toolBar ul li {
            padding-top: 2px;
        }

        .toolBar ul li .contain {
            width: 60px;
            height: 60px;
            line-height: 60px;
            text-align: center;
            color: white;
            cursor: pointer;
            background-color: white;
        }

        .toolbar-left-div {
            width: 50px;
            height: 50px;
            visibility: visible;
        }

        .text-content-right {
            width: 0px;
            height: 60px;
            color: white;
        }

        .prj_contain {
            width: 870px!important;
            padding-bottom: 45px;
        }


        #quoted_price:hover {
            background: rgb(0, 190, 190);
        }

        #usedCashFlow-prompt {
            margin-top: 20px;
        }

        #cashFlowAnalyse-prompt {
            margin-top: 20px;
        }

        #prjAdvantage-prompt {
            margin-top: 20px;
        }

        .col-sm-7 {
            width: 55%;
        }

        .col-sm-3 {
            width: 23%;
        }

        .hlsMaskedTextBoxLabel, .hlsComboboxLabel, .hlsLovLabel, .hlsNumericTextBoxLabel, .hlsTextAreaLabel {
            width: 105px;
            text-align: left !important;
        }

    </style>
    <script id="scriptA"><![CDATA[
    <!--从创建页面带过来的数据-->
    var projectId = "${RequestParameters.projectId!0}";
    var readOnly = '${RequestParameters.readOnly!0}';
    var contractStatus = '${RequestParameters.contractStatus!0}';
    var quotationId = '${RequestParameters.quotationId!0}';

    var viewModel = kendo.observable({
        enabled: true,
        isEnabled: false,
        model: {
            projectId: projectId,
            quotationId: quotationId
        },

        save: function () {

        },
    });


    $().ready(function () {
        if (readOnly == "Y") {
            $(".hlstoolbar").css("display", "none");
            $(".hlsgridbox-btn-detail").css("display","none");
            $(".hlsgrid-add-btn-column").css("display","none");
        }
    });
    var paymentReqStatus;
    function detail(rowdata, rowIndex) {
        return '<a  href="javascript:void(0)" onclick="openDetail(\'' + rowdata.contractId + '\',\'' + rowdata.paymentReqId + '\',\'' + rowdata.paymentReqStatusDesc + '\')"><img src="${base.contextPath}/resources/images/CONT/detail.png" style="cursor:pointer;display:inline-block;margin-right:5px;height:15px;width:15px;"/></a>';
    }

    function openDetail(contractId, paymentReqId, paymentReqStatusDesc) {

        if (paymentReqStatusDesc == "审批中") {
            paymentReqStatus = "APPROVING"
        }
        if (paymentReqStatusDesc == "审批通过") {
            paymentReqStatus = "APPROVED"
        }
        if (paymentReqStatusDesc == "审批退回") {
            paymentReqStatus = "APPROVED_RETURN"
        }
        if (paymentReqStatusDesc == "新建") {
            paymentReqStatus = "NEW"
        }

        if (readOnly == "Y") {
            var url = "${base.contextPath}/cont/CON810A/con_contract_loan_request.view?projectId=" + projectId + '&contractId=' + contractId
                + '&paymentReqId=' + paymentReqId + '&paymentReqStatus=' + paymentReqStatus;
        } else if (paymentReqStatusDesc == "新建" || paymentReqStatusDesc == "审批退回") {
            var url = "${base.contextPath}/cont/CON810A/con_contract_loan_request.view?projectId=" + projectId + '&contractId=' + contractId + '&paymentReqId=' + paymentReqId;
        } else {
            var url = "${base.contextPath}/cont/CON810A/con_contract_loan_request.view?projectId=" + projectId + '&contractId=' + contractId
                + '&paymentReqId=' + paymentReqId + '&paymentReqStatus=' + paymentReqStatus + '&contractStatus=' + contractStatus;
        }
        // var randomFigure = Math.floor(Math.random() * 10000);//增加一个随机数 保证每次打开都刷新
        // top.openTab('FCT.CONTRACT', '保理放款申请', url, false, '', null, randomFigure);
        var $box = $("#popWindow").kendoWindow(
            {
                actions: ["Close"],
                width: 910,
                title: '租赁放款申请',
                visible: false,
                iframe: true,
                modal: true,
                content: url
            }).data("kendoWindow");
        hlsWindow($box, 'FULL');

        window.parent.$("#" + "${RequestParameters.hlsWindowId!}").data("kendoWindow").close();

    }
    function parameterMap(options, type) {

        if (type !== "read" && options.models) {
            var datas = options.models;
            if (type == 'create' || type == 'update' || type == 'destroy') {
                datas = options.models.map(function (data) {
                    if (type == 'create') {
                        data['__status'] = 'add';
                        data['sourceDocumentId'] = viewModel.model.projectId;
                    }
                    if (type == 'update') {
                        data['__status'] = 'update';
                        data['sourceDocumentId'] = viewModel.model.projectId;
                    }
                    return data;
                })
            }
            return kendo.stringify(datas);
        } else if (type === "read") {
            var map = {};
            map.page = options.page;
            map.pagesize = options.pageSize;
            map.projectId = viewModel.model.projectId;
            for (var v in options) {
                map[v] = options[v];
            }
            for (var k in map) {
                if (map[k] === '' || map[k] === null || map[k] === undefined)
                    delete map[k]
            }
            return map;
        }
    }
    function gridLocate(e) {
        var d = this.dataItem(e.element);
    }
    function totalRentalTemp(dataItem) {
        var num = dataItem.amount || 0;
        if (!num)
            num = parseFloat(num);
        return Hls.formatCurrency(num);
    }
    function editable(field) {
        if (readOnly == "Y") {
            return false;
        }
        else{
            return true;
        }
    }
    ]]></script>
    <div id="editWin1"></div>
    <div id="editWin2"></div>
    <div id="addDialog"></div>
    <div id="popWindow"></div>
    <div class="prj_contain">
        <h:dataSource id="paymentDataSource" batch="true" pageSize="5" serverPaging="true">
            <h:transport parameterMap="parameterMap">
                <h:read url="${base.contextPath}/ct/con/contract/payment/info/query" type="GET" dataType="json"/>
            </h:transport>
            <h:schema data="rows" total="total">
                <h:model id="paymentReqId" editable="editable">
                    <h:fields>
                        <h:item name="paymentReqDate" type="date">
                        </h:item>
                    </h:fields>
                </h:model>
            </h:schema>
        </h:dataSource>
        <h:hlsGridBox title="付款信息" hlsGridId="payment" id="section-1" hlsBtnType="ADD,DELETE"
                      width="870px"
                      dataSourceId="paymentDataSource">
            <h:hlsGrid id="payment" dataSource="paymentDataSource" editable="false" hlsBtnType="DELETE"
                       resizable="true" height="440" navigatable="true" locate="gridLocate">
                <h:pageable pageSizes="5,10,20,50" buttonCount="3" refresh="true">
                </h:pageable>
                <h:columns>
                    <h:column field="paymentReqNumber" title='<@spring.message "付款申请编号"/>' width="100">
                        <h:headerAttributes style="text-align:center;font-size:13px;font-weight:normal;"/>
                        <h:attributes style="text-align:center"/>
                    </h:column>
                    <h:column field="paymentReqDate" title='<@spring.message "付款申请时间"/>' width="80" format="{0: yyyy-MM-dd}">
                        <h:headerAttributes style="text-align:center;font-size:13px;font-weight:normal;"/>
                        <h:attributes style="text-align:center"/>
                    </h:column>
                    <h:column field="amount" title='<@spring.message "申请金额"/>' width="80" template="totalRentalTemp">
                        <h:headerAttributes style="text-align:center;font-size:13px;font-weight:normal;"/>
                        <h:attributes style="text-align:center"/>
                    </h:column>
                    <h:column field="paymentReqStatusDesc" title='<@spring.message "审批状态"/>' width="80">
                        <h:headerAttributes style="text-align:center;font-size:13px;font-weight:normal;"/>
                        <h:attributes style="text-align:center"/>
                    </h:column>
                    <h:column title="明细" field="明细" template="fn:detail" width="50">
                        <h:headerAttributes style="text-align:left"/>
                        <h:attributes style="text-align:left"/>
                    </h:column>
                </h:columns>
            </h:hlsGrid>
        </h:hlsGridBox>

    </div>
    <script id="scriptB"><![CDATA[
    /*解除原来的删除事件*/
    $("#payment").data('kendoGrid').wrapper.off('click.kendoGrid', '.hlsgrid-btn-delete');
    /*绑定新删除事件*/
    $("#payment").data('kendoGrid').wrapper.on('click.kendoGrid', '.hlsgrid-btn-delete', function (e) {
        if ($("#payment").data('kendoGrid').dataItem($(e.target).closest('tr')).paymentReqStatus == 'APPROVED' || $("#payment").data('kendoGrid').dataItem($(e.target).closest('tr')).paymentReqStatus == 'APPROVING') {
            kendo.ui.showInfoDialog({
                title: $l('hap.tip.info'),
                message: $l('只有新建和审批退回的付款可以删除！')
            })
        } else {
            kendo.ui.showConfirmDialog({
                title: $l('hap.tip.info'),
                message: $l('hap.tip.delete_confirm')
            }).done(function (event) {
                if (event.button == "OK") {
                    var grid = $("#payment").data('kendoGrid');
                    var data = grid.dataItem($(e.target).closest('tr'));
                    grid.dataSource.remove(data);
                    data['__status'] = 'delete';
                    data['dirty'] = true;
                    // deleteArray.push(data);
                    var url = "${base.contextPath}/csh/con/payment/req/hd/remove";
                    $.ajax({
                        type: 'POST',
                        url: url,
                        data: JSON.stringify([data]),
                        async: false, //设为同步
                        contentType: "application/json; charset=utf-8",
                        success: function (datas) {
                            kendo.ui.showInfoDialog({
                                title: "提示",
                                message: "删除成功"
                            }).done(function () {
                            })
                        }
                    });
                }
            })
        }
    });
    //$(".k-grid-filter").css("display","none");
    /**
     * 重写方法
     *  校验input必输字段是否有值
     * @return  boolean
     */
    function requireInputValidate() {

        var flag = true;
        $.each($("input[required]"), function (index, item) {
            if (!item.value) {
                if (item.name == "floatingCycle") {
                }
                else {
                    flag = false;
                }
            }
        });
        return flag;
    }
    function hlscomponent_gridadd(id){

        // var data = $("#payment").data("kendoGrid").dataSource.data();
        // for (var i = 0; i < data.length; i++) {
        //     if (data[i].paymentReqStatus == 'NEW' || data[i].paymentReqStatus == 'APPROVING') {
        //         kendo.ui.showInfoDialog({
        //             title: $l('提示'),
        //             message: "请先处理新建或审批中的付款！"
        //         });
        //         return true;
        //     }
        // }
        //var amountPaid = 0;

            /*插入新的报价和现金流*/
        /*复制工作流中的放款条件*/


            var url = '${base.contextPath}/hls/cus/prj/quotation/and/cashflow/submit';
            $.ajax({
                type: 'POST',
                url: url,
                data: JSON.stringify(viewModel.model),
                async: false, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    if (datas.success == false) {
                        kendo.ui.showErrorDialog({
                            title: $l('提示'),
                            message: datas.message
                        })
                    } else {
                        // Hls.openBox({
                        //     functionCode: "CON510B",
                        //     winId: "editWin1",
                        //     params: {
                        //         projectId:projectId
                        //     },
                        //     closeFunction: function () {
                        //         $('#payment').data('kendoGrid').dataSource.page(1);
                        //     }
                        // });
                        /*明细页面信息从合同表中查询*/
                        var contractId = datas.rows[0].contractId;
                        var paymentReqId = datas.rows[0].paymentReqId;

                        var url = "${base.contextPath}/cont/CON810A/con_contract_loan_request.view?projectId=" + projectId + '&contractId=' + contractId + '&paymentReqId=' + paymentReqId;
                        var randomFigure = Math.floor(Math.random() * 10000);//增加一个随机数 保证每次打开都刷新
                        top.openTab('CON.CONTRACT', '租赁放款申请', url, false, '', null, randomFigure);
                        window.parent.$("#" + "${RequestParameters.hlsWindowId!}").data("kendoWindow").close();
                    }

                }
            });

    }
    ]]></script>

</h:screen>

