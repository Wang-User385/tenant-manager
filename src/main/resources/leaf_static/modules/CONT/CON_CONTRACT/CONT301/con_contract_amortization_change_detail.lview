<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var BasRecord = $(ds_id).getCurrentRecord();
            var interestAmortizationMethod = BasRecord.get('interest_amortization_method');
            var contractId = BasRecord.get('contract_id');
            if (interestAmortizationMethod) {
                Leaf.request({
                    url: '${/request/@context_path}/hls/cus/con/cashflow/update/amortization/method?contractId=' + contractId,
                    success: function (res) {
                        var para = [{
                            "contract_id": contractId
                        }];
                        if (interestAmortizationMethod != 'INTEREST_IMPORT') {
                            Leaf.request({
                                url: '${/request/@context_path}/gld/finance/income/sharing',
                                para: para,
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    $L.showMessage("提示", "重算报价成功!", function () {
                                        $(cashflow_ds_id).query();
                                    });
                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        } else {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        }
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        };

        //自定义导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var BasRecord = $(ds_id).getCurrentRecord();
            var interestAmortizationMethod = BasRecord.get('interest_amortization_method');
            var contractId = BasRecord.get('contract_id');
            if ($(ds_id).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            if (interestAmortizationMethod == 'INTEREST_IMPORT') {
                var win = new Leaf.Window({
                    id: 'con_contract_amortization_win_id',
                    params: {
                        winid: 'con_contract_amortization_win_id',
                        contractId: contractId
                    },
                    url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_amortization_import.lview',
                    title: '自定义摊销导入',
                    fullScreen: false,
                    width: 450,
                    height: 400,
                    draggable: true
                });
            } else {
                $L.showMessage('提示', '支付表的利息摊销方式不是自定义导入！');
                return false;
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_amortization_import_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'import_detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">导入</a>';
            }
        };

        function open_amortization_import_win(record_id, ds_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            if ($(ds_id).isModified()) {
                $L.showMessage('提示', '请先保存！');
                return false;
            }
            debugger;
            var amortization_method = record.get('amortization_method');
            if (amortization_method == 'COST_IMPORT') {
                var win = new Leaf.Window({
                    id: 'con_contract_amortization_win_id',
                    params: {
                        winid: 'con_contract_amortization_win_id',
                        contractId: record.get('contract_id')
                    },
                    url: '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_amortization_import.lview',
                    title: '自定义摊销导入',
                    fullScreen: false,
                    width: 450,
                    height: 400,
                    draggable: true
                });
            } else {
                $L.showMessage('提示', '该费用项的摊销方式不是自定义摊销！');
                return false;
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>

