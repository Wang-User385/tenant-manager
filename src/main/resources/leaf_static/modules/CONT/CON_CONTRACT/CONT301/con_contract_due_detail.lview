    Author: huangtianyang
    Date: 2019/02/26 11:06
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            if(ds.bindname === "CONT301F291_G_CASH_con_contract_cashflow"){
                console.log(record)
                if(record.modified.hasOwnProperty('fine_reduce_req') && record.get('fine_reduce_req') === 'Y'){
                    if(record.get('principal_write_off_flag') !== 'FULL'){
                        record.set('fine_reduce_req' , 'N');
                        record.set('fine_reduce_req_n' , '否');
                        $L.showInfoMessage("提示","该笔罚息的本金尚未核销，请先核销!");
                    }
                }
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            if (name === 'upload' && record.get('contract_attachment_id')){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('contract_attachment_id') + '\');">附件</a>';
            }
            return value;
        };


        window['upload_file'] = function(record_id,contract_attachment_id){
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'fin002_open_attachment_winid',
                url: url,
                params: {
                    'header_id': contract_attachment_id,
                    'table_name': 'CON_CONTRACT_ATTACHMENT',
                    winid: 'cont301_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $('CONT301F291_G_FILE_con_contract_attachment_ds').query();
            });
        }



        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            var ds_id = 'CONT301F291_G_CASH_con_contract_cashflow_ds';
            var file_id = 'CONT301F291_G_FILE_con_contract_attachment_ds';
            if (!($(ds_id).validate() && $(file_id).validate())){
                return;
            }
            var array = $(ds_id).getAll().map((v)=>v.data);
            var flag = false;
            for(var i=0;i<array.length;i++){
                if(array[i].fine_reduce_req==="Y"){
                    flag = true;
                }
            }
            if(!flag){
                $L.showInfoMessage("提示","请至少选择一条罚息申请减免!");
                return;
            }
            $L.Masker.mask(document.body, "提交中..");
            $(file_id).submit();
            Leaf.request({
                url: "${/request/@context_path}/ct/csh/fine/info/submit/wfl",
                para: array,
                success: function (res) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                        $('${/parameter/@winid}').close();
                        // if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                    });
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "提交失败!", null);
                },
                scope: this
            });

        };






        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    