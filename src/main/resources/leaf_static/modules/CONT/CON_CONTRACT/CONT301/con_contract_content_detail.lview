<?xml version="1.0" encoding="UTF-8"?>

<!--
    Author: huangtianyang
    Date: 2019/02/20 09:47
    Revision: 1.0 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if(ds.bindname === "CONT301F1CON_G_GRID_fct_project_attachment"){
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        }



        //提交审批
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var attach_id_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/virprj/project/create/content",
                para: {
                    project_id:'${/parameter/@project_id}',
                    template_code:'CONTRACT_ATTACHMENT'
                },
                success: function (res) {

                    $(attach_id_ds).query()
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                },
                error: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                //sync: true,
                scope: this
            });



        };


        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var  check_flag ='N'
            var attach_id_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
            if ($(attach_id_ds).validate()) {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

                var records = $(attach_id_ds).getAll();
                if(records.length) {
                    for (var i = 0; i < records.length; i++) {
                    debugger;
                        if(i==records.length-1){
                            check_flag='Y'
                        }
                        var record = records[i];
                        Leaf.request({
                            url: "${/request/@context_path}/vir/prj/attachment/update",
                            para: {
                                project_attachment_id: record.get('project_attachment_id'),
                                document_number: record.get('document_number'),
                                con_content_amount: record.get('con_content_amount'),
                                description:record.get('description')
                            },
                            success: function (res) {
                            },
                            error: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            failure: function (res) {
                                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            },
                            sync: true,
                            scope: this
                        });

                    }
                }
                else
                    {
                        Leaf.showMessage("提示", "请先生成文件名!", null);
                        return;
                    }
               if(check_flag=='Y') {
                   Leaf.request({
                       url: "${/request/@context_path}/virprj/project/create/content1",
                       para: {
                           project_id:'${/parameter/@project_id}'
                       },
                       success: function (res) {
                           $(attach_id_ds).query()
                           window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                       },
                       error: function (res) {
                           window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                       },
                       failure: function (res) {
                           window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                       },
                       //sync: true,
                       scope: this
                   });

               }

                }
        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'download') {
                if (record.get('attachment_id')) {
                    var url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + record.get('attachment_id');
                    return '<a href=' + url + '>下载</a>';
                }
            }
            if (name == 'edit' && record.get('source_pk_value') && record.get('source_pk_value').indexOf(',') === -1){
                return '<a href=javascript:editDocFile(\'' + record.get('source_pk_value') + '\')>在线编辑</a>';
            }

            var link_function = 'upload_file';
            if (name == 'upload' && record.get('project_attachment_id')){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\', \'CONTRACT_CONTENT\');">附件</a>';
            }
            var link_function = 'physical_assets_name_link';
            if (name == 'physical_assets_name' && record.get('physical_assets_name')){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id  + '\',\'' +  record.get('project_attachment_id')  + '\');">' + value + '</a>';
            }

            if (name === 'upload_text' && record.get('project_attachment_id')){
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\', \'PRJ_PROJECT_ATTACHMENT\');">附件</a>';
            }
            if(name === 'lease_detail_link' && record.get('lease_item_id') ){
                return '<a href="javascript:lease_detail_open(\'' + record.get('excel_id') + '\',\'' + record.get('result_id')  + '\',\'' +  record.get('lease_item_id')  + '\')">租赁物明细</a>';
            }
            if(name === 'pledge_link' && record.get('lease_item_id') ){
                return '<a href="javascript:pledge_detail_open(\'' + record.get('excel_id') + '\',\'' + record.get('result_id')  + '\',\'' +  record.get('lease_item_id')  + '\')">抵质押物明细</a>';
            }

            if(name === 'con_upload'&& record.get('project_attachment_id')){
                link_function = 'con_upload';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传' +'('+record.get('attachment_sum')+')'+'</a>';
            }
            if (name == 'file_name' && value) {
                debugger;
                if(record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = value.split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for(var  i = 0; i < fileNameList.length; i++){
                        debugger;
                        if(html != ''){
                            html += ',';
                        }
                        if(atmTypeRef(fileNameList[i])){
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }else if(checkPdf(fileNameList[i])){
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        }else if(checkDox(fileNameList[i])){
                            html += '<a href=javascript:editDocFile(\'' + sourcePkList[i] + '\')>在线预览</a>';
                        }else{
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }

            if (name == 'lease_item_code') {
                //debugger;
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }
            return value;
        };

        window['upload_file'] = function(record_id,project_attachment_id,table){
            var url;
            var function_usage = '${/parameter/@function_usage}';

            if ('${/parameter/@function_usage}' === 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if('${/parameter/@file_flag}' == 'Y'){
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }


            if(project_attachment_id == null){
                $L.showInfoMessage("提示","请先保存附件信息!");
                return;
            }


            var win1 = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': 'FCT_PROJECT_ATTACHMENT',
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win1.on('close', function () {
                debugger;
                var att_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment','G_FORM');
                $('${/parameter/@layout_code}_G_GRID_prj_project_attachment_ds').query();
                $(att_ds_id1).query();
            });
        }


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');

            if(ds.id == ln_ds_id&&record){

                if(record.get('source_type') != 'NEW_ADD'){
                    record.getField('document_number').setReadOnly(true);
                    record.getField('document_name').setReadOnly(true);
                    record.getField('bp_role_type_n').setReadOnly(true);
                    record.getField('bp_role_type').setReadOnly(true);
                    record.getField('bp_id').setReadOnly(true);
                    record.getField('bp_id_n').setReadOnly(true);
                }else{
                    record.getField('document_number').setReadOnly(false);
                    record.getField('document_name').setReadOnly(false);
                    record.getField('bp_role_type_n').setReadOnly(false);
                    record.getField('bp_role_type').setReadOnly(false);
                    record.getField('bp_id').setReadOnly(false);
                    record.getField('bp_id_n').setReadOnly(false);
                }
            }



        }


        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            var attach_id_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');

                var records = $(attach_id_ds).getSelected();
                if(records.length){
                    for(var i=0;i<records.length;i++){
                        var record = records[i];

                            Leaf.request({
                                url: '${/request/@context_path}/vir/prj/attachment/delete',
                                para: {
                                    project_attachment_id:record.get('project_attachment_id')
                                },
                                success: function (res) {
                                    $(attach_id_ds).query()
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                }
                            });
                        }



                }else{
                    Leaf.showMessage("提示", "请选择一条单据进行删除!", null);
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                    return;
                }







        };


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
            if (ds.id === ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('content_flag','Y')
                record.set('content_flag_n','已生成')
                record.set('source_type','NEW_ADD')

            }
        };

        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            debugger;
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();

            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment','G_GRID');
            $(att_ds_id).setQueryParameter('project_id', '${/parameter/@project_id}');

            $(att_ds_id).query();

        }
        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

    </a:view>

</a:screen>

