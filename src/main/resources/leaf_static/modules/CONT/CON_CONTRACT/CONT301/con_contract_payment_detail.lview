<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>

        <a:link id="deduce_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/deduct.lview"/>
        <a:link id="csh_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>

        <a:link id="hls_payment_dt"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_payment_dt.lview"/>
        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <script><![CDATA[
        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            var pay_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','F_PAY_SETTLE');

            $(pay_ds_id).getCurrentRecord().set('project_id', '${/parameter/@project_id}');

        };


        //附件保存
        window['${/parameter/@layout_code}_G_ATTACHMENT_INFO_ATT_SAVE_layout_dynamic_tab_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            $(att_ds_id).submit();
            $(att_ds_id).query();
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        }
        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            var records = $(ds_id).getCurrentRecord();

            if (ds.id == att_ds_id) {
                if(undefined == records.get('payment_req_id')){
                    Leaf.showMessage('提示','清先保存付款申请信息！');
                    $(att_ds_id).query();
                }else {
                    record.set('project_id', records.get('payment_req_id'));
                    record.set('project_attachment_category', 'CON_PAYMENT');
                }
            }
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            if(ds.id == ln_ds_id){
                record.set('project_id','${/parameter/@project_id}');
            }
        }

        // 超链接渲染 上传附件
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            if (name == 'upload' && record.get('project_attachment_id')) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\');">' + '附件上传' +'('+record.get('attachment_sum')+')'+'</a>';
            }
            if (name == 'file_name_pay' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id_n').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
            }
            if (name == 'payment_deduction') {
                return '<a href="javascript:open_payment_dt_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '抵扣明细' + '</a>';
            }
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

            if (name == 'upload') {
                return '<a href="javascript:open_attach(\'' + record.get('warrant_id') + '\')">附件上传</a>';
            }

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
                //return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">' + value + '</a>';
            }

            if (name == 'attachment_id_list_n'){
                if(record.get('file_name_pay') != null && record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = record.get('file_name_pay').split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    for(var  i = 0; i < fileNameList.length; i++){
                        if(html != ''){
                            html += ',';
                        }
                        if(atmTypeRef(fileNameList[i])){
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }else if(checkPdf(fileNameList[i])){
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i]  + '</a></span>';
                        }else{
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }
            return value;
        };

        function atmTypeRef(name){
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }
        function checkPdf(name){
            return /\.(pdf)$/i.test(name)
        }

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            url = '${/request/@context_path}/downloadFile.lview';
            var win = new Leaf.Window({
                id: 'warrant_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_LEASE_ITEM_WARRANT',
                    winid: 'warrant_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant');
                $(ds_id).query();
            });
        }
        window['upload_file'] = function (record_id, project_attachment_id, table) {
            var url;
            if ('${/parameter/@function_usage}' === 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            // var tableName = 'PRJ_PROJECT_ATTACHMENT';
            // if (table) {
            //     tableName = table;
            //     if ('${/parameter/@function_usage}' !== 'QUERY') {
            //         url = '${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/uploadText.lview';
            //     }
            // }
            var tableName = 'PRJ_PROJECT_ATTACHMENT';
            if (project_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var function_usage = '${/parameter/@function_usage}';
            if('${/parameter/@function_code}' == 'CONT301F24WFL'){
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }

            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': tableName,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
                $(att_ds_id).query();
            });
        }

        /*//打开额度占用信息详情页面
        function open_limit_amount_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            if(record.get('deduct_flag') === 'N'){
                return;
            }
            var param = {};
            param['credit_line_id'] = record.data.credit_line_id;
            param['payment_req_id'] = '${/parameter/@payment_req_id}';
            param['url_title'] = '抵扣';
            param['function_code'] = 'CONT301F241';
            param['winid'] = 'CONT301F24_decude_detail_id';
            hls_doc_get_layout_code(param, 'deduce_detail_id', null, 'CONT301F24');
        }*/



        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            if(ds.id ==att_ds_id) {
                $(att_ds_id).setQueryParameter('project_id', '${/parameter/@payment_req_id}');
            }
            var insure_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_insure');

            if(ds.id === insure_ds_id){
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant');

            if(ds.id === warrant_ds_id){
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
            var condition_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');

            if (ds.id === condition_ds_id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
        }
        function assignValue(record,data){
            for(var i in data){
                if(data[i] != null){
                    record[i] = data[i] ;
                }
            }
        }
        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            if(ds.id == ln_ds_id&&record){
                var grid_id = '${/parameter/@layout_code}_G_PLAN_csh_payment_req_ln_layout_grid_id';
                setTimeout(function(){
                    $jq('#' + grid_id + '_' + 'if_from_contract_n' + '_' + record.id).css({
                        "background-color": "#FFFF00",
                        "color": "black"
                    });
                },500);
                record.set('project_id','${/parameter/@project_id}');
                if(record.get('if_from_contract') == 'N'&&'${/parameter/@function_usage}' != 'QUERY'){
                    record.getField('bp_bank_account_name').setReadOnly(false);
                    record.getField('bp_bank_account_name').setRequired(true);
                    record.getField('bp_bank_account_num').setReadOnly(false);
                    record.getField('bp_bank_account_num').setRequired(true);
                    record.getField('bp_bank_branch_name').setReadOnly(false);
                    record.getField('bp_bank_branch_name').setRequired(true);

                    setTimeout(function(){
                        $jq('#' + grid_id + '_' + 'bp_bank_account_num' + '_' + record.id).css({
                            "background-color": "#FFFF00",
                            "color": "black"
                        });
                    },500);

                }else{
                    record.getField('bp_bank_account_name').setReadOnly(true);
                    record.getField('bp_bank_account_name').setRequired(false);
                    record.getField('bp_bank_account_num').setReadOnly(true);
                    record.getField('bp_bank_account_num').setRequired(false);
                    record.getField('bp_bank_branch_name').setReadOnly(true);
                    record.getField('bp_bank_branch_name').setRequired(false);
                }
            }

        }
        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            if(ds.id == ln_ds_id){
                if(name == 'if_from_contract'){
                    if(value == 'N'){
                        record.getField('bp_bank_account_name').setReadOnly(false);
                        record.getField('bp_bank_account_name').setRequired(true);
                        record.getField('bp_bank_account_num').setReadOnly(false);
                        record.getField('bp_bank_account_num').setRequired(true);
                        record.getField('bp_bank_branch_name').setReadOnly(false);
                        record.getField('bp_bank_branch_name').setRequired(true);
                    }else{
                        record.getField('bp_bank_account_name').setReadOnly(true);
                        record.getField('bp_bank_account_name').setRequired(false);
                        record.getField('bp_bank_account_num').setReadOnly(true);
                        record.getField('bp_bank_account_num').setRequired(false);
                        record.getField('bp_bank_branch_name').setReadOnly(true);
                        record.getField('bp_bank_branch_name').setRequired(false);
                    }
                }
            }



        }
        //保存
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var project_id = '${/parameter/@project_id}';
            var funding_plan_id = '${/parameter/@funding_plan_id}';

            //支付结算信息
            var pay_settle_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','F_PAY_SETTLE');
            var payRecord = $(pay_settle_ds_id).getCurrentRecord().data;
            payRecord['project_id'] = '${/parameter/@project_id}';
            //付款前提条件
            var pay_pt_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if($(pay_pt_ds_id).getAll().length != 0) {
                var pay_pt_records = $(pay_pt_ds_id).getAll();
                var hlsCusConContractPaymentPtList = [];
                payRecord['hls_cus_con_contract_payment_pt_list'] = [];
                for (var i = 0; i < pay_pt_records.length; i++) {
                    hlsCusConContractPaymentPtList[i] = {};
                    assignValue(hlsCusConContractPaymentPtList[i],pay_pt_records[i].data);
                    payRecord['hls_cus_con_contract_payment_pt_list'].push(hlsCusConContractPaymentPtList[i]);

                }
            }
            //保险信息
            var insure_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_insure');
            if($(insure_ds_id).getAll().length != 0) {
                var insure_records = $(insure_ds_id).getAll();
                var hlsCusPrjProjectInsureList = [];
                payRecord['hls_cus_prj_project_insure_list']=[];
                for (var i = 0; i < insure_records.length; i++) {
                    hlsCusPrjProjectInsureList[i] = {};
                    insure_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectInsureList[i],insure_records[i].data);
                    payRecord['hls_cus_prj_project_insure_list'].push(hlsCusPrjProjectInsureList[i]);

                }
            }
            //付款行
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            if($(ln_ds_id).getAll().length != 0) {
                var ln_records = $(ln_ds_id).getAll();
                var hlsCusCshPaymentReqLnList = [];
                payRecord['hls_cus_csh_payment_req_ln_list']=[];
                for (var i = 0; i < ln_records.length; i++) {
                    hlsCusCshPaymentReqLnList[i] = {};
                    // ln_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusCshPaymentReqLnList[i],ln_records[i].data);
                    payRecord['hls_cus_csh_payment_req_ln_list'].push(hlsCusCshPaymentReqLnList[i]);

                }
            }
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            if($(att_ds_id).getAll().length != 0) {
                var att_records = $(att_ds_id).getAll();
                var hlsCusPrjProjectAttachmentList = [];
                payRecord['hls_cus_prj_project_attachment_list']=[];
                for (var i = 0; i < att_records.length; i++) {
                    hlsCusPrjProjectAttachmentList[i] = {};
                    // ln_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectAttachmentList[i],att_records[i].data);
                    payRecord['hls_cus_prj_project_attachment_list'].push(hlsCusPrjProjectAttachmentList[i]);
                }
            }

            payRecord[pay_settle_ds_id.replace('_ds','')]=undefined;
            payRecord[insure_ds_id.replace('_ds','')]=undefined;
            payRecord[pay_pt_ds_id.replace('_ds','')]=undefined;
            payRecord[ln_ds_id.replace('_ds','')]=undefined;
            payRecord[att_ds_id.replace('_ds','')]=undefined;
            if(!$(ln_ds_id).validate()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }else{

                Leaf.request({
                    url: '${/request/@context_path}/csh/payment/req/hd/save',
                    para:  payRecord,

                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showMessage('提示', '成功');
                        $(ln_ds_id).query();
                        $(att_ds_id).query();
                        $(insure_ds_id).query();
                        $(pay_pt_ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }

        }

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            $(ln_ds_id).query();

            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment','G_ATTACHMENT_INFO');
            $(att_ds_id).query();
        };

        window['${/parameter/@layout_code}_submit_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var project_id = '${/parameter/@project_id}';
            var funding_plan_id = '${/parameter/@funding_plan_id}';

            //支付结算信息
            var pay_settle_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd','F_PAY_SETTLE');
            var payRecord = $(pay_settle_ds_id).getCurrentRecord().data;
            payRecord['project_id'] = '${/parameter/@project_id}';
            //付款前提条件
            var pay_pt_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_credit_condition');
            if($(pay_pt_ds_id).getAll().length != 0) {
                var pay_pt_records = $(pay_pt_ds_id).getAll();
                var hlsCusConContractPaymentPtList = [];
                payRecord['hls_cus_con_contract_payment_pt_list'] = [];
                for (var i = 0; i < pay_pt_records.length; i++) {
                    hlsCusConContractPaymentPtList[i] = {};
                    assignValue(hlsCusConContractPaymentPtList[i],pay_pt_records[i].data);
                    payRecord['hls_cus_con_contract_payment_pt_list'].push(hlsCusConContractPaymentPtList[i]);

                }
            }
            //保险信息
            var insure_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_insure');
            if($(insure_ds_id).getAll().length != 0) {
                var insure_records = $(insure_ds_id).getAll();
                var hlsCusPrjProjectInsureList = [];
                payRecord['hls_cus_prj_project_insure_list']=[];
                for (var i = 0; i < insure_records.length; i++) {
                    hlsCusPrjProjectInsureList[i] = {};
                    insure_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectInsureList[i],insure_records[i].data);
                    payRecord['hls_cus_prj_project_insure_list'].push(hlsCusPrjProjectInsureList[i]);

                }
            }
            //付款行
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            if($(ln_ds_id).getAll().length != 0) {
                var ln_records = $(ln_ds_id).getAll();
                var hlsCusCshPaymentReqLnList = [];
                payRecord['hls_cus_csh_payment_req_ln_list']=[];
                for (var i = 0; i < ln_records.length; i++) {
                    hlsCusCshPaymentReqLnList[i] = {};
                    // ln_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusCshPaymentReqLnList[i],ln_records[i].data);
                    payRecord['hls_cus_csh_payment_req_ln_list'].push(hlsCusCshPaymentReqLnList[i]);

                }
            }
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');

            if($(att_ds_id).getAll().length != 0) {
                var att_records = $(att_ds_id).getAll();
                var hlsCusPrjProjectAttachmentList = [];
                payRecord['hls_cus_prj_project_attachment_list']=[];
                for (var i = 0; i < att_records.length; i++) {
                    hlsCusPrjProjectAttachmentList[i] = {};
                    // ln_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectAttachmentList[i],att_records[i].data);
                    payRecord['hls_cus_prj_project_attachment_list'].push(hlsCusPrjProjectAttachmentList[i]);
                }
            }

            payRecord[pay_settle_ds_id.replace('_ds','')]=undefined;
            payRecord[insure_ds_id.replace('_ds','')]=undefined;
            payRecord[pay_pt_ds_id.replace('_ds','')]=undefined;
            payRecord[ln_ds_id.replace('_ds','')]=undefined;
            payRecord[att_ds_id.replace('_ds','')]=undefined;
            if(!$(ln_ds_id).validate()){
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                return;
            }else{

                Leaf.request({
                    url: '${/request/@context_path}/csh/payment/req/hd/save',
                    para:  payRecord,

                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ln_ds_id).query();
                        $(att_ds_id).query();
                        submit_function()
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }

        };
        function submit_function(){
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');
            var payment_req_id = $(ds_id).getCurrentRecord().get('payment_req_id');
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            var ln_records = $(ln_ds_id).getAll();
            var k=0;
            for (var i = 0; i <ln_records.length; i++) {
                if(ln_records[i].get('if_from_contract') == 'N'){
                    k++;
                }
            }
            if(k>0){
                new Leaf.showConfirm('${l:HLS.PROMPT}', '请再次确认付款账号，出错需重新发起付款申请！', function okFun() {
                    $L.Masker.mask(document.body, "提交中..");
                    Leaf.request({
                        url: "${/request/@context_path}/hls/cus/con/loan/submit/wfl?paymentReqId=" + payment_req_id,
                        success: function (r) {
                            $L.Masker.unmask(document.body);
                            $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                $('${/parameter/@winid}').close();
                                if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                            });
                        },
                        error: function () {
                            $L.Masker.unmask(document.body);
                            //Leaf.showMessage("提示", "提交出错!", null);
                        },
                        scope: this
                    });
                });
            }else{
                $L.Masker.mask(document.body, "提交中..");
                Leaf.request({
                    url: "${/request/@context_path}/hls/cus/con/loan/submit/wfl?paymentReqId=" + payment_req_id,
                    success: function (r) {
                        $L.Masker.unmask(document.body);
                        $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                            $('${/parameter/@winid}').close();
                            if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                        });
                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        //Leaf.showMessage("提示", "提交出错!", null);
                    },
                    scope: this
                });
            }
        }

        function open_payment_dt_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['function_code'] = 'DT001';
            param['url_title'] = '抵扣明细';
            param['function_usage'] = 'QUERY';

            param['winid'] = 'hls_payment_dt_winid';

            hls_doc_get_layout_code(param, 'hls_payment_dt', ds_id, 'HLS200F2');

            // param['function_usage'] = 'CREATE';
        }
        function beforeSubmit(countiune) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_hd');

            var contract_flag;
            var ln_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'csh_payment_req_ln');
            var ln_records = $(ln_ds_id).getAll();
            for (var i = 0; i < ln_records.length; i++) {
                if(ln_records[i].get('if_from_contract') == 'N'){
                    contract_flag = 'Y';
                }
            }
            if(ds_id){
                if($(ds_id).validate()) {
                    var payment_req_id = $(ds_id).getCurrentRecord().get('payment_req_id');
                    var con_end_task = $(ds_id).getCurrentRecord().get('con_end_task');
                    if('${/parameter/@first_flag}' == 'Y'){
                        $(ds_id).getCurrentRecord().set('trial','${/session/@userId}');
                        $(ds_id).submit();
                    }
                    if('${/parameter/@check_flag}' == 'Y'&&contract_flag == 'Y'){
                        new Leaf.showConfirm('${l:HLS.PROMPT}', '非合同约定账号，请审核依据', function okFun() {
                            countiune();
                        });
                    }else if(con_end_task){
                        Leaf.request({
                            url: "${/request/@context_path}/csh/payment/req/hd/saveEndTask",
                            para: {
                                payment_req_id: payment_req_id,
                                con_end_task: con_end_task,
                                recheck : '${/session/@userId}'
                            },
                            success: function (res) {
                                countiune();
                            },
                            failure: function () {

                            },
                            error: function () {

                            },
                            sync: true,
                            scope: this
                        });
                    }else{
                            countiune();
                            return true;
                    }
                }
            }else{
                countiune();
                return true;
            }
            return false;
        };

        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>

</a:screen>
    
    