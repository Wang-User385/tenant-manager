<?xml version="1.0" encoding="UTF-8"?>


<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="rptm001_calc_price_quotation_common_link_id"
                url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900/quotation_calc_common.lview"/>
        <a:link id="cont301f34s1_amortization_win_link"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_amortization_change_detail.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            if (name == 'price_list') {
                return '<a href="javascript:rent_payment_make_quotation(\'' + record.get('quotation_id') + '\',\'' + record.get('price_list') + '\');">报价</a>';
            }
        };

        //报价链接
        function rent_payment_make_quotation(quotation_id, price_list) {

            if (quotation_id != null) {

                //打开报价窗口
                var param = {};
                param['quotationId'] = quotation_id;
                param['quotation_id'] = quotation_id;
                param['priceList'] = price_list;
                param['function_code'] = "HLS900";
                param['layout_code'] = "CALC_QUOTATUON";
                param['url_title'] = '报价计算';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                param['excel_edit'] = 'Y';

                hls_doc_get_layout_code(param, 'rptm001_calc_price_quotation_common_link_id', '${/parameter/@layout_code}_G_CASHFLOW_INFO_con_contract_cashflow_ds', "HLS900");

            } else {
                Leaf.showMessage("提示", "报价未计算成功，无法查看!", null);
                return false;
            }
        };

        //财务起租按钮
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            var contractRecord = [];
            var check_flag = 'Y';
            if (records.length == 0) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                $L.showInfoMessage("提示", "请至少选择一条数据进行财务起租");
            } else {
                for (var i = 0; i < records.length; i++) {
                    var quatation_id = records[i].data.quotation_id;
                    var lease_account_date = records[i].data.lease_account_date;
                    var first_release_date = records[i].data.first_release_date;
                    if(lease_account_date > new Date()){
                        check_flag = 'N';
                    }
                    var contract_status =   records[i].data.contract_status;
                    if(contract_status != 'INCEPT'){
                        check_flag = 'F';
                    }
                    if(lease_account_date < first_release_date){
                        check_flag = 'W';
                    }


                    contractRecord.push(records[i].data);
                }

                if(check_flag == 'N'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "财务起租核算日不能晚于当前时间！");
                    return ;
                }

                if(check_flag == 'F'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "该支付表业务未起租！");
                    return ;
                }

                if(check_flag == 'W'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "财务起租日不得早于首次放款日！");
                    return ;
                }

                Leaf.request({
                    url: "${/request/@context_path}/contract/incept/lease/check",
                    async: false,
                    para: contractRecord,
                    success: function (res) {

                        var data = res.result.record[0];
                        if (data === "true") {
                            Leaf.request({
                                url: "${/request/@context_path}/contract/incept/lease/finance",
                                async: false,
                                para: contractRecord,
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    $L.showInfoMessage("提示","财务起租成功!",function(){
                                        $(ds_id).query();

                                    });
                                },
                                error: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                failure: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            });
                        }else if(data === "gldfalse"){
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showInfoMessage("提示", "请在【凭证管理】功能中生成起租凭证！");
                            return;
                        }else if(data === "gldconfirmfalse"){
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showInfoMessage("提示", "请先将该合同的起租红冲凭证确认！");
                            return;
                        }

                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                })



            }


        };

        //保存
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            var checkDateFlag = 'Y';
            var contractRecord = [];
            if (records.length == 0) {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                $L.showInfoMessage("提示", "请至少选择一条数据进行保存");
            } else {
                for (var i = 0; i < records.length; i++) {
                    var quatation_id = records[i].data.quotation_id;
                    var first_release_date = records[i].data.first_release_date;
                    var lease_account_date = records[i].data.lease_account_date;
                    if(lease_account_date == null || lease_account_date == ''){
                        checkDateFlag = 'F';
                    }else if(lease_account_date < first_release_date){
                        checkDateFlag = 'N';
                    }
                    contractRecord.push(records[i].data);
                }

                if(checkDateFlag == 'F'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "请输入财务起租核算日！");
                    return ;
                }else if(checkDateFlag == 'N'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "财务起租日不得早于首次放款日！");
                    return ;
                }

                Leaf.request({
                    url: "${/request/@context_path}/contract/incept/save/finance",
                    async: false,
                    para: contractRecord,
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示","保存成功!",function(){
                            $(ds_id).query();
                        });

                    },
                    error: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });


            }


        };

        //修改摊销设定
     /*   window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            if (records.length !== 1) {
                $L.showMessage('提示', '请选择一条记录！');
                return false;
            } else {
                var param = records[0].data;
                param['url_title'] = '修改摊销设定';
                param['function_code'] = 'CONT301F34S1';
                param['winid'] = 'cont301f34s1_amortization_win_id';
                param['function_usage'] = 'MODIFY';
                param['contract_id'] = records[0].data.contract_id;
                hls_doc_get_layout_code(param, 'cont301f34s1_amortization_win_link', ds_id, 'CONT301F34');
            }
        };*/



        ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

