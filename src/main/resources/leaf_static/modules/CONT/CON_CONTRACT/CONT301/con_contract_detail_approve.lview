<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="false"
          trace="true">
    <a:view>
        <style>
            html,body{
                height: 1000px;
                width: 90%;
            }
        </style>
        <script type="text/javascript" src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="con_contract_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail_wfl.lview"/>

        <script><![CDATA[

        //法务复核岗复核
        var task_id = 'sid-LXz2aqWR-LbfG-4zmv-8Sz4-04ldHraGCWLp';
        debugger
        //定稿
        var finalized_task_id = 'sid-uyzzXBy8-ZcJX-4fjY-83jS-F9clWyU2uii2';
        var current_activity_id = parent.currentTaskInfo.task_definition_key;
        var function_code = 'CONT301F1WFLNEW2';
        var maintain_type = 'READONLY';
        var function_usage = 'MODIFY';
     /*   var flag = 'N';
        var file_flag = 'N';
        var finalized_flag = 'N';*/
/*
        if(current_activity_id == task_id){
            function_code = 'CONT301F1WFL';
            maintain_type = 'MODIFY';
            function_usage = 'MODIFY';
            flag = 'Y';
            file_flag = 'Y';
        }
        if(current_activity_id == finalized_task_id){
            finalized_flag = 'Y';
        }*/
        var businessKey = '${/parameter/@businessKey}';
        var pageChooser = new PageChooser({
            url: $('con_contract_detail_id').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                project_id: businessKey,
                maintain_type: maintain_type,
                function_usage: function_usage,
                function_code:function_code
             /*   hidden_right_button_flag: 'Y',
                flag : flag,
                file_flag: file_flag,
                wfl_flag: 'Y',
                finalized_flag: finalized_flag*/
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
