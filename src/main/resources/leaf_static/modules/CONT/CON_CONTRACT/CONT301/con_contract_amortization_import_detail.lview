<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="CUSTOM_AMORTIZATION"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function saveBtn() {
            $("custom_amortization_info_ds").getAll().forEach(function (i) {
                i.dirty = true;
            });
            $("custom_amortization_info_ds").submit();
            // top.refreshFrame();
        }

        function disableBtn() {
            $('saveBtn_id').disable();
            top.refreshFrame();
        }

        function returnBack() {
            top.refreshFrame();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="custom_amortization_info_ds" fetchAll="true" autoQuery="true"
                       queryUrl="${/request/@context_path}/contract/custom/amortization/selectImportTempList?headerId=${/model/header/record/@header_id}&amp;contractId=${/parameter/@contractId}"
                       submitUrl="${/request/@context_path}/contract/custom/amortization/import/confirm?contractId=${/parameter/@contractId}">
                <a:fields>
                    <a:field name="start_date" datatype="date"/>
                    <a:field name="end_date" datatype="date"/>
                </a:fields>
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="THE_IMPORTED_DATA" width="980">
                <a:grid id="custom_amortization_info_grid" bindTarget="custom_amortization_info_ds" marginHeight="150" navBar="true"
                        width="980">
                    <a:columns>
                        <a:column name="error_msg" prompt="错误信息"/>
                        <a:column name="contract_number" prompt="支付表编号"/>
                        <a:column name="cf_item_n" prompt="现金流类型"/>
                        <a:column name="times" prompt="期项"/>
                        <a:column name="period_name" prompt="期间"/>
                        <a:column name="start_date" prompt="开始日期" renderer="Leaf.formatDate"/>
                        <a:column name="end_date" prompt="结束日期" renderer="Leaf.formatDate"/>
                        <a:column name="days" prompt="天数"/>
                        <a:column name="finance_income" prompt="待确认金额（不含税）" align="right"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
