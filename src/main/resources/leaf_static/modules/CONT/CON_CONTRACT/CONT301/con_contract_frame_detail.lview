        window['${/parameter/@layout_code}_autoQuery'] = function () {
            enable_button("all");

            Leaf.request({
                url: "${/request/@context_path}/hls/cus/prj/contract/sign/status?projectId=" + '${/parameter/@project_id}',
                success: function (res) {
                    //debugger;
                    //租金支付表制作
                    if (res.result.record[0] === 'undo' || res.result.record[0] === 'read') {
                        disable_all_function('rent');
                    }
                    //付款前提条件
                    if (res.result.record[1] === 'undo' || res.result.record[1] === 'read') {
                        disable_all_function('condition');
                    }
                    //头寸报备
                    if (res.result.record[2] === 'undo' || res.result.record[2] === 'read') {
                        disable_all_function('report');
                    }

                    //付款申请 -
                    if (res.result.record[3] === 'undo' || res.result.record[3] === 'read') {
                        disable_all_function('payment');
                    }
                    //起租
                    if (res.result.record[4] === 'undo' || res.result.record[4] === 'read') {
                        disable_all_function('lease');
                    }

                    if (res.result.record[5] === 'undo' || '${/parameter/@hidden_right_button_flag}' == 'Y' || '${/parameter/@contract_status}' == 'CANCEL' || '${/parameter/@contract_status}' == 'APPROVING') {
                        disable_all_function('cancel');
                    }
                    //合同关闭
                    /* if(res.result.record[4] === 'undo' || res.result.record[4] === 'read'){
                         disable_all_function('cancel');
                     }*/


                }
            });
        }

        //停用右侧按钮
        function disable_all_function(str) {
            if (str === 'all') {
                //合同签约
                window['${/parameter/@layout_code}_sign_layout_dynamic_click'] = function () {
                    contract_button_function.sign(false);
                };
                //合同起租
                window['${/parameter/@layout_code}_lease_layout_dynamic_click'] = function () {
                    contract_button_function.lease(false);
                };
                //合同关闭
                window['${/parameter/@layout_code}_cancel_layout_dynamic_click'] = function () {
                    contract_button_function.cancel(false);
                };
                //合同撤销
                window['${/parameter/@layout_code}_termination_layout_dynamic_click'] = function () {
                    contract_button_function.termination(false);
                };
                //罚息减免
                window['${/parameter/@layout_code}_spinoff_layout_dynamic_click'] = function () {
                    contract_button_function.spinoff(false);
                };
                //付款申请
                window['${/parameter/@layout_code}_payment_layout_dynamic_click'] = function () {
                    contract_button_function.payment(false);
                };
                //租金支付表制作
                window['${/parameter/@layout_code}_rent_layout_dynamic_click'] = function () {
                    contract_button_function.rent(false);
                };
                //付款前提条件豁免
                window['${/parameter/@layout_code}_condition_layout_dynamic_click'] = function () {
                    contract_button_function.condition(false);
                };
                //头寸报备
                window['${/parameter/@layout_code}_report_layout_dynamic_click'] = function () {
                    contract_button_function.report(false);
                };

                $jq('.hls-selectBar img').each(function (index, element) {
                    element.setAttribute('src', element.getAttribute('src').replace('handle', 'undo'))
                })
            } else {
                window['${/parameter/@layout_code}_' + str + '_layout_dynamic_click'] = function () {
                    contract_button_function[str](false);
                };
                $jq('.hls-selectBar img').each(function (index, element) {
                    if (element.getAttribute('src').search(str) !== -1) {
                        element.setAttribute('src', element.getAttribute('src').replace('handle', 'undo'));
                    }
                })
            }
        }


        function enable_button(str) {
            if (str === 'all') {
                window['${/parameter/@layout_code}_sign_layout_dynamic_click'] = function () {
                    contract_button_function.sign(true);
                };

                window['${/parameter/@layout_code}_lease_layout_dynamic_click'] = function () {
                    contract_button_function.lease(true);
                };

                window['${/parameter/@layout_code}_cancel_layout_dynamic_click'] = function () {
                    contract_button_function.cancel(true);
                };

                window['${/parameter/@layout_code}_termination_layout_dynamic_click'] = function () {
                    contract_button_function.termination(true);
                };

                window['${/parameter/@layout_code}_spinoff_layout_dynamic_click'] = function () {
                    contract_button_function.spinoff(true);
                };

                window['${/parameter/@layout_code}_payment_layout_dynamic_click'] = function () {
                    contract_button_function.payment(true);
                };

                window['${/parameter/@layout_code}_rent_layout_dynamic_click'] = function () {
                    contract_button_function.rent(true);
                };

                window['${/parameter/@layout_code}_condition_layout_dynamic_click'] = function () {
                    contract_button_function.condition(true);
                };
                window['${/parameter/@layout_code}_report_layout_dynamic_click'] = function () {
                    contract_button_function.report(true);
                };

                $jq('.hls-selectBar img').each(function (index, element) {
                    element.setAttribute('src', element.getAttribute('src').replace('undo', 'handle'))
                    // element.setAttribute('src', element.getAttribute('src').replace('undo', 'handle'))
                })
            } else {
                window['${/parameter/@layout_code}_' + str + '_layout_dynamic_click'] = function () {
                    contract_button_function[str](true);
                };
                $jq('.hls-selectBar img').each(function (index, element) {
                    if (element.getAttribute('src').search(str) !== -1) {
                        element.setAttribute('src', element.getAttribute('src').replace('undo', 'handle'));
                    }
                })
            }
        }

        Leaf.onReady(function () {

            disable_all_function("all");
            Leaf.request({
                url: "${/request/@context_path}/hls/cus/prj/contract/sign/status?projectId=" + '${/parameter/@project_id}',
                success: function (res) {
                    enable_button("all");
                    //debugger;
                    //租金支付表制作
                    if (res.result.record[0] === 'undo' || res.result.record[0] === 'read') {
                        disable_all_function('rent');
                    }
                    //付款前提条件
                    if (res.result.record[1] === 'undo' || res.result.record[1] === 'read') {
                        disable_all_function('condition');
                    }
                    //头寸报备
                    if (res.result.record[2] === 'undo' || res.result.record[2] === 'read') {
                        disable_all_function('report');
                    }

                    //付款申请 -
                    if (res.result.record[3] === 'undo' || res.result.record[3] === 'read') {
                        disable_all_function('payment');
                    }
                    //起租
                    if (res.result.record[4] === 'undo' || res.result.record[4] === 'read') {
                        disable_all_function('lease');
                    }
                    if ('${/parameter/@report_flag}' == 'Y') {
                        disable_all_function('rent');
                        disable_all_function('condition');
                        disable_all_function('report');
                        disable_all_function('payment');
                        disable_all_function('lease');
                        disable_all_function('cancel');
                    }

                    //合同关闭
                    if (res.result.record[5] === 'undo' || '${/parameter/@hidden_right_button_flag}' == 'Y' || '${/parameter/@contract_status}' == 'CANCEL' || '${/parameter/@contract_status}' == 'APPROVING') {
                        disable_all_function('cancel');
                    }
                    //合同关闭
                    /* if(res.result.record[4] === 'undo' || res.result.record[4] === 'read'){
                         disable_all_function('cancel');
                     }*/


                }
            });
            if ('${/parameter/@FreeRental_flag}' == 'Y') {
                Leaf.showMessage('提示', '报价方案为自定义租金，报价计算失败，请重新计算报价！');
            }
            if ('${/parameter/@FreePrin_flag}' == 'Y') {
                Leaf.showMessage('提示', '报价方案为自定义本金，报价计算失败，请重新计算报价！');
            }
        });

        //移除前事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_brfore_remove'] = function (ds, record, bp_seq) {

            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            if (ds.id == att_ds_id) {
                for (var i = 0; i < record.length; i++) {
                    if (record[i].get('source_type') == 'LON_CONTENT') {
                        $L.showMessage('提示', '主融资租赁合同不允许删除！');
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        return false;
                    }
                }
            }
            return true;
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq) {
            debugger;
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var projectRecord = $(project_ds).getCurrentRecord();

            if (ds.id == quotation_ds && quotation_ds) {
                var quotationRecord = $(quotation_ds).getCurrentRecord();
                if (projectRecord && projectRecord.get('penalty_rate') && quotationRecord) {
                    quotationRecord.set('penalty_rate', projectRecord.get('penalty_rate'));
                }
            }

            if ('${/parameter/@report_flag}' == 'Y') {
                disable_all_function('rent');
                disable_all_function('condition');
                disable_all_function('report');
                disable_all_function('payment');
                disable_all_function('lease');
                disable_all_function('cancel');
            }
        };


        function projectPrincipalChange(leaseItemAmount, downPayment, deposit) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            if (!leaseItemAmount) {
                leaseItemAmount = quotationRecord.get('lease_item_amount');
            }
            if (!downPayment) {
                downPayment = quotationRecord.get('down_payment');
            }
            if (!deposit) {
                deposit = quotationRecord.get('deposit');
            }

            quotationRecord.set("project_principal", leaseItemAmount - downPayment);
            quotationRecord.set("risk_exposure", leaseItemAmount - downPayment - deposit);
        }


        function rateChange(intRateType) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            if (intRateType === '固定利率' || intRateType === 'FIXED') {
                //如果是固定利率的话，那么浮动方式和幅度是不可编辑的
                quotationRecord.getField('floating_way').setRequired(false);
                quotationRecord.getField('floating_way').setReadOnly(true);
                quotationRecord.getField('floating_way_n').setRequired(false);
                quotationRecord.getField('floating_way_n').setReadOnly(true);
                quotationRecord.getField('floating_way_rate').setRequired(false);
                quotationRecord.getField('floating_way_rate').setReadOnly(true);
                quotationRecord.getField('int_rate').setRequired(true);
                quotationRecord.getField('int_rate').setReadOnly(false);
                quotationRecord.set("base_int_rate_type", null);
                quotationRecord.set("base_rate_type", null);
                quotationRecord.set("floating_way", null);
                quotationRecord.set("floating_way_n", null);
                quotationRecord.set("floating_way_rate", null);
                quotationRecord.set("floating_way_range", null);
            } else {
                //如果是浮动利率，那么浮动方式和幅度是必填的
                quotationRecord.getField('floating_way').setRequired(true);
                quotationRecord.getField('floating_way').setReadOnly(false);
                quotationRecord.getField('floating_way_n').setRequired(true);
                quotationRecord.getField('floating_way_n').setReadOnly(false);
                quotationRecord.getField('floating_way_rate').setRequired(true);
                quotationRecord.getField('floating_way_rate').setReadOnly(false);
                quotationRecord.getField('int_rate').setRequired(false);
                quotationRecord.getField('int_rate').setReadOnly(true);
                //如果是浮动率那么基准利率类型为基准利率【PBOC】
                quotationRecord.set("base_rate_type", "PBOC");
            }
            baseRateChange();
            floatingWayChange(quotationRecord.get('floating_way'), quotationRecord.get('floating_way_rate'));
        }

        function floatingWayChange(floatingWay, floatingWayRate) {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            if (quotationRecord.get('int_rate_type') === 'FLOATING') {
                if (floatingWay === '按央行浮动比率' || floatingWay === 'MUTIPLY') {
                    quotationRecord.set("int_rate", quotationRecord.get('base_rate') * (accAdd(1, floatingWayRate)));
                } else {
                    quotationRecord.set("int_rate", accAdd(quotationRecord.get('base_rate'), floatingWayRate));
                }
            }
        }

        function getRentingFrequency(value) {
            switch (value) {
                case "月付" :
                    return "MONTH";
                case "季付" :
                    return "QUARTER";
                case "半年付" :
                    return "HALF_A_YEAR";
                case "年付" :
                    return "YEAR";
                case "双月付" :
                    return "DOUBLE_MONTH";
            }
        }

        function leaseTimesChange(rentingFrequency, leaseTimes) {
            var frequency = 0;
            if (rentingFrequency === 'MONTH') {
                frequency = 1;
            } else if (rentingFrequency === 'QUARTER') {
                frequency = 3;
            } else if (rentingFrequency === 'HALF_A_YEAR') {
                frequency = 6;
            } else if (rentingFrequency === 'YEAR') {
                frequency = 12;
            } else if (rentingFrequency === 'DOUBLE_MONTH') {
                frequency = 2;
            }
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var leaseTimeTemp = Math.ceil(accMul(leaseTimes, frequency));
            quotationRecord.set("lease_term", leaseTimeTemp);
            baseRateChange();
            leaseStartDateChange(quotationRecord.get('lease_start_date'));

        }

        function baseRateChange() {
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var url = "${/request/@context_path}/fnd/baserateset/queryForFinanceContract";
            jQuery.ajax({
                type: 'POST',
                url: url,
                data: JSON.stringify({
                    baseRateType: 'PBOC',
                    loanTerm: quotationRecord.get('lease_term')
                }),
                headers: {"X-CSRF-TOKEN": document.getElementsByTagName('meta')["_csrf"].content},
                async: false,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    baseRateSource = datas.rows;
                    if (baseRateSource.length > 0) {
                        quotationRecord.set("base_rate", baseRateSource[0].baseRate);
                        quotationRecord.set("base_rate_n", baseRateSource[0].description);
                        quotationRecord.set("description", baseRateSource[0].description);
                    } else {
                        quotationRecord.set("base_rate", "");
                        quotationRecord.set("base_rate_n", "");
                        quotationRecord.set("description", "");
                    }
                }
            });

        }

        function leaseStartDateChange(startDate) {
            var startDays = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0).getDate();
            var day = startDays - startDate.getDate();
            var endDate = new Date(startDate);
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            var frequency = leaseTimesChangeForLeaseDate(quotationRecord.get('renting_frequency'));
            if (frequency === 0 || quotationRecord.get('first_rental_payment_date')) {
                return;
            }
            endDate.setDate(1);
            DateAdd("m", frequency, endDate);
            var endDays = new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0).getDate();
            if (new Date(startDate).getDate() === startDays) {
                endDate.setDate(endDays);
            } else if (new Date(startDate).getDate() > endDays) {
                endDate.setDate(endDays - day);
            } else {
                endDate.setDate(new Date(startDate).getDate());
            }
            quotationRecord.set("first_rental_payment_date", new Date(endDate));
        }

        function leaseTimesChangeForLeaseDate(rentingFrequency) {
            var frequency = 0;
            if (rentingFrequency === 'MONTH') {
                frequency = 1;
            } else if (rentingFrequency === 'QUARTER') {
                frequency = 3;
            } else if (rentingFrequency === 'HALF_A_YEAR') {
                frequency = 6;
            } else if (rentingFrequency === 'YEAR') {
                frequency = 12;
            } else if (rentingFrequency === 'DOUBLE_MONTH') {
                frequency = 2;
            }
            return frequency;
        }

