                                return false;
                            } else {
                                for (var i = 0; i < lease_item_records.length; i++) {
                                    if (lease_item_records[i].data.net_asset_value_total == null || lease_item_records[i].data.net_asset_value_total == ''
                                        || lease_item_records[i].data.net_asset_value_total == 'undefined' || lease_item_records[i].data.net_asset_value_total == 0) {
