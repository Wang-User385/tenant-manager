        //报价计算入口
        window['${/parameter/@layout_code}_quotation_calc_layout_dynamic_click'] = function () {
            if (!$('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').validate()) {
                return;
            }
            var quote_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotation_record = $(quote_ds_id).getCurrentRecord();
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'](function () {
                Leaf.Masker.mask(Ext.getBody(), '正在计算...');
                Leaf.request({
                    url: $('con301_quotation_calc_submit_link_id').getUrl() + "?quotationId=" + quotation_id,
                    type: "GET",
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '计算成功',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                        //带入数据后打开excel
                        var win = new Leaf.Window({
                            id: 'hls900_open_price_winid',
                            url: url,
                            title: 'excel测算',
                            fullScreen: true
                        });
                        win.on('close', function () {
                            $('${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds').query();
                            $('${/parameter/@layout_code}_F_PAYMENT_prj_quotation_ds').query();
                        });
                    },
                    error: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function (res) {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            }, 'N');
        }

        //报价计算
        window['${/parameter/@layout_code}_SAVE1_LAYOUT_DYNAMIC_CLICK'] = function (func, calcFlag) {
            Leaf.Masker.mask(Ext.getBody(), '正在保存...');
            var quote_ds_id = '${/parameter/@layout_code}_G_QUOTATION_prj_quotation_ds';
            var quotation_record = $(quote_ds_id).getCurrentRecord();

            $(quote_ds_id).getCurrentRecord().data.CONT301F1_G_CASHFLOW_prj_quotation_cashflow = null
            var quotation_id = quotation_record.get('quotation_id');
            var price_list = quotation_record.get('price_list');
            var url = '${/request/@context_path}/modules/HLS/HLS200/hls_marketing_fin_calculate.lview?quotationId=' + quotation_id + '&priceList=' + price_list;
            var excelEdit = '${/parameter/@excel_edit}';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = url + '&readOnly=Y';
            }
            // 进入excel前打包数据存入excel
            var param = {};
            var data = $(quote_ds_id).getCurrentRecord();
            if (data) {
                // param = data[0];
                param = data.data;
            }
            if (calcFlag == 'N') {
                param['calc_flag'] = 'N';
            }
            //param带入excel
            param[quote_ds_id.replace('_ds', '')] = undefined;

            Leaf.request({
                url: $('con301_quotation_info_save_link_id').getUrl(),
                type: "POST",
                para: param,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                    if (typeof func == 'function') {
                        func();
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                failure: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });
        }
        window['${/parameter/@layout_code}_quotation_close_query'] = function () {
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var cashflow_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow');
            $(quotation_ds_id).query();
            $(cashflow_ds_id).query();
        }
