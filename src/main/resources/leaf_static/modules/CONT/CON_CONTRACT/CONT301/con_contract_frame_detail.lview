<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <style>
            .hls-selectBar ul li .contain {
                width: 100%;
                height: 70px !important;
                text-align: center;
                color: #7A849A;
                cursor: pointer;
                background-color: white;
                overflow: hidden;
                border: 1px solid #BDC4D4;
                border-bottom: none;
            }
        </style>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_csh_payment_req_create_for_con_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH302/csh_payment_req_create_for_contract.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_contract_rent_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_contract_rent_contract_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_contract.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_cancel_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_cancel.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_end_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_end.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_due_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_due.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_rent_payment_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_rent_payment_make.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_condition_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_TRX/CSH310/csh_payment_conditional_detail.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_report_link_id"
                url="${/request/@context_path}/modules/CAP/CAP100/hls_funding_plan.lview"/>

        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contract_attachment_link_id"
                url="${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contract_sign_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_sign.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contract_payment_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_payment.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_lease_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_lease.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_termination_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_termination.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_spin_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_spin.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_prj306_bp_master_modify_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_BP/PRJ306/hls_bp_master_modify.lview"/>
        <a:link id="${/parameter/@layout_code}${/parameter/@page}_con_contact_archive_link_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_archive.lview"/>
        <a:link id="cont304f1_create_document_number_link_id"
                url="${/request/@context_path}/content/create/doc/number/create/for/con"/>

        <a:link id="hls100_calc_price_quotation_common_link_id"
                url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900/quotation_calc_common.lview"/>
        <a:link id="rpt710_project_price_review_id2"
                url="${/request/@context_path}/modules/RPT/RPT710/rpt_project_query_price_review.lview"/>
        <a:link id="project_credit_credit_notice_link2"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition_query.lview"/>
        <a:link id="project_credit_credit_notice_link3"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316T1/prj_project_credit_transition.lview"/>

        <a:link id="lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <a:link id="SW001_PLEDGE_LEASE"
                url="${/request/@context_path}/modules/SW/SW001/hls_pledge_lease_detail.lview"/>
        <a:link id="bp100_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/state-machine.js"
                type="text/javascript"></script>
        <script src="${/request/@context_path}/resources/hls/hlsBlock/javascript/format-date.js"></script>
        <script src="${/request/@context_path}/resources/hls/HlsCus-common-util.js"></script>

        <link href="${/request/@context_path}/resources/hls/imgPreview/viewer.css" rel="stylesheet" type="text/css"/>
        <script src="${/request/@context_path}/resources/hls/imgPreview/viewer.js"/>

        <script src="${/request/@context_path}/resources/hls/imgPreview/image-view.js"/>
        <a:link id="con301_quotation_info_save_link_id" url="${/request/@context_path}/prj/quotation/record/save"/>
        <a:link id="con301_quotation_calc_submit_link_id" url="${/request/@context_path}/ct/prj/quotation/re/calc"/>
        <a:link id="bp100_bp_master_modify_id11"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>

        <script><![CDATA[


        //查询时调用 form
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            if (ds.bindname === "CONT301F1_F_BASIC_INFO_prj_quotation") {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
                // ds.setQueryParameter('data_class', 'VIRTUAL_CON');
            }
            // debugger;
            if (ds.bindname === "CONT301F1K_G_CASHFLOW_prj_quotation_cashflow") {
                ds.setQueryParameter('quotation_id', '${/parameter/@project_id}');
            }


            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';

        };

        function open_bp_modify_win33(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '客户详细信息';
            param['function_usage'] = 'QUERY';
            if (param['bp_class'] == 'ORG') {
                param['function_code'] = 'BP100F1';

            } else {
                param['function_code'] = 'BP100F2';
            }
            param['winid'] = 'bp_master_modify_winid11';

            if ('${/parameter/@wfl_bp_flag}' == 'Y') {
                parent.parent_bp_chance_detail(param, ds_id);
            } else {
                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id11', ds_id, 'BP100');
            }

        }

        function open_finance_modify_win33(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;

            var bp_id = param.bp_id;
            var bp_name = param.bp_name;
            var bp_code = param.bp_code;
            if (!bp_id) {
                return;
            }
            new Leaf.Window({
                id: 'hls_bp_master_financial_info_winid22',
                url: '${/request/@context_path}/modules/BP/BP100/hls_bp_master_financial_info.lview',
                params: {
                    bp_id: bp_id,
                    bp_master_code: bp_code,
                    bp_master_name: bp_name,
                    winid: 'hls_bp_master_financial_info_winid22',
                    function_usage: 'QUERY'
                },
                title: '财务报表查看',
                fullScreen: false,
                width: 850,
                height: 535,
                side: "right",
                draggable: true
            });
        }

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'download') {
                if (record.get('attachment_id')) {
                    var url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + record.get('attachment_id');
                    return '<a href=' + url + '>下载</a>';
                }
            }
            if (name == 'edit' && record.get('source_pk_value') && record.get('source_pk_value').indexOf(',') === -1) {
                return '<a href=javascript:editDocFile(\'' + record.get('source_pk_value') + '\')>在线编辑</a>';
            }

            var link_function = 'upload_file';
            if (name == 'upload' && record.get('project_attachment_id')) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\', \'CONTRACT_CONTENT\');">附件</a>';
            }
            var link_function = 'physical_assets_name_link';
            if (name == 'physical_assets_name' && record.get('physical_assets_name')) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\',\'' + record.get('project_attachment_id') + '\');">' + value + '</a>';
            }

            if (name === 'upload_text' && record.get('project_attachment_id')) {
                link_function = 'upload_file';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.get('project_attachment_id') + '\', \'PRJ_PROJECT_ATTACHMENT\');">附件</a>';
            }
            if (name === 'lease_detail_link' && record.get('lease_item_id')) {
                return '<a href="javascript:lease_detail_open(\'' + record.get('excel_id') + '\',\'' + record.get('result_id') + '\',\'' + record.get('lease_item_id') + '\')">租赁物明细</a>';
            }
            if (name === 'pledge_link' && record.get('lease_item_id')) {
                return '<a href="javascript:pledge_detail_open(\'' + record.get('excel_id') + '\',\'' + record.get('result_id') + '\',\'' + record.get('lease_item_id') + '\')">抵质押物明细</a>';
            }

            if (name === 'con_upload' && record.get('project_attachment_id')) {
                link_function = 'con_upload';
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '附件上传' + '(' + record.get('attachment_sum') + ')' + '</a>';
            }
            if (name == 'file_name' && value) {
                if (record.get('attachment_id_n') != null) {
                    var html = '';
                    var fileNameList = value.split(',');
                    var attachmentIdList = record.get('attachment_id_n').split(',');
                    var sourcePkList = record.get('source_pk_value').split(',');
                    for (var i = 0; i < fileNameList.length; i++) {
                        if (html != '') {
                            html += ',';
                        }
                        if (atmTypeRef(fileNameList[i])) {
                            html += '<span><a target="_self" alt="' + fileNameList[i] + '" imageIndex="img_' + attachmentIdList[i] + '" ref="img_' + attachmentIdList[i] + '" href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkPdf(fileNameList[i])) {
                            var url = encodeURIComponent('${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i]);
                            html += '<span><a target="_blank" href="${/request/@context_path}/resources/hls/pdf/web/viewer.html?file=' + url + '">' + fileNameList[i] + '</a></span>';
                        } else if (checkDox(fileNameList[i])) {
                            html += '<a href=javascript:editDocFile(\'' + sourcePkList[i] + '\')>' + fileNameList[i] + '</a>';
                        } else {
                            html += '<span><a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + attachmentIdList[i] + '">' + fileNameList[i] + '</a></span>';
                        }

                    }
                    return html;
                }
            }

            if (name == 'lease_item_code') {
                //debugger;
                if (record.get('lease_item_type') == 'LEASE') {
                    link_function = 'lease_item_detail';
                } else if (record.get('lease_item_type') == 'MORTGAGE' || record.get('lease_item_type') == 'PLEDGE') {
                    link_function = 'pledge_detail';
                }
                var detail = '';
                if (value) {
                    detail = value;
                }
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + detail + '</a>';
            }
            if (name == 'bp_detali') {
                return '<a href="javascript:open_bp_modify_win33(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '客户详细信息' + '</a>';
            }
            if (name == 'finnance_info') {
                return '<a href="javascript:open_finance_modify_win33(\'' + record.ds.id + '\',\'' + record.id + '\')">' + '财务报表' + '</a>';
            }
            return value;
        };

        window['lease_item_detail'] = function (record_id, ds_id) {
            //debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_item_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'lease_info_detaill_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'LEASE001');
        };

        window['pledge_detail'] = function (record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            var status = param.lease_item_id;
            var type = 'MODIFY';
            param['url_title'] = '抵质押物详细';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = type;
            param['winid'] = 'hls_lease_item_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = '${/parameter/@function_usage}';
            param['maintain_type'] = '${/parameter/@maintain_type}';
            var link_id = 'SW001_PLEDGE_LEASE';
            hls_doc_get_layout_code(param, link_id, ds_id, 'SW001');
        };

        function atmTypeRef(name) {
            return /\.(jpg|png|gif|bmp|jpeg)$/i.test(name)
        }

        function checkPdf(name) {
            return /\.(pdf)$/i.test(name)
        }

        function checkDox(name) {
            return /\.(doc|docx)$/i.test(name)
        }

        //租赁物明细
        function lease_detail_open(excel_id, result_id, lease_item_id) {

            if (typeof (lease_item_id) === 'undefined' || 'undefined' === lease_item_id) {
                Leaf.showMessage('提示', '租赁物查询有误!', null);
                return;
            }
            if (typeof (excel_id) === 'undefined' || 'undefined' === excel_id) {
                Leaf.showMessage('提示', '租赁物模板查询有误!', null);
                return;
            }
            if (typeof (result_id) === 'undefined' || 'undefined' === result_id) {
                Leaf.showMessage('提示', '该租赁物未维护租赁物明细!', null);
                return;
            }

            new Leaf.Window({
                id: 'contract_lease_excel_detail_win_id',
                params: {
                    result_id: result_id,
                    excel_id: excel_id,
                    source_document_category: 'HLS_LEASE_ITEM_RENTAL',
                    source_document_id: lease_item_id,
                    winid: 'contract_lease_excel_detail_win_id',
                    readOnly: 'Y'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '租赁物明细',
                fullScreen: true
            });

        }


        //抵质押物明细
        function pledge_detail_open(excel_id, result_id, lease_item_id) {

            if (typeof (lease_item_id) === 'undefined' || 'undefined' === lease_item_id) {
                Leaf.showMessage('提示', '抵质押物查询有误!', null);
                return;
            }
            if (typeof (excel_id) === 'undefined' || 'undefined' === excel_id) {
                Leaf.showMessage('提示', '抵质押物模板查询有误!', null);
                return;
            }
            if (typeof (result_id) === 'undefined' || 'undefined' === result_id) {
                Leaf.showMessage('提示', '该抵质押物未维护租赁物明细!', null);
                return;
            }

            new Leaf.Window({
                id: 'contract_pledge_excel_detail_win_id',
                params: {
                    result_id: result_id,
                    excel_id: excel_id,
                    source_document_category: 'MORTGAGE_PLEDGE_REPORT',
                    source_document_id: lease_item_id,
                    winid: 'contract_pledge_excel_detail_win_id',
                    readOnly: 'Y'
                },
                url: '${/request/@context_path}/modules/HLS/HLS600/hls_web_excel_calc_iframe.lview',
                title: '抵质押物明细',
                fullScreen: true
            });

        }


        window['upload_file'] = function (record_id, project_attachment_id, table) {
            var url;
            var function_usage = '${/parameter/@function_usage}';

            if ('${/parameter/@function_usage}' === 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if ('${/parameter/@file_flag}' == 'Y') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == null) {
                $L.showInfoMessage("提示", "请先保存项目信息再上传附件!");
                return;
            }
            if (project_attachment_id == null) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }


            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
                $('${/parameter/@layout_code}_G_ATTACHMENT_prj_project_attachment_ds').query();
                $(att_ds_id).query();
            });
        }

        window['physical_assets_name_link'] = function (record_id, ds_id, project_attachment_id) {
            // debugger;
            var record = $(ds_id).findById(record_id);
            if (record.get('source_type') == 'MORTGAGE_CONTRACT' || record.get('source_type') == 'CONTRACT_OF_PLEDGE') {
                var param = {};
                param['url_title'] = '抵质押物明细';
                param['function_code'] = 'SW001F1';
                param['function_usage'] = 'QUERY';
                param['lease_item_id'] = record.get('source_id');

                param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
                hls_doc_get_layout_code(param, 'SW001_PLEDGE_LEASE', null, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
            }
            if (record.get('source_type') == 'DEPOSIT_CONTENT') {
                var param = {};
                param['url_title'] = '交易方明细';
                param['function_code'] = 'BP100F1';
                param['function_usage'] = 'QUERY';
                param['bp_id'] = record.get('source_id');
                param['winid'] = 'bp_master_modify_winid';

                hls_doc_get_layout_code(param, 'bp100_bp_master_modify_id', ds_id, 'BP100');
            }

        };

        window['con_upload'] = function (record_id, ds_id) {
            // debugger;
            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
            var project_record = $(prj_ds_id).getCurrentRecord();
            var project_id = project_record.get('project_id');
            if (project_id == undefined || project_id == 0) {
                $L.showInfoMessage("提示", "请先保存合同信息再上传附件!");
                return;
            }
            var prj_attach_record = $(ds_id).findById(record_id);
            var project_attachment_id = prj_attach_record.get('project_attachment_id');
            if (project_attachment_id == undefined) {
                $L.showInfoMessage("提示", "请先保存附件信息!");
                return;
            }
            var url;
            var function_usage = '${/parameter/@function_usage}';
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            if ('${/parameter/@file_flag}' == 'Y') {
                url = '${/request/@context_path}/downloadFile.lview';
                function_usage = 'QUERY';
            }
            var att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');
            if ('${/parameter/@finalized_flag}' == 'true' && ds_id == att_ds_id) {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var table_name;
            var document_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            var file_end_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE_END');
            table_name = 'FCT_PROJECT_ATTACHMENT';

            var win = new Leaf.Window({
                id: 'cont301_open_attachment_winid',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': table_name,
                    winid: 'cont301_open_attachment_winid',
                    function_usage: function_usage
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(document_list_ds_id).query();
                if (file_end_list_ds_id) {
                    $(file_end_list_ds_id).query();
                }
            });
        };

        //移除事件(grid,attach,gridbox,table)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_remove'] = function (ds, record, bp_seq) {
            if (ds.bindname === '${/parameter/@layout_code}_G_FILE_TMP_fct_project_attachment_ds') {
                $('${/parameter/@layout_code}_G_FILE_TMP_fct_project_attachment_ds').query();
            }
            if (ds.bindname === '${/parameter/@layout_code}_G_FILE_fct_project_attachment_ds') {
                $('${/parameter/@layout_code}_G_FILE_fct_project_attachment_ds').query();
            }
        };

        //在线编辑
        function editDocFile(source_pk_value) {
            if ('${/parameter/@function_usage}' == 'QUERY') {
                window.open("${/request/@context_path}/sys/office/view?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            } else {
                window.open("${/request/@context_path}/sys/office/review?_csrf=${/session/@_csrf.token}&sourceTypeCode=fnd_atm_attachment_multi&sourcePkValue=" + source_pk_value, '_blank');
            }
        }


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {

            //现金流
            if (ds.bindname === "CONT301F1K_G_CASHFLOW_prj_quotation_cashflow") {
                ds.setQueryParameter('quotation_id', '${/parameter/@project_id}');
                ds.setQueryParameter('data_class', 'VIRTUAL_CON');
                ds.setQueryParameter('source_document_category', 'PRJ_PROJECT');
            }
            //交易方信息
            if (ds.bindname === "CONT301F1_G_TRX_prj_project_bp") {
                ds.setQueryParameter('bp_categroy', 'CON_CONTRACT');
                ds.setQueryParameter('bp_role_type', 'CLIENT');
            }

            var prj_att_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTACHMENT');

            if (ds.id === prj_att_ds_id) {
                ds.setQueryParameter('source_type', 'PRJ_PROJECT_CONTENT');
                ds.setQueryParameter('project_attachment_category', 'HLS_PRJ_PROJECT_DOCX3');
            }


            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';

        };

        //租赁物创建
        window['${/parameter/@layout_code}_G_LEASE_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            //window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            // var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var param = {};
            param['url_title'] = '租赁物详细信息';
            param['function_code'] = 'LEASE001F1';
            param['winid'] = 'lease_detail_new_winid';
            // param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            var link_id = 'lease_info_detaill_id';
            hls_doc_get_layout_code(param, link_id, null, 'LEASE001');
        };

        //抵质押物创建
        window['${/parameter/@layout_code}_G_MORTGAGE_PLEDGOR_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var param = {};
            param['url_title'] = '抵质押物创建';
            param['function_code'] = 'SW001F1';
            param['function_usage'] = 'CREATE';

            param['winid'] = 'SW001_PLEDGE_LEASE_create_winid';
            hls_doc_get_layout_code(param, 'SW001_PLEDGE_LEASE', null, 'SW001', null, null, '${/parameter/@layout_code}_autoQuery');
        };

        window['${/parameter/@layout_code}_G_REPAYMENT_PLAN_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            if ($('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').isModified()) {
                Leaf.showMessage("提示", "请先保存!", null);
                return;
            }
            $L.Masker.mask(document.body, "计算中..");
            var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var quotationRecord = $(quotation_ds).getAt(0);
            Leaf.request({
                url: "${/request/@context_path}/ct/prj/project/calc/xirr",
                para: {quotation_id: quotationRecord.get('quotation_id')},
                success: function (res) {
                    $(quotation_ds).query();
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "计算成功!", null);
                },
                error: function () {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage("提示", "计算出错!", null);
                },
                scope: this
            });

        }

        window['${/parameter/@layout_code}_on_layout_dynamic_grid_beforecreate'] = function (ds, record, config_records, bp_seq) {
            if (ds.bindname === "CONT301F1_G_OTH_prj_quotation_cashflow") {
                var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                var quotationRecord = $(quotation_ds).getAt(0);
                if (!quotationRecord.get('quotation_id')) {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
            return true;
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            //交易方信息
            if (ds.bindname === "CONT301F1_G_TRX_prj_project_bp") {
                record.set('bp_categroy', 'CON_CONTRACT');
                record.set('bp_role_type', 'CLIENT');
            }

            if (ds.bindname === "CONT301F1K_G_CASHFLOW_prj_quotation_cashflow") {
                record.set('quotation_id', '${/parameter/@project_id}');
                record.set('data_class', 'VIRTUAL_CON');
                record.set('source_document_category', 'PRJ_PROJECT');
            }


            var attach_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_ATTACHMENT');
            if (ds.id === attach_ds_id) {
                record.set('project_id', '${/parameter/@project_id}');
                record.set('project_attachment_category', 'CON_CONTRACT_ATT');

            }
        };


        function assignValue(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record[i] = data[i];
                }
            }
        }

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            // debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp');
            if (ds_id == ds.id && ds_id) {
                if (record) {
                    // debugger;
                    if (record.get('bp_type') === 'TENANT') {
                        record.getField('bp_id').setReadOnly(true);
                        record.getField('bp_id_n').setReadOnly(true);
                        /* record.getField('bank_account_id').setReadOnly(true);

                         record.getField('bank_account_id_n').setReadOnly(true);
                         record.getField('description').setReadOnly(true);*/


                    }

                }
            }
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            if (ds.id == con_file_ds) {
                if (record) {

                    if ('${/parameter/@wfl_flag}' == 'Y' && '${/parameter/@finalized_flag}' == 'N') {
                        record.getField('document_number').setReadOnly(false);
                    } else {
                        record.getField('document_number').setReadOnly(true);
                    }
                }
            }
        };

        //文本保存
        window['${/parameter/@layout_code}_G_FILE_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');

            var records = $(con_file_ds).getAll();
            var data = [];
            for (var i = 0; i < records.length; i++) {
                if (records[i].dirty) {
                    data.push(records[i].data);
                }
            }
            Leaf.request({
                url: '${/request/@context_path}/prj/con/check/contract/number',
                para: data,
                scope: this,
                success: function (res) {
                    $(con_file_ds).submit();
                    Leaf.SideBar.show({
                        msg: '保存成功',
                        duration: 2000
                    });
                },
                failure: function () {
                },
                error: function () {
                }
            });
        };


        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {

            //校验

            var prj_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project', 'F_BASIC_INFO');
            var prjRecord = $(prj_ds_id).getCurrentRecord().data;
            var project_id = $(prj_ds_id).getCurrentRecord().get('project_id');
            var prjRecord = {};
            //租赁物信息
            var item_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_lease_item', 'G_LEASE');
            if ($(item_ds_id).getAll().length != 0) {
                var item_records = $(item_ds_id).getAll();
                var hlsCusPrjProjectLeaseItemList = [];
                prjRecord['hls_cus_prj_project_lease_item_list'] = [];
                for (var i = 0; i < item_records.length; i++) {
                    hlsCusPrjProjectLeaseItemList[i] = {};
                    item_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectLeaseItemList[i], item_records[i].data);
                    prjRecord['hls_cus_prj_project_lease_item_list'].push(hlsCusPrjProjectLeaseItemList[i]);

                }
            }
            //质押信息
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_chance_mp', 'G_MORTGAGE_PLEDGOR');
            if ($(pledge_ds_id).getAll().length != 0) {
                var pledge_records = $(pledge_ds_id).getAll();
                var hlsCusPrjProjectBpList = [];
                prjRecord['hls_cus_prj_project_bp_list'] = [];
                for (var i = 0; i < pledge_records.length; i++) {
                    hlsCusPrjProjectBpList[i] = {};
                    pledge_records[i].data['project_id'] = project_id;
                    assignValue(hlsCusPrjProjectBpList[i], pledge_records[i].data);
                    prjRecord['hls_cus_prj_project_bp_list'].push(hlsCusPrjProjectBpList[i]);

                }
            }
            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow');
            var ds_id3 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'G_TRX');
            var ds_id4 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment');
            var ds_id5 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
            var ds_id6 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_survive_require');

            prjRecord[pledge_ds_id.replace('_ds', '')] = undefined;
            prjRecord[prj_ds_id.replace('_ds', '')] = undefined;
            prjRecord[item_ds_id.replace('_ds', '')] = undefined;
            prjRecord[ds_id1.replace('_ds', '')] = undefined;
            prjRecord[ds_id2.replace('_ds', '')] = undefined;
            prjRecord[ds_id3.replace('_ds', '')] = undefined;
            prjRecord[ds_id4.replace('_ds', '')] = undefined;
            prjRecord[ds_id5.replace('_ds', '')] = undefined;
            prjRecord[ds_id6.replace('_ds', '')] = undefined;

            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();

            Leaf.request({
                url: '${/request/@context_path}/ct/con/contract/checkItems',
                para: prjRecord,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    pledgeProportionCheckFlag = res.result.record[0];
                    if (pledgeProportionCheckFlag == 'N') {
                        Leaf.showConfirm("确认", "同一抵押物抵押占比已超过100%！是否继续？", function okFun() {
                            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
