                                if (lease_item_records[i].data.net_asset_value_total == null || lease_item_records[i].data.net_asset_value_total == ''
                                    || lease_item_records[i].data.net_asset_value_total == 'undefined' || lease_item_records[i].data.net_asset_value_total == 0) {
                                    Leaf.showMessage("提示", "至少有一条租赁物信息，并且租赁物净值不能为0或空!");
                                    return false;
                                }
                            }
                        }


                        if (mortgage == 'Y' || pledge == 'Y') {
                            if (mortgage_records.length == 0) {
                                Leaf.showMessage("提示", "担保方式为质押或抵押时，至少有一条抵质押信息，并且评估价值总额不能为0或空!");
                                return false;
                            } else {
                                for (var i = 0; i < mortgage_records.length; i++) {
                                    if (mortgage_records[i].data.asset_value_total == null || mortgage_records[i].data.asset_value_total == ''
                                        || mortgage_records[i].data.asset_value_total == 'undefined' || mortgage_records[i].data.asset_value_total == 0) {
                                        Leaf.showMessage("提示", "担保方式为质押或抵押时，至少有一条抵质押信息，并且抵质押物评估价值不能为0或空!");
                                        return false;
                                    }
                                }
                            }
                        }


                        if (ensure == 'Y' && mortgage != 'Y' && pledge != 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'DEPOSIT_CONTENT') {
                                    ensure_length++;
                                }
                            }
                            if (ensure_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为保证，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }
                        }

                        if (ensure != 'Y' && mortgage == 'Y' && pledge != 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'MORTGAGE_CONTRACT') {
                                    mortgage_length++;
                                }
                            }
                            if (mortgage_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为抵押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }
                        }

                        if (ensure != 'Y' && mortgage != 'Y' && pledge == 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'CONTRACT_OF_PLEDGE') {
                                    pledge_length++;
                                }
                            }
                            if (pledge_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为质押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }
                        }
                        if (ensure == 'Y' && mortgage == 'Y' && pledge != 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'DEPOSIT_CONTENT') {
                                    ensure_length++;
                                }
                            }
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'MORTGAGE_CONTRACT') {
                                    mortgage_length++;
                                }
                            }
                            if (ensure_length == 0 || mortgage_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为保证、抵押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }

                        }
                        if (ensure == 'Y' && mortgage != 'Y' && pledge == 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'DEPOSIT_CONTENT') {
                                    ensure_length++;
                                }
                            }
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'CONTRACT_OF_PLEDGE') {
                                    pledge_length++;
                                }
                            }
                            if (ensure_length == 0 || pledge_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为保证、质押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }

                        }
                        if (ensure != 'Y' && mortgage == 'Y' && pledge == 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'MORTGAGE_CONTRACT') {
                                    mortgage_length++;
                                }
                            }
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'CONTRACT_OF_PLEDGE') {
                                    pledge_length++;
                                }
                            }
                            if (mortgage_length == 0 || pledge_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为抵押、质押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }

                        }
                        if (ensure == 'Y' && mortgage == 'Y' && pledge == 'Y') {
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'DEPOSIT_CONTENT') {
                                    ensure_length++;
                                }
                            }
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'MORTGAGE_CONTRACT') {
                                    mortgage_length++;
                                }
                            }
                            for (var i = 0; i < con_file_records.length; i++) {
                                if (con_file_records[i].get('source_type') == 'CONTRACT_OF_PLEDGE') {
                                    pledge_length++;
                                }
                            }
                            if (ensure_length == 0 || mortgage_length == 0 || pledge_length == 0) {

                                Leaf.showConfirm('提示', '该合同担保方式为保证、抵押、质押，需上传相应合同附件！', function okfun() {
                                    submit_approval();
                                }, function cancelfun() {
                                    return;
                                });
                            } else {
                                submit_approval();
                            }

                        }
                        if (ensure != 'Y' && mortgage != 'Y' && pledge != 'Y') {
                            submit_approval();
                        }
                    }

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    return false;
                },
                sync: true,
                scope: this
            });


        };

        function submit_approval() {
            var con_file_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'fct_project_attachment', 'G_FILE');
            var mortgage_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_chance_mp', 'G_MORTGAGE_PLEDGOR');
            var trx_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_bp', 'G_TRX');
            var assure_ds_id = 'CONT301F1_F_ASSURE_MEANS_N_prj_project_ds';

            var con_file_records = $(con_file_ds).getAll();
            var mortgage_records = $(mortgage_ds_id).getAll();
            var trx_records = $(trx_ds_id).getAll();
            var assure_record = $(assure_ds_id).getCurrentRecord();
            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                $L.Masker.mask(document.body, "提交中..");
                var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var projectRecord = $(project_ds).getAt(0);
                var conFileRecord = $(con_file_ds).getAll();
                if (conFileRecord.length == 0) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "请先维护<b>【合同文本】</b>，再提交审批！");
                    return false;
                }

                var cashflow_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation_cashflow', 'G_CASHFLOW');
                var cashflowRecord = $(cashflow_ds).getAll();
                if (cashflowRecord.length == 0) {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "报价未计算成功！");
                    return false;
                }
                var checkAttachFlag = 'Y';
                var attachmentRecord = $(con_file_ds).getAll();
                for (var i = 0; i < attachmentRecord.length; i++) {
                    if (attachmentRecord[i].get('file_name') == 'undefined' || attachmentRecord[i].get('file_name') == '' || attachmentRecord[i].get('file_name') == undefined) {
                        checkAttachFlag = 'N';
                    }
                }

                if (checkAttachFlag == 'N') {
                    $L.Masker.unmask(document.body);
                    $L.showInfoMessage("提示", "请在<b>【合同文本】</b>处上传文件</b>!");
                    return;
                }

                if (projectRecord.get('contract_amount') > projectRecord.get('real_left_amount')) {
                    $L.Masker.unmask(document.body);
                    Leaf.showMessage('提示', '合同金额不能大于项目审批剩余额度！');
                    return;
                }

                Leaf.request({
                    url: "${/request/@context_path}/ct/con/contract/submit/wfl",
                    para: {project_id: projectRecord.get('project_id')},
                    success: function (res) {
                        $L.Masker.unmask(document.body);
                        $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                            $('${/parameter/@winid}').close();
                            if ("${/parameter/@parent_winid}") $("${/parameter/@parent_winid}").close();
                        });
                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "提交失败!", null);
                    },
                    scope: this
                });
            });
        };

        //生成文本
        window['${/parameter/@layout_code}_create_layout_dynamic_click'] = function () {

            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                $L.Masker.mask(document.body, "生成中..");
                var project_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project');
                var projectRecord = $(project_ds).getAt(0);
                Leaf.request({
                    url: "${/request/@context_path}/ct/con/project/attachment/content/create?projectId=" + '${/parameter/@project_id}',
                    success: function (res) {
                        $('CONT301F1_G_FILE_fct_project_attachment_ds').query();
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "生成成功!", null);

                    },
                    error: function () {
                        $L.Masker.unmask(document.body);
                        // Leaf.showMessage("提示", "生成失败!", null);
                    },
                    scope: this
                });
            });
        };

        //
        window['${/parameter/@layout_code}_calc_layout_dynamic_click'] = function () {
            // 先执行保存操作,保存成功后提交数据
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                $L.Masker.mask(document.body, "计算中..");
                var quotation_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
                var quotationRecord = $(quotation_ds).getAt(0);
                Leaf.request({
                    url: "${/request/@context_path}/ct/prj/quotation/re/calc?quotationId=" + quotationRecord.get('quotation_id'),
                    success: function (res) {
                        $('CONT301F1_G_OTH_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_CASHFLOW_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').query();
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "计算成功!", null);
                    },
                    error: function () {
                        $('CONT301F1_G_OTH_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_CASHFLOW_prj_quotation_cashflow_ds').query();
                        $('CONT301F1_G_REPAYMENT_PLAN_prj_quotation_cashflow_ds').query();
                        $L.Masker.unmask(document.body);
                        Leaf.showMessage("提示", "计算出错!", null);
                    },
                    scope: this
                });
            });
        };

        var contract_button_function = {
