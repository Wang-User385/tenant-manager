<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" customizationEnabled="true"
          dynamiccreateenabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="PRJ419_open_insurance_information_link_id"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419F5/lease_item_insurance.lview"/>
        <a:link id="prj306_bp_master_modify_id"
                url="${/request/@context_path}/modules/BP/BP100/bp_master_modify.lview"/>
        <script src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/state-machine.js"
                type="text/javascript"></script>
        <script><![CDATA[

        let currentDivision = '${/parameter/@division}';
        var manufacturerCode = '${/parameter/@manufacturer_code}';
        var manufacturer_id='${/parameter/@manufacturer_id}';
        var contract_id = '${/parameter/@contract_id}';
        var finance_amount=0;

        $L.onReady(function () {
            //查询额度信息
            if('${/parameter/@function_usage}' != 'CREATE'){
                debugger
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                var record = $('${/parameter/@layout_code}_F_QUTA__ds').getCurrentRecord();
                Leaf.request({
                    url: '${/request/@context_path}/contract/manufacturer/query/amount?contractId='+contract_id,
                    success: function (res) {
                        record.set('credit_amt',res.result.record[0].credit_amt);
                        record.set('tenant_amount',res.result.record[0].tenant_amount);
                        record.set('release_amount',finance_amount);
                        record.set('surplus_amount',res.result.record[0].credit_amt - res.result.record[0].tenant_amount);
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }
        });

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            debugger
            var quotation_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            if(quotation_ds_id == ds.id){
                var record = $(quotation_ds_id).getAt(0);
                if(record!=null){
                    finance_amount=record.get('finance_amount');
                }
                var qota_record = $('${/parameter/@layout_code}_F_QUTA__ds').getCurrentRecord();
                qota_record.set('release_amount',finance_amount);
            }
        };

        //indexchange事件(grid,attach,gridbox,table)
        window['${/parameter/@layout_code}_on_layout_dynamic_grid_indexchange'] = function (ds, record, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation');
            var cc_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            if (ds.id == ds_id) {
                $(cc_ds_id).setQueryParameter('generated_source_doc_id', record.get('quotation_id'));
                $(cc_ds_id).query();
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_quotation'):
                    ds.setQueryParameter('source_document_id', '${/parameter/@contract_id}');
                    ds.setQueryParameter('source_document_category', 'CON_CONTRACT');
                    break;
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_bp'):
                    ds.setQueryParameter('bp_category', 'TENANT');
                    break;
                case 'CONT330F1_G_GURANTOR_con_contract_bp_ds':
                    ds.setQueryParameter('bp_category', 'GUARANTOR');
                    break;
            }
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {

            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment'):
                    record.set('contract_attachment_category', 'NEW');
                    break;
            }
        };

        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'bp_info_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:red">查看承租人</span></a>';
            } else if (name == 'bp_supplier_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:red">查看供应商</span></a>';
            } else if (name == 'bp_security_link' && !record.isNew) {
                return '<a href="javascript:open_bp_modify_win(\'' + record.ds.id + '\',\'' + record.id + '\')"><span style="color:red">查看担保人</span></a>';

            } else if (name == 'quote' && !record.isNew) {
                return '<a href="javascript:sig001_open_price(\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('quotation_id') + '\')"><span style="color:red">报价</span></a>';
            }
            else if (name == 'attachment_detail' && !record.isNew) {
                var table_name = record.get('contract_attachment_category');
                return '<a href="javascript:sig001_open_attach(\'' + record.get('contract_attachment_id') + '\',\''+table_name+'\')">上传/下载</a>';
            }
            else if(name =='insurance_information' && !record.isNew){
                return '<a style="color: red;" href="javascript:sig001_open_insurance_information(\'' + record.ds.id + '\',\'' + record.id + '\')">保险信息</a>';
            }
            return value;
        };

        //附件
        var win;

        function sig001_open_attach(contract_attachment_id,table_name) {
            var url = '${/request/@context_path}/downloadFile.lview';
            win = new Leaf.Window({
                id: 'sig001_open_attachment_winid',
                url: url,
                params: {
                    'header_id': contract_attachment_id,
                    'table_name': 'CON_CONTRACT_ATTACHMENT',
                    winid: 'sig001_open_attachment_winid',
                    function_usage: 'QUERY'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {

            });
        }

        //报价
        function sig001_open_price(dsId,record_id, quotationId) {
            if ($(dsId).validate()) {
                if (quotationId != 'undefined') {
                    //打开报价窗口
                    var price_list = $(dsId).findById(record_id).get("price_list");
                    var url = '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotationId+"&priceList="+price_list;
                    url = url + '&readOnly=Y';
                    var win = new Leaf.Window({
                        id: 'sig001_open_price_winid',
                        url: url,
                        title: '项目报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                    });
                } else {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
        }

        function sig001_open_insurance_information(ds_id,record_id){
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '保险信息维护';
            param['function_code'] = 'PRJ419F5';

            param['winid'] = 'PRJ419_open_insurance_information_winid';
            param['screen_width'] = '1100';
            param['screen_height'] = '450';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'PRJ419_open_insurance_information_link_id', ds_id, 'CONT330F1');
        }

        function con_open_price_modify(dsId, quotationId) {
            if ($(dsId).validate()) {
                if (quotationId != 'undefined') {
                    var win = new Leaf.Window({
                        id: 'con_open_price_modify_winid',
                        url: '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotationId + '&copyCashflowFlag=Y',
                        title: '合同报价',
                        fullScreen: true
                    });
                    win.on('close', function () {
                        var ccc_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
                        var pq_ds_id = get_dsid_by_basetable(window['CONT301F1_layoutDataSetList'], 'prj_quotation');
                        $(ccc_ds_id).query();
                        $(pq_ds_id).query();
                    });
                } else {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
        }

        function con_open_price_query(dsId, quotationId) {
            if ($(dsId).validate()) {
                if (quotationId != 'undefined') {
                    new Leaf.Window({
                        id: 'con_open_price_query_winid',
                        url: '${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ316F3/prj_project_fin_calculate.lview?quotationId=' + quotationId + '&readOnly=Y',
                        title: '合同报价',
                        fullScreen: true
                    });
                } else {
                    Leaf.showMessage("提示", "请先保存报价信息!", null);
                    return false;
                }
            }
        }

        function open_bp_modify_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '商业伙伴维护';
            if (param['bp_class'] == 'ORG') {
                if(param['bp_type']=='MANUFACTURER'){
                    param['function_code'] = 'BP100F4'

                }else {
                    param['function_code'] = 'BP100F1';
                }
            } else {
                param['function_code'] = 'BP100F2';
            }
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['winid'] = 'bp_master_modify_winid';

            hls_doc_get_layout_code(param, 'prj306_bp_master_modify_id', ds_id, 'PRJ306');
        }
        Leaf.onReady(function () {
            hideGird();
        });

        //根据业务线隐藏租赁物
        function hideGird() {
            //商用车租赁物信息grid_id
            let vehicle_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_VEHICLE_con_contract_lease_item_layout_grid_id_wrap'
            //工程机械租赁物信息grid_id
            let machine_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_MACHINE_con_contract_lease_item_layout_grid_id_wrap'
            //租赁物信息_光伏设备grid_id
            let photovoltaic_grid_id = '#' + '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_prj_project_lease_item_layout_grid_id_wrap'
            //附件
            let attachment_grid_id = '#' + '${/parameter/@layout_code}_G_ATTACHMENT_con_contract_attachment_layout_grid_id_wrap'
            //天合附件grid_id
            let th_attachment_grid_id = '#' + '${/parameter/@layout_code}_G_TH_ATTACHMENT_con_contract_attachment_layout_grid_id_wrap'
            //报价方案
            let quotation_ds_id = '${/parameter/@layout_code}_G_FINANCE_prj_quotation_layout_grid_id'
            //租赁物信息_光伏设备
            let lease_item_ds_id = '${/parameter/@layout_code}_G_LEASING_PHOTOVOLTAIC_con_contract_lease_item_layout_grid_id'

            //导航栏圆圈ID
            let machine_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_MACHINE_component_id']").attr("id")
            let vehicle_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_VEHICLE_component_id']").attr("id")
            //光伏设备导航栏ID
            let photovoltaic_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_LEASING_PHOTOVOLTAIC_component_id']").attr("id")
            //附件
            let attachment_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_ATTACHMENT_component_id']").attr("id")
            //天合附件
            let th_attachment_component_id = '#' + jQuery("div[name='${/parameter/@layout_code}_T_TH_ATTACHMENT_component_id']").attr("id")

            //隐藏左侧导航栏
            if (currentDivision === 'COMMERCIAL_VEHICLE') {
                jQuery(machine_grid_id).hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).prev().hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).next().hide();
                //隐藏租赁物_光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).prev().hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).next().hide();
                //隐藏天合附件
                jQuery(th_attachment_grid_id).hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).prev().hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).next().hide();
            }else if (currentDivision === 'ENGINEERING_MACHINERY'){ //工程机械
                //隐藏商用车
                jQuery(vehicle_grid_id).hide();
                jQuery(vehicle_component_id).hide();
                jQuery(vehicle_component_id).prev().hide();
                jQuery(vehicle_component_id).hide();
                jQuery(vehicle_component_id).next().hide();
                //隐藏租赁物_光伏
                jQuery(photovoltaic_grid_id).hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).prev().hide();
                jQuery(photovoltaic_component_id).hide();
                jQuery(photovoltaic_component_id).next().hide();
                //隐藏天合附件
                jQuery(th_attachment_grid_id).hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).prev().hide();
                jQuery(th_attachment_component_id).hide();
                jQuery(th_attachment_component_id).next().hide();
            } else {
                jQuery(vehicle_grid_id).hide();
                jQuery(vehicle_component_id).hide();
                jQuery(vehicle_component_id).prev().hide();
                jQuery(vehicle_component_id).hide();
                jQuery(vehicle_component_id).next().hide();
                //隐藏租赁物_工程机械
                jQuery(machine_grid_id).hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).prev().hide();
                jQuery(machine_component_id).hide();
                jQuery(machine_component_id).next().hide();
                //隐藏附件
                jQuery(attachment_grid_id).hide();
                jQuery(attachment_component_id).hide();
                jQuery(attachment_component_id).prev().hide();
                jQuery(attachment_component_id).hide();
                jQuery(attachment_component_id).next().hide();
            }
            //非天合光伏业务线, 报价方案隐藏 装机量、单价、每期租金
            if (currentDivision !== 'PHOTOVOLTAIC_DEVICES') {
                $(quotation_ds_id).hideColumn('installed_capacity');
                $(quotation_ds_id).hideColumn('unit_price');
                $(quotation_ds_id).hideColumn('each_rental');
            } else {
                //厂商非碳银
                debugger
                if (manufacturerCode !== 'C000032182') {
                    //租赁物隐藏组件生产商
                    $(lease_item_ds_id).hideColumn('module_producer');
                } else {
                    //碳银厂商报价方案隐藏每期租金
                    $(quotation_ds_id).hideColumn('each_rental');
                }
            }
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
        <a:screen-include screen="modules/CONT/CON_CONTRACT/CONT301/con_contract_detail_plus.lview?contract_id=${/parameter/@contract_id}&amp;layout_code=${/parameter/@layout_code}"/>
    </a:view>
</a:screen>

