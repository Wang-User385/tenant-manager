<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT330/con_contract_detail.lview"/>
        <a:link id="con_contract_terminate_link_id" url="${/request/@context_path}/con/contract/terminate"/>
        <script><![CDATA[
        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'):
                    // ds.setQueryParameter('contract_status', 'INCEPT');
                    qpara['created_by'] = '${/session/@user_id}';
                    break;
            }
        };

        window['${/parameter/@layout_code}_terminate_docx_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var select_datas = $(ds_id).getSelected();
            if(select_datas.length === 0){
                Leaf.showMessage('提示！', '至少选择一行!');
                return;
            }
            var ids = [];
            for(var i = 0; i < select_datas.length; i++){
                if(select_datas[i].get('contract_status') !== 'TERMINATE'){
                    Leaf.showMessage('提示！', '只有结束的合同才能打印产权转移书!');
                    return;
                }
                ids.push(select_datas[i].get('contract_id'));
            }
            window.location.href = '${/request/@context_path}/con/contract/ownership/transfer/download?contractIdsStr='+ids.join(',');
            Leaf.showMessage('提示！', '公章加盖中，请稍等!');
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'contract_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细';
            param['winid'] = 'con_contract_detail_win_id';
            param['function_code'] = 'CONT330F1';
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT330');
        }

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var select_datas = $(ds_id).getSelected();
            if(select_datas.length != 1){
                Leaf.showMessage('提示！', '请选择一行记录!');
                return;
            }
            var contract_id=select_datas[0].get('contract_id');

            Leaf.showConfirm("确认", "确认结束合同？", function(){
                Leaf.Masker.mask(Ext.getBody(), '正在执行合同结束操作，请稍后...');
                Leaf.request({
                    url: $('con_contract_terminate_link_id').getUrl(),
                    para: {
                        contract_id : contract_id
                    },
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '${l:HLS.SUBMIT_SUCCESS}',
                            duration: 2000
                        });
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    failure: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    error: function () {
                        Leaf.Masker.unmask(Ext.getBody());
                    },
                    scope: this
                });
            })

        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

