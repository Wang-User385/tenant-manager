<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="con_contract_detail_id"
                url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT301/con_contract_detail.lview"/>
        <script><![CDATA[
        //查询时调用(form,fieldboxcolumn)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.queryurl = ds.queryurl + '&wflRuleControlFlag=Y';
            switch (ds.id) {
                case get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract'):
                    qpara['created_by'] = '${/session/@user_id}';
                    break;
            }
        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_contract_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if ((name == 'contract_number_p' || name == 'legal_contract_number') && value ) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        // 加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var cs = ["INCEPT", "PENDING", "TERMINATE", "CANCEL", "ET", "PENDING"];
            var csn = ["合同起租", "合同暂挂", "合同结束", "合同关闭", "提前结清", "合同暂挂"];
            if (ds.id === ds_id&&record!="") {
                if(record.get('loan_initial_lease') == 'Y' || record.get('loan_initial_lease') == '放款即起租'){
                    record.getField('lease_start_date').setReadOnly(true);
                    record.getField('lease_start_date').setRequired(false);
                }
                if(cs.indexOf(record.get('contract_status')) != -1 || csn.indexOf('contract_status') != -1){
                    record.getField('lease_start_date').setReadOnly(true);
                    record.getField('lease_start_date').setRequired(false);
                }
            }
        }

        //确认起租
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            // debugger
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var record = $(ds_id).getSelected();
            if(record.length != 1){
                Leaf.showMessage('提示','请选择一行记录！');
            }else{
                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function () {
                    $L.Masker.mask(document.body, "确认中..");
                    Leaf.request({
                        url: "${/request/@context_path}/con/contract/incept/confirm",
                        para: {
                            contract_id: record[0].data.contract_id,
                            project_id: record[0].data.project_id,
                            lease_start_date: record[0].data.lease_start_date,
                            quotation_id: record[0].data.quotation_id,
                            is_low_risk: record[0].data.is_low_risk
                        },
                        success: function (res) {
                            console.log(res);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "操作成功!", function () {
                                Leaf.Masker.unmask(Ext.getBody());
                                $(ds_id).query();
                            });

                        },
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        failure: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                        },
                        scope: this
                    });
                });
            }
        }

        function open_contract_detail_win(record_id, ds_id) {
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '合同明细维护';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'con_contract_detail_winid';
            param['hidden_button_code'] = ['save', 'submit_approval', 'create', 'calc', 'quotation_calc'];
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
            param['function_code'] = 'CONT301F1';
            hls_doc_get_layout_code(param, 'con_contract_detail_id', ds_id, 'CONT309');
        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

