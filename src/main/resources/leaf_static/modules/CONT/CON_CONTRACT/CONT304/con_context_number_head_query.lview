<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: lrd
    $Revision: 1.0
    $Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true" dynamiccreateenabled="true">
    <a:init-procedure>
    </a:init-procedure>
    <a:view>
        <a:link id="cont304_create_content_link_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT304/con_content_number_detail_edit.lview"/>
    <script><![CDATA[

    //新建按钮
    window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {

        $L.showConfirm("提示","确认新建单据编号信息?",function(){
            var param = {};
            var document_list_ds_id = "${/parameter/@layout_code}_G_RESULT_con_content_number_head_ds";
            param['url_title'] = '编号申请创建';
            param['function_code'] = 'CONT304F1';
            param['create_flag'] = 'Y';
            param['winid'] = 'cont304_create_content_winid';
            hls_doc_get_layout_code(param, 'cont304_create_content_link_id', document_list_ds_id, 'CONT304F1');
        });

    }

    window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'] = {};
    //超链接渲染
    window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
        var link_function = 'cont304_open_detail';
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
        if (name == 'link_detail') {
            return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + name + '\');">明细</a>';
        }
    };

    window['cont304_open_detail'] = function(record_id, name){
        var record = window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record_id + '---' + name];
        var param = record.data;
        var document_list_ds_id = "${/parameter/@layout_code}_G_RESULT_con_content_number_head_ds";
        param['url_title'] = '编号申请维护';
        param['function_code'] = 'CONT304F1';
        param['winid'] = 'cont304_create_content_winid';
        if (param.status == 'APPROVING' || param.status == 'APPROVED' || param.status == 'CANCEL') {
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';
        }
        hls_doc_get_layout_code(param, 'cont304_create_content_link_id', document_list_ds_id, 'CONT304F1');
    }

    ]]></script>

        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>

    </a:view>
</a:screen>