        //             url: $('cont304f1_create_document_number_link_id').getUrl(),
        //             para: datas,
        //             success: function (res) {
        //                 window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        //                 $L.showInfoMessage("提示","生成成功!",function(){
        //                     $(ds_id).query();
        //                 });
        //             },
        //             error: function (res) {
        //                 $L.showInfoMessage("提示","生成编号失败,请联系管理员!");
        //                 window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        //             },
        //             failure: function (res) {
        //                 $L.showInfoMessage("提示","生成编号失败,请联系管理员!");
        //                 window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
        //             },
        //             scope: this
        //         });
        //     });
        //
