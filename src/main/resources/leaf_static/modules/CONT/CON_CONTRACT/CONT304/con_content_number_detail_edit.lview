        // };

        //提交审批
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            $L.showConfirm("提示","确认提交工作流审批吗?",function(){

                var businessRecord = $('${/parameter/@layout_code}_F_BASIN_INFO_con_content_number_head_ds').getCurrentRecord();
                var apply_business_type = businessRecord.get('apply_business_type');

                if(apply_business_type == 'ZL1030302' || apply_business_type =='ZL1030101' || apply_business_type =='ZL1030102'
                    || apply_business_type == 'ZL1030201'  || apply_business_type == 'ZL1030202' || apply_business_type == 'ZL1030301' || apply_business_type == '' ){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "该业务种类暂不支持提交审批！");
                    return ;
                }

                window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function(){

                    var record = $('${/parameter/@layout_code}_F_BASIN_INFO_con_content_number_head_ds').getCurrentRecord();

                    var head_id = record.get('head_id');

                    var apply_business_type = record.get('apply_business_type');

                    if(apply_business_type == 'ZL1030302' || apply_business_type =='ZL1030101' || apply_business_type =='ZL1030102'
                        || apply_business_type == 'ZL1030201'  || apply_business_type == 'ZL1030202' || apply_business_type == 'ZL1030301' || apply_business_type == '' ){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" , "该业务种类暂不支持提交审批！");
                        return ;
                    }

                    Leaf.request({
                        url: $('cont304f1_submit_document_wfl_link_id').getUrl(),
                        para: {
                            head_id:head_id
                        },
                        success: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示","提交审批成功!",function(){
                                $('${/parameter/@winid}').close();
                            });
                        },
                        error: function (res) {
                            $L.showInfoMessage("提示","提交审批失败,请联系管理员!");
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        failure: function (res) {
                            $L.showInfoMessage("提示","提交审批失败,请联系管理员!");
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });
                });
            });
        }



    ]]></script>

    </a:view>
</a:screen>