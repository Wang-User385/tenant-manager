<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="cont311_confirm_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CONT311/con_bussiness_comfirm_detail.lview"/>
        <a:link id="del_business_confirm_link_id" url="${/request/@context_path}/con/business/confirm/del"/>

        <script><![CDATA[

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_confirm_batch');
            if (ds_id == ds.id) {
                qpara['created_by'] = '${/session/@user_id}';
            }
        };

        function open_confirm_detail_win(record_id,ds_id) {
            var param = $(ds_id).findById(record_id).data;
            debugger
            param['url_title'] = '业务确认函明细维护';
            param['function_code'] = 'CONT312';
            param['winid'] = 'cont311_confirm_detail_winid';
            var link_id = 'cont311_confirm_detail_id';
            hls_doc_get_layout_code(param, link_id, ds_id, 'CONT310F1');
        }

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'open_confirm_detail_win';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'detail') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + "明细" + '</a>';
            }
        };

        // // 打印业务确认函按钮
        // window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function() {
        //     var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_confirm_batch');
        //     var select_datas = $(ds_id).getSelected();
        //     if (select_datas.length>0) {
        //         var ids = [];
        //         for (var i = 0; i < select_datas.length; i++) {
        //             ids.push(select_datas[i].get('batch_id'));
        //         }
        //         window.location.href = '${/request/@context_path}/con/business/confirm/downloadDocx?batchIdsString=' + ids.join(',');
        //     }
        // };
        // 打印业务确认函按钮
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_confirm_batch');
            var records = $(ds_id).getSelected();
            if(records.length == 0){
                Leaf.showMessage('提示！', '请至少选择一条数据！');
                return;
            }
            var printData = [];
            for (var i = 0; i < records.length; i++) {
                printData.push(records[i].data);
            }
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            Leaf.request({
                url: "${/request/@context_path}/con/business/confirm/text",
                para: printData,
                success: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    var down_url ='';
                    var attachment_ids = "";
                    for(var i = 0; i < res.result.record.length; i++){
                        if(i == 0){
                                attachment_ids = res.result.record[0].attachment_id;
                        }else{
                            attachment_ids = attachment_ids + ',' + res.result.record[i].attachment_id;
                        }
                    }
                    debugger
                    down_url = "${/request/@context_path}/fnd/attachment/download/zip?attachment_id=" + attachment_ids;
                    location.href = down_url;
                    Leaf.showMessage("提示", "生成成功!", null);

                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                failure: function (res) {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showMessage("提示", "生成失败!", null);
                },
                scope: this
            });
        }

        //删除业务确认函
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function() {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_confirm_batch');
            var select_datas = $(ds_id).getSelected();
            if (select_datas.length>0) {
                var ids = [];
                for (var i = 0; i < select_datas.length; i++) {
                    if(select_datas[i].get('refresh_status') !== 'UNREFRESH' ){
                        Leaf.showMessage('提示！', '仅未取回的状态可以删除');
                        return;
                    }else {
                        ids.push(select_datas[i].get('batch_id'));
                    }
                }
                Leaf.request({
                    url: $('del_business_confirm_link_id').getUrl()+'?batchIds='+ids.join(','),
                    success: function (res) {
                        Leaf.SideBar.show({
                            msg: '删除成功',
                            duration: 2000
                        });
                        $(ds_id).query();
                        Leaf.Masker.unmask(document);
                    },
                    failure: function () {
                        Leaf.Masker.unmask(document);
                    },
                    error: function () {
                        Leaf.Masker.unmask(document);
                    },
                    scope: this
                });
            }else {
                Leaf.showMessage('提示', '请选择需要删除的数据');
                return ;
            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var con_confirm_batch_ds = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_confirm_batch');
            if(ds.id==con_confirm_batch_ds){
                if(name=="refresh_status"  && value=="REFRESH"){
                    record.set("refresh_date",new Date());
                }
            }
        };
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

