<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        var attachment_id;
        window['upload_file'] = function(record_id,attachment_id,table){
            var tableName = 'SYS_ATTACHMENT';
            if(table){
                tableName = table;
            }
            if(attachment_id == null){
                $L.showInfoMessage("提示","请先保存附件信息!");
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'bill_sys_attachment_winid',
                url: url,
                params: {
                    'header_id': attachment_id,
                    'table_name': tableName,
                    winid: 'bill_sys_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'sys_attachment');
                $(ds_id).query();
            });
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            if(record.get('attachment_id')){
                attachment_id = record.get('attachment_id');
            }
            if (name == 'upload' && attachment_id){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + attachment_id + '\');">附件</a>';
            }
        };


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'sys_attachment');
            if(ds.id && ds.id == ds_id){
                record.set('source_key','${/parameter/@bill_management_id}');
                record.set('name','BILL_MANAGEMENT_ATTACHMENT');
                record.set('status','1');
                var root_ds_str = '${/parameter/@layout_code}_virtual_ds';
                root_ds = $(root_ds_str);
                if (root_ds.validate()) {
                    root_ds.submit();
                } else {
                    return false;
                }

            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            ds.setQueryParameter('bill_management_id','${/parameter/@bill_management_id}');
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

