<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>
    <a:view>
        <a:link id="bill_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CON710/bill_management_detail.lview"/>
        <a:link id="bill_upload_detail_id" url="${/request/@context_path}/modules/CONT/CON_CONTRACT/CON710/bill_management_att.lview"/>
        <script><![CDATA[

        function bill_detail_open(record_id,ds_id) {
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '明细';
            param['function_code'] = 'CON710F1';
            hls_doc_get_layout_code(param, 'bill_detail_id', null, 'CON710', null, null, null);
        }

        function upload_detail_open(record_id,ds_id){
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            param['url_title'] = '明细';
            param['function_code'] = 'CON710F2';
            hls_doc_get_layout_code(param, 'bill_upload_detail_id', null, 'CON710', null, null, null);
        }


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'bill_detail_open';
            if (name === 'details') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">明细</a>';
            }
            link_function = 'upload_detail_open';
            if (name == 'upload'){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">附件</a>';
            }
        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

