<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="hls900h1_quotation_history_id"
                url="${/request/@context_path}/modules/FND/HLS_COMMON/HLS900H1/quotation_calc_common_history.lview"/>

        <script><![CDATA[

            //查询时调用(grid,table,gridBox)
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
                if(ds.id == '${/parameter/@layout_code}_G_GRID_con_contract_ds'){
                    qpara['contract_id'] = '${/parameter/@contract_id}';
                }
            };

            //超链接渲染
            window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
                var link_function;
                if (name == 'quotation_detail') {
                    link_function = 'quotation_history_detail';
                    return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + '报价详情' + '</a>';
                }
            };

            //报价历史
            function quotation_history_detail(record_id, ds_id){
                var record = $(ds_id).findById(record_id);
                var quotationId = record.get('quotation_id');
                var function_code = 'HLS900H1';
                var param = {};
                param['quotationId'] = quotationId;
                param['quotation_id'] = quotationId;
                //param['priceList'] = 'General_Calculator_FreePrin';
                param['url_title'] = '历史报价详情';
                param['winid'] = 'quotation_history_detail_winid';
                param['function_code'] = function_code;
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                // console.log(param);
                hls_doc_get_layout_code(param, 'hls900h1_quotation_history_id', ds_id, function_code);
            }

       ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
