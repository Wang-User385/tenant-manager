<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>

        <a:link id="hls_mortgage_detail_link_id"
                url="${/request/@context_path}/modules/CONT/MORT/MORT001/hls_mortgage_detail.lview"/>

        <script><![CDATA[
        //提交审批按钮
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var record = $(ds_id).getCurrentRecord();
            var contract_id = record.get('contract_id');



            new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/hls/con/contract/submit',
                    para: {
                        contract_id: contract_id
                    },
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100 );
        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'contract_number') {
                return '<a href="javascript:open_review_detail_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'mortgage_review_detail') {
                return '<a href="javascript:open_submit_review_win(\'' + record.id + '\',\'' + record.ds.id + '\');">审批明细</a>';

            }
        };

        function open_review_detail_win(record_id, ds_id) {
            debugger;
            var ds = $(ds_id);
            var record = $(ds_id).findById(record_id);
            var param = record.data;
            // param['project_id'] = record.get('project_id');
            param['contract_id'] = record.get('contract_id');
            param['function_usage'] = 'MODIFY';
            if (record.get('mortgage_status') && (record.get('mortgage_status') == 'APPROVING' || record.get('mortgage_status') == 'APPROVED')) {
                param['function_usage'] = 'QUERY';
            }
            param['url_title'] = '抵质押明细';
            param['function_code'] = 'MORT001F3';
            param['winid'] = 'review_detail_winid';
            hls_doc_get_layout_code(param, 'hls_mortgage_detail_link_id', ds_id, 'MORT001');
        }


        function open_submit_review_win(record_id, ds_id) {
            debugger;
            var ds = $(ds_id);
            var record = $(ds_id).findById(record_id);
            var process_instance_id = record.get('process_instance_id');
            new Leaf.Window({
                id: 'MORT001_approve_history_winid',
                params: {
                    winid: 'MORT001_approve_history_winid',
                    id: process_instance_id
                },
                url: '${/request/@context_path}/modules/MYWFL/MYWFL002/process_approve_history.lview',
                title: '审批明细',
                fullScreen: true
            });
        }

        ]]>
        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
