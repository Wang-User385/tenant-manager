<?xml version="1.0" encoding="UTF-8"?>
<!--
    Author: LI JING ZHOU
    Date: 2024/7/22
    Revision: 1.0
    Purpose: 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>
        <script><![CDATA[


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // if (name == 'project_plan' && !record.isNew) {   //跟进情况  附件
            //     var link_function1 = 'prj_plan_upload';
            //     return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('hls_prj_plan_id') + '\');">上传</a>';
            // }
            if (name == 'info') {   //跟进情况  附件
                var link_function1 = 'upload';
                return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('contract_id') + '\');">附件</a>';
            }
            return value;
        }

        window['upload'] = function (ds_id, record_id, pk_id) {
            debugger;
            var tableName = 'CON_CONTRACT_ATTACHMENT';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            var base_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');
            var base_record;
            var con_contract_attachment_id;
            if (ds_id == base_ds_id){
                base_record = $(base_ds_id).findById(record_id);
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid1',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'MORT001F3_open_attachment_prj_winid1'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }else if (ds_id == base_ds_id1){
                base_record = $(base_ds_id1).findById(record_id);
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid2',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'MORT001F3_open_attachment_prj_winid2'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }else {
                base_record = $(base_ds_id2).findById(record_id);
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid3',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'MORT001F3_open_attachment_prj_winid3'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }



        };


        //准备时
        $L.onReady(function () {

        });

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            var base_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');
            $(base_ds_id).setQueryParameter('contract_id','${/parameter/@contract_id}');
            $(base_ds_id1).setQueryParameter('contract_id','${/parameter/@contract_id}');
            $(base_ds_id2).setQueryParameter('contract_id','${/parameter/@contract_id}');
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            var base_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');

            if (ds.id == base_ds_id){
                $(base_ds_id).getCurrentRecord().set('contract_attachment_category','EXAMINE');
            }else if( ds.id == base_ds_id1){
                $(base_ds_id1).getCurrentRecord().set('contract_attachment_category','CONTRACT');
            }else if (ds.id==base_ds_id2){
                $(base_ds_id2).getCurrentRecord().set('contract_attachment_category','MORTGAGE');
            }
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function (ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            var base_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');
            $(base_ds_id).query();
            $(base_ds_id1).query();
            $(base_ds_id2).query();
        };


        //提交审批按钮
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var record = $(ds_id).getCurrentRecord();
            var contract_id = record.get('contract_id');



            new Leaf.showConfirm('${l:HLS.PROMPT}', '${l:HLS.ARE_YOU_SURE_TO_SUBMIT}', function okFun() {
                window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
                Leaf.request({
                    url: '${/request/@context_path}/con/contract/submit',
                    para: {
                        contract_id: contract_id
                    },
                    success: function (res) {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $(ds_id).query();
                    },
                    failure: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function () {
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    scope: this
                });
            }, function cancel() {
                window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }, 200, 100 );
        };


        //自定义按钮进行绑定
        // window['${/parameter/@layout_code}_G_RENT_PAYMENT_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
        //
        window['${/parameter/@layout_code}_G_PRJ_INFO_ATTA_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            debugger;
            var contract_id = parseInt('${/parameter/@contract_id}');
            var down_url = "${/request/@context_path}/hls/con/contract/download?contract_id=" + contract_id + "&contract_attachment_category=EXAMINE" ;
            location.href = down_url;
        }
        //一键下载
        window['${/parameter/@layout_code}_G_PRJ_CON_INFO_ATTA_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            debugger;
            var contract_id = parseInt('${/parameter/@contract_id}');
            var down_url = "${/request/@context_path}/hls/con/contract/download?contract_id=" + contract_id + "&contract_attachment_category=CONTRACT" ;
            location.href = down_url;
        }
        //一键下载
        window['${/parameter/@layout_code}_G_PRJ_MORTGAGE_INFO_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            debugger;
            var contract_id = parseInt('${/parameter/@contract_id}');
            var down_url ="${/request/@context_path}/hls/con/contract/download?contract_id=" + contract_id + "&contract_attachment_category=MORTGAGE" ;
            location.href = down_url;
        }


        ]]>
        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
