<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>
        <script><![CDATA[


        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            // if (name == 'project_plan' && !record.isNew) {   //跟进情况  附件
            //     var link_function1 = 'prj_plan_upload';
            //     return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('hls_prj_plan_id') + '\');">上传</a>';
            // }
            if (name == 'info') {   //跟进情况  附件
                var link_function1 = 'upload';
                return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('contract_id') + '\');">附件</a>';
            }
            return value;
        }

        window['upload'] = function (ds_id, record_id, pk_id) {
            var tableName = 'CON_CONTRACT_ATTACHMENT';
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            var base_ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');
            var base_record;
            var con_contract_attachment_id;
            if (ds_id == base_ds_id){
                base_record = $(base_ds_id).getCurrentRecord();
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'HPP100F1_open_attachment_winid1'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }else if (ds_id == base_ds_id1){
                base_record = $(base_ds_id1).getCurrentRecord();
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'HPP100F1_open_attachment_winid1'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }else {
                base_record = $(base_ds_id2).getCurrentRecord();
                con_contract_attachment_id = base_record.get('contract_attachment_id');
                if (!con_contract_attachment_id){
                    $L.showInfoMessage("提示", "请先保存再上传附件!");
                    return;
                }
                var url = '${/request/@context_path}/uploadFile.lview';
                var win = new Leaf.Window({
                    id: 'MORT001F3_open_attachment_prj_winid',
                    url: url,
                    params: {
                        'header_id': con_contract_attachment_id,
                        'table_name': tableName,
                        winid: 'HPP100F1_open_attachment_winid1'
                    },
                    title: '文件上传下载',
                    width: 800,
                    height: 475
                });
                win.on('close', function () {
                    $(ds_id).query();
                });
            }



        };



        $L.onReady(function () {
            debugger;
            // // 隐藏审批历史导出按钮
            // jQuery('#${/parameter/@layout_code}_G_PRJ_INFO_ATTA_GRID_HLS_EXPORT_layout_dynamic_button_id').hide();
            //
            // var dsId = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_INFO_ATTA');
            // var dsId1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_CON_INFO_ATTA');
            // var dsId2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_attachment', 'G_PRJ_MORTGAGE_INFO');


        });


        //自定义按钮进行绑定
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var projectId = parseInt('${/parameter/@project_id}');
            var down_url = "${/request/@context_path}/ct/prj/project/sign/contentFileList?projectId=" + projectId;
            location.href = down_url;
        };

        ]]>
        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
