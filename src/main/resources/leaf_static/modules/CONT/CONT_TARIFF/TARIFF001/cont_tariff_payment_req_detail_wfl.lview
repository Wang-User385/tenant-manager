<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="cont_tariff_payment_req_detail_wfl_link"
                url="${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_payment_req_detail.lview"/>
        <script><![CDATA[

        var businessKey = '${/parameter/@businessKey}';
        var pageChooser = new PageChooser({
            url: $('cont_tariff_payment_req_detail_wfl_link').getUrl() + '?function_code=TARIFF001F6',
            function_code: 'TARIFF001F6',
            context_path: '${/request/@context_path}',
            opt: {
                businessKey : '${/parameter/@businessKey}',
                payment_req_id: '${/parameter/@businessKey}',
                maintain_type: 'READONLY',
                function_usage: 'QUERY'
            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
    </a:view>
</a:screen>

