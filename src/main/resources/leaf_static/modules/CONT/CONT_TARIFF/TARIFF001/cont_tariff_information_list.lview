<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="tariff_detail_winid"
                url="${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_information_list_tariff_info.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'detail') {
                return '<a href="javascript:open_tariff_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + "明细" + '</a>';
            }
            return value;
        };
        function open_tariff_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '详细信息';
            param['function_code'] = 'TARIFF001F2';
            param['winid'] = 'hls_tariff_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            param['contract_id'] = record.get("contract_id");
            param['contract_number'] = record.get("contract_number");
            param['screen_width'] = '1000';
            param['screen_height'] = '450';

            var link_id = 'tariff_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'TARIFF001');

        }

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
