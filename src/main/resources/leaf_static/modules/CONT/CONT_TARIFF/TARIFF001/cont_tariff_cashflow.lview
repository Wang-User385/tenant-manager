<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: congweijing
    $Date:2021年5月14日
    $Revision: 1.0
    $Purpose: 关税现金流
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <script><![CDATA[
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_cashflow');
            var win = new Leaf.Window({
                id: 'hls_cont_tariff_cashflow_import_win_id',
                params: {
                    winid: 'cont_tariff_cashflow_import_win_id'
                },
                url: '${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_cashflow_import.lview',
                title: '关税现金流导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(base_ds_id).query();
            });
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

        }
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
