<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: congweijing
    $Date:2021年5月13日
    $Revision: 1.0
    $Purpose: 关税管理资料清单头表
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true" dynamiccreateenabled="true"
          customizationEnabled="true">
    <a:init-procedure/>

    <a:view>
        <a:link id="tariff_ln_detail_winid"
                url="${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_information_list_tariff_info_ln.lview"/>
        <script><![CDATA[
        window['${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record) {
            if (name == 'tariff_detail' && record.get("tariff_id")) {
                return '<a href="javascript:open_tariff_ln_detail_win(\'' + record.ds.id + '\',\'' + record.id + '\')">' + "明细" + '</a>';
            }
            return value;
        };
        function open_tariff_ln_detail_win(ds_id, record_id) {
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['url_title'] = '详细信息';
            param['function_code'] = 'TARIFF001F3';
            param['winid'] = 'hls_tariff_ln_detail_winid';
            param['ds_id'] = ds_id;
            param['function_usage'] = 'CREATE';
            param['tariff_id'] = record.get("tariff_id");
            param['screen_width'] = '1000';
            param['screen_height'] = '450';

            var link_id = 'tariff_ln_detail_winid';
            hls_doc_get_layout_code(param, link_id, ds_id, 'TARIFF001');

        }

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_tariff_info');
            if (ds.id === basic_ds_id) {
                //报关类型为一次性报关，期数和费用项只读
                if (name == 'customs_declaration_method') {
                    if (value == 'ONCE') {
                        record.getField('times').setRequired(false);
                        record.getField('times').setReadOnly(true);
                        record.set('times', null);
                        record.getField('expense_item').setRequired(false);
                        record.getField('expense_item').setReadOnly(true);
                        record.set('expense_item', null);
                    } else {
                        record.getField('times').setReadOnly(false);
                        record.getField('times').setRequired(true);
                        record.set('times', null);
                        record.getField('expense_item').setReadOnly(false);
                        record.getField('expense_item').setRequired(true);
                        record.set('expense_item', null);
                    }
                }
            }
        };

        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function(ds, record, config_records, bp_seq) {
            var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract_tariff_info');
            if (ds.id === basic_ds_id && ('${/parameter/@function_usage}' !== 'QUERY')) {
                //报关类型为一次性报关，期数和费用项只读
                if (record.get("customs_declaration_method") == 'ONCE') {
                    record.getField('times').setRequired(false);
                    record.getField('times').setReadOnly(true);
                    record.getField('expense_item').setRequired(false);
                    record.getField('expense_item').setReadOnly(true);
                } else {
                    record.getField('times').setReadOnly(false);
                    record.getField('times').setRequired(true);
                    record.getField('expense_item').setReadOnly(false);
                    record.getField('expense_item').setRequired(true);
                }
            }

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
