<?xml version="1.0" encoding="UTF-8"?>
<!--
    $Author: congweijing
    $Date:2021年5月13日
    $Revision: 1.0
    $Purpose: 关税管理首页
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application">
    <a:view>
        <script><![CDATA[
        function onIncludeFrameLoad(frameId) {
            var ifm = document.getElementById(frameId);
            var subWeb = document.frames ? document.frames[frameId].document : ifm.contentDocument;
            if (ifm != null && subWeb != null) {
                ifm.height = "100%";
            }
        }
        ]]></script>
        <a:screenBody>
            <a:tabPanel marginWidth="20" marginHeight="1">
                <a:tabs>
                    <a:tab prompt="关税资料清单" width="150" selected="true">
                        <iframe onLoad="onIncludeFrameLoad('includeFrame1')" scrolling="yes" id="includeFrame1" style="border:0;"/>
                        <script><![CDATA[
                        var screenWidth = $L.getViewportWidth();
                        var ifm = document.getElementById("includeFrame1");
                        ifm.width = screenWidth;
                        ifm.src = "${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_information_list.lview?function_code=TARIFF001F1";
                        ]]></script>
                    </a:tab>
                    <a:tab prompt="关税现金流" width="150">
                        <iframe onLoad="onIncludeFrameLoad('includeFrame2')" scrolling="yes" id="includeFrame2" style="border:0;"/>
                        <script><![CDATA[
                        var screenWidth = $L.getViewportWidth();
                        var ifm = document.getElementById("includeFrame2");
                        ifm.width = screenWidth;
                        ifm.src = "${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_cashflow.lview?function_code=TARIFF001F4";
                        ]]></script>
                    </a:tab>
                    <a:tab prompt="代付关税" width="150">
                        <iframe onLoad="onIncludeFrameLoad('includeFrame3')" scrolling="yes" id="includeFrame3" style="border:0;"/>
                        <script><![CDATA[
                        var screenWidth = $L.getViewportWidth();
                        var ifm = document.getElementById("includeFrame3");
                        ifm.width = screenWidth;
                        ifm.src = "${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_cashflow_topay.lview?function_code=TARIFF001F5";
                        ]]></script>
                    </a:tab>
                    <a:tab prompt="付款申请单" width="150">
                        <iframe onLoad="onIncludeFrameLoad('includeFrame4')" scrolling="yes" id="includeFrame4" style="border:0;"/>
                        <script><![CDATA[
                        var screenWidth = $L.getViewportWidth();
                        var ifm = document.getElementById("includeFrame4");
                        ifm.width = screenWidth;
                        ifm.src = "${/request/@context_path}/modules/CONT/CONT_TARIFF/TARIFF001/cont_tariff_payment_req_query.lview?function_code=TARIFF001F7";
                        ]]></script>
                    </a:tab>
                </a:tabs>
            </a:tabPanel>
        </a:screenBody>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
