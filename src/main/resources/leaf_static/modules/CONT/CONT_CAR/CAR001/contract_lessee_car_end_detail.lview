<?xml version="1.0" encoding="UTF-8"?>
<!--
    Author: LI JING ZHOU
    Date: 2024/7/29
    Revision: 1.0
    Purpose:
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>


        <script><![CDATA[

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function(ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var check_flag = true;
            $(ds.id).getCurrentRecord().set('project_id','${/parameter/@project_id}')
            $(ds.id).getCurrentRecord().set('contract_id','${/parameter/@contract_id}')
            return check_flag;
        };

        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CAR_F1');
            if (ds.id==base_ds_id2){
                $(base_ds_id2).getCurrentRecord().set('project_attachment_category','PLEDGE');
                $(base_ds_id2).getCurrentRecord().set('project_id','${/parameter/@project_id}');
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            debugger;
            var base_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CAR_F1');
            if (ds.id == base_ds_id){
                $(base_ds_id).setQueryParameter('contract_id','${/parameter/@contract_id}');
                $(base_ds_id).setQueryParameter('project_id','${/parameter/@project_id}');
            }
        };



        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function1 = 'upload';

            if (record.get('file_num') > 0 && name == 'info' ) {
                return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('contract_id') + '\');">附件' + '(' +record.get("file_num") + ')' + '</a>';
            } else if (record.get('file_num') == 0 || name == 'info'){
                return '<a href="javascript:window[\'' + link_function1 + '\'](\'' + record.ds.id + '\',\'' + record.id + '\',\'' + record.get('contract_id') + '\');">附件</a>';
            }
        };

        window['upload'] = function (ds_id, record_id, pk_id) {
            debugger;
            var tableName = 'PRJ_PROJECT_ATTACHMENT';
            var base_ds_id2 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment', 'G_CAR_F1');
            var base_record;
            var project_attachment_id;
            base_record = $(base_ds_id2).findById(record_id);
            project_attachment_id = base_record.get('project_attachment_id');
            if (!project_attachment_id) {
                $L.showInfoMessage("提示", "请先保存再上传附件!");
                return;
            }
            var url = '${/request/@context_path}/uploadFile.lview';
            var win = new Leaf.Window({
                id: 'CAR001F1_open_attachment_prj_winid3',
                url: url,
                params: {
                    'header_id': project_attachment_id,
                    'table_name': tableName,
                    winid: 'CAR001F1_open_attachment_prj_winid3'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(ds_id).query();
            });


        };

        //一键下载
        window['${/parameter/@layout_code}_G_CAR_F1_USER_BUTTON1_layout_dynamic_tab_click'] = function () {
            debugger;
            var project_id = parseInt('${/parameter/@project_id}');
            var down_url = "${/request/@context_path}/hls/con/contract/download?project_id=" + project_id + "&project_attachment_category=PLEDGE" ;
            location.href = down_url;
        }




        //确认解押
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var ds_id1 = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'prj_project_attachment');
           if (!$(ds_id).validate()){
               window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
               return;
           }
            var record = $(ds_id).getCurrentRecord();
            var contract_id = record.get('contract_id');
            if (!contract_id) contract_id = '${/parameter/@contract_id}';
            if (contract_id){
                Leaf.request({
                    url: '${/request/@context_path}/confirm?contractId='+contract_id,
                    success: function (res) {
                        $(ds_id).submit();
                        $(ds_id1).submit();
                        $(ds_id).query();
                        $(ds_id1).query();
                        Leaf.showSuccessMessage("提示","解押成功");
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    error: function (){
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (){
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true
                });
            }
            $('con_pledge_winid').close();




        };


        ]]>
        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
