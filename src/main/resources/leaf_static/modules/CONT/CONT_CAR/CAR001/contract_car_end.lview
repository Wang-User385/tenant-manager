<?xml version="1.0" encoding="UTF-8"?>
<!--
    Author: LI JING ZHOU
    Date: 2024/7/29
    Revision: 1.0
    Purpose: 
-->
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>

        <a:link id="prj_project_detail"
                url="${/request/@context_path}/modules/PRJ/PRJ_PROJECT/PRJ419/prj_project_modify_entrance.lview"/>
        <a:link id="lessee_detail"
                url="${/request/@context_path}/modules/CONT/CONT_CAR/CAR001/contract_lessee_car_end_detail.lview"/>

        <script><![CDATA[

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if (name == 'contract_number' && value) {
                return '<a href="javascript:open_car_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
            if (name == 'pledge_flag_n' && value) {
                return '<a href="javascript:open_pledge_win(\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }
        };

        function open_car_win(record_id,ds_id) {
            //获取ds
            debugger;
            var param = $(ds_id).findById(record_id).data;
            param['url_title'] = '进件明细';
            param['function_code'] = 'PRJ419F2';
            param['winid'] = 'con_car_winid';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'prj_project_detail', ds_id, 'CAR001');
        }

        function  open_pledge_win(record_id,ds_id) {
            //获取ds
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = {};
            param['contract_id'] = parseInt(record.get('contract_id'));
            param['url_title'] = '租赁物解押明细';
            param['function_code'] = 'CAR001F1';
            param['winid'] = 'con_pledge_winid';
            param['function_usage'] = 'MODIFY';
            hls_doc_get_layout_code(param, 'lessee_detail', ds_id, 'CAR001');
        }



        //确认撤销登记
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            for (let i = 0; i < records.length; i++) {
                var record = records[i];
                var contract_id = record.get('contract_id');
                if (record.get('zdw_register_status_n') && record.get('zdw_register_status_n') == '已撤销'){
                    Leaf.showErrorMessage('重复撤销', record.get('contract_number') +'已确认过撤销，请勿重复撤销！');
                    return;
                }
                Leaf.request({
                    url: '${/request/@context_path}/hls/cus/update/status?contractId='+contract_id,
                    success: function (res) {
                        $(ds_id).query();
                    },
                    sync: true
                });
            }


        };

        //确认合同结束
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'con_contract');
            var records = $(ds_id).getSelected();
            if (records.length != 1){
                Leaf.showErrorMessage('提示','请勾选一条数据');
            }
            var record = records[0];

            if (!record.get('zdw_register_status_n')||record.get('zdw_register_status_n') != '已撤销'){
                Leaf.showErrorMessage('中登网登记状态未撤销','中登网登记状态未撤销，不能结束合同！');
                return;
            }

            if (!record.get('pledge_flag_n') || record.get('pledge_flag_n') == '未办理'){
                Leaf.showErrorMessage('租赁物未解押','租赁物未确认解押，不能结束合同！');
                return;
            }

            if (!record.get('contract_status_n') || record.get('contract_status_n') == '合同结束'){
                Leaf.showErrorMessage('合同已结束', record.get('contract_number') + '合同已结束，请勿重复操作！');
                return;
            }

            if (!record.get('write_off_status') || record.get('write_off_status') == '合同结束'){
                Leaf.showErrorMessage('现金流未核销', '未完全核销，不能结束合同！');
                return;
            }
            var contract_id = record.get('contract_id');
            Leaf.request({
                url: '${/request/@context_path}/hls/update/contract/status?contractId='+contract_id,
                success: function (res) {
                    $(ds_id).query();
                },
                sync: true
            });




        };


        ]]>
        </script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
