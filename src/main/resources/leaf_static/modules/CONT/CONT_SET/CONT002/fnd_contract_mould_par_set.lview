<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function column_ds_grid_tf_editFun(record, name) {
            if (record.isNew) {
                if (name == 'column_name') {
                    return 'column_ds_grid_tf';
                }
            }
            return '';
        }

        function column_screen_query() {
            $('column_result_ds').query();
        }

        function column_screen_reset() {
            $('column_query_ds').reset();
            $('column_result_ds').query();
        }

        function column_screen_del(){
            var ds = $('column_result_ds');
            ds.remove("${/request/@context_path}/con/hlsdocfileparatable/delCon");

        }

        function column_screen_add() {
            $('column_ds_grid').showEditorByRecord($('column_result_ds').create());
        }

        function column_screen_save() {
            var ds = $('column_result_ds');
            if (ds.validate()) {
                ds.setSubmitUrl("${/request/@context_path}/con/hlsdocfileparatable/addCon");
                ds.submit();
            }
        }

        <!--提交成功-->
        function onSubmitSuccess_column_ds(){
            $('column_result_ds').query();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="alignment_ds" loadData="true" lookupCode="HLS.DOC_FILE_ALIGNMENT_TYPE"/>
            <a:dataSet id="column_query_ds" autoQuery="true" loadData="true">
                <a:fields>
                    <a:field name="templet_para_id"  prompt="参数id" defaultValue="${/parameter/@templet_para_id}"/>
                    <a:field name="column_name" prompt="字段名"/>
                    <a:field name="column_desc" prompt="描述"/>
                    <a:field name="alignment_cn" options="alignment_ds"
                             displayField="code_value_name" returnField="alignment" valueField="code_value">
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="column_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl ="${/request/@context_path}/con/hlsdocfileparatable/selectAll"
                       deleteUrl= "${/request/@context_path}/con/hlsdocfileparatable/delCon"
                       queryDataSet="column_query_ds" selectable="true">
                <a:fields>
                    <a:field name="templet_para_id"  prompt="参数id" defaultValue="${/parameter/@templet_para_id}"/>
                    <a:field name="column_name" prompt="字段名"/>
                    <a:field name="column_desc" prompt="描述"/>
                    <a:field name="column_num" prompt="列数"/>
                    <a:field name="column_width" prompt="列宽"/>
                    <a:field name="alignment" prompt="对齐方式"/>
                    <a:field name="alignment_cn" options="alignment_ds"
                             displayField="code_value_name" returnField="alignment" valueField="code_value">
                    </a:field>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N" prompt="启用"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="column_screen_add" text="HAP.NEW" type="add"/>
                <a:gridButton click="column_screen_save" text="HAP.SAVE" type="save"/>
                <a:gridButton bind="column_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="column_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="column_screen_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
            <a:form column="3" title="查询条件" labelwidth="100">
                <a:textField name="column_name" bindTarget="column_query_ds" prompt="字段名" emptyText="字段名" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="column_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="column_desc" bindTarget="column_query_ds" prompt="描述" emptyText="描述" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="column_screen_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="column_ds_grid"  bindTarget="column_result_ds"
                    width="800" height="350" navBar="true" >
                <a:columns>
                    <a:column width="150" name="column_name" editorFunction="column_ds_grid_tf_editFun" prompt="字段名" align="center"  />
                    <a:column width="150" name="column_desc" editor="column_ds_grid_tf" prompt="描述" align="center"  />
                    <a:column width="100" name="column_num" editor="column_ds_grid_tf" prompt="列数" align="center"  />
                    <a:column width="100" name="column_width" editor="column_ds_grid_tf" prompt="列宽" align="center"  />
                    <a:column width="150" name="alignment_cn" editor="column_ds_grid_combo" prompt="对齐方式" align="center"  />
                    <a:column width="100" name="enabled_flag" editor="column_ds_grid_check" prompt="启用" align="center"/>

                </a:columns>
                <a:editors>
                    <a:lov id="column_ds_grid_lov"/>
<!--                    <a:spinner id="column_ds_grid_sp" max="99" min="0" step="1"/>-->
                    <a:textField id="column_ds_grid_tf"/>
                    <a:numberField id="column_ds_grid_nf"/>
                    <a:checkBox id="column_ds_grid_check"/>
                    <a:comboBox id="column_ds_grid_combo"/>
                </a:editors>
            </a:grid>
            <div id="emptyForExportDiv" style="display: none;"></div>
            <iframe frameborder="0" id="emptyForExportIframe" style="display: none;"></iframe>
        </a:screenBody>
    </a:view>
</a:screen>
