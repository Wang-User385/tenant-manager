<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure/>
    <a:view>
        <script><![CDATA[

        function templet_para_ds_grid_tf_editFun(record, name) {
            if (record.isNew) {
                if (name == 'bookmark') {
                    return 'templet_para_ds_grid_tf';
                }

            }
            return '';
        }

        function templet_para_screen_query() {
            $('templet_para_result_ds').query();
        }

        function templet_para_screen_reset() {
            $('templet_para_query_ds').reset();
            $('templet_para_result_ds').query();
        }

         function templet_para_screen_del(){
             var ds = $('templet_para_result_ds');
             ds.remove("${/request/@context_path}/con/hlsdocfiletemp/delCon");

         }

        function templet_para_screen_add() {
            $('templet_para_ds_grid').showEditorByRecord($('templet_para_result_ds').create());
        }

        function templet_para_screen_save() {
            var ds = $('templet_para_result_ds');
            if (ds.validate()) {
                ds.setSubmitUrl("${/request/@context_path}/con/hlsdocfiletemp/addCon");
                ds.submit();
            }
        }

        <!--提交成功-->
        function onSubmitSuccess_templet_para_ds(){
            $('templet_para_result_ds').query();
        }

        <!--列配置----未完成-->
        function render_templet_para_ds_grid(value, record, name) {
            if (!record.isNew) {
                if (name == 'module_template' ) {
                    if (record.get('bookmark_type') == "TABLE" || record.get('bookmark_type')=="TABLE_ROW_REPEAT" || record.get('bookmark_type') == "DYNAMIC_TABLE" || record.get('bookmark_type') == "FORM_TABLE" ) {
                        return '<a href="javascript:winOpen_module_template(\'' + record.get('templet_para_id') + '\');">列配置</a>';
                    }
                }
                if (name == 'img_template' ) {
                    if (record.get('bookmark_type') == "WATERMARK" ) {
                        return '<a href="javascript:winOpen_img_template(\'' + record.get('templet_para_id') + '\');">水印图片</a>';
                    }
                }
                return '';
            }
            return '';
        }

        <!--打开窗口：列配置-->
        function winOpen_module_template(id) {
            // alert("templet_para_id:" + id);
            new Leaf.Window({
                id : "templet_para_edit",
                url : "${/request/@context_path}/modules/CONT/CONT_SET/CONT002/fnd_contract_mould_par_set.lview",
                title : '列配置',
                fullScreen : false,
                params: {
                    templet_para_id: id,
                    winId:"templet_para_edit"
                },
                draggable : true,
                closeable : true,
                width : 850,
                height : 450,
                side:"right"
            });
        }

        <!--打开窗口：水印图片-->
        function winOpen_img_template(id) {
            new Leaf.Window({
                id : "templet_para_edit",
                url : "${/request/@context_path}/modules/CONT/CONT_SET/fnd_contract_mould_par.lview",
                title : '水印图片',
                fullScreen : false,
                params: {
                    templet_para_id: id,
                    winId:"templet_para_edit"
                },
                draggable : true,
                closeable : true,
                width : 1150,
                height : 450,
                side:"right"
            });
        }
        ]]></script>
        <a:dataSets>
            <a:dataSet id="bookmark_type_ds" loadData="true" lookupCode="HLS.DOC_FILE_BOOKMARK_TYPE"/>
            <a:dataSet id="underline_ds" loadData="true" lookupCode="HLS.DOC_FILE_UNDERLINE_TYPE"/>
            <a:dataSet id="templet_para_query_ds" autoQuery="true" loadData="true">
                <a:fields>
                    <a:field name="bookmark"/>
                    <a:field name="bookmark_type_cn" options="bookmark_type_ds"
                             displayField="code_value_name" returnField="bookmark_type" valueField="code_value">
                    </a:field>
                    <a:field name="underline_cn" options="underline_ds"
                             displayField="code_value_name" returnField="underline" valueField="code_value">
                    </a:field>
                </a:fields>
            </a:dataSet>
            <a:dataSet id="templet_para_result_ds" autoPageSize="true" autoQuery="true"
                       queryUrl ="${/request/@context_path}/con/hlsdocfiletemp/selectAll"
                       deleteUrl= "${/request/@context_path}/con/hlsdocfiletemp/delCon"
                       queryDataSet="templet_para_query_ds" selectable="true">
                <a:fields>
                    <a:field name="templet_para_id"  prompt="主键"/>
                    <a:field name="bookmark" required="true" prompt="书签代码"/>
                    <a:field name="bookmark_description" prompt="书签描述"/>
                    <a:field name="bookmark_type" prompt="书签类型"/>
                    <a:field name="bookmark_type_cn" options="bookmark_type_ds"
                             displayField="code_value_name" returnField="bookmark_type" valueField="code_value"/>
                    <a:field name="data_source_id" prompt="数据源id"/>
                    <a:field name="description" lovGridHeight="300" lovHeight="460" required="true"
                             lovService="/hls/db/data/source/leaf/query~com.hand.hls.cont.dto.LovDescriptionDto"
                             lovWidth="580" title="数据源信息">
                        <mapping>
                            <map from="data_source_id" to="data_source_id"/>
                            <map from="data_source_code" to="data_source_code"/>
                            <map from="description" to="description"/>
                        </mapping>
                    </a:field>
                    <a:field name="module_template" prompt="列配置"/>
                    <a:field name="img_template" prompt="水印图片"/>
                    <a:field name="font_family" prompt="字体型号"/>
                    <a:field name="font_size" prompt="字体大小"/>
                    <a:field name="underline" prompt="下划线"/>
                    <a:field name="underline_cn" options="underline_ds"
                             displayField="code_value_name" returnField="underline" valueField="code_value">
                    </a:field>
                    <a:field name="blod" checkedValue="Y" defaultValue="Y" uncheckedValue="N" prompt="是否加粗"/>
                    <a:field name="enabled_flag" checkedValue="Y" defaultValue="Y" uncheckedValue="N" prompt="启用"/>
                </a:fields>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:screenTopToolbar>
                <a:screenTitle/>
                <a:gridButton click="templet_para_screen_add" text="HAP.NEW" type="add"/>
                <a:gridButton click="templet_para_screen_save" text="HAP.SAVE" type="save"/>
                <a:gridButton bind="templet_para_ds_grid" text="HAP.DELETE" type="delete"/>
                <a:gridButton click="templet_para_screen_query" text="HAP.QUERY"/>
                <a:gridButton click="templet_para_screen_reset" text="HAP.RESET"/>
            </a:screenTopToolbar>
                <a:form column="3" title="查询条件" labelwidth="100">
                <a:textField name="bookmark" bindTarget="templet_para_query_ds" prompt="书签代码" emptyText="书签代码" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="templet_para_screen_query"/>
                    </a:events>
                </a:textField>
                <a:textField name="bookmark_description" bindTarget="templet_para_query_ds" prompt="书签描述" emptyText="书签描述" width="165">
                    <a:events>
                        <a:event name="enterdown" handler="templet_para_screen_query"/>
                    </a:events>
                </a:textField>
            </a:form>
            <a:grid id="templet_para_ds_grid" bindTarget="templet_para_result_ds"
                    marginWidth="30" marginHeight="120" navBar="true">
                <a:columns>
                    <a:column width="200" name="bookmark" editorFunction="templet_para_ds_grid_tf_editFun" prompt="书签代码" align="center"/>
                    <a:column width="100" name="bookmark_description" editor="templet_para_ds_grid_tf" prompt="书签描述" align="center"  />
                    <a:column width="100" name="bookmark_type_cn" editor="templet_para_ds_grid_combo" prompt="书签类型" align="center"  />
                    <a:column width="150" name="description" editor="templet_para_ds_grid_lov" prompt="数据源" align="center"  />
                    <a:column width="100" name="module_template" renderer="render_templet_para_ds_grid" prompt="列配置" align="center"  />
                    <a:column width="130" name="img_template" renderer="render_templet_para_ds_grid" prompt="水印图片" align="center"  />
                    <a:column width="100" name="font_family" editor="templet_para_ds_grid_tf" prompt="字体型号" align="center"  />
                    <a:column width="100" name="font_size" editor="templet_para_ds_grid_sp" prompt="字体大小" align="center"  />
                    <a:column width="100" name="underline_cn" editor="templet_para_ds_grid_combo" prompt="下划线" align="center"  />
                    <a:column width="80" name="blod" editor="templet_para_ds_grid_check" prompt="是否加粗" align="center"  />
                    <a:column width="80" name="enabled_flag" editor="templet_para_ds_grid_check" prompt="启用" align="center"/>
                </a:columns>
                <a:editors>
                    <a:lov id="templet_para_ds_grid_lov"/>
                    <a:spinner id="templet_para_ds_grid_sp" max="99" min="0" step="0.5"/>
                    <a:textField id="templet_para_ds_grid_tf"/>
                    <a:numberField id="templet_para_ds_grid_nf"/>
                    <a:checkBox id="templet_para_ds_grid_check"/>
                    <a:comboBox id="templet_para_ds_grid_combo"/>
                </a:editors>
            </a:grid>
            <div id="emptyForExportDiv" style="display: none;"></div>
            <iframe frameborder="0" id="emptyForExportIframe" style="display: none;"></iframe>
        </a:screenBody>
    </a:view>
</a:screen>
