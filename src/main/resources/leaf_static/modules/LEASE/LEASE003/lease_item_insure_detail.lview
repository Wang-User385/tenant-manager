<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="lease_insure_save" url="${/request/@context_path}/hls/lease/item/insure/submit"/>

        <script><![CDATA[
        /*Leaf.onReady(function() {debugger;
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_insure');
            $(ds_id).getCurrentRecord().set('lease_item_id','${/parameter/@lease_item_id}');
        });*/

        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var hlsCusHlsLeaseItemInsureList = [];

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_insure');
            $(ds_id).getCurrentRecord().set('lease_item_id','${/parameter/@lease_item_id}');
            var insureInfo = $(ds_id).getCurrentRecord().data;

            if( !$(ds_id).validate()){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            }else{
                Leaf.request({
                    method: 'POST',
                    url: $('lease_insure_save').getUrl(),
                    para:insureInfo ,
                    success: function (res) {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();

                        $L.showInfoMessage("提示", "保存成功!");
                    },
                    failure: function (e) {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "保存失败!");
                    },
                    error: function (e) {
                        window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        $L.showInfoMessage("提示", "保存失败，服务器错误!");
                    },
                    scope: this
                });
            }

        };


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
