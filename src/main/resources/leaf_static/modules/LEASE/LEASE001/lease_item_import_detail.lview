<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="CSH_TRANSACTION_RECEIPT"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[



        function returnBack() {
            //top.refreshFrame();
            //$('${/parameter/@winid}').close();
            parent._input_window.close();
            $('item_receipt_import_win_id').close();
        }

        function saveBtn() {
            var head_id = '${/model/header/record/@header_id}';
            var leaseItemId ='${/parameter/@lease_item_id}';
            console.log(leaseItemId)
            Leaf.request({
                type: 'POST',
                url: "${/request/@context_path}/hls/lease/item/list/import?headerId=" + head_id+"&leaseItemId="+leaseItemId,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    Leaf.showMessage('提示', res.message);
                    //debugger;
                    returnBack();
                }
            });
        }

        function disableBtn() {
            $('saveBtn_id').disable();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="temp_interface_ds" autoQuery="true"
                       queryDataSet="temp_interface_query_ds"
                       queryUrl="${/request/@context_path}/fnd/interface/lines/query?headerId=${/model/header/record/@header_id}&amp;readLine=2">
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="租赁物新增导入" marginWidth="350">
                <a:grid id="temp_interface_grid_id" bindTarget="temp_interface_ds" marginHeight="350" navBar="true"
                        marginWidth="350">
                    <a:columns>
                        <a:column name="attributes_1" width="80" prompt="序号" align="center"/>
                        <a:column name="attributes_2" width="80" prompt="租赁物名称" align="center"/>
                        <a:column name="attributes_3" width="100" prompt="租赁物价值（元）" align="right"/>
                        <a:column name="attributes_4" width="120" prompt="数量" align="left"/>
                        <a:column name="attributes_5" width="130" prompt="规格" align="left"/>
                        <a:column name="attributes_6" width="150" prompt="供应商" align="left"/>
                        <a:column name="attributes_7" width="150" prompt="品类" align="left"/>
                        <a:column name="attributes_8" width="80" prompt="序列/识别号" align="left"/>
                        <a:column name="attributes_9" width="150" prompt="发票编号"/>
                        <a:column name="attributes_10" width="150" prompt="照片编号"/>
                        <a:column name="attributes_11" width="150" prompt="坐落位置" align="left"/>
                        <a:column name="attributes_12" width="80" prompt="备注" align="left"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
