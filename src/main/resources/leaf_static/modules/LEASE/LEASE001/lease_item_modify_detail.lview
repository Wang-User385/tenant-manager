<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="bill001f2_modify_link_id"
                url="${/request/@context_path}/modules/CSH/CSH_SET/CSH002/csh002_csh_payment_req_hd_detail.lview"/>
        <a:link id="invoice_info_LINK_id"
                url="${/request/@context_path}/modules/VAT/VAT_INVOICE_REC/ACR004/vat_hand_over_invoice.lview"/>
        <script><![CDATA[

        //删除
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON3_layout_dynamic_tab_click'] = function () {
            var hls_lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_list');
            var records = $(hls_lease_item_list_ds_id).getSelected();
            var saveData = [];
            if (records.length > 0) {
                Leaf.showConfirm("${l:HLS.PROMPT}", "确定删除？", function () {
                    if (hls_lease_item_list_ds_id != "") {
                        if ($(hls_lease_item_list_ds_id).getAll().length != 0) {
                            for (var i = 0; i < records.length; i++) {
                                if (records[i].get('transfer_list_id') == undefined) {
                                    $(hls_lease_item_list_ds_id).remove(records[i]);
                                }
                                saveData.push(records[i].data);
                            }
                            Leaf.request({
                                url: '${/request/@context_path}/hls/lease/item/list/remove',
                                para: saveData,
                                success: function (res) {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                    if (res.success) {
                                        Leaf.SideBar.show({
                                            msg: '操作成功',
                                            duration: 1000
                                        });
                                        var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
                                        var lease_item_id = $(pledge_ds_id).getCurrentRecord().get('lease_item_id');
                                        count(pledge_ds_id);
                                        if (lease_item_id) {
                                            $(pledge_ds_id).query();
                                        }

                                    } else {
                                        Leaf.showErrorMessage('提示', res.message);
                                    }
                                },
                                failure: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                error: function () {
                                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                                },
                                scope: this
                            })
                        }
                    }
                });
            } else {
                Leaf.showMessage('${HLS.PROMPT}', '请选择要删除的数据！');
                return;
            }
        };


        //execl导入
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON1_layout_dynamic_tab_click'] = function () {

            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            if (pledge_ds_id == '') {
                return;
            }
            var hlsLease_records = $(pledge_ds_id).getAll();
            var leaseItemId = hlsLease_records[0].data.lease_item_id;
            if (typeof (leaseItemId) === 'undefined' || 'undefined' === leaseItemId) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var win = new Leaf.Window({
                id: 'item_receipt_import_win_id',
                params: {
                    winid: 'item_receipt_import_win_id',
                    lease_item_id: leaseItemId
                },
                url: '${/request/@context_path}/modules/LEASE/LEASE001/lease_item_import.lview',
                title: '租赁物新增导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(pledge_ds_id).query();
            });
        };

        //ocr识别
        window['${/parameter/@layout_code}_G_LEASE_ITEM_LIST_USER_BUTTON2_layout_dynamic_tab_click'] = function () {
            /*var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            if (pledge_ds_id == '') {
                return;
            }
            var hlsLease_records = $(pledge_ds_id).getAll();
            var leaseItemId = hlsLease_records[0].data.lease_item_id;
            if (typeof (leaseItemId) === 'undefined' || 'undefined' === leaseItemId) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }*/

            jQuery("#flieLoad").click();
            jQuery("#flieLoad").off('change').change(function () {
                Leaf.Masker.mask(Ext.getBody(), '识别中。。');
                for(var i=0;i<jQuery("#flieLoad").get(0).files.length; i++){
                    var file = jQuery("#flieLoad").get(0).files[i];
                    if(file == undefined){
                        continue ;
                    }
                    var fileType = file.name;
                    var index= fileType.lastIndexOf(".");
                    var fileType = fileType.substr(index+1);
                    var url = "";
                    if(fileType=='pdf'){
                        url = '${/request/@context_path}/pdf/ocr/import';
                    }else{
                        url = '${/request/@context_path}/table/ocr/import';
                    }

                    var fileName = encodeURI(file.name);
                    var formData = new FormData();
                    formData.append("fileToUpload",file);  //上传一个files对象
                    formData.append("filename",fileName);  //上传一个files对象
                    formData.append("_csrf","${/session/@_csrf.token}");
                    jQuery.ajax({
                        url: url,
                        dataType: "json",
                        type: "post",
                        data: formData,
                        async: false,
                        processData: false,//不去处理发送的数据
                        contentType: false,//不去设置Content-Type请求头
                        error: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            Leaf.showErrorMessage('提示', res.message);
                            return;
                        },
                        success: function (res) {
                            Leaf.Masker.unmask(Ext.getBody());
                            if(res.success == false){
                                Leaf.showErrorMessage('提示', res.message);
                            }else{
                                window.location.href = "${/request/@context_path}/ocr/attachment/package/download?fileName=" + res;
                            }
                            return;
                        }

                    })
                }
                Leaf.Masker.unmask(Ext.getBody());
            });
        };


        function count(pledge_ds_id) {
            var hls_lease_item_list_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_list');

            var totalValue = 0;
            if (hls_lease_item_list_ds_id != "") {
                if ($(hls_lease_item_list_ds_id).getAll().length != 0) {

                    var hls_lease_item_list_id_records = $(hls_lease_item_list_ds_id).getAll();
                    for (var i = 0; i < hls_lease_item_list_id_records.length; i++) {
                        if (typeof (hls_lease_item_list_id_records[i].data.price) === 'undefined' || 'undefined' === hls_lease_item_list_id_records[i].data.price || typeof (hls_lease_item_list_id_records[i].data.quantity) === 'undefined' || 'undefined' === hls_lease_item_list_id_records[i].data.quantity) {
                            return;
                        }
                        totalValue += hls_lease_item_list_id_records[i].data.price * hls_lease_item_list_id_records[i].data.quantity;
                    }
                    if ($(pledge_ds_id).getCurrentRecord() != null && totalValue != NaN) {

                        $(pledge_ds_id).getCurrentRecord().set('net_asset_value_total', totalValue);
                        //$(pledge_ds_id).getCurrentRecord().set('net_asset_value', totalValue);
                    }

                    return;
                }
            }

        }


        //加载时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_load'] = function (ds, record, config_records, bp_seq) {
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            /*
                        count(pledge_ds_id);
            */

        };


        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            //

            var attachment_category_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_attachment');
            console.log(attachment_category_ds_id)

            if (attachment_category_ds_id != "") {
                if ($(attachment_category_ds_id).getCurrentRecord() != null) {
                    $(attachment_category_ds_id).getCurrentRecord().set('attachment_category', 'LEASE');
                }
            }


            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
            var check_flag = true;
            var lease_item_code = $(pledge_ds_id).getCurrentRecord().get('lease_item_code');
            var document_category = 'HLS_LEASE_ITEM';
            var document_type = 'HLS_LEASE_ITEM';
            var business_type = 'HLS_LEASE_ITEM';

            /*
                        count(pledge_ds_id);
            */
            if (pledge_ds_id != "" && $(pledge_ds_id).getCurrentRecord() != null) {

                $(pledge_ds_id).getCurrentRecord().set('lease_item_type', 'LEASE');
                $(pledge_ds_id).getCurrentRecord().set('owner_user_id', '${/session/@employeeId}');

                if (!lease_item_code) {
                    Leaf.request({
                        url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                        success: function (res) {
                            $(pledge_ds_id).getCurrentRecord().set('lease_item_code', res.result.record[0]);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = true;
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        sync: true,
                        scope: this
                    });
                }
            }
            //生成权限字符串  authority_rule_string
            Leaf.request({
                url: "${/request/@context_path}/hls/lease/item/generateAuthorityString",
                success: function (res) {
                    var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
                    $(ds_id).getCurrentRecord().set('authority_rule_string', res.result.record[0]);
                },
                sync: true,
                scope: this
            });

            return check_flag;
        };


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function (ds, record, config_records, bp_seq) {
            var check_flag = true;
            var document_category1 = 'JC_INSURANCE_PLAN';
            var document_type1 = 'JC_INSURANCE_PLAN';
            var business_type1 = 'JC_INSURANCE_PLAN';


            var plan_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'jc_insurance_plan');
            if (plan_ds_id != "" && $(plan_ds_id).getCurrentRecord() != null) {
                var plan_number = $(plan_ds_id).getCurrentRecord().get('plan_number');
                if (!plan_number) {
                    Leaf.request({
                        url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category1 + "&documentType=" + document_type1 + "&businessType=" + business_type1,
                        success: function (res) {
                            $(plan_ds_id).getCurrentRecord().set('plan_number', res.result.record[0]);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = true;
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        sync: true,
                        scope: this
                    });
                }
            }
            return check_flag;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_list');
            var ds_att_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_attachment');
            $(ds_id).query();
            $(ds_att_id).query();
        };

        // 表单查询
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_query'] = function (ds, qpara, bp_seq) {
            //debugger;
            var dsBasicId = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item', 'F_BASIC_INFO');
            if (ds.id === dsBasicId) {
                if ($(dsBasicId).getAt(0) != undefined) {
                    if ($(dsBasicId).getAt(0).get('lease_item_id') != null) {
                        qpara['lease_item_id'] = $(dsBasicId).getAt(0).get('lease_item_id');
                    }
                }
            }

        };

        function assignValue(record, data) {
            for (var i in data) {
                if (data[i] != null) {
                    record[i] = data[i];
                }
            }
        }

        // 保存

        function open_invoice_info_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            if (record.data.invoice_handover_id) {
                var param = record.data;
                param['url_title'] = '交接明细';


                param['function_code'] = 'ACR006';
                param['function_usage'] = 'QUERY';
                param['winid'] = 'invoice_info_detailwinid_wfl';
                hls_doc_get_layout_code(param, 'invoice_info_LINK_id', ds_id, 'ACR006', null, null);
            } else {
                Leaf.showMessage('提示', '未找到发票明细!');
                return;
            }


        }


        function open_payment_req_number_win(ds_id, record_id) {
            debugger;
            var record = $(ds_id).findById(record_id);
            var param = record.data;

            param['function_code'] = 'CSH002F2Q';
            param['url_title'] = '放款申请明细查询';
            param['function_usage'] = 'QUERY';
            hls_doc_get_layout_code(param, 'bill001f2_modify_link_id', ds_id, 'CSH002F2Q');

        }

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            debugger;
            if (name == 'upload') {
                return '<a href="javascript:open_attach(\'' + record.get('hls_lease_item_list_id') + '\')">附件上传</a>';
            }

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '';
                for (var i = 0; i < str.length; i++) {
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] + '">' + str[i] + ' ; </a>';
                }
                return url;
                //return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">' + value + '</a>';
            }

            if (name == 'invoice_info') {
                return '<a href="javascript:open_invoice_info_win(\'' + record.ds.id + '\',\'' + record.id + '\')">交接明细</a>';
            }
            if (name == 'payment_deil' && record.get('loan_application_no')) {
                return '<a href="javascript:open_payment_req_number_win(\'' + record.ds.id + '\',\'' + record.id + '\')">放款明细</a>';
            }

        };

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                //url = '${/request/@context_path}/downloadFile.lview';
                $L.showInfoMessage("提示", "当前无法上传文件!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }

            var win = new Leaf.Window({
                id: 'lease_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_LEASE_ITEM_ATTACHMENT',
                    winid: 'lease_open_attachment_winid'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_list','G_LEASE_ITEM_LIST');
                debugger
                $(ds_id).query();
            });
        }


        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] =
            function (ds, record, name, value, old_value, bp_seq) {


            if (name == 'price'){
                var patt = /^\d+(\.\d+)?$/
                if (!patt.test(value)){
                    Leaf.showMessage('提示','请输入正确的估值！');
                }
            } else if (name == 'quantity'){
                var pattern = /^\d+$/
                if (!pattern.test(value)){
                    Leaf.showMessage('提示','请输入正确的数量！');
                }
            } else if (name == 'original_asset_value'){
                var pattern = /^\d+$/
                if (!pattern.test(value)){
                    Leaf.showMessage('提示','请输入正确的原值！');
                }
            }
                // debugger;
                // //IF_SINCE_THE_MORTGAGE if_since_the_mortgage_n
                // console.log("if_since_the_mortgage_n---->" + record.data.if_since_the_mortgage_n)

                // if (typeof (record.data.if_since_the_mortgage) === 'undefined' || 'undefined' === record.data.if_since_the_mortgage) {
                //
                // } else {
                //     if (record.data.if_since_the_mortgage == 'Y') {
                //
                //         record.fields.mortgage_date_from.setRequired(true);
                //         record.fields.mortgage_date_to.setRequired(true);
                //         record.fields.mortgage_date_from.setReadOnly(false);
                //         record.fields.mortgage_date_to.setReadOnly(false);
                //
                //     } else {
                //         record.data.mortgage_date_from = '';
                //         record.data.mortgage_date_to = '';
                //         record.fields.mortgage_date_from.setRequired(false);
                //         record.fields.mortgage_date_to.setRequired(false);
                //         record.fields.mortgage_date_from.setReadOnly(true);
                //         record.fields.mortgage_date_to.setReadOnly(true);
                //
                //     }
                // }
                var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item');
                count(pledge_ds_id);
                // console.log(ds.id)
                //count(ds.id);


            }


        ]]></script>
        <input type="file" name="image" id="flieLoad" multiple="" accept="image/jpeg,image/jpg,image/png,image/svg,application/pdf" style="display:none"/>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
