<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>

        <a:link id="pli300_check_contract_choose_link_id" url="${/request/@context_path}/modules/plm/pli/PLI300/pli_check_contract_choose.lview"/>

        <a:link id="pli300_wfl_submit_link_id" url="${/request/@context_path}/plm/postloan/inspection/submit/wfl"/>

        <script><![CDATA[

        function get_dsid_by_basetable(layoutDataSetList, base_table, tab_code) {
            if (tab_code) {
                if (base_table) {
                    var base_table_tab_temp = tab_code.toUpperCase() + "_" + base_table.toLowerCase() + '_ds';
                    for (var j = 0; j < layoutDataSetList.length; j++) {
                        var t_dsId = layoutDataSetList[j];
                        if (t_dsId.substring(t_dsId.length - base_table_tab_temp.length, t_dsId.length) == base_table_tab_temp) {
                            return t_dsId;
                        }
                    }
                }
                return '';
            } else {
                if (base_table) {
                    var base_table_temp = base_table.toLowerCase() + '_ds';
                    for (var i = 0; i < layoutDataSetList.length; i++) {
                        var dsId = layoutDataSetList[i];
                        if (dsId.substring(dsId.length - base_table_temp.length, dsId.length) == base_table_temp) {
                            return dsId;
                        }
                    }
                }
                return '';
            }
        }

        var readModel = '${/parameter/@readModel}';

        Leaf.onReady(function(){
            if(readModel == 'edit'){
                $jq("#${/parameter/@layout_code}_submit_approval").hide();

            }
        });

        //合同信息新增
        window['${/parameter/@layout_code}_G_CONTRACT_01_USER_BUTTON1_layout_dynamic_tab_click'] = function () {

            var record = $('${/parameter/@layout_code}_G_INSPECTION_REPORT_plm_postloan_inspection_ds').getCurrentRecord();

            var bp_id = record.get('bp_id');
            var postloan_inspection_id = record.get('postloan_inspection_id');
            var is_plane_check = record.get('is_plane_check');

            var function_code = 'PLI300_CONTRACT';

            var param = {};
            param['function_code'] = function_code;
            param['url_title'] = '贷后检查明细';
            param['side'] = 'right';
            param['screen_width'] = '900';
            param['bp_id'] = bp_id;
            param['postloan_inspection_id'] = postloan_inspection_id;
            param['is_plane_check'] = is_plane_check;
            param['parent_layout_code'] = '${/parameter/@layout_code}';

            hls_doc_get_layout_code(param, 'pli300_check_contract_choose_link_id', null, function_code);
        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function(value, record, name, config_record, bp_seq) {
            var link_function = 'upload_file';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name == 'upload'){
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.ds.id + '\',\'' + record.get('plm_attachment_id') + '\');">附件</a>';
            }
        };


        window['upload_file'] = function(ds_id,plm_attachment_id){

            if(isNaN(plm_attachment_id)){
                $L.showInfoMessage("提示","请先保存当前信息!");
                return;
            }

            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'pli300_open_attachment_winid',
                /*url: '${/request/@context_path}/modules/COMMON/ATTACH/project_attachment_upload.lview?projectAttachmentId=163',*/
                //url: '${/request/@context_path}/uploadFile.lview?projectAttachmentId=' + project_attachment_id,
                url: url,
                params: {
                    'header_id': plm_attachment_id,
                    'table_name': 'POSTLOAN_INSPECTION_ATTACHMENT',
                    winid: 'pli300_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                $(ds_id).query();
            });
        }

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {

            var hls_fin_statement_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_fin_statement_hd');

            var plm_postloan_inspection_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_postloan_inspection');


            if(ds.id == hls_fin_statement_hd_ds_id){
                record.set('bp_id','${/parameter/@bp_id}');
            }

            if(ds.id == plm_postloan_inspection_ds_id){

                //现场检查
                if(readModel == 'edit' && '${/parameter/@function_code}' == 'LOAN_SCENE'){

                    record.getField('start_date').setReadOnly(false);
                    record.getField('end_date').setReadOnly(false);
                    record.getField('project_manager').setReadOnly(false);

                }
            }

        };


        //新增时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_add'] = function(ds, record, config_records, bp_seq) {
            if(ds.id == '${/parameter/@layout_code}_G_SURVEY_plm_pli_check_item_ds'){
                record.set('list_type','SURVEY');
            }

            if(ds.id == '${/parameter/@layout_code}_G_CHECK_ITEMS_plm_pli_check_item_ds'){
                record.set('list_type','LESSEE');
            }

            if(ds.id == '${/parameter/@layout_code}_G_GUARANTOR_INSPECTION_plm_pli_check_item_ds'){
                record.set('list_type','GUARANTOR');
            }

            if(ds.id == '${/parameter/@layout_code}_G_LEASE_INSPECTION_plm_pli_check_item_ds'){
                record.set('list_type','LEASE');
            }

            if(ds.id == '${/parameter/@layout_code}_G_INSPECTION_PLEDGES_plm_pli_check_item_ds'){
                record.set('list_type','PAWN');
            }

            if(ds.id == '${/parameter/@layout_code}_G_AFTER_RENT_plm_pli_check_item_ds'){
                record.set('list_type','ON_SURVEY_PLANE');
            }

            var plm_attachment_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_attachment');

            var base_record = $('${/parameter/@layout_code}_G_INSPECTION_REPORT_plm_postloan_inspection_ds').getCurrentRecord();

            if(ds.id === plm_attachment_ds_id){
                record.set('plm_id',base_record.get('postloan_inspection_id'));
                record.set('plm_attachment_category',"POSTLOAN_INSPECTION_ATTACHMENT");
            }

            if(ds.id === '${/parameter/@layout_code}_G_AIR_LEASING_plm_pli_lease_item_ds'){
                record.set('postloan_inspection_id',base_record.get('postloan_inspection_id'));
            }
        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            if(ds.id == '${/parameter/@layout_code}_G_SURVEY_plm_pli_check_item_ds'){
                qpara['list_type'] = 'SURVEY';
            }

            if(ds.id == '${/parameter/@layout_code}_G_CHECK_ITEMS_plm_pli_check_item_ds'){
                qpara['list_type'] = 'LESSEE';
            }

            if(ds.id == '${/parameter/@layout_code}_G_GUARANTOR_INSPECTION_plm_pli_check_item_ds'){
                qpara['list_type'] = 'GUARANTOR';
            }

            if(ds.id == '${/parameter/@layout_code}_G_LEASE_INSPECTION_plm_pli_check_item_ds'){
                qpara['list_type'] = 'LEASE';
            }

            if(ds.id == '${/parameter/@layout_code}_G_INSPECTION_PLEDGES_plm_pli_check_item_ds'){
                qpara['list_type'] = 'PAWN';
            }

            if(ds.id == '${/parameter/@layout_code}_G_AFTER_RENT_plm_pli_check_item_ds'){
                qpara['list_type'] = 'ON_SURVEY_PLANE';
            }
        };

        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function (ds, record, name, value, old_value, bp_seq) {
            var hls_fin_statement_hd_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_fin_statement_hd');
            var plm_postloan_inspection_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_postloan_inspection');

            if(ds.id === hls_fin_statement_hd_ds_id) {
                if (name == 'fin_statement_hd_id') {
                    $(plm_postloan_inspection_ds_id).getCurrentRecord().set('fin_statement_hd_id', value);
                }
            }
        }

        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function (ds, record) {
            //删除额度信息，财务信息，这两个信息不需要保存
            var dataObj = $('${/parameter/@layout_code}_virtual_ds').getCurrentRecord().data;
            if (dataObj['${/parameter/@layout_code}_F_FINANCE_hls_fin_statement_hd']) {
                delete dataObj['${/parameter/@layout_code}_F_FINANCE_hls_fin_statement_hd'];
            }
            return true;
        }

        //提交审批
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function () {
            window['${/parameter/@layout_code}_SAVE_LAYOUT_DYNAMIC_CLICK'](function(){

                var plm_postloan_inspection_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'plm_postloan_inspection');
                var record = $(plm_postloan_inspection_ds_id).getCurrentRecord();

                Leaf.request({
                    url: $('pli300_wfl_submit_link_id').getUrl(),
                    para: {
                        postloan_inspection_id: record.get('postloan_inspection_id')
                    },
                    success: function (res) {

                        $L.showInfoMessage("提示","提交成功!",function(){
                            $('${/parameter/@winid}').close();
                        });
                    },
                    error: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    failure: function (res) {
                        $L.showInfoMessage("提示","提交失败!");
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    },
                    sync: true,
                    scope: this
                });

            });
        }

        $L.ComboBox.prototype.collapse = function () {
            Ext.get(document.documentElement).un("mousedown", this.triggerBlur, this);
            if(this.popup) {
                this.popup.moveTo(-1000, -1000);
                this.popup.removeClass('animated zoomInDownPopup');
                this.popup.addClass('animated zoomOut');
            }
            this.fireEvent("collapse", this);
        }
        ]]></script>

    </a:view>
</a:screen>
