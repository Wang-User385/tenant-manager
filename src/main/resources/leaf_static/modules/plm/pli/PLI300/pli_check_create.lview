<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true"
          trace="true">
    <a:view>
        <a:link id="pli300_pli_check_detail_link_id" url="${/request/@context_path}/modules/plm/pli/PLI300/pli_check_detail.lview"/>
        <script><![CDATA[
        var isPlaneCheck = '${/parameter/@isPlaneFlag}' == 'true' ? 'Y':'N';

        Leaf.onReady(function(){
            if(isPlaneCheck === 'Y'){
                $('pli300_create_check_form_inspection_type_combobox').setOptions('pli_check_plane_combobox_ds');
            }else{
                $('pli300_create_check_form_inspection_type_combobox').setOptions('pli_check_combobox_ds');
            }
        });


        //设置附件信息
        function setAccessory(datas) {
            //检查方式
            var inspectionType= datas.inspectionType||'';
            //是否飞机
            var isPlaneCheck= datas.isPlaneCheck||'';
            datas.attribute1='';
            if ((!!inspectionType)&&(!!isPlaneCheck)){
                //飞机
                if ('Y'==isPlaneCheck)
                {
                    //现场
                    if ('ON_SITE_INSPECT_PLANE'==inspectionType){
                        datas.attribute1='ACCESSORY.PLAN.ONSITE';
                    }
                    //非现场
                    else if ('OFF_SITE_INSPECT_PLAN'==inspectionType){
                        datas.attribute1='ACCESSORY.PLAN.OFFSITE';
                    }
                }
                //非飞机
                else {
                    //现场
                    if ('ON_SITE_INSPECT'==inspectionType){
                        datas.attribute1='ACCESSORY.NOTPLAN.ONSITE';
                    }
                    //非现场
                    else if ('OFF_SITE_INSPECT'==inspectionType){
                        datas.attribute1='ACCESSORY.NOTPLAN.OFFSITE';
                    }
                }
            }
        }

        //创建贷后检查
        function create_pli_check(datas) {
            var url = '${/request/@context_path}/plm/postloan/inspection/create';
            var isPlaneCheck = "N";
            if (datas.isPlaneCheck && datas.isPlaneCheck == "Y") {
                isPlaneCheck = "Y";
            };
            //设置附件信息
            setAccessory(datas);
            $jq.ajax({
                url: url,
                type: "POST",
                dataType: "json",
                headers: {
                    'X-CSRF-TOKEN': "${/session/@_csrf.token}"
                },
                data: JSON.stringify(datas),
                contentType: "application/json",
                success: function (data) {
                    $L.Masker.unmask(Ext.getBody());
                    if (data.success) {
                        var inspectionType = data.rows[0].inspectionType;
                        var postloanInspectionId = data.rows[0].postloanInspectionId;

                        $L.showInfoMessage("提示","创建成功!",function(){
                            var function_code;

                            /*LOAN_INSPECTION：资产贷后检查明细页面-飞机（定期/不定期-非现场）
                            LOAN_INSPECTION_SCENE：资产贷后检查明细页面-飞机（定期/不定期-现场）
                            LOAN_SCENE：资产贷后检查定期/不定期_（现场）
                            LOAN_OFF_SCENE：资产贷后检查定期/不定期_(非现场)*/


                            //打开对应的页面
                            if(isPlaneCheck == 'Y'){

                                //飞机（非现场）
                                if(datas.inspectionType == 'OFF_SITE_INSPECT_PLAN'){
                                    function_code = 'LOAN_INSPECTION';
                                }

                                //飞机（不定期-现场）
                                if(datas.inspectionMethod == 'IRREGULAR' && datas.inspectionType == 'ON_SITE_INSPECT_PLANE'){
                                    function_code = 'LOAN_INSPECTION_SCENE';
                                }
                            }else{


                                if(datas.inspectionType == 'ON_SITE_INSPECT'){

                                    //现场定期
                                    if(datas.inspectionMethod == 'REGULAR') {
                                        function_code = 'LOAN_SCENE';
                                    }

                                    //现场不定期
                                    if(datas.inspectionMethod == 'IRREGULAR') {
                                        function_code = 'LOAN_NOSCENE';
                                    }
                                }


                                if(datas.inspectionType == 'OFF_SITE_INSPECT'){

                                    //非现场定期
                                    if(datas.inspectionMethod == 'REGULAR') {
                                        function_code = 'LOAN_OFF_SCENE';
                                    }

                                    //非现场不定期
                                    if(datas.inspectionMethod == 'IRREGULAR') {
                                        function_code = 'LOAN_OFF_NOSCENE';
                                    }
                                }

                            }
                            //打开动态页面
                            var param = data.rows[0];
                            param['function_code'] = function_code;
                            param['url_title'] = '贷后检查明细';
                            param['postloan_inspection_id'] = param['postloanInspectionId'];
                            param['bp_id'] = param['bpId'];
                            hls_doc_get_layout_code(param, 'pli300_pli_check_detail_link_id', null, function_code,'${/parameter/@winid}','Y');

                        });

                    } else {
                        $L.showInfoMessage("错误","贷后创建失败"+data.error.message);
                    }
                }
            });
        }

        function create_check_regular(){
            var inspection_type,bp_id;
            var datas = $('pli300_create_check_ds_id').getSelected();
            if(datas.length == 2){
                inspection_type = 'ALL';
            }else {
                inspection_type = datas[0].get('inspection_type');
            }
            bp_id = datas[0].get('bp_id');

            common_submit('REGULAR',inspection_type,bp_id);
        }

        function create_check_irregular(){
            var inspection_type = $('pli300_create_check_form_ds_id').getCurrentRecord().get('inspection_type');
            var bp_id = $('pli300_create_check_form_ds_id').getCurrentRecord().get('bp_id');
            common_submit('IRREGULAR',inspection_type,bp_id);
        }

        function common_submit(inspectionMethod,inspectionType,bpId){
            var data = {
                inspectionMethod: inspectionMethod,
                inspectionType: inspectionType,
                bpId: bpId,
                isPlaneCheck: isPlaneCheck
            };
            $L.showInfoMessage("提示","确认创建!",function () {
                $L.Masker.mask(Ext.getBody(),"正在创建...");
                create_pli_check(data);
            });
        }

        function pli300_create_check_ds_query(ds, para){
            para['is_plane_check'] = isPlaneCheck;
        }

        function pli300_create_check_ds_select(ds,record){
            var datas = ds.getSelected();
            for(var i = 0; i < datas.length; i++){
                if(datas[i].get('bp_id') != record.get('bp_id')){
                    $L.showInfoMessage("提示","请选择相同的客户!");
                    return false;
                }
                if(datas[i].get('inspection_type') != record.get('inspection_type')){
                    var date1 = new Date(datas[i].get('appointed_date')).getMonth();
                    var date2 = new Date(record.get('appointed_date')).getMonth();
                    if(Math.abs(date1-date2) > 1){
                        $L.showInfoMessage("提示","不同的检查性质间待检查日期不能超过1个月!");
                        return false;
                    }
                }
            }
            return true;
        }

        ]]></script>
        <a:dataSets>

            <a:dataSet id="pli_check_plane_combobox_ds">
                <a:datas>
                    <a:record code_value_name="飞机现场检查" code_value="ON_SITE_INSPECT_PLANE"/>
                    <a:record code_value_name="飞机非现场检查" code_value="OFF_SITE_INSPECT_PLAN"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="pli_check_combobox_ds">
                <a:datas>
                    <a:record code_value_name="现场检查" code_value="ON_SITE_INSPECT"/>
                    <a:record code_value_name="非现场检查" code_value="OFF_SITE_INSPECT"/>
                </a:datas>
            </a:dataSet>

            <a:dataSet id="pli300_create_check_ds_id" autoQuery="true" selectable="true" selectionModel="multiple"
                       queryUrl="${/request/@context_path}/plm/pli/upcoming/list/query">

                <a:events>
                    <a:event name="query" handler="pli300_create_check_ds_query"/>
                    <a:event name="beforeselect" handler="pli300_create_check_ds_select"/>
                </a:events>
            </a:dataSet>

            <a:dataSet id="pli300_create_check_form_ds_id" autoCreate="true">
                <a:fields>
                    <a:field name="bp_name" autoComplete="true" required="true" lovGridHeight="350" lovHeight="550"
                             lovLabelWidth="90"
                             lovService="/hls/bp/queryBpMasterLov~hls.layout.dto.LovHlsBpMasterDto" lovWidth="550"
                             title="HLS.BP_TITLE" prompt="商业伙伴">
                        <a:mapping>
                            <a:map from="bp_id" to="bp_id"/>
                            <a:map from="bp_name" to="bp_name"/>
                            <a:map from="bp_code" to="bp_code"/>
                            <a:map from="bp_type" to="bp_type"/>
                            <a:map from="bp_type_n" to="bp_type_n"/>
                        </a:mapping>
                    </a:field>
                    <a:field name="inspection_type_desc" required="true" displayField="code_value_name"
                             returnField="inspection_type" valueField="code_value"/>
                    <a:field name="inspection_type"/>
                </a:fields>
            </a:dataSet>

        </a:dataSets>

        <a:screenBody>
        <a:tabPanel height="400" width="1000">
            <a:tabs>
                <a:tab prompt="定期检查" width="110">

                    <a:gridButton width="100" click="create_check_regular" style="margin-left:20px;margin-top:10px;" text="创建"></a:gridButton>

                    <a:grid id="pli300_create_check_grid_id" bindTarget="pli300_create_check_ds_id" navBar="true" height="300" width="800">
                        <a:columns>
                            <a:column name="bp_name" prompt="客户名称" width="120"/>
                            <a:column name="bp_code" prompt="客户编号" width="150"/>
                            <a:column name="inspection_type_n" prompt="检查性质" width="100"/>
                            <a:column name="appointed_date" prompt="待检查日期" width="100"/>
                        </a:columns>

                    </a:grid>


                </a:tab>

                <a:tab prompt="不定期检查" width="110">

                    <a:form>
                        <a:gridButton text="创建" click="create_check_irregular" width="100" ></a:gridButton>
                        <a:hBox>
                            <a:lov name="bp_name" prompt="客户名称" bindTarget="pli300_create_check_form_ds_id"/>
                        </a:hBox>

                        <a:hBox>
                            <a:lov name="bp_code" prompt="客户编码" readOnly="true" bindTarget="pli300_create_check_form_ds_id"/>
                        </a:hBox>

                        <a:hBox>
                            <a:comboBox id="pli300_create_check_form_inspection_type_combobox" name="inspection_type_desc" prompt="检查性质" bindTarget="pli300_create_check_form_ds_id"/>
                        </a:hBox>

                    </a:form>
                </a:tab>
            </a:tabs>
        </a:tabPanel>
        </a:screenBody>
    </a:view>
</a:screen>
