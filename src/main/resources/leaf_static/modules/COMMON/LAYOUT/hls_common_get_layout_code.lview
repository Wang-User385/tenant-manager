<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:view>
        <script><![CDATA[
        function hls_doc_get_layout_code(param, win_url_link, list_ds, pre_layout_code, pre_winid, pre_win_close_flag, function_name) {
            if (pre_winid) {
                if($(pre_winid)) {
                    Leaf.Masker.mask($(pre_winid).wrap, '${l:HLS.EXECUTING}');
                }
            } else {
                Leaf.Masker.mask(Ext.getBody(), '${l:HLS.EXECUTING}');
            }
            Leaf.request({
                url: '${/request/@context_path}/server/layout/get',
                para: param,
                success: function (res) {
                    if (pre_winid) {
                        Leaf.Masker.unmask($(pre_winid).wrap);
                    } else {
                        Leaf.Masker.unmask(Ext.getBody());
                    }
                    if (!res.result.record[0].layout_code) {
                        Leaf.showMessage('提示', '布局代码不存在');
                        return;
                    }
                    param['layout_code'] = res.result.record[0].layout_code;
                    var winid = '';
                    if (!param['winid']) {
                        if (pre_layout_code) {
                            param['pre_layout_code'] = pre_layout_code;
                            winid = pre_layout_code + 'hls_doc_get_layout_code_winid';
                        } else {
                            winid = 'hls_doc_get_layout_code_winid';
                        }
                    } else {
                        winid = param['winid'];
                    }
                    param['winid'] = winid;
                    var win;
                    if(param['function_usage']=="CREATE"){
                        param['refreshable'] = false;
                    }else if(param['function_usage']!="CREATE"){
                        param['refreshable'] = true;
                    }
                    if(param['side'] && param['screen_width']){
                        win = new Leaf.Window({
                            id: winid,
                            params: param,
                            url: $(win_url_link).getUrl(),
                            title: param['url_title'] + '(' + param['layout_code'] + ')',
                            width: param['screen_width'],
                            side:param['side'],
                            refreshable:param['refreshable'],
                            draggable: false
                        });
                    }
                    else if (param['screen_width'] || param['screen_height']) {
                        win = new Leaf.Window({
                            id: winid,
                            params: param,
                            url: $(win_url_link).getUrl(),
                            title: param['url_title'] + '(' + param['layout_code'] + ')',
                            width: param['screen_width'],
                            height: param['screen_height'],
                            refreshable:param['refreshable'],
                            draggable: false
                        });
                    } else {
                        win = new Leaf.Window({
                            id: winid,
                            params: param,
                            url: $(win_url_link).getUrl(),
                            title: param['url_title'] + '(' + param['layout_code'] + ')',
                            refreshable:param['refreshable'],
                            fullScreen: true,
                            draggable: true
                        });
                    }
                    win.on('close', function () {
                        if (pre_winid && pre_win_close_flag === 'Y') {
                            $(pre_winid).close();
                        }
                        if (list_ds) {
                            if(list_ds == 'wfl_task_detail_query'){
                                //工作流页面全屏跳转刷新用
                                document.getElementById("includeFrame").src = document.getElementById("includeFrame").src;
                            }else{
                                $(list_ds).query($(list_ds).currentPage);
                            }
                        }
                        if (function_name) {
                            window[function_name]();
                        }

                    });
                },
                failure: function () {
                    if (pre_layout_code) {
                        Leaf.Masker.unmask($(pre_winid).wrap);
                    } else {
                        Leaf.Masker.unmask(Ext.getBody());
                    }
                },
                error: function () {
                    if (pre_layout_code) {
                        Leaf.Masker.unmask($(pre_winid).wrap);
                    } else {
                        Leaf.Masker.unmask(Ext.getBody());
                    }
                },
                scope: this
            });
        }

        function get_dsid_by_basetable(layoutDataSetList, base_table, tab_code) {
            if (tab_code) {
                if (base_table) {
                    var base_table_tab_temp = tab_code.toUpperCase() + "_" + base_table.toLowerCase() + '_ds';
                    for (var j = 0; j < layoutDataSetList.length; j++) {
                        var t_dsId = layoutDataSetList[j];
                        if (t_dsId.substring(t_dsId.length - base_table_tab_temp.length, t_dsId.length) == base_table_tab_temp) {
                            return t_dsId;
                        }
                    }
                }
                return '';
            } else {
                if (base_table) {
                    var base_table_temp = base_table.toLowerCase() + '_ds';
                    for (var i = 0; i < layoutDataSetList.length; i++) {
                        var dsId = layoutDataSetList[i];
                        if (dsId.substring(dsId.length - base_table_temp.length, dsId.length) == base_table_temp) {
                            return dsId;
                        }
                    }
                }
                return '';
            }
        }

        //某字段只读 加载时调用
        function readonly_dataset_field(layout_code, base_table, field, tab_code) {
            var ds_id = layout_code.toUpperCase() + '_' + tab_code.toUpperCase() + '_' + base_table.toUpperCase() + '_' + field.toUpperCase();
            var $field = $(ds_id);
            $field.initReadOnly(true);
            $field.initEditable(false);
            var field_id = get_dsid_by_basetable(window[layout_code + '_layoutDataSetList'], base_table, tab_code);
            $(field_id).fields[field.toLowerCase()].setReadOnly(true);
            if ($(field_id).fields[field.toLowerCase() + '_n']) {
                $(field_id).fields[field.toLowerCase() + '_n'].setReadOnly(true);
            }
        }

        //某字段可输 加载时调用
        function unreadonly_dataset_field(layout_code, base_table, field, tab_code) {
            var ds_id = layout_code.toUpperCase() + '_' + tab_code.toUpperCase() + '_' + base_table.toUpperCase() + '_' + field.toUpperCase();
            var $field = $(ds_id);
            $field.initReadOnly(false);
            var field_id = get_dsid_by_basetable(window[layout_code + '_layoutDataSetList'], base_table, tab_code);
            $(field_id).fields[field.toLowerCase()].setReadOnly(false);
            if ($(field_id).fields[field.toLowerCase() + '_n']) {
                $(field_id).fields[field.toLowerCase() + '_n'].setReadOnly(false);
            }
        }


        //某字段非必填 加载时调用
        function unrequire_dataset_field(layoutDataSetList, base_table, field, tab_code) {
            var field_id = get_dsid_by_basetable(layoutDataSetList, base_table, tab_code);
            $(field_id).fields[field.toLowerCase()].setRequired(false);

            if ($(field_id).fields[field.toLowerCase() + '_n']) {
                $(field_id).fields[field.toLowerCase() + '_n'].setRequired(false);
            }
        }

        //某字段必填 加载时调用
        function require_dataset_field(layoutDataSetList, base_table, field, tab_code) {
            var field_id = get_dsid_by_basetable(layoutDataSetList, base_table, tab_code);
            $(field_id).fields[field.toLowerCase()].setRequired(true);

            if ($(field_id).fields[field.toLowerCase() + '_n']) {
                $(field_id).fields[field.toLowerCase() + '_n'].setRequired(true);
            }
        }

        ]]></script>
    </a:view>
</a:screen>
