<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" trace="true">
    <a:init-procedure outputPath="/parameter">
        <a:model-query model="$com.hand.hls.fnd.service.IHlsFndAttributeSequenceService.selectHeaderId"
                       rootPath="header"/>
        <a:import-excel header_id="${/model/header/record/@header_id}" separator=","
                        status_field="/parameter/@ImportSuccess" template_code="WARRANT_DETAIL_IMPORT"
                        user_id="${/session/@user_id}"/>
    </a:init-procedure>
    <a:view>
        <script><![CDATA[

        function returnBack() {

            parent._input_window.close();
            // top.refreshFrame()
            $('warrant_import_win_id').close();
        }

        function saveBtn() {
            var head_id = '${/model/header/record/@header_id}';
            var project_id = '${/parameter/@project_id}';

            Leaf.request({
                type: 'POST',
                url: "${/request/@context_path}/hls/lease/warrant/import?headerId=" + head_id +"&projectId=" + project_id ,
                async: true, //设为同步
                contentType: "application/json; charset=utf-8",
                success: function (res) {
                    Leaf.showMessage('提示', res.message);
                    returnBack();
                }
            });
        }

        function disableBtn() {
            $('saveBtn_id').disable();
        }

        ]]></script>
        <a:dataSets>
            <a:dataSet id="temp_interface_ds" autoQuery="true"
                       queryDataSet="temp_interface_query_ds"
                       queryUrl="${/request/@context_path}/fnd/interface/lines/query?headerId=${/model/header/record/@header_id}&amp;readLine=1">
                <a:events>
                    <a:event name="submitsuccess" handler="disableBtn"/>
                </a:events>
            </a:dataSet>
        </a:dataSets>
        <a:screenBody>
            <a:form id="success_form" height="400" title="权证导入" marginWidth="100">
                <a:grid id="temp_interface_grid_id" bindTarget="temp_interface_ds" marginHeight="150" navBar="true"
                        marginWidth="150">
                    <a:columns>
                        <a:column name="attributes_1" width="80"  prompt="客户名称" align="center"/>
                        <a:column name="attributes_2" width="80"  prompt="业务角色" align="center"/>
                        <a:column name="attributes_3" width="100" prompt="权证名称" align="center"/>
                        <a:column name="attributes_4" width="100" prompt="文件编号" align="center"/>
                        <a:column name="attributes_5" width="100" prompt="入库编号" align="center"/>
                        <a:column name="attributes_6" width="120" prompt="权证类型" align="center"/>
                        <a:column name="attributes_7" width="130" prompt="档案类型" align="center"/>
                        <a:column name="attributes_8" width="150" prompt="权证状态" align="center"/>
                        <a:column name="attributes_9" width="80"  prompt="正本/副本" align="center"/>
                        <a:column name="attributes_10" width="150" prompt="原件/复印件" align="center"/>
                        <a:column name="attributes_11" width="150" prompt="文件数量" align="center"/>
                        <a:column name="attributes_12" width="150" prompt="权证说明" align="center"/>
                        <a:column name="attributes_13" width="150" prompt="备注" align="center"/>
                    </a:columns>
                </a:grid>
                <a:screenTopToolbar>
                    <a:gridButton id="saveBtn_id" click="saveBtn" text="DETERMINING_IMPORT"/>
                    <a:gridButton click="returnBack" text="HAP_BACK"/>
                </a:screenTopToolbar>
            </a:form>
        </a:screenBody>
    </a:view>
</a:screen>
