<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="warrrant_stock_info_add_id"
                url="${/request/@context_path}/modules/WARRANT/WARRANT002/warrant_stock_info_add.lview"/>
        <a:link id="warrrant_stock_check_link"
                url="${/request/@context_path}/warrant/stock/check"/>


        <script><![CDATA[

        //新增和加载时调用(form)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function(ds, record, config_records, bp_seq) {
            //debugger;
            // alert(1);
            // var basic_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant','F_BASIC_INFO');
            var basic_ds_id = '${/parameter/@layout_code}_F_BASIC_INFO__ds';
            var contract_number = '${/parameter/@contract_number}';
            var contract_name = '${/parameter/@contract_name}';
            var project_id = '${/parameter/@project_id}';
            if (ds.id === basic_ds_id) {
                if ($(basic_ds_id).getAt(0) != undefined) {
                    var basicRecord = $(basic_ds_id).getCurrentRecord();
                    basicRecord.set('contract_number',contract_number);
                    basicRecord.set('contract_name',contract_name);
                    basicRecord.set('project_id',project_id);
                }
            }

        };

        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            if(ds.id == '${/parameter/@layout_code}_G_WARRANT_INFO_hls_lease_item_warrant_ds'){
                qpara['project_id'] = '${/parameter/@project_id}';
            }
        };


        //保存前调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_before_submit'] = function(ds, record) {
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            debugger;
            var check_flag = true;
            var contract_number = '${/parameter/@contract_number}';
            var contract_name = '${/parameter/@contract_name}';
            var project_id = '${/parameter/@project_id}';

            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant' ,'G_WARRANT_INFO');
            var warrantRecord = $(warrant_ds_id).getAll();
            for(var i = 0 ; i < warrantRecord.length ; i++ ){
                warrantRecord[i].data.project_id = project_id;
                warrantRecord[i].data.contract_number = contract_number;
                warrantRecord[i].data.contract_name = contract_name;
            }

            return check_flag;
        };

        //保存submitsuccess调用
        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant' ,'G_WARRANT_INFO');
            $(warrant_ds_id).query();
        };

        //权证导入
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant' ,'G_WARRANT_INFO');
            var project_id = '${/parameter/@project_id}';
            var win = new Leaf.Window({
                id: 'warrant_import_win_id',
                params: {
                    winid: 'warrant_import_win_id'
                },
                url: '${/request/@context_path}/modules/WARRANT/WARRANT001/warrant_info_detail_import.lview?project_id='+project_id,
                title: '权证导入',
                fullScreen: false,
                width: 500,
                height: 400,
                draggable: true
            });
            win.on('close', function () {
                $(warrant_ds_id).query();
            });
        };


        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

            if (name == 'upload') {
                return '<a href="javascript:open_attach(\'' + record.get('warrant_id') + '\')">附件上传</a>';
            }

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
                //return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">' + value + '</a>';
            }

        };

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                //url = '${/request/@context_path}/downloadFile.lview';
                $L.showInfoMessage("提示", "当前无法上传文件!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'warrant_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_LEASE_ITEM_WARRANT',
                    winid: 'warrant_open_attachment_winid'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant');
                $(ds_id).query();
            });
        }


        //创建出入库审批
        window['${/parameter/@layout_code}_user_button3_layout_dynamic_click'] = function () {

            //debugger;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant','G_WARRANT_INFO');
            var warrant_record = $(warrant_ds_id).getSelected();

            if(warrant_record.length  == 0 ){
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showInfoMessage("提示" , "请至少选择一条权证信息！");
                return;
            }
            var warrant_status = '';
            var warrant_id_list = [];
            var project_id = '';

            for(var i = 0 ; i < warrant_record.length ; i ++ ){
                // debugger;
                if( i == 0){
                    warrant_status = warrant_record[i].data.warrant_status;
                    project_id = warrant_record[i].data.project_id;
                }
                var warrant_status_compare = warrant_record[i].data.warrant_status;
                if(warrant_status != warrant_status_compare){
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "权证状态不一致");
                    return;
                }
                warrant_id_list.push(warrant_record[i].data);
            }

            Leaf.request({
                url: $('warrrant_stock_check_link').getUrl(),
                para:  warrant_id_list ,

                success: function (res) {

                    var param = {};
                    param['url_title'] = '创建出入库申请';
                    param['function_code'] = 'WARRANT002';
                    param['function_usage'] = 'MODIFY';
                    param['warrant_id_list'] = JSON.stringify(warrant_id_list);
                    param['project_id'] = project_id;
                    param['warrant_status'] = warrant_status;
                    param['screen_width'] = '600';
                    param['screen_height'] = '400';

                    console.log(param);
                    var link_id = 'warrrant_stock_info_add_id';
                    window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    hls_doc_get_layout_code(param, link_id, null , 'WARRANT001F1');

                },
                failure: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                error: function () {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                },
                scope: this
            });




        };



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
