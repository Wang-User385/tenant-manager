<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>

        <a:link id="warrant_stock_detail_link"
                url="${/request/@context_path}/modules/WARRANT/WARRANT003/warrant_stock_info_detail.lview"/>
        <script id="scriptA"><![CDATA[

        var  modifyFlag = 'N';

        var pageChooser = new PageChooser({
            url: $('warrant_stock_detail_link').getUrl() + '?function_code=WARRANT003',
            function_code: 'WARRANT003',
            context_path: '${/request/@context_path}',
            opt: {
                warrant_stock_id: "${/parameter/@businessKey}",
                maintain_type: 'READONLY',
                function_usage: 'QUERY',
                function_code: 'WARRANT003',
                modify_flag : modifyFlag



            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });


        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>

