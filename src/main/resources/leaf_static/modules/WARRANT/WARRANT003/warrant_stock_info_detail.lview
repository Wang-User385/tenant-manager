<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <script><![CDATA[

        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {

            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;

            if (name == 'upload') {
                return '<a href="javascript:open_attach(\'' + record.get('warrant_id') + '\')">附件上传</a>';
            }

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    var temp = record.get('attachment_id').split(',');
                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp[i] +'">' + str[i] +' ; </a>';
                }
                return url;
                //return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('attachment_id') + '">' + value + '</a>';
            }

        };

        //打开附件窗口
        function open_attach(id) {
            if (typeof (id) === 'undefined' || 'undefined' === id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                //url = '${/request/@context_path}/downloadFile.lview';
                $L.showInfoMessage("提示", "当前无法上传文件!");
                return;
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'warrant_open_attachment_winid',
                url: url,
                params: {
                    header_id: id,
                    table_name: 'HLS_LEASE_ITEM_WARRANT',
                    winid: 'warrant_open_attachment_winid'
                },
                title: '附件',
                width: 800,
                height: 575
            });

            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant');
                $(ds_id).query();
            });
        }



        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function(ds, qpara, bp_seq) {
            if(ds.id && '${/parameter/@layout_code}_G_WARRANT_INFO_hls_lease_item_warrant_ds' == ds.id){
                ds.setQueryParameter('warrant_stock_id', '${/parameter/@warrant_stock_id}');
            }
        };


        function beforeSubmit(countiune) {
            debugger;

            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'hls_lease_item_warrant', 'G_WARRANT_INFO');
            var warrant_record = $(warrant_ds_id).getAll();
            var modify_flag = '${/parameter/@modify_flag}';
            var check_flag = 'Y';
            if(modify_flag == 'Y'){

                for(var i = 0 ; i < warrant_record.length ; i ++){

                    if(warrant_record[i].data.warehouse_number == '' || warrant_record[i].data.warehouse_number == null ){
                        check_flag = 'N';
                    }
                }

                if(check_flag == 'N'){
                    Leaf.showInfoMessage("提示" , "请维护库号！");
                    return ;
                }

                $(warrant_ds_id).submit();

               countiune();
            }

            countiune();



        };



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
