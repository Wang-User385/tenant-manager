<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">

    <a:view>
        <a:link id="warrrant_stock_info_add_link"
                url="${/request/@context_path}/modules/WARRANT/WARRANT002/warrant_stock_info_add.lview"/>
        <a:link id="applicant_number_detail_link"
                url="${/request/@context_path}/modules/WARRANT/WARRANT003/warrant_stock_info_detail.lview"/>
        <script><![CDATA[


        //查询时调用(grid,table,gridBox)
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_grid_query'] = function (ds, qpara, bp_seq) {
            if (ds.id && '${/parameter/@layout_code}_G_WARRANT_warrant_stock_hd_ds' == ds.id) {
                ds.setQueryParameter('project_id', '${/parameter/@project_id}');
            }
        };


        //生成出/入库单
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'warrant_stock_hd', 'G_WARRANT');
            var warrant_record = $(warrant_ds_id).getSelected();

            if (warrant_record.length != 1) {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showInfoMessage("提示", "请选择一条权证信息！");
                return;
            }

            var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'warrant_stock_hd', 'G_WARRANT');
            var record = $(ds_id).getCurrentRecord();
            var warrant_stock_id = record.get('warrant_stock_id');
            var project_id = record.get('project_id');
            var stock_type = record.get('stock_type');
            //模板类型代码
            var code = "WARRANT_STOCK_OUT";

            if(stock_type == 'TEMP_OUT_STOCK' || stock_type == 'LAST_OUT_STOCK'){
                code = 'WARRANT_STOCK_OUT';
            }else if(stock_type =='IN_STOCK' || stock_type == 'OUT_STOCK'){
                code = 'WARRANT_STOCK_IN';
            }

            var url = "${/request/@context_path}/warrant/create/download?templateCode=" + code + "&warrantStockId=" + warrant_stock_id + "&projectId=" + project_id;

            Leaf.Masker.mask(Ext.getBody());
            Leaf.request({
                url: url,
                success: function (res) {
                    Leaf.Masker.unmask(Ext.getBody());
                    var attachment_id = res.result.record[0].attachment_id;
                    down_url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + attachment_id;
                    location.href = down_url;
                    Leaf.SideBar.show({
                        msg: '生成成功',
                        duration: 2000
                    });
                },
                error: function () {
                    Leaf.Masker.unmask(Ext.getBody());
                },
                scope: this
            });



        };

        //回库
        window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            //debugger;
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'warrant_stock_hd', 'G_WARRANT');
            var warrant_record = $(warrant_ds_id).getSelected();

            if (warrant_record.length != 1) {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showInfoMessage("提示", "请至少选择一条权证信息！");
                return;
            }
            var warrant_status = '';
            var warrant_id_list = [];
            var project_id = '';
            var stock_type = '';

            for (var i = 0; i < warrant_record.length; i++) {
                if (i == 0) {
                    warrant_status = warrant_record[i].data.warrant_status;
                    project_id = warrant_record[i].data.project_id;
                    stock_type = warrant_record[i].data.stock_type;
                }

                warrant_id_list.push(warrant_record[i].data);
            }
            debugger;
            console.log(stock_type);

            console.log(warrant_status);

            if (stock_type != 'TEMP_OUT_STOCK' || warrant_status != '临时出库') {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                Leaf.showInfoMessage("提示", "仅临时出库的权证才能进行回库操作!");
                return;
            }

            var param = {};
            param['url_title'] = '创建出入库申请';
            param['function_code'] = 'WARRANT002';
            param['function_usage'] = 'MODIFY';
            param['warrant_id_list'] = JSON.stringify(warrant_id_list);
            param['project_id'] = project_id;
            param['warrant_status'] = warrant_status;


            var link_id = 'warrrant_stock_info_add_link';
            window['${/parameter/@bp_seq}${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            hls_doc_get_layout_code(param, link_id, null, 'WARRANT004');


        };

        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'applicant_number_open_detail';

            if (name == 'applicant_number' && value) {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id + '\');">' + value + '</a>';
            }

        }
        function applicant_number_open_detail(record_id, ds_id) {
            // var record = $(ds_id).findById(record_id);

            debugger;
            var param = $(ds_id).findById(record_id).data;

            param['url_title'] = '权证出入库明细';
            param['function_code'] = 'WARRANT003';
            param['function_usage'] = 'QUERY';
            param['modify_flag'] = 'N';

            var link_id = 'applicant_number_detail_link';

            hls_doc_get_layout_code(param, link_id , ds_id, 'WARRANT004');

        }



        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
