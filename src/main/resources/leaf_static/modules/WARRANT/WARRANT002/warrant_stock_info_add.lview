<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="warrant_stock_wfl_link" url="${/request/@context_path}/warrant/stock/submit/wfl"/>
        <a:link id="warrant_stock_detail_link"
                url="${/request/@context_path}/modules/WARRANT/WARRANT003/warrant_stock_info_detail.lview"/>
        <a:link id="${/parameter/@layout_code}_duration_window_id"
                url="${/request/@context_path}/modules/HLS/HLS300/hls_duration_modify.lview"/>

        <script><![CDATA[

        //更新时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_update'] = function(ds, record, name, value, old_value, bp_seq) {
            var warrant_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'warrant_stock_hd');
            if(ds.id == warrant_ds_id){
                if(name == 'stock_type'){
                    if(value == 'IN_STOCK'){
                        record.set('return_date' , '');
                        record.getField('return_date').setReadOnly(true);
                        record.getField('return_date').setRequired(false);
                        record.getField('hd_id').setRequired(false);
                        record.getField('hd_id_n').setRequired(false);
                    }else if(value == 'OUT_STOCK'){
                        record.set('return_date' , '');
                        record.getField('return_date').setReadOnly(true);
                        record.getField('return_date').setRequired(false);
                        record.getField('hd_id').setRequired(false);
                        record.getField('hd_id_n').setRequired(false);

                    }else if(value == 'TEMP_OUT_STOCK'){
                        record.set('return_date' , '');
                        record.getField('return_date').setReadOnly(false);
                        record.getField('return_date').setRequired(true);
                        record.getField('hd_id').setRequired(false);
                        record.getField('hd_id_n').setRequired(false);

                    }else if(value == 'LAST_OUT_STOCK'){
                        record.getField('return_date').setReadOnly(true);
                        record.getField('return_date').setRequired(false);
                        record.getField('hd_id').setRequired(true);
                        record.getField('hd_id_n').setRequired(true);

                    }

                }
            }

        }

        //提交审批
        window['${/parameter/@layout_code}_user_button1_layout_dynamic_click'] = function () {


            var warrant_id_list = JSON.parse('${/parameter/@warrant_id_list}');
            var applicant_ds_id =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'warrant_stock_hd' , 'F_WARRANT');
            var applicant_record = $(applicant_ds_id).getCurrentRecord();
            var applicant_date = new Date();
            applicant_record.set('applicant_id',  '${/session/@userId}' );
            applicant_record.set('applicant_employ',  '${/session/@employeeId}' );
            applicant_record.set('applicant_unit',  '${/session/@unitId}' );

            applicant_record.set('applicant_date',  applicant_date );
            applicant_record.set('project_id',  '${/parameter/@project_id}' );

            var warrant_status =  '${/parameter/@warrant_status}' ;

            if($(applicant_ds_id).validate()) {
                window['${/parameter/@bp_seq}${/parameter/@layout_code}_lock_layout_dynamic_window']();

                if(warrant_status == '未入库'){
                     if(applicant_record.get('stock_type') != 'IN_STOCK'){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" , "未入库的权证仅能进行入库操作！");
                        return ;
                     }
                }

                if(warrant_status == '临时出库'){
                    if(applicant_record.get('stock_type') != 'OUT_STOCK'){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" , "临时出库的权证仅能进行回库操作！");
                        return ;
                    }
                }

                if(warrant_status == '已入库'){
                    if(applicant_record.get('stock_type') != 'TEMP_OUT_STOCK' && applicant_record.get('stock_type') != 'LAST_OUT_STOCK'){
                        window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        Leaf.showInfoMessage("提示" , "已入库的权证仅能进行临时出库和永久出库操作！");
                        return ;
                    }
                }

                if(warrant_status == '永久出库'){
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    Leaf.showInfoMessage("提示" , "永久出库的权证不可进行操作！");
                    return ;
                }


                new Leaf.showConfirm("提示", "确认提交申请么？", function okFun() {

                    Leaf.request({
                        url: $('warrant_stock_wfl_link').getUrl(),
                        para: {
                            hlsWarrantStockLnList: warrant_id_list,
                            hlsWarrantStockHd: applicant_record.data
                        },

                        success: function (res) {

                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            Leaf.showMessage('提示', '提交审批成功!');

                        },
                        failure: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        error: function () {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                        },
                        scope: this
                    });

                }, function cancel() {
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                }, 200, 100);

            }

        };


        //超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            if(name == 'project_id_duration'){

                var link_function = 'duration_number_open';

                return '<a style="display: inline-block;background: #5A7FFF;color: #fff;width: 120px;text-align: center;position: absolute;height: 26px;margin-top: -1px;left: 330px;" href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id +   '\',\'' + record.get('duration_type') +    '\',\'' + record.get('project_id_duration') +   '\');">' + '流程查看' + '</a>';

            }

        }


        function duration_number_open(record_id, ds_id ,duration_type , project_id_duration ) {

            if(duration_type == ''  || duration_type == 'undefined'){
                Leaf.showInfoMessage("提示" , "请先选择前置流程!");
                return ;
            }

            var record = $(ds_id).findById(record_id);
            var param = record.data;
            var duration_type = record.get('duration_type');
            param['url_title'] = '项目变更审批事项工作联系单';
            param['function_code'] = get_function_code(duration_type);
            param['winid'] = 'duration_detail_open_id';
            param['function_usage'] = 'QUERY';
            param['project_id'] = project_id_duration;


            hls_doc_get_layout_code(param, '${/parameter/@layout_code}_duration_window_id', ds_id, 'WARRANT002');

        }


        function get_function_code(duration_type) {
            /**
             PROJECT           项目变更审批事项工作联系单
             TERMINATE         正常结清
             ET                提前结清
             DEPOSIT           保证金释放、退还
             RELEASE           解押
             REPURCHASE        回购
             PREPAYMENT        提前还款
             SPECIAL           特殊事项
             */
            if (duration_type == 'PROJECT') {
                return 'HLS300F2';
            } else if (duration_type == 'RELEASE') {
                return 'HLS300F3';
            } else if (duration_type == 'SPECIAL') {
                return 'HLS300F4';
            } else if (duration_type == 'DEPOSIT') {
                return 'HLS300F5';
            } else if (duration_type == 'REPURCHASE') {
                return 'HLS300F7';
            } else if (duration_type == 'TERMINATE') {
                return 'HLS300F8';
            } else if (duration_type == 'ET') {
                return 'HLS300F9';
            }else if (duration_type == 'PREPAYMENT') {
                return 'HLS300F12';
            }
        }




        //测试明细页面
        /*window['${/parameter/@layout_code}_user_button2_layout_dynamic_click'] = function () {

            var param = {};
            param['url_title'] = '权证出入库明细';
            param['function_code'] = 'WARRANT003';
            param['function_usage'] = 'MODIFY';

            var link_id = 'warrant_stock_detail_link';
            hls_doc_get_layout_code(param, link_id, null , 'WARRANT002');

        };*/

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
