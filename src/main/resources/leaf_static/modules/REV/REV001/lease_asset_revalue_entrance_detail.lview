<?xml version="1.0" encoding="UTF-8"?>

<a:screen xmlns:a="http://www.leaf-framework.org/application" customizationEnabled="true" dynamiccreateenabled="true"
          trace="true">
    <a:view>
        <a:link id="lease_info_detaill_id"
                url="${/request/@context_path}/modules/LEASE/LEASE001/lease_item_modify_detail.lview"/>
        <script><![CDATA[


        //提交审批SUBMIT_APPROVAL
        window['${/parameter/@layout_code}_submit_approval_layout_dynamic_click'] = function (){
            debugger;
            window['${/parameter/@layout_code}_lock_layout_dynamic_window']();
            var ds_id =  get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lease_asset_hd');
            var con_contract_cashflow_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lease_asset_ln' , 'G_DETAIL');

            var dsRecord = $(ds_id).getAll();
            if(dsRecord.length == 1){
                var contractRecord= dsRecord[0].data;

                //避免栈溢出ASSET_HD_ID
                contractRecord[con_contract_cashflow_id.replace('_ds','')]=undefined;
                var asset_hd_id = contractRecord.asset_hd_id;
                if(contractRecord.asset_status!=='APPROVING' && contractRecord.asset_status!=='APPROVED') {
                    Leaf.request({
                        url: "${/request/@context_path}/lease/asset/hd/incept/sumbit",
                        para: {
                            asset_hd_id:asset_hd_id
                        },
                        success: function (r) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            $L.showInfoMessage("提示", "提交成功,已进入工作流审批!", function () {
                                $('${/parameter/@winid}').close();

                            });
                        },
                        error: function (r) {
                            // $L.Masker.unmask(document.body);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            // Leaf.showMessage("提示", r.error.message, null);
                        },
                        scope: this
                    });
                }else{
                    window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                    $L.showInfoMessage("提示", "正在审批中。。。。", function () {
                        $('${/parameter/@winid}').close();

                    });
                }



            }
        }

