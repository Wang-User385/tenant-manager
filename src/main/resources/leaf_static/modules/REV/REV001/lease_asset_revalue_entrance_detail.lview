        //创建加载时调用
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_on_layout_dynamic_form_add_and_load'] = function (ds, record, config_records, bp_seq){
            var pledge_ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lease_asset_hd');


            var check_flag = true;
            var asset_number =$(pledge_ds_id).getCurrentRecord().get('asset_number');
            var document_category = 'REV_ASSET_NUMBER';
            var document_type = 'ASSET_NUMBER';
            var business_type ='ASSET_NUMBER';
            debugger;

            if(pledge_ds_id!="" && $(pledge_ds_id).getCurrentRecord()!=null){
                //MODIFY_PERSON  new Date() MODIFY_DATE ASSET_STATUS
                $(pledge_ds_id).getCurrentRecord().set('modify_person', '${/session/@employeeId}');
                $(pledge_ds_id).getCurrentRecord().set('modify_person_n', '${/session/@employeeName}');
                $(pledge_ds_id).getCurrentRecord().set('modify_unit_n', '${/session/@unitName}');
               /* if(typeof ($(pledge_ds_id).getCurrentRecord().get('asset_status'))=='undefined'|| 'undefined' == ($(pledge_ds_id).getCurrentRecord().get('asset_status'))){
                    $(pledge_ds_id).getCurrentRecord().set('asset_status', 'NEW');
                }*/
                if(typeof ($(pledge_ds_id).getCurrentRecord().get('modify_date'))=='undefined'|| 'undefined' == ($(pledge_ds_id).getCurrentRecord().get('modify_date'))){
                    $(pledge_ds_id).getCurrentRecord().set('modify_date', new Date());
                }


               console.log('${/session/@unitId}')


                $(pledge_ds_id).getCurrentRecord().set('modify_unit', '${/session/@unitId}');

                if(!asset_number){
                    Leaf.request({
                        url: "${/request/@context_path}/common/coding/getCodeValue?documentCategory=" + document_category + "&documentType=" + document_type + "&businessType=" + business_type,
                        success: function (res) {
                            $(pledge_ds_id).getCurrentRecord().set('asset_number', res.result.record[0]);
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = true;
                            // $(pledge_ds_id).query({
                            //     asset_number:res.result.record[0]
                            // });
                        },
                        error: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        failure: function (res) {
                            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
                            check_flag = false;
                        },
                        sync: true,
                        scope: this
                    });
                }


            }



            return check_flag;
        }


        // 超链接渲染
        window['${/parameter/@bp_seq}${/parameter/@layout_code}_dynamic_link_renderer'] = function (value, record, name, config_record, bp_seq) {
            var link_function = 'lease001_detail_open';
            //debugger;





            window['${/parameter/@bp_seq}${/parameter/@layout_code}_hls_link_render_record'][record.id + '---' + name] = record;
            if (name === 'asset_number') {
                return '<a href="javascript:window[\'' + link_function + '\'](\'' + record.id + '\',\'' + record.ds.id +  '\',\'' + record.get('contract_status') +  '\');">' + value + '</a>';
            }

            if (name == 'upload') {

                return '<a href="javascript:approval_upload_file(\'' + record.id + '\',\'' + record.get('asset_ln_id') + '\')">附件上传</a>';
            }
            //FILE_NAME file_name

            if (name == 'file_name' && value) {
                var str = value.split(',');
                var url = '' ;
                for(var i = 0;i < str.length;i++){
                    debugger;
                    var temp;
                    if(record.get('attachment_id')!='undefined'){
                         temp = record.get('attachment_id')
                    }

                    url = url + '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + temp +'">' + str[i] +' ; </a>';
                }
                return url;
                // return '<a href="${/request/@context_path}/fnd/attachment/download?attachment_id=' + record.get('asset_ln_id') + '">' + value + '</a>';
            }


        };

        //ASSET_LN_ID
        window['approval_upload_file'] = function (record_id, asset_ln_id) {
            if (typeof (asset_ln_id) === 'undefined' || 'undefined' === asset_ln_id) {
                Leaf.showMessage('提示', '请先保存!', null);
                return;
            }
            var url;
            if ('${/parameter/@function_usage}' == 'QUERY') {
                url = '${/request/@context_path}/downloadFile.lview';
            } else {
                url = '${/request/@context_path}/uploadFile.lview';
            }
            var win = new Leaf.Window({
                id: 'prj316wfl_open_attachment_winid',
                url: url,
                params: {
                    'header_id': asset_ln_id,
                    'table_name': 'lease_asset_ln',
                    winid: 'prj320_open_attachment_winid',
                    function_usage: '${/parameter/@function_usage}'
                },
                title: '文件上传下载',
                width: 800,
                height: 475
            });
            win.on('close', function () {
                var ds_id = get_dsid_by_basetable(window['${/parameter/@layout_code}_layoutDataSetList'], 'lease_asset_ln');
                $(ds_id).query();
            });
        };


        window['${/parameter/@layout_code}_on_layout_dynamic_submitsuccess'] = function(ds, record, res, bp_seq) {
            window['${/parameter/@layout_code}_unlock_layout_dynamic_window']();
            console.log(1234)

        };

        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
