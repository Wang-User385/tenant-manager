<?xml version="1.0" encoding="UTF-8"?>
<a:screen xmlns:a="http://www.leaf-framework.org/application" trace="true">
    <a:init-procedure/>
    <a:view>
        <style>
            body {
                height: 400px;
                width: 1000px;
            }
        </style>
        <script type="text/javascript"
                src="${/request/@context_path}/resources/js/CONT/CON_CONTRACT/wfl-dymanic-page-chooser.js"></script>
        <a:link id="lease_asset_revalue_wfl_link"
                url="${/request/@context_path}/modules/REV/REV001/lease_asset_revalue_wfl.lview"/>
      <!--leaf_static/modules/REV/REV001/lease_asset_revalue_entrance_detail.lview-->
       <!-- <a:link id="lease_asset_revalue_wfl_link"
                url="${/request/@context_path}/modules/REV/REV001/lease_asset_revalue_entrance_detail.lview"/>-->
        <script><![CDATA[


        var businessKey = '${/parameter/@businessKey}';
        var param = parent.currentTaskInfo.execution_variables;

        // console.log(param);asset_hd_id
        //modules/REV/REV001/lease_asset_revalue_approval.lview

        var bill = parent.currentTaskInfo.execution_variables.filter(function (o) {
            return o.name == "assetHdId";
        });
        var assetHdId = bill[0].value;
      var  function_code = "REV001F2";
      var  function_usage='QUERY';

        var pageChooser = new PageChooser({
            url: $('lease_asset_revalue_wfl_link').getUrl(),
            function_code: function_code,
            context_path: '${/request/@context_path}',
            opt: {
                businessKey : businessKey,
                asset_hd_id: assetHdId,
                maintain_type: 'READONLY',
                function_code: function_code,
                function_usage: function_usage

            },
            success: function (realUrl) {
                location.href = realUrl;
            }
        });
        ]]></script>
        <a:screen-include screen="modules/COMMON/LAYOUT/hls_common_get_layout_code.lview"/>
    </a:view>
</a:screen>
