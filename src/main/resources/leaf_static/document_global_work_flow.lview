                            appendHtml += '<div class="tab">';
                            appendHtml += '<div class="con-right-body-tab div-rate-30 OOb3b3b-color">合同编号</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-10">时间</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-10">用户</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-12">放款金额</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-10">状态</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-13 OOb3b3b-color">放款状态</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-15">流程明细</div></div>';
                        }
                        appendHtml += '<div class="tab">';
                        appendHtml += '<div class="con-right-body-tab div-rate-30 OOb3b3b-color cursor" onclick="addConFunction(\'' + datas[i].contractId + '\')">' + datas[i].contractNumber + '</div>';
                        appendHtml += '<div class="con-right-body-tab div-rate-10">' + (timeFormat(datas[i].applyPayDate) || '--') + '</div>';
                        appendHtml += '<div class="con-right-body-tab div-rate-10">' + (datas[i].taskUserName || '--') + '</div>';
                        appendHtml += '<div class="con-right-body-tab div-rate-12">' + Leaf.formatMoney(datas[i].amountPaid || 0) + '</div>';
                        appendHtml += '<div class="con-right-body-tab div-rate-10">' + (datas[i].currentStatus || '--') + '</div>';
                        appendHtml += '<div class="con-right-body-tab div-rate-13 OOb3b3b-color">' + (datas[i].paymentFlagName || '--') + '</div>';
                        // appendHtml += '<div class="con-right-body-tab div-rate-13 OOb3b3b-color">' + (datas[i].paymentFlagName || '--') + '</div>';
                        if(!!datas[i].processInstanceId ){
                            appendHtml += '<div onclick="goToProcess(\'' + datas[i].processInstanceId + '\',\'CON_CONTRACT\',\'' + datas[i].contractId + '\')" class="con-right-body-tab div-rate-15 OOb3b3b-color cursor">查看流程图明细>></div></div>';
                        }else{
                            appendHtml += '<div class="con-right-body-tab div-rate-15">暂无流程明细</div></div>';
                        }
                    }
                    jQuery("#con-pay-info-append")[0].innerHTML = topHtml + appendHtml;
                } else {
                    jQuery("#con-pay-info-append")[0].innerHTML = topHtml + noDateHtml;
                }
            }
        });
        getTaskLine();
        //起租动态
        function getInceptNotice(arr) {
            var inceptIds = arr.join(",")
            jQuery.ajax({
                type: 'GET',
                url: "${/request/@context_path}/query/notice/by/inceptId",
                data: {
                    contractInceptId: inceptIds
                },
                inceptIds:inceptIds,
                inceptIdArr:arr,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    var inceptsReqMap = {};
                    if (!!datas && datas.success && datas.rows.length>0) {
                        datas = datas.rows;
                        for (var i = 0; i < datas.length; i++) {
                            var inceptReqId = datas[i].documentId;
                            if(!!inceptsReqMap[inceptReqId]){
                                inceptsReqMap[inceptReqId].push(datas[i]);
                            }else{
                                inceptsReqMap[inceptReqId] = [datas[i]];
                            }
                        }
                        for( id in inceptsReqMap ){
                            var targetDiv = jQuery('div[data-incept-req="' + id + '"]');
                            var conIncHtml = targetDiv.html(),_html = '';
                            targetDiv.html("");
                            for(var i=0;i<inceptsReqMap[id].length;i++){
                                var noticeData = inceptsReqMap[id][i];
                                _html += '<div class="center-body-dynamic-time">' + (timeFormat(noticeData.dateTime) || '--') + '</div><div title="' + noticeData.message + '" class="center-body-dynamic-title">' + noticeData.message + '</div>';
                            }
                            if (!inceptsReqMap[id] || inceptsReqMap[id].length == 0) {
                                targetDiv.html(conIncHtml + noDataHtml);
                                targetDiv.find(".total-prj-div").hide();
                            } else {
                                targetDiv.html(conIncHtml + _html);
                                targetDiv.find(".total-prj-div").hide();
                            }
                        }
                    }
                }
            });
        }
        //签约动态
        function getConSignNotice(arr) {
            var contractIds = arr.join(",");
            jQuery.ajax({
                type: 'GET',
                url: "${/request/@context_path}/query/signnotice/by/contractId",
                data: {
                    contractId: contractIds
                },
                contractIds:contractIds,
                contractIdArr:arr,
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    var contractsMap = {};
                    this.contractIdArr.forEach(function(id){
                        contractsMap[id] = [];
                    });
                    if (!!datas && datas.success && datas.rows.length>0) {
                        datas = datas.rows;
                        for (var i = 0; i < datas.length; i++) {
                            var contractId = datas[i].contractId;
                            contractsMap[contractId].push(datas[i]);
                        }
                        for( id in contractsMap ){
                            var targetDiv = jQuery('div[data-con="' + id + '"]');
                            var conSignHtml = targetDiv.html(),_html = '';
                            targetDiv.html("");
                            for(var i=0;i<contractsMap[id].length;i++){
                                var noticeData = contractsMap[id][i];
                                _html += '<div class="center-body-dynamic-time">' + (timeFormat(noticeData.dateTime) || '--') + '</div><div title="' + noticeData.message + '" class="center-body-dynamic-title">' + noticeData.message + '</div>';
                            }
                            if (contractsMap[id].length == 0) {
                                targetDiv.html(conSignHtml + noDataHtml);
                                targetDiv.find(".total-prj-div").hide();
                            } else {
                                targetDiv.html(conSignHtml + _html);
                                targetDiv.find(".total-prj-div").hide();
                            }
                        }
                    }else{
                        this.contractIdArr.forEach(function(id){
                            var targetDiv = jQuery('div[data-con="' + id + '"]');
                            var conSignHtml = targetDiv.html();
                            targetDiv.html("");
                            targetDiv.html(conSignHtml + noDataHtml);
                            targetDiv.find(".total-prj-div").hide();
                        });
                    }
                }
            });
        }
        /* 时间格式转换 */
        function timeFormat(data) {
            if (!data) return false;
            return (/\d{4}-\d{1,2}-\d{1,2}/g).exec(data);
        }
        function downShow(this_node) {
//        var cur = this_node.parentElement.parentElement
//        var eqId = !cur.nextElementSibling ? cur.previousElementSibling.id : cur.nextElementSibling.id;
//        if(currntShowId == ''){
//            currntShowId = !cur.nextElementSibling ? cur.previousElementSibling.id : cur.nextElementSibling.id;
//            jQuery("#"+currntShowId)[0].style.visibility="visible";
//        }else {
//            if(currntShowId == eqId){
//                jQuery("#"+currntShowId)[0].style.visibility="hidden";
//            }else {
//                jQuery("#"+currntShowId)[0].style.visibility="hidden";
//                currntShowId = !cur.nextElementSibling ? cur.previousElementSibling.id : cur.nextElementSibling.id;
//                jQuery("#"+currntShowId)[0].style.visibility="visible";
//            }
//        }
        }
        //计算两个时间之间相差的秒数
        function DateDiff(sDate1, sDate2) {    //sDate1和sDate2是2017-08-21格式
            return parseFloat(Math.abs(new Date(sDate1) - new Date(sDate2)) / 1000);    //把相差的毫秒数转换为秒
        }
        function goToProcess(id, documentcategory, documentid) {
            var params = {
                processInstanceId: id,
                documentcategory: documentcategory,
                documentid: documentid
            };
            new Leaf.Window({
                id: "addDialog",
                params: params,
                url: '${/request/@context_path}/taskDetail.lview',
                title: "流程明细",
                width: 670,
                side: 'right',
                draggable: true
            });
        }
        function getTaskLine() {
            jQuery.ajax({
                type: 'GET',
                url: "${/request/@context_path}/query/prj/task",
                data: {
                    contractId: contractId,
                    projectId: projectId
                },
                contentType: "application/json; charset=utf-8",
                success: function (datas) {
                    if (datas && datas.rows) {
                        var container = jQuery(".bill-process-view-photo");
                        //构造项目流程
                        var dis = createProject(datas, container);
                        //构造合同流程
                        if (datas.rows[0].contractIds) {
                            var arrId = datas.rows[0].contractIds.split(",");
                            createContract(arrId, dis, container);
                        }
                    }
                }
            })
        }
        function createContract(contractIds, dis, container) {
            var leftExtrDis = 20;
            var totleHeight = 200 * contractIds.length;
            var cotnractNode = jQuery('<div class="prj-circle global-font-size14" style="background-color: #FB6E52">合同</div>');
            cotnractNode.appendTo(container);
            cotnractNode.css({
                left: dis + "px",
                top: (totleHeight / 2 - 18) + "px"
            });
            dis = dis + 36;
            var leftLine = jQuery("<div class='start-line'></div>");
            leftLine.css({
                width: leftExtrDis + "px",
                left: dis + "px",
                top: (totleHeight / 2 - 10) + "px"
            });
            leftLine.appendTo(container);
            dis = dis + leftExtrDis;
            var yline = jQuery("<div class='y-line'></div>");
            yline.css({
                top: "100px",
                left: dis + "px",
                height: (totleHeight - 200) + "px"
            });
            dis = dis + 1;
            yline.appendTo(container);
            for (var i = 0; i < contractIds.length; i++) {
                var top = 100 + 200 * i;
                (function (contractIds, top, dis) {
                    jQuery.ajax({
                        type: 'GET',
                        url: "${/request/@context_path}/query/con/task",
                        data: {
                            contractId: contractIds[i],
                        },
                        contentType: "application/json; charset=utf-8",
                        success: function (datas) {
                            createContractNode(top, dis, datas);
                        }
                    })
                })(contractIds, top, dis);

            }
        }
        function createContractNode(topDis, dis, datas) {
            datas = datas.rows;
            var count = datas.length;
            var container = jQuery(".bill-process-view-photo");
            var totalDis = (count > 15 ) ? ((count-5)*65) : 500,nodeList = [];
            // var totalDis =500,nodeList = [];
            var diffTime = datas.length == 1 ? totalDis :DateDiff(datas[datas.length - 1].createDate, datas[0].createDate);
            var lineTo = jQuery('<div class="start-line"></div>');
            lineTo.css({
                width: (totalDis + 100 ) + "px",
                height: "1px",
                left: dis + "px",
                top: topDis + "px"
            });
            lineTo.appendTo(container);
            for (var i = 0; i < datas.length; i++) {
                var time = i==0? 1 :DateDiff(datas[i].createDate, datas[0].createDate);
                var className = "", top;
                var leftDis;
                if ((i % 2) == 0) {
                    className = "upnode-bottom-left";
                    top = (topDis - 84) + "px";
                } else {
                    className = "down-top-left";
                    top = (topDis) + "px";
                }
                leftDis = ((time) / diffTime) * totalDis + 50;
                leftDis = dis + leftDis;
                var node = jQuery('<div class="task_node"></div>');
                node.css({
                    top: top,
                    left: leftDis + "px"
                });

                var line_div = jQuery('<div class="' + className + '"></div>');
                var img = jQuery('<img style="cursor: pointer;" src="${/request/@context_path}/resources/images/RPT/u73.png"/>');
                img.appendTo(line_div);
                var node_span;
                if (className == 'upnode-bottom-left') {
                    node_span = jQuery('<div><div>' + Leaf.formatDate(new Date(datas[i].createDate)) + '</div><div>' + datas[i].description + '</div></div>');
                    node_span.appendTo(node);
                    line_div.appendTo(node);
                } else {
                    node_span = jQuery('<div><div>' + datas[i].description + '</div><div>' +  Leaf.formatDate(new Date(datas[i].createDate)) + '</div></div>');
                    line_div.appendTo(node);
                    node_span.appendTo(node);
                    node_span.css({
                        "margin-top": "15px"
                    });
                }
                img[0].node_span = node_span;
                img.click(function () {
                    if (this.node_span.css("visibility") == 'hidden') {
                        this.node_span.css("visibility", "visible");
                    } else {
                        this.node_span.css("visibility", "hidden");
                    }
                });
                nodeList.push(node);
            }

            //最小间距控制  防止节点重叠
            var lastDis = null,
                minSpace = 90;  //最小间距
            for(var i=0;i<nodeList.length;i++){
                var node = nodeList[i],left = parseInt(node.css("left"));
                if(!!lastDis){
                    if(left - lastDis < minSpace){
                        node.css("left",lastDis + minSpace)
                        left = lastDis + minSpace;
                    }
                }
                lastDis = left;
            }
            //溢出判断
            var halfNodeWidth = 30,
                leftPrjDis = dis,
                maxDis = parseInt(nodeList[nodeList.length-1].css("left")),
                overFlowDis = parseInt(maxDis) + halfNodeWidth - (totalDis + leftPrjDis)
            if(overFlowDis > 0){
                //整体等比例缩小
                for(var i=0;i<nodeList.length;i++){
                    var curLeft = parseInt(nodeList[i].css("left"));
                    var newLeft = (curLeft- leftPrjDis)/(maxDis- leftPrjDis)*totalDis+leftPrjDis;
                    nodeList[i].css("left",newLeft + "px");
                }
            }
            for(var i=0;i<nodeList.length;i++){
                nodeList[i].appendTo(container);
            }

            var endNode = jQuery('<div class="end-node"></div>');
            endNode.appendTo(container);
            endNode.css({
                left: (dis + totalDis + 100 ) + 'px',
                top: (topDis - 5) + 'px'
            });
        }
        function createProject(datas, container) {
            var prjDistance = 300;
            if (datas && datas.rows) {
                var contractIds = [];
                if (datas.rows[0].contractIds) {
                    contractIds = datas.rows[0].contractIds.split(",");
                }
                var distance = 10;
                var totalHeight = 200 * contractIds.length == 0 ? 200 : 200 * contractIds.length;
                container.height(totalHeight);
                var startNode = jQuery('<div class="start-node"></div>');
                startNode.appendTo(container);
                startNode.css({
                    top: (totalHeight / 2 - 5) + "px"
                });
                var startLine = jQuery('<div class="start-line"></div>');
                startLine.appendTo(container);
                startLine.css({
                    top: (totalHeight / 2 - 10) + "px",
                    left: distance + "px"
                });
                distance = distance + 10;
                var projectNode = jQuery('<div class="prj-circle global-font-size14">项目</div>');
                projectNode.appendTo(container);
                projectNode.css({
                    top: (totalHeight / 2 - 18) + "px",
                    left: distance + "px"
                });
                distance = distance + 36;
                var lineToContract = jQuery("<div class='start-line'></div>");
                lineToContract.appendTo(container);
                lineToContract.css({
                    width: "400px",
                    left: distance + "px",
                    top: (totalHeight / 2 - 10) + "px"
                });

                var datas = datas.rows;
                var diffTime = DateDiff(datas[datas.length - 1].createDate, datas[0].createDate);
                var dis = 0,nodeList = [];
                for (var i = 0; i < datas.length; i++) {
                    var time = DateDiff(datas[i].createDate, datas[0].createDate);
                    var className = "", top;
                    if ((i % 2) == 0) {
                        className = "upnode-bottom-left";
                        top = (totalHeight / 2 - 84) + "px";
                    } else {
                        className = "down-top-left";
                        top = (totalHeight / 2) + "px";
                    }
                    if (isNaN((time) / diffTime)) {
                        dis = 20;
                    } else {
                        dis = ((time) / diffTime) * prjDistance + 20;
                    }
                    dis = distance + dis;
                    var node = jQuery('<div class="task_node"></div>');
                    node.css({
                        top: top,
                        left: dis + "px"
                    });


                    var line_div = jQuery('<div class="' + className + '"></div>');
                    var img = jQuery('<img style="cursor: pointer;" src="${/request/@context_path}/resources/images/RPT/u73.png"/>');
                    img.appendTo(line_div);
                    var node_span;
                    if (className == 'upnode-bottom-left') {
                        node_span = jQuery('<div><div>' + Leaf.formatDate(new Date(datas[i].createDate)) + '</div><div>' + datas[i].description + '</div></div>');
                        node_span.appendTo(node);
                        line_div.appendTo(node);
                    } else {
                        node_span = jQuery('<div><div>' + datas[i].description + '</div><div>' + Leaf.formatDate(new Date(datas[i].createDate)) + '</div></div>');
                        line_div.appendTo(node);
                        node_span.appendTo(node);
                        node_span.css({
                            "margin-top": "15px"
                        });
                    }
                    img[0].node_span = node_span;
                    img.click(function () {
                        if (this.node_span.css("visibility") == 'visible') {
                            this.node_span.css("visibility", "hidden");
                        } else {
                            this.node_span.css("visibility", "visible");
                        }
                    });
                    // node.appendTo(container);
                    nodeList.push(node);
                }

                //最小间距控制  防止节点重叠
                var lastDis = null,
                    minSpace = 60;  //最小间距
                for(var i=0;i<nodeList.length;i++){
                    var node = nodeList[i],left = parseInt(node.css("left"));
                    if(!!lastDis){
                        if(left - lastDis < minSpace){
                            node.css("left",lastDis + minSpace)
                            left = lastDis + minSpace;
                        }
                    }
                    lastDis = left;
                }
                //溢出判断
                var halfNodeWidth = 30,
                    leftDis = distance,
                    maxDis = parseInt(nodeList[nodeList.length-1].css("left")),
                    overFlowDis = parseInt(maxDis) + halfNodeWidth - (prjDistance + leftDis)
                if(overFlowDis > 0){
                    //整体等比例缩小
                    for(var i=0;i<nodeList.length;i++){
                        var curLeft = parseInt(nodeList[i].css("left"));
                        var newLeft = (curLeft- leftDis)/(maxDis- leftDis)*prjDistance+leftDis;
                        nodeList[i].css("left",newLeft + "px");
                    }
                }
                for(var i=0;i<nodeList.length;i++){
                    nodeList[i].appendTo(container);
                }

                return distance + 400;
            }
        }
        //合同弹窗
        function addContractFunction(cid) {
            var param = {};

            param['contract_id'] = cid;
            param['url_title'] = '合同明细';
            param['function_code'] = 'CONT301F1';
            param['winid'] = 'con_contract_detail_winid';

            param['hidden_button_code'] = ['save'];
            param.maintain_type = 'READONLY';
            param.function_usage = 'QUERY';

            hls_doc_get_layout_code(param, 'con_contract_detail_id', null, 'CONT301')
        }
        //合同变更弹窗
        function addContractChangeFunction(cid,ccid,cType,bpClass) {
            var change_type = {
                PRE: {
                    function_code: 'CONT302F1',
                    url_title: '合同变更-租前变更'
                },
                TENANT: {
                    function_code: 'CONT302F4',
                    url_title: '合同变更-承租人变更'
                },
                LEASE_ITEM: {
                    function_code: 'CONT302F3',
                    url_title: '合同变更-租赁物变更'
                },
                RESCHEDULE: {
                    function_code: 'CONT302F5',
                    url_title: '合同变更-支付期平移'
                },
                EXTENSION: {
                    function_code: 'CONT302F6',
                    url_title: '合同变更-缩期展期'
                },
                PENALTY_EXEMPT: {
                    function_code: 'CONT302F8',
                    url_title: '合同变更-罚息变更'
                },
                RECEIPT_ACCOUNT: {
                    function_code: 'CONT302F9',
                    url_title: '合同变更-回款账户变更'
                },
                PREPAYMENT: {
                    function_code: 'CONT302F7',
                    url_title: '合同变更-提前结清'
                },
                OTHER:{
                    function_code: 'CONT302F12',
                    url_title: '合同变更-其它'
                }
            };

            var param = {};
            param['contract_id'] = cid;
            param['change_req_id'] = ccid;
            param['url_title'] = '合同变更详情';
            param['function_code'] = change_type[cType.toUpperCase()].function_code;
            param['winid'] = 'con_contract_change_detail_winid';
            param['document_category'] = 'CONTRACT_CHANGE';
            param['document_type'] = 'STD';

            param['winid'] = 'con_contract_change_' + cType.toLowerCase() + '_window_id';
            var link_id = 'con_contract_change_' + cType.toLowerCase() + '_link_id';

            if (!!cType && cType.toUpperCase() === 'TENANT' && !!bpClass) {
                param['function_code'] = param['function_code'] + bpClass.toUpperCase();
                link_id = 'con_contract_change_tenant_' + bpClass.toLowerCase() + '_link_id';
            }

            param['hidden_button_code'] = ['save'];
            param.maintain_type = 'READONLY';
            param.function_usage = 'QUERY';

            hls_doc_get_layout_code(param, link_id, null, 'CONT302')
        }
        //项目弹窗
        function addPrjFunction() {
            var param = prjDataSource;
            var function_code = 'PRJ316F2Q';
            console.log(param);
            debugger;
            param['project_id'] = projectId;
            param['url_title'] = '项目明细';
            param['winid'] = 'project_modify_winid';
            param['function_code'] = function_code;
            var project_status = param.projectStatus;
            param['maintain_type'] = 'READONLY';
            param['function_usage'] = 'QUERY';

            var credit_flag = param.CREDIT_FLAG;
            if(credit_flag == 'Y'){
                function_code = 'PRJ316F2_CREDIT';
                param['function_code'] = 'PRJ316F2_CREDIT';
                hls_doc_get_layout_code(param, 'prj316_project_modify_credit_id', null, function_code);
            }else{
                hls_doc_get_layout_code(param, 'prj316_project_modify_id', null, function_code);
            }

        }

        //合同弹窗2
        function addConFunction(contractId) {
            var param = {};
            debugger;
            for(let i in contractList){
                if (contractList[i].contractId == contractId){
                    param = contractList[i];
                    break;
                }
            }
            param['project_id'] = param.projectId;
            console.log(param);
            if (param.creditFlag == 'N') {
                param['url_title'] = '合同详细页面';
                param['function_code'] = 'CONT301F1';
                param['winid'] = 'prj_credit_contract_create_win_id';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                hls_doc_get_layout_code(param, 'con_contract_detail_id', null, 'PRJ350F1');
            }else {
                param['url_title'] = '合同详细页面';
                param['function_code'] = 'SIG001F1';
                param['maintain_type'] = 'READONLY';
                param['function_usage'] = 'QUERY';
                hls_doc_get_layout_code(param, 'sig001_project_modify_id', null, 'SIG001F1');
            }
        }

        ]]></script>
