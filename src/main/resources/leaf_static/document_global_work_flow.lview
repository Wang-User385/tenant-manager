            }
            .bill-process-view-photo {
                width: 100%;
                height: 200px;
                position: relative;
                overflow-x: auto;
            }
            .bill-info-node-left-right img {
                width: 25px;
                height: 25px;
                margin-top: 25px;
            }
            .prj-div {
                width: 100%;
                height: 165px;
                margin-top: 20px;
            }
            .con-manage {
                width: 100%;
                height: auto;
                margin-top: 20px;
                overflow: hidden;
            }
            .prj-title-icon {
                width: 2%;
                height: 117px;
                float: left;
                padding-top: 35px;
                text-align: center;
                margin-top: 22px;
                color: white;
            }
            .prj-content-div {
                width: 98%;
                height: 100%;
                float: left;
                background-color: white;
            }
            .prj-left-content-div {
                width: 33%;
                height: 100%;
                border-right: 1px solid #cbcbcb;
                float: left;
                padding-top: 20px;
                padding-left: 30px
            }
            .prj-center-content-div {
                width: 67%;
                height: 100%;
                border-right: 5px solid #cbcbcb;
                float: left;
                padding-top: 5px;
                padding-left: 20px;
                overflow-y: auto;
            }
            .prj-right-content-div {
                width: 0%;
                height: 100%;
                float: left;
                padding-top: 20px;
                padding-left: 10px
            }
            .rigth-conetent-div {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                width: 70%;
                float: left;
                height: 20%;
                line-height: 32px;
                color: black
            }
            .left-conetent-div {
                width: 30%;
                float: left;
                height: 20%;
                line-height: 32px
            }
            .con-right-content-div {
                width: 66%;
                height: 100%;
                float: left;
                padding-top: 20px;
                padding-left: 10px;
                overflow:auto;
            }
            .con-line-content-div {
                width: 100%;
                height: 100%;
                float: left;
                padding-top: 20px;
                padding-left: 10px;
                overflow:auto;
            }
            .goToDetail {
                width: 100%;
                float: right;
                text-align: right;
                padding-right: 40px;
                line-height: 22px;
                color: #00b3b3;
