        <script src="${/request/@context_path}/common/prompts"></script>
        <script src="${/request/@context_path}/lib/assets/global/plugins/jquery.blockui.min.js"></script>
        <style>
            .win-close{
                box-sizing: content-box;
            }
            #bill-info {
                width: 1225px;
                background: #eee;
                /* height: 100%; */
                margin: 0 auto;
                padding: 20px;
            }
            .bill-info-task-photo {
