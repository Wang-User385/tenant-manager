            }
            .center-body-title {
                width: 100%;
                height: 32px;
                line-height: 32px
            }
            .center-body-title-left {
                width: auto;
                float: left;
                color: #00b3b3
            }
            .total-prj-div {
                float: left;
                width: 25px;
                height: 15px;
                border-radius: 50px;
                background-color: #e5bc6d;
                color: white;
                line-height: 15px;
                text-align: center;
                margin-top: 8px;
                margin-left: 6px
            }
            .center-body-title-right {
                display: none;
                cursor: pointer;
                margin-top: 5px;
                margin-right: 10px;
                float: right;
                border-radius: 5px;
                width: 80px;
                height: 20px;
                line-height: 20px;
                text-align: center;
                background-color: #8cc375;
                color: white
            }
            .center-body-dynamic-title {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                width: 90%;
                float: left;
                height: 35px;
                line-height: 35px;
                color: black
            }
            .center-body-dynamic-time {
                width: 10%;
                float: left;
                height: 35px;
                line-height: 35px;
            }
            .right-status-title {
                width: 100%;
                height: 25px;
                line-height: 25px;
                color: #00b3b3;
                text-align: left;
                padding-left: 20px
            }
            .right-status-des {
                width: 100%;
                height: 60px;
                text-align: center;
                line-height: 50px;
                color: black;
                font-size: 24px;
            }
            .right-status-btn-div {
                width: 100%;
                height: 40px;
                text-align: center
            }
            .right-status-btn {
                width: 120px;
                height: 30px;
                border-radius: 5px;
                text-align: center;
                line-height: 30px;
                font-size: 16px;
                cursor: pointer;
                margin-left: 110px;
                background-color: #FFCD55;
                color: white;
            }
            .con-right-content-title {
                width: 100%;
                height: 25px;
                line-height: 25px;
                color: #00b3b3;
                padding-left: 20px;
                text-align: left
            }
            .con-right-body-tab {
                height: 35px;
                line-height: 35px;
                text-align: center;
                float: left;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .div-rate-10 {
                width: 10%
            }
            .div-rate-12 {
                width: 12%
            }
            .div-rate-15 {
                width: 15%
            }
            .div-rate-18 {
                width: 14%
            }
            .div-rate-30 {
                width: 30%
            }
            .OOb3b3b-color {
                color: #00b3b3;
            }
            .cursor {
                cursor: pointer;
            }
            .tab {
                width: 100%;
            }
            .con-incept-div {
                width: 100%;
                height: 200px;
                margin-bottom: 20px
            }
            .title-img {
                width: 100%;
                height: 30px;
                line-height: 30px;
                padding-left: 30px
            }
            .title-img-img-div {
                width: 40px;
                height: 40px;
                float: left;
            }
            .title-img-img-div img {
                width: 80%;
                height: 80%
            }
            .title-img-title-div {
                width: 80px;
                float: left;
                padding-top: 6px;
                margin-left: 25px;
                color: #333333;
                font-size: 14px
            }
            .con-incept-body {
                width: 99%;
                float: right;
                border-top: 1px solid #cbcbcb;
                border-bottom: 1px solid #cbcbcb;
                height: 160px
            }
            .con-incept-left {
                width: 33%;
                height: 100%;
                border-right: 1px solid #cbcbcb;
                float: left
            }
            .con-incept-center {
                width: 38%;
                height: 100%;
                border-right: 1px solid #cbcbcb;
                padding-top: 5px;
                float: left;
                padding-left: 10px;
                overflow-y: auto;
            }
            .con-incept-right {
                width: 29%;
                height: 100%;
                padding-top: 20px;
                float: left
            }
            .con-incept-left-div {
                width: 30%;
                height: 38px;
                line-height: 38px;
                padding-left: 20px;
                float: left
            }
            .con-incept-left-time {
                width: 70%;
                height: 38px;
                line-height: 38px;
                float: left;
                color: #333333;
                font-size: 12px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .con-manage-detail {
                width: 30%;
                height: 38px;
                float: right;
                line-height: 38px;
                color: #00b3b3;
                padding-right: 20px;
                padding-bottom: 20px;
                text-align: right;
                cursor: pointer;
                position: relative;
                top: -75px;
            }
            .no-data-notice {
                width: 100%;
                height: 100px;
                line-height: 100px;
                text-align: center;
                font-size: 20px;
            }
            .btn-disable{
                background-color: #aaaaaa;
                cursor: no-drop;
            }
            /*============时间轴通用样式============================================================================================================================*/
            .node-time {
                width: 100%;
                height: 40%;
                text-align: center;
                line-height: 20px;
                color: blue
            }
            .node-title {
                width: 100%;
                height: 60%;
                text-align: center;
                line-height: 30px;
                color: grey;
                font-size: 16px
            }
            .node-top {
                width: 100px;
                height: 50%;
            }
            .show-hide {
                visibility: visible
            }
            .start-node {
                width: 10px;
                height: 10px;
                background-color: #00b300;
                float: left;
                position: absolute;
                border-radius: 50px;
            }
            .node-line {
                width: 10px;
                height: 100px;
                float: left;
                position: absolute;
                border-bottom: 1px solid black
            }
            .node-name {
                width: 36px;
                height: 36px;
                border-radius: 50px;
                color: white;
                background-color: #f0ad4e;
                margin-top: 82px;
                text-align: center;
                line-height: 36px;
                font-size: 16px;
                float: left;
                position: absolute;
                font-weight: 600
            }
            /*=============向下延伸样式=============================================================================================================================*/
            .down-div {
                width: 100px;
                height: 100px;
                float: left;
                position: absolute;
                margin-top: 99px;
            }
            .down-top-left {
                width: 20px;
                height: 35px;
                border-left: 1px solid green;
                border-bottom: 1px solid green;
                border-radius: 0px 0px 0px 5px;
            }
            .down-top-left img {
                width: 20px;
                height: 20px;
                position: absolute;
                left: 20px;
                top: 25px;
            }
            .down-top-right img {
                width: 20px;
                height: 20px;
                margin-top: 28px;
                float: left
            }
            /*=============向上延伸样式=============================================================================================================================*/
            .upnode-div {
                width: 100px;
                height: 100px;
                float: left;
                position: absolute;
            }
            .upnode-bottom-left {
                margin-top: 15px;
                width: 20px;
                height: 35px;
                border-left: 1px solid green;
                border-top: 1px solid green;
                border-radius: 5px 0px 0px 0px;
            }
            .upnode-bottom-left img {
                width: 20px;
                height: 20px;
                position: absolute;
                left: 20px;
                top: 40px;
            }
            .upnode-bottom-right img {
                width: 20px;
                height: 20px;
                float: left;
                margin-top: 8px
            }
            .task_node {
                position: absolute;
                height: 84px;
                width:90px;
            }
            body {
                background: #eeeeee !important;
            }
        </style>
        <script><![CDATA[
        $jq = jQuery;
        var projectId = '${/parameter/@project_id}';
        var contractId = '${/parameter/@contract_id}';
        var currntShowId = '';
        var noDataHtml = '<div class="no-data-notice">暂无数据</div>';
        var prjDataSource = {};
        var contractList = [];
        var noticeInceptData = {};

        //查询当前id所有的项目/合同的数据
        jQuery.ajax({
            type: 'GET',
            url: "${/request/@context_path}/query/all/prj/con",
            data: {
                contractId: contractId,
                projectId: projectId
            },
            contentType: "application/json; charset=utf-8",
            success: function (datas) {
                if (!!datas && datas.rows.length>0) {
                    datas = datas.rows[0];
                    /*项目*/
                    if (datas.PRJ && datas.PRJ.length>0) {
                        prjDataSource = datas.PRJ[0];
                        projectId = datas.PRJ[0].projectId;
                        jQuery(".rigth-conetent-div")[0].innerHTML = datas.PRJ[0].projectNumber || '--';
                        jQuery(".rigth-conetent-div")[1].innerHTML = datas.PRJ[0].projectName || '--';
                        jQuery(".rigth-conetent-div")[2].innerHTML = datas.PRJ[0].bpName || '--';
                        jQuery(".rigth-conetent-div")[3].innerHTML = datas.PRJ[0].employeeIdName || '--';
                        jQuery(".prj-detail")[0].style.display = "block";
                        if(!!datas.PRJ[0].processInstanceId){
                            jQuery("#prj-status-btn").attr("onclick", "goToProcess(\'" + datas.PRJ[0].processInstanceId + "\',\'PRJ_PROJECT\',\'" + datas.PRJ[0].projectId + "\')");
                        }else{
                            // jQuery("#prj-status-btn").hide();
                            jQuery("#prj-status-btn").addClass("btn-disable");
                            jQuery("#prj-status-btn").text("暂无流程图明细");
                        }
                        jQuery("#prj-status")[0].innerHTML = !!datas.PRJ[0].currentStatus ? ('项目审批流程' + datas.PRJ[0].currentStatus) : '暂无项目流程';
                    } else {
                        jQuery(".prj-detail").hide();
                    }
                    /*合同签约*/
                    /*var noticeData = {};
                    if (datas.CON && datas.CON.length>0) {
                        var contract_info_start = jQuery("#contract_info_start");
                        var contractIds = [];
                        for (var i = datas.CON.length - 1; i >= 0; i--) {
                            noticeData[datas.CON[i].contractId] = "";
                            var html = jQuery("#contract_tmplate").html();
                            var record = datas.CON[i];
                            record.contractId && contractIds.push(record.contractId);
                            record.signDate = record.signDate || '--';
                            for (var v in record) {
                                var str = "{{" + v + "}}";
                                html = html.replaceAll(str, record[v] || '--');
                            }
                            html = html.replaceAll(/\{\{(\S)*\}\}/, '--');
                            var curDom = jQuery(html);
                            curDom.insertAfter(contract_info_start);
                            if(!!record.processInstanceId){
                                curDom.find(".con-sign-status-btn").attr("onclick","goToProcess(\'"+record.processInstanceId+"\',\'CON_CONTRACT\',\'"+record.contractId+"\')");
                            }else{
                                curDom.find(".con-sign-status-btn").addClass("btn-disable");
                                curDom.find(".con-sign-status-btn").text("暂无流程图明细");
                            }
                            if(!!record.currentSignStatusN){
                                curDom.find(".con-sign-status").text('签约审批流程'+record.currentSignStatusN);
                            }else{
                                curDom.find(".con-sign-status").text("暂无签约流程");
                            }
                        }
                        getConSignNotice(contractIds);
                    }*/
                    /*合同起租*/
                    if (datas.CON_INCEPT && datas.CON_INCEPT.length>0) {
                        var contract_manage = jQuery("#contract_manage");
                        var inceptIds = [];
                        for (var i = 0; i < datas.CON_INCEPT.length; i++) {
                            noticeInceptData[datas.CON_INCEPT[i].contractInceptId] = "";
                            var html = jQuery("#contract_incept_tmplate").html();
                            var record = datas.CON_INCEPT[i];
                            record.contractInceptId && inceptIds.push(record.contractInceptId);
                            for (var v in record) {
                                var str = "{{" + v + "}}";
                                html = html.replaceAll(str, record[v] || '--');
                            }
                            html = html.replaceAll(/\{\{(\S)*\}\}/, '--');
                            var curDom = jQuery(html);
                            curDom.prependTo(contract_manage);
                            if(!!record.processInstanceId){
                                curDom.find(".con-incept-status-btn").attr("onclick","goToProcess(\'"+record.processInstanceId+"\',\'CON_CONTRACT\',\'"+record.contractId+"\')");
                            }else{
                                curDom.find(".con-incept-status-btn").addClass("btn-disable");
                                curDom.find(".con-incept-status-btn").text("暂无流程图明细");
                            }
                            if(!!record.currentStatus){
                                curDom.find(".con-incept-status").text('起租审批流程'+record.currentStatus);
                            }else{
                                curDom.find(".con-incept-status").text("暂无起租流程");
                            }
                        }
                        getInceptNotice(inceptIds);
                    }
                    /*合同变更*/
                    if (datas.CON_CHANGE.length > 0 && !!datas.CON_CHANGE[0]) {
                        var appendHtml = '';
                        var startHtml = jQuery("#con-change-info-append")[0].innerHTML;
                        jQuery("#con-change-info-append")[0].innerHTML = '';
                        startHtml += '<div class="tab">';
                        startHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color">变更编号</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-18 OOb3b3b-color">合同编号</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color" style="overflow: hidden;">合同名称</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">变更日期</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-10">变更类型</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-10">变更状态</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color cursor">变更明细</div>';
                        startHtml += '<div class="con-right-body-tab div-rate-12">流程明细</div></div>';
                        for (var i = 0; i < datas.CON_CHANGE.length; i++) {
                            var record = datas.CON_CHANGE[i];
                            appendHtml += '<div class="tab">';
                            appendHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color">' + (record.changeReqNumber || '--') + '</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-18 OOb3b3b-color cursor" onclick="addConFunction(\'' + record.contractId + '\')">' + (record.contractNumber || '--') + '</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color" style="overflow: hidden;">' + (record.contractName || '--') + '</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">' + (timeFormat(record.changeReqDate) || '--') + '</div>';

                            var bgrmc = record.changeTypeDesc || '--';

                            appendHtml += '<div class="con-right-body-tab div-rate-10">' + (bgrmc || '--') + '</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-10">' + (record.currentStatus || '--') + '</div>';
                            appendHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color cursor" onclick="addContractChangeFunction(\''+ record.contractId + '\',\'' + record.changeReqId + '\',\'' + record.changeType +  '\',\'' + record.bpClass + '\',\'合同明细\')">变更明细>></div>';
                            // appendHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color cursor" onclick="addContractChangeFunction(\'' + datas.CON_CHANGE_CF[i].contractId + '\',\'' + datas.CON_CHANGE_CF[i].changeReqId + '\')" >变更明细>></div>';
                            if(!!record.processInstanceId){
                                appendHtml += '<div onclick="goToProcess(\'' + record.processInstanceId + '\',\'CONTRACT_CHANGE\',\'' + record.changeReqId + '\')" class="con-right-body-tab div-rate-12 OOb3b3b-color cursor">查看流程图明细>></div></div>';
                            }else{
                                appendHtml += '<div class="con-right-body-tab div-rate-12">暂无流程明细</div></div>';
                            }
                        }
                        jQuery("#con-change-info-append")[0].innerHTML = startHtml + appendHtml;
                    } else {
                        var startHtml = jQuery("#con-change-info-append")[0].innerHTML;
                        jQuery("#con-change-info-append")[0].innerHTML = '';
                        jQuery("#con-change-info-append")[0].innerHTML = startHtml + noDataHtml;
                    }
                    /*合同罚息减免左*/
                    if (datas.CON_CSH.length > 0 && !!datas.CON_CSH[0]) {
                        jQuery("#penalty_total_amount").text(datas.CON_CSH[0].dueAmount || "--");
                        jQuery("#penalty_received_amount").text(datas.CON_CSH[0].receivedAmount || "--");
                        var dueAmount = parseFloat(datas.CON_CSH[0].dueAmount) || 0;
                        var receivedAmount = parseFloat(datas.CON_CSH[0].receivedAmount) || 0;
                        jQuery("#penalty_amount").text(dueAmount - receivedAmount);
                    }
                    /*合同结束*/
                    var noticeTerminationData = {};
                    if (datas.CON_END && datas.CON_END.length>0) {
                        var contract_manage = jQuery("#contract_manage");
                        for (var i = 0; i < datas.CON_END.length; i++) {
                            noticeTerminationData[datas.CON_END[i].contract_termination_id] = "";
                            var html = jQuery("#contract_termination_tmplate").html();
                            var record = datas.CON_END[i];
                            for (var v in record) {
                                var str = "{{" + v + "}}";
                                html = html.replaceAll(str, record[v] || '--');
                            }
                            html = html.replaceAll(/\{\{(\S)*\}\}/, '--');
                            var curDom = jQuery(html);
                            curDom.appendTo(contract_manage);
                            if(!!record.processInstanceId){
                                curDom.find(".con-end-status-btn").attr("onclick","goToProcess(\'"+record.processInstanceId+"\',\'CON_CONTRACT\',\'"+record.contractId+"\')");
                            }else{
                                curDom.find(".con-end-status-btn").addClass("btn-disable");
                                curDom.find(".con-end-status-btn").text("暂无流程图明细");
                            }
                            if(!!record.currentStatus){
                                curDom.find(".con-end-status").text('结束审批流程'+record.currentStatus);
                            }else{
                                curDom.find(".con-end-status").text("暂无结束流程");
                            }
                        }
                    }
                    /*放款情况左*/
                    if (datas.CON_CSH_PAY.length > 0 && datas.CON_CSH_PAY[0]) {
                        var fkzt = '--'
                        if (parseFloat(datas.CON_CSH_PAY[0].dueAmount) == parseFloat(datas.CON_CSH_PAY[0].amountPaid)) {
                            fkzt = '完全放款';
                        } else if (parseFloat(datas.CON_CSH_PAY[0].amountPaid) > 0) {
                            fkzt = '部分放款';
                        } else if (parseFloat(datas.CON_CSH_PAY[0].amountPaid) == 0) {
                            fkzt = '未放款';
                        }
                        jQuery(".con-payinfo-div .rigth-conetent-div")[0].innerHTML = fkzt || '';
                        jQuery(".con-payinfo-div .rigth-conetent-div")[1].innerHTML = Leaf.formatMoney(parseFloat(datas.CON_CSH_PAY[0].dueAmount) || '0');
                        jQuery(".con-payinfo-div .rigth-conetent-div")[2].innerHTML = Leaf.formatMoney(parseFloat(datas.CON_CSH_PAY[0].amountPaid) || '0');
                    }
                    /*合同罚息减免右*/
                    if (datas.CON_CHANGE_CF && datas.CON_CHANGE_CF.length > 0 && !!datas.CON_CHANGE[0]) {
                        var changecfHtml = '';
                        var startHtml = jQuery("#change-cf-append")[0].innerHTML;
                        jQuery("#change-cf-append")[0].innerHTML = '';
                        for (var i = 0; i < datas.CON_CHANGE_CF.length; i++) {
                            if (i == 0) {
                                changecfHtml += '<div class="tab">';
                                changecfHtml += '<div class="con-right-body-tab div-rate-15 OOb3b3b-color">变更编号</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-15 OOb3b3b-color">合同编号</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-15 OOb3b3b-color">报价编号</div>';
                                // changecfHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">日期</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">状态</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">减免金额</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-10 OOb3b3b-color">描述</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color">变更明细</div>';
                                changecfHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color">流程图</div>';
                            }
                            changecfHtml += '<div class="tab">';
                            changecfHtml += '<div class="con-right-body-tab div-rate-15">' + (datas.CON_CHANGE_CF[i].changeReqNumber || '--') + '</div>';
                            changecfHtml += '<div class="con-right-body-tab div-rate-15">' + (datas.CON_CHANGE_CF[i].contractNumber || '--') + '</div>';
                            changecfHtml += '<div class="con-right-body-tab div-rate-15">' + (datas.CON_CHANGE_CF[i].quotationNumber || '--') + '</div>';
                            // changecfHtml += '<div class="con-right-body-tab div-rate-10">' + (timeFormat(datas.CON_CHANGE_CF[i].changeReqDate) || '--') + '</div>';
                            changecfHtml += '<div class="con-right-body-tab div-rate-10">' + (datas.CON_CHANGE_CF[i].currentStatus || '--') + '</div>';

                            //罚息金额
                            var penaltyData = JSON.parse(datas.CON_CHANGE_CF[i].penaltyData || '');
                            var ccr_penalty_exempt_amount = penaltyData["ccr_penalty_exempt_amount"] || 0;

                            changecfHtml += '<div class="con-right-body-tab div-rate-10">' + ccr_penalty_exempt_amount + '</div>';
                            changecfHtml += '<div class="con-right-body-tab div-rate-10">' + (datas.CON_CHANGE_CF[i].description || '--') + '</div>';
                            changecfHtml += '<div class="con-right-body-tab div-rate-12 OOb3b3b-color cursor" onclick="addContractChangeFunction(\'' + datas.CON_CHANGE_CF[i].contractId + '\',\'' + datas.CON_CHANGE_CF[i].changeReqId + '\',\'' + datas.CON_CHANGE_CF[i].changeType + '\')" >变更明细>></div>';
                            if(!!datas.CON_CHANGE_CF[i].processInstanceId && !!datas.CON_CHANGE_CF[i].changeReqId){
                                changecfHtml += '<div onclick="goToProcess(\'' + datas.CON_CHANGE_CF[i].processInstanceId + '\',\'CONTRACT_CHANGE\',\'' + datas.CON_CHANGE_CF[i].changeReqId + '\')" class="con-right-body-tab div-rate-12 OOb3b3b-color cursor">流程图明细>></div></div>';
                            }else{
                                changecfHtml += '<div class="con-right-body-tab div-rate-12 ">暂无流程图明细>></div></div>';
                            }
                        }
                        jQuery("#change-cf-append")[0].innerHTML = startHtml + changecfHtml;
                    } else {
                        var startHtml = jQuery("#change-cf-append")[0].innerHTML;
                        jQuery("#change-cf-append")[0].innerHTML = '';
                        jQuery("#change-cf-append")[0].innerHTML = startHtml + noDataHtml;
                    }

                    /*动态*/
                    var prjAppendHtml = '';
                    var conEndAppendHtml = '';
                    var prjNoticeTotal = 0;
                    var conEndNoticeTotal = 0;
                    var prjHtml = jQuery("#prj-append").html();
                    var conEndHtml = jQuery(".con-end-append").html();
                    jQuery("#prj-append").html("");
                    jQuery(".con-end-append").html("");
                    if (datas.NOTICE.length > 0) {
                        for (var i = 0; i < datas.NOTICE.length; i++) {
                            if (datas.NOTICE[i].category == 'PRJ_PROJECT') {
                                prjNoticeTotal = prjNoticeTotal + 1;
                                prjAppendHtml += '<div class="center-body-dynamic-time">' + (timeFormat(datas.NOTICE[i].dateTime) || '--') + '</div><div title="' + datas.NOTICE[i].message + '" class="center-body-dynamic-title">' + datas.NOTICE[i].message + '</div>';
                            }
                            if (datas.NOTICE[i].category == 'CONTRACT_COMPLETE') {
                                conEndNoticeTotal = conEndNoticeTotal + 1;
                                if (!noticeTerminationData[datas.NOTICE[i].documentId]) {
                                    noticeTerminationData[datas.NOTICE[i].documentId] = "";
                                }
                                if (conEndNoticeTotal < 4) {
                                    noticeTerminationData[datas.NOTICE[i].documentId] += '<div class="center-body-dynamic-time">' + (timeFormat(datas.NOTICE[i].dateTime) || '--') + '</div><div title="' + datas.NOTICE[i].message + '" class="center-body-dynamic-title">' + datas.NOTICE[i].message + '</div>';
                                }
                            }
                        }
                    }
                    if (prjNoticeTotal > 0) {
                        jQuery("#prj-append").html(prjHtml + prjAppendHtml);
                        jQuery("#prj-total").hide();
                        jQuery("#prj-total").html(prjNoticeTotal);
                    } else {
                        jQuery("#prj-append").html(prjHtml + noDataHtml);
                        jQuery("#prj-total").hide();
                    }
                    for (var v in noticeTerminationData) {
                        var targetDiv = jQuery('div[data-termination="' + v + '"]');
                        if (noticeTerminationData[v] == null || noticeTerminationData[v] == "") {
                            targetDiv.html(conEndHtml + noDataHtml);
                            targetDiv.find(".total-prj-div").hide();
                        } else {
                            targetDiv.html(conEndHtml + noticeTerminationData[v]);
                            targetDiv.find(".total-prj-div").hide();
                        }
                    }
                }
            }
        });
        //放款情况
        jQuery.ajax({
            type: 'GET',
