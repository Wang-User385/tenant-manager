        }
        function initWebSocket() {
            socket = new SockJS('${/request/@context_path}/websocket');
            socket.onmessage = function (event) {
                var data = JSON.parse(event.data);
                if(data != null && data.action == 'NOTICE'){
                    push_float_msg_by_websocket(data);
                }
            }
        }
        function push_float_msg_by_websocket(data){
            var messageLength = jQuery(".page-notification-container").length;//现有的message条数
            if(messageLength>=3){
                return;
            }
            var topNumber="59px";
            if(messageLength==1){
                topNumber="80px";
            }else if(messageLength==2){
                topNumber="90px";
            }
            //创建节点
            var msgHtml='';
            msgHtml+='<div id="moment_notice_'+messageLength+'" class="page-notification-container" style="top:'+topNumber+'">';
            msgHtml+='<div class="page-notification  bounceInRight animated ">';
            msgHtml+='<div class="notification-media">';
            msgHtml+='<img style="width:36px;height:36px;"  class="show_hide" src="${/request/@context_path}/leafresources/images/MAIN/socket_msg.png">';
            msgHtml+='</div>';
            msgHtml+='<div style="word-break: break-all;padding-right: 5px; " class="notification-info">';
            msgHtml+='<h4 style="font-size: 13px;white-space:nowrap; overflow:hidden; text-overflow:ellipsis;width: 170px;margin-top:10px;" class="notification-title">'+data.noticeTitle+'</h4>';
            msgHtml+=' <p style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;width: 170px;" class="notification-desc">'+data.noticeMessage+'</p></div>';
            msgHtml+='<div style="width: 75px;padding: 25px;border-left: 1px solid #dbdbdb" class="notification-btn single-btn">';
            msgHtml+='<a href="#" onclick="removeNoticeDiv(this);" style="font-weight: 700" data-dismiss="notification">Close</a>';
            msgHtml+='</div></div></div>';
            //添加节点
            jQuery("#msg_append").append(jQuery(msgHtml));
            //给当前添加的这个节点指定动画事件
            if(messageLength==0){
                setTimeout("messageFadeOut("+messageLength+")",2000);
            }else if(messageLength==1){
                setTimeout("messageFadeOut("+messageLength+")",2500);
            }else {
                setTimeout("messageFadeOut("+messageLength+")",3000);
            }

//        if($("#moment_notice_1").height()){
//            document.getElementById('moment_notice_1').style.cssText="margin-top:"+($("#moment_notice_0").height()-5)+"px!important";
//        }
//        if($("#moment_notice_2").height()){
//            document.getElementById('moment_notice_2').style.cssText="margin-top:"+($("#moment_notice_0").height()+$("#moment_notice_1").height()-10)+"px!important";
//        }
        }
        function removeNoticeDiv(this_node){
            this_node.parentElement.parentElement.parentElement.remove();
        }
        function messageFadeOut(i){
            var index = i;
            if(index==0){
                //如果是第一个节点 直接向右隐藏然后移除
                jQuery("#moment_notice_0").animate({right:'-500px'},700,function(){
                    jQuery("#moment_notice_0").remove();
                })
            }else if(index==1){
                //如果是第二个节点
                jQuery("#moment_notice_1").animate({right:'-500px'},700,function(){
                    jQuery("#moment_notice_1").remove();
                });
            }else if(index==2){
                jQuery("#moment_notice_2").animate({right:'-500px'},700,function(){
                    jQuery("#moment_notice_2").remove();
                    currentMessageIndex=0;//直到第三个节点也全部移除 才允许重新添加事件提醒
                })
            }

        }
        //隐藏系统模板下载
        function hideSysTemplate() {
            jQuery("#sys-template-toolbar").removeClass("fast-menu-toolbar-background");
            jQuery(".sys_template_body").animate({height: "0px"}, function () {
                jQuery(".sys_template_body").hide();
            });
        }
        function renderSysTemplate(ds){
            var records = ds.getAll();
            var total = ds.totalCount,
                curIndex = ds.currentIndex,
                curPageTotal = records.length;
            $jq("#sys_template_content").empty();
            var _html = "";
            records.forEach(function (record, index) {
                var obj = record.getObject();
                if(obj.done_flag == "Y"){
                    return ;
                }
                var title = obj.description;
                var content = obj.file_name;
                var attachment_id = obj.attachment_id;

                _html += '<div class="notice_menu_item notice_menu_item_height" title="点击下载" onclick="onClick_sys_template_file(\'' + record.id + '\')">';
                _html += '<div class="notice_menu_item_content notice_menu_item_height">';
                _html += '<div class="notice_menu_item_content_msg" title="' + title + '">' + title + '</div>';
                _html += '<div class="notice_menu_item_content_time" title="' + content + '">' + content ;
                _html += '</div></div>';
                _html += '<div class="notice_menu_item_img notice_menu_item_height">';
                _html += '<span>下载</span></div>';
                _html += '</div>';
            });
            if((!!curIndex || curIndex == 0) && (!!total || total == 0) ){
                var curStart = curIndex;
                var curEnd = curIndex + (curPageTotal==0?0:(curPageTotal-1));
                _html += '<div class="sys_template_item_footer">' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last_end.png" onClick="javascript:firstPageTemplate()" alt="第一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last.png" onClick="javascript:prePageTemplate()" alt="上一页"/>' +
                    '<span>显示条目 </span>' +
                    '<span> ' + curStart + ' </span>' +
                    '<span> - </span>' +
                    '<span> ' + curEnd + ' </span>' +
                    '<span> 共 </span>' +
                    '<span> ' + total + ' </span>' +
                    '<span>条 </span>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next.png" onClick="javascript:nextPageTemplate()" alt="下一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next_end.png" onClick="javascript:lastPageTemplate()" alt="最后一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/refresh.png" onClick="javascript:refreshTemplate()" alt="刷新" style="width:15px;"/>' +
                    '</div>';
            }
            $jq("#sys_template_content").html(_html);
        }
