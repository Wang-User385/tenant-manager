        function attach_download(id) {
            if(!!id){
                var url = "${/request/@context_path}/fnd/attachment/download?attachment_id=" + id;
                jQuery("#emptyForDownload").attr("src",url);
            }else{
                Leaf.showMessage('${l:HLS.PROMPT}', '未找到当前资源，请联系管理员');
            }
        }
