        function doSearchMessage(page) {
            var noticeMessage = document.getElementById('notice_search_input').value;
            if(!!noticeMessage || noticeMessage == ""){
                $("sys_notice_msg_result_main_ds").qpara.noticeMessage = noticeMessage;
            }
            if(page){
                $("sys_notice_msg_result_main_ds").query(page);
            }else{
                $("sys_notice_msg_result_main_ds").query();
            }
        }
        function doSearchWorkflow(page) {
            var noticeMessage = document.getElementById('todo_search_input').value;
            if(!!noticeMessage || noticeMessage == ""){
                $("sys_todo_msg_result_main_ds").qpara.noticeMessage = noticeMessage;
            }
            if(page){
                $("sys_todo_msg_result_main_ds").query(page);
            }else{
                $("sys_todo_msg_result_main_ds").query();
            }
        }
        function renderSysNotice(ds){
            var records = ds.getAll();
            var total = ds.totalCount,
                curIndex = ds.currentIndex,
                curPageTotal = records.length;
            $jq("#system_notice").empty();
            var html = "";
            records.forEach(function (record, index) {
                var obj = record.getObject();
                var picUrl = "${/request/@context_path}/leafresources/images/MAIN/system_notice0@2x.png";
                if(obj.notice_level == 1 || obj.notice_level == 3){
                    picUrl = "${/request/@context_path}/leafresources/images/MAIN/system_notice_level" + obj.notice_level + "@2x.png";
                }
                var message = obj.notice_title + '--' + obj.notice_message;
                var time = obj.notice_datetime;
                var url = obj.notice_url;
                var instance_id = obj.source_event_id;
                var notice_msg_id = '';
                html += '<div class="notice_menu_item notice_menu_item_height">';
                html += '<div class="notice_menu_item_img notice_menu_item_height">';
                html += '<img src="' + picUrl + '"/></div>';
                html += '<div class="notice_menu_item_content notice_menu_item_height" onclick="onClick_msg_notice(\'' + record.id + '\')">';
                html += '<div class="notice_menu_item_content_msg" title="' + message + '">' + message + '</div>';
                html += '<div class="notice_menu_item_content_time">' + time ;
                if(obj.read_flag == 'Y'){
                    html = html + '<span style="float:right;">已读</span>';
                }
                html += '</div></div></div>';
            });
            if(!!curIndex && (!!total || total == 0) ){
                var curStart = curIndex;
                var curEnd = curIndex + (curPageTotal==0?0:(curPageTotal-1));
                html += '<div class="notice_menu_item_footer">' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last_end.png" onClick="javascript:firstPageNotice()" alt="第一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last.png" onClick="javascript:prePageNotice()" alt="上一页"/>' +
                    '<span>显示条目 </span>' +
                    '<span> ' + curStart + ' </span>' +
                    '<span> - </span>' +
                    '<span> ' + curEnd + ' </span>' +
                    '<span> 共 </span>' +
                    '<span> ' + total + ' </span>' +
                    '<span>条 </span>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next.png" onClick="javascript:nextPageNotice()" alt="下一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next_end.png" onClick="javascript:lastPageNotice()" alt="最后一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/refresh.png" onClick="javascript:refreshNoticeTodo()" alt="刷新" style="width:15px;"/>' +
                    '</div>';
            }
            $jq("#system_notice").html(html);

            $jq("#notice_message_num").html("(" + total + ")");
        }
        function renderSysTodo(ds){
            var records = ds.getAll();
            var total = ds.totalCount,
                curIndex = ds.currentIndex,
                curPageTotal = records.length;
            $jq("#system_todo").empty();
            var todoHtml = "";
            records.forEach(function (record, index) {
                var obj = record.getObject();
                if(obj.done_flag == "Y"){
                    return ;
                }
                var title = obj.notice_title;
                var time = obj.notice_datetime;
                var content = obj.notice_message;
                var submit = obj.source_user_name;
                var instance_id = obj.instance_id;
                var node_id = obj.node_id;
                var record_id = obj.record_id;
                var workflow_id = obj.workflow_id;
                var record_type = obj.record_type;
                todoHtml += '<div class="notice_menu_item todo_menu_item_height">';
                todoHtml += '<div class="todo_menu_item_content todo_menu_item_height" onclick="onClick_todo_notice(\'' + record.id + '\')">';
                todoHtml += '<div class="todo_title">';
                todoHtml += '<span class="title" title="' + title + '">' + title + '</span>';
                todoHtml += '</div>';
                todoHtml += '<div class="todo_msg" title="' + content + '">' + content ;
                todoHtml += '</div></div></div>';
            });
            if(!!curIndex && (!!total || total == 0) ){
                var curStart = curIndex;
                var curEnd = curIndex + (curPageTotal==0?0:(curPageTotal-1));
                todoHtml += '<div class="notice_menu_item_footer">' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last_end.png" onClick="javascript:firstPageTodo()" alt="第一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/last.png" onClick="javascript:prePageTodo()" alt="上一页"/>' +
                    '<span>显示条目 </span>' +
                    '<span> ' + curStart + ' </span>' +
                    '<span> - </span>' +
                    '<span> ' + curEnd + ' </span>' +
                    '<span> 共 </span>' +
                    '<span> ' + total + ' </span>' +
                    '<span>条 </span>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next.png" onClick="javascript:nextPageTodo()" alt="下一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/next_end.png" onClick="javascript:lastPageTodo()" alt="最后一页"/>' +
                    '<img src="${/request/@context_path}/leafresources/images/home_page/refresh.png" onClick="javascript:refreshNoticeTodo()" alt="刷新" style="width:15px;"/>' +
                    '</div>';
            }
            $jq("#system_todo").html(todoHtml);

            $jq("#todo_message_num").html("(" + total + ")");
        }
