        function onClick_msg_notice(record_id) {
            var ds = $("sys_notice_msg_result_main_ds");
            var record = ds.findById(record_id);
            if(!!record.get("notice_url")){
                var url = record.get("notice_url");
                if(!(url.charAt(0)=='/')){
                    url='/'+url;
                }
                var noticeWin = new Leaf.Window({
                    id: 'sys_notice_url',
                    url: '${/request/@context_path}/modules' + url,
                    params: {
                        winid: 'sys_notice_url'
                    },
                    title: '明细',
                    fullScreen: true
                });
                noticeMenuHide();
                noticeWin.on('close', function () {
                    if(record.get("read_flag") != "Y"){
                        setNoticeRead(record.get("notice_id"));
                    }
                });
            }else{
                var detail = '';
                var notice_id = record.get("notice_id");
                detail += !!record.get("notice_message") ? "消息内容  :  " + record.get("notice_message") + "</br>" : '' ;
                detail += !!record.get("source_user_name") ? "来源用户  :  " + record.get("source_user_name") + "(id:" + record.get("source_user_id") + ")" + "</br>" : '' ;
                detail += (!!record.get("source_document_category") && !!record.get("source_document_id")) ? "来源单据  :  " + record.get("source_document_category") + " (id:" + record.get("source_document_id") + ") " + "</br>" : '' ;
                Leaf.showInfoMessage(record.get("notice_title")||"消息",detail,function(){
                    if(record.get("read_flag") != "Y"){
                        setNoticeRead(record.get("notice_id"));
                    }
                },582,405);
            }
        }
        function onClick_todo_notice(record_id) {
            var ds = $("sys_todo_msg_result_main_ds");
            var record = ds.findById(record_id);
            if(!!record.get("notice_url")){
                var url = record.get("notice_url");
                var currentProcessInstanceId = getParaFromUrl(url,"currentProcessInstanceId") || getParaFromUrl(url,"processInstanceId");
                var taskId = getParaFromUrl(url,"taskId");
                noticeMenuHide();
                var win = new Leaf.Window({
                    id: 'task_detail_win',
                    url: '${/request/@context_path}/modules/MYWFL/MYWFL001/task_detail.lview',
                    params: {
                        url: '${/request/@context_path}/modules/zjwfl/ZJWFL5110/zj_wfl_approve.lview',
                        processInstanceId: currentProcessInstanceId,
                        taskId: taskId,
                        isAdmin:false,
                        winid: 'task_detail_win'
                    },
                    title: '工作流审批',
                    height: 500,
                    width: 860,
                    fullScreen: true
                });
                win.on('close', function () {
                    $("sys_todo_msg_result_main_ds").query();
                });
            }else{
                Leaf.showErrorMessage("错误","未找到待办url，请联系管理员");
            }
        }
        function setNoticeRead(notice_id){
            //消息已读
            Leaf.request({
                url: 'hls/system/notice/setread',
                scope: this,
                para: {
                    notice_id: notice_id
                },
                success: function (res) {
                    if (res.success) {
                        $("sys_notice_msg_result_main_ds").query();
                        $("sys_notice_count_ds").query();
                    }
                }
            })
        }
        function goToHomePage(){
            mainJumpUrl('user_role_home_page.lview','主页','SYS_HOME_PAGE','系统首页','系统首页','two');
        }
        function getParaFromUrl(url,pName){
            var ret = '';
            if(url.indexOf("?") < 0){
                return ret;
            }
            var urlParaStr = url.substr(url.indexOf("?")+1);
            var urlParaArr = urlParaStr.split("&");
            for(var i=0;i<urlParaArr.length;i++){
                if(urlParaArr[i].split("=")[0] == pName){
                    ret = urlParaArr[i].split("=")[1];
                    return ret;
                }
            };
            return ret;
        }
        function cleanNoticeMsg() {
            Leaf.Masker.mask(document.getElementById("notice_menu"),"loading...");
            //所有消息已读
            Leaf.request({
                url: 'hls/system/notice/setallread',
                scope: this,
                success: function (res) {
                    if (res.success) {
                        refreshNoticeTodo();
                        Leaf.Masker.unmask(document.getElementById("notice_menu"));
                        Leaf.SideBar.show({
                            msg: '操作成功',
                            duration: 1000
                        });
                    }
                },
                error: function (res) {
                    Leaf.Masker.unmask(document.getElementById("notice_menu"));
                    Leaf.SideBar.show({
                        type:'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                },
                failure: function (res) {
                    Leaf.Masker.unmask(document.getElementById("notice_menu"));
                    Leaf.SideBar.show({
                        type:'warning',
                        msg: '操作失败',
                        duration: 1000
                    });
                }
            })
        }
